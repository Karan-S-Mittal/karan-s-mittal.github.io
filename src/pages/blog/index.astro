---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/content/PageHeader.astro';
import YearGroup from '@components/content/YearGroup.astro';
import BlogPostCard from '@components/content/BlogPostCard.astro';

const allPosts = await getCollection('blog');
const isDev = import.meta.env.DEV;
const posts = allPosts
  .filter((post) => isDev || !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const postsByYear = posts.reduce<Record<string, typeof posts>>((acc, post) => {
  const year = post.data.pubDate.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<Layout title="Essays & Systems Notes | Karan Mittal">
  <main class="container blog-page">
    <PageHeader
      label="Field Notes"
      title="Writing & Systems Notes."
      description="First-principles explanations of AI inference, deterministic retrieval, distributed systems, and low-level optimization."
    />

    <div class="blog-toolbar">
      <div class="search-wrap blog-search">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="blog-search"
          placeholder="Search field notes, tags, or mechanisms..."
          aria-label="Search field notes"
          autocomplete="off"
        />
      </div>

      <div class="blog-quick-links">
        <a href="/tags" class="quick-link-pill">
          <span>Topics Index</span>
          <span class="pill-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <p id="no-results" class="no-results" style="display: none;">No matching essays found.</p>

    <div class="archive-list" id="blog-timeline">
      {years.map((year) => (
        <YearGroup year={year} count={postsByYear[year].length}>
          {postsByYear[year].map((post) => (
            <BlogPostCard
              post={post}
              searchText={[
                post.data.title,
                post.data.description,
                ...post.data.tags,
              ].join(' ').toLowerCase()}
            />
          ))}
        </YearGroup>
      ))}
    </div>
  </main>
</Layout>

<script>
  const searchInput = document.getElementById('blog-search');
  const posts = document.querySelectorAll('.post-card');
  const yearGroups = document.querySelectorAll('.year-group');
  const noResults = document.getElementById('no-results');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
      let visibleCount = 0;

      posts.forEach((post) => {
        const text = (post as HTMLElement).dataset.search || '';
        const match = !query || text.includes(query);
        (post as HTMLElement).style.display = match ? '' : 'none';
        if (match) visibleCount++;
      });

      yearGroups.forEach((group) => {
        const visiblePosts = group.querySelectorAll('.post-card');
        let hasVisible = false;
        visiblePosts.forEach((p) => {
          if ((p as HTMLElement).style.display !== 'none') hasVisible = true;
        });
        (group as HTMLElement).style.display = hasVisible ? '' : 'none';
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    });
  }
</script>

<style>
  .blog-page {
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }

  .blog-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    flex-wrap: wrap;
  }

  .blog-search {
    flex: 1;
    min-width: 240px;
    max-width: 420px;
    margin-bottom: 0;
  }

  .search-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.9rem;
    color: var(--ie-muted);
    pointer-events: none;
  }

  .search-wrap input {
    width: 100%;
    padding: 0.55rem 1rem 0.55rem 2.5rem;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-pill, 999px);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--ie-ink);
    transition: border-color 120ms ease;
  }

  .search-wrap input:focus {
    outline: none;
    border-color: var(--ie-blue);
  }

  .blog-quick-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .quick-link-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-pill, 999px);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ie-ink);
    text-decoration: none;
    transition: border-color 120ms ease, background-color 120ms ease, color 120ms ease;
  }

  .quick-link-pill:hover {
    border-color: var(--ie-blue);
    color: var(--ie-blue);
    background: var(--ie-blue-soft);
  }

  .pill-accent {
    border-color: var(--ie-blue);
    background: var(--ie-blue-soft);
    color: var(--ie-blue);
    font-weight: 600;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ie-blue);
  }

  .no-results {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ie-muted);
    padding: 2rem 0;
  }

  @media (max-width: 768px) {
    .blog-toolbar {
      flex-direction: column;
      align-items: stretch;
    }
    .blog-search {
      max-width: none;
    }
  }
</style>
