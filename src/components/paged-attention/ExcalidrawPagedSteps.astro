          <text x="52" y="196" text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--ex-purple-text)">softmax(Q·Kᵀ)·V</text>
          <text x="52" y="214" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="var(--ex-green-text)">Zero Temp Copy!</text>
        </g>
