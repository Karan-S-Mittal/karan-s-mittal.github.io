---
/**
 * CacheAwareBufferArchitecture.astro
 * ByteByteGo-grade Physical CPU Microarchitecture & Memory Bus Infographic.
 * Visualizes CPU die, L1/L2/L3 caches, DDR5 memory bus, and SIMD accumulation.
 */
import Exhibit from '../../editorial/Exhibit.astro';

interface Props {
  exhibit?: string;
  title?: string;
  badge?: string;
  caption?: string;
}

const {
  exhibit = '05',
  title = 'Physical CPU Cache Hierarchy: Random DRAM Thrashing vs. XGBoost Contiguous Prefetch',
  badge = 'HARDWARE MICROARCHITECTURE',
  caption = 'Top (Naive Scanning): Fetching gradients and Hessians using out-of-order row indices forces the CPU memory controller to jump across non-contiguous DRAM pages, triggering L1/L2 cache misses and freezing the execution pipeline for 200 cycles. Bottom (XGBoost Cache-Conscious Buffer): Pre-sorted CSC column chunks stream continuous 64-byte cache lines directly into L1 Data Cache, driving 256-bit AVX2 SIMD accumulators with zero pipeline bubbles.',
} = Astro.props;
---

<Exhibit exhibit={exhibit} title={title} badge={badge} caption={caption} wide>
  <div class="bbg-diagram-card">
    <svg class="bbg-svg" viewBox="0 0 740 450" role="img" aria-label="ByteByteGo style Physical CPU Microarchitecture Diagram">
      <defs>
        <!-- Soft Ambient Drop Shadow -->
        <filter id="bbg-shadow" x="-5%" y="-5%" width="110%" height="115%">
          <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="var(--ie-ink)" flood-opacity="0.08" />
        </filter>

        <!-- Strong Card Shadow -->
        <filter id="bbg-card-shadow" x="-5%" y="-5%" width="110%" height="115%">
          <feDropShadow dx="0" dy="6" stdDeviation="10" flood-color="var(--ie-ink)" flood-opacity="0.12" />
        </filter>

        <!-- CPU Substrate Gradients -->
        <linearGradient id="cpu-pkg-dark" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="var(--ie-ink)" />
          <stop offset="100%" stop-color="var(--ie-ink)" />
        </linearGradient>

        <linearGradient id="cpu-core-frozen" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="var(--ie-rust-soft)" />
          <stop offset="100%" stop-color="var(--ie-rust-soft)" />
        </linearGradient>

        <linearGradient id="cpu-core-active" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="var(--ie-verified-soft)" />
          <stop offset="100%" stop-color="var(--ie-verified-soft)" />
        </linearGradient>

        <!-- RAM DIMM PCB & Chips -->
        <linearGradient id="dimm-pcb-grad" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="var(--ie-ink)" />
          <stop offset="50%" stop-color="var(--ie-ink)" />
          <stop offset="100%" stop-color="var(--ie-ink)" />
        </linearGradient>

        <linearGradient id="dram-chip-grad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="var(--ie-ink)" />
          <stop offset="100%" stop-color="var(--ie-ink)" />
        </linearGradient>

        <linearGradient id="gold-pin-grad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="var(--ie-rust-soft)" />
          <stop offset="50%" stop-color="var(--ie-rust)" />
          <stop offset="100%" stop-color="var(--ie-rust)" />
        </linearGradient>

        <!-- Flow Conduit Gradients -->
        <linearGradient id="bus-stall-grad" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="var(--ie-rust)" />
          <stop offset="50%" stop-color="var(--ie-rust)" />
          <stop offset="100%" stop-color="var(--ie-rust)" />
        </linearGradient>

        <linearGradient id="bus-stream-grad" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="var(--ie-verified)" />
          <stop offset="50%" stop-color="var(--ie-verified)" />
          <stop offset="100%" stop-color="var(--ie-verified)" />
        </linearGradient>

        <!-- Arrow Markers -->
        <marker id="bbg-arr-red" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
          <path d="M 0 0 L 8 3 L 0 6 Z" fill="var(--ie-rust)" />
        </marker>
        <marker id="bbg-arr-green" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
          <path d="M 0 0 L 8 3 L 0 6 Z" fill="var(--ie-verified)" />
        </marker>
        <marker id="bbg-arr-blue" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
          <path d="M 0 0 L 8 3 L 0 6 Z" fill="var(--ie-blue)" />
        </marker>
      </defs>

      <!-- ========================================================================= -->
      <!-- SCENARIO 1: NAIVE DRAM RANDOM ACCESS (THE MEMORY BOTTLENECK) -->
      <!-- ========================================================================= -->
      <g transform="translate(14, 14)" filter="url(#bbg-shadow)">
        <!-- Outer Scenario Card -->
        <rect x="0" y="0" width="712" height="200" rx="10" fill="var(--ie-surface)" stroke="var(--ie-rust)" stroke-width="1.5" />
        <rect x="0" y="0" width="712" height="32" rx="10 10 0 0" fill="var(--ie-rust-soft)" />
        
        <!-- Step 1 Badge & Header -->
        <rect x="12" y="6" width="24" height="20" rx="4" fill="var(--ie-rust)" />
        <text x="24" y="20" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="11" font-weight="800" fill="var(--ie-surface)">1</text>
        <text x="44" y="20" font-family="var(--font-sans, sans-serif)" font-size="12" font-weight="700" fill="var(--ie-rust)">
          Naive Direct Split Finding: Non-Contiguous DRAM Thrashing
        </text>
        
        <rect x="525" y="6" width="175" height="20" rx="4" fill="var(--ie-rust-soft)" stroke="var(--ie-rust)" stroke-width="1" />
        <text x="612" y="19" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="9.5" font-weight="800" fill="var(--ie-rust)">
          ⚠ ~150–200 CPU CYCLES / STALL
        </text>

        <!-- 1.1 ILLUSTRATED CPU SILICON PACKAGE -->
        <g transform="translate(12, 42)">
          <!-- Substrate Base -->
          <rect x="0" y="0" width="225" height="146" rx="8" fill="url(#cpu-pkg-dark)" stroke="var(--ie-ink)" stroke-width="1.5" />
          
          <!-- Gold Corner Notch Alignment Marker -->
          <polygon points="0,0 12,0 0,12" fill="var(--ie-rust)" />
          
          <text x="18" y="16" font-family="var(--font-mono, monospace)" font-size="9.5" font-weight="800" fill="var(--ie-muted)" letter-spacing="0.06em">
            CPU DIE: SOCKET 0
          </text>

          <!-- Core 0 Die Silicon Surface -->
          <g transform="translate(8, 24)">
            <rect x="0" y="0" width="209" height="114" rx="6" fill="var(--ie-ink)" stroke="var(--ie-muted)" stroke-width="1" />
            
            <!-- ALU Engine Box (Frozen State) -->
            <rect x="6" y="6" width="197" height="30" rx="4" fill="url(#cpu-core-frozen)" stroke="var(--ie-rust)" stroke-width="1.2" />
            <text x="14" y="21" font-family="var(--font-mono, monospace)" font-size="10" font-weight="800" fill="var(--ie-rust)">
              ALU EXECUTION ENGINE
            </text>
            <rect x="135" y="11" width="62" height="18" rx="3" fill="var(--ie-rust)" />
            <text x="166" y="23" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="8.5" font-weight="800" fill="var(--ie-surface)">
              ⛔ STALLED
            </text>

            <!-- L1 & L2 Cache Modules -->
            <g transform="translate(6, 42)">
              <!-- L1 Data Cache -->
              <rect x="0" y="0" width="95" height="34" rx="3" fill="var(--ie-ink)" stroke="var(--ie-muted)" stroke-width="1" />
              <text x="6" y="14" font-family="var(--font-mono, monospace)" font-size="8.5" font-weight="700" fill="var(--ie-rule)">L1 D-CACHE (32KB)</text>
              <rect x="6" y="18" width="83" height="12" rx="2" fill="var(--ie-rust)" />
              <text x="47" y="27" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="8" font-weight="800" fill="var(--ie-rust)">MISS ✕ (4 cyc)</text>

              <!-- L2 Unified Cache -->
              <rect x="102" y="0" width="95" height="34" rx="3" fill="var(--ie-ink)" stroke="var(--ie-muted)" stroke-width="1" />
              <text x="108" y="14" font-family="var(--font-mono, monospace)" font-size="8.5" font-weight="700" fill="var(--ie-rule)">L2 CACHE (512K)</text>
              <rect x="108" y="18" width="83" height="12" rx="2" fill="var(--ie-rust)" />
              <text x="149" y="27" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="8" font-weight="800" fill="var(--ie-rust)">MISS ✕ (12 cyc)</text>
            </g>

            <!-- L3 Shared Cache Layer -->
            <g transform="translate(6, 82)">
              <rect x="0" y="0" width="197" height="24" rx="3" fill="var(--ie-ink)" stroke="var(--ie-muted)" stroke-width="1" />
              <text x="8" y="16" font-family="var(--font-mono, monospace)" font-size="8.5" font-weight="700" fill="var(--ie-muted)">L3 CACHE (32MB)</text>
              <text x="188" y="16" text-anchor="end" font-family="var(--font-mono, monospace)" font-size="8" font-weight="800" fill="var(--ie-rust)">MISS ✕ (40 cyc)</text>
            </g>
          </g>
        </g>

        <!-- 1.2 MEMORY BUS CONDUIT (THE BOTTLENECK TRANSIT) -->
        <g transform="translate(242, 92)">
          <!-- Jagged Bus Line -->
          <path d="M 0 16 L 80 16" stroke="url(#bus-stall-grad)" stroke-width="3" stroke-dasharray="5 3" marker-end="url(#bbg-arr-red)" />
          <rect x="8" y="-6" width="66" height="16" rx="3" fill="var(--ie-rust-soft)" stroke="var(--ie-rust)" stroke-width="1" />
          <text x="41" y="5" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="8" font-weight="800" fill="var(--ie-rust)">
            DDR5 BUS
          </text>
          <text x="40" y="32" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="8.5" font-weight="700" fill="var(--ie-rust)">
            +100ns Latency
          </text>
        </g>

        <!-- 1.3 ILLUSTRATED DUAL-CHANNEL DDR5 DIMM MODULE -->
        <g transform="translate(330, 42)">
          <!-- PCB Board -->
          <rect x="0" y="0" width="370" height="146" rx="8" fill="url(#dimm-pcb-grad)" stroke="var(--ie-ink)" stroke-width="1.5" />
          
          <!-- DIMM Top Heat Spreader Bar -->
          <rect x="0" y="0" width="370" height="22" rx="8 8 0 0" fill="var(--ie-ink)" stroke="var(--ie-muted)" stroke-width="1" />
          <text x="14" y="15" font-family="var(--font-mono, monospace)" font-size="9" font-weight="800" fill="var(--ie-rule)">
            DDR5-5600 DUAL-CHANNEL MEMORY BANK (32GB)
          </text>

          <!-- Gold Contact Pins Along Bottom -->
          <g transform="translate(10, 134)">
            <rect x="0" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="12" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="24" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="36" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="48" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="60" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="72" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="84" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="96" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="108" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="120" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="132" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="144" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="156" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="168" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="180" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="192" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="204" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="216" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="228" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="240" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="252" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="264" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="276" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="288" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="300" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="312" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="324" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
            <rect x="336" y="0" width="7" height="10" fill="url(#gold-pin-grad)" rx="1" />
          </g>

          <!-- 3 Out-of-Order Memory Pages (BGA Chip Packages) -->
          <g transform="translate(12, 30)">
            <!-- Chip A -->
            <g transform="translate(0, 0)">
              <rect x="0" y="0" width="110" height="64" rx="4" fill="url(#dram-chip-grad)" stroke="var(--ie-rust)" stroke-width="1.5" />
              <rect x="4" y="4" width="102" height="14" rx="2" fill="var(--ie-rust)" />
              <text x="55" y="14" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="8" font-weight="800" fill="var(--ie-rust)">
                0x8F0020 (Row 4082)
              </text>
              <text x="55" y="33" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="9" font-weight="700" fill="var(--ie-surface)">
                val = 0.34
              </text>
              <text x="55" y="50" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="8" fill="var(--ie-rust)">
                (g: +1.42, h: 2.1)
              </text>
            </g>

            <!-- Chip B -->
            <g transform="translate(118, 0)">
              <rect x="0" y="0" width="110" height="64" rx="4" fill="url(#dram-chip-grad)" stroke="var(--ie-rust)" stroke-width="1.5" />
              <rect x="4" y="4" width="102" height="14" rx="2" fill="var(--ie-rust)" />
              <text x="55" y="14" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="8" font-weight="800" fill="var(--ie-rust)">
                0x0114C0 (Row 12)
              </text>
              <text x="55" y="33" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="9" font-weight="700" fill="var(--ie-surface)">
                val = 4.50
              </text>
              <text x="55" y="50" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="8" fill="var(--ie-rust)">
                (g: -0.85, h: 1.0)
              </text>
            </g>

            <!-- Chip C -->
            <g transform="translate(236, 0)">
              <rect x="0" y="0" width="110" height="64" rx="4" fill="url(#dram-chip-grad)" stroke="var(--ie-rust)" stroke-width="1.5" />
              <rect x="4" y="4" width="102" height="14" rx="2" fill="var(--ie-rust)" />
              <text x="55" y="14" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="8" font-weight="800" fill="var(--ie-rust)">
                0xF900A0 (Row 9410)
              </text>
              <text x="55" y="33" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="9" font-weight="700" fill="var(--ie-surface)">
                val = 15.4
              </text>
              <text x="55" y="50" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="8" fill="var(--ie-rust)">
                (g: +0.12, h: 0.8)
              </text>
            </g>
          </g>

          <rect x="12" y="104" width="346" height="20" rx="3" fill="var(--ie-rust)" />
          <text x="185" y="117" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="8.5" font-weight="700" fill="var(--ie-rust)">
            ⚠️ 64-Byte Cachelines Thrash: Only 8B Used / 56B Thrown Away Per Hop
          </text>
        </g>
      </g>

      <!-- ========================================================================= -->
      <!-- SCENARIO 2: XGBOOST CACHE-AWARE BUFFER (THE HARDWARE SATURATION) -->
      <!-- ========================================================================= -->
      <g transform="translate(14, 226)" filter="url(#bbg-shadow)">
        <!-- Outer Scenario Card -->
        <rect x="0" y="0" width="712" height="208" rx="10" fill="var(--ie-surface)" stroke="var(--ie-verified)" stroke-width="1.5" />
        <rect x="0" y="0" width="712" height="32" rx="10 10 0 0" fill="var(--ie-verified-soft)" />

        <!-- Step 2 Badge & Header -->
        <rect x="12" y="6" width="24" height="20" rx="4" fill="var(--ie-verified)" />
        <text x="24" y="20" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="11" font-weight="800" fill="var(--ie-surface)">2</text>
        <text x="44" y="20" font-family="var(--font-sans, sans-serif)" font-size="12" font-weight="700" fill="var(--ie-verified)">
          XGBoost Cache-Conscious Engine: Contiguous Pre-Sorted Accumulation
        </text>

        <rect x="525" y="6" width="175" height="20" rx="4" fill="var(--ie-verified-soft)" stroke="var(--ie-verified)" stroke-width="1" />
        <text x="612" y="19" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="9.5" font-weight="800" fill="var(--ie-verified)">
          ✓ ~4 CPU CYCLES (100% L1 HIT)
        </text>

        <!-- 2.1 IN-MEMORY CONTIGUOUS CSC CHUNK -->
        <g transform="translate(12, 42)">
          <rect x="0" y="0" width="225" height="154" rx="8" fill="var(--ie-surface-raised)" stroke="var(--ie-rule)" stroke-width="1.5" />
          <rect x="0" y="0" width="225" height="24" rx="8 8 0 0" fill="var(--ie-rule)" />
          <text x="12" y="16" font-family="var(--font-mono, monospace)" font-size="9.5" font-weight="800" fill="var(--ie-ink)">
            CSC CONTIGUOUS CHUNK (DMatrix)
          </text>

          <!-- Pre-sorted feature values -->
          <g transform="translate(10, 32)">
            <rect x="0" y="0" width="205" height="34" rx="4" fill="var(--ie-blue-soft)" stroke="var(--ie-blue)" stroke-width="1" />
            <text x="10" y="14" font-family="var(--font-mono, monospace)" font-size="8.5" font-weight="700" fill="var(--ie-blue)">VALS[] (Pre-sorted Float32):</text>
            <text x="10" y="27" font-family="var(--font-mono, monospace)" font-size="9.5" font-weight="800" fill="var(--ie-blue)">[ 1.20, 1.80, 2.50, 3.10 ]</text>
          </g>

          <!-- Thread-local gradient buffer -->
          <g transform="translate(10, 72)">
            <rect x="0" y="0" width="205" height="46" rx="4" fill="var(--ie-verified-soft)" stroke="var(--ie-verified)" stroke-width="1.2" />
            <text x="10" y="14" font-family="var(--font-mono, monospace)" font-size="8.5" font-weight="800" fill="var(--ie-verified)">THREAD-LOCAL BUFFER:</text>
            <text x="10" y="28" font-family="var(--font-mono, monospace)" font-size="8.5" font-weight="700" fill="var(--ie-verified)">gBuf[]: [ +1.42, -0.85, +0.12, +0.94 ]</text>
            <text x="10" y="40" font-family="var(--font-mono, monospace)" font-size="8.5" font-weight="700" fill="var(--ie-verified)">hBuf[]: [  2.10,  1.00,  0.80,  1.50 ]</text>
          </g>

          <rect x="10" y="124" width="205" height="20" rx="3" fill="var(--ie-blue-soft)" />
          <text x="112" y="137" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="8.5" font-weight="800" fill="var(--ie-blue)">
            ✓ 64-Byte Aligned Memory Block
          </text>
        </g>

        <!-- 2.2 HIGH SPEED STREAMING CONDUIT -->
        <g transform="translate(242, 98)">
          <path d="M 0 16 L 80 16" stroke="url(#bus-stream-grad)" stroke-width="4" marker-end="url(#bbg-arr-green)" />
          <rect x="6" y="-8" width="70" height="18" rx="3" fill="var(--ie-verified-soft)" stroke="var(--ie-verified)" stroke-width="1" />
          <text x="41" y="4" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="8" font-weight="800" fill="var(--ie-verified)">
            64B BURST
          </text>
          <text x="40" y="32" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="8.5" font-weight="700" fill="var(--ie-verified)">
            Linear DMA
          </text>
        </g>

        <!-- 2.3 CPU DIE: L1 DATA CACHE & 256-BIT AVX2 SIMD ACCUMULATION -->
        <g transform="translate(330, 42)">
          <rect x="0" y="0" width="370" height="154" rx="8" fill="url(#cpu-pkg-dark)" stroke="var(--ie-ink)" stroke-width="1.5" />
          <rect x="0" y="0" width="370" height="24" rx="8 8 0 0" fill="var(--ie-ink)" stroke="var(--ie-muted)" stroke-width="1" />
          <polygon points="0,0 12,0 0,12" fill="var(--ie-verified)" />
          
          <text x="18" y="16" font-family="var(--font-mono, monospace)" font-size="9.5" font-weight="800" fill="var(--ie-rule)">
            CPU CORE 0: L1 D-CACHE & AVX2 SIMD EXECUTION DIE
          </text>

          <g transform="translate(10, 32)">
            <!-- L1 Hit Surface -->
            <g transform="translate(0, 0)">
              <rect x="0" y="0" width="165" height="78" rx="6" fill="var(--ie-ink)" stroke="var(--ie-verified)" stroke-width="1.5" />
              <rect x="6" y="6" width="153" height="18" rx="3" fill="var(--ie-verified)" />
              <text x="82" y="18" text-anchor="middle" font-family="var(--font-mono, monospace)" font-size="8.5" font-weight="800" fill="var(--ie-verified)">
