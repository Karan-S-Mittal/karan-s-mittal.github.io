---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/content/PageHeader.astro';
import { formatTalkDate } from '@utils/date';

// Bump this date whenever this page's content is edited.
const lastUpdated = new Date('2026-09-20');

const focusAreas = [
  {
    index: '01',
    category: 'Work & Advisory',
    status: 'ACTIVE',
    items: [
      { text: 'Co-founding and leading systems engineering at ', link: { text: 'Dextar.co', url: 'https://dextar.co' } },
      { text: 'Developing systems-engineering advisory and implementation work around retrieval, AI workflows, and delivery' },
      { text: 'Making public claims and architecture explanations easier to inspect and verify' },
    ],
  },
  {
    index: '02',
    category: 'Building & Open Source',
    status: 'IN PROGRESS',
    items: [
      { text: 'Expanding a code-first architecture visual library' },
      { text: 'Publishing a systems essay on version control, review protocols, and CI execution boundaries' },
      { text: 'Improving the accessibility and evidence discipline of this engineering studio' },
    ],
  },
  {
    index: '03',
    category: 'Research & Systems',
    status: 'EXPLORING',
    items: [
      { text: 'Git object storage, ref-update boundaries, and packfile mechanics' },
      { text: 'Code-review protocols across branch, change, and patch-series workflows' },
      { text: 'CI runner isolation and the boundary between an image definition and a reproducible build' },
    ],
  },
  {
    index: '04',
    category: 'Community & Mentorship',
    status: 'ACTIVE',
    items: [
      { text: 'Organizing hands-on AI systems workshops at ', link: { text: 'MLIndore', url: 'https://gdg.community.dev/events/details/google-gdg-indore-presents-build-with-ai-hands-on-ai-agents-amp-llmops-workshop-ml-indore-amp-gdg-indore/' } },
      { text: 'Mentoring engineers in systems architecture at ', link: { text: 'CodeVipassana', url: 'https://www.codevipassana.dev/' } },
      { text: 'Hosting distributed systems sessions with ', link: { text: 'GDG Cloud Indore', url: 'https://gdg.community.dev/gdg-cloud-indore/' } },
    ],
  },
  {
    index: '05',
    category: 'Technical Speaking',
    status: 'UPCOMING',
    items: [
      { text: 'Maintaining a public ledger of past talks and workshops' },
      { text: 'Developing future sessions only when the material and event record are ready to publish' },
      { text: 'View all past and upcoming presentations on the ', link: { text: 'Speaking archive →', url: '/speaking' } },
    ],
  },
];
---

<Layout
  title="Now | Karan Mittal"
  description="A living snapshot of Karan Mittal's current systems engineering focus, research, and priorities."
>
  <main class="container now-page">
    <PageHeader
      label="Now"
      title="Current systems focus and priorities."
      description="A living snapshot of current work, public writing, systems research, and community activity."
    />

    <div class="now-grid">
      {focusAreas.map((area) => (
        <section class="now-card" aria-labelledby={`focus-${area.index}`}>
          <div class="card-header">
            <div class="header-left">
              <span class="index-num">{area.index}</span>
              <h2 id={`focus-${area.index}`}>{area.category}</h2>
            </div>
            <span class={`status-pill ${area.status.toLowerCase().replace(/\s+/g, '-')}`}>
              {area.status}
            </span>
          </div>

          <ul class="focus-list">
            {area.items.map((item) => (
              <li>
                <span class="bullet" aria-hidden="true">→</span>
                <span>
                  {item.text}
                  {item.link && (
                    <a href={item.link.url} target={item.link.url.startsWith('http') ? '_blank' : undefined} rel={item.link.url.startsWith('http') ? 'noopener' : undefined}>
                      {item.link.text}
                    </a>
                  )}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <footer class="now-meta-footer">
      <p>
        Updated <time datetime={lastUpdated.toISOString()}>{formatTalkDate(lastUpdated.toISOString().slice(0, 10))}</time> · Based on the <a href="https://nownownow.com/about" target="_blank" rel="noopener">/now page movement</a> by Derek Sivers.
      </p>
    </footer>
  </main>
</Layout>

<style>
  .now-page {
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }

  .now-grid {
    display: grid;
    border-top: 1px solid var(--ie-rule-strong);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .now-card {
    display: grid;
    grid-template-columns: minmax(13rem, 0.68fr) minmax(0, 1.32fr);
    gap: clamp(2rem, 5vw, 4rem);
    padding: clamp(1.5rem, 3vw, 2rem) 0;
    border-bottom: 1px solid var(--ie-rule);
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 0.75rem;
  }

  .header-left {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .index-num {
    color: var(--ie-blue);
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    font-weight: 600;
  }

  .card-header h2 {
    margin: 0;
    color: var(--ie-ink);
    font-family: var(--font-display);
    font-size: var(--ie-type-h3);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .status-pill.active {
    color: var(--ie-blue);
  }

  .status-pill.in-progress {
    color: var(--ie-rust);
  }

  .status-pill.exploring,
  .status-pill.upcoming {
    color: var(--ie-muted);
  }

  .focus-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }

  .focus-list li {
    display: flex;
    gap: 0.55rem;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-ui);
    line-height: 1.55;
  }

  .bullet {
    color: var(--ie-blue);
    font-weight: 600;
    flex-shrink: 0;
  }

  .focus-list a {
    color: var(--ie-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .now-meta-footer {
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--ie-rule);
    text-align: center;
  }

  .now-meta-footer p {
    margin: 0;
    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
  }

  .now-meta-footer a {
    color: var(--ie-ink-secondary);
  }

  .now-meta-footer a:hover {
    color: var(--ie-blue);
  }

  @media (max-width: 680px) {
    .now-card {
      grid-template-columns: 1fr;
      gap: 1.15rem;
    }

    .card-header {
      gap: 0.55rem;
    }
  }
</style>
