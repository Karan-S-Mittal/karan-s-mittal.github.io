---
import ExcalidrawContainer from './ExcalidrawContainer.astro';

interface Props {
  caption?: string;
  exhibit?: string;
  title?: string;
}

const { caption, exhibit, title } = Astro.props;
---

<ExcalidrawContainer caption={caption} exhibit={exhibit} title={title} badge="COPY-ON-WRITE SHARING">
  <svg class="ex-svg-canvas sys-diagram" viewBox="0 0 720 370" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Two logical sequences share their prompt KV pages and allocate separate physical frames only after they diverge.">
    <defs>
      <marker id="cow-arr-3" markerWidth="7" markerHeight="6" refX="6" refY="3" orient="auto"><polygon points="0 0, 7 3, 0 6" fill="var(--text)" /></marker>
      <marker id="cow-arr-blue-3" markerWidth="7" markerHeight="6" refX="6" refY="3" orient="auto"><polygon points="0 0, 7 3, 0 6" fill="var(--accent)" /></marker>
    </defs>

    <!-- LEFT COLUMN: LOGICAL SEQUENCES -->
    <g transform="translate(20, 16)">
      <text x="0" y="12" class="label-signal" dominant-baseline="central">LOGICAL SEQUENCES (PARALLEL SAMPLING)</text>
      <text x="0" y="28" class="body-muted" dominant-baseline="central">Both candidates share the common prompt prefix blocks.</text>

      <!-- REQUEST A -->
      <g transform="translate(0, 44)">
        <rect x="0" y="0" width="300" height="92" rx="6" class="node" />
        <text x="12" y="18" class="label-signal" font-size="9.5" dominant-baseline="central">REQUEST A (CANDIDATE 1)</text>

        <!-- Block A0 -->
        <rect x="12" y="32" width="84" height="46" rx="4" class="node-muted" />
        <text x="54" y="48" class="label" font-size="8.5" text-anchor="middle" dominant-baseline="central">PROMPT 00</text>
        <text x="54" y="64" class="body" font-size="9.5" text-anchor="middle" dominant-baseline="central">"The quick"</text>

        <!-- Block A1 -->
        <rect x="104" y="32" width="84" height="46" rx="4" class="node-muted" />
        <text x="146" y="48" class="label" font-size="8.5" text-anchor="middle" dominant-baseline="central">PROMPT 01</text>
        <text x="146" y="64" class="body" font-size="9.5" text-anchor="middle" dominant-baseline="central">"brown fox"</text>

        <!-- Output A -->
        <rect x="196" y="32" width="92" height="46" rx="4" class="node-signal" />
        <text x="242" y="48" class="label-signal" font-size="8.5" text-anchor="middle" dominant-baseline="central">OUTPUT A</text>
        <text x="242" y="64" class="label-signal" font-size="9.5" text-anchor="middle" dominant-baseline="central">"jumps over"</text>
      </g>

      <!-- REQUEST B -->
      <g transform="translate(0, 150)">
        <rect x="0" y="0" width="300" height="92" rx="6" class="node" />
        <text x="12" y="18" class="label-signal" font-size="9.5" dominant-baseline="central">REQUEST B (CANDIDATE 2)</text>

        <!-- Block B0 -->
        <rect x="12" y="32" width="84" height="46" rx="4" class="node-muted" />
        <text x="54" y="48" class="label" font-size="8.5" text-anchor="middle" dominant-baseline="central">PROMPT 00</text>
        <text x="54" y="64" class="body" font-size="9.5" text-anchor="middle" dominant-baseline="central">"The quick"</text>

        <!-- Block B1 -->
        <rect x="104" y="32" width="84" height="46" rx="4" class="node-muted" />
        <text x="146" y="48" class="label" font-size="8.5" text-anchor="middle" dominant-baseline="central">PROMPT 01</text>
        <text x="146" y="64" class="body" font-size="9.5" text-anchor="middle" dominant-baseline="central">"brown fox"</text>

        <!-- Output B -->
        <rect x="196" y="32" width="92" height="46" rx="4" class="node-signal" />
        <text x="242" y="48" class="label-signal" font-size="8.5" text-anchor="middle" dominant-baseline="central">OUTPUT B</text>
        <text x="242" y="64" class="label-signal" font-size="9.5" text-anchor="middle" dominant-baseline="central">"sleeps all"</text>
      </g>
    </g>

    <!-- CONNECTOR FLOWS -->
    <!-- Prompt 00 (A & B) -> Frame 12 -->
    <path d="M 104 106 C 180 106, 320 84, 420 84" class="flow" marker-end="url(#cow-arr-3)" />
    <path d="M 104 212 C 180 212, 320 84, 420 84" class="flow-dashed" marker-end="url(#cow-arr-3)" />

    <!-- Prompt 01 (A & B) -> Frame 04 -->
    <path d="M 196 106 C 260 106, 320 144, 420 144" class="flow" marker-end="url(#cow-arr-3)" />
    <path d="M 196 212 C 260 212, 320 144, 420 144" class="flow-dashed" marker-end="url(#cow-arr-3)" />

    <!-- Output A -> Frame 31 -->
    <path d="M 320 106 C 360 106, 380 204, 420 204" class="flow-signal" marker-end="url(#cow-arr-blue-3)" />

    <!-- Output B -> Frame 58 -->
    <path d="M 320 212 C 360 212, 380 264, 420 264" class="flow-signal" marker-end="url(#cow-arr-blue-3)" />

    <!-- RIGHT COLUMN: PHYSICAL GPU FRAMES -->
    <g transform="translate(426, 16)">
      <text x="0" y="12" class="label-signal" dominant-baseline="central">PHYSICAL GPU FRAMES (55% MEMORY SAVED)</text>
      <text x="0" y="28" class="body-muted" dominant-baseline="central">Shared prompts live once; private frames created on write.</text>

      <!-- Frame 12 (Shared) -->
      <g transform="translate(0, 44)">
        <rect x="0" y="0" width="274" height="48" rx="6" class="node-signal" />
        <text x="12" y="18" class="title" font-size="13" dominant-baseline="central">Physical Frame #12</text>
        <text x="12" y="33" class="label" font-size="8.5" dominant-baseline="central">PROMPT 00</text>
        <rect x="176" y="12" width="88" height="24" rx="4" fill="var(--ex-blue-bg)" stroke="var(--ex-blue-stroke)" stroke-width="1.2" />
        <text x="220" y="24" class="label-signal" font-size="8.5" text-anchor="middle" font-weight="600" dominant-baseline="central">ref count: 2</text>
      </g>

      <!-- Frame 04 (Shared) -->
      <g transform="translate(0, 104)">
        <rect x="0" y="0" width="274" height="48" rx="6" class="node-signal" />
        <text x="12" y="18" class="title" font-size="13" dominant-baseline="central">Physical Frame #04</text>
        <text x="12" y="33" class="label" font-size="8.5" dominant-baseline="central">PROMPT 01</text>
        <rect x="176" y="12" width="88" height="24" rx="4" fill="var(--ex-blue-bg)" stroke="var(--ex-blue-stroke)" stroke-width="1.2" />
        <text x="220" y="24" class="label-signal" font-size="8.5" text-anchor="middle" font-weight="600" dominant-baseline="central">ref count: 2</text>
      </g>

      <!-- Frame 31 (Private Output A) -->
      <g transform="translate(0, 164)">
        <rect x="0" y="0" width="274" height="48" rx="6" class="node" />
        <text x="12" y="18" class="title" font-size="13" dominant-baseline="central">Physical Frame #31</text>
        <text x="12" y="33" class="label" font-size="8.5" dominant-baseline="central">OUTPUT A (Diverged)</text>
        <rect x="176" y="12" width="88" height="24" rx="4" class="node-muted" />
        <text x="220" y="24" class="label" font-size="8.5" text-anchor="middle" dominant-baseline="central">ref count: 1</text>
      </g>

      <!-- Frame 58 (Private Output B) -->
      <g transform="translate(0, 224)">
        <rect x="0" y="0" width="274" height="48" rx="6" class="node" />
        <text x="12" y="18" class="title" font-size="13" dominant-baseline="central">Physical Frame #58</text>
        <text x="12" y="33" class="label" font-size="8.5" dominant-baseline="central">OUTPUT B (Diverged)</text>
        <rect x="176" y="12" width="88" height="24" rx="4" class="node-muted" />
        <text x="220" y="24" class="label" font-size="8.5" text-anchor="middle" dominant-baseline="central">ref count: 1</text>
      </g>
    </g>

    <!-- Bottom note -->
    <line x1="20" y1="324" x2="700" y2="324" class="rule" />
    <text x="20" y="348" class="body-muted" font-size="11.5" dominant-baseline="central">Shared prompt pages have ref count: 2; private physical frames are allocated only after generation branches diverge.</text>
  </svg>
</ExcalidrawContainer>



