---
/**
 * Button.astro — component form of the global .button control.
 * Primary: blue fill, white text, rounded square. Secondary: hairline, blue text.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  target?: string;
  rel?: string;
}

const { href, variant = 'primary', type = 'button', disabled = false, target, rel } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn', `btn-${variant}`, { 'btn-disabled': disabled }]}
  href={href}
  target={href ? target : undefined}
  rel={href ? rel : undefined}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  aria-disabled={disabled ? 'true' : undefined}
>
  <slot />
</Tag>

<style>
  /* Mirrors the global .button / .more-link pair: one blue rounded square,
     and a quiet secondary. No lift, shadow, or glow. */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    gap: var(--space-2);
    padding: 0.6rem 1.25rem;
    font-family: var(--font-sans);
    font-size: var(--ie-type-base);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.2;
    border-radius: var(--radius-control);
    corner-shape: squircle;
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }

  .btn:focus-visible {
    outline: 2px solid var(--interactive-focus);
    outline-offset: 3px;
  }

  .btn-primary {
    background: var(--ie-button);
    color: #fff;
  }

  .btn-primary:hover:not(.btn-disabled) {
    background: var(--ie-button-hover);
    color: #fff;
    text-decoration: none;
  }

  .btn-secondary {
    background: transparent;
    color: var(--ie-blue);
    border-color: var(--ie-rule-strong);
  }

  .btn-secondary:hover:not(.btn-disabled) {
    border-color: var(--ie-blue);
    color: var(--ie-blue);
    text-decoration: none;
  }

  .btn-disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
</style>
