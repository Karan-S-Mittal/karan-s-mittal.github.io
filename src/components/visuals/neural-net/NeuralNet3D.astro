    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label);
  }

  .webgl-fallback strong {
    color: var(--ie-ink);
    font-family: var(--font-sans);
    font-size: var(--ie-type-base);
