---
/**
 * Three concrete engineering paths. A reader selects the kind of system and
 * sees the mechanism, constraint, and definition of inspectability together.
 */
---

<section class="system-map" data-system-map aria-labelledby="system-map-title">
  <div class="map-heading">
    <div>
      <p class="map-kicker">Inspectable systems / three examples</p>
      <h3 id="system-map-title">Select the kind of system you need to understand.</h3>
    </div>
    <p>Each path names what enters, what changes, where it can fail, and what a dependable output contains.</p>
  </div>

  <div class="map-controls" aria-label="Choose a system path">
    <button type="button" data-map-control="0" aria-pressed="true">
      <span>01</span>
      <strong>Knowledge</strong>
      <small>Can the answer be traced?</small>
    </button>
    <button type="button" data-map-control="1" aria-pressed="false">
      <span>02</span>
      <strong>Inference</strong>
      <small>Can the bottleneck be measured?</small>
    </button>
    <button type="button" data-map-control="2" aria-pressed="false">
      <span>03</span>
      <strong>Delivery</strong>
      <small>Can the operating team own it?</small>
    </button>
  </div>

  <div class="mechanism" aria-live="polite">
    <article class="mechanism-step">
      <span>Input</span>
      <strong data-node-title="0">Question</strong>
      <p data-node-body="0">Request, constraints, and permitted source boundaries.</p>
    </article>
    <div class="mechanism-edge" aria-hidden="true"><span data-edge-label="0">retrieve</span></div>
    <article class="mechanism-step">
      <span>Mechanism</span>
      <strong data-node-title="1">Evidence retrieval</strong>
      <p data-node-body="1">Rank sources while keeping provenance attached.</p>
    </article>
    <div class="mechanism-edge" aria-hidden="true"><span data-edge-label="1">test</span></div>
    <article class="mechanism-step constraint-step">
      <span>Constraint</span>
      <strong data-node-title="2">Verification gate</strong>
      <p data-node-body="2">Compare every claim with the evidence that supports it.</p>
    </article>
    <div class="mechanism-edge" aria-hidden="true"><span data-edge-label="2">deliver</span></div>
    <article class="mechanism-step">
      <span>Output</span>
      <strong data-node-title="3">Traceable answer</strong>
      <p data-node-body="3">The answer, citations, and decision boundary together.</p>
    </article>
  </div>

  <div class="map-conclusion">
    <div class="constraint-note">
      <span>Where it fails</span>
      <strong data-constraint>Unsupported claims stop at the verification gate.</strong>
    </div>
    <div class="takeaway-note">
      <span>What inspectable means here</span>
      <strong data-takeaway>Every answer can be traced back to a permitted source.</strong>
    </div>
  </div>

  <p class="accessible-summary" data-accessible-summary>
    A knowledge system accepts a bounded question, retrieves evidence with provenance, rejects unsupported claims, and returns an answer that can be traced to its sources.
  </p>
</section>

<script>
  const SYSTEM_PATHS = [
    {
      nodes: [
        ['Question', 'Request, constraints, and permitted source boundaries.'],
        ['Evidence retrieval', 'Rank sources while keeping provenance attached.'],
        ['Verification gate', 'Compare every claim with the evidence that supports it.'],
        ['Traceable answer', 'The answer, citations, and decision boundary together.'],
      ],
      edges: ['retrieve', 'test', 'deliver'],
      constraint: 'Unsupported claims stop at the verification gate.',
      takeaway: 'Every answer can be traced back to a permitted source.',
      summary: 'A knowledge system accepts a bounded question, retrieves evidence with provenance, rejects unsupported claims, and returns an answer that can be traced to its sources.',
    },
    {
      nodes: [
        ['Workload', 'Traffic shape, token counts, latency target, and cost boundary.'],
        ['Measurement', 'Profile compute, memory movement, queues, and saturation.'],
        ['Measured bottleneck', 'Locate the resource that actually limits the request path.'],
        ['Operating envelope', 'A tested latency, throughput, and cost range.'],
      ],
      edges: ['profile', 'isolate', 'validate'],
      constraint: 'A faster model does not help when another part of the path misses the service target.',
      takeaway: 'Performance can be traced to a measured bottleneck and a repeatable test.',
      summary: 'An inference system begins with a real workload, profiles the complete request path, isolates the limiting resource, and produces a tested operating envelope.',
    },
    {
      nodes: [
        ['Problem', 'The decision, user, owner, and consequence of failure.'],
        ['System boundary', 'Explicit inputs, outputs, dependencies, and responsibilities.'],
        ['Validation', 'Failure cases, acceptance tests, and observable operating signals.'],
        ['Owned system', 'Runbooks, handover, and a team able to operate it.'],
      ],
      edges: ['frame', 'build', 'hand over'],
      constraint: 'The system is unfinished if the operating team cannot diagnose and own it.',
      takeaway: 'Ownership and evidence survive the transition from project to production.',
      summary: 'A delivery system frames a consequential problem, defines its boundary, validates failure cases, and is handed over with the evidence and operating knowledge required for ownership.',
    },
  ];

  function initialiseSystemMaps() {
    document.querySelectorAll<HTMLElement>('[data-system-map]').forEach((root) => {
      if (root.dataset.initialised === 'true') return;
      root.dataset.initialised = 'true';

      const controls = [...root.querySelectorAll<HTMLButtonElement>('[data-map-control]')];
      const titles = [...root.querySelectorAll<HTMLElement>('[data-node-title]')];
      const bodies = [...root.querySelectorAll<HTMLElement>('[data-node-body]')];
      const edges = [...root.querySelectorAll<HTMLElement>('[data-edge-label]')];
      const constraint = root.querySelector<HTMLElement>('[data-constraint]');
      const takeaway = root.querySelector<HTMLElement>('[data-takeaway]');
      const summary = root.querySelector<HTMLElement>('[data-accessible-summary]');

      const setPath = (index: number) => {
        const path = SYSTEM_PATHS[index];
        if (!path) return;

        controls.forEach((control, controlIndex) => {
          control.setAttribute('aria-pressed', String(controlIndex === index));
        });
        path.nodes.forEach(([title, body], nodeIndex) => {
          if (titles[nodeIndex]) titles[nodeIndex].textContent = title;
          if (bodies[nodeIndex]) bodies[nodeIndex].textContent = body;
        });
        path.edges.forEach((label, edgeIndex) => {
          if (edges[edgeIndex]) edges[edgeIndex].textContent = label;
        });
        if (constraint) constraint.textContent = path.constraint;
        if (takeaway) takeaway.textContent = path.takeaway;
        if (summary) summary.textContent = path.summary;
      };

      controls.forEach((control) => {
        control.addEventListener('click', () => setPath(Number(control.dataset.mapControl)));
      });

      setPath(0);
    });
  }

  initialiseSystemMaps();
  document.addEventListener('astro:page-load', initialiseSystemMaps);
</script>

<style>
  .system-map {
    border-top: 2px solid var(--ie-ink);
    border-bottom: 1px solid var(--ie-rule-strong);
  }

  .map-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(260px, 0.85fr);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: end;
    padding: 1.25rem 0 1.5rem;
    border-bottom: 1px solid var(--ie-rule);
  }

  .map-kicker,
  .mechanism-step > span,
  .constraint-note > span,
  .takeaway-note > span {
    margin: 0;
    color: var(--ie-blue);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label);
    font-weight: 600;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .map-heading h3 {
    max-width: 28ch;
    margin: 0.45rem 0 0;
    color: var(--ie-ink);
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.6rem);
    font-weight: 600;
    line-height: 1.12;
  }

  .map-heading > p {
    max-width: 48ch;
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: 1rem;
    line-height: 1.6;
  }

  .map-controls {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 1px solid var(--ie-rule-strong);
  }

  .map-controls button {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.15rem 0.75rem;
    min-height: 88px;
    padding: 1rem;
    border: 0;
    border-right: 1px solid var(--ie-rule);
    background: transparent;
    color: var(--ie-muted);
    text-align: left;
    cursor: pointer;
  }

  .map-controls button:last-child { border-right: 0; }

  .map-controls button > span {
    grid-row: 1 / 3;
    color: var(--ie-blue);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label);
  }

  .map-controls strong {
    color: var(--ie-ink);
    font-size: 1rem;
  }

  .map-controls small {
    color: var(--ie-muted);
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .map-controls button[aria-pressed='true'] {
    background: var(--ie-blue-soft);
    box-shadow: inset 0 -3px 0 var(--ie-blue);
  }

  .map-controls button[aria-pressed='true'] strong,
  .map-controls button[aria-pressed='true'] small {
    color: var(--ie-blue);
  }

  .mechanism {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 56px minmax(0, 1fr) 56px minmax(0, 1fr) 56px minmax(0, 1fr);
    align-items: stretch;
    padding: 2rem 0;
  }

  .mechanism-step {
    min-height: 190px;
    padding: 1.25rem;
    border: 1px solid var(--ie-rule-strong);
    background: var(--ie-surface);
  }

  .mechanism-step > span {
    display: block;
    margin-bottom: 1.75rem;
    color: var(--ie-muted);
  }

  .mechanism-step strong {
    display: block;
    margin-bottom: 0.65rem;
    color: var(--ie-ink);
    font-size: 1.1rem;
    line-height: 1.25;
  }

  .mechanism-step p {
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .constraint-step {
    border: 2px solid var(--ie-rust);
    padding: calc(1.25rem - 1px);
    background: var(--ie-rust-soft);
  }

  .constraint-step > span { color: var(--ie-rust); }

  .mechanism-edge {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mechanism-edge::before {
    content: '';
    position: absolute;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--ie-blue);
  }

  .mechanism-edge::after {
    content: '';
    position: absolute;
    right: 1px;
    width: 7px;
    height: 7px;
    border-top: 1px solid var(--ie-blue);
    border-right: 1px solid var(--ie-blue);
    transform: rotate(45deg);
  }

  .mechanism-edge span {
    position: relative;
    z-index: 1;
    padding: 0.25rem 0.35rem;
    background: var(--ie-surface-raised);
    color: var(--ie-blue);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .map-conclusion {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--ie-rule-strong);
  }

  .constraint-note,
  .takeaway-note {
    min-height: 116px;
    padding: 1.25rem;
  }

  .constraint-note {
    border-right: 1px solid var(--ie-rule);
  }

  .constraint-note > span { color: var(--ie-rust); }

  .constraint-note strong,
  .takeaway-note strong {
    display: block;
    max-width: 54ch;
    margin-top: 0.55rem;
    color: var(--ie-ink);
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .accessible-summary {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .map-heading {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .mechanism {
      grid-template-columns: 1fr;
      padding-block: 1.5rem;
    }

    .mechanism-step {
      min-height: 0;
    }

    .mechanism-step > span {
      margin-bottom: 1rem;
    }

    .mechanism-edge {
      min-height: 48px;
      justify-content: flex-start;
      padding-left: 1.25rem;
    }

    .mechanism-edge::before {
      top: 0;
      bottom: 0;
      left: 1.25rem;
      width: 1px;
      height: auto;
    }

    .mechanism-edge::after {
      right: auto;
      bottom: 2px;
      left: calc(1.25rem - 3px);
      transform: rotate(135deg);
    }

    .mechanism-edge span {
      margin-left: 1rem;
    }
  }

  @media (max-width: 640px) {
    .map-controls {
      grid-template-columns: 1fr;
    }

    .map-controls button {
      min-height: 72px;
      border-right: 0;
      border-bottom: 1px solid var(--ie-rule);
    }

    .map-controls button:last-child { border-bottom: 0; }

    .map-conclusion {
      grid-template-columns: 1fr;
    }

    .constraint-note {
      border-right: 0;
      border-bottom: 1px solid var(--ie-rule);
    }
  }
</style>
