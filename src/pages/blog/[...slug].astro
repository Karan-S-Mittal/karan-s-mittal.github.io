---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getReadingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;
const post = Astro.props;
const { Content, headings } = await render(post);

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const showToc = tocHeadings.length > 2;

const readingTime = getReadingTime(post.body);
const isSystemsEssay = post.id === 'paged-attention-kv-cache';

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={`${post.data.title} | Karan Mittal`}
  description={post.data.description}
  type="article"
  pubDate={post.data.pubDate}
  image={isSystemsEssay ? new URL('/generated/exhibits/paged-attention-model.webp', Astro.site).toString() : undefined}
>
  <main class="container post-layout">
    <article class="post-content">
      <header class="post-header">
        {isSystemsEssay && <img class="post-memory-module" src="/images/paged-attention-memory-module.webp" alt="" aria-hidden="true" width="275" height="1492" />}
        {isSystemsEssay && <p class="post-eyebrow">Systems explainer <span aria-hidden="true">/</span> LLM inference</p>}
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
          <span aria-hidden="true" class="meta-sep">·</span>
          <span>{readingTime} min read</span>
          {post.data.updatedDate && (
            <>
              <span aria-hidden="true" class="meta-sep">·</span>
              <span class="updated">
                Updated {post.data.updatedDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
              </span>
            </>
          )}
        </div>

        <h1>{post.data.title}</h1>

        {isSystemsEssay && <p class="post-standfirst">A visual, first-principles model of why the KV cache becomes the bottleneck in LLM serving—and how virtual-memory ideas make it manageable.</p>}

        {post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map((tag) => (
              <a href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`} class="tag">{tag}</a>
            ))}
          </div>
        )}
      </header>

      {showToc && (
        <div class="post-mobile-toc">
          <TableOfContents headings={tocHeadings} idPrefix="mobile-toc" />
        </div>
      )}

      <Content />

      <footer class="post-footer">
        <p class="back-link">
          <a href="/blog">← All posts</a>
        </p>
      </footer>
    </article>

    {showToc && (
      <aside class="post-sidebar">
        <TableOfContents headings={tocHeadings} idPrefix="desktop-toc" />
      </aside>
    )}
  </main>
</Layout>

<style>
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: var(--space-8);
    max-width: var(--page-max-width);
    align-items: start;
  }
  .post-content {
    min-width: 0;
    max-width: var(--prose-max-width);
  }
  .post-sidebar {
    position: sticky;
    top: 5rem;
    align-self: start;
  }
  .post-mobile-toc {
    display: none;
  }

  .post-header {
    position: relative;
    padding: clamp(2.5rem, 7vw, 5.5rem) 0 2.5rem;
    margin-bottom: 3.5rem;
    border-bottom: 1px solid var(--border);
  }
  .post-memory-module {
    position: absolute;
    top: 1.25rem;
    right: -4rem;
    width: clamp(4.5rem, 7vw, 6rem);
    height: auto;
    pointer-events: none;
    user-select: none;
  }
  .post-eyebrow {
    margin: 0 0 1rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .post-eyebrow span {
    color: var(--border);
    padding: 0 0.35rem;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .meta-sep {
    color: var(--border);
  }
  .updated {
    color: var(--accent);
  }

  .post-header h1 {
    max-width: 15ch;
    margin: 0.75rem 0 1.25rem;
    font-size: clamp(2.625rem, 6vw, 3.5rem); /* 42–56px, spec §4.2 */
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.15;
    color: var(--text);
  }

  .post-standfirst {
    max-width: 61ch;
    margin: 0;
    color: var(--text-secondary);
    font-size: clamp(1.05rem, 1.4vw, 1.22rem);
    line-height: 1.65;
  }

  .post-tags {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
    font-family: var(--font-mono);
  }

  .post-footer {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
  }
  .back-link {
    margin: 0;
  }
  .back-link a {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  @media (max-width: 960px) {
    .post-layout {
      grid-template-columns: 1fr;
      max-width: none;
    }
    .post-sidebar {
      display: none;
    }
    .post-mobile-toc {
      display: block;
      margin: -1rem 0 3rem;
    }
    .post-memory-module {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .post-header { padding-top: 2rem; margin-bottom: 2.5rem; }
    .post-header h1 { font-size: clamp(2.625rem, 12vw, 3.5rem); }
  }
</style>

<style is:global>
  /* Prose rules target markdown-rendered content, so they must be global.
     Colors inherit the themed tokens from global.css in both themes. */
  .post-content > :is(p, li) {
    color: var(--text-secondary);
  }
  .post-content > h2 {
    margin-top: 4.5rem;
    padding-top: 1.1rem;
    scroll-margin-top: 5.5rem;
    font-size: clamp(1.875rem, 3vw, 2.5rem); /* 30–40px, spec §4.2 */
    letter-spacing: -0.035em;
  }
  .post-content > h3 {
    margin-top: 2.75rem;
    scroll-margin-top: 5.5rem;
    font-size: 1.375rem; /* 22px, spec §4.2 h3 floor */
    letter-spacing: -0.02em;
  }
  .post-content > h4 {
    margin: 2rem 0 0.65rem;
    scroll-margin-top: 5.5rem;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .post-content code {
    font-family: var(--font-mono);
  }
  .post-content .katex-display {
    margin: var(--space-5) 0 var(--space-3);
    padding: var(--space-4) var(--space-5);
    overflow-x: auto;
    border: 1px solid var(--border);
    border-left: 2px solid var(--accent);
    border-radius: var(--radius);
    background: var(--bg-inset);
    color: var(--text);
  }
  .post-content .katex-display > .katex {
    min-width: max-content;
    font-size: 1.1em;
  }
  .post-content table {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    table-layout: auto;
    font-size: 0.9rem;
    line-height: 1.45;
  }
  .post-content th,
  .post-content td {
    padding: var(--table-cell-pad-block) var(--table-cell-pad-inline);
    border: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
    overflow-wrap: anywhere;
    word-break: normal;
  }
  .post-content table code {
    white-space: nowrap;
    overflow-wrap: normal;
  }
  .post-content th {
    background: var(--bg-inset);
    color: var(--text);
    font-weight: 600;
  }
  .post-content td {
    color: var(--text-secondary);
  }
  .post-content .formula-note {
    margin: 0 0 var(--space-5);
    padding-left: var(--space-3);
    border-left: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .post-layout .tag:hover,
  .post-layout .back-link a {
    color: var(--accent);
  }
  .post-layout .post-sidebar .toc-root {
    position: sticky;
    top: 5.5rem;
  }
  .post-mobile-toc .toc-root {
    margin-bottom: 2rem;
  }

  @media (max-width: 640px) {
    .ex-canvas-frame { padding: 1rem; }
    .post-content .katex-display {
      padding: var(--space-3);
      font-size: 0.88rem;
    }
    .post-content .katex-display > .katex {
      min-width: 0;
      font-size: 0.95em;
      white-space: normal;
    }
    .post-content table {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .post-content th,
    .post-content td {
      min-width: 10rem;
      padding: var(--table-cell-pad-block) var(--table-cell-pad-inline);
    }
  }
</style>
