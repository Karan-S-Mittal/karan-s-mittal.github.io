---
import VisualPage from '@layouts/VisualPage.astro';
import PlatformStackHierarchy from '@components/diagram/version-control/PlatformStackHierarchy.astro';
import { getDiagramBySlug } from '@data/diagrams';

const diagram = getDiagramBySlug('developer-platform-stack')!;
---

<VisualPage
  title={diagram.title}
  description={diagram.description}
  explanation={diagram.explanation}
  targetId={diagram.targetId}
  filename={diagram.filename}
  category={diagram.category}
  drawingNo={diagram.canonicalId}
>
  <div class="visual-wrapper">
    <PlatformStackHierarchy id="platform-stack-diagram" />
  </div>
</VisualPage>

<style>
  .visual-wrapper {
    width: 100%;
    padding: 1.5rem 0.5rem;
  }
</style>
