---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/portfolio/PageHeader.astro';
import WorkCard from '../components/portfolio/WorkCard.astro';
import workData from '../data/work.json';

const { work } = workData;
---

<Layout
  title="Selected Work | Karan Mittal"
  description="How Karan Mittal approaches deterministic engineering for complex data and AI systems."
>
  <main class="container">
    <PageHeader
      label="Engineering practice"
      title="From uncertain AI work to systems a team can operate."
      description="Three recurring classes of engagement, documented as system lenses. Client and implementation details remain confidential."
    />

    <div class="principle">
      <span aria-hidden="true">↳</span>
      <p>Reliability is not a feature added at the end. It is a set of explicit choices about evidence, constraints, failure modes, and ownership.</p>
    </div>

    <div class="work-list">
      {work.map((item, index) => <WorkCard item={item} index={String(index + 1).padStart(2, '0')} detailed />)}
    </div>

    <section class="case-study-row">
      <div>
        <p class="label">Case study</p>
        <h2>A public example: rebuilding this site on a written design contract.</h2>
        <p>The same reasoning spine &mdash; ambiguity, constraint, system, evidence, aftermath &mdash; applied to an implementation whose claims can be checked directly in the repository.</p>
      </div>
      <a href="/case-studies/soft-architecture/" class="arrow-link">Read the case study<span class="arrow" aria-hidden="true">&rarr;</span></a>
    </section>

    <section class="engagement">
      <div>
        <p class="label">Consulting</p>
        <h2>Bring the difficult system question.</h2>
        <p>I work with teams navigating knowledge systems, AI reliability, performance constraints, and the transition from prototype to production.</p>
      </div>
      <a href="/#contact" class="quiet-btn">Discuss an engagement</a>
    </section>
  </main>
</Layout>

<style>
  main.container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 var(--space-5) var(--space-9);
  }

  .principle {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    max-width: 680px;
    margin: 0 0 var(--space-8);
    padding: var(--space-4) var(--space-5);
    border-left: 3px solid var(--accent);
    background: var(--surface-card);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    box-shadow: var(--shadow-sm);
  }
  .principle span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 1.125rem;
  }
  .principle p {
    margin: 0;
    color: var(--text);
    font-size: 0.9375rem;
    line-height: 1.65;
    font-style: italic;
  }

  .work-list {
    display: grid;
    gap: var(--space-6);
  }

  .work-list :global(.studio-panel) {
    scroll-margin-top: 5rem;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .case-study-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-top: var(--space-9);
    padding: var(--space-7);
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }
  .case-study-row .label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2);
  }
  .case-study-row h2 {
    font-family: var(--font-serif);
    margin: 0 0 var(--space-2);
    font-size: clamp(1.35rem, 2.5vw, 1.65rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--text);
  }
  .case-study-row p:not(.label) {
    max-width: 540px;
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .case-study-row .arrow-link {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }
  .case-study-row .arrow-link:hover {
    color: var(--accent-hover);
    transform: translateX(2px);
    text-decoration: none;
  }

  .engagement {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-top: var(--space-7);
    padding: var(--space-8) var(--space-7);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
    background: var(--surface-card);
    box-shadow: var(--shadow-card);
  }
  .engagement .label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2);
  }
  .engagement h2 {
    font-family: var(--font-serif);
    margin: 0 0 var(--space-3);
    font-size: clamp(1.65rem, 3vw, 2.25rem);
    font-weight: 500;
    color: var(--text);
  }
  .engagement p:not(.label) {
    max-width: 520px;
    margin: 0;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
  }
  .engagement .quiet-btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: var(--ink-900);
    color: #ffffff !important;
    font-size: var(--text-sm);
    font-weight: 500;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }
  .engagement .quiet-btn:hover {
    background: #000;
    transform: translateY(-1px);
    text-decoration: none;
  }
  html.dark .engagement .quiet-btn {
    background: var(--accent);
    color: #fff !important;
  }

  @media (max-width: 768px) {
    main.container {
      padding: 0 var(--space-4) var(--space-8);
    }
    .case-study-row {
      align-items: flex-start;
      flex-direction: column;
      padding: var(--space-6);
    }
    .engagement {
      align-items: flex-start;
      flex-direction: column;
      padding: var(--space-6);
    }
  }
</style>
