---
import Exhibit from '../../editorial/Exhibit.astro';

interface Props { caption?: string; exhibit?: string; title?: string; }

const {
  caption = 'For the same eight query heads, MHA stores eight K/V heads, GQA shares two K/V heads across query groups, and MQA shares one K/V head across every query. Fewer stored K/V heads reduce cache capacity and bandwidth requirements.',
  exhibit = '02',
  title = 'The quantity that changes from MHA to GQA to MQA',
} = Astro.props;

const modes = [
  { name: 'MHA', detail: 'No sharing', kv: 8, ratio: '8 Q : 8 KV', relative: '1.0× cache units', tone: 'constraint' },
  { name: 'GQA', detail: 'Grouped sharing', kv: 2, ratio: '8 Q : 2 KV', relative: '0.25× cache units', tone: 'active' },
  { name: 'MQA', detail: 'Full sharing', kv: 1, ratio: '8 Q : 1 KV', relative: '0.125× cache units', tone: 'neutral' },
];
---

<Exhibit exhibit={exhibit} title={title} badge="KV HEAD GEOMETRY" caption={caption} wide>
  <div class="head-comparison">
    <header class="comparison-question">
      <span>Question</span>
      <strong>For eight query heads, how many key/value heads must the cache retain?</strong>
    </header>

    <div class="mode-grid">
      {modes.map((mode) => (
        <article class:list={['mode', mode.tone]}>
          <div class="mode-heading">
            <span>{mode.name}</span>
            <div><strong>{mode.ratio}</strong><small>{mode.detail}</small></div>
          </div>

          <div class="head-row">
            <span class="row-label">Query heads</span>
            <div class="boxes query-boxes" aria-label="Eight query heads">
              {Array.from({ length: 8 }, (_, index) => <i>Q{index + 1}</i>)}
            </div>
          </div>

          <div class="sharing-arrow" aria-hidden="true">↓ share across groups ↓</div>

          <div class="head-row">
            <span class="row-label">Stored K/V heads</span>
            <div class="boxes kv-boxes" aria-label={`${mode.kv} stored key value heads`}>
              {Array.from({ length: mode.kv }, (_, index) => <i>KV{index + 1}</i>)}
            </div>
          </div>

          <p class="mode-result"><strong>{mode.relative}</strong><span>relative to MHA</span></p>
        </article>
      ))}
    </div>

    <aside class="head-takeaway">
      <span>What changes</span>
      <p>The number of query heads stays fixed. Only the number of retained K/V head sets falls. That directly reduces how much cache data the decoder stores and moves.</p>
    </aside>
  </div>
</Exhibit>

<style>
  .head-comparison { width: 100%; }

  .comparison-question,
  .head-takeaway {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1rem 0;
    border-top: 2px solid var(--ie-ink, var(--text));
    border-bottom: 1px solid var(--ie-rule-strong, var(--border-default));
  }

  .comparison-question > span,
  .head-takeaway > span,
  .row-label,
  .mode-heading > span {
    color: var(--ie-blue, var(--accent));
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .comparison-question strong {
    color: var(--ie-ink, var(--text));
    font-size: 1rem;
    font-weight: 550;
  }

  .mode-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .mode {
    padding: 1.35rem;
    border-right: 1px solid var(--ie-rule, var(--border-default));
  }

  .mode:last-child { border-right: 0; }
  .mode.active { background: var(--ie-blue-soft, var(--accent-subtle)); }

  .mode-heading {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 0.7rem;
    min-height: 68px;
    border-bottom: 1px solid var(--ie-rule, var(--border-default));
  }

  .mode.constraint .mode-heading > span { color: var(--ie-rust, var(--signal-warm)); }
  .mode-heading div { display: flex; flex-direction: column; }
  .mode-heading strong { color: var(--ie-ink, var(--text)); font-size: 1rem; }
  .mode-heading small { color: var(--ie-muted, var(--text-muted)); font-size: 0.88rem; }

  .head-row { padding-top: 1rem; }
  .row-label { display: block; margin-bottom: 0.55rem; color: var(--ie-muted, var(--text-muted)); }

  .boxes { display: grid; gap: 0.3rem; }
  .query-boxes { grid-template-columns: repeat(4, 1fr); }
  .kv-boxes { grid-template-columns: repeat(4, 1fr); }

  .boxes i {
    display: flex;
    min-height: 34px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--ie-rule-strong, var(--border-default));
    border-radius: 3px;
    color: var(--ie-ink-secondary, var(--text-secondary));
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-style: normal;
  }

  .kv-boxes i {
    border-color: var(--ie-blue, var(--accent));
    color: var(--ie-blue, var(--accent));
  }

  .sharing-arrow {
    margin-top: 0.9rem;
    color: var(--ie-muted, var(--text-muted));
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-align: center;
  }

  .mode-result {
    display: flex;
    flex-direction: column;
    margin: 1.25rem 0 0;
    padding-top: 0.8rem;
    border-top: 1px solid var(--ie-rule, var(--border-default));
  }

  .mode-result strong { color: var(--ie-ink, var(--text)); font-size: 1rem; }
  .mode-result span { color: var(--ie-muted, var(--text-muted)); font-size: 0.85rem; }

  .head-takeaway { border-top-width: 1px; }
  .head-takeaway p { margin: 0; color: var(--ie-ink-secondary, var(--text-secondary)); font-size: 0.95rem; line-height: 1.55; }

  @media (max-width: 800px) {
    .mode-grid { grid-template-columns: 1fr; }
    .mode { border-right: 0; border-bottom: 1px solid var(--ie-rule-strong, var(--border-default)); }
    .mode:last-child { border-bottom: 0; }
    .comparison-question, .head-takeaway { grid-template-columns: 1fr; gap: 0.4rem; }
  }
</style>
