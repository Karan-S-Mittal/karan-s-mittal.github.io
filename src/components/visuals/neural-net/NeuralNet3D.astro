</style>

<script>
  import * as THREE from 'three';
  import { BaseThreeElement } from '../../visual-engine/core/BaseThreeElement';
  import { lerp } from '../../visual-engine/math/interpolations';

  interface Synapse {
    source: THREE.Vector3;
    target: THREE.Vector3;
    sourceNodeIndex: number;
    targetNodeIndex: number;
    layerIndex: number;
    weight: number;
    lineMesh: THREE.Line;
  }

  interface PulseParticle {
    synapseIndex: number;
    progress: number;
    speed: number;
  }

  interface Chapter {
    id: number;
    kicker: string;
    title: string;
    mode: 'forward' | 'backward';
    pruning: number;
    cameraAngle: { x: number; y: number; z: number };
    body: string;
    formula: string;
    note: string;
  }

  const CHAPTERS: Chapter[] = [
    {
      id: 0,
      kicker: 'Chapter 01 / Input Manifold',
      title: 'Input Vector & Feature Activation Space (x)',
      mode: 'forward',
      pruning: 0.05,
      cameraAngle: { x: -2.5, y: 1.2, z: 13.5 },
      body: 'The network receives a 4-dimensional input feature vector. Each node activation reflects an incoming signal intensity (such as token embedding coordinates, sensory measurements, or image pixel luminance).',
      formula: 'a_i^(0) = x_i ∈ [0, 1]',
      note: '← Initial feature activations at layer 0',
    },
    {
      id: 1,
      kicker: 'Chapter 02 / Synaptic Flow',
      title: 'Linear Transform & Forward Signal Pulses (Wx + b)',
      mode: 'forward',
      pruning: 0.15,
      cameraAngle: { x: 0, y: 1.5, z: 14 },
      body: 'Signals propagate left-to-right across hidden layers. Each downstream neuron computes a weighted sum followed by non-linear gating. Excitatory weights (instrument blue) amplify salient signals, while inhibitory weights (rust) suppress noise.',
      formula: 'z_j^(l) = ∑ w_ji a_i^(l-1) + b_j',
      note: '← Forward activation pulses cross synaptic paths',
    },
    {
      id: 2,
      kicker: 'Chapter 03 / Error Propagation',
      title: 'Backpropagation & Loss Gradients (∇_W L)',
      mode: 'backward',
      pruning: 0.15,
      cameraAngle: { x: 2.5, y: 1.8, z: 13.5 },
      body: 'The chain rule in reverse: output prediction error propagates backwards through the network. Amber gradient waves compute parameter sensitivities ∂L/∂W to steer the weights toward lower empirical risk.',
      formula: '∂L/∂w_ji = (∂L/∂a_j) · σ\'(z_j) · a_i',
      note: '← Reverse gradient wave computes exact weight updates',
    },
    {
      id: 3,
      kicker: 'Chapter 04 / Sparse Geometry',
      title: 'Magnitude Pruning & Optimal Sparse Subnet',
      mode: 'forward',
      pruning: 0.55,
      cameraAngle: { x: 0, y: 2.2, z: 12.5 },
      body: 'Connections with near-zero synaptic influence are pruned. Over 40% of redundant weights fade away without degrading inference quality—drastically bounding memory bandwidth and latency.',
      formula: '|w_ji| ≥ τ  (Sparse Matrix Optimization)',
      note: '← Subnet sparsity eliminates memory & compute waste',
    },
  ];

  class NeuralNet3DElement extends BaseThreeElement {
    private layers: number[] = [4, 7, 7, 3];
    private nodeMeshes: THREE.Mesh[][] = [];
    private nodePositions: THREE.Vector3[][] = [];
    private synapses: Synapse[] = [];
    private pulses: PulseParticle[] = [];
    private pulsePoints!: THREE.Points;
    private pulsePositions!: Float32Array;
    private pulseColors!: Float32Array;

    private currentChapter: number = 0;
    private isPlaying: boolean = false;
    private playTimer: ReturnType<typeof setInterval> | null = null;

    private mode: 'forward' | 'backward' = 'forward';
    private weightThreshold: number = 0.05;
    private targetCameraPos = new THREE.Vector3(0, 1.5, 14);

    private nodeGeometry = new THREE.SphereGeometry(0.35, 24, 24);
    private positiveLineMaterial!: THREE.LineBasicMaterial;
    private negativeLineMaterial!: THREE.LineBasicMaterial;
    private nodeMaterial!: THREE.MeshStandardMaterial;
    private controlsAbortController: AbortController | null = null;

    public override connectedCallback(): void {
      try {
        super.connectedCallback();
      } catch (error) {
        console.warn('Neural network WebGL view unavailable', error);
        this.classList.add('webgl-unavailable');
      }
    }

    protected initScene(): void {
      const rawLayers = this.getAttribute('data-layers');
      if (rawLayers) {
        try {
          this.layers = JSON.parse(rawLayers);
        } catch (e) {
          console.error(e);
        }
      }

      this.camera.position.set(CHAPTERS[0].cameraAngle.x, CHAPTERS[0].cameraAngle.y, CHAPTERS[0].cameraAngle.z);
      this.targetCameraPos.copy(this.camera.position);

      // Lighting
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.85);
      this.scene.add(ambientLight);

      const dirLight = new THREE.DirectionalLight(0xffffff, 1.2);
      dirLight.position.set(10, 20, 15);
      this.scene.add(dirLight);

      const pointLight = new THREE.PointLight(0x2857d9, 2, 50);
      pointLight.position.set(0, 0, 8);
      this.scene.add(pointLight);

      this.buildMaterials();
      this.buildNetwork();
      this.buildPulseParticles();
      this.initStoryControls();

      this.setChapter(0, false);
      this.startAnimation();
    }

    private buildMaterials(): void {
      const isDark = this.themeColors.isDark;

      this.nodeMaterial = new THREE.MeshStandardMaterial({
        color: new THREE.Color(this.themeColors.surfaceCard),
        roughness: 0.2,
        metalness: 0.1,
        emissive: new THREE.Color(this.themeColors.accent),
        emissiveIntensity: isDark ? 0.4 : 0.18,
      });

      this.positiveLineMaterial = new THREE.LineBasicMaterial({
        color: new THREE.Color(this.themeColors.accent),
        transparent: true,
        opacity: 0.38,
      });

      this.negativeLineMaterial = new THREE.LineBasicMaterial({
        color: new THREE.Color(this.themeColors.signalWarm),
        transparent: true,
        opacity: 0.38,
      });
    }

    private updateThemeMaterials(): void {
      const isDark = this.themeColors.isDark;
      const surface = new THREE.Color(this.themeColors.surfaceCard);
      const accent = new THREE.Color(this.themeColors.accent);
      const warm = new THREE.Color(this.themeColors.signalWarm);

      this.nodeMaterial?.color.copy(surface);
      this.nodeMaterial?.emissive.copy(accent);
      if (this.nodeMaterial) this.nodeMaterial.emissiveIntensity = isDark ? 0.4 : 0.18;
      this.positiveLineMaterial?.color.copy(accent);
      this.negativeLineMaterial?.color.copy(warm);

      this.nodeMeshes.forEach((layer) => layer.forEach((mesh) => {
        const material = mesh.material as THREE.MeshStandardMaterial;
        material.color.copy(surface);
        material.emissive.copy(accent);
        material.emissiveIntensity = isDark ? 0.4 : 0.18;
        material.needsUpdate = true;
      }));

      this.synapses.forEach((synapse) => {
        const material = synapse.lineMesh.material as THREE.LineBasicMaterial;
        material.color.copy(synapse.weight >= 0 ? accent : warm);
        material.needsUpdate = true;
      });
    }

    private buildNetwork(): void {
      const layerSpacing = 4.2;
      const totalWidth = (this.layers.length - 1) * layerSpacing;
      const startX = -totalWidth / 2;

      this.nodeMeshes = [];
      this.nodePositions = [];
      this.synapses = [];

      this.layers.forEach((nodeCount, lIdx) => {
        const x = startX + lIdx * layerSpacing;
        const nodeSpacing = 1.4;
        const totalHeight = (nodeCount - 1) * nodeSpacing;
        const startY = totalHeight / 2;

        const layerMeshes: THREE.Mesh[] = [];
        const layerPositions: THREE.Vector3[] = [];

        for (let i = 0; i < nodeCount; i++) {
          const y = startY - i * nodeSpacing;
          const z = Math.sin((i / (nodeCount - 1 || 1)) * Math.PI) * 0.8 - 0.4;
          const pos = new THREE.Vector3(x, y, z);
          layerPositions.push(pos);

          const mesh = new THREE.Mesh(this.nodeGeometry, this.nodeMaterial.clone());
          mesh.position.copy(pos);
          this.scene.add(mesh);
          layerMeshes.push(mesh);
        }

        this.nodeMeshes.push(layerMeshes);
        this.nodePositions.push(layerPositions);
      });

      for (let l = 0; l < this.layers.length - 1; l++) {
        const fromNodes = this.nodePositions[l];
        const toNodes = this.nodePositions[l + 1];

        fromNodes.forEach((fromPos, srcIdx) => {
          toNodes.forEach((toPos, tgtIdx) => {
            const seed = srcIdx * 17 + tgtIdx * 31 + l * 101;
            const weight = Math.sin(seed);

            const points = [fromPos, toPos];
            const geom = new THREE.BufferGeometry().setFromPoints(points);
            const isPos = weight >= 0;
            const mat = (isPos ? this.positiveLineMaterial : this.negativeLineMaterial).clone();
            mat.opacity = Math.max(0.06, Math.abs(weight) * 0.45);

            const lineMesh = new THREE.Line(geom, mat);
            this.scene.add(lineMesh);

            this.synapses.push({
              source: fromPos,
              target: toPos,
              sourceNodeIndex: srcIdx,
              targetNodeIndex: tgtIdx,
              layerIndex: l,
              weight,
              lineMesh,
            });
          });
        });
      }

      this.updateWeightVisibility();
    }

    private buildPulseParticles(): void {
      const maxParticles = 320;
      this.pulses = [];
      this.pulsePositions = new Float32Array(maxParticles * 3);
      this.pulseColors = new Float32Array(maxParticles * 3);

      for (let i = 0; i < maxParticles; i++) {
        const synIdx = Math.floor(Math.random() * this.synapses.length);
        this.pulses.push({
          synapseIndex: synIdx,
          progress: Math.random(),
          speed: 0.007 + Math.random() * 0.007,
        });
      }

      const geom = new THREE.BufferGeometry();
      geom.setAttribute('position', new THREE.BufferAttribute(this.pulsePositions, 3));
      geom.setAttribute('color', new THREE.BufferAttribute(this.pulseColors, 3));

      const mat = new THREE.PointsMaterial({
        size: 0.24,
        vertexColors: true,
        transparent: true,
        opacity: 0.92,
        blending: THREE.AdditiveBlending,
      });

      this.pulsePoints = new THREE.Points(geom, mat);
      this.scene.add(this.pulsePoints);
    }

    private updateWeightVisibility(): void {
      this.synapses.forEach((syn) => {
        const visible = Math.abs(syn.weight) >= this.weightThreshold;
        syn.lineMesh.visible = visible;
      });
    }

    private setChapter(chapterIndex: number, pausePlay: boolean = true): void {
      if (chapterIndex < 0 || chapterIndex >= CHAPTERS.length) return;
      this.currentChapter = chapterIndex;
      const chapter = CHAPTERS[chapterIndex];

      if (pausePlay && this.isPlaying) {
        this.stopAutoPlay();
      }

      this.mode = chapter.mode;
      this.weightThreshold = chapter.pruning;
      this.targetCameraPos.set(chapter.cameraAngle.x, chapter.cameraAngle.y, chapter.cameraAngle.z);
      this.updateWeightVisibility();

      const tabs = this.querySelectorAll('.chapter-tab');
      tabs.forEach((tab, idx) => {
        const isActive = idx === chapterIndex;
        tab.classList.toggle('active', isActive);
        tab.setAttribute('aria-selected', String(isActive));
      });

      const kicker = this.querySelector('[data-story-kicker]');
      const title = this.querySelector('[data-story-title]');
      const body = this.querySelector('[data-story-body]');
      const formulaCode = this.querySelector('[data-formula-code]');
      const formulaNote = this.querySelector('[data-formula-note]');
      const indicator = this.querySelector('[data-step-indicator]');
      const prevBtn = this.querySelector('[data-step-prev]') as HTMLButtonElement;
      const nextBtn = this.querySelector('[data-step-next]') as HTMLButtonElement;

      if (kicker) kicker.textContent = chapter.kicker;
      if (title) title.textContent = chapter.title;
      if (body) body.textContent = chapter.body;
      if (formulaCode) formulaCode.textContent = chapter.formula;
      if (formulaNote) formulaNote.textContent = chapter.note;
      if (indicator) indicator.textContent = `${chapterIndex + 1} of ${CHAPTERS.length}`;
      if (prevBtn) prevBtn.disabled = chapterIndex === 0;
      if (nextBtn) nextBtn.disabled = chapterIndex === CHAPTERS.length - 1;
    }

    private toggleAutoPlay(): void {
      if (this.isPlaying) {
        this.stopAutoPlay();
      } else {
        this.startAutoPlay();
      }
    }

    private startAutoPlay(): void {
      this.isPlaying = true;
      const playBtn = this.querySelector('[data-story-play]') as HTMLElement;
      if (playBtn) {
        playBtn.classList.add('playing');
        playBtn.setAttribute('aria-pressed', 'true');
        const label = playBtn.querySelector('.play-label');
        const icon = playBtn.querySelector('.play-icon');
        if (label) label.textContent = 'Pause Story';
        if (icon) icon.textContent = '⏸';
      }

      if (this.playTimer) clearInterval(this.playTimer);
      this.playTimer = setInterval(() => {
        const nextIdx = (this.currentChapter + 1) % CHAPTERS.length;
        this.setChapter(nextIdx, false);
      }, 5200);
    }

    private stopAutoPlay(): void {
      this.isPlaying = false;
      if (this.playTimer) {
        clearInterval(this.playTimer);
        this.playTimer = null;
      }
      const playBtn = this.querySelector('[data-story-play]') as HTMLElement;
      if (playBtn) {
        playBtn.classList.remove('playing');
        playBtn.setAttribute('aria-pressed', 'false');
        const label = playBtn.querySelector('.play-label');
        const icon = playBtn.querySelector('.play-icon');
        if (label) label.textContent = 'Play Story';
        if (icon) icon.textContent = '▶';
      }
    }

    private initStoryControls(): void {
      this.controlsAbortController?.abort();
      this.controlsAbortController = new AbortController();
      const { signal } = this.controlsAbortController;

      const tabs = this.querySelectorAll('.chapter-tab');
      tabs.forEach((tab) => {
        tab.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const chIdx = parseInt(target.dataset.chapter || '0', 10);
          this.setChapter(chIdx);
        }, { signal });
      });

      const playBtn = this.querySelector('[data-story-play]');
      playBtn?.addEventListener('click', () => {
        this.toggleAutoPlay();
      }, { signal });

      const prevBtn = this.querySelector('[data-step-prev]');
      prevBtn?.addEventListener('click', () => {
        this.setChapter(this.currentChapter - 1);
      }, { signal });

      const nextBtn = this.querySelector('[data-step-next]');
      nextBtn?.addEventListener('click', () => {
        this.setChapter(this.currentChapter + 1);
      }, { signal });

      const canvasContainer = this.querySelector('[data-canvas-container]') as HTMLElement;
      canvasContainer?.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(event.key)) return;
        event.preventDefault();
        const target = this.controls?.target || new THREE.Vector3();
        const offset = this.camera.position.clone().sub(target);
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          offset.applyAxisAngle(new THREE.Vector3(0, 1, 0), event.key === 'ArrowLeft' ? 0.12 : -0.12);
        } else {
          offset.y += event.key === 'ArrowUp' ? 0.35 : -0.35;
        }
        this.camera.position.copy(target).add(offset);
        this.camera.lookAt(target);
        this.renderFrame(performance.now());
      }, { signal });
    }

    protected render(time: number): void {
      this.camera.position.lerp(this.targetCameraPos, 0.04);
      this.camera.lookAt(0, 0, 0);

      const isForward = this.mode === 'forward';
      const posAttr = this.pulsePoints.geometry.getAttribute('position') as THREE.BufferAttribute;
      const colAttr = this.pulsePoints.geometry.getAttribute('color') as THREE.BufferAttribute;

      const accentColor = new THREE.Color(this.themeColors.accent);
      const signalColor = new THREE.Color(this.themeColors.signalWarm);

      this.pulses.forEach((pulse, i) => {
        const syn = this.synapses[pulse.synapseIndex];
        if (!syn || !syn.lineMesh.visible) {
          pulse.synapseIndex = Math.floor(Math.random() * this.synapses.length);
          return;
        }

        pulse.progress += pulse.speed;
        if (pulse.progress > 1) {
          pulse.progress = 0;
          pulse.synapseIndex = Math.floor(Math.random() * this.synapses.length);
        }

        const t = isForward ? pulse.progress : 1 - pulse.progress;
        const x = lerp(syn.source.x, syn.target.x, t);
        const y = lerp(syn.source.y, syn.target.y, t);
        const z = lerp(syn.source.z, syn.target.z, t);

        posAttr.setXYZ(i, x, y, z);
        const particleColor = isForward ? (syn.weight >= 0 ? accentColor : signalColor) : signalColor;
        colAttr.setXYZ(i, particleColor.r, particleColor.g, particleColor.b);
      });

      posAttr.needsUpdate = true;
      colAttr.needsUpdate = true;

      this.nodeMeshes.forEach((layerMeshes, lIdx) => {
        layerMeshes.forEach((mesh, nIdx) => {
          const wavePhase = (time * 0.003) - (isForward ? lIdx : (this.layers.length - 1 - lIdx)) * 1.2;
          const pulse = (Math.sin(wavePhase) + 1) * 0.5;
          const scale = 1 + pulse * 0.15;
          mesh.scale.set(scale, scale, scale);

          const mat = mesh.material as THREE.MeshStandardMaterial;
          mat.emissiveIntensity = 0.2 + pulse * 0.5;
        });
      });
    }

    protected onResize(): void {}

    protected onThemeChange(): void {
      this.updateThemeMaterials();
    }

    protected onDestroy(): void {
      this.stopAutoPlay();
      this.controlsAbortController?.abort();
      this.controlsAbortController = null;
      this.nodeGeometry.dispose();
      this.nodeMaterial?.dispose();
      this.positiveLineMaterial?.dispose();
      this.negativeLineMaterial?.dispose();
    }
  }

  if (!customElements.get('neural-net-3d')) {
    customElements.define('neural-net-3d', NeuralNet3DElement);
  }
</script>
