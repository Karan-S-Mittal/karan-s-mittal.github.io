---
const currentPath = Astro.url.pathname;

interface Props {
  variant?: 'default' | 'instrumented';
}

const { variant = 'default' } = Astro.props;
const isInstrumented = variant === 'instrumented';

const nav = [
  { href: '/work', label: 'Work' },
  { href: '/blog', label: 'Blog' },
  { href: '/about#community', label: 'Community' },
  { href: '/about', label: 'About' },
  { href: '/talks', label: 'Talks' },
];

function isActive(href: string) {
  if (href.includes('#')) return false;
  if (href === '/blog') return currentPath.startsWith('/blog');
  if (href === '/work') return currentPath.startsWith('/work');
  if (href === '/about') return currentPath === '/about';
  if (href === '/talks') return currentPath.startsWith('/talks');
  return currentPath === href;
}
---

<header id="site-header" class:list={{ instrumented: isInstrumented }}>
  <div class="header-inner">
    <div class="header-left">
      <a href="/" class="brand" aria-label="Karan Mittal Home">
        <span class="brand-name">Karan Mittal</span>
        {isInstrumented && <span class="brand-role">Explanatory Systems Studio</span>}
      </a>
    </div>

    <nav class="main-nav" aria-label="Primary">
      {nav.map(item => (
        <a href={item.href} class={isActive(item.href) ? 'active' : ''} aria-current={isActive(item.href) ? 'page' : undefined}>
          {isInstrumented && item.href === '/blog' ? 'Field notes' : item.label}
        </a>
      ))}
    </nav>

    <div class="header-right">
      {isInstrumented && (
        <details class="mobile-nav">
          <summary>Index</summary>
          <nav class="mobile-nav-panel" aria-label="Mobile primary navigation">
            {nav.map(item => (
              <a href={item.href} class={isActive(item.href) ? 'active' : ''} aria-current={isActive(item.href) ? 'page' : undefined}>
                <span>{isInstrumented && item.href === '/blog' ? 'Field notes' : item.label}</span>
                <span aria-hidden="true">↗</span>
              </a>
            ))}
            <a href="/#contact" class="mobile-nav-contact">
              <span>Work together</span>
              <span aria-hidden="true">→</span>
            </a>
          </nav>
        </details>
      )}

      <button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle Dark Mode" title="Toggle theme">
        <svg class="sun-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="moon-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <a href="/#contact" class="consult-cta">
        <span>{isInstrumented ? 'Work together' : 'Contact'}</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    btn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  }

  setupThemeToggle();
  document.addEventListener('astro:page-load', setupThemeToggle);

  function setupMobileNavigation() {
    const menu = document.querySelector('.mobile-nav');
    if (!(menu instanceof HTMLDetailsElement) || menu.dataset.initialised === 'true') return;
    menu.dataset.initialised = 'true';

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => menu.removeAttribute('open'));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') menu.removeAttribute('open');
    });
  }

  setupMobileNavigation();
  document.addEventListener('astro:page-load', setupMobileNavigation);
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--border);
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .header-inner {
    max-width: var(--page-max-width);
    margin: 0 auto;
    padding: 0.75rem var(--space-5);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }

  .header-left {
    display: flex;
    align-items: center;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    text-decoration: none;
  }
  .brand-name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--text);
    letter-spacing: -0.015em;
    white-space: nowrap;
  }
  .brand-role {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .main-nav {
    display: flex;
    gap: 1.75rem;
    align-items: center;
  }
  .main-nav a {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.25rem 0;
    transition: color var(--transition-fast);
  }
  .main-nav a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .main-nav a.active {
    color: var(--text);
    font-weight: 600;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .mobile-nav {
    display: none;
  }

  .theme-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--bg-inset);
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }
  .theme-toggle-btn:hover {
    background: var(--border-default);
    color: var(--text);
  }

  .sun-icon { display: none; }
  .moon-icon { display: block; }

  :global(html.dark) .sun-icon { display: block; }
  :global(html.dark) .moon-icon { display: none; }
  :global(html.dark) header#site-header {
    background: rgba(12, 12, 14, 0.82);
  }

  .consult-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.85rem;
    background: var(--accent);
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    border-radius: var(--radius-pill);
    text-decoration: none;
    box-shadow: 0 1px 3px rgba(0, 113, 227, 0.2);
    transition: background-color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
  }
  .consult-cta:hover {
    background: var(--accent-hover);
    color: #ffffff;
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(0, 113, 227, 0.3);
  }
  .consult-cta svg {
    transition: transform var(--transition-fast);
  }
  .consult-cta:hover svg {
    transform: translateX(2px);
  }

  @media (max-width: 720px) {
    .header-inner {
      padding: 0.65rem var(--space-4);
    }
    .brand-role {
      display: none;
    }
    .main-nav {
      gap: 1rem;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .main-nav::-webkit-scrollbar {
      display: none;
    }
    .main-nav a {
      font-size: 0.75rem;
      white-space: nowrap;
    }
    .consult-cta {
      padding: 0.3rem 0.65rem;
      font-size: 0.7rem;
    }
  }

  header.instrumented {
    background: color-mix(in srgb, var(--ie-canvas) 96%, transparent);
    border-bottom-color: var(--ie-rule);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  header.instrumented .header-inner {
    max-width: 1280px;
    min-height: 64px;
    padding: 0 var(--space-5);
  }

  header.instrumented .brand {
    gap: 0.75rem;
  }

  header.instrumented .brand-name {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  header.instrumented .brand-role {
    display: inline-block;
    padding-left: 0.75rem;
    border-left: 1px solid var(--ie-rule);
    color: var(--ie-muted);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  header.instrumented .main-nav {
    gap: 1.5rem;
  }

  header.instrumented .main-nav a {
    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.025em;
  }

  header.instrumented .main-nav a:hover,
  header.instrumented .main-nav a.active {
    color: var(--ie-ink);
  }

  header.instrumented .theme-toggle-btn {
    width: 34px;
    height: 34px;
    border-color: var(--ie-rule);
    border-radius: 5px;
    background: transparent;
    color: var(--ie-muted);
  }

  header.instrumented .consult-cta {
    min-height: 34px;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--ie-ink);
    border-radius: 5px;
    background: var(--ie-ink);
    box-shadow: none;
    color: var(--ie-canvas);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }

  header.instrumented .consult-cta:hover {
    border-color: var(--ie-blue);
    background: var(--ie-blue);
    box-shadow: none;
    transform: none;
  }

  :global(html.dark) header.instrumented {
    background: color-mix(in srgb, var(--ie-canvas) 96%, transparent);
  }

  @media (max-width: 900px) {
    header.instrumented .brand-role {
      display: none;
    }
  }

  @media (max-width: 720px) {
    header.instrumented .header-inner {
      min-height: 56px;
      padding: 0 var(--space-4);
    }

    header.instrumented .main-nav {
      display: none;
    }

    header.instrumented .mobile-nav {
      display: block;
      order: 2;
    }

    header.instrumented .mobile-nav summary {
      display: inline-flex;
      min-width: 54px;
      min-height: 36px;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--ie-rule-strong);
      border-radius: 5px;
      color: var(--ie-ink);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      list-style: none;
    }

    header.instrumented .mobile-nav summary::-webkit-details-marker {
      display: none;
    }

    header.instrumented .mobile-nav[open] summary {
      border-color: var(--ie-blue);
      background: var(--ie-blue-soft);
      color: var(--ie-blue);
    }

    header.instrumented .mobile-nav-panel {
      position: fixed;
      top: 56px;
      right: 0;
      left: 0;
      display: grid;
      padding: 0.6rem 1rem 1rem;
      border-top: 1px solid var(--ie-rule);
      border-bottom: 1px solid var(--ie-rule-strong);
      background: var(--ie-canvas);
      box-shadow: 0 16px 32px color-mix(in srgb, var(--ie-ink) 8%, transparent);
    }

    header.instrumented .mobile-nav-panel a {
      display: flex;
      min-height: 46px;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--ie-rule);
      color: var(--ie-ink-secondary);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      text-decoration: none;
    }

    header.instrumented .mobile-nav-panel a.active {
      color: var(--ie-blue);
    }

    header.instrumented .mobile-nav-panel .mobile-nav-contact {
      margin-top: 0.6rem;
      padding-inline: 0.8rem;
      border: 1px solid var(--ie-ink);
      border-radius: 5px;
      background: var(--ie-ink);
      color: var(--ie-canvas);
    }

    header.instrumented .theme-toggle-btn {
      order: 1;
    }

    header.instrumented .consult-cta {
      display: none;
    }
  }
</style>
