---
import { getCollection } from 'astro:content';
import { normalizeTag, tagSlug } from '@utils/tags.js';

// Legacy /tags/* routes. Topic archives are retired (see AGENTS.md section 7),
// so every tag resolves to the writing index rather than a missing page.
export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const tags = new Set<string>();
  for (const post of allPosts) {
    for (const tag of post.data.tags) tags.add(tagSlug(normalizeTag(tag)));
  }
  return [...tags].map((tag) => ({ params: { tag } }));
}

return Astro.redirect('/publications/', 301);
---
