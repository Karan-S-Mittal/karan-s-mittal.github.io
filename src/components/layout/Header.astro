---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

interface NavItem {
  href: string;
  label: string;
  activePaths?: string[];
}

const nav: NavItem[] = [
  { href: '/publications/', label: 'Publications', activePaths: ['/publications/', '/writing/'] },
  { href: '/about/', label: 'About' },
  { href: '/now/', label: 'Now' },
];

function isActive(item: Pick<NavItem, 'href' | 'activePaths'>) {
  const paths = item.activePaths || [item.href];
  return paths.some((href) => {
    const cleanHref = href.replace(/\/$/, '') || '/';
    if (cleanHref === '/') return pathname === '/';
    return pathname === cleanHref || pathname.startsWith(cleanHref + '/');
  });
}
---

<header id="site-header">
  <div class="header-inner">
    <div class="header-left">
      <a href="/" class="brand" aria-label="Karan Mittal Home">
        <span class="brand-name">Karan Mittal</span>
      </a>
    </div>

    <nav class="main-nav" aria-label="Primary">
      {nav.map(item => (
        <a href={item.href} class={isActive(item) ? 'active' : ''} aria-current={isActive(item) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-right">
      <details class="mobile-nav">
        <summary aria-label="Menu">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <line x1="4" y1="9" x2="20" y2="9"></line>
            <line x1="4" y1="15" x2="20" y2="15"></line>
          </svg>
        </summary>
        <nav class="mobile-nav-panel" aria-label="Mobile primary navigation">
          {nav.map(item => (
            <a href={item.href} class={isActive(item) ? 'active' : ''} aria-current={isActive(item) ? 'page' : undefined}>
              <span>{item.label}</span>
            </a>
          ))}
        </nav>
      </details>

      <button id="theme-toggle" class="theme-toggle-btn" aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode">
        <svg class="sun-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="moon-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <a href="/contact/" class:list={['consult-cta', { active: isActive({ href: '/contact/' }) }]}>
        <span>Contact</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    const syncThemeState = () => {
      const isDark = document.documentElement.classList.contains('dark');
      btn.setAttribute('aria-pressed', String(isDark));
      btn.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
      btn.setAttribute('title', isDark ? 'Switch to light mode' : 'Switch to dark mode');
    };

    btn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      syncThemeState();
    });
    syncThemeState();
  }

  setupThemeToggle();

  function setupMobileNavigation() {
    const menu = document.querySelector('.mobile-nav');
    if (!(menu instanceof HTMLDetailsElement)) return;

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => menu.removeAttribute('open'));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') menu.removeAttribute('open');
    });
  }

  setupMobileNavigation();
</script>

<style>
  /* Solid, not frosted: the header is a plain band with one hairline. */
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--ie-canvas);
    border-bottom: 1px solid var(--ie-rule);
    transition: background-color 120ms ease, border-color 120ms ease;
  }

  .header-inner {
    max-width: var(--width-visual, 1180px);
    min-height: 52px;
    margin: 0 auto;
    padding: 0 var(--space-5, 1.5rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4, 1rem);
  }

  .header-left {
    display: flex;
    flex: 1;
    align-items: center;
  }

  .brand {
    display: flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: var(--ie-type-h4);
    font-weight: 600;
    color: var(--ie-ink);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .main-nav {
    display: flex;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
    align-items: center;
  }

  .main-nav a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--ie-ink-secondary);
    font-family: var(--font-sans);
    font-size: var(--ie-type-ui);
    font-weight: 400;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: color 120ms ease;
  }

  .main-nav a:hover,
  .main-nav a.active {
    color: var(--ie-ink);
  }

  .main-nav a.active {
    font-weight: 600;
  }

  .header-right {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .theme-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: var(--ie-muted);
    cursor: pointer;
    transition: color 120ms ease;
  }

  .theme-toggle-btn:hover {
    color: var(--ie-ink);
  }

  .sun-icon { display: none; }
  .moon-icon { display: block; }

  :global(html.dark) .sun-icon { display: block; }
  :global(html.dark) .moon-icon { display: none; }

  .consult-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ie-blue);
    font-family: var(--font-sans);
    font-size: var(--ie-type-ui);
    font-weight: 400;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .consult-cta:hover {
    color: var(--ie-blue);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 760px) {
    .header-inner {
      padding: 0 var(--space-4, 1rem);
    }

    .main-nav {
      display: none;
    }

    .mobile-nav {
      display: block;
      order: 3;
    }

    .mobile-nav summary {
      display: inline-flex;
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
      color: var(--ie-ink);
      cursor: pointer;
      list-style: none;
    }

    .mobile-nav summary::-webkit-details-marker {
      display: none;
    }

    .mobile-nav-panel {
      position: fixed;
      top: 53px;
      right: 0;
      bottom: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      padding: 1.5rem 1.5rem 2rem;
      background: var(--ie-canvas);
    }

    .mobile-nav:not([open]) .mobile-nav-panel {
      display: none;
    }

    .mobile-nav-panel a {
      display: flex;
      min-height: 52px;
      align-items: center;
      border-bottom: 1px solid var(--ie-rule);
      color: var(--ie-ink);
      font-family: var(--font-display);
      font-size: var(--ie-type-h3);
      font-weight: 600;
      letter-spacing: -0.02em;
      text-decoration: none;
    }

    .mobile-nav-panel a.active {
      color: var(--ie-muted);
    }

    .consult-cta { order: 1; }
    .theme-toggle-btn { order: 2; }
  }
</style>
