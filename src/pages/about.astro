---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/portfolio/PageHeader.astro';
import Icon from '../components/chrome/Icon.astro';
import StudioPanel from '../components/chrome/StudioPanel.astro';
import communitiesData from '../data/communities.json';

const { communities } = communitiesData;
---

<Layout title="About | Karan Mittal">
  <main class="container">
    <PageHeader
      label="About"
      title="Karan Mittal"
      description="Founder, engineer, and community builder working on deterministic solutions for complicated systems."
    />

    <blockquote class="hero-quote">
      The difficult part of an engineering problem is rarely the tool. It is designing a system people can rely on.
    </blockquote>

    <p class="bio">
      I am an AI Systems Architect and co-founder of <a href="https://dextar.co">Dextar</a>. I work with teams
      turning ambiguous data and AI problems into deterministic engineering systems—systems with clear boundaries,
      evidence, constraints, and a path to production. My experience spans life sciences, semiconductor supply chains,
      and finance; my current focus includes knowledge systems, AI reliability, and performance engineering.
    </p>

    <nav class="local-nav">
      <a href="#now">Now</a>
      <span class="nav-sep">·</span>
      <a href="#capabilities">Practice</a>
      <span class="nav-sep">·</span>
      <a href="#community">Community</a>
    </nav>

    <section id="now">
      <h2>Now</h2>
      <p class="section-desc">A living snapshot of current focus, updated periodically.</p>
      <div class="now-grid">
        <StudioPanel title="Work" index="01" state="signal">
          <Icon slot="icon" name="briefcase" size={15} />
          <ul>
            <li>Co-founding and leading engineering at <a href="https://dextar.co">Dextar.co</a></li>
            <li>Architecting production GraphRAG systems for enterprise clients</li>
            <li>Consulting on MLOps infrastructure and GPU cluster optimisation</li>
          </ul>
        </StudioPanel>

        <StudioPanel title="Building" index="02" state="model">
          <Icon slot="icon" name="wrench" size={15} />
          <ul>
            <li>An open-source deterministic RAG evaluation harness</li>
            <li>A CUDA optimisation pattern cookbook for ML inference</li>
            <li>This blog and my GitHub presence</li>
          </ul>
        </StudioPanel>

        <StudioPanel title="Learning" index="03" state="verified">
          <Icon slot="icon" name="book-open" size={15} />
          <ul>
            <li>Advanced Rust for systems programming</li>
            <li>CPU/GPU co-design patterns for edge LLM inference</li>
          </ul>
        </StudioPanel>

        <StudioPanel title="Speaking" index="04" state="signal">
          <Icon slot="icon" name="mic" size={15} />
          <ul>
            <li>Preparing talks on GraphRAG and deterministic retrieval for 2026</li>
            <li><a href="/talks" class="arrow-link">View all talks and events<span class="arrow" aria-hidden="true">→</span></a></li>
          </ul>
        </StudioPanel>
      </div>
      <p class="now-footer">
        Last updated: August 2026 · <a href="https://nownownow.com/about">What is a /now page?</a>
      </p>
    </section>

    <section id="capabilities">
      <h2>Engineering practice</h2>
      <div class="capabilities-list">
        <div class="capability">
          <h3>AI Architecture</h3>
          <p>Knowledge systems, retrieval contracts, graph-aware discovery, LLM orchestration</p>
        </div>
        <div class="capability">
          <h3>Performance</h3>
          <p>Inference paths, model and hardware trade-offs, observability, low-latency delivery</p>
        </div>
        <div class="capability">
          <h3>Infrastructure</h3>
          <p>Production MLOps, Kubernetes, cloud-native systems, evaluation and operational guardrails</p>
        </div>
        <div class="capability">
          <h3>Leadership</h3>
          <p>Technical strategy, engineering team building, stakeholder alignment, durable handover</p>
        </div>
      </div>
    </section>

    <section id="community">
      <h2>Community</h2>
      <p class="section-desc">I organise and mentor across several technical communities in Central India.</p>
      <div class="community-list">
        {communities.map((c) => (
          <div class="community-row">
            <img src={c.logo} alt={c.name} class="community-logo" />
            <div class="community-info">
              <p class="community-name">{c.name}</p>
              <p class="community-desc">{c.description}</p>
            </div>
            {c.links && c.links.length > 0 && (
              <div class="community-links">
                {c.links.map((link: { label: string; url: string }) => (
                  <a href={link.url} target="_blank" rel="noopener">
                    {link.label}
                    <Icon name="arrow-up-right" size={12} />
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="cta-section">
      <h2>Let's build</h2>
      <p>For consulting engagements involving complex data, AI reliability, system performance, or technical strategy.</p>
      <div class="cta-actions">
        <a href="/#contact" class="cta-link arrow-link">Discuss an engagement<span class="arrow" aria-hidden="true">→</span></a>
        <a href="https://www.linkedin.com/in/karansmittal/" class="cta-link arrow-link">LinkedIn<span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero-quote {
    margin: 0 0 var(--space-6);
    padding: 0;
    border: none;
    background: none;
    max-width: 26ch;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    color: var(--text);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .bio {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-6);
    max-width: 640px;
  }

  .local-nav {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    font-size: var(--text-sm);
    font-weight: 500;
    margin-bottom: var(--space-7);
  }
  .nav-sep {
    color: var(--border);
  }

  .capabilities-list {
    border-top: 1px solid var(--border);
  }
  .capability {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .capability h3 {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .capability p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.6;
  }

  .section-desc {
    color: var(--muted);
    margin-bottom: var(--space-5);
    margin-top: calc(var(--space-2) * -1);
  }

  .now-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .now-grid ul {
    margin: 0;
    padding-left: var(--space-4);
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }
  .now-grid li {
    margin-bottom: var(--space-1);
  }
  .now-footer {
    color: var(--muted);
    font-size: var(--text-xs);
    margin: 0 0 var(--space-7);
  }

  .community-list {
    border-top: 1px solid var(--border);
  }
  .community-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .community-logo {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
    margin: 0;
    opacity: 0.9;
    border-radius: var(--radius-sm);
  }
  .community-info {
    min-width: 0;
  }
  .community-name {
    font-weight: 600;
    color: var(--text);
    margin: 0 0 var(--space-1);
    font-size: var(--text-sm);
  }
  .community-desc {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .community-links {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .community-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--muted);
  }
  .community-links a:hover {
    color: var(--text);
  }
  .community-links a svg {
    opacity: 0.4;
  }

  .cta-section {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }
  .cta-section h2 {
    margin-top: 0;
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }
  .cta-section p {
    color: var(--muted);
    margin-bottom: var(--space-4);
    max-width: 480px;
  }
  .cta-actions {
    display: flex;
    gap: var(--space-5);
    flex-wrap: wrap;
  }
  .cta-link {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
  }
  .cta-link:hover {
    color: var(--accent-hover);
  }

  @media (max-width: 720px) {
    .now-grid {
      grid-template-columns: 1fr;
    }
    .capability {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .community-row {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }
    .community-links {
      grid-column: 2;
      justify-content: flex-start;
    }
    .hero-quote {
      font-size: var(--text-xl);
    }
  }
</style>
