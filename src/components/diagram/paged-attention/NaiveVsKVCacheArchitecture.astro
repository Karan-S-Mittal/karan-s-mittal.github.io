---
/**
 * A two-lane explanation of exactly which token projections are repeated by
 * naive decoding and which tensors are retained by a KV cache.
 */
import Exhibit from '../../editorial/Exhibit.astro';

interface Props {
  caption?: string;
  exhibit?: string;
  title?: string;
}

const {
  caption = 'Without a KV cache, past token projections are recomputed at every decoding step. With a cache, each new token contributes one new key/value pair while previous pairs remain addressable in GPU memory.',
  exhibit = '01',
  title = 'What the KV cache actually removes',
} = Astro.props;
---

<Exhibit exhibit={exhibit} title={title} badge="DECODE MECHANISM" caption={caption} wide>
  <div class="cache-comparison">
    <section class="comparison-lane naive-lane" aria-labelledby="naive-lane-title">
      <header>
        <span class="lane-number">A</span>
        <div>
          <h4 id="naive-lane-title">Without a KV cache</h4>
          <p>Every step projects the entire prefix again.</p>
        </div>
      </header>

      <ol class="decode-steps">
        <li>
          <span class="step-number">Step 1</span>
          <div class="tokens"><span class="token new">The</span></div>
          <strong>1 projection</strong>
        </li>
        <li>
          <span class="step-number">Step 2</span>
          <div class="tokens"><span class="token repeated">The</span><span class="token new">quick</span></div>
          <strong>2 projections</strong>
        </li>
        <li>
          <span class="step-number">Step 3</span>
          <div class="tokens"><span class="token repeated">The</span><span class="token repeated">quick</span><span class="token new">brown</span></div>
          <strong>3 projections</strong>
        </li>
      </ol>

      <div class="lane-result constraint-result">
        <span>Repeated work</span>
        <strong>1 + 2 + 3 = 6 token projections</strong>
        <p>Grey tokens are work the model already performed at an earlier step.</p>
      </div>
    </section>

    <section class="comparison-lane cache-lane" aria-labelledby="cache-lane-title">
      <header>
        <span class="lane-number">B</span>
        <div>
          <h4 id="cache-lane-title">With a KV cache</h4>
          <p>Only the newest token is projected; its K/V pair is appended.</p>
        </div>
      </header>

      <ol class="decode-steps cache-steps">
        <li>
          <span class="step-number">Step 1</span>
          <div class="append-path"><span class="token new">The</span><i aria-hidden="true">→</i><span class="cache-block">K₀ · V₀</span></div>
          <strong>append block 0</strong>
        </li>
        <li>
          <span class="step-number">Step 2</span>
          <div class="append-path"><span class="token new">quick</span><i aria-hidden="true">→</i><span class="cache-block">K₁ · V₁</span></div>
          <strong>append block 1</strong>
        </li>
        <li>
          <span class="step-number">Step 3</span>
          <div class="append-path"><span class="token new">brown</span><i aria-hidden="true">→</i><span class="cache-block">K₂ · V₂</span></div>
          <strong>append block 2</strong>
        </li>
      </ol>

      <div class="lane-result cache-result">
        <span>Stored in GPU memory</span>
        <div class="cache-strip" aria-label="Three retained key value pairs">
          <b>K₀ · V₀</b><b>K₁ · V₁</b><b>K₂ · V₂</b>
        </div>
        <p>Projection work becomes constant per new token; cache capacity grows with sequence length.</p>
      </div>
    </section>
  </div>

  <aside class="comparison-takeaway">
    <span>What to notice</span>
    <p><strong>The cache removes repeated K/V projection work.</strong> Attention still reads the retained K/V states, so memory capacity and movement become the next constraint.</p>
  </aside>
</Exhibit>

<style>
  .cache-comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    border-top: 2px solid var(--ie-ink, var(--text));
    border-bottom: 1px solid var(--ie-rule-strong, var(--border-default));
  }

  .comparison-lane {
    padding: 1.5rem;
  }

  .comparison-lane:first-child {
    border-right: 1px solid var(--ie-rule-strong, var(--border-default));
  }

  .comparison-lane header {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    min-height: 94px;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--ie-rule, var(--border-default));
  }

  .lane-number,
  .step-number,
  .lane-result > span,
  .comparison-takeaway > span {
    color: var(--ie-blue, var(--accent));
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .naive-lane .lane-number { color: var(--ie-rust, var(--signal-warm)); }

  .comparison-lane h4 {
    margin: 0 0 0.35rem;
    color: var(--ie-ink, var(--text));
    font-family: var(--font-sans);
    font-size: 1.2rem;
    font-weight: 650;
  }

  .comparison-lane header p,
  .lane-result p,
  .comparison-takeaway p {
    margin: 0;
    color: var(--ie-ink-secondary, var(--text-secondary));
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .decode-steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .decode-steps li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    gap: 0.8rem;
    align-items: center;
    min-height: 76px;
    border-bottom: 1px solid var(--ie-rule, var(--border-default));
  }

  .decode-steps li > strong {
    color: var(--ie-muted, var(--text-muted));
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .tokens,
  .append-path,
  .cache-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }

  .token,
  .cache-block,
  .cache-strip b {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    padding: 0.32rem 0.55rem;
    border: 1px solid var(--ie-rule-strong, var(--border-default));
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .token.new,
  .cache-block {
    border-color: var(--ie-blue, var(--accent));
    background: var(--ie-blue-soft, var(--accent-subtle));
    color: var(--ie-blue, var(--accent));
  }

  .token.repeated {
    border-style: dashed;
    color: var(--ie-muted, var(--text-muted));
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .append-path i {
    color: var(--ie-blue, var(--accent));
    font-style: normal;
  }

  .lane-result {
    min-height: 146px;
    padding-top: 1.25rem;
  }

  .lane-result > strong {
    display: block;
    margin: 0.55rem 0;
    color: var(--ie-ink, var(--text));
    font-size: 1rem;
  }

  .constraint-result > span { color: var(--ie-rust, var(--signal-warm)); }

  .cache-strip {
    margin: 0.65rem 0;
    gap: 0;
  }

  .cache-strip b {
    flex: 1;
    justify-content: center;
    border-color: var(--ie-blue, var(--accent));
    border-right: 0;
    border-radius: 0;
    background: var(--ie-blue-soft, var(--accent-subtle));
    color: var(--ie-blue, var(--accent));
    font-weight: 600;
  }

  .cache-strip b:first-child { border-radius: 3px 0 0 3px; }
  .cache-strip b:last-child { border-right: 1px solid var(--ie-blue, var(--accent)); border-radius: 0 3px 3px 0; }

  .comparison-takeaway {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1.5rem;
    width: 100%;
    margin-top: 1rem;
    padding: 1.15rem 0;
    border-top: 1px solid var(--ie-rust, var(--signal-warm));
  }

  .comparison-takeaway > span { color: var(--ie-rust, var(--signal-warm)); }
  .comparison-takeaway strong { color: var(--ie-ink, var(--text)); }

  @media (max-width: 760px) {
    .cache-comparison {
      grid-template-columns: 1fr;
    }

    .comparison-lane:first-child {
      border-right: 0;
      border-bottom: 2px solid var(--ie-rule-strong, var(--border-default));
    }

    .comparison-lane {
      padding: 1rem 0;
    }

    .decode-steps li {
      grid-template-columns: 4rem minmax(0, 1fr);
      padding-block: 0.75rem;
    }

    .decode-steps li > strong {
      grid-column: 2;
      white-space: normal;
    }

    .comparison-takeaway {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }
  }
</style>
