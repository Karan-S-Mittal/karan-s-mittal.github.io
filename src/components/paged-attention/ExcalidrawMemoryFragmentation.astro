---
import ExcalidrawContainer from './ExcalidrawContainer.astro';

interface Props {
  caption?: string;
  exhibit?: string;
  title?: string;
}

const { caption, exhibit, title } = Astro.props;
---

<ExcalidrawContainer caption={caption} exhibit={exhibit} title={title} badge="MEMORY ALLOCATION">
  <svg class="ex-svg-canvas sys-diagram" viewBox="0 0 800 448" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Contiguous allocation reserves a long buffer, leaves the unused tail locked after a request finishes, and creates fragmented free memory across requests.">
    <defs>
      <pattern id="fragment-hatch" width="8" height="8" patternTransform="rotate(45)" patternUnits="userSpaceOnUse"><line x1="0" y1="0" x2="0" y2="8" stroke="var(--ex-text-muted)" stroke-opacity=".30" stroke-width="2" /></pattern>
    </defs>
    <text x="32" y="32" class="label">CONTIGUOUS ALLOCATION</text>
    <text x="768" y="32" class="label" text-anchor="end">CAPACITY IS RESERVED, NOT EARNED</text>
    <line x1="32" y1="48" x2="768" y2="48" class="rule" />

    <text x="32" y="88" class="label">01 / ADMISSION</text>
    <text x="176" y="88" class="body-muted">Reserve the maximum sequence length before the request starts.</text>
    <g transform="translate(176 108)">
      <rect x="0" y="0" width="560" height="48" rx="4" class="node-muted" />
      <rect x="0" y="0" width="96" height="48" rx="4" class="node-signal" />
      <rect x="96" y="0" width="464" height="48" fill="url(#fragment-hatch)" />
      <text x="48" y="21" class="body" text-anchor="middle">prompt</text><text x="48" y="37" class="label-signal" text-anchor="middle">750 TOKENS</text>
      <text x="328" y="21" class="body-muted" text-anchor="middle">reserved capacity</text><text x="328" y="37" class="label" text-anchor="middle">7,442 TOKENS</text>
    </g>

    <line x1="32" y1="184" x2="768" y2="184" class="rule" />
    <text x="32" y="224" class="label">02 / EARLY STOP</text>
    <text x="176" y="224" class="body-muted">When generation ends, the unused tail stays unavailable for this request.</text>
    <g transform="translate(176 244)">
      <rect x="0" y="0" width="560" height="48" rx="4" class="node-muted" />
      <rect x="0" y="0" width="144" height="48" rx="4" class="node-signal" />
      <rect x="144" y="0" width="416" height="48" fill="url(#fragment-hatch)" />
      <text x="72" y="21" class="body" text-anchor="middle">used</text><text x="72" y="37" class="label-signal" text-anchor="middle">750 TOKENS</text>
      <text x="352" y="21" class="body-muted" text-anchor="middle">locked, never touched</text><text x="352" y="37" class="label" text-anchor="middle">INTERNAL FRAGMENTATION</text>
    </g>

    <line x1="32" y1="320" x2="768" y2="320" class="rule" />
    <text x="32" y="348" class="label">03 / MANY REQUESTS</text>
    <text x="176" y="366" class="body-muted">Free capacity remains, but no request-sized region is contiguous.</text>
    <g transform="translate(176 380)">
      <rect x="0" y="0" width="72" height="24" class="node-muted" /><rect x="80" y="0" width="40" height="24" fill="url(#fragment-hatch)" /><rect x="128" y="0" width="96" height="24" class="node-muted" /><rect x="232" y="0" width="40" height="24" fill="url(#fragment-hatch)" /><rect x="280" y="0" width="112" height="24" class="node-muted" /><rect x="400" y="0" width="40" height="24" fill="url(#fragment-hatch)" /><rect x="448" y="0" width="112" height="24" class="node-muted" />
      <text x="280" y="48" class="label" text-anchor="middle">SCATTERED FREE REGIONS</text>
    </g>
  </svg>
</ExcalidrawContainer>
