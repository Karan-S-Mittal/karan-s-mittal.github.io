---
import StudioPanel from '../chrome/StudioPanel.astro';

interface WorkItem {
  id: string;
  eyebrow: string;
  title: string;
  summary: string;
  context?: string;
  focus?: string[];
  flow?: string[];
}

interface Props {
  item: WorkItem;
  detailed?: boolean;
  index?: string;
}

const { item, detailed = false, index } = Astro.props;
---

<StudioPanel
  id={`work-${item.id}`}
  title={item.title}
  label={item.eyebrow}
  index={index}
  heading="h2"
  state="signal"
  spacious={detailed}
>
  <div class:list={['work-card-copy', { detailed }]}>
    <p class="summary">{item.summary}</p>
    {detailed && item.context && <p class="context">{item.context}</p>}
  </div>

  {detailed && item.focus && (
    <div class="detail-grid">
      <div>
        <p class="detail-label">Design focus</p>
        <ul>
          {item.focus.map((point) => <li>{point}</li>)}
        </ul>
      </div>
      {item.flow && (
        <div>
          <p class="detail-label">System lens</p>
          <ol class="system-flow">
            {item.flow.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{step}</li>)}
          </ol>
        </div>
      )}
    </div>
  )}
</StudioPanel>

<style>
  .detail-label {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .summary, .context { margin: 0; color: var(--muted); line-height: 1.65; }
  .context { margin-top: var(--space-4); color: var(--text-secondary); }
  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .detail-label { color: var(--muted); }
  ul, .system-flow { margin: 0; padding: 0; list-style: none; }
  ul { display: grid; gap: var(--space-2); }
  ul li { color: var(--text-secondary); font-size: var(--text-sm); line-height: 1.5; padding-left: 1.4rem; position: relative; }
  ul li::before { content: '→'; position: absolute; left: 0; color: var(--accent); }
  .system-flow { display: grid; gap: var(--space-2); }
  .system-flow li { display: flex; align-items: baseline; gap: var(--space-2); color: var(--text-secondary); font-size: var(--text-sm); }
  .system-flow span { color: var(--accent); font-family: var(--font-mono); font-size: var(--text-xs); }
  @media (max-width: 640px) {
    .detail-grid { grid-template-columns: 1fr; gap: var(--space-5); }
  }
</style>
