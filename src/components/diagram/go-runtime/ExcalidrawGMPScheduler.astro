---
import ExcalidrawContainer from '../paged-attention/ExcalidrawContainer.astro';

interface Props {
  caption?: string;
  exhibit?: string;
  title?: string;
}

const { caption, exhibit, title } = Astro.props;
---

<ExcalidrawContainer caption={caption} exhibit={exhibit} title={title} badge="RUNTIME CONCURRENCY">
  <svg class="ex-svg-canvas sys-diagram" viewBox="0 0 720 460" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Microarchitecture of the Go GMP work-stealing scheduler with 3 execution planes: Kernel Space, Go Runtime User Space, and Hardware Execution.">
    <defs>
      <marker id="gmp-arr" markerWidth="7" markerHeight="6" refX="6" refY="3" orient="auto"><polygon points="0 0, 7 3, 0 6" fill="#1A1A2E" /></marker>
      <marker id="gmp-arr-blue" markerWidth="7" markerHeight="6" refX="6" refY="3" orient="auto"><polygon points="0 0, 7 3, 0 6" fill="#2676AA" /></marker>
    </defs>

    <!-- 1. KERNEL SPACE PLANE -->
    <g transform="translate(20, 16)">
      <rect x="0" y="0" width="680" height="74" rx="8" fill="color-mix(in srgb, var(--accent) 3%, transparent)" stroke="color-mix(in srgb, var(--accent) 18%, transparent)" stroke-width="1.5" />
      <text x="16" y="16" class="label-signal" font-size="8.5" font-weight="700" letter-spacing="0.06em" dominant-baseline="central">KERNEL SPACE (ASYNC I/O &amp; EVENT SUBSYSTEM)</text>

      <!-- Network Poller Node -->
      <g transform="translate(16, 28)">
        <rect x="0" y="0" width="310" height="36" rx="6" class="node-signal" stroke-width="1.5" />
        <text x="14" y="18" class="label-signal" font-size="9" font-weight="700" dominant-baseline="central">EPOLL / KQUEUE EVENT LOOP</text>
        <rect x="210" y="6" width="88" height="24" rx="3" class="node" stroke-width="1" />
        <text x="254" y="18" class="label-signal" font-size="8" font-weight="600" text-anchor="middle" dominant-baseline="central">fd:42 (TCP Ready)</text>
      </g>

      <!-- Signal Preemption Node -->
      <g transform="translate(354, 28)">
        <rect x="0" y="0" width="310" height="36" rx="6" class="node-muted" stroke-width="1.5" />
        <text x="14" y="18" class="label" font-size="9" font-weight="700" dominant-baseline="central">SYSMON BACKGROUND MONITOR</text>
        <rect x="210" y="6" width="88" height="24" rx="3" class="node-signal" stroke-width="1" />
        <text x="254" y="18" class="label-signal" font-size="8" font-weight="700" text-anchor="middle" dominant-baseline="central">SIGURG &gt;10ms</text>
      </g>
    </g>

    <!-- Connector: Netpoller injects ready G into Runtime -->
    <path d="M 171 90 V 118" class="flow-dashed" stroke="#CDB4DB" stroke-width="1.5" stroke-dasharray="4 3" marker-end="url(#gmp-arr-blue)" />
    <text x="180" y="104" class="label-signal" font-size="8" dominant-baseline="central">I/O READY &rarr; P₀ LRQ</text>

    <!-- 2. GO RUNTIME (USER SPACE) SCHEDULING PLANE -->
    <g transform="translate(20, 118)">
      <rect x="0" y="0" width="680" height="204" rx="10" fill="color-mix(in srgb, var(--accent) 5%, transparent)" stroke="color-mix(in srgb, var(--accent) 22%, transparent)" stroke-width="1.5" />
      
      <!-- Header Row -->
      <text x="16" y="18" class="label-signal" font-size="8.5" font-weight="700" letter-spacing="0.06em" dominant-baseline="central">GO RUNTIME USER SPACE (GMP WORK-STEALING SCHEDULER)</text>
      
      <!-- Global Run Queue Badge on Right -->
      <g transform="translate(390, 8)">
        <rect x="0" y="0" width="274" height="24" rx="4" class="node-muted" stroke-width="1" />
        <text x="10" y="12" class="label" font-size="8" font-weight="600" dominant-baseline="central">Global Run Queue (GRQ): [G₇, G₈] (1/61 check)</text>
      </g>

      <!-- PROCESSOR 0 (P0) -->
      <g transform="translate(16, 38)">
        <rect x="0" y="0" width="310" height="150" rx="8" class="node" stroke-width="1.5" />
        <text x="16" y="20" class="title" font-size="13" font-weight="600" dominant-baseline="central">Logical Processor P₀ (Active Core Context)</text>
        <text x="16" y="38" class="label" font-size="8" font-weight="600" dominant-baseline="central">LOCK-FREE RING BUFFER (256 G SLOTS) · HEAD=2, TAIL=4</text>

        <!-- P0 LRQ Slot Visualization -->
        <g transform="translate(14, 52)">
          <rect x="0" y="0" width="62" height="42" rx="4" class="node-signal" stroke-width="1.5" />
          <text x="31" y="16" class="label-signal" font-size="8.5" font-weight="700" text-anchor="middle" dominant-baseline="central">Slot [0]</text>
          <text x="31" y="30" class="body" font-size="10" font-weight="700" text-anchor="middle" dominant-baseline="central">G₁</text>

          <rect x="70" y="0" width="62" height="42" rx="4" class="node-signal" stroke-width="1.5" />
          <text x="101" y="16" class="label-signal" font-size="8.5" font-weight="700" text-anchor="middle" dominant-baseline="central">Slot [1]</text>
          <text x="101" y="30" class="body" font-size="10" font-weight="700" text-anchor="middle" dominant-baseline="central">G₂</text>

          <rect x="140" y="0" width="62" height="42" rx="4" stroke="var(--border-default)" stroke-dasharray="2 2" />
          <text x="171" y="16" class="label" font-size="8" text-anchor="middle" dominant-baseline="central">Slot [2]</text>
          <text x="171" y="30" class="label" font-size="8" text-anchor="middle" dominant-baseline="central">Empty</text>

          <rect x="210" y="0" width="72" height="42" rx="4" stroke="var(--border-default)" stroke-dasharray="2 2" />
          <text x="246" y="16" class="label" font-size="8" text-anchor="middle" dominant-baseline="central">[3..255]</text>
          <text x="246" y="30" class="label" font-size="8" text-anchor="middle" dominant-baseline="central">Head/Tail</text>
        </g>
        <text x="16" y="112" class="label-signal" font-size="8.5" dominant-baseline="central">&bull; Next Runnable: G₁ pops in &lt;10ns without mutex</text>
        <text x="16" y="130" class="body-muted" font-size="10" dominant-baseline="central">Zero kernel switches · Pure user-space execution</text>
      </g>

      <!-- PROCESSOR 1 (P1) -->
      <g transform="translate(354, 38)">
        <rect x="0" y="0" width="310" height="150" rx="8" class="node" stroke-width="1.5" />
        <text x="16" y="20" class="title" font-size="13" font-weight="600" dominant-baseline="central">Logical Processor P₁ (Victim Candidate)</text>
        <text x="16" y="38" class="label" font-size="8" font-weight="600" dominant-baseline="central">LOADED RUNQUEUE (6 Gs IN BUFFER) · HEAD=0, TAIL=6</text>

        <!-- P1 LRQ Slot Visualization -->
        <g transform="translate(14, 52)">
          <rect x="0" y="0" width="44" height="42" rx="4" class="node-signal" stroke-width="1.5" />
          <text x="22" y="16" class="label-signal" font-size="7.5" text-anchor="middle" dominant-baseline="central">[0]</text>
          <text x="22" y="30" class="body" font-size="9" text-anchor="middle" dominant-baseline="central">G₃</text>

          <rect x="48" y="0" width="44" height="42" rx="4" class="node-signal" stroke-width="1.5" />
          <text x="70" y="16" class="label-signal" font-size="7.5" text-anchor="middle" dominant-baseline="central">[1]</text>
          <text x="70" y="30" class="body" font-size="9" text-anchor="middle" dominant-baseline="central">G₄</text>

          <rect x="96" y="0" width="44" height="42" rx="4" class="node-signal" stroke-width="1.5" />
          <text x="118" y="16" class="label-signal" font-size="7.5" text-anchor="middle" dominant-baseline="central">[2]</text>
          <text x="118" y="30" class="body" font-size="9" text-anchor="middle" dominant-baseline="central">G₅</text>

          <!-- Steal Target Batch (G6, G7, G8) -->
          <rect x="144" y="0" width="138" height="42" rx="4" fill="color-mix(in srgb, var(--accent) 15%, transparent)" stroke="var(--accent)" stroke-width="1.5" />
          <text x="213" y="16" class="label-signal" font-size="8" font-weight="700" text-anchor="middle" dominant-baseline="central">STEAL BATCH [3..5]</text>
          <text x="213" y="30" class="label-signal" font-size="9" font-weight="700" text-anchor="middle" dominant-baseline="central">G₆, G₇, G₈ (50%)</text>
        </g>
        <text x="16" y="112" class="label-signal" font-size="8.5" dominant-baseline="central">&bull; Steal Target: P₀ steals half buffer via atomic CAS</text>
        <text x="16" y="130" class="body-muted" font-size="10" dominant-baseline="central">Maintains uniform core utilization under load</text>
      </g>

      <!-- Work-Stealing Curve -->
      <path d="M 530 84 C 470 38, 290 38, 230 84" class="flow-signal" stroke="#2676AA" stroke-width="2" marker-end="url(#gmp-arr-blue)" />
      <text x="375" y="46" class="label-signal" text-anchor="middle" font-size="8.5" font-weight="700" dominant-baseline="central">ATOMIC CAS WORK-STEAL (N/2 = 3 Gs)</text>
    </g>

    <!-- 3. HARDWARE EXECUTION PLANE (OS THREADS & CPU CORES) -->
    <g transform="translate(20, 334)">
      <rect x="0" y="0" width="680" height="80" rx="8" class="node-signal" stroke-width="1.5" />
      <text x="16" y="16" class="label-signal" font-size="8.5" font-weight="700" letter-spacing="0.06em" dominant-baseline="central">HARDWARE MULTI-CORE LAYER (1:1 OS THREAD BINDING)</text>

      <!-- Core 0 / Thread M0 -->
      <g transform="translate(16, 28)">
        <rect x="0" y="0" width="310" height="42" rx="6" class="node" stroke-width="1.5" />
        <text x="14" y="21" class="body" font-size="11" font-weight="700" dominant-baseline="central">OS Thread M₀ (Core 0)</text>
        <rect x="180" y="6" width="118" height="30" rx="4" class="node-signal" stroke-width="1" />
        <text x="239" y="21" class="label-signal" font-size="9" font-weight="700" text-anchor="middle" dominant-baseline="central">RUNNING: G₀</text>
      </g>

      <!-- Core 1 / Thread M1 -->
      <g transform="translate(354, 28)">
        <rect x="0" y="0" width="310" height="42" rx="6" class="node" stroke-width="1.5" />
        <text x="14" y="21" class="body" font-size="11" font-weight="700" dominant-baseline="central">OS Thread M₁ (Core 1)</text>
        <rect x="180" y="6" width="118" height="30" rx="4" class="node-signal" stroke-width="1" />
        <text x="239" y="21" class="label-signal" font-size="9" font-weight="700" text-anchor="middle" dominant-baseline="central">RUNNING: G₃</text>
      </g>
    </g>

    <!-- Connectors P -> M -->
    <path d="M 171 322 V 334" class="flow" stroke="#1A1A2E" stroke-width="1.5" marker-end="url(#gmp-arr)" />
    <path d="M 509 322 V 334" class="flow" stroke="#1A1A2E" stroke-width="1.5" marker-end="url(#gmp-arr)" />

    <!-- Editorial Leader Line -->
    <text x="20" y="440" class="body-muted" font-size="11" dominant-baseline="central">&larr; notice 3-tier boundary: Network Poller parks I/O in kernel space while M:N scheduler balances cores via atomic work stealing</text>
  </svg>
</ExcalidrawContainer>
