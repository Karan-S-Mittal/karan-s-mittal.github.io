---
const currentPath = Astro.url.pathname;

const nav = [
  { href: '/blog', label: 'Writing' },
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/talks', label: 'Talks' },
  { href: '/now', label: 'Now' },
];

function isActive(href: string) {
  if (href.includes('#')) return false;
  if (href === '/blog') return currentPath.startsWith('/blog');
  if (href === '/work') return currentPath.startsWith('/work');
  if (href === '/talks') return currentPath.startsWith('/talks');
  if (href === '/now') return currentPath === '/now';
  if (href === '/about') return currentPath === '/about';
  if (href === '/contact') return currentPath === '/contact';
  return currentPath === href;
}
---

<header id="site-header">
  <div class="header-inner">
    <div class="header-left">
      <a href="/" class="brand" aria-label="Karan Mittal Home">
        <span class="brand-name">Karan Mittal</span>
        <span class="brand-role">Explanatory Systems Studio</span>
      </a>
    </div>

    <nav class="main-nav" aria-label="Primary">
      {nav.map(item => (
        <a href={item.href} class={isActive(item.href) ? 'active' : ''} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-right">
      <details class="mobile-nav">
        <summary>Index</summary>
        <nav class="mobile-nav-panel" aria-label="Mobile primary navigation">
          {nav.map(item => (
            <a href={item.href} class={isActive(item.href) ? 'active' : ''} aria-current={isActive(item.href) ? 'page' : undefined}>
              <span>{item.label}</span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
          <a href="/contact" class="mobile-nav-contact">
            <span>Project brief / Contact</span>
            <span aria-hidden="true">→</span>
          </a>
        </nav>
      </details>

      <button id="theme-toggle" class="theme-toggle-btn" aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode">
        <svg class="sun-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="moon-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <a href="/contact" class="consult-cta">
        <span>Contact</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  let mobileNavCleanup = null;

  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    const syncThemeState = () => {
      const isDark = document.documentElement.classList.contains('dark');
      btn.setAttribute('aria-pressed', String(isDark));
      btn.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
      btn.setAttribute('title', isDark ? 'Switch to light mode' : 'Switch to dark mode');
    };

    if (btn.dataset.initialised !== 'true') {
      btn.dataset.initialised = 'true';
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        syncThemeState();
      });
    }
    syncThemeState();
  }

  setupThemeToggle();
  document.addEventListener('astro:page-load', setupThemeToggle);

  function setupMobileNavigation() {
    const menu = document.querySelector('.mobile-nav');
    if (!(menu instanceof HTMLDetailsElement) || menu.dataset.initialised === 'true') return;

    // Astro client navigation can replace the header. Tear down the old
    // document listener before binding the new menu so detached menus do not
    // accumulate global handlers.
    mobileNavCleanup?.();
    menu.dataset.initialised = 'true';
    const controller = new AbortController();

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => menu.removeAttribute('open'), { signal: controller.signal });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') menu.removeAttribute('open');
    }, { signal: controller.signal });

    mobileNavCleanup = () => controller.abort();
  }

  setupMobileNavigation();
  document.addEventListener('astro:page-load', setupMobileNavigation);
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: color-mix(in srgb, var(--ie-canvas) 96%, transparent);
    border-bottom: 1px solid var(--ie-rule);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: background-color 120ms ease, border-color 120ms ease;
  }

  :global(html.dark) header {
    background: color-mix(in srgb, var(--ie-canvas) 96%, transparent);
    border-bottom-color: var(--ie-rule);
  }

  .header-inner {
    max-width: 960px;
    min-height: 64px;
    margin: 0 auto;
    padding: 0 var(--space-5, 1.5rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4, 1rem);
  }

  .header-left {
    display: flex;
    align-items: center;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    text-decoration: none;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ie-ink);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .brand-role {
    display: inline-block;
    padding-left: 0.75rem;
    border-left: 1px solid var(--ie-rule);
    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label, 0.8125rem);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .main-nav {
    display: flex;
    gap: 1.75rem;
    align-items: center;
  }

  .main-nav a {
    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: var(--ie-type-ui, 0.875rem);
    letter-spacing: 0.02em;
    text-decoration: none;
    padding: 0.25rem 0;
    transition: color 120ms ease;
  }

  .main-nav a:hover,
  .main-nav a.active {
    color: var(--ie-ink);
    font-weight: 600;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .theme-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--ie-rule);
    border-radius: 5px;
    background: transparent;
    color: var(--ie-muted);
    cursor: pointer;
    transition: all 120ms ease;
  }

  .theme-toggle-btn:hover {
    border-color: var(--ie-rule-strong);
    color: var(--ie-ink);
    background: var(--ie-surface-raised);
  }

  .sun-icon { display: none; }
  .moon-icon { display: block; }

  :global(html.dark) .sun-icon { display: block; }
  :global(html.dark) .moon-icon { display: none; }

  .consult-cta {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--ie-ink);
    border-radius: 5px;
    background: var(--ie-ink);
    color: var(--ie-canvas);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label, 0.8125rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: all 120ms ease;
  }

  .consult-cta:hover {
    border-color: var(--ie-blue);
    background: var(--ie-blue);
    color: #ffffff;
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 1080px) {
    .brand-role {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .header-inner {
      min-height: 56px;
      padding: 0 var(--space-4, 1rem);
    }

    .main-nav {
      display: none;
    }

    .consult-cta {
      display: none;
    }

    .mobile-nav {
      display: block;
      order: 2;
    }

    .mobile-nav summary {
      display: inline-flex;
      min-width: 54px;
      min-height: 36px;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--ie-rule-strong);
      border-radius: 5px;
      color: var(--ie-ink);
      font-family: var(--font-mono);
      font-size: var(--ie-type-label, 0.8125rem);
      font-weight: 600;
      cursor: pointer;
      list-style: none;
    }

    .mobile-nav summary::-webkit-details-marker {
      display: none;
    }

    .mobile-nav[open] summary {
      border-color: var(--ie-blue);
      background: var(--ie-blue-soft);
      color: var(--ie-blue);
    }

    .mobile-nav-panel {
      position: fixed;
      top: 56px;
      right: 0;
      left: 0;
      display: grid;
      padding: 0.6rem 1rem 1rem;
      border-top: 1px solid var(--ie-rule);
      border-bottom: 1px solid var(--ie-rule-strong);
      background: var(--ie-canvas);
      box-shadow: 0 16px 32px color-mix(in srgb, var(--ie-ink) 8%, transparent);
    }

    .mobile-nav:not([open]) .mobile-nav-panel {
      display: none;
    }

    .mobile-nav-panel a {
      display: flex;
      min-height: 46px;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--ie-rule);
      color: var(--ie-ink-secondary);
      font-family: var(--font-mono);
      font-size: 0.875rem;
      text-decoration: none;
    }

    .mobile-nav-panel a.active {
      color: var(--ie-blue);
      font-weight: 600;
    }

    .mobile-nav-panel .mobile-nav-contact {
      margin-top: 0.6rem;
      padding-inline: 0.8rem;
      border: 1px solid var(--ie-ink);
      border-radius: 5px;
      background: var(--ie-ink);
      color: var(--ie-canvas);
    }

    .theme-toggle-btn {
      order: 1;
    }
  }
</style>
