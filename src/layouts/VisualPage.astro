---
import Layout from './Layout.astro';
import DiagramExportBar from '@components/diagram/DiagramExportBar.astro';

interface Props {
  title: string;
  description: string;
  explanation: string;
  targetId: string;
  filename: string;
  category?: string;
  drawingNo?: string;
}

const {
  title,
  description,
  explanation,
  targetId,
  filename,
  category,
  drawingNo,
} = Astro.props;
---

<Layout title={`${title} | Karan Mittal`} description={description}>
  <main class="visual-page" aria-label={title}>
    <nav class="visual-nav" aria-label="Diagram navigation">
      <a href="/ideas/#diagrams">← All ideas</a>
    </nav>

    <header class="visual-head">
      {(drawingNo || category) && (
        <div class="visual-meta">
          {drawingNo && <span class="meta-drawing">{drawingNo}</span>}
          {drawingNo && category && <span class="meta-sep" aria-hidden="true">&bull;</span>}
          {category && <span class="meta-category">{category}</span>}
          <span class="meta-sep" aria-hidden="true">&bull;</span>
          <span class="meta-export">VECTOR BLUEPRINT &bull; 3&times; PNG</span>
        </div>
      )}
      <h1>{title}</h1>
      <p>{description}</p>
    </header>

    <div id={targetId} class="visual-sheet">
      <div class="visual-content">
        <slot />
      </div>
    </div>

    <div class="export-wrap">
      <DiagramExportBar targetId={targetId} filename={filename} caption={description} />
    </div>

    <section class="visual-explanation" aria-labelledby="visual-explanation-title">
      <span class="explanation-badge">Reading Specification</span>
      <h2 id="visual-explanation-title">How to read it</h2>
      <p>{explanation}</p>
    </section>
  </main>
</Layout>

<style>
  .visual-page {
    max-width: 1160px;
    margin: 0 auto;
    padding: 1.25rem var(--space-5) clamp(3rem, 7vw, 6rem);
    color: var(--ie-ink);
    font-family: var(--font-sans);
  }

  .visual-nav {
    min-height: 44px;
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
    border-bottom: 1px solid var(--ie-rule);
  }

  .visual-nav a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--ie-blue);
    font-size: var(--ie-type-ui);
    font-weight: 500;
    text-decoration: none;
  }

  .visual-nav a:hover { text-decoration: underline; }

  .visual-head {
    max-width: 820px;
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
  }

  .visual-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
    font-size: var(--ie-type-micro);
    line-height: 1;
  }

  .meta-drawing {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--ie-ink);
    letter-spacing: 0.04em;
  }

  .meta-sep {
    color: var(--ie-rule-strong);
  }

  .meta-category {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--ie-blue);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .meta-export {
    font-family: var(--font-mono);
    color: var(--ie-muted);
    letter-spacing: 0.03em;
  }

  .visual-head h1 {
    margin: 0 0 0.75rem;
    color: var(--ie-ink);
    font-family: var(--font-display);
    font-size: var(--ie-type-h1);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.12;
  }

  .visual-head p {
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-body);
    line-height: 1.6;
  }

  .visual-sheet {
    padding: clamp(1rem, 3vw, 2rem);
    border: 1px solid var(--ie-rule-strong);
    border-radius: var(--radius-card);
    background: var(--ie-surface);
  }

  .visual-content {
    width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
  }

  .export-wrap { margin-top: 1rem; }

  .visual-explanation {
    max-width: 700px;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--ie-rule-strong);
  }

  .explanation-badge {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--ie-blue);
    font-family: var(--font-sans);
    font-size: var(--ie-type-label);
    font-weight: 600;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .visual-explanation h2 {
    margin: 0 0 0.65rem;
    color: var(--ie-ink);
    font-family: var(--font-display);
    font-size: var(--ie-type-h2);
  }

  .visual-explanation p {
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-base);
    line-height: 1.7;
  }

  @media (max-width: 680px) {
    .visual-page { padding-inline: 1rem; }
    .visual-sheet { padding: 0.75rem; }
  }
</style>
