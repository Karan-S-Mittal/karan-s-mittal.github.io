---
import ExcalidrawContainer from './ExcalidrawContainer.astro';

interface Props {
  caption?: string;
  exhibit?: string;
  title?: string;
}

const { caption, exhibit, title } = Astro.props;
---

<ExcalidrawContainer caption={caption} exhibit={exhibit} title={title} badge="CACHE FOOTPRINT">
  <svg class="ex-svg-canvas sys-diagram" viewBox="0 0 720 370" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="A comparison of MHA, MQA, and GQA showing how many key-value heads are cached for eight query heads.">
    <!-- ROW 1: MHA (1:1) -->
    <g transform="translate(20, 16)">
      <rect x="0" y="0" width="136" height="88" rx="6" class="node-muted" />
      <text x="14" y="24" class="title" font-size="14.5" dominant-baseline="central">MHA (2017)</text>
      <text x="14" y="44" class="label" dominant-baseline="central">1 : 1 MAPPING</text>
      <text x="14" y="66" class="body-muted" font-size="11.5" dominant-baseline="central">8 Query : 8 KV</text>

      <!-- 8 Query Heads -->
      <g transform="translate(154, 6)">
        <text x="0" y="10" class="label" font-size="9.5" dominant-baseline="central">8 QUERY HEADS (Hq)</text>
        <g transform="translate(0, 20)">
          <rect x="0" y="0" width="28" height="28" rx="4" class="node" /><text x="14" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">q₀</text>
          <rect x="33" y="0" width="28" height="28" rx="4" class="node" /><text x="47" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">q₁</text>
          <rect x="66" y="0" width="28" height="28" rx="4" class="node" /><text x="80" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">q₂</text>
          <rect x="99" y="0" width="28" height="28" rx="4" class="node" /><text x="113" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">q₃</text>
          <rect x="132" y="0" width="28" height="28" rx="4" class="node" /><text x="146" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">q₄</text>
          <rect x="165" y="0" width="28" height="28" rx="4" class="node" /><text x="179" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">q₅</text>
          <rect x="198" y="0" width="28" height="28" rx="4" class="node" /><text x="212" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">q₆</text>
          <rect x="231" y="0" width="28" height="28" rx="4" class="node" /><text x="245" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">q₇</text>
        </g>
      </g>

      <!-- 8 KV Heads -->
      <g transform="translate(426, 6)">
        <text x="0" y="10" class="label" font-size="9.5" dominant-baseline="central">8 KV HEADS (100% VRAM)</text>
        <g transform="translate(0, 20)">
          <rect x="0" y="0" width="28" height="28" rx="4" class="node-muted" /><text x="14" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">k₀</text>
          <rect x="33" y="0" width="28" height="28" rx="4" class="node-muted" /><text x="47" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">k₁</text>
          <rect x="66" y="0" width="28" height="28" rx="4" class="node-muted" /><text x="80" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">k₂</text>
          <rect x="99" y="0" width="28" height="28" rx="4" class="node-muted" /><text x="113" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">k₃</text>
          <rect x="132" y="0" width="28" height="28" rx="4" class="node-muted" /><text x="146" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">k₄</text>
          <rect x="165" y="0" width="28" height="28" rx="4" class="node-muted" /><text x="179" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">k₅</text>
          <rect x="198" y="0" width="28" height="28" rx="4" class="node-muted" /><text x="212" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">k₆</text>
          <rect x="231" y="0" width="28" height="28" rx="4" class="node-muted" /><text x="245" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">k₇</text>
        </g>
      </g>
    </g>

    <!-- Mid line -->
    <line x1="20" y1="122" x2="700" y2="122" class="rule" />

    <!-- ROW 2: MQA (8:1) -->
    <g transform="translate(20, 138)">
      <rect x="0" y="0" width="136" height="88" rx="6" class="node-muted" />
      <text x="14" y="24" class="title" font-size="14.5" dominant-baseline="central">MQA (2019)</text>
      <text x="14" y="44" class="label" dominant-baseline="central">8 : 1 MAPPING</text>
      <text x="14" y="66" class="body-muted" font-size="11.5" dominant-baseline="central">8 Query : 1 KV</text>

      <!-- 8 Query Heads -->
      <g transform="translate(154, 6)">
        <text x="0" y="10" class="label" font-size="9.5" dominant-baseline="central">8 QUERY HEADS</text>
        <g transform="translate(0, 20)">
          <rect x="0" y="0" width="28" height="28" rx="4" class="node" /><text x="14" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">q₀</text>
          <rect x="33" y="0" width="28" height="28" rx="4" class="node" /><text x="47" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">q₁</text>
          <rect x="66" y="0" width="28" height="28" rx="4" class="node" /><text x="80" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">q₂</text>
          <rect x="99" y="0" width="28" height="28" rx="4" class="node" /><text x="113" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">q₃</text>
          <rect x="132" y="0" width="28" height="28" rx="4" class="node" /><text x="146" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">q₄</text>
          <rect x="165" y="0" width="28" height="28" rx="4" class="node" /><text x="179" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">q₅</text>
          <rect x="198" y="0" width="28" height="28" rx="4" class="node" /><text x="212" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">q₆</text>
          <rect x="231" y="0" width="28" height="28" rx="4" class="node" /><text x="245" y="14" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">q₇</text>
        </g>
      </g>

      <!-- 1 KV Head -->
      <g transform="translate(426, 6)">
        <text x="0" y="10" class="label-signal" font-size="9.5" dominant-baseline="central">1 SHARED KV HEAD (12.5% VRAM)</text>
        <g transform="translate(0, 20)">
          <rect x="0" y="0" width="259" height="28" rx="4" class="node-signal" />
          <text x="129" y="14" class="label-signal" font-size="9.5" text-anchor="middle" dominant-baseline="central">KV Shared (All 8 heads attend here)</text>
        </g>
      </g>
    </g>

    <!-- Mid line -->
    <line x1="20" y1="244" x2="700" y2="244" class="rule" />

    <!-- ROW 3: GQA (4:1) -->
    <g transform="translate(20, 260)">
      <rect x="0" y="0" width="136" height="88" rx="6" class="node-signal" />
      <text x="14" y="24" class="title" font-size="14.5" dominant-baseline="central" fill="var(--accent)">GQA (2023)</text>
      <text x="14" y="44" class="label-signal" dominant-baseline="central">4 : 1 GROUPING</text>
      <text x="14" y="66" class="body-muted" font-size="11.5" dominant-baseline="central">8 Query : 2 KV</text>

      <!-- 8 Query Heads in 2 Groups -->
      <g transform="translate(154, 6)">
        <text x="0" y="10" class="label-signal" font-size="9.5" dominant-baseline="central">GROUP 1 [q₀–q₃]  ·  GROUP 2 [q₄–q₇]</text>
        <g transform="translate(0, 20)">
          <!-- Group 1 -->
          <rect x="0" y="0" width="124" height="28" rx="4" class="node-signal" />
          <text x="62" y="14" class="label-signal" font-size="9.5" text-anchor="middle" dominant-baseline="central">q₀, q₁, q₂, q₃</text>
          <!-- Group 2 -->
          <rect x="135" y="0" width="124" height="28" rx="4" class="node-signal" />
          <text x="197" y="14" class="label-signal" font-size="9.5" text-anchor="middle" dominant-baseline="central">q₄, q₅, q₆, q₇</text>
        </g>
      </g>

      <!-- 2 KV Heads -->
      <g transform="translate(426, 6)">
        <text x="0" y="10" class="label-signal" font-size="9.5" dominant-baseline="central">2 KV HEADS (25% VRAM — SWEET SPOT)</text>
        <g transform="translate(0, 20)">
          <rect x="0" y="0" width="124" height="28" rx="4" class="node-signal" />
          <text x="62" y="14" class="label-signal" font-size="9.5" text-anchor="middle" dominant-baseline="central">KV Group 1</text>
          <rect x="135" y="0" width="124" height="28" rx="4" class="node-signal" />
          <text x="197" y="14" class="label-signal" font-size="9.5" text-anchor="middle" dominant-baseline="central">KV Group 2</text>
        </g>
      </g>
    </g>
  </svg>
</ExcalidrawContainer>



