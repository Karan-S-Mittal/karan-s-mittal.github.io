---
/**
 * PlatformStackHierarchy.astro
 * Visualizes the 4-layer functional hierarchy of modern developer platforms:
 * SCM Core -> Collaboration -> Automation/Artifacts -> Dev Environments & AI.
 * 100% compliant with Soft Architecture tokens.
 */
import VisualAttribution from '../VisualAttribution.astro';

interface Props {
  id?: string;
}

const { id = 'platform-stack-hierarchy' } = Astro.props;
---

<div class="platform-hierarchy" id={id}>
  <div class="stack-container">
    <!-- Layer 4: AI & Dev Environments -->
    <div class="stack-layer layer-ai">
      <div class="layer-badge">
        <span class="layer-num">04</span>
        <span class="layer-name">Optional Development Environments</span>
      </div>
      <div class="layer-cards">
        <div class="stack-pill highlight">Remote Workspaces</div>
        <div class="stack-pill highlight">Development Containers</div>
        <div class="stack-pill">Remote Editor Services</div>
        <div class="stack-pill">Workspace Lifecycle Controls</div>
      </div>
    </div>

    <div class="stack-connector">
      <span class="connector-line"></span>
      <span class="connector-text">Adds an optional working environment</span>
      <span class="connector-line"></span>
    </div>

    <!-- Layer 3: Automation & Artifacts -->
    <div class="stack-layer layer-automation">
      <div class="layer-badge">
        <span class="layer-num">03</span>
        <span class="layer-name">Automation & Artifact Delivery</span>
      </div>
      <div class="layer-cards">
        <div class="stack-pill">Workflow Scheduler & Runner Queue</div>
        <div class="stack-pill">Package & OCI Registries</div>
        <div class="stack-pill">Build Logs, Caches & Artifacts</div>
        <div class="stack-pill">Deployment & Secret Distribution</div>
      </div>
    </div>

    <div class="stack-connector">
      <span class="connector-line"></span>
      <span class="connector-text">Reacts to repository and review events</span>
      <span class="connector-line"></span>
    </div>

    <!-- Layer 2: Collaboration & Governance -->
    <div class="stack-layer layer-collab">
      <div class="layer-badge">
        <span class="layer-num">02</span>
        <span class="layer-name">Collaboration, Review & Policy</span>
      </div>
      <div class="layer-cards">
        <div class="stack-pill">Pull Requests & Inline Code Review</div>
        <div class="stack-pill">Branch Protection & Merge Queues</div>
        <div class="stack-pill">Issues, Kanban Projects & Discussions</div>
        <div class="stack-pill">Wikis (Git Documentation Sub-repos)</div>
      </div>
    </div>

    <div class="stack-connector">
      <span class="connector-line"></span>
      <span class="connector-text">Binds human coordination around Git refs</span>
      <span class="connector-line"></span>
    </div>

    <!-- Layer 1: Core SCM -->
    <div class="stack-layer layer-scm">
      <div class="layer-badge">
        <span class="layer-num">01</span>
        <span class="layer-name">Core SCM & Object Storage Engine</span>
      </div>
      <div class="layer-cards">
        <div class="stack-pill foundation">Git Repositories (Bare Remotes)</div>
        <div class="stack-pill foundation">Objects (Blobs, Trees, Commits, Tags)</div>
        <div class="stack-pill foundation">Reference Pointers (Branches, Tags, HEAD)</div>
        <div class="stack-pill foundation">Packfiles & Delta Compression (.pack, .idx)</div>
      </div>
    </div>
  </div>

  <div class="diagram-footer">
    <VisualAttribution />
  </div>
</div>

<style>
  .platform-hierarchy {
    width: 100%;
    padding: 1.5rem;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 8px);
    font-family: var(--font-sans);
  }

  .stack-container {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 820px;
    margin: 0 auto;
  }

  .stack-layer {
    padding: 1rem 1.25rem;
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-sm, 6px);
    background: var(--ie-surface-raised);
    transition: border-color 150ms ease;
  }

  .layer-scm {
    border-color: var(--ie-rule-strong);
    background: color-mix(in srgb, var(--ie-blue-soft) 40%, var(--ie-surface));
    border-left: 3px solid var(--ie-blue);
  }

  .layer-collab {
    border-left: 3px solid var(--ie-ink);
  }

  .layer-automation {
    border-left: 3px solid var(--ie-rust);
  }

  .layer-ai {
    border-left: 3px solid var(--ie-verified);
  }

  .layer-badge {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }

  .layer-num {
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    font-weight: 600;
    color: var(--ie-muted);
  }

  .layer-name {
    font-family: var(--font-display);
    font-size: var(--ie-type-ui);
    font-weight: 600;
    color: var(--ie-ink);
    letter-spacing: -0.01em;
  }

  .layer-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.5rem;
  }

  .stack-pill {
    padding: 0.45rem 0.7rem;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-sm, 4px);
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    color: var(--ie-ink-secondary);
    line-height: 1.4;
  }

  .stack-pill.foundation {
    font-weight: 600;
    color: var(--ie-ink);
  }

  .stack-pill.highlight {
    border-color: color-mix(in srgb, var(--ie-verified) 40%, var(--ie-rule));
  }

  .stack-connector {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.15rem 0.5rem;
  }

  .connector-line {
    flex: 1;
    height: 1px;
    background: var(--ie-rule);
  }

  .connector-text {
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    color: var(--ie-muted);
    letter-spacing: 0.02em;
  }

  .diagram-footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--ie-rule);
  }

  @media (max-width: 640px) {
    .layer-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
