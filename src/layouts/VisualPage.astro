---
import Layout from './Layout.astro';
import DiagramExportBar from '@components/diagram/DiagramExportBar.astro';

interface Props {
  title: string;
  description: string;
  explanation: string;
  targetId: string;
  filename: string;
  category?: string;
  drawingNo?: string;
  canonicalId?: string;
  modelStatus?: 'explanatory' | 'specification' | 'comparison';
  socialImage?: string;
  provenance?: {
    sources: Array<{ label: string; url?: string; type?: string }>;
    illustrativeScope?: string;
  };
}

const {
  title,
  description,
  explanation,
  targetId,
  filename,
  category,
  drawingNo,
  canonicalId = drawingNo,
  modelStatus,
  socialImage,
  provenance,
} = Astro.props;
---

<Layout title={`${title} | Karan Mittal`} description={description} image={socialImage}>
  <main class="visual-page" aria-label={title}>
    <nav class="visual-nav" aria-label="Diagram navigation">
      <a href="/ideas/#diagrams">← All ideas</a>
    </nav>

    <header class="visual-head">
      {(canonicalId || category) && (
        <div class="visual-meta">
          {canonicalId && <span class="meta-drawing">{canonicalId}</span>}
          {canonicalId && category && <span class="meta-sep" aria-hidden="true">&bull;</span>}
          {category && <span class="meta-category">{category}</span>}
          {modelStatus && (
            <>
              <span class="meta-sep" aria-hidden="true">&bull;</span>
              <span class="meta-status-tag">{modelStatus.toUpperCase()} MODEL</span>
            </>
          )}
          <span class="meta-sep" aria-hidden="true">&bull;</span>
          <span class="meta-export">VECTOR BLUEPRINT &bull; 3&times; PNG</span>
        </div>
      )}
      <h1>{title}</h1>
      <p>{description}</p>
    </header>

    <div id={targetId} class="visual-sheet">
      <div class="visual-content">
        <slot />
      </div>
    </div>

    <div class="export-wrap">
      <DiagramExportBar targetId={targetId} filename={filename} caption={description} />
    </div>

    <!-- Textual Semantic Legend -->
    <section class="diagram-legend" aria-label="Visual grammar semantic legend">
      <div class="legend-items">
        <div class="legend-item">
          <span class="legend-swatch swatch-blue" aria-hidden="true"></span>
          <span class="legend-label"><strong>Dependency / Flow</strong> Active execution, data flow, or structural hierarchy</span>
        </div>
        <div class="legend-item">
          <span class="legend-swatch swatch-verified" aria-hidden="true"></span>
          <span class="legend-label"><strong>Verified / Bounded</strong> Confirmed compliance, validated commit, or safe route</span>
        </div>
        <div class="legend-item">
          <span class="legend-swatch swatch-rust" aria-hidden="true"></span>
          <span class="legend-label"><strong>Constraint / Gap</strong> Policy boundary, unresolved relationship, or failure gate</span>
        </div>
      </div>
    </section>

    <section class="visual-explanation" aria-labelledby="visual-explanation-title">
      <span class="explanation-badge">Reading Specification</span>
      <h2 id="visual-explanation-title">How to read it</h2>
      <p>{explanation}</p>

      {provenance && (
        <div class="visual-provenance">
          <span class="provenance-badge">Provenance &amp; Verification Standard</span>
          {provenance.illustrativeScope && (
            <p class="illustrative-scope">{provenance.illustrativeScope}</p>
          )}
          {provenance.sources && provenance.sources.length > 0 && (
            <div class="provenance-sources-wrap">
              <span class="provenance-subheading">Primary Documentation &amp; Standards:</span>
              <ul class="provenance-list">
                {provenance.sources.map((src) => (
                  <li>
                    {src.url ? (
                      <a href={src.url} target="_blank" rel="noopener">
                        <span>{src.label}</span>
                        <span class="ext-arrow" aria-hidden="true">↗</span>
                      </a>
                    ) : (
                      <span>{src.label}</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}
    </section>
  </main>
</Layout>

<style>
  .visual-page {
    max-width: 1160px;
    margin: 0 auto;
    padding: 1.25rem var(--space-5) clamp(3rem, 7vw, 6rem);
    color: var(--ie-ink);
    font-family: var(--font-sans);
  }

  .visual-nav {
    min-height: 44px;
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
    border-bottom: 1px solid var(--ie-rule);
  }

  .visual-nav a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--ie-blue);
    font-size: var(--ie-type-ui);
    font-weight: 500;
    text-decoration: none;
  }

  .visual-nav a:hover { text-decoration: underline; }

  .visual-head {
    max-width: 820px;
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
  }

  .visual-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
    font-size: var(--ie-type-micro);
    line-height: 1;
  }

  .meta-drawing {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--ie-ink);
    letter-spacing: 0.04em;
  }

  .meta-sep {
    color: var(--ie-rule-strong);
  }

  .meta-category {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--ie-blue);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .meta-export {
    font-family: var(--font-mono);
    color: var(--ie-muted);
    letter-spacing: 0.03em;
  }

  .visual-head h1 {
    margin: 0 0 0.75rem;
    color: var(--ie-ink);
    font-family: var(--font-display);
    font-size: var(--ie-type-h1);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.12;
  }

  .visual-head p {
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-body);
    line-height: 1.6;
  }

  .visual-sheet {
    padding: clamp(1rem, 3vw, 2rem);
    border: 1px solid var(--ie-rule-strong);
    border-radius: var(--radius-card);
    background: var(--ie-surface);
  }

  .visual-content {
    width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
  }

  .export-wrap { margin-top: 1rem; }

  .visual-explanation {
    max-width: 700px;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--ie-rule-strong);
  }

  .explanation-badge {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--ie-blue);
    font-family: var(--font-sans);
    font-size: var(--ie-type-label);
    font-weight: 600;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .visual-explanation h2 {
    margin: 0 0 0.65rem;
    color: var(--ie-ink);
    font-family: var(--font-display);
    font-size: var(--ie-type-h2);
  }

  .visual-explanation p {
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-base);
    line-height: 1.7;
  }

  .meta-status-tag {
    font-family: var(--font-mono);
    color: var(--ie-muted);
    letter-spacing: 0.04em;
  }

  .diagram-legend {
    margin-top: 1.5rem;
    padding: 0.85rem 1.15rem;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 6px);
  }

  .legend-items {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--ie-type-micro);
    color: var(--ie-ink-secondary);
    line-height: 1.4;
  }

  .legend-swatch {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .swatch-blue {
    background: var(--ie-blue);
  }

  .swatch-verified {
    background: var(--ie-verified);
  }

  .swatch-rust {
    background: var(--ie-rust);
  }

  .legend-label strong {
    color: var(--ie-ink);
    margin-right: 0.35rem;
  }

  .visual-provenance {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--ie-rule-strong);
  }

  .provenance-badge {
    display: block;
    margin-bottom: 0.6rem;
    color: var(--ie-blue);
    font-family: var(--font-sans);
    font-size: var(--ie-type-micro);
    font-weight: 600;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .illustrative-scope {
    margin: 0 0 0.85rem;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-small);
    line-height: 1.6;
    max-width: 68ch;
  }

  .provenance-sources-wrap {
    margin-top: 0.85rem;
  }

  .provenance-subheading {
    display: block;
    margin-bottom: 0.45rem;
    font-family: var(--font-sans);
    font-size: var(--ie-type-micro);
    font-weight: 600;
    color: var(--ie-ink);
    letter-spacing: 0.02em;
  }

  .provenance-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .provenance-list li a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ie-blue);
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    text-decoration: none;
  }

  .provenance-list li a:hover {
    text-decoration: underline;
  }

  .provenance-list li span {
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    color: var(--ie-ink-secondary);
  }

  .ext-arrow {
    color: var(--ie-muted);
  }

  @media (max-width: 680px) {
    .visual-page { padding-inline: 1rem; }
    .visual-sheet { padding: 0.75rem; }
    .legend-items { flex-direction: column; gap: 0.65rem; }
  }
</style>
