---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Karan Mittal | Solutions Architect">
  <main style="max-width: 720px; margin: 0 auto; padding: 3rem 1.5rem;">
    <nav style="margin-bottom: 2rem; font-size: 0.9rem; color: var(--muted);">
      <a href="/" style="font-weight: 600; color: var(--accent);">Karan Mittal</a>
      <span style="margin: 0 0.5rem;">/</span>
      <a href="/blog">Writing</a>
    </nav>

    <h1 style="font-size: 2rem; margin-bottom: 0.5rem;">Solutions Architect & Technical Leader</h1>
    <p style="font-size: 1.15rem; color: var(--muted); margin-bottom: 2rem;">
      Building deterministic, high-performance AI systems that scale reliably.
    </p>

    <section style="margin-bottom: 2.5rem;">
      <h2 style="font-size: 1.1rem; margin-bottom: 0.75rem;">Current Focus</h2>
      <ul style="padding-left: 1.25rem; color: var(--muted);">
        <li>Production-grade GraphRAG with deterministic retrieval guarantees</li>
        <li>CPU/GPU co-design patterns for edge LLM inference</li>
        <li>Open-source tooling for reproducible RAG evaluation</li>
      </ul>
    </section>

    <section style="margin-bottom: 2.5rem;">
      <h2 style="font-size: 1.1rem; margin-bottom: 0.75rem;">Selected Work</h2>
      <p style="color: var(--muted);">
        Explore my pinned repositories on
        <a href="https://github.com/Karan-S-Mittal">GitHub</a> or read my
        <a href="/blog">technical writing</a>.
      </p>
    </section>

    <section>
      <h2 style="font-size: 1.1rem; margin-bottom: 0.75rem;">Connect</h2>
      <p style="color: var(--muted);">
        <a href="https://www.linkedin.com/in/karansmittal/">LinkedIn</a>
        <span style="margin: 0 0.5rem;">·</span>
        <a href="https://twitter.com/KaranSMittal">X / Twitter</a>
        <span style="margin: 0 0.5rem;">·</span>
        <a href="mailto:karanshyammittal@gmail.com">Email</a>
      </p>
    </section>
  </main>
</Layout>
