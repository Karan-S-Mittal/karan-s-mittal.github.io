---
/**
 * SiteBackdrop.astro
 *
 * Computational Graph & HPC Lattice backdrop.
 * Pure visual representation with topological nodes, tensor flow geodesics,
 * and animated data movement streams adhering strictly to Soft Architecture tokens.
 * Completely free of text labels and annotations.
 */
---

<div class="site-backdrop" aria-hidden="true">
  <svg class="backdrop-svg" viewBox="0 0 1440 900" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMin slice">
    <defs>
      <!-- HPC Coordinate Matrix Pattern -->
      <pattern id="hpc-lattice" width="48" height="48" patternUnits="userSpaceOnUse">
        <circle cx="24" cy="24" r="1" class="lattice-dot" />
        <path d="M 22 24 L 26 24 M 24 22 L 24 26" class="lattice-cross" />
      </pattern>
    </defs>

    <!-- Lattice Grid Plane -->
    <rect width="100%" height="100%" fill="url(#hpc-lattice)" opacity="0.6" />

    <!-- Topological Structural Bounds & Orbitals -->
    <g class="graph-mesh">
      <!-- Central Orchestration Orbitals & Pulse Halos -->
      <circle cx="720" cy="210" r="140" class="orbital-ring rotating" stroke-dasharray="4 10" />
      <circle cx="720" cy="210" r="260" class="orbital-ring wide" stroke-dasharray="3 16" />
      <circle cx="720" cy="210" r="64" class="core-halo pulse-halo" />

      <!-- Left Cluster: Topological Subgraph -->
      <g class="cluster left-cluster">
        <path class="cluster-boundary" d="M 160 170 Q 270 110 370 190 T 330 350 T 140 310 Z" />
        
        <!-- Cluster Guide Edges -->
        <line x1="180" y1="270" x2="230" y2="210" class="cluster-edge" />
        <line x1="230" y1="210" x2="320" y2="170" class="cluster-edge" />
        <line x1="320" y1="170" x2="290" y2="290" class="cluster-edge" />
        <line x1="290" y1="290" x2="220" y2="330" class="cluster-edge" />
        <line x1="220" y1="330" x2="180" y2="270" class="cluster-edge" />
        <line x1="230" y1="210" x2="290" y2="290" class="cluster-edge" />

        <!-- Intra-Cluster Data Movement Streams -->
        <path class="stream-line stream-amber" d="M 180 270 L 230 210 L 320 170" />
        <path class="stream-line stream-verified" d="M 320 170 L 290 290 L 220 330" />

        <!-- Cluster Nodes -->
        <circle cx="180" cy="270" r="5" class="graph-node" />
        <circle cx="230" cy="210" r="11" class="node-ring" />
        <circle cx="230" cy="210" r="7" class="graph-node primary" />
        <circle cx="320" cy="170" r="6" class="graph-node" />
        <circle cx="290" cy="290" r="12" class="node-ring" />
        <circle cx="290" cy="290" r="8" class="graph-node verified" />
        <circle cx="220" cy="330" r="5" class="graph-node" />
      </g>

      <!-- Right Cluster: Execution & Isolation Subgraph -->
      <g class="cluster right-cluster">
        <path class="cluster-boundary" d="M 1070 150 Q 1210 120 1300 210 T 1240 360 T 1050 280 Z" />
        
        <!-- Cluster Guide Edges -->
        <line x1="1110" y1="190" x2="1210" y2="170" class="cluster-edge" />
        <line x1="1210" y1="170" x2="1250" y2="270" class="cluster-edge" />
        <line x1="1250" y1="270" x2="1200" y2="340" class="cluster-edge" />
        <line x1="1200" y1="340" x2="1150" y2="310" class="cluster-edge" />
        <line x1="1150" y1="310" x2="1110" y2="190" class="cluster-edge" />
        <line x1="1210" y1="170" x2="1150" y2="310" class="cluster-edge" />

        <!-- Intra-Cluster Data Movement Streams -->
        <path class="stream-line stream-amber-fast" d="M 1110 190 L 1210 170 L 1250 270" />
        <path class="stream-line stream-reverse" d="M 1250 270 L 1200 340 L 1150 310" />

        <!-- Cluster Nodes -->
        <circle cx="1110" cy="190" r="7" class="graph-node" />
        <circle cx="1210" cy="170" r="10" class="node-ring" />
        <circle cx="1210" cy="170" r="6" class="graph-node primary" />
        <circle cx="1250" cy="270" r="12" class="node-ring" />
        <circle cx="1250" cy="270" r="8" class="graph-node rust" />
        <circle cx="1150" cy="310" r="5" class="graph-node" />
        <circle cx="1200" cy="340" r="5" class="graph-node" />
      </g>

      <!-- Inter-Cluster Guide Tracks -->
      <path class="guide-track" d="M 320 170 C 440 150 560 180 706 210" />
      <path class="guide-track" d="M 708 218 C 570 280 430 330 290 290" />
      <path class="guide-track" d="M 734 210 C 860 190 980 175 1110 190" />
      <path class="guide-track" d="M 1150 310 C 1010 320 870 270 732 218" />
      <path class="guide-track arch" d="M 230 210 C 460 60 980 60 1210 170" />
      <path class="guide-track arch-low" d="M 180 270 C 460 450 960 450 1250 270" />

      <!-- Active Data Movement Streams (Animated Packets / Pulses) -->
      <!-- Left to Center Highway -->
      <path class="stream-line stream-amber" d="M 320 170 C 440 150 560 180 706 210" />
      <!-- Center to Left Return -->
      <path class="stream-line stream-verified" d="M 708 218 C 570 280 430 330 290 290" />
      <!-- Center to Right Dispatch -->
      <path class="stream-line stream-amber-fast" d="M 734 210 C 860 190 980 175 1110 190" />
      <!-- Right to Center Sync -->
      <path class="stream-line stream-reverse" d="M 1150 310 C 1010 320 870 270 732 218" />
      <!-- Long-range Macro Transits -->
      <path class="stream-line stream-amber" d="M 230 210 C 460 60 980 60 1210 170" />
      <path class="stream-line stream-reverse-slow" d="M 180 270 C 460 450 960 450 1250 270" />

      <!-- Central Node: Core Dispatch & Hub -->
      <g class="cluster core-cluster">
        <circle cx="720" cy="210" r="22" class="node-ring" />
        <circle cx="720" cy="210" r="14" class="core-node-outer" />
        <circle cx="720" cy="210" r="7" class="core-node-inner" />
        <circle cx="720" cy="210" r="2.5" class="core-node-pin" />
      </g>

      <!-- Micro Precision Junction Markers (Diamonds, no text) -->
      <rect x="510" y="172" width="5" height="5" class="junction-pin" transform="rotate(45 512.5 174.5)" />
      <rect x="920" y="186" width="5" height="5" class="junction-pin" transform="rotate(45 922.5 188.5)" />
      <rect x="717.5" y="67.5" width="5" height="5" class="junction-pin" transform="rotate(45 720 70)" />
      <rect x="717.5" y="347.5" width="5" height="5" class="junction-pin" transform="rotate(45 720 350)" />
      <rect x="548" y="278" width="4" height="4" class="junction-pin" transform="rotate(45 550 280)" />
      <rect x="888" y="268" width="4" height="4" class="junction-pin" transform="rotate(45 890 270)" />
    </g>
  </svg>
</div>

<style>
  .site-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .backdrop-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    -webkit-mask-image: radial-gradient(ellipse at 50% 28%, black 20%, rgb(0 0 0 / 0.45) 55%, transparent 80%);
    mask-image: radial-gradient(ellipse at 50% 28%, black 20%, rgb(0 0 0 / 0.45) 55%, transparent 80%);
  }

  /* Lattice Pattern */
  .lattice-dot {
    fill: var(--ie-rule-strong);
    opacity: 0.4;
  }

  .lattice-cross {
    stroke: var(--ie-rule);
    stroke-width: 0.8;
    opacity: 0.6;
  }

  /* Orbitals & Halos */
  .orbital-ring {
    fill: none;
    stroke: var(--ie-rule);
    stroke-width: 1;
    opacity: 0.65;
  }

  .orbital-ring.rotating {
    transform-origin: 720px 210px;
    animation: orbit-rotate 180s linear infinite;
  }

  .orbital-ring.wide {
    stroke: var(--ie-rule-strong);
    opacity: 0.35;
  }

  .core-halo {
    fill: none;
    stroke: var(--ie-blue);
    stroke-width: 1.5;
    stroke-opacity: 0.25;
    stroke-dasharray: 4 6;
  }

  .pulse-halo {
    transform-origin: 720px 210px;
    animation: halo-breathe 8s ease-in-out infinite;
  }

  /* Clusters */
  .cluster-boundary {
    fill: var(--ie-surface-raised);
    fill-opacity: 0.25;
    stroke: var(--ie-rule);
    stroke-width: 1;
    stroke-dasharray: 6 8;
  }

  .cluster-edge {
    stroke: var(--ie-rule-strong);
    stroke-width: 1.2;
    stroke-opacity: 0.55;
    vector-effect: non-scaling-stroke;
  }

  /* Nodes */
  .graph-node {
    fill: var(--ie-canvas);
    stroke: var(--ie-rule-strong);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .graph-node.primary {
    stroke: var(--ie-blue);
    fill: var(--ie-blue-soft);
  }

  .graph-node.verified {
    stroke: var(--ie-verified);
    fill: var(--ie-verified-soft);
  }

  .graph-node.rust {
    stroke: var(--ie-rust);
    fill: var(--ie-rust-soft);
  }

  .node-ring {
    fill: none;
    stroke: var(--ie-rule-strong);
    stroke-width: 1;
    opacity: 0.45;
    stroke-dasharray: 2 4;
  }

  /* Core Node Hierarchy */
  .core-node-outer {
    fill: var(--ie-surface);
    stroke: var(--ie-blue);
    stroke-width: 1.5;
  }

  .core-node-inner {
    fill: var(--ie-blue-soft);
    stroke: var(--ie-blue);
    stroke-width: 1.5;
  }

  .core-node-pin {
    fill: var(--ie-blue);
  }

  /* Guide Tracks (Structural Blueprint Lines) */
  .guide-track {
    fill: none;
    stroke: var(--ie-rule);
    stroke-width: 1;
    stroke-opacity: 0.65;
    vector-effect: non-scaling-stroke;
  }

  .guide-track.arch {
    stroke: var(--ie-blue);
    stroke-opacity: 0.12;
    stroke-dasharray: 3 8;
  }

  .guide-track.arch-low {
    stroke: var(--ie-rule-strong);
    stroke-opacity: 0.2;
    stroke-dasharray: 4 10;
  }

  /* Active Data Movement Streams */
  .stream-line {
    fill: none;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .stream-amber {
    stroke: var(--ie-blue);
    stroke-width: 1.5;
    stroke-dasharray: 6 18;
    animation: flow-forward 16s linear infinite;
    opacity: 0.65;
  }

  .stream-amber-fast {
    stroke: var(--ie-blue);
    stroke-width: 1.5;
    stroke-dasharray: 4 14;
    animation: flow-forward 10s linear infinite;
    opacity: 0.75;
  }

  .stream-verified {
    stroke: var(--ie-verified);
    stroke-width: 1.5;
    stroke-dasharray: 5 16;
    animation: flow-reverse 14s linear infinite;
    opacity: 0.65;
  }

  .stream-reverse {
    stroke: var(--ie-blue);
    stroke-width: 1.2;
    stroke-dasharray: 4 16;
    animation: flow-reverse 18s linear infinite;
    opacity: 0.55;
  }

  .stream-reverse-slow {
    stroke: var(--ie-rule-strong);
    stroke-width: 1.2;
    stroke-dasharray: 5 20;
    animation: flow-reverse 26s linear infinite;
    opacity: 0.45;
  }

  /* Keyframe Animations for Data Movement */
  @keyframes flow-forward {
    from {
      stroke-dashoffset: 0;
    }
    to {
      stroke-dashoffset: -240;
    }
  }

  @keyframes flow-reverse {
    from {
      stroke-dashoffset: 0;
    }
    to {
      stroke-dashoffset: 240;
    }
  }

  @keyframes orbit-rotate {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes halo-breathe {
    0%, 100% {
      transform: scale(0.95);
      stroke-opacity: 0.2;
    }
    50% {
      transform: scale(1.1);
      stroke-opacity: 0.45;
    }
  }

  .junction-pin {
    fill: var(--ie-canvas);
    stroke: var(--ie-blue);
    stroke-width: 1;
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .backdrop-svg {
      opacity: 0.5;
    }

    .orbital-ring.wide,
    .guide-track.arch,
    .guide-track.arch-low {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stream-line,
    .orbital-ring.rotating,
    .pulse-halo {
      animation: none !important;
    }
  }

  @media print {
    .site-backdrop {
      display: none;
    }
  }
</style>
