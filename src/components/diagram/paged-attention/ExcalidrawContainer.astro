---
/**
 * ExcalidrawContainer.astro
 * Technical diagram canvas with a shared semantic palette inside the site's Exhibit frame.
 */
import Exhibit from '../../editorial/Exhibit.astro';

interface Props {
  caption?: string;
  badge?: string;
  exhibit?: string;
  title?: string;
}

const { caption, badge, exhibit, title } = Astro.props;
---

<Exhibit exhibit={exhibit} title={title} badge={badge} caption={caption} wide>
  <div class="ex-canvas-frame">
    <slot />
    <p class="ex-canvas-hint">On small screens, the figure scales to the reading column.</p>
  </div>
</Exhibit>

<style is:global>
  .ex-canvas-frame {
    position: relative;
    width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-color: var(--border-default) transparent;
  }

  .ex-canvas-hint {
    display: none;
  }

  .ex-svg-canvas {
    display: block;
    width: 100%;
    max-width: 720px;
    height: auto;
    font-family: var(--font-sans);
    margin: 0 auto;
  }

  /* Node styling in Light Mode */
  .sys-diagram .node {
    fill: #ffffff;
    stroke: var(--ink-900);
    stroke-width: 1.5;
  }

  .sys-diagram .node-muted {
    fill: var(--ex-gray-bg);
    stroke: var(--ex-border);
    stroke-width: 1.2;
  }

  .sys-diagram .node-signal {
    fill: var(--ex-blue-bg);
    stroke: var(--ex-blue-stroke);
    stroke-width: 1.5;
  }

  /* Node styling in Dark Mode */
  :global(html.dark) .sys-diagram .node {
    fill: #1e1e23;
    stroke: rgba(255, 255, 255, 0.22);
    stroke-width: 1.5;
  }

  :global(html.dark) .sys-diagram .node-muted {
    fill: #151518;
    stroke: rgba(255, 255, 255, 0.12);
    stroke-width: 1.2;
  }

  :global(html.dark) .sys-diagram .node-signal {
    fill: rgba(41, 151, 255, 0.14);
    stroke: var(--blue-400);
    stroke-width: 1.5;
  }

  .sys-diagram .rule {
    stroke: var(--border-default);
    stroke-width: 1;
  }

  .sys-diagram .flow {
    fill: none;
    stroke: var(--ink-700);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  :global(html.dark) .sys-diagram .flow {
    stroke: rgba(255, 255, 255, 0.6);
  }

  .sys-diagram .flow-signal {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sys-diagram .flow-dashed {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 4 4;
  }

  /* Typography inside SVG diagrams */
  .sys-diagram text {
    user-select: none;
  }

  .sys-diagram .title {
    fill: var(--text);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
  }

  .sys-diagram .body {
    fill: var(--text);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
  }

  .sys-diagram .body-muted {
    fill: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 400;
  }

  .sys-diagram .label {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .sys-diagram .label-signal {
    fill: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (max-width: 759px) {
    .ex-svg-canvas {
      min-width: 0;
    }

    .ex-canvas-hint {
      display: block;
      margin: 0.75rem 0 0;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      line-height: 1.45;
    }
  }
</style>

