---
// Iconography per Soft Architecture spec §46: 24×24 grid, 1.5px monoline,
// round caps/joins, currentColor. Glyphs come from @lucide/astro (tree-shaken).
import { Briefcase, Wrench, BookOpen, Users, Mic, ExternalLink, ArrowUpRight } from '@lucide/astro';

interface Props {
  name: 'briefcase' | 'wrench' | 'book-open' | 'users' | 'mic' | 'external-link' | 'arrow-up-right';
  size?: number;
  strokeWidth?: number;
}

const { name, size = 16 } = Astro.props;

const icons = {
  briefcase: Briefcase,
  wrench: Wrench,
  'book-open': BookOpen,
  users: Users,
  mic: Mic,
  'external-link': ExternalLink,
  'arrow-up-right': ArrowUpRight,
};

const Glyph = icons[name];
---

<span class="icon-inline" style={`display:inline-flex; align-items:center; margin-right:0.5rem; color:inherit;`}>
  <Glyph size={size} aria-hidden="true" />
</span>

<style>
  /* Spec §46: 1.5px monoline regardless of package default */
  .icon-inline :global(svg) {
    stroke-width: 1.5;
  }
</style>
