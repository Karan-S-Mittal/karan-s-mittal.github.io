---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import workData from '../data/work.json';
import talksData from '../data/talks.json';
import { SITE } from '../config';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const featuredWork = workData.work.slice(0, 3);
const talkCount = talksData.talks.length;
const communityCount = 3;

function formatDate(date: Date | string) {
  const d = typeof date === 'string' ? new Date(date) : date;
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<Layout
  title={`${SITE.title} | Deterministic Engineering`}
  description={SITE.description}
>
  <main class="home-container">
    <!-- HERO SECTION: Editorial Statement + Authentic Portrait -->
    <section class="hero-section" aria-labelledby="home-title">
      <div class="hero-grid">
        <div class="hero-content">
          <p class="section-meta-tag">
            <span class="meta-sym">&sect;01</span>
            <span class="meta-text">INDEPENDENT CONSULTING &middot; DEXTAR CO-FOUNDER</span>
          </p>
          <h1 id="home-title" class="hero-title">
            Engineering systems<br />you can rely on.
          </h1>
          <p class="hero-lead">
            I design deterministic data and AI systems for teams working with complexity&mdash;knowledge engines,
            production retrieval, and the infrastructure that makes ambitious work dependable.
          </p>
          <div class="hero-actions">
            <a href="#contact" class="btn-primary">Discuss an engagement</a>
            <a href="/work" class="btn-secondary">See selected work</a>
          </div>
        </div>

        <div class="hero-portrait-card">
          <div class="portrait-frame">
            <img
              src="/profile-400.jpg"
              alt="Karan Mittal speaking on deterministic AI systems"
              class="portrait-img"
              width="400"
              height="400"
              loading="eager"
            />
          </div>
          <div class="principle-box">
            <p class="principle-label">OPERATING PRINCIPLE</p>
            <p class="principle-quote">&ldquo;Reliability is designed into the system&mdash;never added as an afterthought.&rdquo;</p>
          </div>
        </div>
      </div>

      <!-- Proof Strip: 3 Core Pillars -->
      <div class="proof-strip">
        <div class="proof-item">
          <span class="proof-num">01</span>
          <span class="proof-text">Knowledge &amp; retrieval systems</span>
        </div>
        <div class="proof-item">
          <span class="proof-num">02</span>
          <span class="proof-text">Performance engineering</span>
        </div>
        <div class="proof-item">
          <span class="proof-num">03</span>
          <span class="proof-text">Production data &amp; AI delivery</span>
        </div>
      </div>
    </section>

    <!-- SECTION 02: SELECTED WORK -->
    <section class="home-section" id="work" aria-labelledby="work-heading">
      <div class="section-header-split">
        <div>
          <p class="section-meta-tag">
            <span class="meta-sym">&sect;02</span>
            <span class="meta-text">SELECTED WORK</span>
          </p>
          <h2 id="work-heading" class="section-title">The system is the product.</h2>
        </div>
        <p class="section-header-desc">
          Representative architecture challenges, described without exposing client detail.
        </p>
      </div>

      <div class="cards-grid-3">
        {featuredWork.map((item) => (
          <div class="system-card">
            <p class="card-eyebrow">{item.eyebrow}</p>
            <h3 class="card-title">{item.title}</h3>
            <p class="card-summary">{item.summary}</p>
          </div>
        ))}
      </div>

      <div class="section-footer-row">
        <a href="/work" class="editorial-arrow-link">Explore the engineering lenses &rarr;</a>
      </div>
    </section>

    <!-- SECTION 03: FIELD NOTES (Writing & Public Insights) -->
    <section class="home-section" id="ideas" aria-labelledby="ideas-heading">
      <div class="section-header-split">
        <div>
          <p class="section-meta-tag">
            <span class="meta-sym">&sect;03</span>
            <span class="meta-text">FIELD NOTES</span>
          </p>
          <h2 id="ideas-heading" class="section-title">Ideas made inspectable.</h2>
        </div>
        <p class="section-header-desc">
          Writing about systems, retrieval, and the technical choices beneath dependable software.
        </p>
      </div>

      <div class="field-notes-layout">
        <div class="essays-column">
          {posts.map((post) => (
            <a href={`/blog/${post.id}/`} class="essay-item">
              <time class="essay-date" datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              <div class="essay-details">
                <h3 class="essay-title">{post.data.title}</h3>
                <p class="essay-desc">{post.data.description}</p>
              </div>
              <span class="essay-arrow" aria-hidden="true">&#8599;</span>
            </a>
          ))}
        </div>

        <div class="linkedin-card">
          <p class="card-eyebrow">ALSO WRITING IN PUBLIC</p>
          <h3 class="linkedin-card-title">Selected notes and technical perspectives on LinkedIn.</h3>
          <a
            href="https://www.linkedin.com/in/karansmittal/"
            target="_blank"
            rel="noopener"
            class="linkedin-link"
          >
            Follow the working thread &#8599;
          </a>
        </div>
      </div>

      <div class="section-footer-row">
        <a href="/blog" class="editorial-arrow-link">Browse all field notes &rarr;</a>
      </div>
    </section>

    <!-- SECTION 04: PROOF, IN PUBLIC -->
    <section class="home-section" id="community" aria-labelledby="community-heading">
      <div class="section-header-split">
        <div>
          <p class="section-meta-tag">
            <span class="meta-sym">&sect;04</span>
            <span class="meta-text">PROOF, IN PUBLIC</span>
          </p>
          <h2 id="community-heading" class="section-title">Teaching from the work.</h2>
        </div>
        <p class="section-header-desc">
          Technical communities are where ideas are tested, clarified, and shared.
        </p>
      </div>

      <div class="cards-grid-3">
        <div class="stat-card">
          <span class="stat-metric">{talkCount < 10 ? `0${talkCount}` : talkCount}</span>
          <h3 class="stat-label">Talks &amp; workshops on record</h3>
          <a href="/talks" class="stat-action">View speaking &rarr;</a>
        </div>
        <div class="stat-card">
          <span class="stat-metric">0{communityCount}</span>
          <h3 class="stat-label">Technical communities supported</h3>
          <a href="/about#community" class="stat-action">Explore community work &rarr;</a>
        </div>
        <div class="stat-card">
          <span class="stat-metric">IN</span>
          <h3 class="stat-label">Building and learning in Central India</h3>
          <a
            href="https://gdg.community.dev/gdg-cloud-indore/"
            target="_blank"
            rel="noopener"
            class="stat-action"
          >
            See public events &#8599;
          </a>
        </div>
      </div>
    </section>

    <!-- SECTION 04: EXPLANATORY SYSTEMS STUDIO SHOWCASE -->
    <section class="studio-showcase-section" aria-labelledby="studio-heading">
      <div class="section-header-row">
        <div>
          <p class="section-meta-tag">
            <span class="meta-sym">&sect;05</span>
            <span class="meta-text">EXPLANATORY SYSTEMS STUDIO</span>
          </p>
          <h2 id="studio-heading" class="section-title">Visual Computing &amp; Mechanistic Engines.</h2>
        </div>
        <a href="/studio" class="section-all-link">Studio Hub &rarr;</a>
      </div>

      <div class="studio-cards-grid">
        <a href="/studio/visuals" class="studio-card">
          <div class="studio-card-badge">INTERACTIVE LAB</div>
          <h3 class="studio-card-title">Visual Computing Lab</h3>
          <p class="studio-card-desc">Interactive 3Blue1Brown (Mafs) vector geometry, Observable Plot convex loss manifolds, WebGL matrix engines, and Univer spreadsheets.</p>
          <span class="studio-card-link">Launch Visual Lab &rarr;</span>
        </a>

        <a href="/studio/components" class="studio-card">
          <div class="studio-card-badge">DESIGN SYSTEM</div>
          <h3 class="studio-card-title">Component Gallery</h3>
          <p class="studio-card-desc">Publication-grade editorial exhibits, algorithm flows, isocontours, and primary citation cards built for technical essays.</p>
          <span class="studio-card-link">Explore Primitives &rarr;</span>
        </a>
      </div>
    </section>

    <!-- CLOSING SECTION: WORK TOGETHER -->
    <section class="contact-section" id="contact" aria-labelledby="contact-heading">
      <div class="contact-card">
        <p class="card-eyebrow">WORK TOGETHER</p>
        <h2 id="contact-heading" class="contact-title">Have a system that needs to be right?</h2>
        <p class="contact-desc">
          For consulting engagements involving AI reliability, knowledge systems, performance, or technical strategy.
        </p>
        <div class="contact-action-row">
          <a href={`mailto:${SITE.email}?subject=Architecture%20Consulting%20Inquiry%20-%20Karan%20Mittal`} class="btn-primary">
            Start a conversation
          </a>
          <a
            href="https://www.linkedin.com/in/karansmittal/"
            target="_blank"
            rel="noopener"
            class="contact-secondary-link"
          >
            Connect on LinkedIn &#8599;
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* ================================================================
     Calm Editorial Studio Styles — Karan Mittal
     ================================================================ */

  .home-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 var(--space-5) var(--space-9);
  }

  /* ---- Meta Label (§01, §02) ---- */
  .section-meta-tag {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
  }
  .meta-sym {
    color: var(--accent);
    font-weight: 600;
  }
  .meta-text {
    color: var(--muted);
    text-transform: uppercase;
  }

  /* ---- HERO SECTION ---- */
  .hero-section {
    padding-top: var(--space-8);
    padding-bottom: var(--space-6);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-7);
    align-items: start;
    margin-bottom: var(--space-8);
  }
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 4.5vw, 3.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: var(--text);
    margin-bottom: var(--space-5);
  }
  .hero-lead {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 540px;
    margin-bottom: var(--space-6);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  /* Buttons */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    background: var(--ink-900);
    color: #ffffff !important;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }
  .btn-primary:hover {
    background: #000;
    transform: translateY(-1px);
    text-decoration: none;
  }
  html.dark .btn-primary {
    background: var(--accent);
    color: #fff !important;
  }
  html.dark .btn-primary:hover {
    background: var(--blue-600);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    background: var(--surface-card);
    color: var(--text) !important;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: border-color var(--transition-fast), background-color var(--transition-fast), transform var(--transition-fast);
  }
  .btn-secondary:hover {
    border-color: var(--text);
    background: var(--surface-subtle);
    transform: translateY(-1px);
    text-decoration: none;
  }

  /* Portrait Card */
  .hero-portrait-card {
    display: flex;
    flex-direction: column;
    max-width: 320px;
    margin-left: auto;
  }
  .portrait-frame {
    width: 100%;
    height: 380px;
    border-radius: 140px 140px 16px 16px;
    overflow: hidden;
    background: var(--surface-subtle);
    border: 1px solid var(--border-default);
    box-shadow: var(--shadow-card);
  }
  .portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(100%) contrast(1.05);
    transition: filter var(--transition-slow);
  }
  .portrait-frame:hover .portrait-img {
    filter: grayscale(30%) contrast(1.02);
  }
  .principle-box {
    margin-top: var(--space-3);
    padding: var(--space-4);
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .principle-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }
  .principle-quote {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--text);
    font-style: italic;
    margin: 0;
  }

  /* Proof Strip */
  .proof-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--border-default);
    border-bottom: 1px solid var(--border-default);
    margin-top: var(--space-6);
  }
  .proof-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-4);
  }
  .proof-item + .proof-item {
    border-left: 1px solid var(--border-default);
  }
  .proof-num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent);
  }
  .proof-text {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text);
  }

  /* ---- SHARED SECTION STYLES ---- */
  .home-section {
    padding-top: var(--space-9);
  }
  .section-header-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    align-items: end;
    margin-bottom: var(--space-6);
  }
  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(1.875rem, 3.2vw, 2.625rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.18;
    color: var(--text);
    margin: 0;
  }
  .section-header-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
    max-width: 440px;
    justify-self: end;
  }

  /* ---- 3-CARD GRIDS (§02 & §04) ---- */
  .cards-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .system-card {
    padding: var(--space-6);
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }
  .system-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--accent);
  }
  .card-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: var(--space-3);
    text-transform: uppercase;
  }
  .card-title {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--text);
    margin-bottom: var(--space-3);
  }
  .card-summary {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  .section-footer-row {
    margin-top: var(--space-5);
  }
  .editorial-arrow-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }
  .editorial-arrow-link:hover {
    color: var(--accent-hover);
    transform: translateX(2px);
    text-decoration: none;
  }

  /* ---- SECTION 03: FIELD NOTES ---- */
  .field-notes-layout {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: var(--space-4);
  }
  .essays-column {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-default);
  }
  .essay-item {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border-default);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }
  .essay-item:hover {
    text-decoration: none;
  }
  .essay-item:hover .essay-title {
    color: var(--accent);
  }
  .essay-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
  }
  .essay-details {
    display: grid;
    gap: var(--space-1);
  }
  .essay-title {
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--text);
    transition: color var(--transition-fast);
  }
  .essay-desc {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
  }
  .essay-arrow {
    color: var(--muted);
    font-size: 1.125rem;
    transition: transform var(--transition-fast), color var(--transition-fast);
  }
  .essay-item:hover .essay-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .linkedin-card {
    padding: var(--space-6);
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .linkedin-card-title {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--text);
    margin-bottom: var(--space-4);
  }
  .linkedin-link {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }
  .linkedin-link:hover {
    color: var(--accent-hover);
    transform: translateX(2px);
    text-decoration: none;
  }

  /* ---- SECTION 04: STAT CARDS ---- */
  .stat-card {
    padding: var(--space-6);
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }
  .stat-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }
  .stat-metric {
    font-family: var(--font-mono);
    font-size: 2.25rem;
    font-weight: 600;
    color: var(--accent);
    line-height: 1;
    margin-bottom: var(--space-3);
  }
  .stat-label {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    line-height: 1.4;
    margin-bottom: var(--space-4);
    flex-grow: 1;
  }
  .stat-action {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }
  .stat-card:hover .stat-action {
    color: var(--accent);
    transform: translateX(2px);
  }

  /* ---- CLOSING SECTION: CONTACT ---- */
  .contact-section {
    padding-top: var(--space-9);
  }
  .contact-card {
    padding: var(--space-8) var(--space-7);
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }
  .contact-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.18;
    color: var(--text);
    margin-bottom: var(--space-3);
  }
  .contact-desc {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 560px;
    margin-bottom: var(--space-6);
  }
  .contact-action-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
  .contact-secondary-link {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .contact-secondary-link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  /* ---- SECTION 04: STUDIO SHOWCASE ---- */
  .studio-showcase-section {
    margin-top: var(--space-8);
    padding-top: var(--space-7);
    border-top: 1px solid var(--border-default);
  }

  .studio-cards-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  .studio-card {
    display: flex;
    flex-direction: column;
