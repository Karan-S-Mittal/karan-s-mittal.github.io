---
import ExcalidrawContainer from './ExcalidrawContainer.astro';

interface Props {
  caption?: string;
  exhibit?: string;
  title?: string;
}

const { caption, exhibit, title } = Astro.props;
---

<ExcalidrawContainer caption={caption} exhibit={exhibit} title={title} badge="CACHE FOOTPRINT">
  <svg class="ex-svg-canvas sys-diagram" viewBox="0 0 800 392" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="A comparison of MHA, MQA, and GQA showing how many key-value heads are cached for eight query heads.">
    <text x="32" y="32" class="label">8 QUERY HEADS</text>
    <text x="768" y="32" class="label" text-anchor="end">FEWER KV HEADS, SMALLER CACHE</text>
    <line x1="32" y1="48" x2="768" y2="48" class="rule" />

    <text x="32" y="88" class="title">Query heads stay constant</text>
    <g transform="translate(288 68)">
      <rect x="0" y="0" width="32" height="32" rx="4" class="node-muted" /><rect x="40" y="0" width="32" height="32" rx="4" class="node-muted" /><rect x="80" y="0" width="32" height="32" rx="4" class="node-muted" /><rect x="120" y="0" width="32" height="32" rx="4" class="node-muted" />
      <rect x="160" y="0" width="32" height="32" rx="4" class="node-muted" /><rect x="200" y="0" width="32" height="32" rx="4" class="node-muted" /><rect x="240" y="0" width="32" height="32" rx="4" class="node-muted" /><rect x="280" y="0" width="32" height="32" rx="4" class="node-muted" />
    </g>

    <line x1="32" y1="132" x2="768" y2="132" class="rule" />
    <text x="32" y="168" class="title">MHA</text><text x="32" y="188" class="label">1 : 1 MAPPING</text>
    <text x="176" y="176" class="body-muted">8 KV heads cached</text>
    <g transform="translate(448 148)">
      <rect x="0" y="0" width="32" height="40" rx="4" class="node-muted" /><rect x="40" y="0" width="32" height="40" rx="4" class="node-muted" /><rect x="80" y="0" width="32" height="40" rx="4" class="node-muted" /><rect x="120" y="0" width="32" height="40" rx="4" class="node-muted" />
      <rect x="160" y="0" width="32" height="40" rx="4" class="node-muted" /><rect x="200" y="0" width="32" height="40" rx="4" class="node-muted" /><rect x="240" y="0" width="32" height="40" rx="4" class="node-muted" /><rect x="280" y="0" width="32" height="40" rx="4" class="node-muted" />
    </g>
    <text x="768" y="176" class="label" text-anchor="end">100%</text>

    <line x1="32" y1="220" x2="768" y2="220" class="rule" />
    <text x="32" y="256" class="title">MQA</text><text x="32" y="276" class="label">8 : 1 MAPPING</text>
    <text x="176" y="264" class="body-muted">1 shared KV head</text>
    <g transform="translate(448 236)"><rect x="0" y="0" width="32" height="40" rx="4" class="node-muted" /></g>
    <text x="768" y="264" class="label" text-anchor="end">12.5%</text>

    <line x1="32" y1="308" x2="768" y2="308" class="rule" />
    <text x="32" y="344" class="title">GQA</text><text x="32" y="364" class="label-signal">4 : 1 MAPPING</text>
    <text x="176" y="352" class="body-muted">2 KV heads shared across groups</text>
    <g transform="translate(448 324)"><rect x="0" y="0" width="32" height="40" rx="4" class="node-signal" /><rect x="40" y="0" width="32" height="40" rx="4" class="node-signal" /></g>
    <text x="768" y="352" class="label-signal" text-anchor="end">25%</text>
  </svg>
</ExcalidrawContainer>
