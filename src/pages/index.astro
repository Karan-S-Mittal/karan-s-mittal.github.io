---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Karan Mittal | Solutions Architect">
  <main class="container">

    <section class="hero">
      <h1 class="hero-title">
        Building deterministic,<br />high-performance AI systems.
      </h1>
      <p class="hero-lead">
        I architect enterprise-scale systems where reliability is the foundation.
        Co-founder of <a href="https://dextar.co">Dextar</a>, organiser of
        <a href="/about#community">MLIndore</a> and <a href="/about#community">GDG Cloud Indore</a>,
        and a technical leader who has shipped across life sciences, semiconductor supply chains, and finance.
      </p>
      <div class="hero-links">
        <a href="https://www.linkedin.com/in/karansmittal/" class="btn btn-primary">LinkedIn</a>
        <a href="https://twitter.com/KaranSMittal" class="btn btn-secondary">X / Twitter</a>
        <a href="mailto:karanshyammittal@gmail.com" class="btn btn-ghost">Email</a>
      </div>
    </section>

    <hr />

    <section class="selected-work">
      <p class="label">Selected Work</p>
      <div class="work-grid">
        <a href="https://github.com/Karan-S-Mittal" class="work-card">
          <h3>GitHub</h3>
          <p>Architectural projects and open-source work on deterministic RAG, CUDA patterns, and MLOps tooling.</p>
        </a>
        <a href="/blog" class="work-card">
          <h3>Writing</h3>
          <p>Essays on GraphRAG, deterministic retrieval, and lessons from production AI systems.</p>
        </a>
        <a href="/talks" class="work-card">
          <h3>Talks</h3>
          <p>Workshops and sessions on AI architecture, MLOps, and building production-scale systems.</p>
        </a>
      </div>
    </section>

  </main>
</Layout>

<style>
  .hero {
    padding: var(--space-7) 0 var(--space-5);
    text-align: center;
  }
  .hero-title {
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: var(--space-4);
    color: var(--accent);
  }
  .hero-lead {
    font-size: var(--text-lg);
    color: var(--muted);
    max-width: 540px;
    margin: 0 auto var(--space-5);
    line-height: 1.7;
  }
  .hero-links {
    display: flex;
    gap: var(--space-2);
    justify-content: center;
    flex-wrap: wrap;
  }

  .selected-work {
    padding: var(--space-2) 0 var(--space-5);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .work-card {
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
  }
  .work-card:hover {
    text-decoration: none;
  }
  .work-card h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text);
  }
  .work-card p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.55;
  }

  @media (max-width: 720px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
    .hero {
      padding: var(--space-5) 0 var(--space-4);
      text-align: left;
    }
    .hero-links {
      justify-content: flex-start;
    }
  }
</style>
