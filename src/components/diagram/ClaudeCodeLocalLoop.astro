---
/**
 * ClaudeCodeLocalLoop.astro
 * Minimalist architecture diagram of Claude Code's local execution loop.
 *
 * Strictly focused on the structural blocks and data flows:
 * - 3-stage control loop: [User / Terminal] <-> [Context Engine] <-> [Agent Loop]
 * - Downward T-junction blueprint bus connecting to 3 substrates:
 *   [Local Tools], [Model Context Protocol], [Subagents]
 * - Zero decorative meta text, banners, or method labels.
 * - Standard attributed signature <VisualAttribution /> in bottom right.
 * - 100% token compliant (zero raw hex).
 */
import {
  Terminal,
  SquareTerminal,
  Search,
  SquarePen,
  RefreshCw,
  Network,
  Cpu,
  ShieldCheck,
  GitFork,
  GitBranch,
  Boxes,
  Split,
  FolderGit2,
  Database,
  Wrench,
  FileCode,
  Workflow,
  CircleCheck,
} from '@lucide/astro';
import BrandIcon from './icons/BrandIcon.astro';
import VisualAttribution from './VisualAttribution.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['claude-loop-root', className]}>
  <div class="claude-loop-canvas" id="claude-code-local-loop">
    <!-- Top Flow: 3-Stage Control Loop -->
    <div class="control-row">
      <!-- 1. User / Terminal (Entry) -->
      <div class="node-card">
        <div class="node-header">
          <div class="node-icon">
            <Terminal size={16} stroke-width={1.5} />
          </div>
          <div class="node-titles">
            <h3 class="node-name">User / Terminal</h3>
            <span class="node-role">Developer Shell</span>
          </div>
        </div>

        <ul class="node-items">
          <li>
            <Terminal size={13} stroke-width={1.5} class="item-ico" />
            <span class="item-label"><code>stdin / stdout</code> stream</span>
          </li>
          <li class="constraint-item">
            <ShieldCheck size={13} stroke-width={1.5} class="item-ico ico-rust" />
            <span class="item-label">
              Permission gates <span class="tag-rust">APPROVAL</span>
            </span>
            <span class="constraint-callout">&larr; human gate</span>
          </li>
          <li>
            <FileCode size={13} stroke-width={1.5} class="item-ico" />
            <span class="item-label">Inline diff patch review</span>
          </li>
        </ul>
      </div>

      <!-- Bridge 1: Terminal <-> Context Engine -->
      <div class="bridge" aria-hidden="true">
        <div class="bridge-arrow-wrap">
          <svg class="bridge-svg" viewBox="0 0 76 16" preserveAspectRatio="none">
            <defs>
              <marker id="arr-bi-left" viewBox="0 0 6 6" refX="1" refY="3" markerWidth="4" markerHeight="4" orient="auto">
                <path d="M5,1 L1,3 L5,5" fill="none" stroke="var(--ie-blue)" stroke-width="1.2" stroke-linecap="round" />
              </marker>
              <marker id="arr-bi-right" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="4" markerHeight="4" orient="auto">
                <path d="M1,1 L5,3 L1,5" fill="none" stroke="var(--ie-blue)" stroke-width="1.2" stroke-linecap="round" />
              </marker>
            </defs>
            <line x1="6" y1="8" x2="70" y2="8" stroke="var(--ie-blue)" stroke-width="1.5" marker-start="url(#arr-bi-left)" marker-end="url(#arr-bi-right)" />
          </svg>
        </div>
        <span class="bridge-pill">Prompt · Stream</span>
      </div>

      <!-- 2. Context Engine (Intelligence) -->
      <div class="node-card">
        <div class="node-header">
          <div class="node-icon icon-claude">
            <BrandIcon name="claude" size={16} />
          </div>
          <div class="node-titles">
            <h3 class="node-name">Context Engine</h3>
            <span class="node-role">Repository State</span>
          </div>
        </div>

        <ul class="node-items">
          <li>
            <FolderGit2 size={13} stroke-width={1.5} class="item-ico" />
            <span class="item-label"><code>AST repo map</code> hierarchy</span>
          </li>
          <li>
            <Cpu size={13} stroke-width={1.5} class="item-ico" />
            <span class="item-label">Dynamic context compaction</span>
          </li>
          <li>
            <Database size={13} stroke-width={1.5} class="item-ico" />
            <span class="item-label">Turn &amp; prompt history</span>
          </li>
        </ul>
      </div>

      <!-- Bridge 2: Context Engine <-> Agent Loop -->
      <div class="bridge" aria-hidden="true">
        <div class="bridge-arrow-wrap">
          <svg class="bridge-svg" viewBox="0 0 76 16" preserveAspectRatio="none">
            <line x1="6" y1="8" x2="70" y2="8" stroke="var(--ie-blue)" stroke-width="1.5" marker-start="url(#arr-bi-left)" marker-end="url(#arr-bi-right)" />
          </svg>
        </div>
        <span class="bridge-pill">Actuation</span>
      </div>

      <!-- 3. Agent Loop (ReAct Cycle) -->
      <div class="node-card">
        <div class="node-header">
          <div class="node-icon icon-loop">
            <RefreshCw size={16} stroke-width={1.5} />
          </div>
          <div class="node-titles">
            <h3 class="node-name">Agent Loop</h3>
            <span class="node-role">Autonomous REPL</span>
          </div>
        </div>

        <!-- ReAct Cycle Visual Bar -->
        <div class="react-cycle-bar">
          <span class="cycle-step"><span class="step-pin"></span>Plan</span>
          <span class="cycle-sep">→</span>
          <span class="cycle-step"><span class="step-pin"></span>Tool</span>
          <span class="cycle-sep">→</span>
          <span class="cycle-step"><span class="step-pin"></span>Eval</span>
          <span class="cycle-reload" title="Continuous loop"><RefreshCw size={11} stroke-width={1.8} /></span>
        </div>

        <ul class="node-items">
          <li>
            <Workflow size={13} stroke-width={1.5} class="item-ico" />
            <span class="item-label">Task decomposition</span>
          </li>
          <li>
            <Cpu size={13} stroke-width={1.5} class="item-ico" />
            <span class="item-label">Substrate tool dispatch</span>
          </li>
          <li>
            <CircleCheck size={13} stroke-width={1.5} class="item-ico" />
            <span class="item-label">Compiler exit verification</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Central Downward Dispatch Bus -->
    <div class="bus-container" aria-hidden="true">
      <svg class="bus-svg" viewBox="0 0 720 28" preserveAspectRatio="none">
        <defs>
          <marker id="bus-drop-arrow" viewBox="0 0 6 6" refX="3" refY="5" markerWidth="4" markerHeight="4" orient="auto">
            <path d="M1,1 L3,5 L5,1" fill="none" stroke="var(--ie-blue)" stroke-width="1.3" stroke-linecap="round" />
          </marker>
        </defs>
        <!-- Center trunk from Context Engine (x=360) -->
        <path d="M 360 0 L 360 12" fill="none" stroke="var(--ie-blue)" stroke-width="1.5" />
        <!-- Junction Pin -->
        <circle cx="360" cy="12" r="3" fill="var(--ie-blue)" />
        <!-- Horizontal crossbar from column 1 center (112) to column 3 center (608) -->
        <path d="M 112 12 L 608 12" fill="none" stroke="var(--ie-blue)" stroke-width="1.5" />
        <!-- 3 Downward Drops centered over each substrate column below -->
        <path d="M 112 12 L 112 24" fill="none" stroke="var(--ie-blue)" stroke-width="1.5" marker-end="url(#bus-drop-arrow)" />
        <path d="M 360 12 L 360 24" fill="none" stroke="var(--ie-blue)" stroke-width="1.5" marker-end="url(#bus-drop-arrow)" />
        <path d="M 608 12 L 608 24" fill="none" stroke="var(--ie-blue)" stroke-width="1.5" marker-end="url(#bus-drop-arrow)" />
      </svg>
    </div>

    <!-- Bottom Layer: Substrate Execution Panel -->
    <div class="substrate-panel">
      <div class="substrate-grid">
        <!-- Substrate 1: Local Tools -->
        <div class="substrate-col">
          <div class="col-header">
            <div class="col-title-group">
              <div class="col-icon">
                <Wrench size={14} stroke-width={1.5} />
              </div>
              <h4 class="col-title">Local Tools</h4>
            </div>
            <span class="col-tag">Host Native</span>
          </div>

          <ul class="col-list">
            <li>
              <Search size={13} stroke-width={1.5} class="sub-ico" />
              <div class="col-item-text">
                <code>ripgrep</code>
                <span class="item-desc">Fast regex codebase search</span>
              </div>
            </li>
            <li>
              <SquarePen size={13} stroke-width={1.5} class="sub-ico" />
              <div class="col-item-text">
                <code>edit</code>
                <span class="item-desc">Exact line file replacement</span>
              </div>
            </li>
            <li>
              <SquareTerminal size={13} stroke-width={1.5} class="sub-ico" />
              <div class="col-item-text">
                <code>bash</code>
                <span class="item-desc">Shell command runner</span>
              </div>
            </li>
          </ul>
        </div>

        <!-- Substrate 2: Model Context Protocol -->
        <div class="substrate-col">
          <div class="col-header">
            <div class="col-title-group">
              <div class="col-icon icon-mcp">
                <BrandIcon name="mcp" size={14} />
              </div>
              <h4 class="col-title">Model Context Protocol</h4>
            </div>
            <span class="col-tag">Open Standard</span>
          </div>

          <ul class="col-list">
            <li>
              <Network size={13} stroke-width={1.5} class="sub-ico" />
              <div class="col-item-text">
                <code>mcp-client</code>
                <span class="item-desc">JSON-RPC socket transport</span>
              </div>
            </li>
            <li>
              <Cpu size={13} stroke-width={1.5} class="sub-ico" />
              <div class="col-item-text">
                <code>discovery</code>
                <span class="item-desc">Dynamic capability query</span>
              </div>
            </li>
            <li>
              <ShieldCheck size={13} stroke-width={1.5} class="sub-ico" />
              <div class="col-item-text">
                <code>schemas</code>
                <span class="item-desc">Type-safe tool interfaces</span>
              </div>
            </li>
          </ul>
        </div>

        <!-- Substrate 3: Subagents -->
        <div class="substrate-col">
          <div class="col-header">
            <div class="col-title-group">
              <div class="col-icon">
                <GitFork size={14} stroke-width={1.5} />
              </div>
              <h4 class="col-title">Subagents</h4>
            </div>
            <span class="col-tag">Concurrent</span>
          </div>

          <ul class="col-list">
            <li>
              <Split size={13} stroke-width={1.5} class="sub-ico" />
              <div class="col-item-text">
                <code>fork</code>
                <span class="item-desc">Child task delegation</span>
              </div>
            </li>
            <li>
              <GitBranch size={13} stroke-width={1.5} class="sub-ico" />
              <div class="col-item-text">
                <code>worktree</code>
                <span class="item-desc">Isolated branch filesystems</span>
              </div>
            </li>
            <li>
              <Boxes size={13} stroke-width={1.5} class="sub-ico" />
              <div class="col-item-text">
                <code>tmux</code>
                <span class="item-desc">Headless session manager</span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Footer Attribution -->
    <footer class="loop-footer">
      <VisualAttribution />
    </footer>
  </div>
</div>

<style>
  /* Root & Canvas */
  .claude-loop-root {
    width: 100%;
    margin: 1.5rem 0;
  }

  .claude-loop-canvas {
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 8px);
    padding: 2rem 2.25rem 1.5rem 2.25rem;
    font-family: var(--font-diagram, 'Inter', -apple-system, sans-serif);
    color: var(--ie-ink);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Top Control Row */
  .control-row {
    display: grid;
    grid-template-columns: 1fr 80px 1fr 80px 1fr;
    align-items: stretch;
    gap: 0;
  }

  /* Node Cards */
  .node-card {
    background: var(--ie-canvas);
    border: 1px solid var(--ie-rule);
    border-radius: 8px;
    padding: 1.15rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    box-sizing: border-box;
  }

  .node-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .node-icon {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ie-blue);
    flex-shrink: 0;
  }

  .node-icon.icon-claude {
    color: var(--brand-anthropic);
  }

  .node-icon.icon-loop {
    color: var(--ie-blue);
  }

  .node-titles {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .node-name {
    margin: 0;
    font-family: var(--font-diagram, 'Inter', sans-serif);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ie-ink);
    letter-spacing: -0.01em;
  }

  .node-role {
    font-size: 0.6875rem;
    color: var(--ie-muted);
    font-family: var(--font-diagram, 'Inter', sans-serif);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Node Items */
  .node-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .node-items li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--ie-ink-secondary);
    line-height: 1.3;
  }

  .item-ico {
    color: var(--ie-muted);
    flex-shrink: 0;
  }

  .item-ico.ico-rust {
    color: var(--ie-rust);
  }

  .item-label {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    flex: 1;
    min-width: 0;
  }

  .node-items code {
    font-family: var(--font-mono, monospace);
    font-size: 0.71875rem;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    padding: 0.05rem 0.28rem;
    border-radius: 4px;
    color: var(--ie-ink);
    white-space: nowrap;
  }

  .tag-rust {
    font-family: var(--font-mono, monospace);
    font-size: 0.5625rem;
    font-weight: 600;
    color: var(--ie-rust);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rust);
    padding: 0.05rem 0.28rem;
    border-radius: 3px;
    letter-spacing: 0.04em;
  }

  .constraint-callout {
    font-family: var(--font-diagram);
    font-size: 0.65rem;
    color: var(--ie-rust);
    white-space: nowrap;
    margin-left: auto;
  }

  /* ReAct Cycle Bar */
  .react-cycle-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: 6px;
    padding: 0.3rem 0.55rem;
    font-size: 0.6875rem;
    font-weight: 600;
    box-sizing: border-box;
  }

  .cycle-step {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--ie-ink);
  }

  .step-pin {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--ie-blue);
  }

  .cycle-sep {
    color: var(--ie-blue);
    font-weight: 700;
  }

  .cycle-reload {
    display: flex;
    align-items: center;
    color: var(--ie-muted);
  }

  /* Connectors / Bridges */
  .bridge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0 2px;
  }

  .bridge-arrow-wrap {
    width: 100%;
    height: 16px;
    display: flex;
    align-items: center;
  }

  .bridge-svg {
    width: 100%;
    height: 16px;
  }

  .bridge-pill {
    font-family: var(--font-mono, monospace);
    font-size: 0.53125rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--ie-muted);
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    padding: 0.12rem 0.4rem;
    border-radius: 3px;
    z-index: 2;
  }

  /* Subsystem Bus */
  .bus-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin: 0;
  }

  .bus-svg {
    width: 100%;
    height: 28px;
  }

  /* Substrate Panel */
  .substrate-panel {
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: 8px;
    padding: 1.15rem 1.25rem 1.25rem 1.25rem;
    box-sizing: border-box;
  }

  .substrate-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .substrate-col {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .col-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .col-title-group {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .col-icon {
    color: var(--ie-ink-secondary);
    display: flex;
    align-items: center;
  }

  .col-icon.icon-mcp {
    color: var(--ie-blue);
  }

  .col-title {
    margin: 0;
    font-family: var(--font-diagram, 'Inter', sans-serif);
    font-size: 0.84375rem;
    font-weight: 600;
    color: var(--ie-ink);
  }

  .col-tag {
    font-family: var(--font-mono, monospace);
    font-size: 0.5625rem;
    color: var(--ie-muted);
    background: var(--ie-canvas);
    border: 1px solid var(--ie-rule);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    text-transform: uppercase;
  }

  .col-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .col-list li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.75rem;
  }

  .sub-ico {
    color: var(--ie-muted);
    flex-shrink: 0;
  }

  .col-item-text {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    min-width: 0;
    overflow: hidden;
  }

  .col-item-text code {
    font-family: var(--font-mono, monospace);
    font-size: 0.71875rem;
    color: var(--ie-ink);
    background: var(--ie-canvas);
    border: 1px solid var(--ie-rule);
    padding: 0.05rem 0.28rem;
    border-radius: 3px;
    font-weight: 500;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .item-desc {
    font-size: 0.71875rem;
    color: var(--ie-ink-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Footer */
  .loop-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-top: 1rem;
  }

  /* Responsive */
  @media (max-width: 800px) {
    .claude-loop-canvas {
      padding: 1.25rem;
    }

    .control-row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .bridge {
      display: none;
    }

    .bus-container {
      display: none;
    }

    .substrate-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
