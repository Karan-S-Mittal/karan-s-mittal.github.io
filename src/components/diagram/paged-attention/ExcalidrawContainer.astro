---
/**
 * ExcalidrawContainer.astro
 * Technical diagram canvas with a shared semantic palette inside the site's Exhibit frame.
 */
import Exhibit from '../../editorial/Exhibit.astro';

interface Props {
  caption?: string;
  badge?: string;
  exhibit?: string;
  title?: string;
}

const { caption, badge, exhibit, title } = Astro.props;
---

<Exhibit exhibit={exhibit} title={title} caption={caption} wide>
  <div class="ex-canvas-frame">
    {badge && <p class="ex-badge">{badge}</p>}
    <slot />
    <p class="ex-canvas-hint">On small screens, the figure scales to the reading column.</p>
  </div>
</Exhibit>

<style is:global>
  /* Diagram palette lives in src/styles/global.css — this file holds structure only */
  .ex-canvas-frame {
    position: relative;
    background: var(--ex-bg);
    padding: var(--exhibit-pad-block) var(--exhibit-pad-inline) 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-color: var(--ex-border) transparent;
  }

  .ex-badge {
    position: static;
    margin: 0 0 1rem;
    font-family: 'JetBrains Mono', var(--font-mono, monospace);
    font-size: 0.65rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0;
    color: var(--ex-text-muted);
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .ex-canvas-hint {
    display: none;
  }

  .ex-svg-canvas {
    display: block;
    width: 100%;
    min-width: 760px;
    height: auto;
    max-width: none;
  }

  .sys-diagram .node {
    fill: var(--ex-card-bg);
    stroke: var(--ex-text-main);
    stroke-width: 1.8;
  }

  .sys-diagram .node-muted {
    fill: var(--ex-gray-bg);
    stroke: var(--ex-border);
    stroke-width: 1.6;
  }

  .sys-diagram .node-signal {
    fill: var(--ex-blue-bg);
    stroke: var(--ex-blue-stroke);
    stroke-width: 1.8;
  }

  .sys-diagram .rule { stroke: var(--ex-border); stroke-width: 1.2; }
  .sys-diagram .flow { fill: none; stroke: var(--ex-text-main); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .sys-diagram .flow-signal { fill: none; stroke: var(--ex-blue-stroke); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .sys-diagram .flow-dashed { fill: none; stroke: var(--diagram-edge-secondary); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 4 4; }
  .sys-diagram .label { fill: var(--ex-text-muted); font-family: 'JetBrains Mono', var(--font-mono); font-size: 13px; letter-spacing: 0.06em; }
  .sys-diagram .label-signal { fill: var(--ex-blue-text); font-family: 'JetBrains Mono', var(--font-mono); font-size: 13px; font-weight: 600; letter-spacing: 0.06em; }
  .sys-diagram .title { fill: var(--ex-text-main); font-family: 'Inter', var(--font-sans); font-size: 18px; font-weight: 600; }
  .sys-diagram .body { fill: var(--ex-text-main); font-family: 'Inter', var(--font-sans); font-size: 14px; }
  .sys-diagram .body-muted { fill: var(--ex-text-muted); font-family: 'Inter', var(--font-sans); font-size: 14px; }

  @media (max-width: 759px) {
    .ex-svg-canvas {
      min-width: 0;
    }

    .ex-canvas-hint {
      display: block;
      margin: 0.75rem 0 0;
      color: var(--ex-text-muted);
      font-family: 'JetBrains Mono', var(--font-mono, monospace);
      font-size: 0.68rem;
      line-height: 1.45;
    }
  }
</style>
