---
interface Props {
  label: string;
  title: string;
  description?: string;
  count?: number;
  countLabel?: string;
}

const { label, title, description, count, countLabel = 'on record' } = Astro.props;
---

<header class="page-header">
  <p class="label">{label}</p>
  <h1>{title}</h1>
  {description && (
    <p class="lead">
      {description}
      {count !== undefined && (
        <span class="count-badge">{count} {countLabel}</span>
      )}
    </p>
  )}
</header>

<style>
  .page-header {
    margin-bottom: 3.5rem;
  }
  .page-header h1 {
    margin-bottom: 0.75rem;
  }
  .lead {
    color: var(--muted);
    max-width: 560px;
    margin: 0;
    line-height: 1.7;
    font-size: 1.05rem;
  }
  .count-badge {
    display: inline-block;
    margin-left: 0.5rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--muted);
    background: var(--bg-elevated);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }
</style>
