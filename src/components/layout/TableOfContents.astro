---
/**
 * TableOfContents.astro
 * Minimal, non-expanding, bold + blue scrollspy Table of Contents.
 *
 * Replaces distracting accordion expansion and highlight boxes with:
 * - Direct bold + blue active state (no background fill, no border bar)
 * - Strict character truncation with tooltip support
 * - Stable, static hierarchy (no height shifting as you scroll)
 */
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Chapter {
  slug: string;
  text: string;
  depth: number;
  subchapters: Heading[];
}

interface Props {
  headings: Heading[];
  idPrefix?: string;
  maxChars?: number;
}

const { headings, idPrefix = 'toc', maxChars = 34 } = Astro.props;

function truncate(str: string, limit: number): string {
  if (!str) return '';
  const clean = str.replace(/\s+/g, ' ').trim();
  if (clean.length <= limit) return clean;
  return clean.slice(0, limit).trim() + '…';
}

function buildHierarchy(items: Heading[]): Chapter[] {
  const chapters: Chapter[] = [];
  let currentChapter: Chapter | null = null;

  for (const h of items) {
    if (h.depth === 2) {
      currentChapter = {
        slug: h.slug,
        text: h.text,
        depth: h.depth,
        subchapters: [],
      };
      chapters.push(currentChapter);
    } else if (h.depth === 3 && currentChapter) {
      currentChapter.subchapters.push(h);
    } else {
      chapters.push({
        slug: h.slug,
        text: h.text,
        depth: h.depth,
        subchapters: [],
      });
    }
  }
  return chapters;
}

const chapters = buildHierarchy(headings);
---

<nav class="toc-root" aria-label="Table of contents" data-toc-container id={idPrefix}>
  <div class="toc-header">
    <span class="toc-title">Contents</span>
    <span class="toc-progress-pct" data-toc-progress>0%</span>
  </div>

  <div class="toc-progress-track">
    <div class="toc-progress-bar" data-toc-progress-bar></div>
  </div>

  <ul class="toc-list" id={`${idPrefix}-list`}>
    {chapters.map((ch) => (
      <li class="toc-item">
        <a
          href={`#${ch.slug}`}
          class="toc-link toc-chapter-link"
          data-heading={ch.slug}
          title={ch.text}
        >
          {truncate(ch.text, maxChars)}
        </a>

        {ch.subchapters.length > 0 && (
          <ul class="toc-sub-list">
            {ch.subchapters.map((sub) => (
              <li class="toc-sub-item">
                <a
                  href={`#${sub.slug}`}
                  class="toc-link toc-subchapter-link"
                  data-heading={sub.slug}
                  title={sub.text}
                >
                  {truncate(sub.text, maxChars - 3)}
                </a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</nav>

<script>
  function initScrollspy() {
    const containers = document.querySelectorAll<HTMLElement>('[data-toc-container]');

    containers.forEach((container) => {
      if (container.dataset.initialized === 'true') return;
      container.dataset.initialized = 'true';

      const allLinks = container.querySelectorAll<HTMLAnchorElement>('.toc-link');
      const progressBar = container.querySelector<HTMLElement>('[data-toc-progress-bar]');
      const progressText = container.querySelector<HTMLElement>('[data-toc-progress]');

      const headingElements: HTMLElement[] = [];
      allLinks.forEach((link) => {
        const slug = link.dataset.heading;
        if (!slug) return;
        const el = document.getElementById(slug);
        if (el) headingElements.push(el);
      });

      if (headingElements.length === 0) return;

      function updateActiveState() {
        const scrollY = window.scrollY;
        const windowHeight = window.innerHeight;
        const docHeight = document.documentElement.scrollHeight - windowHeight;

        // Reading progress percentage
        const progress = Math.min(100, Math.max(0, Math.round((scrollY / (docHeight || 1)) * 100)));
        if (progressBar) progressBar.style.width = `${progress}%`;
        if (progressText) progressText.textContent = `${progress}%`;

        // Determine currently active heading
        let activeHeading: HTMLElement | null = headingElements[0];
        const offset = 140;

        if (scrollY + windowHeight >= document.documentElement.scrollHeight - 24) {
          activeHeading = headingElements[headingElements.length - 1];
        } else {
          for (let i = 0; i < headingElements.length; i++) {
            const el = headingElements[i];
            const top = el.getBoundingClientRect().top;
            if (top <= offset) {
              activeHeading = el;
            } else {
              break;
            }
          }
        }

        if (!activeHeading) return;
        const activeSlug = activeHeading.id;

        allLinks.forEach((link) => {
          const isCurrent = link.dataset.heading === activeSlug;
          link.classList.toggle('active', isCurrent);
        });
      }

      window.addEventListener('scroll', updateActiveState, { passive: true });
      window.addEventListener('resize', updateActiveState, { passive: true });
      updateActiveState();
    });
  }

  initScrollspy();
</script>

<style>
  .toc-root {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--ie-rule) transparent;
    padding: 1.25rem 1rem;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 8px);
  }

  .toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .toc-title {
    font-family: var(--font-sans);
    font-size: var(--ie-type-label);
    font-weight: 600;
    color: var(--ie-muted);
    text-transform: uppercase;
    letter-spacing: 0.055em;
  }

  .toc-progress-pct {
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    font-weight: 500;
    color: var(--ie-blue);
  }

  .toc-progress-track {
    width: 100%;
    height: 2px;
    background: var(--ie-rule);
    border-radius: var(--radius-pill, 999px);
    margin-bottom: 0.75rem;
    overflow: hidden;
  }

  .toc-progress-bar {
    width: 0%;
    height: 100%;
    background: var(--ie-blue);
    transition: width 100ms ease;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .toc-item {
    margin: 0;
  }

  .toc-sub-list {
    list-style: none;
    margin: 0.15rem 0 0.25rem 0.5rem;
    padding: 0 0 0 0.65rem;
    border-left: 1px solid var(--ie-rule);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .toc-sub-item {
    margin: 0;
  }

  .toc-link {
    display: block;
    text-decoration: none;
    color: var(--ie-muted);
    font-family: var(--font-sans);
    font-size: var(--ie-type-label);
    font-weight: 400;
    line-height: 1.45;
    padding: 0.22rem 0.35rem;
    border-radius: var(--radius-sm, 4px);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    background: transparent;
    transition: color 120ms ease;
  }

  .toc-subchapter-link {
    font-size: var(--ie-type-micro);
    line-height: 1.4;
    padding: 0.18rem 0.35rem;
  }

  .toc-link:hover {
    color: var(--ie-blue);
    background: transparent;
    text-decoration: none;
  }

  /* Active state: bold and anchor blue only, no background highlight or box */
  .toc-link.active {
    color: var(--ie-blue) !important;
    font-weight: 600 !important;
    background: transparent !important;
  }

  @media (max-width: 960px) {
    .toc-root {
      max-height: none;
    }
  }
</style>
