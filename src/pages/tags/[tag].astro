---
import { getCollection } from 'astro:content';
import { normalizeTag, tagSlug } from '@utils/tags.js';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const tagMap = new Map<string, typeof allPosts>();
  for (const post of allPosts) {
    for (const tag of post.data.tags) {
      const key = normalizeTag(tag);
      if (!tagMap.has(key)) tagMap.set(key, []);
      if (!tagMap.get(key)!.some((existing) => existing.id === post.id)) {
        tagMap.get(key)!.push(post);
      }
    }
  }

  return Array.from(tagMap.entries()).map(([tag]) => ({
    params: { tag: tagSlug(tag) },
  }));
}

const { tag } = Astro.params;
return Astro.redirect(`/topics/${tag}/`, 301);
---
