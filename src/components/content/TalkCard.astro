---
import type { Talk } from '../../types/talks';
import { formatTalkDate } from '../../utils/date';

interface Props {
  talk: Talk;
  searchText?: string;
}

const { talk, searchText } = Astro.props;
const formattedDate = formatTalkDate(talk.date);

const typeLabel: Record<Talk['type'], string> = {
  talk: 'Session',
  workshop: 'Workshop',
  panel: 'Panel',
  keynote: 'Keynote',
};

// The title carries the primary link, so the row needs no button. Anything
// left over trails the entry as plain text links.
const extraLinks = [
  ...talk.links.map((link) => ({ label: link.label, url: link.url })),
  ...(talk.slides ? [{ label: 'Slides', url: talk.slides }] : []),
  ...(talk.recording ? [{ label: 'Recording', url: talk.recording }] : []),
];
const primary = extraLinks.shift();

const footnote = [talk.event, talk.org, talk.venue, talk.audience && `Audience: ${talk.audience}`]
  .filter(Boolean)
  .join(' · ');
---

<article class="talk-row" data-search={searchText} data-year={talk.year} data-date={talk.date}>
  <p class="talk-meta">
    <time datetime={talk.date}>{formattedDate}</time>
    <span aria-hidden="true" class="meta-sep">·</span>
    <span class="talk-type">{typeLabel[talk.type]}</span>
  </p>

  <h3 class="talk-title">
    {primary
      ? <a href={primary.url} target="_blank" rel="noopener noreferrer">{talk.title}<span class="talk-mark" aria-hidden="true">↗</span></a>
      : talk.title}
  </h3>

  <p class="talk-description">{talk.description}</p>
  {talk.caption && <p class="talk-description">{talk.caption}</p>}

  <p class="talk-footnote">{footnote}</p>

  {extraLinks.length > 0 && (
    <p class="talk-links">
      {extraLinks.map((link) => (
        <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
      ))}
    </p>
  )}
</article>

<style>
  .talk-row {
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--ie-rule);
  }

  .talk-row:last-child {
    border-bottom: none;
  }

  .talk-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.55rem;
    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label);
  }

  .meta-sep {
    color: var(--ie-rule-strong);
  }

  .talk-type {
    font-family: var(--font-sans);
    font-weight: 600;
  }

  .talk-title {
    max-width: 40ch;
    margin: 0 0 0.5rem;
    color: var(--ie-ink);
    font-family: var(--font-display);
    font-size: var(--ie-type-h3);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.28;
  }

  .talk-title a {
    color: inherit;
    text-decoration: none;
  }

  .talk-title a:hover {
    color: var(--ie-blue);
  }

  .talk-mark {
    margin-left: 0.3em;
    color: var(--ie-muted);
    font-size: 0.75em;
  }

  .talk-description {
    max-width: 68ch;
    margin: 0 0 0.6rem;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-h4);
    line-height: 1.55;
  }

  .talk-footnote {
    max-width: 72ch;
    margin: 0;
    color: var(--ie-muted);
    font-family: var(--font-sans);
    font-size: var(--ie-type-ui);
    line-height: 1.55;
  }

  .talk-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0.7rem 0 0;
  }

  .talk-links a {
    color: var(--ie-blue);
    font-family: var(--font-sans);
    font-size: var(--ie-type-ui);
    text-decoration: none;
  }

  .talk-links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
