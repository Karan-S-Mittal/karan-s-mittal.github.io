---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/content/PageHeader.astro';
import { formatTalkDate } from '@utils/date';
import { nowAreas } from '@data/now';
import { execFileSync } from 'node:child_process';

// The page is only as current as its content, so the date comes from the
// last commit that touched src/data/now.ts. The deploy checks out full
// history for this. The constant covers a checkout without git.
function lastCommitDate(file: string, fallback: string): string {
  try {
    const date = execFileSync('git', ['log', '-1', '--format=%cs', '--', file], { encoding: 'utf8' }).trim();
    return date || fallback;
  } catch {
    return fallback;
  }
}

const lastUpdated = lastCommitDate('src/data/now.ts', '2026-09-23');
---

<Layout
  title="Now | Karan Mittal"
  description="A living snapshot of Karan Mittal's current systems engineering focus, research, and priorities."
>
  <main class="container now-page">
    <PageHeader
      label="Now"
      title="What I’m focused on now"
      description="Current work, research, and community activity. I update this page in the first week of each month."
    />

    <div class="now-grid">
      {nowAreas.map((area) => (
        <section class="rail now-card" aria-labelledby={`focus-${area.id}`}>
          <h2 id={`focus-${area.id}`}>{area.category}</h2>

          <ul class="focus-list">
            {area.items.map((item) => (
              <li>
                {item.text}
                {item.link && (
                  <a href={item.link.url} target={item.link.url.startsWith('http') ? '_blank' : undefined} rel={item.link.url.startsWith('http') ? 'noopener' : undefined}>
                    {item.link.text}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <footer class="now-meta-footer">
      <p>
        Updated <time datetime={lastUpdated}>{formatTalkDate(lastUpdated)}</time> · Based on the <a href="https://nownownow.com/about" target="_blank" rel="noopener">/now page movement</a> by Derek Sivers.
      </p>
    </footer>
  </main>
</Layout>

<style>
  .now-grid {
    display: grid;
    border-top: 1px solid var(--ie-rule);
  }

  /* Each area is a rail row: the heading on the left, the entries on the
     right. Stacked on phones, the heading sits close to its entries. */
  .now-card {
    row-gap: var(--gap-related);
    padding: clamp(1.75rem, 3.5vw, 2.5rem) 0;
    border-bottom: 1px solid var(--ie-rule);
  }

  .now-card h2 {
    margin: 0;
    color: var(--ie-ink);
    font-family: var(--font-display);
    font-size: var(--ie-type-h3);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .focus-list {
    display: grid;
    max-width: 64ch;
    margin: 0;
    padding: 0;
    gap: 1rem;
    list-style: none;
  }

  .focus-list li {
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-h4);
    line-height: 1.55;
  }

  .now-meta-footer {
    margin-top: var(--gap-group);
  }

  .now-meta-footer p {
    margin: 0;
    color: var(--ie-muted);
    font-size: var(--ie-type-ui);
  }
</style>
