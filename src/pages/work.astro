---
import Layout from '@layouts/Layout.astro';
import EngagementList from '@components/content/EngagementList.astro';
import talksData from '@data/talks.json';
import '@styles/practice.css';
const workshops = talksData.talks.filter(t => ['agentverse-rag-2026', 'build-with-ai-ips-2025'].includes(t.id));
---
<Layout title="Work & Engagements | Karan Mittal" description="Explore Karan Mittal’s public engineering work, technical workshops, and ways to work together on data, AI, and software problems.">
  <main class="practice-page">
    <span class="register">Work & engagements</span><h1>Understand the problem.<br />Take responsibility for the solution.</h1>
    <p class="lead">I work with organisations on data, AI, and software systems—from investigating a problem to implementing a solution and helping the team own it.</p>
    <div class="actions"><a class="action" href="/contact">Discuss your problem →</a><a href="#engagements">Ways to work together ↓</a></div>

    <section class="section" aria-labelledby="public-work"><span class="register">01 / Public work</span><h2 id="public-work">Selected workshops and technical sessions.</h2><p class="lead">Hands-on workshops and public teaching covering systems engineering, agent workflows, and practical AI implementations.</p>
      {workshops.map(talk => <article class="event-row"><div><span class="register">Workshop</span><time datetime={talk.date}>{new Date(talk.date).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric', timeZone:'UTC' })}</time></div><div><span class="event-meta">{talk.role} / {talk.org}</span><h3>{talk.title}</h3><p>{talk.description}</p><a href={talk.links[0].url} target="_blank" rel="noopener">View the event record ↗</a></div></article>)}
      <div class="actions"><a href="/talks">More talks & workshops →</a></div>
    </section>
    <section class="section" id="engagements" aria-labelledby="engagements-heading"><span class="register">02 / Working together</span><h2 id="engagements-heading">Choose the starting point that fits.</h2><p class="lead">The scope follows the problem. We agree on the useful outcome, constraints, and responsibilities before implementation begins.</p><EngagementList /></section>
    <section class="section" aria-labelledby="practice-heading"><span class="register">03 / Engineering focus</span><h2 id="practice-heading">Technical depth, applied to a useful outcome.</h2><ul class="problem-list"><li><strong>Knowledge & retrieval</strong>Source traceability, retrieval design, and evaluation for teams that need to use scattered information.</li><li><strong>System performance</strong>Profiling, inference paths, and memory or hardware constraints when latency and cost affect the usefulness of a system.</li><li><strong>Delivery & ownership</strong>System boundaries, operational checks, documentation, and handover so the team can maintain what is built.</li></ul></section>
    <section class="section closing"><h2>What needs to work better?</h2><p class="lead">Describe the problem, who it affects, and what a useful result would look like. You do not need to arrive with a chosen technology or a finished brief.</p><a href="/contact" class="action">Start a conversation →</a></section>
  </main>
</Layout>
