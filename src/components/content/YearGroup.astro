---
interface Props {
  year: string;
}

const { year } = Astro.props;
---

<section class="rail year-group" aria-labelledby={`year-${year}`}>
  <h2 id={`year-${year}`} class="year-label">{year}</h2>
  <div class="year-content">
    <slot />
  </div>
</section>

<style>
  /* A rail row: the year on the page edge, its entries to the right. Groups
     share hairlines, so a run of years reads as one ruled list. */
  .year-group {
    row-gap: var(--gap-related);
    padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
    border-top: 1px solid var(--ie-rule);
    border-bottom: 1px solid var(--ie-rule);
  }

  .year-group + .year-group {
    border-top: none;
  }

  .year-label {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--ie-type-h3);
    font-weight: 600;
    color: var(--ie-ink);
    line-height: 1.3;
    letter-spacing: -0.015em;
    font-variant-numeric: tabular-nums;
  }

  .year-content {
    display: flex;
    flex-direction: column;
  }
</style>
