---
const currentPath = Astro.url.pathname;

const nav = [
  { href: '/blog', label: 'Essays' },
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/talks', label: 'Talks' },
];

function isActive(href: string) {
  return currentPath.startsWith(href);
}
---

<header>
  <div class="header-inner">
    <a href="/" class="brand">Karan Mittal</a>
    <nav class="main-nav" aria-label="Primary">
      {nav.map(item => (
        <a href={item.href} class={isActive(item.href) ? 'active' : ''} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease, background-color var(--transition-fast);
  }

  header.scrolled {
    border-bottom-color: var(--border);
  }

  .header-inner {
    max-width: var(--page-max-width);
    margin: 0 auto;
    padding: var(--space-3) var(--space-5);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }

  .brand {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--text);
    letter-spacing: -0.015em;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity var(--transition-fast);
  }
  .brand:hover {
    opacity: 0.65;
    text-decoration: none;
  }

  .main-nav {
    display: flex;
    gap: var(--space-5);
    align-items: center;
  }
  .main-nav a {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    padding: var(--space-1) 0;
    transition: color var(--transition-fast);
  }
  .main-nav a:hover {
    color: var(--text);
    text-decoration: none;
  }
  .main-nav a.active {
    color: var(--text);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .header-inner {
      padding: var(--space-3);
      gap: var(--space-2);
    }
    .brand {
      font-size: 0.95rem;
    }
    .main-nav {
      gap: var(--space-3);
      overflow-x: auto;
      scrollbar-width: none;
      padding: var(--space-1) 0;
    }
    .main-nav::-webkit-scrollbar {
      display: none;
    }
    .main-nav a {
      font-size: 0.8rem;
      white-space: nowrap;
    }
  }
</style>

