---
import Layout from '@layouts/Layout.astro';
---

<Layout title="Page not found | Karan Mittal" description="This path does not resolve." robots="noindex, follow">
  <main class="container lost">
    <p class="eyebrow">Error 404</p>
    <h1>This path does not resolve.</h1>
    <p class="lost-copy">
      The page you asked for was moved, renamed, or never existed.
      The rest of the site is intact.
    </p>
    <div class="lost-actions">
      <a class="button" href="/">Back to the homepage</a>
      <a class="more-link" href="/publications/">Browse publications</a>
    </div>
  </main>
</Layout>

<style>
  .lost h1 {
    max-width: 16ch;
    margin-bottom: var(--gap-related);
  }
  .lost-copy {
    max-width: 46ch;
    margin-bottom: var(--gap-group);
  }
  .lost-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
  }
</style>
