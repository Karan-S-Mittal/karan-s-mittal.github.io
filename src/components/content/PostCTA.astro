---
/**
 * PostCTA.astro
 * End-of-essay call to action, rendered by the essay layout so no post can
 * forget it. It holds the page's one `.button` (to /contact); the second
 * action is a `.more-link` to "What I build" on the homepage. Space alone
 * separates it from the essay: no rule, no eyebrow.
 */

interface Props {
  /** Overrides the default prompt line. Keep it calm and specific. */
  prompt?: string;
  /** Overrides the default heading. */
  heading?: string;
}

const {
  heading = 'Working with data like this?',
  prompt = 'If your team has data like this that people can’t read yet, I can build the view and hand it over.',
} = Astro.props;
---

<section class="post-cta" aria-labelledby="post-cta-heading">
  <h2 id="post-cta-heading">{heading}</h2>
  <p class="post-cta-prompt">{prompt}</p>
  <div class="post-cta-actions">
    <a class="button" href="/contact/">Start a conversation</a>
    <a class="more-link" href="/#practice">What I build</a>
  </div>
</section>

<style>
  .post-cta {
    max-width: 62ch;
    margin-top: var(--gap-section);
  }

  .post-cta h2 {
    margin: 0 0 var(--gap-related);
    font-size: var(--ie-type-h3);
  }

  .post-cta-prompt {
    margin: 0;
    color: var(--ie-muted);
    font-size: var(--ie-type-body);
  }

  .post-cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.75rem;
    margin-top: var(--gap-group);
  }
</style>
