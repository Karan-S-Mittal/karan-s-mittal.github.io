---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;
const post = Astro.props;
const { Content } = await post.render();
---
<Layout title={`${post.data.title} | Karan Mittal`} description={post.data.description}>
  <main style="max-width: 720px; margin: 0 auto; padding: 3rem 1.5rem;">
    <nav style="margin-bottom: 2rem; font-size: 0.9rem; color: var(--muted);">
      <a href="/">Karan Mittal</a>
      <span style="margin: 0 0.5rem;">/</span>
      <a href="/blog">Writing</a>
      <span style="margin: 0 0.5rem;">/</span>
      <span style="font-weight: 600; color: var(--accent);">{post.data.title}</span>
    </nav>

    <article>
      <h1 style="margin-bottom: 0.5rem;">{post.data.title}</h1>
      <p style="color: var(--muted); font-size: 0.9rem; margin-bottom: 2rem;">
        Published {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
      <Content />
    </article>
  </main>
</Layout>
