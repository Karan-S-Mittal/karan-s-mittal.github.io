---
/**
 * AgentContextProgression.astro
 * Publication-grade architectural visual mapping the four coding agent context horizons:
 * CLI → Repo Agent → Cloud/IDE → Multi-Agent Harness.
 *
 * Adheres strictly to the Studio Diagramming Framework:
 * - 100% token-based (using --ie-* tokens), zero raw hex.
 * - Single Rust Locus: State drift constraint in Stage 04.
 * - Author attribution embedded directly inside the graphic canvas frame.
 */
import VisualAttribution from './VisualAttribution.astro';

interface Props {
  exhibit?: string;
  title?: string;
  badge?: string;
  caption?: string;
  wide?: boolean;
}

const {
  exhibit = '03',
  title = 'Coding Agent Context: CLI → Repo Agent → Cloud/IDE → Multi-Agent',
  badge = 'SPECTRUM',
  caption = 'An architectural progression mapping the expansion of context perimeters—from turn-based shell buffers to workspace AST graphs, isolated cloud devcontainers, and distributed multi-agent swarms.',
  wide = true,
} = Astro.props;
---

<div class="agent-context-canvas" id="agent-progression-diagram" data-component="agent-context-progression">
    <!-- Graphic Header inside the Image Frame -->
    <header class="canvas-header">
      <div class="header-tags">
        <span class="tag-badge">ARCHITECTURAL SPECTRUM</span>
        <span class="tag-sub">4-STAGE CONTEXT PROGRESSION</span>
      </div>
      <h3 class="canvas-title">Coding Agent Context Horizons</h3>
      <p class="canvas-subtitle">
        How the agent execution perimeter expands from turn-based terminal buffers to distributed swarms.
      </p>
    </header>

    <!-- 4-Stage Progressive Pipeline Cards -->
    <div class="stages-flow-grid">
      <!-- Stage 01: CLI -->
      <div class="stage-card">
        <div class="stage-top">
          <div class="stage-header">
            <span class="stage-step">01 · CLI</span>
            <span class="stage-badge">~8K–128K</span>
          </div>
          <div class="stage-identity">
            <div class="stage-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="4 17 10 11 4 5" />
                <line x1="12" y1="19" x2="20" y2="19" />
              </svg>
            </div>
            <div class="stage-titles">
              <h4 class="stage-title">CLI Shell</h4>
              <span class="stage-subtitle">Terminal buffer</span>
            </div>
          </div>
          <div class="stage-bullets">
            <div class="bullet-item">
              <span class="bullet-dot" aria-hidden="true"></span>
              <span>Active $PWD & stdout</span>
            </div>
            <div class="bullet-item">
              <span class="bullet-dot" aria-hidden="true"></span>
              <span>Ripgrep regex search</span>
            </div>
            <div class="bullet-item">
              <span class="bullet-dot" aria-hidden="true"></span>
              <span>Turn-based human review</span>
            </div>
          </div>
        </div>
        <div class="stage-footer">
          <span class="stage-boundary">Boundary: Host</span>
          <span class="stage-examples">Aider · Claude CLI</span>
        </div>
      </div>

      <!-- Stage 02: Repo Agent -->
      <div class="stage-card">
        <div class="stage-top">
          <div class="stage-header">
            <span class="stage-step">02 · REPO</span>
            <span class="stage-badge">~1M + AST</span>
          </div>
          <div class="stage-identity">
            <div class="stage-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="18" r="3" />
                <circle cx="6" cy="6" r="3" />
                <circle cx="18" cy="6" r="3" />
                <path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9" />
                <path d="M12 12v3" />
              </svg>
            </div>
            <div class="stage-titles">
              <h4 class="stage-title">Repo Agent</h4>
              <span class="stage-subtitle">Workspace graph</span>
            </div>
          </div>
          <div class="stage-bullets">
            <div class="bullet-item">
              <span class="bullet-dot" aria-hidden="true"></span>
              <span>Codebase AST & LSP</span>
            </div>
            <div class="bullet-item">
              <span class="bullet-dot" aria-hidden="true"></span>
              <span>Project AGENTS.md rules</span>
            </div>
            <div class="bullet-item">
              <span class="bullet-dot" aria-hidden="true"></span>
              <span>Multi-file plan & patch</span>
            </div>
          </div>
        </div>
        <div class="stage-footer">
          <span class="stage-boundary">Boundary: Workspace</span>
          <span class="stage-examples">Cursor · Claude GA</span>
        </div>
      </div>

      <!-- Stage 03: Cloud / IDE -->
      <div class="stage-card">
        <div class="stage-top">
          <div class="stage-header">
            <span class="stage-step">03 · CLOUD/IDE</span>
            <span class="stage-badge">Container</span>
          </div>
          <div class="stage-identity">
            <div class="stage-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242" />
                <path d="M12 12v9" />
                <path d="m8 17 4 4 4-4" />
              </svg>
            </div>
            <div class="stage-titles">
              <h4 class="stage-title">Cloud / IDE</h4>
              <span class="stage-subtitle">Persistent runtime</span>
            </div>
          </div>
          <div class="stage-bullets">
            <div class="bullet-item">
              <span class="bullet-dot" aria-hidden="true"></span>
              <span>Live editor tab state</span>
            </div>
            <div class="bullet-item">
              <span class="bullet-dot" aria-hidden="true"></span>
              <span>gVisor / VM devcontainer</span>
            </div>
            <div class="bullet-item">
              <span class="bullet-dot" aria-hidden="true"></span>
              <span>Async PR background worker</span>
            </div>
          </div>
        </div>
        <div class="stage-footer">
          <span class="stage-boundary">Boundary: Sandbox</span>
          <span class="stage-examples">Codex Cloud · Devin</span>
        </div>
      </div>

      <!-- Stage 04: Multi-Agent Swarm -->
      <div class="stage-card stage-card-active">
        <div class="stage-top">
          <div class="stage-header">
            <span class="stage-step stage-step-active">04 · SWARM</span>
            <span class="stage-badge stage-badge-active">Swarm DAG</span>
          </div>
          <div class="stage-identity">
            <div class="stage-icon stage-icon-active" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m18 16 4-4-4-4" />
                <path d="m6 8-4 4 4 4" />
                <path d="m14.5 4-5 16" />
              </svg>
            </div>
            <div class="stage-titles">
              <h4 class="stage-title">Multi-Agent</h4>
              <span class="stage-subtitle">Distributed teams</span>
            </div>
          </div>
          <div class="stage-bullets">
            <div class="bullet-item">
              <span class="bullet-dot" aria-hidden="true"></span>
              <span>Orchestrator task DAG</span>
            </div>
            <div class="bullet-item">
              <span class="bullet-dot" aria-hidden="true"></span>
              <span>Branched worktrees</span>
            </div>
            <div class="bullet-item">
              <span class="bullet-dot" aria-hidden="true"></span>
              <span>Consensus merge gate</span>
            </div>
          </div>
          <!-- Single Rust Constraint Locus -->
          <div class="stage-constraint">
            <span aria-hidden="true">▲</span>
            <span>Constraint: State drift</span>
          </div>
        </div>
        <div class="stage-footer">
          <span class="stage-boundary">Boundary: Swarm</span>
          <span class="stage-examples">Opus Teams · Swarm</span>
        </div>
      </div>
    </div>

    <!-- Expansion Spectrum Strip with Integrated Author Stamp INSIDE the Frame -->
    <footer class="canvas-footer">
      <div class="spectrum-bar">
        <span class="spectrum-label">CONTEXT SPAN:</span>
        <span class="spectrum-flow">~8KB Shell Buffer ──► ~100MB AST Graph ──► ~10GB Cloud Sandbox ──► Distributed Swarm Bus</span>
      </div>
      <VisualAttribution />
    </footer>
  </div>

<style>
  .agent-context-canvas {
    width: 100%;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 12px);
    padding: clamp(1.25rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    font-family: var(--font-diagram);
    color: var(--ie-ink);
    box-sizing: border-box;
  }

  /* Canvas Header inside Image */
  .canvas-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .header-tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro, 0.75rem);
  }

  .tag-badge {
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm, 4px);
    background: var(--ie-surface-raised);
    color: var(--ie-muted);
    border: 1px solid var(--ie-rule);
  }

  .tag-sub {
    color: var(--ie-blue);
    font-weight: 600;
  }

  .canvas-title {
    margin: 0;
    font-family: var(--font-display, var(--font-sans));
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 700;
    color: var(--ie-ink);
    letter-spacing: -0.025em;
  }

  .canvas-subtitle {
    margin: 0;
    font-size: var(--ie-type-ui, 0.875rem);
    color: var(--ie-ink-secondary);
    max-width: 48rem;
    line-height: 1.45;
  }

  /* 4-Stage Flow Grid */
  .stages-flow-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .stages-flow-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .stages-flow-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Stage Cards */
  .stage-card {
    background: var(--ie-surface-raised);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 8px);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    position: relative;
    transition: border-color 0.15s ease;
  }

  .stage-card:hover {
    border-color: var(--ie-rule-strong);
  }

  .stage-card-active {
    border: 2px solid var(--ie-blue);
    background: var(--ie-surface-raised);
  }

  .stage-top {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .stage-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .stage-step {
    font-weight: 700;
    color: var(--ie-muted);
  }

  .stage-step-active {
    color: var(--ie-blue);
  }

  .stage-badge {
    font-size: 0.625rem;
    font-weight: 600;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm, 3px);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    color: var(--ie-blue);
  }

  .stage-badge-active {
    background: var(--ie-blue-soft);
    border-color: var(--ie-blue);
    color: var(--ie-blue);
  }

  .stage-identity {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .stage-icon {
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm, 4px);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ie-ink);
    flex-shrink: 0;
  }

  .stage-icon-active {
    background: var(--ie-blue-soft);
    border-color: var(--ie-blue);
    color: var(--ie-blue);
  }

  .stage-titles {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .stage-title {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ie-ink);
  }

  .stage-subtitle {
    font-size: 0.6875rem;
    color: var(--ie-muted);
    font-family: var(--font-mono);
  }

  .stage-bullets {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: var(--ie-ink-secondary);
  }

  .bullet-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    line-height: 1.35;
  }

  .bullet-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--ie-blue);
    flex-shrink: 0;
  }

  /* Single Rust Constraint Locus */
  .stage-constraint {
    margin-top: 0.25rem;
    padding: 0.25rem 0.5rem;
    background: var(--ie-rust-soft);
    border: 1px dashed var(--ie-rust);
    border-radius: var(--radius-sm, 4px);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--ie-rust);
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .stage-footer {
    padding-top: 0.625rem;
    border-top: 1px solid var(--ie-rule);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--ie-muted);
  }

  .stage-boundary {
    font-weight: 500;
  }

  .stage-examples {
    color: var(--ie-muted);
  }

  /* Bottom Canvas Footer with Embedded Author Attribution */
  .canvas-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--ie-rule);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .spectrum-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro, 0.75rem);
    color: var(--ie-muted);
  }

  .spectrum-label {
    font-weight: 700;
    color: var(--ie-ink);
  }

  .spectrum-flow {
    color: var(--ie-muted);
  }
</style>
