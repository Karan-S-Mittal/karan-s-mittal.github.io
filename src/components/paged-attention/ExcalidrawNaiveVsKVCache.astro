---
import ExcalidrawContainer from './ExcalidrawContainer.astro';

interface Props {
  caption?: string;
  exhibit?: string;
  title?: string;
}

const { caption, exhibit, title } = Astro.props;
---

<ExcalidrawContainer caption={caption} exhibit={exhibit} title={title} badge="COMPUTE MODEL">
  <svg class="ex-svg-canvas sys-diagram" viewBox="0 0 800 400" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="At decoding step three, naive decoding recomputes three token projections while KV caching projects only the active token and reuses stored keys and values.">
    <defs>
      <marker id="naive-arrow" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto"><polygon points="0 0, 10 4, 0 8" fill="var(--ex-text-main)" /></marker>
      <marker id="naive-arrow-signal" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto"><polygon points="0 0, 10 4, 0 8" fill="var(--ex-text-main)" /></marker>
      <pattern id="naive-hatch" width="8" height="8" patternTransform="rotate(45)" patternUnits="userSpaceOnUse"><line x1="0" y1="0" x2="0" y2="8" stroke="var(--ex-text-muted)" stroke-opacity=".22" stroke-width="2" /></pattern>
    </defs>

    <text x="32" y="32" class="label">DECODE STEP 03</text>
    <text x="768" y="32" class="label" text-anchor="end">SAME NEXT TOKEN</text>
    <line x1="32" y1="48" x2="768" y2="48" class="rule" />

    <text x="32" y="88" class="title">Naive decoding</text>
    <text x="32" y="108" class="body-muted">Run the entire sequence through the transformer again.</text>

    <g transform="translate(32 136)">
      <rect x="0" y="0" width="80" height="48" rx="4" class="node-muted" />
      <rect x="0" y="0" width="80" height="48" rx="4" fill="url(#naive-hatch)" />
      <text x="40" y="20" class="body" text-anchor="middle">The</text><text x="40" y="36" class="label" text-anchor="middle">REPEAT</text>
      <rect x="96" y="0" width="80" height="48" rx="4" class="node-muted" />
      <rect x="96" y="0" width="80" height="48" rx="4" fill="url(#naive-hatch)" />
      <text x="136" y="20" class="body" text-anchor="middle">quick</text><text x="136" y="36" class="label" text-anchor="middle">REPEAT</text>
      <rect x="192" y="0" width="80" height="48" rx="4" class="node-muted" />
      <text x="232" y="20" class="body" text-anchor="middle">brown</text><text x="232" y="36" class="label" text-anchor="middle">ACTIVE</text>
      <path d="M 272 24 H 376" class="flow" marker-end="url(#naive-arrow)" />
      <rect x="376" y="0" width="160" height="48" rx="4" class="node" />
      <text x="456" y="21" class="title" text-anchor="middle">Transformer</text><text x="456" y="37" class="label" text-anchor="middle">3 PROJECTIONS</text>
      <path d="M 536 24 H 640" class="flow" marker-end="url(#naive-arrow)" />
      <rect x="640" y="0" width="96" height="48" rx="4" class="node-muted" />
      <text x="688" y="21" class="body" text-anchor="middle">fox</text><text x="688" y="37" class="label" text-anchor="middle">OUTPUT</text>
    </g>

    <line x1="32" y1="224" x2="768" y2="224" class="rule" />

    <text x="32" y="264" class="title">KV-cached decoding</text>
    <text x="32" y="284" class="body-muted">Reuse prior keys and values; project only the token that just arrived.</text>

    <g transform="translate(32 312)">
      <rect x="0" y="0" width="176" height="56" rx="4" class="node-muted" />
      <text x="16" y="20" class="title">Stored KV cache</text>
      <text x="16" y="40" class="label">THE · QUICK</text>
      <rect x="224" y="0" width="80" height="56" rx="4" class="node-signal" />
      <text x="264" y="22" class="body" text-anchor="middle">brown</text><text x="264" y="42" class="label-signal" text-anchor="middle">NEW QKV</text>
      <path d="M 304 28 H 408" class="flow-signal" marker-end="url(#naive-arrow-signal)" />
      <rect x="408" y="0" width="160" height="56" rx="4" class="node" />
      <text x="488" y="22" class="title" text-anchor="middle">Attention</text><text x="488" y="42" class="label" text-anchor="middle">REUSE + 1 PROJ.</text>
      <path d="M 568 28 H 672" class="flow-signal" marker-end="url(#naive-arrow-signal)" />
      <rect x="672" y="0" width="64" height="56" rx="4" class="node-signal" />
      <text x="704" y="22" class="body" text-anchor="middle">fox</text><text x="704" y="42" class="label-signal" text-anchor="middle">OUTPUT</text>
    </g>
  </svg>
</ExcalidrawContainer>
