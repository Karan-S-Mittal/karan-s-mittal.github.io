---
interface Props {
  year: string;
  count: number;
}

const { year, count } = Astro.props;
---

<section class="year-group" aria-labelledby={`year-${year}`}>
  <div class="year-header">
    <span class="year-dot" aria-hidden="true"></span>
    <h2 id={`year-${year}`} class="year-label">{year}</h2>
    <span class="year-count" aria-hidden="true">{count}</span>
  </div>
  <div class="year-content">
    <slot />
  </div>
</section>

<style>
  .year-group {
    position: relative;
    padding-left: var(--space-6);
  }

  /* Vertical connector line */
  .year-group::before {
    content: '';
    position: absolute;
    left: 5px;
    top: var(--space-2);
    bottom: calc(var(--space-2) * -1);
    width: 1.5px;
    background: var(--border);
  }

  .year-group:last-child::before {
    bottom: auto;
    height: var(--space-3);
  }

  .year-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    position: relative;
  }

  .year-dot {
    position: absolute;
    left: calc(var(--space-6) * -1 + 2px);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--bg);
    flex-shrink: 0;
  }

  .year-label {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    line-height: 1;
  }

  .year-count {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--muted);
    opacity: 0.6;
  }

  .year-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  @media (max-width: 640px) {
    .year-group {
      padding-left: var(--space-5);
    }
    .year-dot {
      left: calc(var(--space-5) * -1 + 2px);
    }
  }
</style>
