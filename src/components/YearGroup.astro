---
interface Props {
  year: string;
  count: number;
}

const { year, count } = Astro.props;
---

<section class="year-group" aria-labelledby={`year-${year}`}>
  <div class="year-header">
    <h2 id={`year-${year}`} class="year-label">{year}</h2>
    <span class="year-count" aria-hidden="true">{count} post{count === 1 ? '' : 's'}</span>
  </div>
  <div class="year-content">
    <slot />
  </div>
</section>

<style>
  .year-group {
    position: relative;
  }

  .year-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  .year-label {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--muted);
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .year-count {
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--muted);
    opacity: 0.6;
  }

  .year-content {
    display: flex;
    flex-direction: column;
  }
</style>
