---
/**
 * CodexVsClaudeCodeHero.astro
 * Minimalist hero banner visual comparing Anthropic Claude Code and OpenAI Codex.
 * Ultra-clean composition modeled directly on the reference visual:
 * - High-contrast monospace header pill
 * - Deep squircle app cards with vector brand marks
 * - Retro pixelated cross operator
 * - Soft stipple/halftone dot canvas
 * - Discreet attribution signature
 * - Zero exhibit headers, zero descriptive clutter, zero raw hex.
 */
import BrandIcon from './icons/BrandIcon.astro';
import VisualAttribution from './VisualAttribution.astro';

interface Props {
  headline?: string;
  class?: string;
}

const {
  headline = 'CODEX  VS  CLAUDE CODE',
  class: className = '',
} = Astro.props;
---

<div class:list={['codex-claude-hero-root', className]}>
  <div class="hero-canvas" id="codex-vs-claude-hero-canvas">
    <!-- Halftone / Stipple Dot Matrix Pattern Canvas -->
    <svg class="canvas-bg-dots" aria-hidden="true" width="100%" height="100%">
      <defs>
        <pattern id="codex-claude-stipple" width="20" height="20" patternUnits="userSpaceOnUse">
          <circle cx="10" cy="10" r="1.5" fill="var(--ie-hero-dot)" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#codex-claude-stipple)" />
    </svg>

    <!-- ================= TOP: MONOSPACE HEADER PILL ================= -->
    <div class="pill-row">
      <div class="header-pill">
        <span class="pill-text">{headline}</span>
      </div>
    </div>

    <!-- ================= MIDDLE: CARDS & OPERATOR ================= -->
    <div class="cards-stage">
      <!-- Claude Code Card -->
      <div class="hero-entity">
        <div class="squircle-card card-claude">
          <div class="icon-wrap icon-claude">
            <BrandIcon name="claude" size={54} />
          </div>
        </div>
        <span class="entity-name">Claude Code</span>
      </div>

      <!-- Retro Pixelated Cross Operator -->
      <div class="operator-wrap" aria-hidden="true">
        <svg class="pixel-operator" width="35" height="35" viewBox="0 0 35 35">
          <!-- Row 0 -->
          <rect x="0" y="0" width="5" height="5" fill="var(--ie-hero-operator)" />
          <rect x="30" y="0" width="5" height="5" fill="var(--ie-hero-operator)" />
          <!-- Row 1 -->
          <rect x="5" y="5" width="5" height="5" fill="var(--ie-hero-operator)" />
          <rect x="25" y="5" width="5" height="5" fill="var(--ie-hero-operator)" />
          <!-- Row 2 -->
          <rect x="10" y="10" width="5" height="5" fill="var(--ie-hero-operator)" />
          <rect x="20" y="10" width="5" height="5" fill="var(--ie-hero-operator)" />
          <!-- Row 3: Center -->
          <rect x="15" y="15" width="5" height="5" fill="var(--ie-hero-operator)" />
          <!-- Row 4 -->
          <rect x="10" y="20" width="5" height="5" fill="var(--ie-hero-operator)" />
          <rect x="20" y="20" width="5" height="5" fill="var(--ie-hero-operator)" />
          <!-- Row 5 -->
          <rect x="5" y="25" width="5" height="5" fill="var(--ie-hero-operator)" />
          <rect x="25" y="25" width="5" height="5" fill="var(--ie-hero-operator)" />
          <!-- Row 6 -->
          <rect x="0" y="30" width="5" height="5" fill="var(--ie-hero-operator)" />
          <rect x="30" y="30" width="5" height="5" fill="var(--ie-hero-operator)" />
        </svg>
      </div>

      <!-- OpenAI Codex Card -->
      <div class="hero-entity">
        <div class="squircle-card card-codex">
          <div class="icon-wrap icon-codex">
            <BrandIcon name="openai" size={54} />
          </div>
        </div>
        <span class="entity-name">Codex</span>
      </div>
    </div>

    <!-- ================= CORNER ATTRIBUTION ================= -->
    <div class="corner-attribution">
      <VisualAttribution author="karansmittal" />
    </div>
  </div>
</div>

<style>
  .codex-claude-hero-root {
    --ie-hero-bg: #eceafd;
    --ie-hero-dot: #c4b5fd;
    --ie-hero-pill-bg: #15181d;
    --ie-hero-pill-text: #f0abfc;
    --ie-hero-pill-border: #2e3440;
    --ie-hero-card-bg: #15181d;
    --ie-hero-card-border: #2a2e39;
    --ie-hero-operator: #8b80b6;
    --ie-hero-icon-white: #ffffff;
    --ie-hero-sub-ink: #2a293d;
    --ie-hero-sub-muted: #5e5c78;
    --ie-hero-spec-text: #f3f4f6;
    --ie-hero-spec-sub: #9da3af;
    width: 100%;
    margin: 0 auto;
  }

  :global(.dark) .codex-claude-hero-root {
    --ie-hero-bg: #0f0d1a;
    --ie-hero-dot: #2a2444;
    --ie-hero-pill-bg: #15181d;
    --ie-hero-pill-text: #f0abfc;
    --ie-hero-pill-border: #2e3440;
    --ie-hero-card-bg: #15181d;
    --ie-hero-card-border: #2a2e39;
    --ie-hero-operator: #7b71a2;
    --ie-hero-icon-white: #ffffff;
    --ie-hero-sub-ink: #f0edf8;
    --ie-hero-sub-muted: #a4a0be;
    --ie-hero-spec-text: #f3f4f6;
    --ie-hero-spec-sub: #aeb6c2;
  }

  .hero-canvas {
    position: relative;
    width: 100%;
    min-height: 420px;
    background-color: var(--ie-hero-bg);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 4vw, 3rem) clamp(2rem, 5vw, 3rem);
    box-sizing: border-box;
  }

  .canvas-bg-dots {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  /* ================= HEADER PILL ================= */
  .pill-row {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    width: 100%;
    margin-bottom: clamp(2rem, 4.5vw, 3.25rem);
  }

  .header-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--ie-hero-pill-bg);
    border: 1px solid var(--ie-hero-pill-border);
    border-radius: 4px;
    padding: 0.75rem clamp(1.5rem, 3.5vw, 2.5rem);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }

  .pill-text {
    font-family: var(--font-mono);
    font-size: clamp(0.8125rem, 1.6vw, 1.05rem);
    font-weight: 600;
    color: var(--ie-hero-pill-text);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: center;
    line-height: 1.3;
  }

  /* ================= CARDS STAGE ================= */
  .cards-stage {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1.75rem, 6vw, 4.5rem);
    width: 100%;
    max-width: 580px;
  }

  .hero-entity {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.85rem;
  }

  .squircle-card {
    position: relative;
    width: clamp(112px, 16vw, 138px);
    height: clamp(112px, 16vw, 138px);
    border-radius: 28px;
    background: var(--ie-hero-card-bg);
    border: 1px solid var(--ie-hero-card-border);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.32);
    transition: transform var(--transition-fast);
  }

  .squircle-card:hover {
    transform: translateY(-2px);
  }

  .icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-claude :global(svg) {
    fill: var(--ie-hero-icon-white);
  }

  .icon-codex :global(svg) {
    fill: var(--ie-hero-icon-white);
  }

  .entity-name {
    font-family: var(--font-diagram);
    font-size: clamp(1rem, 2vw, 1.15rem);
    font-weight: 600;
    color: var(--ie-hero-sub-ink);
    letter-spacing: -0.01em;
  }

  /* ================= RETRO OPERATOR ================= */
  .operator-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: -1.75rem; /* align with squircle center */
  }

  .pixel-operator {
    display: block;
    width: clamp(28px, 4vw, 36px);
    height: clamp(28px, 4vw, 36px);
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.15));
  }

  /* ================= CORNER ATTRIBUTION ================= */
  .corner-attribution {
    position: absolute;
    bottom: 0.85rem;
    right: 1.15rem;
    z-index: 1;
  }

  /* ================= RESPONSIVE ================= */
  @media (max-width: 640px) {
    .cards-stage {
      gap: 1.25rem;
    }
  }
</style>
