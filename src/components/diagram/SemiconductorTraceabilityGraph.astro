          <marker id={`${id}-m3-arr-blue`} viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M1.5 1.5 6.5 4 1.5 6.5" fill="none" stroke="var(--ie-blue)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </marker>
          <marker id={`${id}-m3-arr-rust`} viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M1.5 1.5 6.5 4 1.5 6.5" fill="none" stroke="var(--ie-rust)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </marker>
        </defs>
        <g transform="translate(8 12)">
          <rect width="144" height="48" rx="6" class="node-constraint" />
          <text x="12" y="22" class="node-title constraint-text">Evidence gap</text>
