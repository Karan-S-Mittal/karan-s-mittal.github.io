---
interface Props {
  year: string;
  count: number;
  unit?: string;
}

const { year, count, unit = 'post' } = Astro.props;
---

<section class="year-group" aria-labelledby={`year-${year}`}>
  <div class="year-header">
    <h2 id={`year-${year}`} class="year-label">{year}</h2>
    <span class="year-count-pill" aria-hidden="true">{count} {unit}{count === 1 ? '' : 's'}</span>
  </div>
  <div class="year-content">
    <slot />
  </div>
</section>

<style>
  .year-group {
    position: relative;
    margin-bottom: 2rem;
  }

  .year-group:last-child {
    margin-bottom: 0;
  }

  .year-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--ie-rule);
  }

  .year-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--ie-type-ui);
    font-weight: 600;
    color: var(--ie-ink);
    line-height: 1;
    letter-spacing: 0.05em;
  }

  .year-count-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill, 999px);
    background: var(--ie-surface-raised);
    border: 1px solid var(--ie-rule);
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    font-weight: 500;
    color: var(--ie-muted);
    letter-spacing: 0.02em;
  }

  .year-content {
    display: flex;
    flex-direction: column;
  }
</style>
