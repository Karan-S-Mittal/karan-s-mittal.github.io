---
/**
 * PrimaryVerification.astro
 * Streamlined, publication-grade Primary Citation & Verification Ledger.
 * Ruled, high-density table linking claims to authoritative primary sources.
 */

export interface CitationItem {
  id: string;
  badge?: string;
  claim: string;
  source?: string;
  authors?: string;
  title?: string;
  sourceTitle?: string;
  url?: string;
  permalink?: string;
  anchor?: string;
}

interface Props {
  citations?: CitationItem[];
  items?: CitationItem[];
}

const rawCitations = Astro.props.citations || Astro.props.items || [];
const citations = rawCitations.map((c) => ({
  id: c.id,
  claim: c.claim,
  source: c.source || c.authors || 'Primary Source',
  title: c.title || c.sourceTitle || 'Official Specification',
  url: c.url || c.permalink || '#',
  anchor: c.anchor,
}));
---

<div class="citation-ledger" aria-labelledby="citation-ledger-title">
  <div class="citation-ledger-head">
    <span class="citation-ledger-eyebrow">Evidence Ledger</span>
    <h3 id="citation-ledger-title" class="citation-ledger-title">Primary source citations &amp; verifications</h3>
  </div>

  <div class="citation-table-wrap">
    <table class="citation-table">
      <thead>
        <tr>
          <th scope="col" class="col-ref">Ref</th>
          <th scope="col" class="col-source">Primary Source</th>
          <th scope="col" class="col-claim">Verified Claim / Invariant</th>
        </tr>
      </thead>
      <tbody>
        {citations.map((c) => (
          <tr>
            <td class="cell-ref">[{c.id}]</td>
            <td class="cell-source">
              <a href={c.url} target="_blank" rel="noopener noreferrer" class="citation-link">
                <span class="citation-title">{c.title}</span>
                <span class="citation-arrow" aria-hidden="true">↗</span>
              </a>
              <div class="citation-meta">
                <span class="citation-author">{c.source}</span>
                {c.anchor && (
                  <>
                    <span class="citation-sep" aria-hidden="true">·</span>
                    <code class="citation-anchor">{c.anchor}</code>
                  </>
                )}
              </div>
            </td>
            <td class="cell-claim">{c.claim}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<style>
  .citation-ledger {
    margin: 4.5rem 0 3.5rem;
    border-top: 2px solid var(--ie-ink);
    border-bottom: 1px solid var(--ie-rule-strong);
  }

  .citation-ledger-head {
    padding: 1.25rem 0 0.85rem;
    border-bottom: 1px solid var(--ie-rule);
  }

  .citation-ledger-eyebrow {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--ie-blue);
    font-family: var(--font-sans);
    font-size: var(--ie-type-label);
    font-weight: 600;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .citation-ledger-title {
    margin: 0;
    color: var(--ie-ink);
    font-family: var(--font-display);
    font-size: var(--ie-type-ui);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .citation-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--ie-rule) transparent;
  }

  .citation-table {
    width: 100%;
    margin: 0;
    border-collapse: collapse;
    table-layout: auto;
    font-family: var(--font-sans);
    font-size: var(--ie-type-small);
  }

  .citation-table th {
    padding: 0.85rem 1rem 0.85rem 0;
    border-bottom: 1px solid var(--ie-rule-strong);
    color: var(--ie-ink);
    font-family: var(--font-sans);
    font-size: var(--ie-type-micro);
    font-weight: 600;
    text-align: left;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: transparent;
  }

  .citation-table td {
    padding: 1.1rem 1rem 1.1rem 0;
    border-bottom: 1px solid var(--ie-rule);
    vertical-align: top;
    line-height: 1.55;
  }

  .citation-table tr:last-child td {
    border-bottom: none;
  }

  .col-ref {
    width: 4.5rem;
  }

  .col-source {
    width: 32%;
    min-width: 13rem;
  }

  .col-claim {
    width: auto;
  }

  .cell-ref {
    font-family: var(--font-mono);
    font-size: var(--ie-type-label);
    font-weight: 600;
    color: var(--ie-rust);
    white-space: nowrap;
  }

  .cell-source {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-right: 1.5rem;
  }

  .citation-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    color: var(--ie-ink);
    font-weight: 600;
    text-decoration: none;
    transition: color 120ms ease;
  }

  .citation-link:hover {
    color: var(--ie-blue);
    text-decoration: underline;
  }

  .citation-arrow {
    color: var(--ie-blue);
    font-size: 0.85em;
    font-weight: normal;
  }

  .citation-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
    font-size: var(--ie-type-micro);
    color: var(--ie-muted);
  }

  .citation-author {
    color: var(--ie-muted);
  }

  .citation-sep {
    color: var(--ie-rule-strong);
  }

  .citation-anchor {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0.1rem 0.3rem;
    border-radius: var(--radius-sm, 3px);
    background: var(--ie-surface-raised);
    color: var(--ie-ink-secondary);
  }

  .cell-claim {
    color: var(--ie-ink-secondary);
    max-width: 50ch;
  }

  @media (max-width: 640px) {
    .citation-table {
      min-width: 32rem;
    }

    .citation-table th,
    .citation-table td {
      padding: 0.75rem 0.75rem 0.75rem 0;
    }

    .col-ref {
      width: 3rem;
    }

    .col-source {
      width: 11rem;
      min-width: 11rem;
    }

    .cell-claim {
      min-width: 16rem;
    }
  }
</style>
