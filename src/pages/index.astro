---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import { SITE } from "../config";
import { practiceAreas } from "@data/practice";
import { externalWriting } from "@data/publications";
import talksData from "@data/talks.json";
import { talkTypeLabel, type Talk } from "../types/talks";
import communitiesData from "@data/communities.json";
import PracticeChart from "@components/diagram/home/PracticeChart.astro";
import CommunityIcon from "@components/content/CommunityIcon.astro";
import AccentTitle from "@components/content/AccentTitle.astro";
import { formatMonthYear } from "@utils/date";
import "@styles/practice.css";

const publishedPosts = (
  await getCollection("blog", ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestLocalPost = publishedPosts[0];
const externalArticle = externalWriting[0];
const recentTalks = [...talksData.talks]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, latestLocalPost ? 1 : 2);

// Most visible community first.
const communityOrder = ["gdg-cloud-indore", "mlindore", "codevipassana"];
const communities = [...communitiesData.communities].sort(
  (a, b) => communityOrder.indexOf(a.id) - communityOrder.indexOf(b.id),
);

---

<Layout title={SITE.title} description={SITE.description}>
  <main class="practice-page home-page">
    <section class="band home-hero" aria-labelledby="hero-heading">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1 id="hero-heading">Karan Mittal</h1>
          <ul class="hero-role">
            <li>Data visualisation expert</li>
            <li>
              Co-founder and CTO, <a
                href="https://dextar.co"
                target="_blank"
                rel="noopener">Dextar</a
              >
            </li>
            <li>Organiser, ML Indore and GDG Cloud Indore</li>
          </ul>
          <p class="lead">
            I’ve built data apps in Plotly Dash since 2019, including a year as
            a software engineer at Plotly. After that I built analytics for
            semiconductor manufacturing at Lam Research and for oncology teams in
            life sciences.
          </p>
          <div class="actions">
            <a class="button" href="/contact/">Discuss your project</a>
            <a class="more-link" href="/publications/">Writing and talks</a>
          </div>
        </div>

        <figure class="hero-portrait">
          <img
            src="/photos/karan-mittal.jpg"
            srcset="/photos/karan-mittal-320.jpg 320w, /photos/karan-mittal.jpg 480w"
            sizes="(max-width: 720px) 200px, 380px"
            alt="Karan Mittal"
            width="480"
            height="600"
            fetchpriority="high"
          />
        </figure>
      </div>
    </section>

    <section id="practice" class="band band--tint" aria-labelledby="practice-heading">
      <div class="wrap">
        <div class="section-header">
          <h2 id="practice-heading">What I build</h2>
          <p class="lead">
            Most of my work starts with data that’s hard to read and ends with
            something a team opens every week.
          </p>
        </div>

        <ol class="columns practice-list">
          {
            practiceAreas.map((area) => (
              <li class="practice-item" id={area.id}>
                <div class="practice-figure">
                  <PracticeChart kind={area.chart} />
                </div>
                <h3 class="practice-problem">{area.problem}</h3>
                <p class="practice-intervention">{area.intervention}</p>
              </li>
            ))
          }
        </ol>
        <p class="practice-caption">The charts use illustrative data.</p>
      </div>
    </section>

    <section class="band" aria-labelledby="recent-heading">
      <div class="wrap">
        <h2 id="recent-heading" class="section-header">Writing and talks</h2>

        <ul class="community-list" aria-label="Communities">
          {
            communities.map((community) => (
              <li>
                <a
                  class="community"
                  href={community.links[0].url}
                  target="_blank"
                  rel="noopener"
                >
                  <CommunityIcon id={community.id} />
                  <span class="community-text">
                    <span class="community-name">{community.name}</span>
                    <span class="community-role">{community.role}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <ul class="columns proof-list">
          {
            latestLocalPost && (
              <li class="proof-item">
                <p class="proof-meta">
                  <time datetime={latestLocalPost.data.pubDate.toISOString()}>
                    {formatMonthYear(latestLocalPost.data.pubDate)}
                  </time>
                  <span>Essay</span>
                </p>
                <h3 class="proof-title">
                  <a href={`/writing/${latestLocalPost.id}/`}>
                    <AccentTitle title={latestLocalPost.data.title} />
                  </a>
                </h3>
                <p class="proof-desc">{latestLocalPost.data.description}</p>
              </li>
            )
          }

          {
            externalArticle && (
              <li class="proof-item">
                <p class="proof-meta">
                  <time datetime={externalArticle.pubDate}>
                    {formatMonthYear(externalArticle.pubDate)}
                  </time>
                  <span>Published at {externalArticle.publication}</span>
                </p>
                <h3 class="proof-title">
                  <a href={externalArticle.href} target="_blank" rel="noopener">
                    <>
                      <AccentTitle title={externalArticle.title} />
                      <span class="proof-mark" aria-hidden="true">
                        &nbsp;&nearr;
                      </span>
                    </>
                  </a>
                </h3>
                <p class="proof-desc">{externalArticle.description}</p>
              </li>
            )
          }

          {
            recentTalks.map((talk) => (
              <li class="proof-item">
                <p class="proof-meta">
                  <time datetime={talk.date}>
                    {formatMonthYear(talk.date)}
                  </time>
                  <span>
                    {talkTypeLabel[talk.type as Talk["type"]]} · {talk.event}
                  </span>
                </p>
                <h3 class="proof-title">
                  {talk.links[0] ? (
                    <a href={talk.links[0].url} target="_blank" rel="noopener">
                      <AccentTitle title={talk.title} />
                      <span class="proof-mark" aria-hidden="true">
                        &nbsp;&nearr;
                      </span>
                    </a>
                  ) : (
                    talk.title
                  )}
                </h3>
                <p class="proof-desc">{talk.description}</p>
              </li>
            ))
          }
        </ul>

        <div class="actions">
          <a class="more-link" href="/publications/">All writing and talks</a>
        </div>
      </div>
    </section>

    <section class="band band--tint" aria-labelledby="closing-heading">
      <div class="wrap">
        <h2 id="closing-heading">What needs to work better?</h2>
        <p class="lead">
          Describe the data, who relies on it and what they need to see. A
          few sentences are enough to start.
        </p>
        <div class="actions">
          <a href="/contact/" class="more-link">Start a conversation</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* ---- Hero: who, on the page edge; the portrait beside it ----------- */

  .home-hero {
    padding-top: var(--page-top);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 380px);
    align-items: center;
    gap: var(--gap-group) clamp(2rem, 6vw, 6rem);
  }

  .home-hero h1 {
    margin-bottom: var(--gap-related);
    font-size: var(--ie-type-display);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .hero-role {
    max-width: 52ch;
    margin-bottom: var(--gap-related);
    color: var(--ie-ink);
    font-size: var(--ie-type-body);
    font-weight: 600;
    line-height: 1.4;
    list-style: none;
    padding: 0;
  }

  .hero-role li {
    margin: 0;
    color: inherit;
  }

  .home-hero .lead {
    max-width: 58ch;
  }

  .hero-portrait {
    margin: 0;
  }

  /* The hairline holds the frame when the photo's edge is as light as the
     page (the pale expo floor along its bottom edge). */
  .hero-portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    border-radius: 18px;
    corner-shape: squircle;
    object-fit: cover;
    outline: 1px solid var(--ie-rule-strong);
    outline-offset: -1px;
  }

  /* Phones: a small portrait above the name, so the first screen shows
     the person and the message together. */
  @media (max-width: 720px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-portrait {
      order: -1;
      width: 200px;
    }

    .hero-role {
      font-size: var(--ie-type-base);
    }
  }

  /* ---- Sections: title, then content, on the page edge -------------- */

  .section-header {
    margin-bottom: var(--gap-group);
  }

  .section-header .lead {
    max-width: 58ch;
  }

  /* ---- Writing and talks -------------------------------------------- */

  /* A free row, not the three-column grid below it: lined up with the
     columns, each community would read as the heading of the item under it. */
  .community-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-related) 3rem;
    margin: 0 0 var(--gap-group);
    padding: 0;
    list-style: none;
  }

  .community-list li {
    margin: 0;
  }

  .community {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-height: 44px;
    color: var(--ie-ink);
  }

  /* The hairline keeps a dark logo visible on the dark band. */
  .community-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .community-name {
    font-weight: 600;
  }

  .community:hover .community-name {
    color: var(--ie-blue);
  }

  .community-role {
    color: var(--ie-muted);
    font-size: var(--ie-type-small);
  }

  /* Three columns, side by side, so each section fits on about one screen. */
  .columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 3vw, 3rem);
    row-gap: var(--gap-group);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .columns > li {
    margin: 0;
    padding-top: var(--gap-related);
    border-top: 1px solid var(--ie-rule-strong);
  }

  /* The glyphs differ in height, so practice items are subgrids: the
     titles and text start on the same line in every column. */
  .practice-list > li {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: 0;
  }

  @media (max-width: 900px) {
    .columns {
      grid-template-columns: 1fr;
    }

    .practice-list > li {
      grid-row: auto;
      grid-template-rows: none;
    }
  }

  .proof-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-bottom: 0.5rem;
    color: var(--ie-muted);
    font-size: var(--ie-type-small);
  }

  .proof-meta span {
    font-weight: 600;
  }

  .proof-title {
    max-width: 44ch;
    margin-bottom: 0.55rem;
    font-size: var(--ie-type-h3);
    line-height: 1.22;
    letter-spacing: -0.02em;
  }

  .proof-title a {
    color: var(--ie-ink);
  }

  .proof-title a:hover {
    color: var(--ie-blue);
  }

  .proof-mark {
    margin-left: 0.3em;
    color: var(--ie-muted);
    font-size: 0.8em;
  }

  .proof-desc {
    max-width: 68ch;
    margin: 0;
    color: var(--ie-ink-secondary);
  }

  /* ---- What I build: a small chart above each item ------------------ */

  .practice-figure {
    margin-bottom: var(--gap-related);
  }

  .practice-caption {
    margin: var(--gap-group) 0 0;
    color: var(--ie-muted);
    font-size: var(--ie-type-caption);
  }

  .practice-problem {
    margin-bottom: 0.65rem;
    font-size: var(--ie-type-h3);
    line-height: 1.24;
    letter-spacing: -0.02em;
  }

  .practice-intervention {
    max-width: 68ch;
    margin: 0;
    color: var(--ie-ink-secondary);
  }
</style>
