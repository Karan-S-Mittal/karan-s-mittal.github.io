---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/content/PageHeader.astro';
import { formatTalkDate } from '@utils/date';

// Bump this date whenever this page's content is edited.
const lastUpdated = new Date('2026-09-23');

const focusAreas = [
  {
    index: '01',
    category: 'Building',
    items: [
      { text: 'Co-founding and leading systems engineering at ', link: { text: 'Dextar.co', url: 'https://dextar.co' } },
      { text: 'Graph-grounded traceability and evidence screening pipelines for complex manufacturing supply chains' },
      { text: 'Knowledge systems that combine graph structure with LLM retrieval, where every answer carries its provenance' },
    ],
  },
  {
    index: '02',
    category: 'Investigating',
    items: [
      { text: 'Knowledge systems: when graph structure beats vector similarity for retrieval, and how to combine the two' },
      { text: 'LLM evaluation: building ground-truth suites from real questions, and measuring where automated graders disagree with people' },
      { text: 'Graph theory: what the structure of a knowledge graph reveals about missing or contradictory facts' },
    ],
  },
  {
    index: '03',
    category: 'Teaching',
    items: [
      { text: 'Organizing hands-on AI systems and LLMOps workshops at ', link: { text: 'MLIndore', url: 'https://gdg.community.dev/events/details/google-gdg-indore-presents-build-with-ai-hands-on-ai-agents-amp-llmops-workshop-ml-indore-amp-gdg-indore/' } },
      { text: 'Mentoring engineers in systems architecture and distributed systems at ', link: { text: 'CodeVipassana', url: 'https://www.codevipassana.dev/' } },
      { text: 'Running distributed systems and cloud infrastructure workshops with ', link: { text: 'GDG Cloud Indore', url: 'https://gdg.community.dev/gdg-cloud-indore/' } },
    ],
  },
  {
    index: '04',
    category: 'Changed my mind about',
    items: [
      { text: 'General-purpose agent loops: shifted from open-ended autonomous agent workflows to bounded, specialized paths backed by explicit graph-grounded verification gates' },
    ],
  },
];
---

<Layout
  title="Now | Karan Mittal"
  description="A living snapshot of Karan Mittal's current systems engineering focus, research, and priorities."
>
  <main class="container now-page">
    <PageHeader
      label="Now"
      title="What I’m focused on now."
      description="Current work, research, and community activity. Updated when something changes."
    />

    <div class="now-grid">
      {focusAreas.map((area) => (
        <section class="now-card" aria-labelledby={`focus-${area.index}`}>
          <h2 id={`focus-${area.index}`}>{area.category}</h2>

          <ul class="focus-list">
            {area.items.map((item) => (
              <li>
                {item.text}
                {item.link && (
                  <a href={item.link.url} target={item.link.url.startsWith('http') ? '_blank' : undefined} rel={item.link.url.startsWith('http') ? 'noopener' : undefined}>
                    {item.link.text}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <footer class="now-meta-footer">
      <p>
        Updated <time datetime={lastUpdated.toISOString()}>{formatTalkDate(lastUpdated.toISOString().slice(0, 10))}</time> · Based on the <a href="https://nownownow.com/about" target="_blank" rel="noopener">/now page movement</a> by Derek Sivers.
      </p>
    </footer>
  </main>
</Layout>

<style>
  .now-page {
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }

  .now-grid {
    display: grid;
    border-top: 1px solid var(--ie-rule);
  }

  .now-card {
    display: grid;
    /* Heading rail on the left; the width goes to the entries. */
    grid-template-columns: minmax(10rem, 0.32fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.75rem);
    padding: clamp(1.75rem, 3.5vw, 2.5rem) 0;
    border-bottom: 1px solid var(--ie-rule);
  }

  .now-card h2 {
    margin: 0;
    color: var(--ie-ink);
    font-family: var(--font-display);
    font-size: var(--ie-type-h3);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .focus-list {
    display: grid;
    max-width: 64ch;
    margin: 0;
    padding: 0;
    gap: 1rem;
    list-style: none;
  }

  .focus-list li {
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-h4);
    line-height: 1.55;
  }

  .now-meta-footer {
    margin-top: 1.5rem;
  }

  .now-meta-footer p {
    margin: 0;
    color: var(--ie-muted);
    font-size: var(--ie-type-ui);
  }

  @media (max-width: 680px) {
    .now-card {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
