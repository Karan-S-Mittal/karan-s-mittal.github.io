---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import communitiesData from '../data/communities.json';

const { communities } = communitiesData;
---

<Layout title="About | Karan Mittal">
  <main class="container">
    <PageHeader label="About" title="Karan Mittal" />

    <blockquote class="hero-quote">
      Most data problems aren't data problems. They're architecture problems.
    </blockquote>

    <p class="bio">
      I'm the co-founder and CTO of <a href="https://dextar.co">Dextar.co</a>, where we build deterministic,
      high-performance AI systems for enterprise clients. Previously, I have architected systems across life
      sciences, semiconductor supply chains, and finance. My focus is on the intersection of AI reliability,
      graph-based retrieval, and production MLOps.
    </p>

    <nav class="local-nav">
      <a href="#capabilities">Capabilities</a>
      <span class="nav-sep">·</span>
      <a href="#community">Community</a>
    </nav>

    <section id="capabilities">
      <h2>Capabilities</h2>
      <div class="capabilities-grid">
        <div class="capability">
          <h3>AI Architecture</h3>
          <p>GraphRAG, deterministic retrieval, vector databases, DSPy, LLM orchestration</p>
        </div>
        <div class="capability">
          <h3>Performance</h3>
          <p>CUDA optimisation, model quantisation, GPU cluster tuning, low-latency inference</p>
        </div>
        <div class="capability">
          <h3>Infrastructure</h3>
          <p>MLOps pipelines, Kubernetes, cloud-native systems, distributed training</p>
        </div>
        <div class="capability">
          <h3>Leadership</h3>
          <p>Engineering team building, technical strategy, vendor evaluation, investor communication</p>
        </div>
      </div>
    </section>

    <hr />

    <section id="community">
      <h2>Community</h2>
      <p class="section-desc">I organise and mentor across several technical communities in Central India.</p>
      <div class="community-grid">
        {communities.map((c) => (
          <div class="community-card">
            <img src={c.logo} alt={c.name} class="community-logo" />
            <p class="community-name">{c.name}</p>
            <p class="community-desc">{c.description}</p>
            {c.links && c.links.length > 0 && (
              <div class="community-links">
                {c.links.map((link: { label: string; url: string }) => (
                  <a href={link.url} target="_blank" rel="noopener">
                    {link.label}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17L17 7"/><path d="M7 7h10v10"/>
                    </svg>
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="cta-section">
      <h2>Let's Build</h2>
      <p>Available for enterprise consulting, advisory roles, and speaking engagements.</p>
      <div class="cta-actions">
        <a href="mailto:karanshyammittal@gmail.com" class="btn btn-primary">Send an Email</a>
        <a href="https://www.linkedin.com/in/karansmittal/" class="btn btn-secondary">LinkedIn</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero-quote {
    margin: 0 0 var(--space-6);
    padding: 0;
    border: none;
    background: none;
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--text);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }
  .bio {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-6);
    max-width: 640px;
  }

  .local-nav {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    font-size: var(--text-sm);
    font-weight: 500;
    margin-bottom: var(--space-7);
  }
  .nav-sep {
    color: var(--border);
  }

  .capabilities-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }
  .capability h3 {
    margin-top: 0;
    margin-bottom: var(--space-1);
    font-size: var(--text-base);
    font-weight: 600;
  }
  .capability p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.6;
  }

  .section-desc {
    color: var(--muted);
    margin-bottom: var(--space-5);
    margin-top: calc(var(--space-2) * -1);
  }

  .community-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .community-card {
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    text-align: center;
  }
  .community-logo {
    margin: 0 auto var(--space-3);
    display: block;
    max-height: 48px;
    width: auto;
    height: auto;
    object-fit: contain;
    opacity: 0.85;
  }
  .community-name {
    font-weight: 600;
    color: var(--text);
    margin: 0 0 var(--space-1);
    font-size: var(--text-sm);
  }
  .community-desc {
    margin: 0 0 var(--space-3);
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .community-links {
    display: flex;
    gap: var(--space-2);
    justify-content: center;
    flex-wrap: wrap;
  }
  .community-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--muted);
  }
  .community-links a:hover {
    color: var(--text);
  }
  .community-links a svg {
    opacity: 0.4;
  }

  .cta-section {
    margin-top: var(--space-8);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    text-align: center;
  }
  .cta-section h2 {
    margin-top: 0;
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }
  .cta-section p {
    color: var(--muted);
    margin-bottom: var(--space-4);
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }
  .cta-actions {
    display: flex;
    gap: var(--space-2);
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 720px) {
    .capabilities-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .community-grid {
      grid-template-columns: 1fr;
    }
    .hero-quote {
      font-size: var(--text-lg);
    }
  }
</style>
