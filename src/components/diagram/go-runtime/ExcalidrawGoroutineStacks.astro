---
import ExcalidrawContainer from '../paged-attention/ExcalidrawContainer.astro';

interface Props {
  caption?: string;
  exhibit?: string;
  title?: string;
}

const { caption, exhibit, title } = Astro.props;
---

<ExcalidrawContainer caption={caption} exhibit={exhibit} title={title} badge="MEMORY FOOTPRINT">
  <svg class="ex-svg-canvas sys-diagram" viewBox="0 0 720 420" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Comparison between fixed 2MB OS thread stacks and dynamically resizing 2KB Go contiguous stacks.">
    <defs>
      <marker id="stack-arr" markerWidth="7" markerHeight="6" refX="6" refY="3" orient="auto"><polygon points="0 0, 7 3, 0 6" fill="#1A1A2E" /></marker>
      <marker id="stack-arr-blue" markerWidth="7" markerHeight="6" refX="6" refY="3" orient="auto"><polygon points="0 0, 7 3, 0 6" fill="#2676AA" /></marker>
      <pattern id="waste-stack-hatch" width="8" height="8" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
        <line x1="0" y1="0" x2="0" y2="8" stroke="var(--muted)" stroke-opacity="0.25" stroke-width="1.5" />
      </pattern>
    </defs>

    <!-- SECTION 1: OS THREAD (STATIC 2MB) -->
    <g transform="translate(20, 16)">
      <text x="0" y="12" class="label-signal" font-size="9.5" font-weight="700" letter-spacing="0.05em" dominant-baseline="central">APPROACH A / OS KERNEL THREAD (PTHREAD)</text>
      <text x="0" y="28" class="body-muted" font-size="11.5" dominant-baseline="central">Static 2MB–8MB stack allocation per thread + MMU guard pages. 100k threads consume &gt;200 GB RAM.</text>

      <g transform="translate(0, 44)">
        <rect x="0" y="0" width="680" height="52" rx="8" class="node-muted" stroke-width="1.5" />

        <!-- Guard Page Low -->
        <rect x="0" y="0" width="40" height="52" rx="6" fill="color-mix(in srgb, var(--text-muted) 15%, transparent)" stroke="var(--border-default)" stroke-width="1.5" />
        <text x="20" y="26" class="label" font-size="8" font-weight="700" text-anchor="middle" dominant-baseline="central">GUARD</text>

        <!-- Used 4KB Frame -->
        <rect x="44" y="0" width="90" height="52" rx="6" class="node" stroke-width="1.5" />
        <text x="89" y="18" class="body" font-size="10.5" font-weight="700" text-anchor="middle" dominant-baseline="central">Used Frame</text>
        <text x="89" y="34" class="label-signal" font-size="8.5" font-weight="600" text-anchor="middle" dominant-baseline="central">~4 KB DATA</text>

        <!-- Unused 2MB Ghost Reservation -->
        <rect x="138" y="0" width="498" height="52" fill="url(#waste-stack-hatch)" />
        <text x="387" y="18" class="body-muted" font-size="11.5" font-weight="600" text-anchor="middle" dominant-baseline="central">Unused Virtual Memory Reservation (Locked by Kernel MMU)</text>
        <text x="387" y="34" class="label" font-size="9" text-anchor="middle" dominant-baseline="central">~2,093,056 BYTES UNUSED (99.8% ALLOCATION WASTE PER IDLE THREAD)</text>

        <!-- Guard Page High -->
        <rect x="640" y="0" width="40" height="52" rx="6" fill="color-mix(in srgb, var(--text-muted) 15%, transparent)" stroke="var(--border-default)" stroke-width="1.5" />
        <text x="660" y="26" class="label" font-size="8" font-weight="700" text-anchor="middle" dominant-baseline="central">GUARD</text>
      </g>
    </g>

    <!-- DIVIDER -->
    <line x1="20" y1="146" x2="700" y2="146" stroke="var(--border-default)" stroke-width="1.5" />

    <!-- SECTION 2: GO CONTIGUOUS DYNAMIC STACKS -->
    <g transform="translate(20, 162)">
      <text x="0" y="12" class="label-signal" font-size="9.5" font-weight="700" letter-spacing="0.05em" dominant-baseline="central">APPROACH B / GO DYNAMIC CONTIGUOUS STACKS</text>
      <text x="0" y="28" class="body-muted" font-size="11.5" dominant-baseline="central">Starts at only 2KB in heap arena. Grows via runtime.morestack copy when call frame exhausts limit.</text>

      <g transform="translate(0, 44)">
        <!-- Step 1: Initial 2KB Frame -->
        <g transform="translate(0, 0)">
          <rect x="0" y="0" width="180" height="136" rx="8" class="node-signal" stroke-width="1.5" />
          <text x="16" y="20" class="title" font-size="13" font-weight="600" dominant-baseline="central">01 / Initial Stack</text>
          <text x="16" y="38" class="label-signal" font-size="8.5" font-weight="600" dominant-baseline="central">2,048 BYTES CONTIGUOUS</text>

          <g transform="translate(14, 52)">
            <rect x="0" y="0" width="152" height="70" rx="6" class="node" stroke-width="1.5" />
            <text x="14" y="20" class="body" font-size="10.5" font-weight="600" dominant-baseline="central">main() frame</text>
            <text x="14" y="38" class="body-muted" font-size="10" dominant-baseline="central">handleConn() frame</text>
            <text x="14" y="56" class="label-signal" font-size="8.5" font-weight="700" dominant-baseline="central">SP &rarr; Top of Stack</text>
          </g>
        </g>

        <!-- Prologue Check Arrow -->
        <path d="M 186 68 H 234" class="flow-signal" stroke="#2676AA" stroke-width="2" marker-end="url(#stack-arr-blue)" />
        <text x="210" y="54" class="label-signal" text-anchor="middle" font-size="8.5" font-weight="700" dominant-baseline="central">CHECK</text>

        <!-- Step 2: Compiler Prologue Check -->
        <g transform="translate(240, 0)">
          <rect x="0" y="0" width="210" height="136" rx="8" class="node" stroke-width="1.5" />
          <text x="16" y="20" class="title" font-size="13" font-weight="600" dominant-baseline="central">02 / Prologue Check</text>
          <text x="16" y="38" class="label" font-size="8.5" font-weight="600" dominant-baseline="central">INLINE ASSEMBLY PROLOGUE</text>

          <g transform="translate(14, 52)">
            <rect x="0" y="0" width="182" height="70" rx="6" class="node-muted" stroke-width="1.5" />
            <text x="12" y="20" class="label-signal" font-family="var(--font-mono)" font-size="9" dominant-baseline="central">CMPQ SP, 16(R14)</text>
            <text x="12" y="38" class="label-signal" font-family="var(--font-mono)" font-size="9" dominant-baseline="central">JLS  runtime.morestack</text>
            <text x="12" y="56" class="body-muted" font-size="9.5" dominant-baseline="central">Detects SP &lt; stackguard0</text>
          </g>
        </g>

        <!-- Growth Arrow -->
        <path d="M 456 68 H 504" class="flow-signal" stroke="#2676AA" stroke-width="2" marker-end="url(#stack-arr-blue)" />
        <text x="480" y="54" class="label-signal" text-anchor="middle" font-size="8.5" font-weight="700" dominant-baseline="central">2X ALLOC</text>

        <!-- Step 3: Copied Contiguous 4KB Frame -->
        <g transform="translate(510, 0)">
          <rect x="0" y="0" width="170" height="136" rx="8" class="node-signal" stroke-width="1.5" />
          <text x="16" y="20" class="title" font-size="13" font-weight="600" dominant-baseline="central">03 / Doubled Stack</text>
          <text x="16" y="38" class="label-signal" font-size="8.5" font-weight="600" dominant-baseline="central">4,096 BYTES (EXPANDED)</text>

          <g transform="translate(14, 52)">
            <rect x="0" y="0" width="142" height="70" rx="6" class="node" stroke-width="1.5" />
            <text x="12" y="20" class="body" font-size="10" font-weight="600" dominant-baseline="central">Frames Copied</text>
            <text x="12" y="38" class="body-muted" font-size="9.5" dominant-baseline="central">Pointers adjusted</text>
            <text x="12" y="56" class="label-signal" font-size="8" font-weight="700" dominant-baseline="central">Shrinks on GC cycle</text>
          </g>
        </g>
      </g>
    </g>

    <!-- Editorial Leader Line -->
    <text x="20" y="394" class="body-muted" font-size="11" dominant-baseline="central">&larr; notice contiguous stack copy eliminates hot-split overheads while 100k Goroutines cost only ~200MB RAM</text>
  </svg>
</ExcalidrawContainer>
