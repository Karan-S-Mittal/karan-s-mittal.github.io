---
import StudioPanel from '../chrome/StudioPanel.astro';

interface WorkItem {
  id: string;
  eyebrow: string;
  title: string;
  summary: string;
  context?: string;
  focus?: string[];
  flow?: string[];
}

interface Props {
  item: WorkItem;
  detailed?: boolean;
  index?: string;
}

const { item, detailed = false, index } = Astro.props;
---

<StudioPanel
  id={`work-${item.id}`}
  title={item.title}
  label={item.eyebrow}
  index={index}
  heading="h2"
  state="signal"
  spacious={detailed}
>
  <div class:list={['work-card-copy', { detailed }]}>
    <p class="summary">{item.summary}</p>
    {detailed && item.context && <p class="context">{item.context}</p>}
  </div>

  {detailed && item.focus && (
    <div class="detail-grid">
      <div>
        <p class="detail-label">Design focus</p>
        <ul>
          {item.focus.map((point) => <li>{point}</li>)}
        </ul>
      </div>
      {item.flow && (
        <div>
          <p class="detail-label">System lens</p>
          <ol class="system-flow">
            {item.flow.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{step}</li>)}
          </ol>
        </div>
      )}
    </div>
  )}
</StudioPanel>

<style>
  .detail-label {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ie-blue);
  }

  .summary,
  .context {
    margin: 0;
    color: var(--ie-ink-secondary);
    line-height: 1.65;
    font-size: 0.95rem;
  }

  .context {
    margin-top: 0.75rem;
    color: var(--ie-muted);
    font-size: 0.9rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ie-rule);
  }

  ul,
  .system-flow {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  ul li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--ie-ink-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  ul li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--ie-blue);
    font-weight: 600;
  }

  .system-flow li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--ie-ink-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .system-flow span {
    color: var(--ie-blue);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .detail-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
