---
import Exhibit from '../../editorial/Exhibit.astro';

interface Props { caption?: string; exhibit?: string; title?: string; }

const {
  caption = 'A contiguous allocator reserves a large maximum-length region before the sequence exists. A block allocator requests fixed-size frames only as tokens arrive, leaving unused capacity only in the final partially filled block.',
  exhibit = '03',
  title = 'Why reserving for the maximum sequence wastes memory',
} = Astro.props;
---

<Exhibit exhibit={exhibit} title={title} badge="ALLOCATION MECHANISM" caption={caption} wide>
  <div class="allocation-comparison">
    <header class="allocation-question">
      <span>Example request</span>
      <strong>The request has generated 5 tokens. The maximum possible length is 12.</strong>
    </header>

    <div class="allocation-grid">
      <section class="allocation-lane contiguous">
        <div class="lane-heading">
          <span>A</span>
          <div><h4>Contiguous reservation</h4><p>Reserve all 12 token slots before generation.</p></div>
        </div>

        <div class="memory-row" aria-label="Five used slots and seven reserved unused slots">
          {Array.from({ length: 12 }, (_, index) => (
            <i class={index < 5 ? 'used' : 'reserved'}>{index < 5 ? `t${index}` : '—'}</i>
          ))}
        </div>

        <div class="allocation-result constraint-result">
          <strong>7 of 12 slots are unavailable to other requests</strong>
          <p>The unused tail is reserved even if this sequence ends at token 5.</p>
        </div>
      </section>

      <section class="allocation-lane paged">
        <div class="lane-heading">
          <span>B</span>
          <div><h4>Fixed-size block allocation</h4><p>Allocate another four-slot frame only when needed.</p></div>
        </div>

        <div class="block-row" aria-label="One full block and one partially filled block">
          <div class="memory-block">
            <span>Block 0 · full</span>
            <div>{Array.from({ length: 4 }, (_, index) => <i class="used">t{index}</i>)}</div>
          </div>
          <div class="memory-block active-block">
            <span>Block 1 · active</span>
            <div><i class="used">t4</i><i class="free">free</i><i class="free">free</i><i class="free">free</i></div>
          </div>
        </div>

        <div class="allocation-result paged-result">
          <strong>Only the final block can contain unused slots</strong>
          <p>Any other free physical frame remains available to another request.</p>
        </div>
      </section>
    </div>

    <aside class="allocation-takeaway">
      <span>What changed</span>
      <p>Paged allocation replaces one speculative maximum-length reservation with small allocations made as the sequence grows.</p>
    </aside>
  </div>
</Exhibit>

<style>
  .allocation-comparison { width: 100%; }

  .allocation-question,
  .allocation-takeaway {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1rem 0;
    border-top: 2px solid var(--ie-ink, var(--text));
    border-bottom: 1px solid var(--ie-rule-strong, var(--border-default));
  }

  .allocation-question span,
  .allocation-takeaway span,
  .lane-heading > span {
    color: var(--ie-blue, var(--accent));
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .allocation-question strong { color: var(--ie-ink, var(--text)); font-size: 1rem; font-weight: 550; }

  .allocation-grid { display: grid; grid-template-columns: 1fr 1fr; }
  .allocation-lane { padding: 1.5rem; }
  .allocation-lane:first-child { border-right: 1px solid var(--ie-rule-strong, var(--border-default)); }

  .lane-heading {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    min-height: 86px;
    border-bottom: 1px solid var(--ie-rule, var(--border-default));
  }

  .contiguous .lane-heading > span { color: var(--ie-rust, var(--signal-warm)); }
  .lane-heading h4 { margin: 0 0 0.3rem; color: var(--ie-ink, var(--text)); font-size: 1.16rem; }
  .lane-heading p, .allocation-result p, .allocation-takeaway p { margin: 0; color: var(--ie-ink-secondary, var(--text-secondary)); font-size: 0.94rem; line-height: 1.5; }

  .memory-row {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 2px;
    padding: 2rem 0;
  }

  .memory-row i,
  .memory-block i {
    display: flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--ie-rule-strong, var(--border-default));
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-style: normal;
  }

  .memory-row .used,
  .memory-block .used {
    border-color: var(--ie-blue, var(--accent));
    background: var(--ie-blue-soft, var(--accent-subtle));
    color: var(--ie-blue, var(--accent));
  }

  .memory-row .reserved {
    border-color: color-mix(in srgb, var(--ie-rust, var(--signal-warm)) 55%, var(--ie-rule));
    background: var(--ie-rust-soft, transparent);
    color: var(--ie-rust, var(--signal-warm));
  }

  .block-row {
    display: grid;
    gap: 0.7rem;
    padding: 1.25rem 0;
  }

  .memory-block > span {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--ie-muted, var(--text-muted));
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .memory-block > div { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; }
  .memory-block .free { border-style: dashed; color: var(--ie-muted, var(--text-muted)); }
  .active-block { padding-left: 2rem; }

  .allocation-result {
    min-height: 112px;
    padding-top: 1rem;
    border-top: 1px solid var(--ie-rule, var(--border-default));
  }

  .allocation-result strong { display: block; margin-bottom: 0.45rem; color: var(--ie-ink, var(--text)); font-size: 1rem; }
  .constraint-result strong { color: var(--ie-rust, var(--signal-warm)); }
  .paged-result strong { color: var(--ie-blue, var(--accent)); }

  .allocation-takeaway { border-top-width: 1px; }

  @media (max-width: 760px) {
    .allocation-question, .allocation-takeaway { grid-template-columns: 1fr; gap: 0.4rem; }
    .allocation-grid { grid-template-columns: 1fr; }
    .allocation-lane { padding: 1rem 0; }
    .allocation-lane:first-child { border-right: 0; border-bottom: 2px solid var(--ie-rule-strong, var(--border-default)); }
    .memory-row { overflow-x: auto; grid-template-columns: repeat(12, minmax(32px, 1fr)); }
  }
</style>
