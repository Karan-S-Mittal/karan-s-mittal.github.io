      flex: 1 1 calc(50% - 0.5rem);
      justify-content: center;
    }
    .story-playback-controls {
      width: 100%;
    }
    .story-play-btn {
      width: 100%;
      justify-content: center;
    }
    .three-canvas-container {
      height: 320px;
    }
    .storyline-card {
