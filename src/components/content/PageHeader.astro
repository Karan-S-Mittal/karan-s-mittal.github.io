---
interface Props {
  label: string;
  title: string;
  description?: string;
  headingLevel?: 'h1' | 'h2';
}

const { label, title, description, headingLevel = 'h1' } = Astro.props;
const Heading = headingLevel;
---

<header class="page-header">
  <p class="page-register">{label}</p>
  <Heading>{title}</Heading>
  {description && (
    <p class="lead">{description}</p>
  )}
</header>

<style>
  .page-header {
    margin-bottom: var(--space-9);
    padding: var(--space-8) 0 0;
  }
  .page-register {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--ie-type-small);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ie-muted);
  }
  .page-header :is(h1, h2) {
    font-family: var(--font-display);
    max-width: 28ch;
    font-size: var(--ie-type-h1);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.08;
    color: var(--ie-ink);
    margin-bottom: var(--space-4);
  }
  .lead {
    color: var(--ie-muted);
    max-width: 620px;
    margin: 0;
    line-height: 1.5;
    font-size: var(--ie-type-body);
  }
  @media (max-width: 640px) {
    .page-header {
      margin-bottom: var(--space-6);
    }
    .lead {
      font-size: var(--ie-type-h4);
    }
  }
</style>
