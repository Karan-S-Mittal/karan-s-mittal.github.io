---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/portfolio/PageHeader.astro';
import YearGroup from '../components/portfolio/YearGroup.astro';
import TalkCard from '../components/portfolio/TalkCard.astro';
import talksData from '../data/talks.json';
import type { Talk } from '../types/talks';

const talks: Talk[] = talksData.talks;

const sortedTalks = [...talks].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const talksByYear = sortedTalks.reduce<Record<string, Talk[]>>((acc, talk) => {
  if (!acc[talk.year]) acc[talk.year] = [];
  acc[talk.year].push(talk);
  return acc;
}, {});

const years = Object.keys(talksByYear).sort((a, b) => Number(b) - Number(a));
const allYears = [...new Set(talks.map((t) => t.year))].sort((a, b) => Number(b) - Number(a));
---

<Layout title="Talks | Karan Mittal">
  <main class="container">
    <PageHeader label="§05 Proof, in public" title="Talks & Workshops" description="Working ideas in public: architecture, AI systems, and practical learning. Recent sessions on record." />

    <div class="filters">
      <div class="search-wrap">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="talk-search"
          placeholder="Search talks..."
          aria-label="Search talks"
          autocomplete="off"
        />
      </div>

      <div class="year-filter">
        <select id="year-filter" aria-label="Filter by year">
          <option value="">All years</option>
          {allYears.map((year) => (
            <option value={year}>{year}</option>
          ))}
        </select>
      </div>
    </div>

    <p id="no-results" class="no-results" style="display: none;">No talks found.</p>

    <div class="archive-list" id="talks-timeline">
      {years.map((year) => (
        <YearGroup year={year} count={talksByYear[year].length} unit="talk">
          {talksByYear[year].map((talk) => (
            <TalkCard
              talk={talk}
              searchText={[
                talk.title,
                talk.description,
                talk.event,
                talk.org,
                talk.venue,
                talk.type,
                ...talk.tags,
              ].join(' ').toLowerCase()}
            />
          ))}
        </YearGroup>
      ))}
    </div>

    <section class="cta-section">
      <p class="cta-label">WORK IN PUBLIC</p>
      <h2>Teaching from the work.</h2>
      <p>Workshops and talks are a way to test engineering ideas in the open. For consulting enquiries, start with the system question.</p>
      <a href="/#contact" class="quiet-btn">Start a conversation</a>
    </section>
  </main>
</Layout>

<script>
  const searchInput = document.getElementById('talk-search');
  const yearSelect = document.getElementById('year-filter');
  const talks = document.querySelectorAll('.talk-card');
  const yearGroups = document.querySelectorAll('.year-group');
  const noResults = document.getElementById('no-results');

  function filterTalks() {
    const query = (searchInput as HTMLInputElement)?.value.toLowerCase().trim() || '';
    const selectedYear = (yearSelect as HTMLSelectElement)?.value || '';
    let visibleCount = 0;

    talks.forEach((talk) => {
      const text = (talk as HTMLElement).dataset.search || '';
      const year = (talk as HTMLElement).dataset.year || '';
      const matchesQuery = !query || text.includes(query);
      const matchesYear = !selectedYear || year === selectedYear;
      const match = matchesQuery && matchesYear;
      (talk as HTMLElement).style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });

    yearGroups.forEach((group) => {
      const visibleTalks = group.querySelectorAll('.talk-card');
      let hasVisible = false;
      visibleTalks.forEach((t) => {
        if ((t as HTMLElement).style.display !== 'none') hasVisible = true;
      });
      (group as HTMLElement).style.display = hasVisible ? '' : 'none';
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  searchInput?.addEventListener('input', filterTalks);
  yearSelect?.addEventListener('change', filterTalks);
</script>

<style>
  main.container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 var(--space-5) var(--space-9);
  }

  .filters {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
    flex-wrap: wrap;
  }
  .filters .search-wrap {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 200px;
    max-width: 360px;
  }
  .search-icon {
    position: absolute;
    left: 0.85rem;
    color: var(--muted);
    pointer-events: none;
  }
  .filters .search-wrap input {
    width: 100%;
    padding: 0.6rem 1rem 0.6rem 2.5rem;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--text);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .filters .search-wrap input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.15);
  }

  .year-filter select {
    padding: 0.6rem 1.25rem;
    font-size: var(--text-sm);
    font-family: var(--font-sans);
    color: var(--text);
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    outline: none;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition-fast);
  }
  .year-filter select:focus {
    border-color: var(--accent);
  }

  .no-results {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
    padding: var(--space-6) 0;
  }

  .cta-section {
    margin-top: var(--space-9);
    padding: var(--space-8) var(--space-7);
    border-radius: var(--radius-card);
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    box-shadow: var(--shadow-card);
    text-align: left;
  }
  .cta-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }
  .cta-section h2 {
    font-family: var(--font-serif);
    margin-top: 0;
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    font-weight: 500;
    margin-bottom: var(--space-2);
    color: var(--text);
  }
  .cta-section p:not(.cta-label) {
    color: var(--text-secondary);
    margin-bottom: var(--space-5);
    max-width: 540px;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .quiet-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: var(--ink-900);
    color: #ffffff !important;
    font-size: var(--text-sm);
    font-weight: 500;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }
  .quiet-btn:hover {
    background: #000;
    transform: translateY(-1px);
    text-decoration: none;
  }
  html.dark .quiet-btn {
    background: var(--accent);
    color: #fff !important;
  }

  @media (max-width: 768px) {
    main.container {
      padding: 0 var(--space-4) var(--space-8);
    }
    .filters {
      flex-direction: column;
      align-items: stretch;
    }
    .filters .search-wrap {
      max-width: none;
    }
    .cta-section {
      padding: var(--space-6) var(--space-5);
    }
  }
</style>
