---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import MetaLabel from '../components/MetaLabel.astro';
import Button from '../components/Button.astro';
import Exhibit from '../components/Exhibit.astro';
import EvidenceObject from '../components/EvidenceObject.astro';
import DarkPlane from '../components/DarkPlane.astro';
import TintedPlane from '../components/TintedPlane.astro';
import workData from '../data/work.json';
import talksData from '../data/talks.json';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const featuredWork = workData.work.slice(0, 3);
const recentTalks = [...talksData.talks]
  .sort((a, b) => (a.date < b.date ? 1 : -1))
  .slice(0, 3);
const talkCount = talksData.talks.length;

function formatDate(date: Date | string) {
  const d = typeof date === 'string' ? new Date(date) : date;
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

const capabilities = [
  {
    index: '01',
    label: 'Knowledge systems',
    distillation: 'Deterministic retrieval layers that make every answer attributable to a source.',
    primitive: 'graph',
  },
  {
    index: '02',
    label: 'Performance / Inference',
    distillation: 'The path between model and user experience, engineered against latency, cost, and hardware limits.',
    primitive: 'pipeline',
  },
  {
    index: '03',
    label: 'Infrastructure',
    distillation: 'Cloud-native foundations that survive handover and stay observable in production.',
    primitive: 'plane',
  },
  {
    index: '04',
    label: 'Technical leadership',
    distillation: 'Turning unclear problems into boundaries, assumptions, and plans a team can own.',
    primitive: 'decision',
  },
];
---

<Layout
  title="Karan Mittal | Deterministic Engineering"
  description="Karan Mittal turns ambiguous AI problems into deterministic systems - knowledge architecture, inference engineering, and technical leadership."
>
  <main>
    <!-- HERO — QUIET (spec §7/§23.1/§35) -->
    <section class="hero" aria-labelledby="home-title">
      <svg class="hero-topology" viewBox="0 0 520 300" aria-hidden="true">
        <circle cx="60" cy="60" r="3" />
        <circle cx="150" cy="120" r="3" />
        <circle cx="70" cy="200" r="3" />
        <line x1="66" y1="64" x2="144" y2="116" class="ht-dashed" />
        <line x1="76" y1="196" x2="146" y2="126" class="ht-dashed" />
        <circle cx="260" cy="90" r="4" />
        <line x1="156" y1="118" x2="250" y2="94" class="ht-dashed" />
        <line x1="264" y1="98" x2="330" y2="180" class="ht-solid" />
        <circle cx="340" cy="190" r="4" />
        <line x1="348" y1="186" x2="430" y2="110" class="ht-solid" />
        <circle class="ht-attention" cx="440" cy="100" r="4.5" />
        <line x1="346" y1="196" x2="420" y2="248" class="ht-dashed" />
        <circle cx="430" cy="252" r="3" />
      </svg>

      <div class="hero-inner">
        <p class="label">Karan Mittal &middot; AI systems architect</p>
        <h1 id="home-title">I turn ambiguous AI problems into deterministic&nbsp;systems.</h1>
        <p class="hero-support">
          Knowledge systems, inference engineering, infrastructure, and technical leadership
          &mdash; rendered into clarity through gentle, precise structure.
        </p>
        <div class="hero-actions">
          <Button href="/work">See the systems</Button>
          <Button href="/contact" variant="secondary">Start a project</Button>
        </div>
      </div>
    </section>

    <div class="home-body">
      <!-- CAPABILITIES — MODERATE (spec §23.2) -->
      <section class="home-section" aria-labelledby="capabilities-heading">
        <MetaLabel index="01" label="Capabilities" />
        <h2 id="capabilities-heading" class="visually-hidden">Capabilities</h2>
        <div class="capability-grid">
          {capabilities.map((cap) => (
            <div class="capability-plane">
              <p class="cap-index">{cap.index}</p>
              <h3>{cap.label}</h3>
              <p class="cap-distillation">{cap.distillation}</p>
              <svg class="cap-primitive" viewBox="0 0 96 20" aria-hidden="true">
                {cap.primitive === 'graph' && (
                  <g>
                    <circle cx="10" cy="10" r="3" /><circle cx="48" cy="4" r="3" /><circle cx="48" cy="16" r="3" /><circle cx="86" cy="10" r="3" />
                    <line x1="13" y1="9" x2="44" y2="5" /><line x1="13" y1="11" x2="44" y2="15" />
                    <line x1="52" y1="5" x2="82" y2="9" class="cp-dashed" /><line x1="52" y1="15" x2="82" y2="11" class="cp-dashed" />
                  </g>
                )}
                {cap.primitive === 'pipeline' && (
                  <g>
                    <circle cx="8" cy="10" r="3" /><line x1="12" y1="10" x2="38" y2="10" />
                    <rect x="40" y="3" width="18" height="14" rx="3" class="cp-node" />
                    <line x1="60" y1="10" x2="84" y2="10" /><circle cx="88" cy="10" r="3" />
                  </g>
                )}
                {cap.primitive === 'plane' && (
                  <g>
                    <rect x="6" y="2" width="56" height="16" rx="4" class="cp-plane" />
                    <circle cx="22" cy="10" r="3" /><line x1="27" y1="10" x2="43" y2="10" class="cp-dashed" /><circle cx="47" cy="10" r="3" />
                    <line x1="66" y1="10" x2="84" y2="10" class="cp-dashed" />
                  </g>
                )}
                {cap.primitive === 'decision' && (
                  <g>
                    <circle cx="10" cy="10" r="3" /><line x1="14" y1="10" x2="36" y2="10" />
                    <circle cx="44" cy="10" r="4" class="cp-attention" />
                    <line x1="50" y1="10" x2="84" y2="10" class="cp-dashed" /><circle cx="88" cy="10" r="3" />
                  </g>
                )}
              </svg>
            </div>
          ))}
        </div>
      </section>

      <!-- SELECTED SYSTEM — DENSE (spec §23.3) -->
      <section class="home-section" aria-labelledby="system-heading">
        <MetaLabel index="02" label="Selected system" />
        <div class="system-intro">
          <h2 id="system-heading">Serving LLMs without wasting memory</h2>
          <p>
            From the essay on PagedAttention: contiguous allocation wastes most of a GPU's
            KV-cache capacity. Paging it &mdash; the way operating systems page virtual memory
            &mdash; is what makes high-throughput serving possible.
          </p>
        </div>
        <Exhibit
          exhibit="00"
          title="Virtual KV blocks map to scattered physical pages"
          badge="SYSTEM MAP"
          caption="The block table is the only contiguous structure. Physical frames fill on demand; internal fragmentation is bounded by the page size instead of the generation length."
        >
          <svg class="sys-diagram" viewBox="0 0 900 260" role="img" aria-label="A block table maps virtual token blocks to scattered physical GPU memory pages shared across sequences">
            <defs>
              <marker id="home-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
                <path d="M0,0 L8,4 L0,8 Z" fill="var(--diagram-edge-primary)" />
              </marker>
            </defs>
            <g class="plane">
              <rect x="30" y="30" width="380" height="200" rx="8" />
              <text class="label-signal" x="54" y="58">LOGICAL / SEQUENCE</text>
              <rect class="node node-signal" x="54" y="80" width="100" height="48" rx="6" />
              <text class="body" x="72" y="108">blk 0</text>
              <rect class="node node-signal" x="170" y="80" width="100" height="48" rx="6" />
              <text class="body" x="188" y="108">blk 1</text>
              <rect class="node node-signal" x="286" y="80" width="100" height="48" rx="6" />
              <text class="body" x="304" y="108">blk 2</text>
              <path class="flow flow-dashed" d="M104 128 V176 H304 V128" />
              <text class="label" x="130" y="200">block table &mdash; the only contiguous structure</text>
            </g>
            <path class="flow flow-signal" d="M410 130 H480" marker-end="url(#home-arrow)" />
            <g class="plane">
              <rect x="490" y="30" width="380" height="200" rx="8" />
              <text class="label-signal" x="514" y="58">PHYSICAL / GPU HBM</text>
              <rect class="node node-signal" x="514" y="76" width="104" height="44" rx="6" />
              <text class="body" x="532" y="102">page 7</text>
              <rect class="node" x="646" y="76" width="104" height="44" rx="6" />
              <text class="body-muted" x="664" y="102">free</text>
              <rect class="node node-signal" x="752" y="76" width="94" height="44" rx="6" />
              <text class="body" x="768" y="102">page 11</text>
              <rect class="node node-signal" x="514" y="140" width="104" height="44" rx="6" />
              <text class="body" x="532" y="166">page 2</text>
              <rect class="node" x="646" y="140" width="104" height="44" rx="6" />
              <text class="body-muted" x="664" y="166">free</text>
              <rect class="node node-attention" x="752" y="140" width="94" height="44" rx="6" />
              <text class="label" x="766" y="166" style="fill: var(--ink-900)">copy-on-write</text>
              <text class="label" x="514" y="212">frames allocated on demand &middot; waste bounded by page size</text>
            </g>
          </svg>
        </Exhibit>
        <p class="system-link-row"><a href="/blog/paged-attention-kv-cache/">Read the full breakdown &rarr;</a></p>
      </section>

      <!-- STATEMENT — quiet tinted plane (spec §24 TintedPlane) -->
      <section class="home-section" aria-label="Working principle">
        <TintedPlane label="How I work">
          <h2>Ambiguity &rarr; structure &rarr; system &rarr; evidence.</h2>
          <p>
            Every engagement follows the same transformation: an unclear problem,
            a boundary drawn around it, a mechanism that makes it deterministic,
            and the measurements that prove it works.
          </p>
        </TintedPlane>
      </section>
      <section class="home-section" aria-labelledby="evidence-heading">
        <MetaLabel index="03" label="Evidence" />
        <h2 id="evidence-heading" class="visually-hidden">Evidence</h2>
        <div class="evidence-grid">
          <EvidenceObject index="01" label="Writing" metric="5 deep dives" method="Long-form engineering essays" outcome="Primary citations, working diagrams, no hype" />
          <EvidenceObject index="02" label="Teaching" metric={String(talkCount) + ' sessions'} method="Workshops & conference talks" outcome="RAG, GraphRAG, LLMOps taught hands-on" />
          <EvidenceObject index="03" label="Decision">
            <p>RAG &darr; GraphRAG</p>
            <p><strong>Why</strong> &mdash; cross-document relationships were part of the question.</p>
          </EvidenceObject>
        </div>
      </section>

      <!-- SELECTED WORK (spec §23.4) -->
      <section class="home-section" aria-labelledby="work-heading">
        <div class="section-heading">
          <MetaLabel index="04" label="Selected work" />
          <a href="/work" class="section-more">All work &rarr;</a>
        </div>
        <h2 id="work-heading" class="visually-hidden">Selected work</h2>
        <div class="work-list">
          {featuredWork.map((item, i) => (
            <a href="/work" class="work-row">
              <span class="work-index">{String(i + 1).padStart(2, '0')}</span>
              <span class="work-body">
                <span class="work-title">{item.title}</span>
                <span class="work-summary">{item.summary}</span>
              </span>
              <span class="row-arrow" aria-hidden="true">&rarr;</span>
            </a>
          ))}
        </div>
      </section>

      <!-- WRITING (spec §23.5) -->
      <section class="home-section" aria-labelledby="essays-heading">
        <div class="section-heading">
          <MetaLabel index="05" label="Writing" />
          <a href="/blog" class="section-more">All essays &rarr;</a>
        </div>
        <h2 id="essays-heading" class="visually-hidden">Writing</h2>
        <div class="writing-list">
          {posts.map(post => (
            <a href={`/blog/${post.id}/`} class="writing-row">
              <time class="writing-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              <span class="writing-body">
                <span class="writing-title">{post.data.title}</span>
                <span class="writing-desc">{post.data.description}</span>
              </span>
              <span class="row-arrow" aria-hidden="true">&#8599;</span>
            </a>
          ))}
        </div>
      </section>

      <!-- SPEAKING (spec §23.6) -->
      <section class="home-section" aria-labelledby="speaking-heading">
        <div class="section-heading">
          <MetaLabel index="06" label="Speaking" />
          <a href="/talks" class="section-more">All talks &rarr;</a>
        </div>
        <h2 id="speaking-heading" class="visually-hidden">Speaking</h2>
        <div class="public-list">
          {recentTalks.map(talk => (
            <a href={talk.links[0]?.url ?? '/talks'} class="public-row" target={talk.links[0] ? '_blank' : undefined} rel={talk.links[0] ? 'noopener' : undefined}>
              <span class="public-label">{talk.title}</span>
              <span class="public-meta">{talk.event} &middot; {formatDate(talk.date)} &rarr;</span>
            </a>
          ))}
        </div>
      </section>

      <!-- CONTACT — DARK CONCLUSION PLANE (spec §23.7/§8.4) -->
      <DarkPlane id="contact">
        <h2>Start a project</h2>
        <p>Bringing an ambiguous AI or data problem into focus? The fastest path is a direct conversation about constraints, evidence, and the system that has to exist.</p>
        <div class="contact-actions">
          <Button href="mailto:karanshyammittal@gmail.com">Email Karan</Button>
          <Button href="/about" variant="secondary">Background &amp; community</Button>
        </div>
      </DarkPlane>
    </div>
  </main>
</Layout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    margin: -1px; padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---- Hero: quiet, topology secondary to type (§35) ---- */
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border-subtle);
    /* Canvas-blue ambience (spec §3.1) — the soft light comes from the top right */
    background:
      radial-gradient(circle at 85% 8%, var(--blue-100), transparent 58%),
      var(--surface-page);
  }
  .hero-topology {
    position: absolute;
    top: 0;
    right: 0;
    width: min(46vw, 540px);
    opacity: 0.32;
    pointer-events: none;
  }
  .hero-topology circle { fill: var(--diagram-node-primary); }
  .hero-topology circle.ht-attention { fill: var(--diagram-node-attention); }
  .hero-topology .ht-solid { stroke: var(--diagram-edge-primary); stroke-width: 1.5; }
  .hero-topology .ht-dashed { stroke: var(--diagram-edge-secondary); stroke-width: 1.5; stroke-dasharray: 4 5; }

  .hero-inner {
    position: relative;
    max-width: var(--page-max-width);
    margin: 0 auto;
    padding: var(--space-9) var(--space-5) var(--space-8);
  }
  .hero-inner h1 {
    max-width: 15ch;
    margin-bottom: var(--space-5);
    font-size: clamp(2.75rem, 5.5vw, 4rem); /* Display tier, spec §4.2 */
  }
  .hero-support {
    max-width: 560px;
    margin: 0 0 var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .home-body {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-5) var(--space-8);
  }

  /* ---- Sections ---- */
  .home-section { padding: var(--space-8) 0 0; }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .section-more {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-decoration: none;
  }
  .section-more:hover { color: var(--accent); text-decoration: none; }

  /* ---- Capabilities: four planes, not a keyword wall (§23.2) ---- */
  .capability-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-5);
  }
  .capability-plane {
    padding: var(--space-5);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--blue-100) 38%, var(--surface-card)),
      var(--surface-card) 70%
    );
    border: 1px solid color-mix(in srgb, var(--blue-300) 45%, var(--border-default));
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }
  .cap-index {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--interactive-primary);
  }
  .capability-plane h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
    line-height: 1.25;
  }
  .cap-distillation {
    margin: 0 0 var(--space-4);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .cap-primitive { display: block; width: 96px; height: 20px; opacity: 0.85; }
  .cap-primitive circle { fill: var(--diagram-node-primary); }
  .cap-primitive .cp-attention { fill: var(--diagram-node-attention); }
  .cap-primitive line { stroke: var(--diagram-edge-primary); stroke-width: 1.5; }
  .cap-primitive .cp-dashed { stroke: var(--diagram-edge-secondary); stroke-dasharray: 3 4; }
  .cap-primitive .cp-node { fill: var(--surface-subtle); stroke: var(--diagram-edge-primary); stroke-width: 1.5; }
  .cap-primitive .cp-plane { fill: var(--diagram-plane); stroke: var(--border-muted); stroke-width: 1; }

  /* ---- Selected system: intentionally denser (§23.3) ---- */
  .system-intro { max-width: var(--width-reading); margin-top: var(--space-5); }
  .system-intro h2 { margin-bottom: var(--space-2); }
  .system-intro p { color: var(--text-secondary); }
  .system-link-row { margin-top: var(--space-3); }

  .sys-diagram .plane > rect {
    fill: var(--surface-card);
    stroke: var(--border-default);
    stroke-width: 1;
  }
  .sys-diagram .node { fill: var(--surface-card); stroke: var(--ink-900); stroke-width: 1.8; }
  .sys-diagram .node-signal { fill: var(--blue-100); stroke: var(--blue-500); stroke-width: 1.8; }
  .sys-diagram .node-attention { fill: var(--pink-300); stroke: var(--pink-400); stroke-width: 1.8; }
  .sys-diagram .flow { fill: none; stroke: var(--ink-900); stroke-width: 1.8; }
  .sys-diagram .flow-signal { stroke: var(--blue-500); stroke-width: 2.2; }
  .sys-diagram .flow-dashed { stroke: var(--lavender-400); stroke-width: 1.8; stroke-dasharray: 4 4; }
  .sys-diagram text.label { fill: var(--muted); font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.05em; }
  .sys-diagram text.label-signal { fill: var(--blue-600); font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.05em; }
  .sys-diagram text.body { fill: var(--ink-900); font-family: var(--font-sans); font-size: 14px; }
  .sys-diagram text.body-muted { fill: var(--muted); font-family: var(--font-sans); font-size: 14px; }

  /* ---- Evidence ---- */
  .evidence-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  /* ---- Ruled rows: Material-3 style state layers ---- */
  .work-list, .writing-list, .public-list {
    border-top: 1px solid var(--border);
    margin-top: var(--space-5);
  }
  .work-row, .writing-row, .public-row {
    border-radius: var(--radius);
    transition:
      background-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }
  /* State layer: ~8% blue wash, pointer only — no sticky hover on touch */
  @media (hover: hover) {
    .work-row:hover, .writing-row:hover, .public-row:hover {
      background: color-mix(in srgb, var(--blue-100) 45%, transparent);
      text-decoration: none;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
    }
  }
  .work-row:hover .work-title, .writing-row:hover .writing-title, .public-row:hover .public-label {
    color: var(--accent);
  }

  /* ---- Work rows ---- */
  .work-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }
  .work-index { color: var(--accent); font-family: var(--font-mono); font-size: var(--text-xs); }
  .work-body { display: grid; gap: var(--space-1); }
  .work-title {
    color: var(--text);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
    transition: color var(--transition-fast);
  }
  .work-summary { color: var(--muted); font-size: var(--text-sm); line-height: 1.5; }

  /* ---- Writing rows ---- */
  .writing-row {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }
  .writing-date { color: var(--muted); font-family: var(--font-mono); font-size: var(--text-xs); }
  .writing-body { display: grid; gap: var(--space-1); }
  .writing-title {
    color: var(--text);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
    transition: color var(--transition-fast);
  }
  .writing-desc { color: var(--muted); font-size: var(--text-sm); line-height: 1.5; }
  .row-arrow { color: var(--muted); }

  /* ---- Speaking rows ---- */
  .public-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }
  .public-label {
    color: var(--text);
    font-weight: 500;
    transition: color var(--transition-fast);
  }
  .public-meta {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  /* ---- Contact ---- */
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  @media (max-width: 720px) {
    .hero-inner { padding: var(--space-8) var(--space-4) var(--space-7); }
    .hero-topology { opacity: 0.22; width: 72vw; }
