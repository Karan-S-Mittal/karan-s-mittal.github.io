---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';
import VisualMicroSchematic from '@components/visuals/VisualMicroSchematic.astro';
import HeroWorkflowGraph from '@components/visuals/HeroWorkflowGraph.astro';
import '@styles/practice.css';

const publishedPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPosts = [...publishedPosts.filter(p => p.data.featured), ...publishedPosts.filter(p => !p.data.featured)].slice(0, 3);
const formatDate = (date: Date | string) => new Date(date).toLocaleDateString('en-GB', {day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC'});

const featuredBlueprints = [
  {
    slug: 'claude-code-loop',
    title: 'Agent Execution Loop',
    desc: 'Interactive CLI shell, tool dispatch, and permission gates that keep agents deterministic.',
    badge: 'AGENT WORKFLOW'
  },
  {
    slug: 'deterministic-rag',
    title: 'Zero-Hallucination Retrieval',
    desc: 'Hybrid dense/sparse search, immutable hashes, and deterministic replay audit bundles.',
    badge: 'VERIFIED DATA'
  },
  {
    slug: 'coding-agent',
    title: 'Cognitive Router & Tools',
    desc: '3-tier orchestration: planner decomposition, tool routing, and sandboxed bash execution.',
    badge: 'MLOPS ARCHITECTURE'
  }
];
---

<Layout title={SITE.title} description={SITE.description}>
  <main class="practice-page">
    <!-- Centered Hero -->
    <section class="hero hero-centric" aria-labelledby="home-title">
      <div class="hero-content">
        <span class="register">Karan Mittal &bull; Systems Engineering &amp; MLOps</span>
        <h1 id="home-title">Solve the real problem.<br />Build a system that lasts.</h1>
        <p class="lead">
          I help engineering teams turn unpredictable LLM prototypes into reliable, cost-efficient production systems—through state-graph workflows, smart model routing, and automated evaluation.
        </p>
        <div class="actions">
          <a class="action" href="/contact">Discuss your system →</a>
          <a class="action secondary" href="/visuals">Explore architecture blueprints →</a>
        </div>
      </div>
      <HeroWorkflowGraph />
    </section>

    <!-- 3 Core Pillars -->
    <ul class="problem-list" aria-label="Problems I help solve">
      <li>
        <span class="problem-num">01 / AGENT WORKFLOWS &amp; STATE GRAPHS</span>
        <strong>Get models to follow instructions.</strong>
        Replace fragile single-prompt chains with structured state graphs, tool sandboxes, and schema validation. Ensure agents reliably complete multi-step tasks without getting stuck in infinite loops.
      </li>
      <li>
        <span class="problem-num">02 / MLOPS &amp; COST OPTIMIZATION</span>
        <strong>Stop overpaying for tokens.</strong>
        Architect tiered model routing, semantic caching, and prompt compaction. Run 90% of routine traffic on fast, inexpensive models to cut monthly API spend by up to 70%.
      </li>
      <li>
        <span class="problem-num">03 / CONTINUOUS EVAL HARNESS</span>
        <strong>Ship model updates safely.</strong>
        Build automated regression test suites and policy gates into CI/CD. Test prompt adjustments and new model releases against benchmark datasets before they touch customers.
      </li>
    </ul>

    <!-- Section 01: Featured Architecture Blueprints -->
    <section class="section" aria-labelledby="blueprints-heading">
      <div class="section-head">
        <div>
          <span class="register">01 / Verified blueprints</span>
          <h2 id="blueprints-heading">Architectures you can inspect.</h2>
        </div>
        <a href="/visuals">View all 11 blueprints →</a>
      </div>
      <div class="featured-blueprints-grid">
        {featuredBlueprints.map(bp => (
          <a href={`/visuals/${bp.slug}/`} class="blueprint-showcase-card">
            <VisualMicroSchematic slug={bp.slug} />
            <div class="blueprint-card-info">
              <span class="register">{bp.badge}</span>
              <h3>{bp.title}</h3>
              <p>{bp.desc}</p>
              <span class="blueprint-card-cta">Inspect blueprint &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Section 02: Selected Writing -->
    <section class="section" aria-labelledby="writing-heading">
      <div class="section-head">
        <div>
          <span class="register">02 / Selected writing</span>
          <h2 id="writing-heading">How I work through complex systems.</h2>
        </div>
        <a href="/blog">All {publishedPosts.length} essays →</a>
      </div>
      {featuredPosts.map(post => (
        <a class="note-row" href={`/blog/${post.id}/`}>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
        </a>
      ))}
    </section>

    <!-- Centered Closing -->
    <section class="closing centered-closing" aria-labelledby="closing-heading">
      <span class="register">03 / Start a conversation</span>
      <h2 id="closing-heading">Have an AI system that needs to work better?</h2>
      <p class="lead">Whether you are struggling with agent reliability, runaway API bills, or scaling your evaluation pipeline, let’s talk through the engineering.</p>
      <div class="actions">
        <a href="/contact" class="action">Tell me what needs to work better →</a>
        <a href="/work" class="action secondary">Explore advisory &amp; build options →</a>
      </div>
    </section>
  </main>
</Layout>
