---
interface Props {
  id: string;
  index: string;
  title: string;
  description: string;
  source?: string;
  status?: 'live' | 'candidate' | 'compatibility';
  flush?: boolean;
}

const {
  id,
  index,
  title,
  description,
  source,
  status = 'live',
  flush = false,
} = Astro.props;
---

<section class:list={['component-specimen', { flush }]} id={id}>
  <header class="specimen-header">
    <div class="specimen-title-group">
      <span class:list={['specimen-status', `status-${status}`]} aria-hidden="true"></span>
      <span class="specimen-index">{index}</span>
      <div>
        <h2>{title}</h2>
        <p>{description}</p>
      </div>
    </div>
    <div class="specimen-meta">
      <span>{status}</span>
      {source && <code>{source}</code>}
    </div>
  </header>
  <div class="specimen-stage">
    <slot />
  </div>
</section>

<style>
  .component-specimen {
    scroll-margin-top: 8rem;
    overflow: hidden;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    border-radius: var(--showroom-radius, var(--panel-radius));
    box-shadow: var(--panel-shadow);
  }
  .specimen-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-5);
    padding: var(--space-4) var(--space-5);
    background: var(--panel-header-bg);
    border-bottom: 1px solid var(--panel-border);
  }
  .specimen-title-group {
    display: grid;
    grid-template-columns: 6px auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-2);
    min-width: 0;
  }
  .specimen-status {
    width: 6px;
    height: 6px;
    margin-top: 0.55rem;
    border-radius: 50%;
    background: var(--ie-blue);
  }
  .status-candidate { background: var(--signal-warm); }
  .status-compatibility { background: var(--muted); }
  .specimen-index {
    padding-top: 0.22rem;
    color: var(--muted);
    font: 600 0.68rem/1.4 var(--font-mono);
  }
  h2 { margin: 0; font-size: var(--ie-type-body); letter-spacing: -0.015em; line-height: 1.3; }
  .specimen-title-group p {
    max-width: 620px;
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: var(--ie-type-ui);
    line-height: 1.55;
  }
  .specimen-meta {
    display: flex;
    flex: 0 0 auto;
    align-items: baseline;
    gap: var(--space-3);
    padding-top: 0.3rem;
  }
  .specimen-meta span {
    color: var(--muted);
    font: 500 0.62rem/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .specimen-meta code {
    max-width: 260px;
    overflow: hidden;
    padding: 0;
    color: var(--muted);
    background: transparent;
    border-radius: 0;
    font: 400 0.68rem/1 var(--font-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .specimen-stage { min-width: 0; padding: var(--space-6); }
  .flush .specimen-stage { padding: 0; }
  @media (max-width: 680px) {
    .specimen-header { flex-direction: column; gap: var(--space-2); }
    .specimen-meta { flex-wrap: wrap; padding-top: 0; padding-left: 1.35rem; }
    .specimen-stage { padding: var(--space-4); }
  }
  @container (max-width: 680px) {
    .specimen-header { flex-direction: column; gap: var(--space-2); }
    .specimen-meta { flex-wrap: wrap; padding-top: 0; padding-left: 1.35rem; }
    .specimen-stage { padding: var(--space-4); }
  }
</style>
