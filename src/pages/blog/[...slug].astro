---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import TableOfContents from '@components/layout/TableOfContents.astro';
import { getReadingTime } from '@utils/readingTime';
import { tagSlug } from '@utils/tags.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;
const post = Astro.props;
const { Content, headings } = await render(post);

const tocHeadings = headings
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({ ...h, text: h.text.replace(/\s*#\s*$/, '') }));
const showToc = tocHeadings.length > 2;

const readingTime = getReadingTime(post.body);

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={`${post.data.title} | Karan Mittal`}
  description={post.data.description}
  type="article"
  pubDate={post.data.pubDate}
  image={
    post.data.image
      ? new URL(post.data.image, Astro.site).toString()
      : undefined
  }
>
  <main class="container post-layout instrumented-essay">
    <article class="post-content">
      <header class="post-header">
        <div class="article-sequence" aria-label="Article explanatory sequence">
          <span class="sequence-label">Explanatory sequence</span>
          <ol>
            <li>Premise</li>
            <li>Mechanism</li>
            <li class="sequence-constraint">Constraint</li>
            <li>Evidence</li>
            <li>Decision</li>
          </ol>
        </div>

        <div class="post-header-copy">
          {post.data.tags.length > 0 && (
            <p class="post-eyebrow">Systems Explainer <span aria-hidden="true">/</span> {post.data.tags[0]}</p>
          )}
          <div class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
            <span aria-hidden="true" class="meta-sep">·</span>
            <span>{readingTime} min read</span>
            {post.data.updatedDate && (
              <>
                <span aria-hidden="true" class="meta-sep">·</span>
                <span class="updated">
                  Updated {post.data.updatedDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                </span>
              </>
            )}
          </div>

          {post.data.titleHtml ? (
            <h1 set:html={post.data.titleHtml} />
          ) : (
            <h1>{post.data.title}</h1>
          )}

          {post.data.description && <p class="post-standfirst">{post.data.description}</p>}

          {post.data.tags.length > 0 && (
            <div class="post-tags">
              {post.data.tags.map((tag) => (
                <a href={`/tags/${tagSlug(tag)}/`} class="tag">{tag}</a>
              ))}
            </div>
          )}
        </div>

        {post.data.image && (
          <figure class="post-hero-figure">
            <a
              class="post-hero-media"
              href={post.data.image}
              target="_blank"
              rel="noopener"
              aria-label={`Open full-size figure: ${post.data.heroCaption || post.data.title}`}
            >
              <img
                src={post.data.image}
                alt={post.data.heroCaption || post.data.title}
                width="1920"
                height="1072"
                class="post-hero-img"
                loading="eager"
                decoding="async"
              />
            </a>
            {post.data.heroCaption && (
              <figcaption class="post-hero-caption">
                <span class="caption-marker">FIG 00</span>
                <span>{post.data.heroCaption}</span>
                <span class="post-hero-hint" aria-hidden="true">Open full-size ↗</span>
              </figcaption>
            )}
          </figure>
        )}
      </header>

      {showToc && (
        <details class="post-mobile-toc">
          <summary>
            <span>Article contents</span>
            <span class="post-mobile-toc-count">{tocHeadings.length} sections</span>
          </summary>
          <div class="post-mobile-toc-panel">
            <TableOfContents headings={tocHeadings} idPrefix="mobile-toc" />
          </div>
        </details>
      )}

      <Content />

      <footer class="post-footer">
        <p class="back-link">
          <a href="/blog">← All posts</a>
        </p>
      </footer>
    </article>

    {showToc && (
      <aside class="post-sidebar">
        <TableOfContents headings={tocHeadings} idPrefix="desktop-toc" />
      </aside>
    )}
  </main>
</Layout>

<style>
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, var(--width-content)) 240px;
    gap: var(--space-6);
    max-width: 1280px;
    align-items: start;
  }
  .post-content {
    min-width: 0;
    max-width: none;
  }
  .post-sidebar {
    position: sticky;
    top: 5rem;
    align-self: start;
  }
  .post-mobile-toc {
    display: none;
  }

  .post-header,
  .post-footer {
    max-width: var(--prose-max-width);
  }

  .post-header-copy {
    max-width: var(--prose-max-width);
  }

  .post-header {
    position: relative;
    padding: clamp(2.5rem, 7vw, 5.5rem) 0 2.5rem;
    margin-bottom: 3.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--blue-300) 40%, var(--neutral-150));
    /* Faint canvas-blue ambience behind the title block */
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--blue-100) 40%, transparent),
      transparent 80%
    );
  }
  .post-memory-module {
    position: absolute;
    top: 1.25rem;
    right: -4rem;
    width: clamp(4.5rem, 7vw, 6rem);
    height: auto;
    pointer-events: none;
    user-select: none;
  }
  .post-eyebrow {
    margin: 0 0 1rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label, 0.72rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .post-eyebrow span {
    color: var(--border);
    padding: 0 0.35rem;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label, 0.72rem);
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .meta-sep {
    color: var(--border);
  }
  .updated {
    color: var(--accent);
  }

  .post-header h1 {
    max-width: 18ch;
    margin: 0.75rem 0 1.25rem;
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--text);
  }

  .post-standfirst {
    max-width: 61ch;
    margin: 0;
    color: var(--text-secondary);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.65;
  }

  .post-tags {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
    font-family: var(--font-mono);
  }

  .post-footer {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
  }
  .back-link {
    margin: 0;
  }
  .back-link a {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .instrumented-essay.post-layout {
    grid-template-columns: minmax(0, 1fr) 232px;
    gap: 2.5rem;
    max-width: 1280px;
    padding-inline: 1.5rem;
  }

  .instrumented-essay .post-header {
    max-width: 1040px;
    margin-bottom: 4.5rem;
    padding: 3.5rem 0 2rem;
    border-bottom: 1px solid var(--ie-rule-strong);
    background: transparent;
  }

  .instrumented-essay .post-header-copy {
    max-width: 760px;
  }

  .article-sequence {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 1.25rem;
    align-items: center;
    margin-bottom: 3.5rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--ie-rule-strong);
    border-bottom: 1px solid var(--ie-rule);
  }

  .sequence-label {
    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .article-sequence ol {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-sequence li {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ie-ink-secondary);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label);
  }

  .article-sequence li:not(:last-child)::after {
    content: '→';
    color: var(--ie-rule-strong);
  }

  .article-sequence .sequence-constraint {
    color: var(--ie-rust);
  }

  .instrumented-essay .post-eyebrow {
    margin-bottom: 1.25rem;
    color: var(--ie-blue);
    font-size: var(--ie-type-label);
  }

  .instrumented-essay .post-meta {
    margin-bottom: 1.25rem;
    color: var(--ie-muted);
    font-size: var(--ie-type-label);
  }

  .instrumented-essay .post-header h1 {
    max-width: 16ch;
    margin: 0 0 1.35rem;
    color: var(--ie-ink);
    font-family: var(--font-serif);
    font-size: clamp(3rem, 6.4vw, 5.6rem);
    font-weight: 500;
    line-height: 0.98;
  }

  .instrumented-essay .post-standfirst {
    max-width: 62ch;
    color: var(--ie-ink-secondary);
    font-size: 1.25rem;
  }

  .instrumented-essay .post-tags {
    gap: 0.9rem;
    margin-top: 1.5rem;
  }

  .instrumented-essay .post-tags .tag {
    padding: 0 0 0.15rem;
    border: 0;
    border-bottom: 1px solid var(--ie-rule-strong);
    border-radius: 0;
    background: transparent;
    color: var(--ie-muted);
    font-size: var(--ie-type-label);
  }

  .instrumented-essay .post-hero-figure {
    max-width: 1040px;
    margin: 3rem 0 0;
  }

  @media (max-width: 1100px) {
    .post-layout {
      grid-template-columns: 1fr;
      max-width: var(--width-content);
    }
    .post-sidebar {
      display: none;
    }
    .post-mobile-toc {
      display: block;
      max-width: var(--prose-max-width);
      margin: -1rem 0 3rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface-card);
    }
    .post-mobile-toc summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding: var(--space-3) var(--space-4);
      color: var(--text);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      list-style: none;
    }
    .post-mobile-toc summary::-webkit-details-marker { display: none; }
    .post-mobile-toc summary::after {
      content: '+';
      color: var(--accent);
      font-size: var(--text-base);
    }
    .post-mobile-toc[open] summary::after { content: '\2212'; }
    .post-mobile-toc-count {
      margin-left: auto;
      color: var(--muted);
      font-weight: 400;
      letter-spacing: 0;
      text-transform: none;
    }
    .post-mobile-toc-panel {
      padding: 0 var(--space-3) var(--space-3);
    }
    .post-mobile-toc-panel :global(.toc-root) {
      max-height: min(60vh, 30rem);
      border-radius: var(--radius-sm);
    }
    .post-memory-module {
      display: none;
    }

    .instrumented-essay.post-layout {
      grid-template-columns: minmax(0, 1fr);
      max-width: 1040px;
      padding-inline: 1.25rem;
    }
  }

  @media (max-width: 640px) {
    .post-header { padding-top: 2rem; margin-bottom: 2.5rem; }
    .post-header h1 { font-size: clamp(2.25rem, 10.5vw, 3rem); }

    .instrumented-essay .post-header {
      padding-top: 2rem;
      margin-bottom: 3rem;
    }

    .article-sequence {
      grid-template-columns: 1fr;
      gap: 0.45rem;
      margin-bottom: 2rem;
      padding-block: 0.65rem;
    }

    .article-sequence ol {
      justify-content: flex-start;
    }

    .instrumented-essay .post-header h1 {
      font-size: clamp(2.35rem, 11.5vw, 3rem);
      line-height: 1.01;
    }
  }
</style>

<style is:global>
  /* Prose rules target markdown-rendered content, so they must be global.
     Colors inherit the themed tokens from global.css in both themes. */
  .post-content > :is(p, li) {
    color: var(--text-secondary);
  }
  .post-content > :is(p, ul, ol, blockquote, pre, h2, h3, h4, hr, table, .math-card, .formula-note, .katex-display, figure, .exhibit, .interactive-walkthrough) {
    max-width: var(--prose-max-width);
  }
  .post-content > .exhibit.wide {
    width: 100%;
    margin-left: 0;
    max-width: var(--prose-max-width);
  }
  .post-content > h2 {
    margin-top: 4.5rem;
    padding-top: 1.1rem;
    scroll-margin-top: 5.5rem;
    font-size: clamp(1.875rem, 3vw, 2.5rem); /* 30–40px, spec §4.2 */
    letter-spacing: -0.035em;
  }
  .post-content > h3 {
    margin-top: 2.75rem;
    scroll-margin-top: 5.5rem;
    font-size: 1.375rem; /* 22px, spec §4.2 h3 floor */
    letter-spacing: -0.02em;
  }
  .post-content > h4 {
    margin: 2rem 0 0.65rem;
    scroll-margin-top: 5.5rem;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .post-content code {
    font-family: var(--font-mono);
  }
  .post-content .katex-mathml,
  .post-content .katex-mathml math {
    inline-size: 1px !important;
    max-inline-size: 1px !important;
    overflow: hidden !important;
  }
  .post-content p > .katex:only-child {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }
  .post-content .katex-display {
    margin: var(--space-5) 0 var(--space-3);
    padding: var(--space-4) var(--space-5);
    overflow-x: auto;
    border: 1px solid var(--border);
    border-left: 2px solid var(--accent);
    border-radius: var(--radius);
    background: var(--bg-inset);
    color: var(--text);
  }
  .post-content .katex-display > .katex {
    min-width: max-content;
    font-size: 1.1em;
  }
  .post-content table {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    table-layout: auto;
    font-size: 0.9rem;
    line-height: 1.45;
  }
  .post-content th,
  .post-content td {
    padding: var(--table-cell-pad-block) var(--table-cell-pad-inline);
    border: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
    overflow-wrap: anywhere;
    word-break: normal;
  }
  .post-content table code {
    white-space: nowrap;
    overflow-wrap: normal;
  }
  .post-content th {
    background: var(--bg-inset);
    color: var(--text);
    font-weight: 600;
  }
  .post-content td {
    color: var(--text-secondary);
  }
  .post-content .formula-note {
    margin: 0 0 var(--space-5);
    padding-left: var(--space-3);
    border-left: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .post-layout .tag:hover,
  .post-layout .back-link a {
    color: var(--accent);
  }
  .post-layout .post-sidebar .toc-root {
    position: sticky;
    top: 5.5rem;
  }
  .post-mobile-toc .toc-root {
    margin-bottom: 2rem;
  }

  .post-hero-figure {
    margin: var(--space-5) 0 var(--space-6) 0;
    border-radius: var(--radius-card, 10px);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface-card, #ffffff);
    box-shadow: 0 4px 20px rgba(162, 210, 255, 0.12);
  }

  .post-hero-img {
    width: 100%;
    height: auto;
    max-height: 440px;
    object-fit: cover;
    display: block;
  }

  .post-hero-media {
    display: block;
    overflow-x: auto;
    color: inherit;
  }

  .post-hero-caption {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 10px 16px;
    font-family: var(--font-mono, monospace);
    font-size: 11.5px;
    color: var(--muted);
    border-top: 1px solid var(--border);
    background: var(--bg-inset);
  }

  .post-hero-hint {
    margin-left: auto;
    white-space: nowrap;
    color: var(--accent);
  }

  .caption-marker {
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.05em;
  }

  .instrumented-essay .post-content > :is(p, ul, ol, blockquote, pre, h2, h3, h4, hr, table, .math-card, .formula-note, .katex-display) {
    max-width: 700px;
  }

  .instrumented-essay .post-content > :is(.exhibit, .interactive-walkthrough, .verification-wrapper, figure) {
    width: 100%;
    max-width: 1040px;
  }

  .instrumented-essay .post-content > p,
  .instrumented-essay .post-content > :is(ul, ol) li {
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-body);
    line-height: 1.78;
  }

  .instrumented-essay .post-content > h2 {
    margin-top: 5.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ie-rule-strong);
    color: var(--ie-ink);
    font-family: var(--font-serif);
    font-size: clamp(2.15rem, 4vw, 3.25rem);
    font-weight: 600;
    line-height: 1.08;
  }

  .instrumented-essay .post-content > h2::before {
    display: block;
    margin-bottom: 0.7rem;
    color: var(--ie-blue);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .instrumented-essay .post-content > h3 {
    margin-top: 3.25rem;
    color: var(--ie-ink);
    font-family: var(--font-sans);
    font-size: 1.45rem;
    font-weight: 600;
  }

  .instrumented-essay .post-content > blockquote {
    margin-block: 2.5rem;
    padding: 0.2rem 0 0.2rem 1.25rem;
    border-left: 3px solid var(--ie-rust);
    background: transparent;
    color: var(--ie-ink-secondary);
  }

  .instrumented-essay .post-content .katex-display {
    border-color: var(--ie-rule);
    border-left-color: var(--ie-blue);
    border-radius: 4px;
    background: var(--ie-surface);
  }

  .instrumented-essay .post-content table {
    border-top: 2px solid var(--ie-ink);
    border-bottom: 1px solid var(--ie-rule-strong);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .instrumented-essay .post-content th,
  .instrumented-essay .post-content td {
    border-width: 0 0 1px;
    border-color: var(--ie-rule);
  }

  .instrumented-essay .post-content th {
    background: transparent;
    color: var(--ie-ink);
    text-transform: uppercase;
    letter-spacing: 0.035em;
  }

  .instrumented-essay .post-hero-figure {
    border-radius: 6px;
    border-color: var(--ie-rule-strong);
    background: var(--ie-surface);
    box-shadow: none;
  }

  .instrumented-essay .post-hero-caption {
    border-top-color: var(--ie-rule);
    background: var(--ie-surface-raised);
  }

  .instrumented-essay .caption-marker {
    color: var(--ie-rust);
  }

  .instrumented-essay .post-sidebar .toc-root,
  .instrumented-essay .post-mobile-toc .toc-root {
    padding: 1rem 0 1rem 1rem;
    border: 0;
    border-left: 1px solid var(--ie-rule-strong);
    border-radius: 0;
    background: transparent;
  }

  .instrumented-essay .post-footer {
    max-width: 700px;
    border-top: 1px solid var(--ie-rule-strong);
  }

  @media (max-width: 640px) {
    .ex-canvas-frame { padding: 1rem; }
    .post-hero-img {
      width: 720px;
      min-width: 720px;
      max-width: none;
      max-height: none;
    }
    .post-hero-caption {
      align-items: flex-start;
      flex-wrap: wrap;
    }
    .post-hero-hint {
      width: 100%;
      margin-left: 0;
    }
    .post-content .katex-display {
      padding: var(--space-3);
      font-size: 0.88rem;
    }
    .post-content .katex-display > .katex {
      min-width: 0;
      font-size: 0.95em;
      white-space: normal;
    }
    .post-content p > .katex:only-child {
      font-size: 0.94em;
    }
    .post-content table {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .post-content th,
    .post-content td {
      min-width: 10rem;
      padding: var(--table-cell-pad-block) var(--table-cell-pad-inline);
    }

    .instrumented-essay .post-content > :is(.exhibit, .interactive-walkthrough, .verification-wrapper, figure) {
      min-width: 0;
      max-width: 100%;
    }
  }
</style>
