---
/**
 * The 8 mark: one ribbon that loops twice. The top loop and the strand that
 * crosses in front are blue; the bottom loop is ink and is cut away where the
 * blue passes over it. A flat redraw of docs/brand/symbol.png so it stays
 * sharp at 16–32px. public/favicon.svg and the PNG icons are the same drawing
 * in fixed colours; change them together.
 */
interface Props {
  /** Height in px; the width follows the glyph, so its left edge sits on the page edge. */
  size?: number;
}

const { size = 26 } = Astro.props;
const width = Math.round((size * 40) / 58);
const maskId = `mark-cut-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class="mark" viewBox="12 3 40 58" width={width} height={size} aria-hidden="true" focusable="false">
  <defs>
    <mask id={maskId} maskUnits="userSpaceOnUse" x="0" y="0" width="64" height="64">
      <rect width="64" height="64" fill="#fff" />
      <path d="M45.1 37.1C41 32.7 25.8 27.7 21.8 23.2" fill="none" stroke="#000" stroke-width="11" />
    </mask>
  </defs>
  <path class="mark-back" d="M42.2 23.2C38.2 27.7 23 32.7 18.9 37.1A16 12 0 1 0 45.1 37.1" mask={`url(#${maskId})`} />
  <path class="mark-front" d="M45.1 37.1C41 32.7 25.8 27.7 21.8 23.2A12.5 10 0 1 1 42.2 23.2" />
</svg>

<style>
  .mark {
    display: block;
    flex-shrink: 0;
  }

  .mark path {
    fill: none;
    stroke-width: 7;
  }

  /* Ink inverts with the theme; the blue stays the site's blue. */
  .mark-back {
    stroke: var(--ie-ink);
  }

  .mark-front {
    stroke: var(--ie-blue);
  }
</style>
