---
import VisualPage from '@layouts/VisualPage.astro';
import PlatformStackHierarchy from '@components/diagram/version-control/PlatformStackHierarchy.astro';

const title = 'Developer Platform Stack Hierarchy';
const description = 'The four-tier functional architecture of modern code hosting: SCM content-addressable object store, collaboration ACLs, automated CI runners, and ephemeral cloud environments.';
---

<VisualPage
  title={title}
  description={description}
  targetId="platform-stack-export"
  filename="platform-stack-hierarchy"
  category="SYSTEMS ARCHITECTURE"
  drawingNo="VCS-01"
>
  <div id="platform-stack-export" class="visual-wrapper">
    <PlatformStackHierarchy id="platform-stack-diagram" />
  </div>
</VisualPage>

<style>
  .visual-wrapper {
    width: 100%;
    padding: 1.5rem 0.5rem;
  }
</style>
