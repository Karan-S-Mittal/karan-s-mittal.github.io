---
/**
 * SectionBreak.astro — spec §15.5
 * Replaces a generic <hr> with a faint topology strip.
 * 3–4 nodes, low opacity, semantic edge grammar (solid = direct, dashed = async).
 */
interface Props {
  label?: string;
}

const { label } = Astro.props;
---

<div class="section-break" role="separator" aria-label={label || 'Section break'}>
  <svg viewBox="0 0 320 12" width="320" height="12" aria-hidden="true">
    <circle cx="8" cy="6" r="3.5" />
    <line x1="16" y1="6" x2="128" y2="6" class="sb-solid" />
    <circle cx="136" cy="6" r="3.5" />
    <line x1="148" y1="6" x2="204" y2="6" class="sb-dashed" />
    <circle cx="212" cy="6" r="3.5" />
    <line x1="220" y1="6" x2="304" y2="6" class="sb-solid" />
    <circle cx="312" cy="6" r="3.5" />
  </svg>
</div>

<style>
  .section-break {
    display: flex;
    justify-content: center;
    margin: var(--space-8) auto;
    opacity: 0.35;
  }

  .section-break svg circle {
    fill: var(--diagram-node-primary);
  }

  .section-break svg .sb-solid {
    stroke: var(--diagram-edge-primary);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .section-break svg .sb-dashed {
    stroke: var(--diagram-edge-secondary);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 4 5;
  }
</style>
