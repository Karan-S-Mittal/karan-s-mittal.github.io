---
/**
 * SiteBackdrop.astro
 *
 * Generative-inspired Computational Graph & HPC Lattice backdrop.
 * Features topological compute clusters, tensor flow vectors, memory state nodes,
 * and coordinate readouts, adhering strictly to Soft Architecture design tokens.
 */
---

<div class="site-backdrop" aria-hidden="true">
  <svg class="backdrop-svg" viewBox="0 0 1440 900" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMin slice">
    <defs>
      <!-- HPC Coordinate Matrix Pattern -->
      <pattern id="hpc-lattice" width="48" height="48" patternUnits="userSpaceOnUse">
        <circle cx="24" cy="24" r="1" class="lattice-dot" />
        <path d="M 22 24 L 26 24 M 24 22 L 24 26" class="lattice-cross" />
      </pattern>

      <!-- Gradient Flow for Tensor Edges -->
      <linearGradient id="tensor-flow-amber" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="var(--ie-blue)" stop-opacity="0.5" />
        <stop offset="50%" stop-color="var(--ie-blue)" stop-opacity="0.2" />
        <stop offset="100%" stop-color="var(--ie-rule-strong)" stop-opacity="0.1" />
      </linearGradient>

      <linearGradient id="tensor-flow-verified" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="var(--ie-verified)" stop-opacity="0.4" />
        <stop offset="100%" stop-color="var(--ie-rule)" stop-opacity="0.05" />
      </linearGradient>
    </defs>

    <!-- Lattice Grid Plane -->
    <rect width="100%" height="100%" fill="url(#hpc-lattice)" opacity="0.6" />

    <!-- Topological Structural Bounds & Orbitals -->
    <g class="graph-mesh">
      <!-- Central Orchestration Orbitals -->
      <circle cx="720" cy="210" r="160" class="orbital-ring" stroke-dasharray="4 8" />
      <circle cx="720" cy="210" r="280" class="orbital-ring wide" stroke-dasharray="2 12" />
      <circle cx="720" cy="210" r="64" class="core-halo" />

      <!-- Left Cluster: Memory & State Architecture (Mem0, Vector, Graph) -->
      <g class="cluster memory-cluster">
        <path class="cluster-boundary" d="M 180 180 Q 280 120 360 200 T 320 340 T 160 300 Z" />
        <circle cx="220" cy="220" r="7" class="graph-node primary" />
        <circle cx="310" cy="180" r="6" class="graph-node" />
        <circle cx="280" cy="290" r="8" class="graph-node verified" />
        <circle cx="170" cy="280" r="5" class="graph-node" />
        <line x1="220" y1="220" x2="310" y2="180" class="cluster-edge" />
        <line x1="310" y1="180" x2="280" y2="290" class="cluster-edge" />
        <line x1="280" y1="290" x2="170" y2="280" class="cluster-edge" />
        <line x1="170" y1="280" x2="220" y2="220" class="cluster-edge" />

        <!-- Coordinate Callout -->
        <text x="160" y="325" class="coord-tag">state_space: 0x7F2A [episodic]</text>
        <text x="180" y="165" class="coord-tag">mem_stride: 64B</text>
      </g>

      <!-- Central Node: High-Performance Runtime & Dispatcher -->
      <g class="cluster core-cluster">
        <circle cx="720" cy="210" r="12" class="core-node" />
        <circle cx="720" cy="210" r="4" class="core-pin" />
        <text x="736" y="200" class="coord-tag bold">harness::rank_0 [DAG]</text>
        <text x="736" y="218" class="coord-tag">λ_eval = 0.994</text>
      </g>

      <!-- Right Cluster: Tool Execution & Sandboxing Runtime -->
      <g class="cluster tools-cluster">
        <path class="cluster-boundary" d="M 1080 160 Q 1200 130 1280 220 T 1220 350 T 1060 270 Z" />
        <circle cx="1120" cy="200" r="7" class="graph-node" />
        <circle cx="1220" cy="180" r="6" class="graph-node primary" />
        <circle cx="1240" cy="280" r="8" class="graph-node rust" />
        <circle cx="1140" cy="300" r="5" class="graph-node" />
        <line x1="1120" y1="200" x2="1220" y2="180" class="cluster-edge" />
        <line x1="1220" y1="180" x2="1240" y2="280" class="cluster-edge" />
        <line x1="1240" y1="280" x2="1140" y2="300" class="cluster-edge" />
        <line x1="1140" y1="300" x2="1120" y2="200" class="cluster-edge" />

        <!-- Coordinate Callout -->
        <text x="1150" y="160" class="coord-tag">sandbox::isolation [microVM]</text>
        <text x="1160" y="340" class="coord-tag">tensor_dim: [4096, 768]</text>
      </g>

      <!-- Inter-Cluster Directed Tensor Geodesics -->
      <!-- Left to Center -->
      <path class="tensor-flow-edge primary" d="M 310 180 C 440 160 560 190 708 210" />
      <path class="tensor-flow-edge dashed" d="M 280 290 C 420 320 580 270 710 216" />

      <!-- Center to Right -->
      <path class="tensor-flow-edge primary" d="M 732 210 C 860 190 980 180 1120 200" />
      <path class="tensor-flow-edge verified" d="M 728 218 C 880 270 1020 310 1140 300" />

      <!-- High-Performance Tensor Matrix Cross-Connections -->
      <path class="tensor-arch-curve" d="M 220 220 C 460 70 960 70 1220 180" />
      <path class="tensor-arch-curve low" d="M 170 280 C 480 440 940 440 1240 280" />

      <!-- Micro Terminal Markers -->
      <rect x="520" y="176" width="3" height="3" class="terminal-marker" />
      <rect x="910" y="196" width="3" height="3" class="terminal-marker" />
      <rect x="690" y="88" width="60" height="14" rx="3" class="spec-badge-bg" />
      <text x="700" y="98" class="spec-badge-text">TOPOLOGICAL MESH</text>
    </g>
  </svg>
</div>

<style>
  .site-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .backdrop-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    -webkit-mask-image: radial-gradient(ellipse at 50% 28%, black 20%, rgb(0 0 0 / 0.45) 55%, transparent 80%);
    mask-image: radial-gradient(ellipse at 50% 28%, black 20%, rgb(0 0 0 / 0.45) 55%, transparent 80%);
  }

  /* Lattice Pattern */
  .lattice-dot {
    fill: var(--ie-rule-strong);
    opacity: 0.4;
  }

  .lattice-cross {
    stroke: var(--ie-rule);
    stroke-width: 0.8;
    opacity: 0.6;
  }

  /* Orbitals & Halos */
  .orbital-ring {
    fill: none;
    stroke: var(--ie-rule);
    stroke-width: 1;
    opacity: 0.65;
  }

  .orbital-ring.wide {
    stroke: var(--ie-rule-strong);
    opacity: 0.35;
  }

  .core-halo {
    fill: none;
    stroke: var(--ie-blue);
    stroke-width: 1.5;
    stroke-opacity: 0.25;
    stroke-dasharray: 4 6;
  }

  /* Clusters */
  .cluster-boundary {
    fill: var(--ie-surface-raised);
    fill-opacity: 0.3;
    stroke: var(--ie-rule);
    stroke-width: 1;
    stroke-dasharray: 6 8;
  }

  .cluster-edge {
    stroke: var(--ie-rule-strong);
    stroke-width: 1.2;
    stroke-opacity: 0.65;
    vector-effect: non-scaling-stroke;
  }

  /* Nodes */
  .graph-node {
    fill: var(--ie-canvas);
    stroke: var(--ie-rule-strong);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .graph-node.primary {
    stroke: var(--ie-blue);
    fill: var(--ie-blue-soft);
  }

  .graph-node.verified {
    stroke: var(--ie-verified);
    fill: var(--ie-verified-soft);
  }

  .graph-node.rust {
    stroke: var(--ie-rust);
    fill: var(--ie-rust-soft);
  }

  .core-node {
    fill: var(--ie-surface);
    stroke: var(--ie-blue);
    stroke-width: 2;
    filter: drop-shadow(0 0 6px var(--ie-blue-soft));
  }

  .core-pin {
    fill: var(--ie-blue);
  }

  /* Tensor Edges */
  .tensor-flow-edge {
    fill: none;
    stroke: url(#tensor-flow-amber);
    stroke-width: 1.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .tensor-flow-edge.dashed {
    stroke-dasharray: 4 6;
    stroke: var(--ie-rule-strong);
    stroke-opacity: 0.5;
  }

  .tensor-flow-edge.verified {
    stroke: url(#tensor-flow-verified);
    stroke-dasharray: 5 5;
  }

  .tensor-arch-curve {
    fill: none;
    stroke: var(--ie-blue);
    stroke-width: 1;
    stroke-opacity: 0.18;
    stroke-dasharray: 3 8;
  }

  .tensor-arch-curve.low {
    stroke: var(--ie-rule-strong);
    stroke-opacity: 0.25;
  }

  .terminal-marker {
    fill: var(--ie-blue);
    opacity: 0.5;
  }

  /* Annotations & Coordinates */
  .coord-tag {
    font-family: var(--font-mono);
    font-size: 9.5px;
    fill: var(--ie-muted);
    letter-spacing: 0.04em;
    opacity: 0.75;
  }

  .coord-tag.bold {
    font-weight: 600;
    fill: var(--ie-blue);
    opacity: 0.95;
  }

  .spec-badge-bg {
    fill: var(--ie-surface);
    stroke: var(--ie-rule);
    stroke-width: 1;
  }

  .spec-badge-text {
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
    fill: var(--ie-muted);
    letter-spacing: 0.08em;
  }

  @media (max-width: 768px) {
    .backdrop-svg {
      opacity: 0.55;
    }

    .coord-tag,
    .spec-badge-bg,
    .spec-badge-text,
    .orbital-ring.wide {
      display: none;
    }
  }

  @media print {
    .site-backdrop {
      display: none;
    }
  }
</style>
