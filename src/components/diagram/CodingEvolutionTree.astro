---
/**
 * CodingEvolutionTree.astro
 * Publication-grade squarish evolutionary branching tree diagram comparing
 * Claude Code (Anthropic) and OpenAI Codex across 2025 and 2026.
 *
 * Adheres strictly to the Studio Diagramming Framework:
 * - Squarish aspect ratio (~1.15:1) for compact visual presentation without excessive length or width.
 * - Dual temporal columns: 2025 on left, 2026 on right, with subtle central datum rule.
 * - Git-tree branch grammar: vertical continuity trunks, junction pins, and cross-year capability bridges.
 * - 100% token compliant: zero raw hex, full light/dark mode parity via --ie-* and --brand-*.
 * - Brand marks: Claude & OpenAI vector icons via BrandIcon.astro.
 * - Standard author attribution: VisualAttribution.astro in bottom-right corner.
 */
import BrandIcon from './icons/BrandIcon.astro';
import VisualAttribution from './VisualAttribution.astro';

interface Props {
  title?: string;
  badge?: string;
  caption?: string;
  showHeader?: boolean;
  showAttribution?: boolean;
  bordered?: boolean;
  class?: string;
}

const {
  title = 'Agentic Coding Evolution: Claude Code & Codex',
  badge = 'CHRONOLOGY · 2025 – 2026',
  caption = 'Architectural genealogy from early terminal & cloud previews into autonomous multi-agent systems and isolated sandboxes.',
  showHeader = true,
  showAttribution = true,
  bordered = true,
  class: className = '',
} = Astro.props;
---

<div class:list={['evolution-tree-root', { 'is-unbordered': !bordered }, className]} id="coding-evolution-diagram">
  <!-- Diagram Header -->
  {showHeader && (
    <header class="tree-header">
      <div class="header-topline">
        {badge && <span class="header-badge">{badge}</span>}
        <span class="badge-sep">·</span>
        <span class="header-epochs">2-Year Trajectory</span>
      </div>
      <h2 class="tree-title">{title}</h2>
      {caption && <p class="tree-caption">{caption}</p>}
    </header>
  )}

  <!-- Horizontal Timeline Epoch Ruler: 2025 vs 2026 -->
  <div class="epoch-ruler" aria-hidden="true">
    <div class="ruler-col ruler-2025">
      <div class="epoch-badge">
        <span class="epoch-year">2025</span>
        <span class="epoch-phase">Terminal & Cloud Previews</span>
      </div>
      <div class="ruler-bar">
        <span class="ruler-segment"></span>
        <span class="ruler-tick tick-mid">Q3</span>
        <span class="ruler-segment"></span>
        <span class="ruler-tick tick-end">Q4</span>
      </div>
    </div>

    <div class="ruler-boundary">
      <span class="boundary-line"></span>
      <span class="boundary-pill">TRANSITION</span>
    </div>

    <div class="ruler-col ruler-2026">
      <div class="epoch-badge">
        <span class="epoch-year">2026</span>
        <span class="epoch-phase">Agents, Memory & Sandboxing</span>
      </div>
      <div class="ruler-bar">
        <span class="ruler-tick tick-start">Q1</span>
        <span class="ruler-segment"></span>
        <span class="ruler-tick tick-mid">Q2</span>
        <span class="ruler-segment"></span>
        <span class="ruler-tick tick-end">Q3</span>
      </div>
    </div>
  </div>

  <!-- Main Canvas: Two Stacked Evolution Tracks -->
  <div class="tracks-stage">
    <!-- ================= TRACK 1: CLAUDE CODE (ANTHROPIC) ================= -->
    <section class="track-section track-claude" aria-label="Claude Code Architectural Evolution">
      <div class="track-header">
        <div class="track-brand">
          <div class="brand-badge badge-claude">
            <BrandIcon name="claude" size={14} />
          </div>
          <span class="track-title">Claude Code</span>
          <span class="track-org">Anthropic</span>
        </div>
        <span class="track-indicator">Local Execution & Subagent Trees</span>
      </div>

      <!-- Two-Column Tree Layout -->
      <div class="tree-grid">
        <!-- 2025 Column: Root & Version 2.0 -->
        <div class="tree-col col-2025">
          <div class="trunk-rail trunk-claude"></div>

          <!-- Milestone 1: Research Preview -->
          <article class="tree-node node-claude node-root">
            <span class="junction-dot dot-origin" aria-hidden="true"></span>
            <div class="node-card">
              <div class="card-meta">
                <time class="card-date">Feb 24, 2025</time>
                <span class="card-tag">RESEARCH PREVIEW</span>
              </div>
              <h4 class="card-name">Terminal Agent</h4>
              <p class="card-desc">Bundled with Claude 3.7 Sonnet · Local execution preview</p>
            </div>
          </article>

          <!-- Milestone 2: Claude Code 2.0 -->
          <article class="tree-node node-claude node-branch">
            <span class="junction-dot dot-t" aria-hidden="true"></span>
            <span class="branch-arm arm-claude" aria-hidden="true"></span>
            <div class="node-card">
              <div class="card-meta">
                <time class="card-date">Sep 29, 2025</time>
                <span class="card-tag">CLAUDE CODE 2.0</span>
              </div>
              <h4 class="card-name">IDE & Subagent Runtime</h4>
              <div class="chips-row">
                <span class="chip">VS Code</span>
                <span class="chip">checkpoints</span>
                <span class="chip">subagents</span>
                <span class="chip">background work</span>
              </div>
            </div>
          </article>

          <!-- Cross-Year Horizontal Spur Out -->
          <div class="cross-year-spur spur-claude-out" aria-hidden="true">
            <span class="spur-wire"></span>
            <span class="spur-arrow">►</span>
          </div>
        </div>

        <!-- Central Datum Rule -->
        <div class="col-divider" aria-hidden="true"></div>

        <!-- 2026 Column: Architecture Bridge & Fable 5.1 -->
        <div class="tree-col col-2026">
          <div class="trunk-rail subtrunk-claude"></div>

          <!-- Milestone 3: Capability Transition Node -->
          <article class="tree-node node-claude node-bridge">
            <span class="junction-dot dot-bridge" aria-hidden="true"></span>
            <div class="node-card card-transition">
              <div class="card-meta">
                <span class="card-tag tag-verified">2026 CAPABILITY SHIFT</span>
              </div>
              <h4 class="card-name">Sandboxed Multi-Agent Platform</h4>
              <div class="chips-row">
                <span class="chip chip-highlight">sandboxing</span>
                <span class="chip chip-highlight">remote execution</span>
                <span class="chip">memory</span>
                <span class="chip">agents runtime</span>
              </div>
            </div>
          </article>

          <!-- Milestone 4: Fable 5.1 -->
          <article class="tree-node node-claude node-branch">
            <span class="junction-dot dot-corner" aria-hidden="true"></span>
            <span class="branch-arm arm-claude" aria-hidden="true"></span>
            <div class="node-card">
              <div class="card-meta">
                <time class="card-date">Sep 1, 2026</time>
                <span class="card-tag">FRONTIER MODEL</span>
              </div>
              <h4 class="card-name">Fable 5.1</h4>
              <p class="card-desc">Autonomous orchestration over remote execution graphs</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Track Divider -->
    <div class="tracks-divider" aria-hidden="true"></div>

    <!-- ================= TRACK 2: OPENAI CODEX ================= -->
    <section class="track-section track-codex" aria-label="OpenAI Codex Architectural Evolution">
      <div class="track-header">
        <div class="track-brand">
          <div class="brand-badge badge-codex">
            <BrandIcon name="openai" size={14} />
          </div>
          <span class="track-title">OpenAI Codex</span>
          <span class="track-org">OpenAI</span>
        </div>
        <span class="track-indicator">Cloud Previews to Parallel Worktrees</span>
      </div>

      <!-- Two-Column Tree Layout -->
      <div class="tree-grid">
        <!-- 2025 Column: Cloud Preview -> GPT-5-Codex -> GA -->
        <div class="tree-col col-2025">
          <div class="trunk-rail trunk-codex"></div>

          <!-- Milestone 1: Cloud Preview -->
          <article class="tree-node node-codex node-root">
            <span class="junction-dot dot-origin" aria-hidden="true"></span>
            <div class="node-card">
              <div class="card-meta">
                <time class="card-date">May 16, 2025</time>
                <span class="card-tag">CLOUD PREVIEW</span>
              </div>
              <h4 class="card-name">Cloud Agent</h4>
              <p class="card-desc">Parallel task delegation powered by codex-1</p>
            </div>
          </article>

          <!-- Milestone 2: GPT-5-Codex -->
          <article class="tree-node node-codex node-branch">
            <span class="junction-dot dot-t" aria-hidden="true"></span>
            <span class="branch-arm arm-codex" aria-hidden="true"></span>
            <div class="node-card">
              <div class="card-meta">
                <time class="card-date">Sep 15, 2025</time>
                <span class="card-tag">GPT-5-CODEX</span>
              </div>
              <h4 class="card-name">CLI + IDE Upgrades</h4>
              <div class="chips-row">
                <span class="chip">CLI launch</span>
                <span class="chip">IDE integrations</span>
              </div>
            </div>
          </article>

          <!-- Milestone 3: General Availability -->
          <article class="tree-node node-codex node-branch">
            <span class="junction-dot dot-t" aria-hidden="true"></span>
            <span class="branch-arm arm-codex" aria-hidden="true"></span>
            <div class="node-card">
              <div class="card-meta">
                <time class="card-date">Oct 6, 2025</time>
                <span class="card-tag">GENERAL AVAILABILITY</span>
              </div>
              <h4 class="card-name">Enterprise Rollout</h4>
              <p class="card-desc">OpenAI DevDay announcement · Admin controls & SDK</p>
            </div>
          </article>

          <!-- Cross-Year Horizontal Spur Out -->
          <div class="cross-year-spur spur-codex-out" aria-hidden="true">
            <span class="spur-wire"></span>
            <span class="spur-arrow">►</span>
          </div>
        </div>

        <!-- Central Datum Rule -->
        <div class="col-divider" aria-hidden="true"></div>

        <!-- 2026 Column: Codex App -> Memory -> GPT-6 Astra -->
        <div class="tree-col col-2026">
          <div class="trunk-rail subtrunk-codex"></div>

          <!-- Milestone 4: Codex App -->
          <article class="tree-node node-codex node-bridge">
            <span class="junction-dot dot-bridge" aria-hidden="true"></span>
            <div class="node-card">
              <div class="card-meta">
                <time class="card-date">Feb 2, 2026</time>
                <span class="card-tag">CODEX APP</span>
              </div>
              <h4 class="card-name">Multi-Agent Command Center</h4>
              <div class="chips-row">
                <span class="chip chip-highlight">parallel agents</span>
                <span class="chip chip-highlight">worktrees</span>
              </div>
            </div>
          </article>

          <!-- Milestone 5: Memory & Computer Use -->
          <article class="tree-node node-codex node-branch">
            <span class="junction-dot dot-t" aria-hidden="true"></span>
            <span class="branch-arm arm-codex" aria-hidden="true"></span>
            <div class="node-card">
              <div class="card-meta">
                <time class="card-date">Apr 16, 2026</time>
                <span class="card-tag">ONGOING WORK</span>
              </div>
              <h4 class="card-name">Autonomous Horizon Expansion</h4>
              <div class="chips-row">
                <span class="chip">memory</span>
                <span class="chip">ongoing work</span>
                <span class="chip">computer use</span>
              </div>
            </div>
          </article>

          <!-- Milestone 6: GPT-6 Astra -->
          <article class="tree-node node-codex node-branch">
            <span class="junction-dot dot-corner" aria-hidden="true"></span>
            <span class="branch-arm arm-codex" aria-hidden="true"></span>
            <div class="node-card">
              <div class="card-meta">
                <time class="card-date">Sep 3, 2026</time>
                <span class="card-tag">GPT-6 ASTRA</span>
              </div>
              <h4 class="card-name">Frontier Autonomous Codex</h4>
              <p class="card-desc">Next-generation multi-agent coding intelligence</p>
            </div>
          </article>
        </div>
      </div>
    </section>
  </div>

  <!-- Bottom Bar: Legend & Attribution Wordmark -->
  {showAttribution && (
    <footer class="tree-footer">
      <div class="footer-legend">
        <span class="legend-item">
          <span class="dot dot-claude" aria-hidden="true"></span>
          <span>Claude Code (Anthropic)</span>
        </span>
        <span class="legend-sep">·</span>
        <span class="legend-item">
          <span class="dot dot-codex" aria-hidden="true"></span>
          <span>OpenAI Codex</span>
        </span>
      </div>
      <VisualAttribution author="karansmittal" />
    </footer>
  )}
</div>

<style>
  .evolution-tree-root {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    max-width: 780px;
    margin: 0 auto;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card);
    padding: clamp(1rem, 2.5vw, 1.5rem);
    font-family: var(--font-diagram);
    color: var(--ie-ink);
    box-sizing: border-box;
  }

  .evolution-tree-root.is-unbordered {
    border: none;
    padding: 0;
    background: transparent;
  }

  /* Header */
  .tree-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .header-topline {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .header-badge {
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--ie-blue);
    text-transform: uppercase;
  }

  .badge-sep {
    color: var(--ie-rule-strong);
    font-size: var(--ie-type-micro);
  }

  .header-epochs {
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    color: var(--ie-muted);
  }

  .tree-title {
    margin: 0;
    font-size: var(--ie-type-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ie-ink);
    line-height: 1.25;
  }

  .tree-caption {
    margin: 0;
    font-size: var(--ie-type-micro);
    color: var(--ie-muted);
    line-height: 1.4;
  }

  /* Epoch Ruler */
  .epoch-ruler {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    background: var(--ie-surface-raised);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius);
  }

  .ruler-col {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .epoch-badge {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .epoch-year {
    font-family: var(--font-mono);
    font-size: var(--ie-type-ui);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ie-ink);
  }

  .epoch-phase {
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    color: var(--ie-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .ruler-bar {
    display: flex;
    align-items: center;
    height: 14px;
    gap: 0.35rem;
  }

  .ruler-segment {
    flex: 1;
    height: 2px;
    background: var(--ie-rule-strong);
    border-radius: 1px;
  }

  .ruler-tick {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--ie-muted);
    padding: 0 0.2rem;
    font-weight: 600;
  }

  .ruler-boundary {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0 0.35rem;
  }

  .boundary-line {
    width: 1px;
    height: 12px;
    background: var(--ie-rule-strong);
  }

  .boundary-pill {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ie-blue);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-sm);
    padding: 0.1rem 0.35rem;
    white-space: nowrap;
  }

  /* Stage & Tracks */
  .tracks-stage {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .tracks-divider {
    height: 1px;
    background: var(--ie-rule);
    width: 100%;
  }

  .track-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .track-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--ie-rule);
  }

  .track-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .brand-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--ie-rule);
  }

  .badge-claude {
    background: var(--brand-anthropic-soft);
    border-color: var(--brand-anthropic-border);
  }

  .badge-codex {
    background: var(--brand-openai-soft);
    border-color: var(--brand-openai-border);
  }

  .track-title {
    font-size: var(--ie-type-ui);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ie-ink);
  }

  .track-org {
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    color: var(--ie-muted);
  }

  .track-indicator {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ie-muted);
  }

  /* Tree Grid */
  .tree-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.125rem;
    position: relative;
  }

  @media (max-width: 640px) {
    .tree-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .col-divider {
      display: none;
    }
  }

  .col-divider {
    width: 1px;
    background: var(--ie-rule);
    border-left: 1px dashed var(--ie-rule-strong);
    opacity: 0.6;
  }

  .tree-col {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-left: 1.625rem;
  }

  /* Vertical Trunk Rails */
  .trunk-rail {
    position: absolute;
    left: 8px;
    width: 2px;
    top: 14px;
    border-radius: 1px;
  }

  .trunk-claude {
    bottom: 12px;
    background: var(--brand-anthropic);
  }

  .subtrunk-claude {
    top: 14px;
    bottom: 22px;
    background: var(--brand-anthropic);
  }

  .trunk-codex {
    bottom: 12px;
    background: var(--brand-openai);
  }

  .subtrunk-codex {
    top: 14px;
    bottom: 22px;
    background: var(--brand-openai);
  }

  /* Tree Nodes */
  .tree-node {
    position: relative;
  }

  /* Junction Dots */
  .junction-dot {
    position: absolute;
    left: calc(-1.625rem + 4px);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ie-surface);
    border: 2px solid var(--ie-rule-strong);
    z-index: 2;
  }

  .node-claude .junction-dot {
    border-color: var(--brand-anthropic);
  }

  .node-codex .junction-dot {
    border-color: var(--brand-openai);
  }

  .dot-origin {
    top: 10px;
  }

  .dot-t {
    top: 14px;
  }

  .dot-bridge {
    top: 14px;
  }

  .dot-corner {
    top: 14px;
  }

  .node-claude .dot-bridge,
  .node-claude .dot-origin {
    background: var(--brand-anthropic);
  }

  .node-codex .dot-bridge,
  .node-codex .dot-origin {
    background: var(--brand-openai);
  }

  /* Horizontal Branch Arms */
  .branch-arm {
    position: absolute;
    left: calc(-1.625rem + 9px);
    top: 18px;
    width: 14px;
    height: 2px;
    z-index: 1;
  }

  .arm-claude {
    background: var(--brand-anthropic);
  }

  .arm-codex {
    background: var(--brand-openai);
  }

  /* Cross-Year Bridge Out */
  .cross-year-spur {
    position: relative;
    display: flex;
    align-items: center;
    margin-left: calc(-1.625rem + 9px);
    margin-top: 0.125rem;
    height: 14px;
    z-index: 3;
  }

  .spur-wire {
    flex: 1;
    height: 2px;
    border-radius: 1px;
  }

  .spur-claude-out .spur-wire {
    background: var(--brand-anthropic);
  }

  .spur-codex-out .spur-wire {
    background: var(--brand-openai);
  }

  .spur-arrow {
    font-size: 8px;
    line-height: 1;
    margin-left: -2px;
  }

  .spur-claude-out .spur-arrow {
    color: var(--brand-anthropic);
  }

  .spur-codex-out .spur-arrow {
    color: var(--brand-openai);
  }

  /* Node Cards */
  .node-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.55rem 0.75rem;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius);
    transition: border-color var(--transition-fast);
  }

  .node-claude .node-card:hover {
    border-color: var(--brand-anthropic-border);
  }

  .node-codex .node-card:hover {
    border-color: var(--brand-openai-border);
  }

  .card-transition {
    background: var(--ie-surface-raised);
    border-style: dashed;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
  }

  .card-date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--ie-ink-secondary);
  }

  .node-claude .card-date {
    color: var(--brand-anthropic);
  }

  .node-codex .card-date {
    color: var(--brand-openai);
  }

  .card-tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--ie-rule);
    background: var(--ie-surface-raised);
    color: var(--ie-ink-secondary);
    white-space: nowrap;
  }

  .tag-verified {
    background: var(--ie-verified-soft);
    border-color: var(--ie-verified);
    color: var(--ie-verified);
  }

  .card-name {
    margin: 0;
    font-size: var(--ie-type-ui);
    font-weight: 600;
    line-height: 1.3;
    color: var(--ie-ink);
  }

