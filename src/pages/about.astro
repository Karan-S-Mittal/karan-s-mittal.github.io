---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/content/PageHeader.astro';
import Icon from '@components/layout/Icon.astro';
import { SITE, SOCIALS } from '../config';
import communitiesData from '@data/communities.json';

const { communities } = communitiesData;
const linkedinSocial = SOCIALS.find((s) => s.name === 'LinkedIn')?.url || 'https://www.linkedin.com/in/karansmittal/';
const githubSocial = SOCIALS.find((s) => s.name === 'GitHub')?.url || 'https://github.com/karan-s-mittal';
---

<Layout title="About | Karan Mittal">
  <main class="container about-page">
    <PageHeader
      label="About"
      title="Karan Mittal"
      description="AI systems architect, founder, and community builder working on dependable knowledge and inference systems."
    />

    <div class="about-intro">
      <div class="about-portrait-frame">
        <img
          class="about-portrait"
          src="/profile-400.jpg"
          alt="Karan Mittal"
          width="200"
          height="240"
          loading="eager"
        />
      </div>
      <div class="about-lead">
        <blockquote class="hero-quote">
          &ldquo;The difficult part of an engineering problem is rarely the tool. It is designing a system people can rely on.&rdquo;
        </blockquote>

        <div class="bio-text">
          <p>
            I am an AI Systems Architect and co-founder of <a href="https://dextar.co" target="_blank" rel="noopener">Dextar</a>. I work with engineering teams turning uncertain AI prototypes into dependable production systems with clear operational boundaries, inspectable evidence, and explicit constraints.
          </p>
          <p>
            My experience spans enterprise knowledge infrastructure, life sciences, and finance. My current work centers on deterministic knowledge systems, LLM inference optimization, and microarchitectural performance engineering.
          </p>
        </div>

        <div class="hero-actions">
          <a class="ie-action primary" href="/blog">Read field notes &rarr;</a>
          <a class="ie-action secondary" href="/work">Selected work &nearr;</a>
          <a class="ie-action secondary" href="/now">What I'm doing now &rarr;</a>
        </div>
      </div>
    </div>

    <!-- TECHNICAL FOCUS -->
    <section class="about-section">
      <div class="section-head">
        <span class="section-register">01 / Focus</span>
        <h2>Engineering Practice &amp; Systems Focus</h2>
      </div>

      <div class="focus-list">
        <div class="focus-item">
          <h3>Deterministic RAG &amp; Knowledge Systems</h3>
          <p>
            Structured retrieval contracts, citation chains, graph-aware discovery, and predictable LLM orchestration designed to eliminate hallucinations in mission-critical workloads.
          </p>
        </div>

        <div class="focus-item">
          <h3>Inference &amp; Microarchitecture</h3>
          <p>
            KV-cache layout optimization, CUDA kernel efficiency, memory fragmentation bounds, and low-latency token generation under high operational concurrency.
          </p>
        </div>

        <div class="focus-item">
          <h3>Systems Reliability &amp; Evaluation</h3>
          <p>
            Production evaluation harnesses, distributed data pipelines, and deterministic verification boundaries that ensure architectures survive team handover and operational scaling.
          </p>
        </div>
      </div>
    </section>

    <!-- COMMUNITY & MENTORSHIP -->
    <section class="about-section">
      <div class="section-head">
        <span class="section-register">02 / Ecosystem</span>
        <h2>Community &amp; Mentorship</h2>
        <p class="section-desc">Organising, mentoring, and teaching across technical communities in Central India.</p>
      </div>

      <div class="community-list">
        {communities.map((c) => (
          <div class="community-row">
            <img src={c.logo} alt={c.name} class="community-logo" loading="lazy" decoding="async" />
            <div class="community-info">
              <p class="community-name">{c.name}</p>
              <p class="community-desc">{c.description}</p>
            </div>
            {c.links && c.links.length > 0 && (
              <div class="community-links">
                {c.links.map((link: { label: string; url: string }) => (
                  <a href={link.url} target="_blank" rel="noopener" class="comm-btn">
                    <span>{link.label}</span>
                    <Icon name="arrow-up-right" size={12} />
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- CONSULTATION & INTAKE -->
    <section class="about-section cta-section">
      <div class="cta-inner">
        <span class="section-register">03 / Consultation</span>
        <h2>Bring the difficult system question</h2>
        <p>
          Available for technical advisory, deep-dive architecture reviews, and resolving prototype-to-production bottlenecks across deterministic retrieval and inference optimization.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="ie-action primary">Start consultation inquiry &rarr;</a>
          <a href={`mailto:${SITE.email}?subject=Systems%20Architecture%20Inquiry`} class="ie-action secondary">Email</a>
          <a href={linkedinSocial} target="_blank" rel="noopener" class="ie-action secondary">LinkedIn &nearr;</a>
          <a href={githubSocial} target="_blank" rel="noopener" class="ie-action secondary">GitHub &nearr;</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .about-page {
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .section-register {
    display: inline-block;
    margin-bottom: 0.5rem;
    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-intro {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--ie-rule);
  }

  .about-portrait-frame {
    width: 200px;
    height: 240px;
    border-radius: var(--radius-card, 8px);
    overflow: hidden;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
  }

  .about-portrait {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .about-lead {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero-quote {
    margin: 0;
    padding: 0;
    border: none;
    background: none;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    font-weight: 500;
    font-style: italic;
    color: var(--ie-ink);
    line-height: 1.42;
    letter-spacing: -0.015em;
  }

  .bio-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bio-text p {
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-base);
    line-height: 1.68;
    max-width: 680px;
  }

  .bio-text a {
    color: var(--ie-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .ie-action {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.6rem 1.15rem;
    border: 1px solid var(--ie-ink);
    border-radius: var(--radius, 6px);
    font-family: var(--font-sans);
    font-size: var(--ie-type-ui);
    font-weight: 600;
    text-decoration: none;
    transition: all 120ms ease;
  }

  .ie-action.primary {
    background: var(--ie-ink);
    color: var(--ie-canvas);
  }

  .ie-action.primary:hover {
    border-color: var(--ie-blue);
    background: var(--ie-blue);
    color: #ffffff;
  }

  .ie-action.secondary {
    background: transparent;
    color: var(--ie-ink);
    border-color: var(--ie-rule-strong);
  }

  .ie-action.secondary:hover {
    border-color: var(--ie-blue);
    color: var(--ie-blue);
    background: var(--ie-surface);
  }

  /* SECTIONS */
  .about-section {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--ie-rule);
  }

  .about-section:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .section-head {
    margin-bottom: 2rem;
  }

  .section-head h2 {
    margin: 0;
    color: var(--ie-ink);
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 3vw, 2.2rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .section-desc {
    margin: 0.5rem 0 0;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-small);
  }

  /* FOCUS LIST */
  .focus-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .focus-item {
    border-left: 2px solid var(--ie-rule);
    padding-left: 1.25rem;
    transition: border-color 150ms ease;
  }

  .focus-item:hover {
    border-color: var(--ie-blue);
  }

  .focus-item h3 {
    margin: 0 0 0.4rem;
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ie-ink);
  }

  .focus-item p {
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-small);
    line-height: 1.65;
    max-width: 660px;
  }

  /* COMMUNITY */
  .community-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .community-row {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: center;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 8px);
    background: var(--ie-surface);
    transition: border-color 120ms ease;
  }

  .community-row:hover {
    border-color: var(--ie-blue);
  }

  .community-logo {
    width: 44px;
    height: 44px;
    border-radius: 6px;
    object-fit: cover;
    border: 1px solid var(--ie-rule);
  }

  .community-info {
    min-width: 0;
  }

  .community-name {
    margin: 0 0 0.25rem;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ie-ink);
  }

  .community-desc {
    margin: 0;
    font-size: var(--ie-type-small);
    color: var(--ie-ink-secondary);
    line-height: 1.5;
  }

  .community-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .comm-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-sm, 4px);
    background: var(--ie-surface);
    color: var(--ie-ink);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label);
    text-decoration: none;
    transition: all 120ms ease;
  }

  .comm-btn:hover {
    border-color: var(--ie-blue);
    color: var(--ie-blue);
  }

  /* CTA */
  .cta-section {
    border-top: 2px solid var(--ie-rust);
  }

  .cta-inner {
    max-width: 680px;
  }

  .cta-inner p {
    margin: 0.75rem 0 1.5rem;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-body);
    line-height: 1.65;
  }

  @media (max-width: 680px) {
    .about-intro {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .about-portrait-frame {
      width: 140px;
      height: 168px;
    }

    .community-row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .community-logo {
      display: none;
    }
  }
</style>
