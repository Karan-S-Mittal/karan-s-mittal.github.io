---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/portfolio/PageHeader.astro';
import NeuralNet3D from '../../../components/visuals/neural-net/NeuralNet3D.astro';
import LinearTransform2D from '../../../components/visuals/neural-net/LinearTransform2D.astro';
import MatrixComputeSpreadsheet from '../../../components/visuals/neural-net/MatrixComputeSpreadsheet.astro';
import { LinearRegressionMafs } from '../../../components/visuals/ml/regression/LinearRegressionMafs';
import { DiagramEngineComparison } from '../../../components/visual-engine/showcase/DiagramEngineComparison';
---

<Layout
  title="Visual Studio Lab | Explanatory Systems Studio"
  description="Interactive 2D/3D visual engine laboratory inspired by 3Blue1Brown and Bartosz Ciechanowski for systems engineering explanations."
>
  <main class="container lab-layout">
    <PageHeader
      label="§05 Visual Studio Lab"
      title="Explanatory Graphics & Visual Engine."
      description="A testing and development sandbox for high-performance 2D/3D interactive visual models built with Three.js, Canvas2D, and Soft Architecture design tokens."
    />

    <!-- LAB INTRO NOTE -->
    <div class="lab-card intro-card">
      <div class="lab-badge-row">
        <span class="live-dot"></span>
        <span class="lab-tag">ENGINE ARCHITECTURE</span>
      </div>
      <p class="intro-text">
        Every visual below adheres to the <strong>3Blue1Brown / Ciechanowski standard</strong>: 60 FPS GPU-accelerated execution, zero background battery drain via <code>IntersectionObserver</code> auto-pausing, high-DPI Retina coordinate scaling, dynamic light/dark CSS token synchronization, and comprehensive WebGL memory disposal.
      </p>
    </div>

    <!-- SHOWCASE 01: 3D NEURAL NET -->
    <section class="visual-section">
      <div class="section-header">
        <span class="section-num">01</span>
        <div class="section-title-group">
          <h2 class="section-title">3D Neural Network Signal &amp; Gradient Flow Engine</h2>
          <p class="section-desc">Interactive 3D multilayer network with forward inference activation pulses, backprop gradient waves, and dynamic weight pruning.</p>
        </div>
      </div>

      <NeuralNet3D
        exhibit="01"
        title="3D Deep Network Signal & Gradient Propagation"
        caption="Drag to orbit in 3D, switch between Forward Activations and Backward Gradients, prune weak synaptic weights, and scrub layer-by-layer signal propagation."
        layers={[4, 8, 8, 3]}
      />

      <div class="embed-box">
        <span class="embed-label">MDX Embed Snippet:</span>
        <pre class="embed-code"><code>&lt;NeuralNet3D layers={[4, 8, 8, 3]} mode="forward" /&gt;</code></pre>
      </div>
    </section>

    <!-- SHOWCASE 02: 2D LINEAR TRANSFORM -->
    <section class="visual-section">
      <div class="section-header">
        <span class="section-num">02</span>
        <div class="section-title-group">
          <h2 class="section-title">2D Linear Transformation &amp; Grid Warping Engine</h2>
          <p class="section-desc">3Blue1Brown-inspired continuous coordinate plane bending, showing basis vectors î and ĵ, matrix multiplication T(v) = Av, and the determinant det(A).</p>
        </div>
      </div>

      <LinearTransform2D
        exhibit="02"
        title="2D Matrix Linear Transformation & Area Scaling"
        caption="Select matrix presets (Shear, Rotate, Squeeze, Singular) or edit matrix entries directly. The transform interpolates smoothly from the Identity matrix with live determinant tracking."
      />

      <div class="embed-box">
        <span class="embed-label">MDX Embed Snippet:</span>
        <pre class="embed-code"><code>&lt;LinearTransform2D /&gt;</code></pre>
      </div>
    </section>

    <!-- SHOWCASE 03: MATRIX COMPUTE SPREADSHEET -->
    <section class="visual-section">
      <div class="section-header">
        <span class="section-num">03</span>
        <div class="section-title-group">
          <h2 class="section-title">Interactive Matrix Spreadsheet &amp; Neural Compute Engine</h2>
          <p class="section-desc">Modify numerical values in the table grid (Inputs x, Weights W, Bias b) and watch them immediately calculate the dot product z = Wx + b and update the visual neural graph in real time.</p>
        </div>
      </div>

      <MatrixComputeSpreadsheet
        exhibit="03"
        title="Interactive Weight Spreadsheet & Neural Dot Product Engine"
        caption="Click any cell in the table below to edit inputs, weights, or biases. The live neural graph updates edge line thickness, positive/negative colors, node glow intensities, and activation equations in real time."
      />

      <div class="embed-box">
        <span class="embed-label">MDX Embed Snippet:</span>
        <pre class="embed-code"><code>&lt;MatrixComputeSpreadsheet /&gt;</code></pre>
      </div>
    </section>

    <!-- SHOWCASE 04: LINEAR REGRESSION 3B1B MAFS + OBSERVABLE PLOT + UNIVER SPREADSHEET -->
    <section class="visual-section">
      <div class="section-header">
        <span class="section-num">04</span>
        <div class="section-title-group">
          <h2 class="section-title">Linear Regression: 3B1B Vector Plane, Observable Loss, &amp; Univer Spreadsheet</h2>
          <p class="section-desc">Mafs Cartesian vector plane with draggable coordinate points, Observable Plot publication-grade convex loss bowl J(m), live formula bar, and color-linked editable data cells.</p>
        </div>
      </div>

      <LinearRegressionMafs client:visible />

      <div class="embed-box">
        <span class="embed-label">MDX Embed Snippet:</span>
        <pre class="embed-code"><code>&lt;LinearRegressionOLS /&gt;</code></pre>
      </div>
    </section>

    <!-- SHOWCASE 05: DIAGRAM ENGINE COMPARISON (ROUGHJS VS D3 BEZIER) -->
    <section class="visual-section">
      <div class="section-header">
        <span class="section-num">05</span>
        <div class="section-title-group">
          <h2 class="section-title">Diagram Engine Comparison: Rough.js (Excalidraw) vs. D3 G2 Bezier (ByteByteGo)</h2>
          <p class="section-desc">Live side-by-side comparison of the same CPU microarchitecture diagram rendered through algorithmic 2-pass sketch jitter (RoughJS) vs. G2 cubic bezier vector spline cables (D3).</p>
        </div>
      </div>

      <DiagramEngineComparison client:visible />

      <div class="embed-box">
        <span class="embed-label">Interactive Controls:</span>
        <pre class="embed-code"><code>Switch between Side-by-Side, RoughJS (with dynamic roughness/hachure sliders), and D3 publication vector mode.</code></pre>
      </div>
    </section>

    <!-- BENCHMARK & SPECS -->
    <section class="specs-section">
      <h3 class="specs-title">Visual Engine Production Standards</h3>
      <div class="specs-grid">
        <div class="spec-card">
          <span class="spec-badge">BATTERY DEFENSE</span>
          <h4 class="spec-heading">IntersectionObserver Auto-Pause</h4>
          <p class="spec-text">Render loops pause immediately when scrolled out of viewport. 0% CPU/GPU usage when offscreen.</p>
        </div>

        <div class="spec-card">
          <span class="spec-badge">RETINA CRISPNESS</span>
          <h4 class="spec-heading">Dynamic DPR Scaling</h4>
          <p class="spec-text">Internal bitmaps scale by <code>window.devicePixelRatio</code> with context normalization for 4K clarity.</p>
        </div>

        <div class="spec-card">
          <span class="spec-badge">THEME SYNC</span>
          <h4 class="spec-heading">Live CSS Token Bridge</h4>
          <p class="spec-text">Dynamically extracts <code>--accent</code> and <code>--surface-card</code> tokens, updating materials instantly on theme switch.</p>
        </div>

        <div class="spec-card">
          <span class="spec-badge">MEMORY SAFETY</span>
          <h4 class="spec-heading">Context Disposal &amp; Cleanup</h4>
          <p class="spec-text">Disposes geometries, materials, and forces WebGL context loss on unmount to eliminate memory leaks.</p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .lab-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-bottom: var(--space-8);
  }

  .lab-card {
    padding: var(--space-4) var(--space-5);
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
  }

  .intro-card {
    border-left: 3px solid var(--accent);
  }

  .lab-badge-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--space-2);
  }

  .live-dot {
    width: 7px;
    height: 7px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--accent);
  }

  .lab-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .intro-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text);
  }

  .intro-text code {
    font-family: var(--font-mono);
    font-size: 12.5px;
    padding: 2px 5px;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
    border-radius: 4px;
  }

  .visual-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-default);
  }

  .section-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .section-num {
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 800;
    color: var(--accent);
    line-height: 1.2;
  }

  .section-title-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .section-title {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .section-desc {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .embed-box {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border-default);
    border-radius: 6px;
    flex-wrap: wrap;
  }

  .embed-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
  }

  .embed-code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    background: transparent;
    padding: 0;
  }

  .specs-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-default);
  }

  .specs-title {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    color: var(--text);
  }

  .specs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-3);
  }

  .spec-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-3) var(--space-4);
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 8px;
  }

  .spec-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--accent);
  }

  .spec-heading {
    margin: 0;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text);
  }

  .spec-text {
    margin: 0;
    font-size: 12px;
    line-height: 1.45;
    color: var(--text-muted);
  }
</style>
