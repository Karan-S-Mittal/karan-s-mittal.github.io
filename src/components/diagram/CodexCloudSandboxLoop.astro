---
/**
 * CodexCloudSandboxLoop.astro
 * Minimalist architecture diagram of OpenAI Codex's cloud execution loop.
 *
 * Adheres strictly to Soft Architecture & Ciechanowski visual discipline:
 * - Clean white canvas & soft neutral surfaces (var(--ie-canvas), var(--ie-surface)).
 * - Minimal, high-signal tokens and single-line chips (no wordy paragraphs).
 * - Monoline vector Lucide icons (stroke-width={1.5}) & BrandIcon (zero emojis).
 * - Blueprint blue connectors (var(--ie-blue)) with subtle arrowhead markers.
 * - Single constraint node highlighted with rust (var(--ie-rust)) for [APPROVAL].
 * - Standard <VisualAttribution /> box in the bottom right corner.
 */
import {
  Terminal,
  FolderGit2,
  Search,
  SquarePen,
  RefreshCw,
  GitPullRequest,
  ShieldCheck,
  CircleCheck,
  FileCode,
  GitBranch,
  GitFork,
  ArrowRight,
  ArrowDown,
  ArrowLeft,
} from '@lucide/astro';
import BrandIcon from './icons/BrandIcon.astro';
import VisualAttribution from './VisualAttribution.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['codex-loop-root', className]}>
  <div class="codex-loop-canvas diagram-canvas" id="codex-cloud-sandbox-loop">
    <!-- ================= 1. DEVELOPER DISPATCH ================= -->
    <div class="actor-card dispatch-node">
      <div class="card-head">
        <div class="node-icon">
          <Terminal size={15} stroke-width={1.5} />
        </div>
        <div class="node-title-group">
          <h3 class="node-title">Developer / Client</h3>
          <span class="node-role">Issue Orchestrator</span>
        </div>
        <span class="node-badge">CLIENT DISPATCH</span>
      </div>

      <ul class="node-items">
        <li>
          <GitBranch size={13} stroke-width={1.5} class="item-ico" />
          <span class="item-label">
            <code>task-spec</code> Issue context &amp; target requirements
          </span>
        </li>
        <li>
          <GitFork size={13} stroke-width={1.5} class="item-ico" />
          <span class="item-label">
            <code>base-ref</code> Target upstream branch reference
          </span>
        </li>
      </ul>
    </div>

    <!-- Connector: Dispatch -> Sandbox -->
    <div class="blueprint-bridge" aria-hidden="true">
      <div class="stem-wire stem-top"></div>
      <span class="bridge-pill">Dispatch Task Spec</span>
      <div class="stem-wire stem-bottom">
        <svg class="arrow-svg" viewBox="0 0 8 10">
          <path d="M1,2 L4,8 L7,2" fill="none" stroke="var(--ie-blue)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
    </div>

    <!-- ================= 2. CODEX CLOUD SANDBOX ================= -->
    <div class="sandbox-panel">
      <!-- Panel Header -->
      <div class="panel-header">
        <div class="panel-brand">
          <div class="brand-icon-wrap">
            <BrandIcon name="openai" size={15} />
          </div>
          <div class="panel-titles">
            <h3 class="panel-title">OpenAI Codex Cloud Sandbox</h3>
            <span class="panel-role">App-Server Daemon</span>
          </div>
        </div>
        <span class="panel-tag">EPHEMERAL MICROVM</span>
      </div>

      <!-- Stage Flow Stage -->
      <div class="sandbox-flow">
        <!-- ROW 1: Phase 1 & Phase 2 -->
        <div class="flow-row">
          <!-- Phase 1: Workspace Init -->
          <div class="stage-cell">
            <div class="cell-head">
              <div class="cell-icon">
                <FolderGit2 size={14} stroke-width={1.5} />
              </div>
              <h4 class="cell-title">1. Workspace Init</h4>
            </div>
            <ul class="cell-list">
              <li>
                <span class="bullet-dot"></span>
                <span><code>git clone</code> Clean shallow checkout</span>
              </li>
              <li>
                <span class="bullet-dot"></span>
                <span><code>runtime</code> Toolchain &amp; SDK bootstrap</span>
              </li>
            </ul>
          </div>

          <!-- Horizontal Bridge: 1 -> 2 -->
          <div class="step-bridge" aria-hidden="true">
            <span class="bridge-label">clean tree</span>
            <svg class="step-arrow-svg" viewBox="0 0 44 12">
              <line x1="2" y1="6" x2="36" y2="6" stroke="var(--ie-blue)" stroke-width="1.3" />
              <path d="M32,2 L37,6 L32,10" fill="none" stroke="var(--ie-blue)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>

          <!-- Phase 2: Context & Planning -->
          <div class="stage-cell">
            <div class="cell-head">
              <div class="cell-icon">
                <Search size={14} stroke-width={1.5} />
              </div>
              <h4 class="cell-title">2. Context &amp; Plan</h4>
            </div>
            <ul class="cell-list">
              <li>
                <span class="bullet-dot"></span>
                <span><code>AST map</code> Symbol &amp; dependency index</span>
              </li>
              <li>
                <span class="bullet-dot"></span>
                <span><code>plan</code> Execution graph synthesis</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Vertical Transit: 2 -> 3 (Right column drop) -->
        <div class="flow-transit-row" aria-hidden="true">
          <div class="transit-blank"></div>
          <div class="transit-drop-col">
            <div class="mini-stem stem-top"></div>
            <span class="transit-badge">exec plan</span>
            <div class="mini-stem stem-bottom">
              <svg class="drop-arrow-svg" viewBox="0 0 8 10">
                <path d="M1,2 L4,8 L7,2" fill="none" stroke="var(--ie-blue)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          </div>
        </div>

        <!-- ROW 2: Phase 4 (Correction) & Phase 3 (Mutation) -->
        <div class="flow-row">
          <!-- Phase 4: Self-Correction Loop -->
          <div class="stage-cell cell-correction">
            <div class="cell-head">
              <div class="cell-icon icon-correction">
                <RefreshCw size={14} stroke-width={1.5} />
              </div>
              <div class="cell-title-wrap">
                <h4 class="cell-title">4. Self-Correction</h4>
                <span class="cycle-pill">↺ REPAIR</span>
              </div>
            </div>
            <ul class="cell-list">
              <li>
                <span class="bullet-dot dot-rust"></span>
                <span><code>diagnose</code> Compiler stderr &amp; stack</span>
              </li>
              <li>
                <span class="bullet-dot dot-rust"></span>
                <span><code>patch ↺</code> Re-evaluates until green</span>
              </li>
            </ul>
          </div>

          <!-- Bidirectional Feedback Bridge: 4 <-> 3 -->
          <div class="feedback-bridge" aria-hidden="true">
            <div class="feedback-wire wire-fail">
              <span class="wire-tag tag-rust">fail: stderr</span>
              <svg class="wire-svg" viewBox="0 0 54 10">
                <line x1="52" y1="5" x2="8" y2="5" stroke="var(--ie-rust)" stroke-width="1.3" />
                <path d="M11,2 L7,5 L11,8" fill="none" stroke="var(--ie-rust)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <div class="feedback-wire wire-fix">
              <svg class="wire-svg" viewBox="0 0 54 10">
                <line x1="2" y1="5" x2="46" y2="5" stroke="var(--ie-blue)" stroke-width="1.3" />
                <path d="M43,2 L47,5 L43,8" fill="none" stroke="var(--ie-blue)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="wire-tag tag-blue">fix patch</span>
            </div>
          </div>

          <!-- Phase 3: Mutation & Test -->
          <div class="stage-cell cell-highlight">
            <div class="cell-head">
              <div class="cell-icon">
                <SquarePen size={14} stroke-width={1.5} />
              </div>
              <h4 class="cell-title">3. Mutation &amp; Test</h4>
            </div>
            <ul class="cell-list">
              <li>
                <span class="bullet-dot"></span>
                <span><code>mutate</code> Surgical file patch edits</span>
              </li>
              <li>
                <span class="bullet-dot"></span>
                <span><code>test</code> Linter &amp; unit test suites</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Vertical Transit: 3 -> 5 (Center-right drop) -->
        <div class="flow-transit-row transit-to-pkg" aria-hidden="true">
          <div class="transit-pkg-col">
            <div class="mini-stem stem-top"></div>
            <span class="transit-badge badge-green">all tests green ✓</span>
            <div class="mini-stem stem-bottom">
              <svg class="drop-arrow-svg" viewBox="0 0 8 10">
                <path d="M1,2 L4,8 L7,2" fill="none" stroke="var(--ie-blue)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          </div>
        </div>

        <!-- ROW 3: Phase 5 (Full Width Branch & PR Packaging) -->
        <div class="stage-cell stage-cell-full">
          <div class="cell-head">
            <div class="cell-icon">
              <GitPullRequest size={14} stroke-width={1.5} />
            </div>
            <h4 class="cell-title">5. Branch &amp; PR Packaging</h4>
            <span class="full-tag">VERIFIABLE ARTIFACT</span>
          </div>
          <div class="full-cell-grid">
            <div class="full-item">
              <span class="bullet-dot dot-verified"></span>
              <span><code>git push</code> Clean atomic commit branch pushed upstream</span>
            </div>
            <div class="full-item">
              <span class="bullet-dot dot-verified"></span>
              <span><code>pr-diff</code> Synthesizes diff summary &amp; test logs</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Connector: Sandbox -> Review Gate -->
    <div class="blueprint-bridge" aria-hidden="true">
      <div class="stem-wire stem-top"></div>
      <span class="bridge-pill">Pull Request &amp; Diff Summary</span>
      <div class="stem-wire stem-bottom">
        <svg class="arrow-svg" viewBox="0 0 8 10">
          <path d="M1,2 L4,8 L7,2" fill="none" stroke="var(--ie-blue)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
    </div>

    <!-- ================= 3. DEVELOPER REVIEW GATE ================= -->
    <div class="actor-card review-node">
      <div class="card-head">
        <div class="node-icon icon-rust">
          <ShieldCheck size={15} stroke-width={1.5} />
        </div>
        <div class="node-title-group">
          <h3 class="node-title">Developer / Review Gate</h3>
          <span class="node-role">Verification &amp; Merge</span>
        </div>
        <span class="tag-rust">APPROVAL</span>
      </div>

      <ul class="node-items">
        <li>
          <FileCode size={13} stroke-width={1.5} class="item-ico" />
          <span class="item-label">
            <code>diff-review</code> Inspects code diff &amp; test attestations
          </span>
        </li>
        <li>
          <CircleCheck size={13} stroke-width={1.5} class="item-ico" />
          <span class="item-label">
            <code>pr merge</code> Fast-forward squash &amp; upstream merge
          </span>
        </li>
      </ul>
    </div>

    <!-- Visual Attribution Box in Bottom Right -->
    <div class="attribution-wrap">
      <VisualAttribution author="karansmittal" />
    </div>
  </div>
</div>

<style>
  .codex-loop-root {
    width: 100%;
    margin: 0 auto;
    font-family: var(--font-diagram);
    color: var(--ie-ink);
  }

  .codex-loop-canvas {
    position: relative;
    width: 100%;
    background-color: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card);
    padding: clamp(1.25rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
  }

  /* ================= ACTOR NODES (Top & Bottom) ================= */
  .actor-card {
    width: 100%;
    max-width: 680px;
    background: var(--ie-canvas);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card);
    padding: 0.85rem 1.15rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .node-icon {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ie-blue);
    flex-shrink: 0;
  }

  .node-icon.icon-rust {
    color: var(--ie-rust);
  }

  .node-title-group {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .node-title {
    font-size: var(--ie-type-ui);
    font-weight: 600;
    margin: 0;
    line-height: 1.25;
    color: var(--ie-ink);
  }

  .node-role {
    font-size: var(--ie-type-micro);
    color: var(--ie-muted);
    font-family: var(--font-diagram);
    line-height: 1.2;
  }

  .node-badge {
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    font-weight: 500;
    color: var(--ie-muted);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    letter-spacing: 0.03em;
  }

  .tag-rust {
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    font-weight: 600;
    color: var(--ie-rust);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rust);
    padding: 0.1rem 0.45rem;
    border-radius: 3px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .node-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .node-items li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--ie-type-label);
    color: var(--ie-ink-secondary);
  }

  .item-ico {
    color: var(--ie-muted);
    flex-shrink: 0;
  }

  .item-label {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    white-space: nowrap;
  }

  .actor-card code,
  .stage-cell code {
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    padding: 0.05rem 0.3rem;
    border-radius: 4px;
    color: var(--ie-ink);
    white-space: nowrap;
  }

  /* ================= BLUEPRINT BRIDGES ================= */
  .blueprint-bridge {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 680px;
    margin: 0.15rem 0;
  }

  .stem-wire {
    width: 1.5px;
    background: var(--ie-blue);
  }

  .stem-top {
    height: 8px;
  }

  .stem-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 12px;
  }

  .arrow-svg {
    width: 8px;
    height: 10px;
    display: block;
  }

  .bridge-pill {
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    color: var(--ie-muted);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    padding: 0.1rem 0.6rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  /* ================= CODEX CLOUD SANDBOX PANEL ================= */
  .sandbox-panel {
    width: 100%;
    max-width: 680px;
    background: var(--ie-canvas);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card);
    padding: 1.15rem 1.25rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--ie-rule);
  }

  .panel-brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .brand-icon-wrap {
    width: 26px;
    height: 26px;
    border-radius: var(--radius-sm);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-openai);
    flex-shrink: 0;
  }

  .panel-titles {
    display: flex;
    flex-direction: column;
  }

  .panel-title {
    margin: 0;
    font-size: var(--ie-type-ui);
    font-weight: 600;
    color: var(--ie-ink);
    line-height: 1.25;
  }

  .panel-role {
    font-size: var(--ie-type-micro);
    color: var(--ie-muted);
    line-height: 1.2;
  }

  .panel-tag {
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    color: var(--ie-muted);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-pill);
    letter-spacing: 0.03em;
  }

  /* ================= STAGE FLOW PIPELINE ================= */
  .sandbox-flow {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .flow-row {
    display: grid;
    grid-template-columns: 1fr 76px 1fr;
    align-items: center;
  }

  .stage-cell {
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: 6px;
    padding: 0.75rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    box-sizing: border-box;
  }

  .stage-cell-full {
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: 6px;
    padding: 0.75rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .full-tag {
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    color: var(--ie-muted);
    background: var(--ie-canvas);
    border: 1px solid var(--ie-rule);
    padding: 0.05rem 0.35rem;
    border-radius: 3px;
    letter-spacing: 0.03em;
    margin-left: auto;
  }

  .full-cell-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    font-size: var(--ie-type-label);
    color: var(--ie-ink-secondary);
  }

  .full-item {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .cell-head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .cell-icon {
    color: var(--ie-ink-secondary);
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .icon-correction {
    color: var(--ie-rust);
  }

  .cell-title {
    margin: 0;
    font-size: var(--ie-type-label);
    font-weight: 600;
    color: var(--ie-ink);
    white-space: nowrap;
  }

  .cell-title-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 1;
    gap: 0.35rem;
  }

  .cycle-pill {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    color: var(--ie-rust);
    background: var(--ie-canvas);
    border: 1px solid var(--ie-rust);
    padding: 0.05rem 0.3rem;
    border-radius: 3px;
    white-space: nowrap;
    letter-spacing: 0.03em;
  }

  .cell-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cell-list li {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: var(--ie-type-label);
    color: var(--ie-ink-secondary);
    line-height: 1.3;
  }

  .bullet-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--ie-muted);
    flex-shrink: 0;
    margin-top: 0.4rem;
  }

  .dot-rust {
    background: var(--ie-rust);
  }

  .dot-verified {
    background: var(--ie-verified);
  }

  /* Bridges */
  .step-bridge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    width: 76px;
  }

  .bridge-label {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    color: var(--ie-muted);
    white-space: nowrap;
  }

  .step-arrow-svg {
    width: 56px;
    height: 12px;
    display: block;
  }

  /* Vertical transit */
  .flow-transit-row {
    display: grid;
    grid-template-columns: 1fr 76px 1fr;
    height: 36px;
    align-items: center;
  }

  .transit-drop-col {
    grid-column: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  .mini-stem {
    width: 1.5px;
    background: var(--ie-blue);
  }

  .mini-stem.stem-top {
    height: 5px;
  }

  .mini-stem.stem-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 10px;
  }

  .drop-arrow-svg {
    width: 8px;
    height: 10px;
    display: block;
  }

  .transit-badge {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    color: var(--ie-muted);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    padding: 0.05rem 0.4rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    line-height: 1.2;
  }

  .badge-green {
    color: var(--ie-verified);
    border-color: var(--ie-rule);
  }

  .transit-to-pkg {
    display: flex;
    justify-content: center;
    height: 36px;
  }

  .transit-pkg-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  /* Feedback bridge between 4 and 3 */
  .feedback-bridge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    width: 76px;
