---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/content/PageHeader.astro';
import VisualBlueprintCard from '@components/visuals/VisualBlueprintCard.astro';

interface VisualItem {
  id: string;
  title: string;
  desc: string;
  category: string;
  archetype?: 'loop' | 'pipeline' | 'memory' | 'tree' | 'hierarchy' | 'comparison';
  href: string;
}

// Auto-discover all visual pages in this directory
const rawPages = import.meta.glob<string>('./*.astro', { query: '?raw', import: 'default', eager: true });

// Curated metadata and archetype mapping for established visuals
const curatedMeta: Record<string, { title?: string; desc?: string; category?: string; archetype?: 'loop' | 'pipeline' | 'memory' | 'tree' | 'hierarchy' | 'comparison' }> = {
  'platform-stack': {
    title: 'Developer Platform Stack Hierarchy',
    desc: 'The four-tier functional architecture of modern code hosting: SCM Merkle DAGs, collaboration ACLs, automated CI runners, and ephemeral cloud IDEs.',
    category: 'SYSTEMS ARCHITECTURE',
    archetype: 'hierarchy',
  },
  'code-review-topologies': {
    title: 'Three Code Review Topologies',
    desc: 'Comparative architectural breakdown: Branch PRs vs Gerrit/Sapling Stacked Changes vs Linux Kernel Patch-over-email.',
    category: 'REVIEW PROTOCOLS',
    archetype: 'comparison',
  },
};

const preferredOrder: string[] = ['platform-stack', 'code-review-topologies'];

const visuals: VisualItem[] = Object.entries(rawPages)
  .filter(([path]) => !path.endsWith('index.astro'))
  .map(([path, rawContent]) => {
    const slug = path.replace(/^\.\//, '').replace(/\.astro$/, '');
    const curated = curatedMeta[slug] || {};

    const titleMatch = rawContent.match(/const\s+title\s*=\s*['"`]([^'"`]+)['"`]/);
    const descMatch = rawContent.match(/const\s+(?:caption|description)\s*=\s*['"`]([^'"`]+)['"`]/);

    const title = curated.title || (titleMatch ? titleMatch[1] : slug.replace(/-/g, ' '));
    const desc = curated.desc || (descMatch ? descMatch[1] : '');
    const category = curated.category || 'SYSTEMS ARCHITECTURE';
    const archetype = curated.archetype || 'pipeline';

    return {
      id: slug,
      title,
      desc,
      category,
      archetype,
      href: `/visuals/${slug}/`,
    };
  })
  .sort((a, b) => {
    const idxA = preferredOrder.indexOf(a.id);
    const idxB = preferredOrder.indexOf(b.id);
    if (idxA !== -1 && idxB !== -1) return idxA - idxB;
    if (idxA !== -1) return -1;
    if (idxB !== -1) return 1;
    return a.title.localeCompare(b.title);
  });
---

<Layout
  title="Visuals & Systems Blueprints | Karan Mittal"
  description="A catalog of systems architecture diagrams, comparative chronologies, and memory models. Inspect and download each visual as an image."
>
  <main class="visuals-page">
    <div class="container page-shell">
      <PageHeader
        label="Visual Library"
        title="Visuals & Systems Blueprints."
        description="A collection of systems architecture diagrams, comparative chronologies, and memory models. Every visual can be inspected in full and exported as a 3× high-resolution PNG."
        count={visuals.length}
        countLabel="systems visuals"
      />

      {visuals.length > 0 ? (
        <>
          <div class="search-bar-wrap">
            <input
              type="search"
              id="visual-search"
              placeholder="Filter visuals by keyword, topic, or technology..."
              aria-label="Filter visuals"
            />

            <div class="archetype-filter-bar" role="tablist" aria-label="Filter by system archetype">
              <button type="button" class="filter-pill active" data-filter="all" role="tab" aria-selected="true">All ({visuals.length})</button>
              <button type="button" class="filter-pill" data-filter="loop" role="tab" aria-selected="false">Loops & Harnesses</button>
              <button type="button" class="filter-pill" data-filter="memory" role="tab" aria-selected="false">Memory & Paging</button>
              <button type="button" class="filter-pill" data-filter="hierarchy" role="tab" aria-selected="false">Topologies & Swarms</button>
              <button type="button" class="filter-pill" data-filter="comparison" role="tab" aria-selected="false">Comparisons</button>
              <button type="button" class="filter-pill" data-filter="tree" role="tab" aria-selected="false">Evolution Trees</button>
            </div>
          </div>

          <div class="visuals-grid" id="visuals-grid">
            {visuals.map((v, i) => (
              <VisualBlueprintCard
                slug={v.id}
                index={i + 1}
                title={v.title}
                desc={v.desc}
                category={v.category}
                href={v.href}
                archetype={v.archetype}
              />
            ))}
          </div>

          <p id="no-results" class="no-results" style="display: none;">
            No visuals match your filter.
          </p>
        </>
      ) : (
        <div class="empty-visuals-state">
          <p>No architecture visuals published yet. Starting afresh.</p>
          <p class="empty-subtext">Add standalone visuals in <code>src/pages/visuals/</code> using the diagram-craft workflow.</p>
        </div>
      )}
    </div>
  </main>
</Layout>

<script>
  const searchInput = document.getElementById('visual-search') as HTMLInputElement | null;
  const filterPills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const cards = document.querySelectorAll<HTMLElement>('.visual-card');
  const noResults = document.getElementById('no-results');

  let currentArchetype = 'all';
  let currentSearch = '';

  function applyFilters() {
    let visibleCount = 0;

    cards.forEach((card) => {
      const text = card.dataset.search || '';
      const archetype = card.dataset.archetype || '';

      const matchesSearch = !currentSearch || text.includes(currentSearch);
      const matchesArchetype = currentArchetype === 'all' || archetype === currentArchetype || (currentArchetype === 'loop' && (archetype === 'pipeline' || archetype === 'loop'));

      const isVisible = matchesSearch && matchesArchetype;
      card.style.display = isVisible ? 'flex' : 'none';
      if (isVisible) visibleCount++;
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      currentSearch = searchInput.value.trim().toLowerCase();
      applyFilters();
    });
  }

  filterPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      filterPills.forEach((p) => {
        p.classList.remove('active');
        p.setAttribute('aria-selected', 'false');
      });
      pill.classList.add('active');
      pill.setAttribute('aria-selected', 'true');
      currentArchetype = pill.dataset.filter || 'all';
      applyFilters();
    });
  });
</script>

<style>
  .visuals-page {
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }

  .page-shell {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 var(--space-5, 1.5rem);
  }

  .search-bar-wrap {
    margin: 1.5rem 0 2rem;
  }

  .search-bar-wrap input {
    width: 100%;
    padding: 0.75rem 1rem;
    font-family: var(--font-diagram);
    font-size: var(--ie-type-ui);
    color: var(--ie-ink);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius);
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.15s ease;
  }

  .search-bar-wrap input:focus {
    border-color: var(--ie-blue);
  }

  .archetype-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.85rem;
  }

  .filter-pill {
    padding: 0.35rem 0.75rem;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-sm, 4px);
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    font-weight: 500;
    color: var(--ie-muted);
    cursor: pointer;
    transition: all var(--transition-fast, 150ms ease);
  }

  .filter-pill:hover {
    border-color: var(--ie-blue);
    color: var(--ie-ink);
  }

  .filter-pill.active {
    background: var(--ie-blue);
    border-color: var(--ie-blue);
    color: var(--ie-canvas);
    font-weight: 600;
  }

  /* Responsive Visual Blueprint Grid */
  .visuals-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .no-results {
    padding: 3rem 0;
    text-align: center;
    color: var(--ie-muted);
    font-family: var(--font-diagram);
    font-size: var(--ie-type-body);
  }

  @media (max-width: 640px) {
    .visuals-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  .empty-visuals-state {
    padding: 3rem 0;
    color: var(--ie-muted);
    font-family: var(--font-diagram);
    font-size: var(--ie-type-body);
  }
  .empty-subtext {
    margin-top: 0.5rem;
    font-size: var(--ie-type-ui);
    color: var(--ie-ink-secondary);
  }
  .empty-subtext code {
    font-family: var(--font-mono);
    padding: 0.1rem 0.35rem;
    background: var(--ie-surface-raised);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-sm);
  }
</style>
