---
import { engagements } from '../../data/practice';
---

<div class="engagement-briefs-list">
  {engagements.map((item, index) => (
    <article class="engagement-brief-card" id={item.id}>
      <header class="brief-card-header">
        <div class="brief-meta">
          <span class="brief-index">{String(index + 1).padStart(2, '0')}</span>
          <span class="brief-label">{item.label}</span>
          <span class="brief-operating-model">{item.operatingModel}</span>
        </div>
        <h3 class="brief-title">{item.title}</h3>
      </header>

      <dl class="brief-specs">
        <div class="brief-field">
          <dt>Problem</dt>
          <dd>{item.problem}</dd>
        </div>
        <div class="brief-field">
          <dt>Constraint</dt>
          <dd>{item.constraint}</dd>
        </div>
        <div class="brief-field">
          <dt>Intervention</dt>
          <dd>{item.intervention}</dd>
        </div>
        <div class="brief-field">
          <dt>Outcome</dt>
          <dd>{item.outcome}</dd>
        </div>
        <div class="brief-field highlight">
          <dt>Responsibility</dt>
          <dd>{item.responsibility}</dd>
        </div>
      </dl>
    </article>
  ))}
</div>

<style>
  .engagement-briefs-list {
    display: grid;
    gap: 1.75rem;
    margin-top: 1.5rem;
  }

  .engagement-brief-card {
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 8px);
    background: var(--ie-surface);
    transition: border-color 150ms ease;
  }

  .engagement-brief-card:hover {
    border-color: var(--ie-rule-strong);
  }

  .brief-card-header {
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--ie-rule);
  }

  .brief-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.85rem;
    margin-bottom: 0.5rem;
  }

  .brief-index {
    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    font-weight: 700;
  }

  .brief-label {
    color: var(--ie-blue);
    font-family: var(--font-sans);
    font-size: var(--ie-type-label);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .brief-operating-model {
    margin-left: auto;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-pill, 999px);
    background: var(--ie-surface-raised);
    color: var(--ie-ink-secondary);
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    letter-spacing: 0.03em;
  }

  .brief-title {
    margin: 0;
    color: var(--ie-ink);
    font-family: var(--font-display);
    font-size: var(--ie-type-h3);
    line-height: 1.25;
  }

  .brief-specs {
    margin: 0;
    display: grid;
    gap: 0.85rem;
  }

  .brief-field {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
  }

  .brief-field dt {
    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .brief-field dd {
    margin: 0;
    color: var(--ie-ink-secondary);
    font-family: var(--font-sans);
    font-size: var(--ie-type-ui);
    line-height: 1.55;
  }

  .brief-field.highlight {
    padding-top: 0.65rem;
    border-top: 1px dashed var(--ie-rule);
  }

  .brief-field.highlight dt {
    color: var(--ie-blue);
  }

  .brief-field.highlight dd {
    color: var(--ie-ink);
    font-weight: 500;
  }

  @media (max-width: 680px) {
    .brief-field {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .brief-operating-model {
      margin-left: 0;
    }
  }
</style>
