---
import InteractiveWalkthrough from '../InteractiveWalkthrough.astro';

interface Props {
  caption?: string;
  exhibit?: string;
  title?: string;
}

const { caption, exhibit, title } = Astro.props;

const stages = [
  {
    id: 's1',
    index: '01',
    name: 'Logical blocks',
    desc: '<strong>Step 1 (Logical Slicing):</strong> The sequence is divided into fixed-size logical blocks ($B=4$). Slots fill token-by-token without pre-allocating unused future slots.',
    targetGroup: 'step-group-s1',
  },
  {
    id: 's2',
    index: '02',
    name: 'Block table',
    desc: '<strong>Step 2 (Page Translation):</strong> A lightweight block table maps each logical block index ($O(1)$ lookup) to its assigned physical GPU frame number.',
    targetGroup: 'step-group-s2',
  },
  {
    id: 's3',
    index: '03',
    name: 'GPU frames',
    desc: '<strong>Step 3 (Scattered Allocation):</strong> Physical frames are allocated non-contiguously across GPU VRAM. Only the final block has partial-fill overhead.',
    targetGroup: 'step-group-s3',
  },
  {
    id: 's4',
    index: '04',
    name: 'Kernel gather',
    desc: '<strong>Step 4 (In-Kernel Gather):</strong> The custom CUDA attention kernel reads the block table directly to fetch scattered blocks into <code>__shared__</code> memory without materializing contiguous copies.',
    targetGroup: 'step-group-s4',
  },
];
---

<InteractiveWalkthrough
  exhibit={exhibit}
  title={title}
  badge="PAGEDATTENTION ARCHITECTURE"
  caption={caption}
  allStageName="Full architecture"
  allStageDesc="<strong>End-to-End PagedAttention:</strong> Logical token streams map through a lightweight Block Table into scattered GPU VRAM physical frames, which the custom CUDA kernel gathers directly during self-attention."
  stages={stages}
  wide={true}
>
  <svg id="ex-paged-steps-svg" class="ex-svg-canvas sys-diagram" viewBox="0 0 720 330" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="A four stage PagedAttention model showing logical token blocks, a block table, scattered physical frames, and an in-kernel gather.">
    <defs>
      <marker id="paged-arr-2" markerWidth="7" markerHeight="6" refX="6" refY="3" orient="auto"><polygon points="0 0, 7 3, 0 6" fill="var(--text)" /></marker>
      <marker id="paged-arr-blue-2" markerWidth="7" markerHeight="6" refX="6" refY="3" orient="auto"><polygon points="0 0, 7 3, 0 6" fill="var(--accent)" /></marker>
    </defs>

    <!-- STEP 1: LOGICAL BLOCKS -->
    <g id="step-group-s1" data-step-group="step-group-s1" class="step-group">
      <text x="18" y="16" class="label-signal" dominant-baseline="central">01 / LOGICAL BLOCKS</text>
      <rect x="18" y="32" width="148" height="240" rx="6" class="node" />
      <text x="30" y="54" class="title" font-size="13.5" dominant-baseline="central">Token Stream</text>
      <text x="30" y="70" class="label" font-size="8.5" dominant-baseline="central">BLOCK SIZE B = 4</text>

      <!-- Block 00 -->
      <rect x="28" y="86" width="128" height="62" rx="4" class="node-muted" />
      <text x="36" y="102" class="label-signal" font-size="8.5" dominant-baseline="central">LOGICAL BLOCK #0</text>
      <text x="36" y="120" class="body" font-size="10.5" dominant-baseline="central">["The", "quick",</text>
      <text x="36" y="135" class="body" font-size="10.5" dominant-baseline="central"> "brown", "fox"]</text>

      <!-- Block 01 -->
      <rect x="28" y="156" width="128" height="62" rx="4" class="node-signal" />
      <text x="36" y="172" class="label-signal" font-size="8.5" dominant-baseline="central">LOGICAL BLOCK #1</text>
      <text x="36" y="190" class="body" font-size="10.5" dominant-baseline="central">["jumps", "over",</text>
      <text x="36" y="205" class="body" font-size="10.5" dominant-baseline="central"> "lazy", ...]</text>

      <text x="92" y="254" class="label" text-anchor="middle" font-size="8.5" dominant-baseline="central">O(1) append/token</text>
    </g>

    <!-- Connector S1 -> S2 -->
    <path id="conn-s1-s2" data-step-connector="conn-s1-s2" d="M 166 152 H 192" class="flow-signal" marker-end="url(#paged-arr-blue-2)" />

    <!-- STEP 2: BLOCK TABLE -->
    <g id="step-group-s2" data-step-group="step-group-s2" class="step-group">
      <text x="198" y="16" class="label-signal" dominant-baseline="central">02 / BLOCK TABLE</text>
      <rect x="198" y="32" width="148" height="240" rx="6" class="node-signal" />
      <text x="210" y="54" class="title" font-size="13.5" dominant-baseline="central">Page Table</text>
      <text x="210" y="70" class="label" font-size="8.5" dominant-baseline="central">LOGICAL → PHYSICAL</text>

      <!-- Mapping Row 1 -->
      <g transform="translate(208, 86)">
        <rect x="0" y="0" width="128" height="52" rx="4" class="node" />
        <text x="8" y="18" class="label" font-size="8.5" dominant-baseline="central">BLOCK #00</text>
        <text x="8" y="36" class="body" font-weight="600" font-size="11" dominant-baseline="central">→ FRAME #12</text>
        <rect x="82" y="8" width="38" height="18" rx="3" fill="var(--ex-blue-bg)" />
        <text x="101" y="17" class="label-signal" font-size="7.5" text-anchor="middle" dominant-baseline="central">FULL</text>
      </g>

      <!-- Mapping Row 2 -->
      <g transform="translate(208, 146)">
        <rect x="0" y="0" width="128" height="52" rx="4" class="node" />
        <text x="8" y="18" class="label" font-size="8.5" dominant-baseline="central">BLOCK #01</text>
        <text x="8" y="36" class="body" font-weight="600" font-size="11" dominant-baseline="central">→ FRAME #04</text>
        <rect x="82" y="8" width="38" height="18" rx="3" fill="var(--ex-blue-bg)" />
        <text x="101" y="17" class="label-signal" font-size="7.5" text-anchor="middle" dominant-baseline="central">ACTIVE</text>
      </g>

      <text x="272" y="254" class="label-signal" text-anchor="middle" font-size="8.5" dominant-baseline="central">O(1) index lookup</text>
    </g>

    <!-- Connector S2 -> S3 -->
    <path id="conn-s2-s3" data-step-connector="conn-s2-s3" d="M 346 152 H 372" class="flow-signal" marker-end="url(#paged-arr-blue-2)" />

    <!-- STEP 3: PHYSICAL GPU POOL -->
    <g id="step-group-s3" data-step-group="step-group-s3" class="step-group">
      <text x="378" y="16" class="label-signal" dominant-baseline="central">03 / GPU VRAM POOL</text>
      <rect x="378" y="32" width="160" height="240" rx="6" class="node" />
      <text x="390" y="54" class="title" font-size="13.5" dominant-baseline="central">Scattered Frames</text>
      <text x="390" y="70" class="label" font-size="8.5" dominant-baseline="central">NON-CONTIGUOUS</text>

      <!-- Frame Grid -->
      <g transform="translate(388, 86)">
        <rect x="0" y="0" width="140" height="30" rx="4" class="node-signal" />
        <text x="10" y="15" class="label-signal" font-size="8.5" dominant-baseline="central">FRAME #04 · Blk 01</text>

        <rect x="0" y="36" width="140" height="30" rx="4" class="node-muted" />
        <text x="10" y="51" class="label" font-size="8.5" dominant-baseline="central">FRAME #08 · Other</text>

        <rect x="0" y="72" width="140" height="30" rx="4" class="node-signal" />
        <text x="10" y="87" class="label-signal" font-size="8.5" dominant-baseline="central">FRAME #12 · Blk 00</text>

        <rect x="0" y="108" width="140" height="26" rx="4" class="node-muted" />
        <text x="10" y="121" class="label" font-size="8" dominant-baseline="central">FRAME #16 · Free</text>
      </g>

      <text x="458" y="254" class="label" text-anchor="middle" font-size="8.5" dominant-baseline="central">~0% internal waste</text>
    </g>

    <!-- Connector S3 -> S4 -->
    <path id="conn-s3-s4" data-step-connector="conn-s3-s4" d="M 538 152 H 564" class="flow-signal" marker-end="url(#paged-arr-blue-2)" />

    <!-- STEP 4: CUDA KERNEL GATHER -->
    <g id="step-group-s4" data-step-group="step-group-s4" class="step-group">
      <text x="570" y="16" class="label-signal" dominant-baseline="central">04 / CUDA GATHER</text>
      <rect x="570" y="32" width="132" height="240" rx="6" class="node-signal" />
      <text x="582" y="54" class="title" font-size="13.5" dominant-baseline="central">Warp Gather</text>
      <text x="582" y="70" class="label-signal" font-size="8.5" dominant-baseline="central">IN-KERNEL FUSION</text>

      <!-- Kernel steps -->
      <g transform="translate(578, 86)">
        <rect x="0" y="0" width="116" height="36" rx="4" class="node" />
        <text x="8" y="12" class="label" font-size="7.5" dominant-baseline="central">1. READ POINTERS</text>
        <text x="8" y="25" class="label-signal" font-size="7.5" dominant-baseline="central">from Block Table</text>

        <rect x="0" y="42" width="116" height="36" rx="4" class="node" />
        <text x="8" y="54" class="label" font-size="7.5" dominant-baseline="central">2. LOAD BLOCKS</text>
        <text x="8" y="67" class="label-signal" font-size="7.5" dominant-baseline="central">into shared SRAM</text>

        <rect x="0" y="84" width="116" height="36" rx="4" class="node-signal" />
        <text x="8" y="96" class="label-signal" font-size="7.5" dominant-baseline="central">3. ATTENTION DOT</text>
        <text x="8" y="109" class="label-signal" font-size="7.5" dominant-baseline="central">Q · Kᵀ no copy</text>
      </g>

      <text x="636" y="254" class="label-signal" text-anchor="middle" font-size="8.5" dominant-baseline="central">Zero mem-copy</text>
    </g>

    <!-- Footer note -->
    <text x="18" y="304" class="body-muted" font-size="11.5" dominant-baseline="central">Only the lightweight Block Table is contiguous in memory. Physical KV cache frames can live anywhere in the GPU pool.</text>
  </svg>
</InteractiveWalkthrough>
