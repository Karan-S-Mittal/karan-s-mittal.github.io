---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/portfolio/PageHeader.astro';
import Icon from '../components/chrome/Icon.astro';
import StudioPanel from '../components/chrome/StudioPanel.astro';
import communitiesData from '../data/communities.json';

const { communities } = communitiesData;
---

<Layout title="About | Karan Mittal">
  <main class="container">
    <PageHeader
      label="§04 About"
      title="Karan Mittal"
      description="AI systems architect, founder, and community builder working on dependable knowledge and inference systems."
    />

    <div class="about-intro">
      <div class="about-portrait-frame">
        <img class="about-portrait" src="/profile-400.jpg" alt="Karan Mittal speaking at a technical event" width="400" height="400" />
      </div>
      <div>
        <blockquote class="hero-quote">
          “The difficult part of an engineering problem is rarely the tool. It is designing a system people can rely on.”
        </blockquote>

        <p class="bio">
          I am an AI Systems Architect and co-founder of <a href="https://dextar.co">Dextar</a>. I work with teams
          turning uncertain data and AI work into systems with clear boundaries, inspectable evidence, explicit
          constraints, and a path to production. My experience spans life sciences, semiconductor supply chains,
          and finance; my current focus includes knowledge systems, AI reliability, and performance engineering.
        </p>

        <nav class="local-nav">
          <a href="#now">Now</a>
          <span class="nav-sep">·</span>
          <a href="#capabilities">Practice</a>
          <span class="nav-sep">·</span>
          <a href="#community">Community</a>
        </nav>
      </div>
    </div>

    <section id="now">
      <h2>Now</h2>
      <p class="section-desc">A living snapshot of current focus, updated periodically.</p>
      <div class="now-grid">
        <StudioPanel title="Work" index="01" state="signal">
          <Icon slot="icon" name="briefcase" size={15} />
          <ul>
            <li>Co-founding and leading engineering at <a href="https://dextar.co">Dextar.co</a></li>
            <li>Architecting production GraphRAG systems for enterprise clients</li>
            <li>Consulting on MLOps infrastructure and GPU cluster optimisation</li>
          </ul>
        </StudioPanel>

        <StudioPanel title="Building" index="02" state="model">
          <Icon slot="icon" name="wrench" size={15} />
          <ul>
            <li>An open-source deterministic RAG evaluation harness</li>
            <li>A CUDA optimisation pattern cookbook for ML inference</li>
            <li>This blog and my GitHub presence</li>
          </ul>
        </StudioPanel>

        <StudioPanel title="Learning" index="03" state="verified">
          <Icon slot="icon" name="book-open" size={15} />
          <ul>
            <li>Advanced Rust for systems programming</li>
            <li>CPU/GPU co-design patterns for edge LLM inference</li>
          </ul>
        </StudioPanel>

        <StudioPanel title="Speaking" index="04" state="signal">
          <Icon slot="icon" name="mic" size={15} />
          <ul>
            <li>Preparing talks on GraphRAG and deterministic retrieval for 2026</li>
            <li><a href="/talks" class="arrow-link">View all talks and events<span class="arrow" aria-hidden="true">→</span></a></li>
          </ul>
        </StudioPanel>
      </div>
      <p class="now-footer">
        Last updated: August 2026 · <a href="https://nownownow.com/about">What is a /now page?</a>
      </p>
    </section>

    <section id="capabilities">
      <h2>Engineering practice</h2>
      <div class="capabilities-list">
        <div class="capability">
          <h3>AI Architecture</h3>
          <p>Knowledge systems, retrieval contracts, graph-aware discovery, LLM orchestration</p>
        </div>
        <div class="capability">
          <h3>Performance</h3>
          <p>Inference paths, model and hardware trade-offs, observability, low-latency delivery</p>
        </div>
        <div class="capability">
          <h3>Infrastructure</h3>
          <p>Production MLOps, Kubernetes, cloud-native systems, evaluation and operational guardrails</p>
        </div>
        <div class="capability">
          <h3>Leadership</h3>
          <p>Technical strategy, engineering team building, stakeholder alignment, durable handover</p>
        </div>
      </div>
    </section>

    <section id="community">
      <h2>Community</h2>
      <p class="section-desc">I organise and mentor across several technical communities in Central India.</p>
      <div class="community-list">
        {communities.map((c) => (
          <div class="community-row">
            <img src={c.logo} alt={c.name} class="community-logo" />
            <div class="community-info">
              <p class="community-name">{c.name}</p>
              <p class="community-desc">{c.description}</p>
            </div>
            {c.links && c.links.length > 0 && (
              <div class="community-links">
                {c.links.map((link: { label: string; url: string }) => (
                  <a href={link.url} target="_blank" rel="noopener">
                    {link.label}
                    <Icon name="arrow-up-right" size={12} />
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="cta-section">
      <h2>Let's build</h2>
      <p>For consulting engagements involving complex data, AI reliability, system performance, or technical strategy.</p>
      <div class="cta-actions">
        <a href="/#contact" class="cta-link arrow-link">Discuss an engagement<span class="arrow" aria-hidden="true">→</span></a>
        <a href="https://www.linkedin.com/in/karansmittal/" class="cta-link arrow-link">LinkedIn<span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</Layout>

<style>
  main.container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 var(--space-5) var(--space-9);
  }

  .about-intro {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
    margin-bottom: var(--space-8);
  }
  .about-portrait-frame {
    width: 220px;
    height: 260px;
    border-radius: 110px 110px 14px 14px;
    overflow: hidden;
    background: var(--surface-subtle);
    border: 1px solid var(--border-default);
    box-shadow: var(--shadow-card);
  }
  .about-portrait {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(100%) contrast(1.05);
    transition: filter var(--transition-slow);
  }
  .about-portrait-frame:hover .about-portrait {
    filter: grayscale(20%) contrast(1.02);
  }

  .hero-quote {
    margin: 0 0 var(--space-5);
    padding: 0;
    border: none;
    background: none;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 500;
    font-style: italic;
    color: var(--text);
    line-height: 1.35;
    letter-spacing: -0.015em;
  }
  .bio {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-6);
    max-width: 680px;
  }
  .bio a {
    color: var(--accent);
    text-decoration: none;
  }
  .bio a:hover {
    text-decoration: underline;
  }

  .local-nav {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .local-nav a {
    color: var(--accent);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .local-nav a:hover {
    color: var(--accent-hover);
  }
  .nav-sep {
    color: var(--border-default);
  }

  /* Section Headings */
  section {
    padding-top: var(--space-8);
  }
  section h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--text);
    margin: 0 0 var(--space-2);
  }
  .section-desc {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 var(--space-6);
  }

  .now-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
    margin-bottom: var(--space-5);
  }
  .now-grid :global(.studio-panel) {
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }
  .now-grid ul {
    margin: 0;
    padding-left: var(--space-4);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.65;
  }
  .now-grid li {
    margin-bottom: var(--space-2);
  }
  .now-grid a {
    color: var(--accent);
    text-decoration: none;
  }
  .now-grid a:hover {
    text-decoration: underline;
  }
  .now-footer {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    margin: var(--space-3) 0 0;
  }
  .now-footer a {
    color: var(--accent);
  }

  .capabilities-list {
    border-top: 1px solid var(--border-default);
  }
  .capability {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border-default);
  }
  .capability h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--text);
  }
  .capability p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .community-list {
    border-top: 1px solid var(--border-default);
  }
  .community-row {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--border-default);
  }
  .community-logo {
    display: block;
    width: 2.75rem;
    height: 2.75rem;
    object-fit: contain;
    margin: 0;
    border-radius: var(--radius-sm);
  }
  .community-info {
    min-width: 0;
  }
  .community-name {
    font-family: var(--font-serif);
    font-weight: 500;
    color: var(--text);
    margin: 0 0 var(--space-1);
    font-size: 1.15rem;
  }
  .community-desc {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .community-links {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .community-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .community-links a:hover {
    color: var(--accent-hover);
    text-decoration: none;
  }

  .cta-section {
    margin-top: var(--space-9);
    padding: var(--space-8) var(--space-7);
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }
  .cta-section h2 {
    font-family: var(--font-serif);
    margin-top: 0;
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    font-weight: 500;
    margin-bottom: var(--space-2);
  }
  .cta-section p {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: var(--space-5);
    max-width: 540px;
  }
  .cta-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    align-items: center;
  }
  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
  }
  .cta-link:hover {
    color: var(--accent-hover);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    main.container {
      padding: 0 var(--space-4) var(--space-8);
    }
    .about-intro {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .about-portrait-frame {
      width: 140px;
      height: 160px;
      border-radius: 70px 70px 10px 10px;
    }
    .now-grid {
      grid-template-columns: 1fr;
    }
    .capability {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .community-row {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }
    .community-links {
      grid-column: 2;
      justify-content: flex-start;
    }
  }
</style>
