          <text x="8" y="20" font-family="var(--font-mono)" font-size="11" font-weight="600" fill="var(--ex-blue-text)">Blk #0 ──►</text>
          <text x="8" y="38" font-family="var(--font-mono)" font-size="12" font-weight="700" fill="var(--ex-blue-text)">Frame #12</text>
        </g>

        <!-- Entry 1 -->
        <g transform="translate(10, 203)">
          <rect x="0" y="0" width="130" height="48" rx="6" fill="var(--ex-indigo-bg)" stroke="var(--ex-indigo-stroke)" stroke-width="1" />
          <text x="8" y="20" font-family="var(--font-mono)" font-size="11" font-weight="600" fill="var(--ex-indigo-text)">Blk #1 ──►</text>
          <text x="8" y="38" font-family="var(--font-mono)" font-size="12" font-weight="700" fill="var(--ex-indigo-text)">Frame #04</text>
        </g>
      </g>
    </g>

    <!-- Connector S2 -> S3 -->
    <path id="conn-s2-s3-a" d="M 365 112 C 390 112, 390 285, 410 285" stroke="var(--ex-blue-stroke)" stroke-width="1.5" stroke-dasharray="3 3" marker-end="url(#ex-arrow-s1)" />
    <path id="conn-s2-s3-b" d="M 365 267 C 385 267, 390 112, 410 112" stroke="var(--ex-indigo-stroke)" stroke-width="1.5" stroke-dasharray="3 3" marker-end="url(#ex-arrow-s2)" />

    <!-- ==================================================== -->
    <!-- STAGE 3: NON-CONTIGUOUS GPU HBM MEMORY POOL -->
    <!-- ==================================================== -->
    <g id="step-group-s3" class="step-group">
      <text x="420" y="24" font-family="var(--font-sans)" font-size="13" font-weight="700" fill="var(--ex-green-text)">
        3. GPU HBM Page Pool
      </text>

      <g transform="translate(420, 40)">
        <rect x="0" y="0" width="145" height="290" rx="8" fill="var(--ex-card-bg)" stroke="var(--ex-green-stroke)" stroke-width="1.5" />
        <rect x="6" y="6" width="133" height="24" rx="4" fill="var(--ex-green-bg)" />
        <text x="72" y="22" text-anchor="middle" font-family="var(--font-sans)" font-size="11.5" font-weight="700" fill="var(--ex-green-text)">
          Physical Frames
        </text>

        <!-- 4x4 Grid of 16 Physical Memory Frames -->
        <g transform="translate(10, 40)">
          <!-- Row 0: Frames 0..3 -->
          <rect x="0" y="0" width="28" height="48" rx="4" fill="var(--ex-gray-bg)" stroke="var(--ex-border)" stroke-width="1" />
          <text x="14" y="28" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ex-text-muted)">#00</text>

          <rect x="32" y="0" width="28" height="48" rx="4" fill="var(--ex-gray-bg)" stroke="var(--ex-border)" stroke-width="1" />
          <text x="46" y="28" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ex-text-muted)">#01</text>

          <rect x="64" y="0" width="28" height="48" rx="4" fill="var(--ex-gray-bg)" stroke="var(--ex-border)" stroke-width="1" />
          <text x="78" y="28" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ex-text-muted)">#02</text>

          <rect x="96" y="0" width="28" height="48" rx="4" fill="var(--ex-gray-bg)" stroke="var(--ex-border)" stroke-width="1" />
          <text x="110" y="28" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ex-text-muted)">#03</text>

          <!-- Row 1: Frames 4..7 (Frame #04 active Indigo) -->
          <rect x="0" y="56" width="28" height="48" rx="4" fill="var(--ex-indigo-bg)" stroke="var(--ex-indigo-stroke)" stroke-width="2" />
          <text x="14" y="78" text-anchor="middle" font-family="var(--font-mono)" font-size="9" font-weight="700" fill="var(--ex-indigo-text)">#04</text>
          <text x="14" y="94" text-anchor="middle" font-family="var(--font-mono)" font-size="7.5" fill="var(--ex-indigo-text)">Blk 1</text>

          <rect x="32" y="56" width="28" height="48" rx="4" fill="var(--ex-gray-bg)" stroke="var(--ex-border)" stroke-width="1" />
          <text x="46" y="84" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ex-text-muted)">#05</text>

          <rect x="64" y="56" width="28" height="48" rx="4" fill="var(--ex-gray-bg)" stroke="var(--ex-border)" stroke-width="1" />
          <text x="78" y="84" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ex-text-muted)">#06</text>

          <rect x="96" y="56" width="28" height="48" rx="4" fill="var(--ex-gray-bg)" stroke="var(--ex-border)" stroke-width="1" />
          <text x="110" y="84" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ex-text-muted)">#07</text>

          <!-- Row 2: Frames 8..11 -->
          <rect x="0" y="112" width="28" height="48" rx="4" fill="var(--ex-gray-bg)" stroke="var(--ex-border)" stroke-width="1" />
          <text x="14" y="140" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ex-text-muted)">#08</text>

          <rect x="32" y="112" width="28" height="48" rx="4" fill="var(--ex-gray-bg)" stroke="var(--ex-border)" stroke-width="1" />
          <text x="46" y="140" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ex-text-muted)">#09</text>

          <rect x="64" y="112" width="28" height="48" rx="4" fill="var(--ex-gray-bg)" stroke="var(--ex-border)" stroke-width="1" />
          <text x="78" y="140" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ex-text-muted)">#10</text>

          <rect x="96" y="112" width="28" height="48" rx="4" fill="var(--ex-gray-bg)" stroke="var(--ex-border)" stroke-width="1" />
          <text x="110" y="140" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ex-text-muted)">#11</text>

          <!-- Row 3: Frames 12..15 (Frame #12 active Blue) -->
          <rect x="0" y="168" width="28" height="48" rx="4" fill="var(--ex-blue-bg)" stroke="var(--ex-blue-stroke)" stroke-width="2" />
          <text x="14" y="190" text-anchor="middle" font-family="var(--font-mono)" font-size="9" font-weight="700" fill="var(--ex-blue-text)">#12</text>
          <text x="14" y="206" text-anchor="middle" font-family="var(--font-mono)" font-size="7.5" fill="var(--ex-blue-text)">Blk 0</text>

          <rect x="32" y="168" width="28" height="48" rx="4" fill="var(--ex-gray-bg)" stroke="var(--ex-border)" stroke-width="1" />
          <text x="46" y="196" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ex-text-muted)">#13</text>

          <rect x="64" y="168" width="28" height="48" rx="4" fill="var(--ex-gray-bg)" stroke="var(--ex-border)" stroke-width="1" />
          <text x="78" y="196" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ex-text-muted)">#14</text>

          <rect x="96" y="168" width="28" height="48" rx="4" fill="var(--ex-gray-bg)" stroke="var(--ex-border)" stroke-width="1" />
          <text x="110" y="196" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ex-text-muted)">#15</text>
        </g>
      </g>
    </g>

    <!-- Connector S3 -> S4 -->
    <path id="conn-s3-s4-a" d="M 565 152 L 595 152" stroke="var(--ex-indigo-stroke)" stroke-width="1.5" marker-end="url(#ex-arrow-s2)" />
    <path id="conn-s3-s4-b" d="M 565 264 L 595 264" stroke="var(--ex-blue-stroke)" stroke-width="1.5" marker-end="url(#ex-arrow-s1)" />

    <!-- ==================================================== -->
    <!-- STAGE 4: SRAM GATHER & FUSED ATTENTION -->
    <!-- ==================================================== -->
    <g id="step-group-s4" class="step-group">
      <text x="605" y="24" font-family="var(--font-sans)" font-size="13" font-weight="700" fill="var(--ex-purple-text)">
        4. SRAM Gather
      </text>

      <g transform="translate(605, 40)">
        <rect x="0" y="0" width="120" height="290" rx="8" fill="var(--ex-card-bg)" stroke="var(--ex-purple-stroke)" stroke-width="1.5" />
