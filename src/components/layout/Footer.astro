---
import { SOCIALS, SITE } from '../../config';

const socials = SOCIALS;
---

<footer>
  <div class="footer-inner">
    <nav class="footer-nav" aria-label="Footer navigation">
      <a href="/publications/">Publications</a>
      <a href="/about/">About</a>
      <a href="/now/">Now</a>
      <a href="/contact/">Contact</a>
      <a href="/rss.xml">RSS</a>
    </nav>

    <div class="footer-base">
      <p class="copyright">Copyright &copy; {new Date().getFullYear()} {SITE.name}</p>
      <nav class="footer-social" aria-label="Elsewhere">
        {socials.map(s => (
          <a
            href={s.href}
            target={s.href.startsWith('http') ? '_blank' : undefined}
            rel={s.href.startsWith('http') ? 'noopener' : undefined}
          >
            {s.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</footer>

<style>
  footer {
    /* The one gap between the last section and the footer, on every page. */
    margin-top: var(--gap-section);
    background: var(--ie-surface-raised);
    color: var(--ie-muted);
    font-family: var(--font-sans);
    font-size: var(--ie-type-caption);
    letter-spacing: -0.005em;
  }

  .footer-inner {
    max-width: var(--width-content, 960px);
    margin: 0 auto;
    padding: 1.25rem var(--space-5, 1.5rem) 1.5rem;
  }

  .footer-nav,
  .footer-social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 1.5rem;
  }

  .footer-nav {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--ie-rule-strong);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 1.5rem;
    padding-top: 0.5rem;
  }

  .copyright {
    margin: 0;
    color: var(--ie-muted);
    font-size: inherit;
  }

  footer a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--ie-ink-secondary);
    text-decoration: none;
  }

  footer a:hover {
    color: var(--ie-ink);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  @media (max-width: 640px) {
    .footer-inner {
      padding-inline: var(--space-4, 1rem);
    }
  }
</style>
