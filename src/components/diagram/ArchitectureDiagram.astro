---
/**
 * ArchitectureDiagram.astro — spec §10/§11/§28
 * Data-driven architecture figure: typed nodes, semantic edges, boundary planes.
 * Layout coordinates are explicit (no auto-layout), but every rendered element
 * maps to grammar meaning and the accessible description is generated from data.
 *
 * Styling reuses the shared .sys-diagram token classes in global.css, so this
 * component, hand-coded exhibits, and Excalidraw exports share one visual language.
 */
export type NodeKind = 'default' | 'signal' | 'attention';
export type EdgeKind = 'direct' | 'async';

interface ArchNode {
  id: string;
  label: string;
  x: number;
  y: number;
  w: number;
  h: number;
  kind?: NodeKind;
  /** Render label muted (e.g. free frames) */
  muted?: boolean;
}

interface ArchEdge {
  from: string;
  to: string;
  kind?: EdgeKind;
  /** Explicit SVG path (grid/routed flows). Falls back to a border-to-border line. */
  d?: string;
  label?: string;
}

interface ArchPlane {
  id?: string;
  label: string;
  x: number;
  y: number;
  w: number;
  h: number;
}

interface ArchNote {
  text: string;
  x: number;
  y: number;
}

interface Props {
  id: string;
  viewBox?: string;
  /** Accessible name for the figure; a summary is generated from the data. */
  label?: string;
  /** One-sentence reading of what the diagram proves. */
  description?: string;
  planes?: ArchPlane[];
  nodes?: ArchNode[];
  edges?: ArchEdge[];
  notes?: ArchNote[];
}

const {
  id,
  viewBox = '0 0 900 260',
  label,
  description,
  planes = [],
  nodes = [],
  edges = [],
  notes = [],
} = Astro.props;

const byId = new Map<string, ArchNode>(
  [...nodes, ...planes.map((p) => ({ id: p.id ?? p.label, label: p.label, x: p.x, y: p.y, w: p.w, h: p.h }))].map(
    (n) => [n.id, n],
  ),
);

function nodeClass(kind: NodeKind | undefined): string {
  if (kind === 'signal') return 'node node-signal';
  if (kind === 'attention') return 'node node-attention';
  return 'node';
}

/** Intersection of the centre-line with each rectangle's border. */
function borderPoint(n: ArchNode, toward: ArchNode): { x: number; y: number } {
  const cx = n.x + n.w / 2;
  const cy = n.y + n.h / 2;
  const tx = toward.x + toward.w / 2;
  const ty = toward.y + toward.h / 2;
  const dx = tx - cx;
  const dy = ty - cy;
  const scaleX = dx === 0 ? Infinity : (n.w / 2 + 3) / Math.abs(dx);
  const scaleY = dy === 0 ? Infinity : (n.h / 2 + 3) / Math.abs(dy);
  const s = Math.min(scaleX, scaleY);
  return { x: cx + dx * s, y: cy + dy * s };
}

const resolvedEdges = edges.map((e) => {
  const a = byId.get(e.from);
  const b = byId.get(e.to);
  if (!a || !b) throw new Error(`ArchitectureDiagram ${id}: unknown node on edge ${e.from} -> ${e.to}`);
  return { ...e, a, b };
});

// Generated accessible summary (spec §20.2: diagrams need text equivalents)
const asyncCount = resolvedEdges.filter((e) => e.kind === 'async').length;
const generated =
  `${nodes.length} elements${planes.length ? ` across ${planes.length} boundaries` : ''}` +
  `${resolvedEdges.length ? `; ${resolvedEdges.length - asyncCount} direct flows` : ''}` +
  `${asyncCount ? `, ${asyncCount} dashed (asynchronous or optional)` : ''}.` +
  ` Elements: ${nodes.map((n) => n.label).join(', ')}.`;
const ariaLabel = `${label ?? 'System diagram'} — ${description ?? ''} ${generated}`.trim();
---

<svg
  class="sys-diagram arch-diagram"
  viewBox={viewBox}
  role="img"
  aria-label={ariaLabel}
>
  <defs>
    <marker id={`${id}-arrow`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L8,4 L0,8 Z" fill="var(--diagram-edge-primary)" />
    </marker>
  </defs>

  {planes.map((p) => (
    <g class="plane">
      <rect x={p.x} y={p.y} width={p.w} height={p.h} rx="8" />
      <text class="label-signal" x={p.x + 24} y={p.y + 28}>{p.label}</text>
    </g>
  ))}

  {resolvedEdges.map((e) =>
    e.d ? (
      <path
        class:list={['flow', { 'flow-dashed': e.kind === 'async' }]}
        d={e.d}
        marker-end={e.kind === 'async' ? undefined : `url(#${id}-arrow)`}
      />
    ) : (
      (() => {
        const p1 = borderPoint(e.a, e.b);
        const p2 = borderPoint(e.b, e.a);
        return (
          <line
            class:list={['flow', { 'flow-dashed': e.kind === 'async' }]}
            x1={p1.x}
            y1={p1.y}
            x2={p2.x}
            y2={p2.y}
            marker-end={e.kind === 'async' ? undefined : `url(#${id}-arrow)`}
          />
        );
      })()
    )
  )}

  {nodes.map((n) => (
    <g>
      <rect class={nodeClass(n.kind)} x={n.x} y={n.y} width={n.w} height={n.h} rx="6" />
      <text
        class={n.muted ? 'body-muted' : 'body'}
        x={n.x + n.w / 2}
        y={n.y + n.h / 2 + 6}
        text-anchor="middle"
        style={n.kind === 'attention' ? 'fill: var(--ink-900)' : undefined}
      >
        {n.label}
      </text>
    </g>
  ))}

  {notes.map((note) => (
    <text class="label" x={note.x} y={note.y}>{note.text}</text>
  ))}
</svg>

<style>
  /* Scoped safety net only; all grammar styling lives in global .sys-diagram */
  .arch-diagram {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
