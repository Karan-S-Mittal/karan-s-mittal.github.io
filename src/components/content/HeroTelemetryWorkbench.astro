---
/**
 * HeroTelemetryWorkbench.astro
 *
 * Interactive systems telemetry workbench featured in the homepage hero.
 * Demonstrates live KV cache memory allocation across non-contiguous GPU frames
 * as sequence tokens expand.
 *
 * 100% token compliant, zero raw hex colors.
 */
---

<div class="hero-workbench" id="hero-workbench">
  <!-- Workbench Header & Tabs -->
  <div class="workbench-header">
    <div class="workbench-tabs" role="tablist" aria-label="Workbench view selection">
      <button
        type="button"
        class="wb-tab active"
        data-wb-tab="telemetry"
        role="tab"
        aria-selected="true"
        aria-controls="wb-panel-telemetry"
      >
        <span class="tab-indicator" aria-hidden="true"></span>
        <span>Systems Telemetry</span>
      </button>
      <button
        type="button"
        class="wb-tab"
        data-wb-tab="profile"
        role="tab"
        aria-selected="false"
        aria-controls="wb-panel-profile"
      >
        <span>Engineer Profile</span>
      </button>
    </div>
    <span class="wb-live-badge" aria-hidden="true">LIVE CAD</span>
  </div>

  <!-- Panel 1: Live Telemetry Workbench -->
  <div class="wb-panel active" id="wb-panel-telemetry" role="tabpanel">
    <div class="telemetry-top">
      <div class="telemetry-title-group">
        <span class="telemetry-sub">INTERACTIVE MECHANISM</span>
        <h3 class="telemetry-name">PagedAttention KV Allocator</h3>
      </div>
      <div class="telemetry-readout">
        <span class="readout-k">VRAM FOOTPRINT:</span>
        <span class="readout-v" id="wb-vram-text">96 KB</span>
      </div>
    </div>

    <!-- Interactive Slider -->
    <div class="wb-slider-row">
      <div class="slider-label-bar">
        <label for="wb-token-slider" class="slider-label">Prompt Token Sequence:</label>
        <span class="slider-val" id="wb-token-display">96 tokens (6 blocks)</span>
      </div>
      <input
        type="range"
        id="wb-token-slider"
        class="wb-slider"
        min="16"
        max="256"
        step="16"
        value="96"
        aria-label="Adjust token sequence length"
      />
    </div>

    <!-- Physical VRAM Frame Grid (16 frames) -->
    <div class="vram-frame-grid" id="wb-frame-grid" role="grid" aria-label="GPU VRAM physical frames">
      <!-- Generated via JS for exact responsiveness -->
    </div>

    <!-- Live Telemetry Metrics Bar -->
    <div class="telemetry-status-bar">
      <div class="status-metric">
        <span class="metric-k">FRAMES</span>
        <span class="metric-v" id="wb-frames-metric">6 / 16</span>
      </div>
      <div class="status-metric">
        <span class="metric-k">FRAGMENTATION</span>
        <span class="metric-v text-verified">0% (PAGED)</span>
      </div>
      <div class="status-metric">
        <span class="metric-k">GPU MEMCPY</span>
        <span class="metric-v text-verified">0 BYTES</span>
      </div>
    </div>

    <!-- Leader Line Callout -->
    <div class="wb-callout">
      <span class="callout-arrow" aria-hidden="true">&larr;</span>
      <span>Scattered VRAM frames bound via page table without contiguous copy.</span>
      <a href="/visuals/paged-attention/" class="wb-inspect-link">Blueprint &rarr;</a>
    </div>
  </div>

  <!-- Panel 2: Profile & Role -->
  <div class="wb-panel" id="wb-panel-profile" role="tabpanel" hidden>
    <div class="profile-layout">
      <img
        class="profile-img"
        src="/profile-400.jpg"
        alt="Karan Mittal speaking at a technical event"
        width="100"
        height="120"
        loading="lazy"
      />
      <div class="profile-copy">
        <h3 class="profile-name">Karan Mittal</h3>
        <span class="profile-title">Engineer-scientist &middot; Co-founder, Dextar</span>
        <p class="profile-bio">Working on hard systems engineering: AI inference microarchitecture, deterministic retrieval, distributed storage, and low-level kernel performance.</p>
        <div class="profile-links">
          <a href="/about/">Full background &rarr;</a>
          <a href="/contact/">Discuss problem &rarr;</a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initHeroTelemetry() {
    const workbench = document.getElementById('hero-workbench');
    if (!workbench) return;

    // Tab Switching
    const tabs = workbench.querySelectorAll<HTMLButtonElement>('.wb-tab');
    const telemetryPanel = document.getElementById('wb-panel-telemetry');
    const profilePanel = document.getElementById('wb-panel-profile');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const isTelemetry = tab.dataset.wbTab === 'telemetry';
        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        if (telemetryPanel && profilePanel) {
          telemetryPanel.classList.toggle('active', isTelemetry);
          telemetryPanel.hidden = !isTelemetry;
          profilePanel.classList.toggle('active', !isTelemetry);
          profilePanel.hidden = isTelemetry;
        }
      });
    });

    // PagedAttention Frame Allocation Logic
    const slider = document.getElementById('wb-token-slider') as HTMLInputElement | null;
    const tokenDisplay = document.getElementById('wb-token-display');
    const vramText = document.getElementById('wb-vram-text');
    const framesMetric = document.getElementById('wb-frames-metric');
    const frameGrid = document.getElementById('wb-frame-grid');

    // Scatter allocation permutation order for 16 physical frames
    const frameAllocationOrder = [12, 7, 3, 14, 1, 9, 5, 11, 2, 8, 15, 0, 4, 10, 6, 13];
    const totalFrames = 16;
    const blockSize = 16; // 16 tokens per block

    function renderFrames(tokens: number) {
      if (!frameGrid) return;
      const blockCount = Math.min(totalFrames, Math.ceil(tokens / blockSize));
      const allocatedIndices = new Set(frameAllocationOrder.slice(0, blockCount));

      // Update readouts
      if (tokenDisplay) tokenDisplay.textContent = `${tokens} tokens (${blockCount} blocks)`;
      if (vramText) vramText.textContent = `${blockCount * 16} KB`;
      if (framesMetric) framesMetric.textContent = `${blockCount} / ${totalFrames}`;

      // Re-render cells
      let html = '';
      for (let i = 0; i < totalFrames; i++) {
        const isAllocated = allocatedIndices.has(i);
        const isOtherReq = !isAllocated && (i === 0 || i === 8);
        const cellClass = isAllocated
          ? 'f-cell allocated'
          : isOtherReq
          ? 'f-cell other'
          : 'f-cell free';

        const label = `F${String(i).padStart(2, '0')}`;
        const sub = isAllocated ? 'Req 1' : isOtherReq ? 'Req 2' : 'Free';

        html += `
          <div class="${cellClass}" role="gridcell" title="Frame ${i}: ${sub}">
            <span class="cell-num">${label}</span>
            <span class="cell-sub">${sub}</span>
          </div>
        `;
      }
      frameGrid.innerHTML = html;
    }

    if (slider) {
      slider.addEventListener('input', () => {
        renderFrames(parseInt(slider.value, 10));
      });
      renderFrames(parseInt(slider.value, 10));
    }
  }

  document.addEventListener('DOMContentLoaded', initHeroTelemetry);
  initHeroTelemetry();
</script>

<style>
  .hero-workbench {
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule-strong);
    border-radius: var(--radius-card, 6px);
    overflow: hidden;
    font-family: var(--font-diagram);
    box-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.05);
  }

  /* Header Bar */
  .workbench-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0.75rem;
    background: var(--ie-surface-raised);
    border-bottom: 1px solid var(--ie-rule);
  }

  .workbench-tabs {
    display: flex;
    gap: 0.35rem;
  }

  .wb-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm, 4px);
    background: transparent;
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    color: var(--ie-muted);
    cursor: pointer;
    transition: all var(--transition-fast, 150ms ease);
  }

  .wb-tab:hover {
    color: var(--ie-ink);
  }

  .wb-tab.active {
    background: var(--ie-surface);
    border-color: var(--ie-rule);
    color: var(--ie-ink);
    font-weight: 600;
  }

  .tab-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ie-blue);
  }

  .wb-live-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--ie-rule);
    border-radius: 3px;
    background: var(--ie-surface);
    color: var(--ie-muted);
  }

  /* Panel Container */
  .wb-panel {
    display: none;
    padding: 1rem 1.15rem;
  }

  .wb-panel.active {
    display: block;
  }

  /* Telemetry Panel Elements */
  .telemetry-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .telemetry-sub {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--ie-blue);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.15rem;
  }

  .telemetry-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ie-ink);
    letter-spacing: -0.01em;
  }

  .telemetry-readout {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-family: var(--font-mono);
    line-height: 1.2;
  }

  .readout-k {
    font-size: 0.5625rem;
    color: var(--ie-muted);
    letter-spacing: 0.05em;
  }

  .readout-v {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ie-blue);
  }

  /* Slider Controls */
  .wb-slider-row {
    margin-bottom: 0.85rem;
    padding: 0.5rem 0.65rem;
    background: var(--ie-surface-raised);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-sm, 4px);
  }

  .slider-label-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.4rem;
    font-family: var(--font-diagram);
    font-size: 0.75rem;
  }

  .slider-label {
    color: var(--ie-ink-secondary);
  }

  .slider-val {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ie-blue);
  }

  .wb-slider {
    width: 100%;
    accent-color: var(--ie-blue);
    cursor: pointer;
  }

  /* Frame Grid */
  .vram-frame-grid {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 3px;
    padding: 4px;
    background: var(--ie-rule);
    border: 1px solid var(--ie-rule-strong);
    border-radius: var(--radius-sm, 4px);
    margin-bottom: 0.85rem;
  }

  :global(.f-cell) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 2px 4px;
    border-radius: 2px;
    background: var(--ie-mem-free, var(--ie-surface));
    text-align: center;
    transition: background var(--transition-fast, 150ms ease), border-color var(--transition-fast, 150ms ease);
  }

  :global(.f-cell.allocated) {
    background: var(--ie-mem-allocated, var(--ie-blue-soft));
    border-top: 2px solid var(--ie-blue);
  }

  :global(.f-cell.other) {
    background: var(--ie-mem-cached, var(--ie-surface-raised));
    border-top: 2px solid var(--ie-muted);
  }

  :global(.f-cell.free) {
    background: var(--ie-surface);
    opacity: 0.65;
  }

  :global(.cell-num) {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--ie-ink);
    line-height: 1.1;
  }

  :global(.f-cell.allocated .cell-num) {
    color: var(--ie-blue);
  }

  :global(.cell-sub) {
    font-family: var(--font-diagram);
    font-size: 0.5625rem;
    color: var(--ie-muted);
    line-height: 1;
    margin-top: 1px;
  }

  /* Status Bar */
  .telemetry-status-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--ie-rule);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-sm, 4px);
    margin-bottom: 0.75rem;
    overflow: hidden;
  }

  .status-metric {
    display: flex;
    flex-direction: column;
    padding: 0.35rem 0.5rem;
    background: var(--ie-surface);
    font-family: var(--font-mono);
  }

  .metric-k {
    font-size: 0.5625rem;
    color: var(--ie-muted);
    letter-spacing: 0.04em;
  }

  .metric-v {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ie-ink);
  }

  .metric-v.text-verified {
    color: var(--ie-verified);
  }

  /* Callout Footer */
  .wb-callout {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    color: var(--ie-muted);
    line-height: 1.35;
  }

  .callout-arrow {
    color: var(--ie-blue);
    font-weight: 700;
  }

  .wb-inspect-link {
    margin-left: auto;
    font-family: var(--font-diagram);
    font-weight: 600;
    color: var(--ie-blue);
    text-decoration: none;
    white-space: nowrap;
  }

  .wb-inspect-link:hover {
    text-decoration: underline;
  }

  /* Profile Layout */
  .profile-layout {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  .profile-img {
    width: 100px;
    height: 120px;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-sm, 4px);
  }

  .profile-name {
    margin: 0 0 0.15rem;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--ie-ink);
  }

  .profile-title {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    color: var(--ie-muted);
    margin-bottom: 0.5rem;
  }

  .profile-bio {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ie-ink-secondary);
  }

  .profile-links {
    display: flex;
    gap: 1rem;
  }

  .profile-links a {
    font-size: var(--ie-type-micro);
    font-weight: 600;
    color: var(--ie-blue);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .vram-frame-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .profile-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
