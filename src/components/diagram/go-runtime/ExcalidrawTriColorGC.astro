---
import ExcalidrawContainer from '../paged-attention/ExcalidrawContainer.astro';

interface Props {
  caption?: string;
  exhibit?: string;
  title?: string;
}

const { caption, exhibit, title } = Astro.props;
---

<ExcalidrawContainer caption={caption} exhibit={exhibit} title={title} badge="GARBAGE COLLECTION">
  <svg class="ex-svg-canvas sys-diagram" viewBox="0 0 720 430" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Tri-color concurrent mark-sweep garbage collection states and hybrid write barrier interception.">
    <defs>
      <marker id="gc-arr" markerWidth="7" markerHeight="6" refX="6" refY="3" orient="auto"><polygon points="0 0, 7 3, 0 6" fill="#1A1A2E" /></marker>
      <marker id="gc-arr-blue" markerWidth="7" markerHeight="6" refX="6" refY="3" orient="auto"><polygon points="0 0, 7 3, 0 6" fill="#2676AA" /></marker>
      <pattern id="gc-dead-hatch" width="8" height="8" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
        <line x1="0" y1="0" x2="0" y2="8" stroke="var(--muted)" stroke-opacity="0.3" stroke-width="1.5" />
      </pattern>
    </defs>

    <!-- SECTION 1: TRI-COLOR STATES -->
    <g transform="translate(20, 16)">
      <text x="0" y="12" class="label-signal" font-size="9.5" font-weight="700" letter-spacing="0.05em" dominant-baseline="central">01 / CONCURRENT TRI-COLOR MARK CLASSIFICATION</text>
      <text x="0" y="28" class="body-muted" font-size="11.5" dominant-baseline="central">Background mark workers color the object graph concurrently alongside running user Goroutines.</text>

      <g transform="translate(0, 44)">
        <!-- BLACK SET -->
        <g transform="translate(0, 0)">
          <rect x="0" y="0" width="206" height="110" rx="8" class="node-signal" stroke-width="1.5" />
          <text x="16" y="20" class="title" font-size="13.5" font-weight="600" dominant-baseline="central">Black Set (Retained)</text>
          <text x="16" y="38" class="label-signal" font-size="8.5" font-weight="600" dominant-baseline="central">PROVEN LIVE OBJECTS</text>

          <g transform="translate(14, 52)">
            <rect x="0" y="0" width="178" height="44" rx="6" class="node" stroke-width="1.5" />
            <text x="89" y="16" class="body" font-size="10.5" font-weight="700" text-anchor="middle" dominant-baseline="central">Scanned Objects</text>
            <text x="89" y="30" class="body-muted" font-size="9.5" text-anchor="middle" dominant-baseline="central">All outgoing pointers checked</text>
          </g>
        </g>

        <!-- Advance Arrow -->
        <path d="M 212 55 H 240" class="flow-signal" stroke="#2676AA" stroke-width="2" marker-end="url(#gc-arr-blue)" />

        <!-- GREY SET -->
        <g transform="translate(246, 0)">
          <rect x="0" y="0" width="206" height="110" rx="8" class="node" stroke-width="1.5" />
          <text x="16" y="20" class="title" font-size="13.5" font-weight="600" dominant-baseline="central">Grey Set (Work Queue)</text>
          <text x="16" y="38" class="label" font-size="8.5" font-weight="600" dominant-baseline="central">MARKING FRONTIER</text>

          <g transform="translate(14, 52)">
            <rect x="0" y="0" width="178" height="44" rx="6" class="node-signal" stroke-width="1.5" />
            <text x="89" y="16" class="label-signal" font-size="10" font-weight="700" text-anchor="middle" dominant-baseline="central">Pending Traversal</text>
            <text x="89" y="30" class="body-muted" font-size="9.5" text-anchor="middle" dominant-baseline="central">In per-P gcWork mark buffers</text>
          </g>
        </g>

        <!-- Advance Arrow -->
        <path d="M 458 55 H 486" class="flow-signal" stroke="#2676AA" stroke-width="2" marker-end="url(#gc-arr-blue)" />

        <!-- WHITE SET -->
        <g transform="translate(492, 0)">
          <rect x="0" y="0" width="188" height="110" rx="8" class="node-muted" stroke-width="1.5" />
          <text x="16" y="20" class="title" font-size="13.5" font-weight="600" dominant-baseline="central">White Set (Sweep)</text>
          <text x="16" y="38" class="label" font-size="8.5" font-weight="600" dominant-baseline="central">UNREACHABLE OBJECTS</text>

          <g transform="translate(14, 52)">
            <rect x="0" y="0" width="160" height="44" rx="6" class="node-muted" stroke-width="1.5" />
            <rect x="0" y="0" width="160" height="44" rx="6" fill="url(#gc-dead-hatch)" />
            <text x="80" y="16" class="label" font-size="9.5" font-weight="700" text-anchor="middle" dominant-baseline="central">Dead Memory</text>
            <text x="80" y="30" class="label" font-size="8" text-anchor="middle" dominant-baseline="central">Reclaimed at sweep phase</text>
          </g>
        </g>
      </g>
    </g>

    <!-- DIVIDER -->
    <line x1="20" y1="200" x2="700" y2="200" stroke="var(--border-default)" stroke-width="1.5" />

    <!-- SECTION 2: HYBRID WRITE BARRIER -->
    <g transform="translate(20, 216)">
      <text x="0" y="12" class="label-signal" font-size="9.5" font-weight="700" letter-spacing="0.05em" dominant-baseline="central">02 / HYBRID WRITE BARRIER (GO 1.8+ INVARIANT PROTECTION)</text>
      <text x="0" y="28" class="body-muted" font-size="11.5" dominant-baseline="central">Intercepts concurrent pointer writes without stopping Goroutines or re-scanning stacks.</text>

      <g transform="translate(0, 44)">
        <rect x="0" y="0" width="680" height="96" rx="8" class="node-signal" stroke-width="1.5" />
        <text x="16" y="22" class="title" font-size="13.5" font-weight="600" dominant-baseline="central">Mutator Action: *slot = ptr</text>
        <text x="16" y="40" class="label-signal" font-size="8.5" font-weight="700" dominant-baseline="central">YUASA DELETION + DIJKSTRA INSERTION FUSION</text>
        <text x="16" y="66" class="body-muted" font-size="11" dominant-baseline="central">Executed in compiler-inserted inline barrier code</text>

        <g transform="translate(340, 16)">
          <rect x="0" y="0" width="324" height="64" rx="6" class="node" stroke-width="1.5" />
          <text x="14" y="20" class="label" font-size="8.5" font-weight="600" dominant-baseline="central">1. shade(*slot) &rarr; Old pointer shaded Grey (Yuasa)</text>
          <text x="14" y="44" class="label-signal" font-size="8.5" font-weight="700" dominant-baseline="central">2. shade(ptr)   &rarr; New pointer shaded Grey (Dijkstra)</text>
        </g>
      </g>
    </g>

    <!-- Editorial Leader Line -->
    <text x="20" y="408" class="body-muted" font-size="11" dominant-baseline="central">&larr; notice hybrid write barrier eliminates STW stack rescans; pause limited strictly to phase handshakes (&lt;100µs)</text>
  </svg>
</ExcalidrawContainer>
