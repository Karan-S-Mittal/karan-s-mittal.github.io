---
/**
 * AlgorithmFlow.astro
 * High-density, digestible 4-5 step visual algorithm breakdown component.
 * Inspired by Bartosz Ciechanowski + ByteByteGo + Daily Dose of Data Science.
 *
 * Renders connected visual cards with step numbers, state pills,
 * mechanistic intuition, formulas, and data-flow connectors.
 */
import Exhibit from '../editorial/Exhibit.astro';

export interface FlowStep {
  step: string;
  title: string;
  tag?: string;
  state?: 'signal' | 'verified' | 'constraint' | 'failure' | 'model' | 'default';
  description: string;
  formula?: string;
  note?: string;
}

interface Props {
  exhibit?: string;
  title?: string;
  badge?: string;
  caption?: string;
  steps: FlowStep[];
  columns?: 2 | 3 | 4;
  wide?: boolean;
}

const {
  exhibit,
  title,
  badge = 'ALGORITHM PIPELINE',
  caption,
  steps = [],
  columns = 2,
  wide = true,
} = Astro.props;
---

<Exhibit exhibit={exhibit} title={title} badge={badge} caption={caption} wide={wide}>
  <div class="algorithm-flow-root" data-flow-root>
    <div
      class:list={['flow-grid', `cols-${columns}`]}
      data-flow-layout={columns === 2 && steps.length === 4 ? 'two-by-two' : 'grid'}
    >
      {steps.map((item, index) => {
        const stateClass = item.state ? `state-${item.state}` : 'state-signal';
        return (
          <div class:list={['flow-step-card', stateClass]}>
            <div class="step-card-header">
              <div class="step-identity">
                <span class="step-num">{item.step}</span>
                <h4 class="step-title">{item.title}</h4>
              </div>
              {item.tag && <span class="step-tag">{item.tag}</span>}
            </div>

            {index < steps.length - 1 && (
              <span class="step-connector-pill" aria-hidden="true">
                {columns === 2 && steps.length === 4 && index % 2 === 0 ? '↓' : '→'}
              </span>
            )}

            <div class="step-card-body">
              <p class="step-desc">{item.description}</p>

              {item.formula && (
                <div class="step-property" role="math" aria-label={`Formula: ${item.formula}`}>
                  <span class="step-property-label">Formula</span>
                  <span class="step-formula-text">{item.formula}</span>
                </div>
              )}

              {item.note && (
                <div class="step-property step-note">
                  <span class="step-property-label">Notice</span>
                  <span><span class="note-arrow">&larr;</span> {item.note}</span>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</Exhibit>

<style>
  .algorithm-flow-root {
    container-name: algorithm-flow;
    container-type: inline-size;
    width: 100%;
    padding: var(--space-3) 0;
  }

  .flow-grid {
    display: grid;
    gap: var(--space-3);
    position: relative;
  }

  .flow-grid.cols-2 {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }

  .flow-grid.cols-3 {
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }

  .flow-grid.cols-4 {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .flow-grid[data-flow-layout='two-by-two'] {
    grid-template-rows: repeat(2, minmax(0, 1fr));
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: column;
  }

  .flow-step-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--panel-bg, var(--bg-elevated));
    border: 1px solid var(--panel-border, var(--border));
    border-radius: var(--panel-radius, var(--radius));
    box-shadow: var(--panel-shadow, none);
    overflow: visible;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .flow-step-card:hover {
    border-color: var(--panel-border-strong, var(--muted));
  }

  /* Small semantic status light: colour stays local and the surface remains calm. */
  .flow-step-card::before {
    content: '';
    position: absolute;
    z-index: 2;
    top: calc(var(--panel-header-height, 2.75rem) / 2 - 3px);
    left: 0.85rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .flow-step-card.state-signal::before { background: var(--interactive-primary); }
  .flow-step-card.state-verified::before { background: var(--blue-500); }
  .flow-step-card.state-constraint::before { background: var(--signal-warm); }
  .flow-step-card.state-failure::before { background: var(--signal-warm); }
  .flow-step-card.state-model::before { background: var(--diagram-node-primary); }

  .step-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--panel-header-height, 2.5rem);
    gap: var(--space-3);
    padding: 0.6rem var(--space-3) 0.6rem 1.8rem;
    background: var(--panel-header-bg, var(--bg-inset));
    border-bottom: 1px solid var(--panel-border, var(--border));
    border-radius: var(--panel-radius, var(--radius)) var(--panel-radius, var(--radius)) 0 0;
  }

  .step-identity {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .step-num {
    font-family: 'JetBrains Mono', var(--font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .step-connector-pill {
    font-size: 0.85rem;
    color: var(--muted);
    font-weight: 600;
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--muted);
    background: var(--panel-bg, var(--bg-elevated));
    border: 1px solid var(--panel-border, var(--border));
    border-radius: 6px;
    font: 600 0.7rem/1 var(--font-mono);
  }

  .flow-grid[data-flow-layout='two-by-two'] .flow-step-card:nth-child(odd) .step-connector-pill {
    left: 50%;
    bottom: -1.03rem;
    transform: translateX(-50%);
  }

  .flow-grid[data-flow-layout='two-by-two'] .flow-step-card:nth-child(even) .step-connector-pill {
    top: 50%;
    right: -1.03rem;
    transform: translateY(-50%);
  }

  .step-tag {
    font-family: 'JetBrains Mono', var(--font-mono, monospace);
    font-size: 0.65rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    padding: 0;
    white-space: nowrap;
  }

  .step-title {
    font-family: 'Inter', var(--font-sans, sans-serif);
    min-width: 0;
    margin: 0;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
  }

  .step-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    padding: var(--space-3);
  }

  .step-desc {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0 0 var(--space-3);
    flex-grow: 1;
  }

  .step-property {
    display: grid;
    grid-template-columns: 3.6rem minmax(0, 1fr);
    gap: var(--space-2);
    align-items: baseline;
    min-width: 0;
    margin-top: -1px;
    padding: 0.45rem 0.55rem;
    background: var(--panel-property-bg, var(--bg-inset));
    border: 1px solid var(--panel-border, var(--border));
    border-radius: 7px;
    overflow-x: auto;
  }

  .step-property-label {
    color: var(--muted);
    font: 500 0.62rem/1.4 var(--font-mono);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .step-formula-text {
    font-family: 'JetBrains Mono', var(--font-mono, monospace);
    font-size: 0.72rem;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .step-note {
    font-family: 'JetBrains Mono', var(--font-mono, monospace);
    font-size: 0.68rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .note-arrow {
    color: var(--interactive-primary);
    font-weight: 700;
  }

  @container algorithm-flow (max-width: 640px) {
    .flow-grid,
    .flow-grid[data-flow-layout='two-by-two'] {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-auto-flow: row;
    }

    .step-connector-pill {
      left: 50%;
      right: auto;
      top: auto;
      bottom: -1.05rem;
      transform: translateX(-50%);
      font-size: 0;
    }

    .flow-grid[data-flow-layout='two-by-two'] .flow-step-card .step-connector-pill {
      left: 50%;
      right: auto;
      top: auto;
      bottom: -1.05rem;
      transform: translateX(-50%);
    }

    .step-connector-pill::after {
      content: '↓';
      font-size: 0.85rem;
    }
  }
</style>
