---
/**
 * Page intro: eyebrow, headline, lead, and optional actions (the default
 * slot). The page's .container supplies --page-top above; this block owns
 * --gap-block below, so every inner page starts and settles the same way.
 */
interface Props {
  label: string;
  title: string;
  description?: string;
  headingLevel?: 'h1' | 'h2';
}

const { label, title, description, headingLevel = 'h1' } = Astro.props;
const Heading = headingLevel;
const hasActions = Astro.slots.has('default');
---

<header class="page-header">
  <p class="page-register">{label}</p>
  <Heading>{title}</Heading>
  {description && (
    <p class="lead">{description}</p>
  )}
  {hasActions && (
    <div class="page-header-actions">
      <slot />
    </div>
  )}
</header>

<style>
  .page-header {
    margin-bottom: var(--gap-block);
  }
  .page-register {
    margin-bottom: var(--gap-tight);
    font-family: var(--font-sans);
    font-size: var(--ie-type-small);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ie-muted);
  }
  .page-header :is(h1, h2) {
    font-family: var(--font-display);
    max-width: 28ch;
    font-size: var(--ie-type-h1);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.08;
    color: var(--ie-ink);
    margin: 0 0 var(--gap-related);
  }
  .lead {
    color: var(--ie-muted);
    max-width: 620px;
    margin: 0;
    line-height: 1.5;
    font-size: var(--ie-type-body);
  }
  .page-header-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap-tight) 1.75rem;
    margin-top: var(--gap-group);
  }
  @media (max-width: 640px) {
    .lead {
      font-size: var(--ie-type-base);
    }
  }
</style>
