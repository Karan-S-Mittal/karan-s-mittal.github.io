---
import Layout from '@layouts/Layout.astro';
import EngagementList from '@components/content/EngagementList.astro';
import { getCollection } from 'astro:content';
import { SITE, SOCIALS } from '../config';
import talksData from '@data/talks.json';
import VisualMicroSchematic from '@components/visuals/VisualMicroSchematic.astro';
import '@styles/practice.css';
const publishedPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPosts = [...publishedPosts.filter(p => p.data.featured), ...publishedPosts.filter(p => !p.data.featured)].slice(0, 3);
const selectedTalks = [...talksData.talks].sort((a,b) => b.date.localeCompare(a.date)).slice(0, 3);
const linkedin = SOCIALS.find(s => s.label === 'LinkedIn')!;
const formatDate = (date: Date | string) => new Date(date).toLocaleDateString('en-GB', {day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC'});
---
<Layout title={SITE.title} description={SITE.description}>
  <main class="practice-page">
    <section class="hero" aria-labelledby="home-title">
      <div>
        <span class="register">Karan Mittal / Engineer-scientist · Co-founder, Dextar</span>
        <h1 id="home-title">Solve the real problem.<br />Build a system that lasts.</h1>
        <p class="lead">I help organisations turn difficult data, AI, and software problems into systems people can rely on—from understanding what is wrong to building a solution the team can run.</p>
        <div class="actions"><a class="action" href="/contact">Discuss your problem →</a><a class="action secondary" href="/work">Explore my work →</a></div>
      </div>
      <div class="hero-aside"><img class="hero-portrait" src="/profile-400.jpg" alt="Karan Mittal speaking at a technical event" width="180" height="216" loading="eager" /><span class="portrait-caption">Engineering, explaining, and building with teams.</span></div>
    </section>
    <ul class="problem-list" aria-label="Problems I help solve">
      <li><strong>The prototype needs to work in practice.</strong>Turn promising AI behaviour into a system with clear requirements, evaluation, and operational ownership.</li>
      <li><strong>The information is there. Trust is missing.</strong>Make knowledge easier to retrieve, trace to its sources, and use in everyday decisions.</li>
      <li><strong>The system is holding the team back.</strong>Investigate performance, cost, and maintenance problems, then decide what is worth changing.</li>
    </ul>

    <section class="section" aria-labelledby="work-heading">
      <div class="section-head"><div><span class="register">01 / Selected work</span><h2 id="work-heading">An implementation you can inspect.</h2></div><a href="/work">Work & contributions →</a></div>
      <article class="evidence-feature">
        <div class="evidence-copy">
          <span class="register">Independent project / Explanatory Systems Studio</span>
          <h3>Making technical explanations testable.</h3>
          <p>This site is also a working engineering project: interactive explanations, verified visual blueprints, and memory layouts that keep published material consistent.</p>
          <dl class="evidence-details">
            <dt>The problem</dt>
            <dd>Static prose makes it difficult to trace non-contiguous GPU allocations, loop gates, and data planes.</dd>
            <dt>The implementation</dt>
            <dd>Live vector schematics with exact memory strides, verified state tokens, and exportable high-resolution blueprints.</dd>
          </dl>
          <div class="evidence-links">
            <a href="/visuals/">Explore systems blueprints &rarr;</a>
            <a href="/case-studies/explanatory-studio/" class="secondary-link">Read study &rarr;</a>
          </div>
        </div>
        <div class="evidence-preview-wrap">
          <div class="evidence-blueprint-frame">
            <VisualMicroSchematic slug="paged-attention" />
            <div class="evidence-blueprint-bar">
              <span class="blueprint-label">EXHIBIT &bull; PAGEDATTENTION TRANSLATION</span>
              <a href="/visuals/paged-attention/" class="blueprint-link">Inspect &rarr;</a>
            </div>
          </div>
        </div>
      </article>
    </section>

    <section class="section" aria-labelledby="engagement-heading"><div class="section-head"><div><span class="register">02 / Working together</span><h2 id="engagement-heading">Start where the problem is.</h2></div></div><EngagementList /><div class="actions"><a href="/work#engagements">Explore engagement options →</a></div></section>

    <section class="section" aria-labelledby="writing-heading"><div class="section-head"><div><span class="register">03 / Selected writing</span><h2 id="writing-heading">How I work through a system.</h2></div><a href="/blog">All {publishedPosts.length} essays →</a></div>
      {featuredPosts.map(post => <a class="note-row" href={`/blog/${post.id}/`}><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><div><h3>{post.data.title}</h3><p>{post.data.description}</p></div></a>)}
    </section>

    <section class="section" aria-labelledby="community-heading"><div class="section-head"><div><span class="register">04 / Teaching & community</span><h2 id="community-heading">Build understanding. Help others build.</h2></div><a href="/talks">Talks & workshops →</a></div><p class="lead">I speak, organise, and mentor through MLIndore, GDG Cloud Indore, and CodeVipassana. These are selected events from that work.</p>
      {selectedTalks.map(talk => <article class="event-row"><time datetime={talk.date}>{formatDate(talk.date)}</time><div><span class="event-meta">{talk.role} / {talk.org}</span><h3>{talk.title}</h3><p>{talk.description}</p><a href={talk.links[0].url} target="_blank" rel="noopener">Event details ↗</a></div></article>)}
      <div class="actions"><a href="/about#community">Meet the communities →</a><a href={linkedin.href} target="_blank" rel="noopener">More activity on LinkedIn ↗</a></div>
    </section>

    <section class="section closing" aria-labelledby="about-heading"><span class="register">05 / The person behind the work</span><h2 id="about-heading">An engineer-scientist, invested in the outcome.</h2><p class="lead">I’m Karan, co-founder of Dextar. I care about understanding why something fails, finding a useful solution, and leaving people with a system they can operate and improve. Building, teaching, and working with teams are all part of that practice.</p><a href="/about">More about me →</a><div class="actions"><a href="/contact" class="action">Tell me what needs to work better →</a></div></section>
  </main>
</Layout>
