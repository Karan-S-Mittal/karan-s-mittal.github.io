---
import ExcalidrawContainer from './ExcalidrawContainer.astro';
import { createCopyOnWriteRoutes } from '../../lib/diagram-routing.js';

interface Props {
  caption?: string;
  exhibit?: string;
  title?: string;
}

const { caption, exhibit, title } = Astro.props;
const { promptA00ToFrame12, promptB00ToFrame12, promptA01ToFrame04, promptB01ToFrame04, outputAToFrame31, outputBToFrame58 } = createCopyOnWriteRoutes();
---

<ExcalidrawContainer caption={caption} exhibit={exhibit} title={title} badge="COPY-ON-WRITE">
  <svg class="ex-svg-canvas sys-diagram" viewBox="0 0 800 432" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Two logical sequences share their prompt KV pages and allocate separate physical frames only after they diverge.">
    <defs>
      <marker id="cow-arrow" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto"><polygon points="0 0, 10 4, 0 8" fill="var(--ex-text-main)" /></marker>
      <marker id="cow-arrow-signal" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto"><polygon points="0 0, 10 4, 0 8" fill="var(--ex-text-main)" /></marker>
    </defs>
    <text x="32" y="32" class="label">LOGICAL SEQUENCES</text>
    <text x="768" y="32" class="label" text-anchor="end">PHYSICAL GPU POOL</text>
    <line x1="32" y1="48" x2="768" y2="48" class="rule" />

    <text x="32" y="88" class="label">REQUEST A</text>
    <g transform="translate(32 104)">
      <rect x="0" y="0" width="88" height="40" rx="4" class="node-muted" /><text x="44" y="25" class="label" text-anchor="middle">PROMPT 00</text>
      <rect x="104" y="0" width="88" height="40" rx="4" class="node-muted" /><text x="148" y="25" class="label" text-anchor="middle">PROMPT 01</text>
      <rect x="208" y="0" width="88" height="40" rx="4" class="node-signal" /><text x="252" y="25" class="label-signal" text-anchor="middle">OUTPUT A</text>
    </g>

    <text x="32" y="232" class="label">REQUEST B</text>
    <g transform="translate(32 248)">
      <rect x="0" y="0" width="88" height="40" rx="4" class="node-muted" /><text x="44" y="25" class="label" text-anchor="middle">PROMPT 00</text>
      <rect x="104" y="0" width="88" height="40" rx="4" class="node-muted" /><text x="148" y="25" class="label" text-anchor="middle">PROMPT 01</text>
      <rect x="208" y="0" width="88" height="40" rx="4" class="node-signal" /><text x="252" y="25" class="label-signal" text-anchor="middle">OUTPUT B</text>
    </g>

    <path d={promptA00ToFrame12} class="flow" marker-end="url(#cow-arrow)" />
    <path d={promptB00ToFrame12} class="flow-dashed" marker-end="url(#cow-arrow)" />
    <path d={promptA01ToFrame04} class="flow" marker-end="url(#cow-arrow)" />
    <path d={promptB01ToFrame04} class="flow-dashed" marker-end="url(#cow-arrow)" />
    <path d={outputAToFrame31} class="flow-signal" marker-end="url(#cow-arrow-signal)" />
    <path d={outputBToFrame58} class="flow-signal" marker-end="url(#cow-arrow-signal)" />

    <g transform="translate(472 72)">
      <text x="0" y="18" class="title">Physical page frames</text>
      <rect x="0" y="32" width="272" height="52" rx="4" class="node-muted" />
      <text x="16" y="55" class="title">Frame 12</text><text x="16" y="74" class="label">PROMPT 00 · REF COUNT 2</text>
      <rect x="0" y="92" width="272" height="52" rx="4" class="node-muted" />
      <text x="16" y="115" class="title">Frame 04</text><text x="16" y="134" class="label">PROMPT 01 · REF COUNT 2</text>
      <rect x="0" y="152" width="272" height="52" rx="4" class="node-signal" />
      <text x="16" y="175" class="title">Frame 31</text><text x="16" y="194" class="label-signal">OUTPUT A · REF COUNT 1</text>
      <rect x="0" y="212" width="272" height="52" rx="4" class="node-signal" />
      <text x="16" y="235" class="title">Frame 58</text><text x="16" y="254" class="label-signal">OUTPUT B · REF COUNT 1</text>
    </g>

    <line x1="32" y1="368" x2="768" y2="368" class="rule" />
    <text x="32" y="400" class="body-muted">Shared prompt pages have ref_count=2; new frames appear only after divergence.</text>
  </svg>
</ExcalidrawContainer>
