---
import ExcalidrawContainer from '../paged-attention/ExcalidrawContainer.astro';

interface Props {
  caption?: string;
  exhibit?: string;
  title?: string;
}

const { caption, exhibit, title } = Astro.props;
---

<ExcalidrawContainer caption={caption} exhibit={exhibit} title={title} badge="HASH MAP MICROARCHITECTURE">
  <svg class="ex-svg-canvas sys-diagram" viewBox="0 0 720 430" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Comparison between legacy Go 8-slot bucket chain maps and modern Go 1.24 SwissTable SIMD group probing.">
    <defs>
      <marker id="swiss-arr" markerWidth="7" markerHeight="6" refX="6" refY="3" orient="auto"><polygon points="0 0, 7 3, 0 6" fill="#1A1A2E" /></marker>
      <marker id="swiss-arr-blue" markerWidth="7" markerHeight="6" refX="6" refY="3" orient="auto"><polygon points="0 0, 7 3, 0 6" fill="#2676AA" /></marker>
    </defs>

    <!-- SECTION 1: LEGACY GO MAP (BUCKET CHAINS) -->
    <g transform="translate(20, 16)">
      <text x="0" y="12" class="label-signal" font-size="9.5" font-weight="700" letter-spacing="0.05em" dominant-baseline="central">LEGACY GO MAP / 8-ENTRY BUCKETS + OVERFLOW CHAIN</text>
      <text x="0" y="28" class="body-muted" font-size="11.5" dominant-baseline="central">Scalar top-hash iteration; pointer chasing across scattered overflow buckets on hash collisions.</text>

      <g transform="translate(0, 44)">
        <!-- Bucket 0 -->
        <rect x="0" y="0" width="300" height="60" rx="8" class="node-muted" stroke-width="1.5" />
        <text x="16" y="20" class="label" font-size="8.5" font-weight="700" dominant-baseline="central">PRIMARY BUCKET (8 ENTRIES)</text>
        <text x="16" y="40" class="body" font-size="10.5" dominant-baseline="central">[k₀, v₀] [k₁, v₁] [k₂, v₂] ... [k₇, v₇]</text>

        <!-- Overflow pointer arrow -->
        <path d="M 300 30 H 360" class="flow-dashed" stroke="#1A1A2E" stroke-width="1.5" stroke-dasharray="3 3" marker-end="url(#swiss-arr)" />
        <text x="330" y="18" class="label" font-size="8" font-weight="700" text-anchor="middle" dominant-baseline="central">OVERFLOW</text>

        <!-- Overflow Bucket -->
        <rect x="368" y="0" width="312" height="60" rx="8" class="node-muted" stroke-width="1.5" />
        <text x="16" y="20" class="label-signal" font-size="8.5" font-weight="700" dominant-baseline="central" transform="translate(368, 0)">OVERFLOW BUCKET (CACHE MISS CHASE)</text>
        <text x="16" y="40" class="body-muted" font-size="10.5" dominant-baseline="central" transform="translate(368, 0)">[k₈, v₈] [k₉, v₉] ... [k₁₅, v₁₅]</text>
      </g>
    </g>

    <!-- DIVIDER -->
    <line x1="20" y1="160" x2="700" y2="160" stroke="var(--border-default)" stroke-width="1.5" />

    <!-- SECTION 2: GO 1.24 SWISSTABLE (SIMD CONTROL GROUP PROBING) -->
    <g transform="translate(20, 176)">
      <text x="0" y="12" class="label-signal" font-size="9.5" font-weight="700" letter-spacing="0.05em" dominant-baseline="central">GO 1.24 SWISSTABLE / 16-BYTE METADATA VECTOR + SIMD PROBE</text>
      <text x="0" y="28" class="body-muted" font-size="11.5" dominant-baseline="central">16-slot control bytes loaded into 128-bit SIMD register; matches hash top 7-bits in 1 CPU instruction.</text>

      <g transform="translate(0, 44)">
        <!-- 16-Byte Control Group -->
        <g transform="translate(0, 0)">
          <rect x="0" y="0" width="380" height="120" rx="8" class="node-signal" stroke-width="1.5" />
          <text x="16" y="20" class="title" font-size="13" font-weight="600" dominant-baseline="central">Control Group (16 Bytes)</text>
          <text x="16" y="38" class="label-signal" font-size="8.5" font-weight="700" dominant-baseline="central">H1 HASH = GROUP INDEX · H2 = 7-BIT SIGNATURE</text>

          <!-- 16 Byte slots -->
          <g transform="translate(14, 54)">
            <rect x="0" y="0" width="20" height="32" rx="3" class="node-signal" stroke-width="1.5" /><text x="10" y="16" class="label-signal" font-size="8" font-weight="700" text-anchor="middle" dominant-baseline="central">7F</text>
            <rect x="22" y="0" width="20" height="32" rx="3" class="node-signal" stroke-width="1.5" /><text x="32" y="16" class="label-signal" font-size="8" font-weight="700" text-anchor="middle" dominant-baseline="central">3A</text>
            <rect x="44" y="0" width="20" height="32" rx="3" class="node-signal" stroke-width="1.5" /><text x="54" y="16" class="label-signal" font-size="8" font-weight="700" text-anchor="middle" dominant-baseline="central">8C</text>
            <rect x="66" y="0" width="20" height="32" rx="3" class="node-signal" stroke-width="1.5" /><text x="76" y="16" class="label-signal" font-size="8" font-weight="700" text-anchor="middle" dominant-baseline="central">12</text>
            <rect x="88" y="0" width="20" height="32" rx="3" class="node-muted" stroke-width="1.5" /><text x="98" y="16" class="label" font-size="7.5" text-anchor="middle" dominant-baseline="central">FF</text>
            <rect x="110" y="0" width="20" height="32" rx="3" class="node-muted" stroke-width="1.5" /><text x="120" y="16" class="label" font-size="7.5" text-anchor="middle" dominant-baseline="central">FF</text>
            <rect x="132" y="0" width="58" height="32" rx="3" class="node-muted" stroke-width="1.5" /><text x="161" y="16" class="label" font-size="8" text-anchor="middle" dominant-baseline="central">... (16B)</text>
            <rect x="194" y="0" width="158" height="32" rx="3" class="node" stroke-width="1.5" /><text x="273" y="16" class="label-signal" font-size="8" font-weight="700" text-anchor="middle" dominant-baseline="central">128-bit SIMD Compare</text>
          </g>
          <text x="16" y="104" class="body-muted" font-size="10.5" dominant-baseline="central">Instruction: SIMD compare produces match bitmask in 1 cycle</text>
        </g>

        <!-- SIMD Probe Arrow -->
        <path d="M 386 60 H 434" class="flow-signal" stroke="#2676AA" stroke-width="2" marker-end="url(#swiss-arr-blue)" />
        <text x="410" y="46" class="label-signal" text-anchor="middle" font-size="8.5" font-weight="700" dominant-baseline="central">DIRECT</text>

        <!-- Contiguous Data Slots -->
        <g transform="translate(440, 0)">
          <rect x="0" y="0" width="240" height="120" rx="8" class="node" stroke-width="1.5" />
          <text x="16" y="20" class="title" font-size="13" font-weight="600" dominant-baseline="central">Packed Slot Array</text>
          <text x="16" y="38" class="label" font-size="8.5" font-weight="700" dominant-baseline="central">FLAT ARRAY (ZERO OVERFLOW POINTERS)</text>

          <g transform="translate(14, 54)">
            <rect x="0" y="0" width="212" height="36" rx="4" class="node-signal" stroke-width="1.5" />
            <text x="106" y="18" class="body" font-size="10.5" font-weight="700" text-anchor="middle" dominant-baseline="central">Direct Slot Access: &amp;slots[match]</text>
          </g>
          <text x="16" y="104" class="body-muted" font-size="10.5" dominant-baseline="central">High cache locality · No pointer chases</text>
        </g>
      </g>
    </g>

    <!-- Editorial Leader Line -->
    <text x="20" y="408" class="body-muted" font-size="11" dominant-baseline="central">&larr; notice 16 slots tested simultaneously in 1 CPU cycle via SIMD; boosts map lookup throughput by 30% to 50%</text>
  </svg>
</ExcalidrawContainer>
