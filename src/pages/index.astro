---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';
import { practiceAreas } from '@data/practice';
import { externalWriting } from '@data/publications';
import '@styles/practice.css';

const publishedPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestLocalPost = publishedPosts[0];
const externalArticle = externalWriting[0];

const monthYear = (value: Date) =>
  value.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
---

<Layout title={SITE.title} description="Karan Mittal is a systems engineer building deterministic harnesses, evaluation boundaries, and persistent state for production AI agents and LLMOps.">
  <main class="practice-page home-page">
    <header class="home-hero" aria-labelledby="hero-heading">
      <h1 id="hero-heading">Deterministic harnesses for production AI agents.</h1>
      <p class="lead">
        I build runtime execution sandboxes, evaluation boundaries, and persistent state for
        agentic systems where hallucination, state corruption, and silent failure are
        unacceptable. Co-founder at <a href="https://dextar.co" target="_blank" rel="noopener">Dextar</a>.
      </p>
      <div class="hero-actions">
        <a class="action" href="/contact">Discuss your problem &rarr;</a>
      </div>
    </header>

    <section id="practice" class="section" aria-labelledby="practice-heading">
      <div class="section-header">
        <span class="register">01 / What I fix</span>
        <h2 id="practice-heading">Where production agent systems break down.</h2>
      </div>

      <ol class="practice-list">
        {practiceAreas.map((area) => (
          <li class="practice-item" id={area.id}>
            <span class="practice-num" aria-hidden="true">{area.num}</span>
            <div class="practice-body">
              <h3 class="practice-problem">{area.problem}</h3>
              <p class="practice-intervention">{area.intervention}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="proof" class="section" aria-labelledby="proof-heading">
      <div class="section-header">
        <span class="register">02 / Direct proof</span>
        <h2 id="proof-heading">Published systems research and public writing.</h2>
      </div>

      <ul class="proof-list">
        {externalArticle && (
          <li class="proof-item">
            <p class="proof-meta">
              <span>Published at {externalArticle.publication}</span>
              <time datetime={externalArticle.pubDate}>
                {monthYear(new Date(externalArticle.pubDate))}
              </time>
            </p>
            <h3 class="proof-title">
              <a href={externalArticle.href} target="_blank" rel="noopener">
                {externalArticle.title}<span class="proof-mark" aria-hidden="true">&nearr;</span>
              </a>
            </h3>
            <p class="proof-desc">{externalArticle.description}</p>
          </li>
        )}

        {latestLocalPost && (
          <li class="proof-item">
            <p class="proof-meta">
              <span>On-site essay</span>
              <time datetime={latestLocalPost.data.pubDate.toISOString()}>
                {monthYear(latestLocalPost.data.pubDate)}
              </time>
            </p>
            <h3 class="proof-title">
              <a href={`/writing/${latestLocalPost.id}/`}>{latestLocalPost.data.title}</a>
            </h3>
            <p class="proof-desc">{latestLocalPost.data.description}</p>
          </li>
        )}
      </ul>

      <div class="proof-actions">
        <a href="/writing/">All technical writing &rarr;</a>
        <a href="/speaking/">Workshops &amp; conference talks &rarr;</a>
      </div>
    </section>

    <section class="section closing" aria-labelledby="closing-heading">
      <span class="register">Start a conversation</span>
      <h2 id="closing-heading">What needs to work better?</h2>
      <p class="lead">
        Describe the agent, pipeline, or systems problem, who it impacts, and what a reliable
        outcome looks like. A few sentences are enough to start.
      </p>
      <div class="actions">
        <a href="/contact/" class="action">Start an engineering conversation &rarr;</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* ---- Hero -------------------------------------------------------- */

  .home-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: clamp(4rem, 9vw, 7.5rem) clamp(3.5rem, 7vw, 5.5rem);
    border-bottom: 1px solid var(--ie-rule-strong);
    text-align: center;
  }

  .home-hero h1 {
    max-width: 18ch;
    margin-bottom: 1.5rem;
    font-size: clamp(2.35rem, 5.4vw, 3.9rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .home-hero .lead {
    max-width: 58ch;
    margin-bottom: 0;
    color: var(--ie-ink-secondary);
    font-size: clamp(1.0625rem, 1.5vw, 1.1875rem);
    line-height: 1.62;
  }

  .home-hero .lead a {
    border-bottom: 1px solid var(--ie-rule-strong);
    color: var(--ie-ink);
    font-weight: 500;
  }

  .home-hero .lead a:hover {
    border-bottom-color: var(--ie-ink);
  }

  .hero-actions {
    margin-top: 2.25rem;
  }

  /* ---- Shared section header --------------------------------------- */

  .section-header {
    max-width: 44ch;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .closing .lead,
  .section-header .lead {
    max-width: 62ch;
  }

  /* ---- 01 / What I fix --------------------------------------------- */

  .practice-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ie-rule);
    list-style: none;
  }

  .practice-item {
    display: grid;
    align-items: start;
    gap: 0 clamp(1.25rem, 3vw, 2.5rem);
    padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
    border-bottom: 1px solid var(--ie-rule);
    grid-template-columns: 3.5rem minmax(0, 1fr);
  }

  .practice-num {
    padding-top: 0.35rem;
    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label);
    font-variant-numeric: tabular-nums;
  }

  .practice-problem {
    max-width: 24ch;
    margin-bottom: 0.65rem;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.24;
    letter-spacing: -0.02em;
  }

  .practice-intervention {
    max-width: 68ch;
    margin: 0;
    color: var(--ie-ink-secondary);
  }

  /* ---- 02 / Direct proof ------------------------------------------- */

  .proof-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ie-rule);
    list-style: none;
  }

  .proof-item {
    padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
    border-bottom: 1px solid var(--ie-rule);
  }

  .proof-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 0.7rem;
    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label);
  }

  .proof-title {
    max-width: 34ch;
    margin-bottom: 0.55rem;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.22;
    letter-spacing: -0.02em;
  }

  .proof-title a {
    color: var(--ie-ink);
    text-decoration: none;
  }

  .proof-title a:hover {
    color: var(--ie-blue);
  }

  .proof-mark {
    margin-left: 0.3em;
    color: var(--ie-muted);
    font-size: 0.8em;
  }

  .proof-desc {
    max-width: 68ch;
    margin: 0;
    color: var(--ie-ink-secondary);
  }

  .proof-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-top: 1.75rem;
  }

  .proof-actions a {
    min-height: 44px;
    align-content: center;
    color: var(--ie-ink-secondary);
    font-family: var(--font-sans);
    font-size: var(--ie-type-ui);
  }

  .proof-actions a:hover {
    color: var(--ie-blue);
  }

  /* ---- Responsive --------------------------------------------------- */

  @media (max-width: 640px) {
    .practice-item {
      gap: 0.5rem 0;
      grid-template-columns: 1fr;
    }

    .practice-num {
      padding-top: 0;
    }
  }
</style>
