---
import type { Talk } from '../../types/talks';
import { formatTalkDate } from '../../utils/date';

interface Props {
  talk: Talk;
  searchText?: string;
}

const { talk, searchText } = Astro.props;
const formattedDate = formatTalkDate(talk.date);

const typeLabel: Record<Talk['type'], string> = {
  talk: 'Session',
  workshop: 'Workshop',
  panel: 'Panel',
  keynote: 'Keynote',
};
---

<article class="talk-card" data-search={searchText} data-year={talk.year} data-date={talk.date}>
  <div class="talk-meta">
    <time datetime={talk.date}>{formattedDate}</time>
    <span aria-hidden="true" class="meta-sep">·</span>
    <span class="talk-type" data-type={talk.type}>{typeLabel[talk.type]}</span>
  </div>

  <h3 class="talk-title">{talk.title}</h3>
  <p class="talk-description">{talk.description}</p>

  <div class="talk-footnote">
    <span>{talk.event}</span>
    <span class="sep">·</span>
    <span>{talk.org}</span>
    {talk.venue && (
      <>
        <span class="sep">·</span>
        <span>{talk.venue}</span>
      </>
    )}
  </div>

  {talk.links.length > 0 && (
    <div class="talk-links">
      {talk.links.map((link) => (
        <a href={link.url} target="_blank" rel="noopener noreferrer" class="talk-link">
          {link.label}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7"/>
            <path d="M7 7h10v10"/>
          </svg>
        </a>
      ))}
    </div>
  )}
</article>

<style>
  .talk-card {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--ie-rule);
  }

  .talk-card:last-child {
    border-bottom: none;
  }

  .talk-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ie-muted);
  }

  .meta-sep {
    color: var(--ie-rule-strong);
  }

  .talk-type {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill, 999px);
    font-weight: 600;
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: var(--ie-blue-soft);
    color: var(--ie-blue);
  }

  .talk-type[data-type="workshop"] {
    background: var(--ie-blue-soft);
    color: var(--ie-blue);
  }

  .talk-type[data-type="keynote"] {
    background: var(--ie-rust-soft);
    color: var(--ie-rust);
  }

  .talk-type[data-type="panel"] {
    background: var(--ie-surface-raised);
    color: var(--ie-ink-secondary);
    border: 1px solid var(--ie-rule);
  }

  .talk-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
    color: var(--ie-ink);
  }

  .talk-description {
    margin: 0 0 0.75rem;
    color: var(--ie-ink-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .talk-footnote {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ie-muted);
    margin-bottom: 0.75rem;
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .talk-footnote .sep {
    color: var(--ie-rule-strong);
  }

  .talk-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .talk-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    min-height: 44px;
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius, 6px);
    background: var(--ie-surface);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ie-ink);
    text-decoration: none;
    transition: border-color 120ms ease, background-color 120ms ease, color 120ms ease;
  }

  .talk-link:hover {
    border-color: var(--ie-blue);
    background: var(--ie-blue-soft);
    color: var(--ie-blue);
  }

  .talk-link svg {
    flex-shrink: 0;
    color: var(--ie-muted);
  }

  @media (max-width: 640px) {
    .talk-card {
      padding: 1.25rem 0;
    }
  }
</style>
