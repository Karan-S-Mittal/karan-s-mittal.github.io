---
import VisualPage from '@layouts/VisualPage.astro';
import CodeReviewTopologies from '@components/diagram/version-control/CodeReviewTopologies.astro';
import { getDiagramBySlug } from '@data/diagrams';

const diagram = getDiagramBySlug('code-review-topologies')!;
---

<VisualPage
  title={diagram.title}
  description={diagram.description}
  explanation={diagram.explanation}
  targetId={diagram.targetId}
  filename={diagram.filename}
  category={diagram.category}
  canonicalId={diagram.canonicalId}
  modelStatus={diagram.modelStatus}
  provenance={diagram.provenance}
  socialImage={diagram.socialImage}
>
  <div class="visual-wrapper">
    <CodeReviewTopologies id="code-review-diagram" />
  </div>
</VisualPage>

<style>
  .visual-wrapper {
    width: 100%;
    padding: 1.5rem 0.5rem;
  }
</style>
