---
/**
 * DiagramExportBar.astro
 * Standardized action bar for publication-grade diagrams allowing one-click
 * high-resolution (3x) PNG downloads directly from the client.
 *
 * Adheres strictly to the Studio Diagramming Framework:
 * - Zero raw hex: All styles use semantic --ie-* tokens.
 * - Client-side high-resolution rendering with html-to-image.
 */
interface Props {
  targetId: string;
  filename?: string;
  caption?: string;
}

const {
  targetId,
  filename = 'studio-diagram',
  caption = 'Includes author attribution',
} = Astro.props;
---

<div class="diagram-export-bar" data-target-id={targetId} data-filename={filename}>
  <div class="export-actions">
    <button type="button" class="export-btn export-btn-primary" data-action="download-png">
      <svg class="btn-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <polyline points="7 10 12 15 17 10" />
        <line x1="12" y1="15" x2="12" y2="3" />
      </svg>
      <span class="btn-text">Download PNG</span>
    </button>

    <button type="button" class="export-btn export-btn-secondary" data-action="copy-link">
      <svg class="btn-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
      </svg>
      <span class="btn-text">Share Link</span>
    </button>

    <div class="scale-picker" role="group" aria-label="Export resolution scale">
      <span class="scale-label">Scale:</span>
      <div class="scale-buttons">
        <button type="button" class="scale-btn" data-scale="2" aria-pressed="false">2×</button>
        <button type="button" class="scale-btn active" data-scale="3" aria-pressed="true">3×</button>
        <button type="button" class="scale-btn" data-scale="4" aria-pressed="false">4×</button>
      </div>
    </div>
  </div>

  <div class="export-meta">
    <span class="meta-tag">3× HIGH-RES PNG</span>
    {caption && <span class="meta-caption">{caption}</span>}
  </div>
</div>

<script>
  import { toBlob } from 'html-to-image';

  function initExportBars() {
    const bars = document.querySelectorAll<HTMLElement>('.diagram-export-bar');
    bars.forEach((bar) => {
      if (bar.dataset.initialized === 'true') return;
      bar.dataset.initialized = 'true';

      const targetId = bar.dataset.targetId;
      const filename = bar.dataset.filename || 'diagram';
      const downloadBtn = bar.querySelector<HTMLButtonElement>('[data-action="download-png"]');
      const shareBtn = bar.querySelector<HTMLButtonElement>('[data-action="copy-link"]');
      const scaleButtons = bar.querySelectorAll<HTMLButtonElement>('.scale-btn');
      const metaTag = bar.querySelector<HTMLElement>('.meta-tag');

      let currentScale = 3;

      scaleButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const scale = parseInt(btn.dataset.scale || '3', 10);
          currentScale = scale;
          scaleButtons.forEach((b) => {
            const isActive = b === btn;
            b.classList.toggle('active', isActive);
            b.setAttribute('aria-pressed', String(isActive));
          });
          if (metaTag) {
            metaTag.textContent = `${scale}× HIGH-RES PNG`;
          }
        });
      });

      if (downloadBtn && targetId) {
        downloadBtn.addEventListener('click', async () => {
          const targetEl = document.getElementById(targetId);
          if (!targetEl) {
            console.error(`Export target #${targetId} not found.`);
            return;
          }

          const originalText = downloadBtn.querySelector('.btn-text')?.textContent || 'Download PNG';
          const textSpan = downloadBtn.querySelector('.btn-text');
          if (textSpan) textSpan.textContent = `Rendering ${currentScale}× PNG...`;
          downloadBtn.disabled = true;
          const restoreSvg: (() => void)[] = [];

          try {
            // Ensure all web fonts are fully rendered before capturing
            if (document.fonts && document.fonts.ready) {
              await document.fonts.ready;
            }

            // Computed background to ensure opaque capture across light/dark modes
            const computedStyle = window.getComputedStyle(document.documentElement);
            const surfaceColor = computedStyle.getPropertyValue('--ie-surface').trim() || 'rgb(255, 255, 255)';

            // Scale once: output pixels = measured CSS dimensions × pixelRatio.
            const scale = currentScale;
            const rect = targetEl.getBoundingClientRect();
            const width = Math.ceil(rect.width);
            const height = Math.ceil(rect.height);

            // SVG presentation attributes survive image serialization across browsers.
            // Resolve stylesheet paint while the nodes still have their page context.
            for (const node of targetEl.querySelectorAll<SVGElement>('svg *')) {
              const paint = getComputedStyle(node);
              for (const property of ['fill', 'fill-opacity', 'stroke', 'stroke-width', 'stroke-opacity', 'stroke-dasharray', 'stroke-dashoffset', 'stroke-linecap', 'stroke-linejoin', 'opacity']) {
                const previous = node.getAttribute(property);
                const value = paint.getPropertyValue(property);
                if (!value) continue;
                restoreSvg.push(() => previous === null ? node.removeAttribute(property) : node.setAttribute(property, previous));
                node.setAttribute(property, value);
              }
            }

            const blob = await toBlob(targetEl, {
              cacheBust: true,
              pixelRatio: scale,
              width,
              height,
              backgroundColor: surfaceColor,
              style: {
                width: `${width}px`,
                height: `${height}px`,
                margin: '0',
              },
              filter: (node) => {
                // Ignore the export bar itself if nested
                if (node instanceof HTMLElement && (node.classList.contains('diagram-export-bar') || node.hasAttribute('data-export-ignore'))) {
                  return false;
                }
                return true;
              },
            });

            if (!blob) throw new Error('The browser could not create the PNG.');
            const imageUrl = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.download = `${filename}-${scale}x-${document.documentElement.classList.contains('dark') ? 'dark' : 'light'}.png`;
            link.href = imageUrl;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            setTimeout(() => URL.revokeObjectURL(imageUrl), 60000);

            if (textSpan) textSpan.textContent = 'Downloaded!';
            setTimeout(() => {
              if (textSpan) textSpan.textContent = originalText;
              downloadBtn.disabled = false;
            }, 2000);
          } catch (err) {
            console.error('Failed to render diagram PNG:', err);
            if (textSpan) textSpan.textContent = 'Export Failed';
            setTimeout(() => {
              if (textSpan) textSpan.textContent = originalText;
              downloadBtn.disabled = false;
            }, 2000);
          } finally {
            restoreSvg.forEach((restore) => restore());
          }
        });
      }

      if (shareBtn) {
        shareBtn.addEventListener('click', async () => {
          const textSpan = shareBtn.querySelector('.btn-text');
          const originalText = textSpan?.textContent || 'Share Link';
          try {
            await navigator.clipboard.writeText(window.location.href);
            if (textSpan) textSpan.textContent = 'Copied URL!';
            setTimeout(() => {
              if (textSpan) textSpan.textContent = originalText;
            }, 2000);
          } catch {
            if (textSpan) textSpan.textContent = 'Press Ctrl+C';
            setTimeout(() => {
              if (textSpan) textSpan.textContent = originalText;
            }, 2000);
          }
        });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initExportBars);
  } else {
    initExportBars();
  }
  document.addEventListener('astro:page-load', initExportBars);
</script>

<style>
  .diagram-export-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--ie-surface-raised);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card);
    font-family: var(--font-diagram);
    margin-top: 1rem;
  }

  .export-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .export-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    min-height: 44px;
    font-size: var(--ie-type-micro);
    font-weight: 600;
    font-family: var(--font-diagram);
    border-radius: var(--radius);
    cursor: pointer;
    transition: background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }

  .export-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .export-btn-primary {
    background: var(--ie-blue);
    color: var(--ie-surface);
    border: 1px solid var(--ie-blue);
  }

  .export-btn-primary:hover:not(:disabled) {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  .export-btn-secondary {
    background: var(--ie-surface);
    color: var(--ie-ink);
    border: 1px solid var(--ie-rule-strong);
  }

  .export-btn-secondary:hover:not(:disabled) {
    background: var(--ie-surface-raised);
    border-color: var(--ie-ink);
  }

  .btn-icon {
    flex-shrink: 0;
  }

  .scale-picker {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: 0.25rem;
  }

  .scale-label {
    font-size: var(--ie-type-micro);
    font-family: var(--font-mono);
    color: var(--ie-muted);
  }

  .scale-buttons {
    display: inline-flex;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule-strong);
    border-radius: var(--radius);
    padding: 2px;
    gap: 2px;
  }

  .scale-btn {
    padding: 0.15rem 0.45rem;
    min-width: 44px;
    min-height: 44px;
    font-size: var(--ie-type-micro);
    font-family: var(--font-mono);
    font-weight: 600;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--ie-ink-secondary);
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .scale-btn:hover {
    color: var(--ie-ink);
  }

  .scale-btn.active {
    background: var(--ie-blue);
    color: var(--ie-surface);
  }

  .export-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .meta-tag {
    font-size: var(--ie-type-micro);
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.125rem 0.375rem;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-sm);
    color: var(--ie-ink-secondary);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .meta-caption {
    font-size: var(--ie-type-micro);
    color: var(--ie-muted);
    flex: 1;
    min-width: 0;
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .export-actions {
      width: 100%;
    }

    .scale-picker {
      margin-left: 0;
    }

    .export-meta {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
