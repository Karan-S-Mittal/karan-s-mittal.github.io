---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/content/PageHeader.astro';
import YearGroup from '@components/content/YearGroup.astro';
import TalkCard from '@components/content/TalkCard.astro';
import { externalWriting, software } from '@data/publications';
import talksData from '@data/talks.json';
import type { Talk } from '../types/talks';

// ---- Writing: on-site essays and external articles, newest first --------

interface WritingItem {
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  href: string;
  source: string;
  external: boolean;
}

const isDev = import.meta.env.DEV;
const essays: WritingItem[] = (await getCollection('blog'))
  .filter((post) => isDev || !post.data.draft)
  .map((post) => ({
    id: post.id,
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    href: `/writing/${post.id}/`,
    source: 'Essay',
    external: false,
  }));

const articles: WritingItem[] = externalWriting.map((item) => ({
  id: item.href,
  title: item.title,
  description: item.description,
  pubDate: new Date(item.pubDate),
  href: item.href,
  source: item.publication,
  external: true,
}));

const writing = [...essays, ...articles].sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

// ---- Talks, grouped by year -----------------------------------------------

const talks: Talk[] = [...talksData.talks].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
const talksByYear = talks.reduce<Record<string, Talk[]>>((acc, talk) => {
  (acc[talk.year] ||= []).push(talk);
  return acc;
}, {});
const talkYears = Object.keys(talksByYear).sort((a, b) => Number(b) - Number(a));

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

const sections = [
  { id: 'writing', label: 'Writing', show: true },
  { id: 'talks', label: 'Talks', show: talks.length > 0 },
  { id: 'software', label: 'Software', show: software.length > 0 },
].filter((section) => section.show);

// The headline names only the sections that exist ("Writing and talks.").
const kinds = sections.map((section) => section.id);
const headline = `${kinds.slice(0, -1).join(', ')}${kinds.length > 2 ? ',' : ''}${kinds.length > 1 ? ' and ' : ''}${kinds.at(-1)}.`;
const title = headline[0].toUpperCase() + headline.slice(1);
---

<Layout
  title="Publications | Karan Mittal"
  description="Writing, talks, and workshops by Karan Mittal on knowledge systems, LLM evaluation, and graph-grounded retrieval."
>
  <main class="container publications-page">
    <PageHeader
      label="Publications"
      title={title}
      description="Public work on knowledge systems, LLM evaluation, and graph-grounded retrieval."
    >
      <nav class="section-index" aria-label="On this page">
        {sections.map((section) => (
          <a class="more-link" href={`#${section.id}`}>{section.label}</a>
        ))}
      </nav>
    </PageHeader>

    <section id="writing" class="pub-section" aria-labelledby="writing-heading">
      <h2 id="writing-heading">Writing</h2>
      {writing.length > 0 ? (
        <ul class="pub-list">
          {writing.map((item) => (
            <li class="pub-item">
              <p class="pub-meta">
                <span class="pub-source">{item.source}</span>
                <time datetime={item.pubDate.toISOString()}>{formatDate(item.pubDate)}</time>
              </p>
              <h3 class="pub-title">
                <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined}>
                  {item.title}{item.external && <span class="ext-mark" aria-hidden="true">&nbsp;&nearr;</span>}
                </a>
              </h3>
              <p class="pub-desc">{item.description}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="pub-empty">Nothing published yet.</p>
      )}
    </section>

    {talks.length > 0 && (
      <section id="talks" class="pub-section" aria-labelledby="talks-heading">
        <h2 id="talks-heading">Talks and workshops</h2>
        <p class="pub-intro">
          Community talks and hands-on workshops, mostly with developer groups in Indore.
        </p>
        {talkYears.map((year) => (
          <YearGroup year={year}>
            {talksByYear[year].map((talk) => <TalkCard talk={talk} />)}
          </YearGroup>
        ))}
      </section>
    )}

    {software.length > 0 && (
      <section id="software" class="pub-section" aria-labelledby="software-heading">
        <h2 id="software-heading">Software</h2>
        <ul class="pub-list">
          {software.map((item) => (
            <li class="pub-item">
              <p class="pub-meta">
                <time datetime={item.released}>{formatDate(new Date(item.released))}</time>
              </p>
              <h3 class="pub-title">
                <a href={item.href} target="_blank" rel="noopener">
                  {item.title}<span class="ext-mark" aria-hidden="true">&nbsp;&nearr;</span>
                </a>
              </h3>
              <p class="pub-desc">{item.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="pub-section pub-closing" aria-labelledby="speaking-invite">
      <p class="eyebrow">Invite me to speak</p>
      <h2 id="speaking-invite">Teaching from direct systems practice.</h2>
      <p class="pub-intro">
        For a conference session or a workshop with your team, tell me about the audience and
        what you would like them to understand or build.
      </p>
      <a href="/contact/" class="button">Inquire about speaking</a>
    </section>
  </main>
</Layout>

<style>
  .section-index {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
  }

  /* Sections sit --gap-section apart; the first follows the page intro,
     which already supplies --gap-block. */
  .pub-section {
    padding-top: var(--gap-section);
    scroll-margin-top: 4rem;
  }

  .pub-section:first-of-type {
    padding-top: 0;
  }

  .pub-section > h2 {
    margin: 0 0 var(--gap-group);
    font-size: var(--ie-type-h2);
  }

  .pub-section > h2:has(+ .pub-intro) {
    margin-bottom: var(--gap-related);
  }

  .pub-intro {
    max-width: 620px;
    margin: 0 0 var(--gap-group);
    color: var(--ie-muted);
    font-size: var(--ie-type-body);
    line-height: 1.5;
  }

  .pub-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ie-rule);
    list-style: none;
  }

  .pub-item {
    margin: 0;
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--ie-rule);
  }

  .pub-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin: 0 0 0.5rem;
    color: var(--ie-muted);
    font-size: var(--ie-type-ui);
  }

  .pub-source {
    font-weight: 600;
  }

  .pub-meta time {
    font-family: var(--font-mono);
    font-size: var(--ie-type-caption);
  }

  .pub-title {
    max-width: 40ch;
    margin: 0 0 0.5rem;
    font-size: var(--ie-type-h3);
    line-height: 1.28;
    letter-spacing: -0.015em;
  }

  .pub-title a {
    color: var(--ie-ink);
  }

  .pub-title a:hover {
    color: var(--ie-blue);
  }

  .ext-mark {
    color: var(--ie-muted);
    font-size: 0.75em;
  }

  .pub-desc {
    max-width: 68ch;
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-h4);
    line-height: 1.55;
  }

  .pub-empty {
    color: var(--ie-muted);
  }

  .pub-closing h2 {
    margin-bottom: var(--gap-related);
  }
</style>
