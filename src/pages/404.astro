---
import Layout from '@layouts/Layout.astro';
---

<Layout title="Page not found | Karan Mittal" description="The page you asked for isn’t here." robots="noindex, follow">
  <main class="container lost">
    <p class="eyebrow">Error 404</p>
    <h1>Page not found</h1>
    <p class="lost-copy">
      It may have moved, or the link may be mistyped.
    </p>
    <div class="lost-actions">
      <a class="button" href="/">Back to the homepage</a>
      <a class="more-link" href="/publications/">Writing and talks</a>
    </div>
  </main>
</Layout>

<style>
  .lost h1 {
    max-width: 16ch;
    margin-bottom: var(--gap-related);
  }
  .lost-copy {
    max-width: 46ch;
    margin-bottom: var(--gap-group);
    color: var(--ie-muted);
    font-size: var(--ie-type-body);
  }
  .lost-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
  }
</style>
