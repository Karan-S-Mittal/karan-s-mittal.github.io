---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/content/PageHeader.astro';
import YearGroup from '@components/content/YearGroup.astro';
import TalkCard from '@components/content/TalkCard.astro';
import talksData from '@data/talks.json';
import type { Talk } from '../types/talks';

const talks: Talk[] = talksData.talks;

const sortedTalks = [...talks].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const talksByYear = sortedTalks.reduce<Record<string, Talk[]>>((acc, talk) => {
  if (!acc[talk.year]) acc[talk.year] = [];
  acc[talk.year].push(talk);
  return acc;
}, {});

const years = Object.keys(talksByYear).sort((a, b) => Number(b) - Number(a));
const allYears = [...new Set(talks.map((t) => t.year))].sort((a, b) => Number(b) - Number(a));
---

<Layout title="Talks & Workshops | Karan Mittal">
  <main class="container talks-page">
    <PageHeader
      label="Public Record"
      title="Talks, Workshops & Masterclasses."
      description="Working technical ideas in public: systems architecture, AI inference, deterministic retrieval, and low-level performance."
    />

    <div class="filters">
      <div class="search-wrap">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="talk-search"
          placeholder="Search talks, topics, or venues..."
          aria-label="Search talks"
          autocomplete="off"
        />
      </div>

      <div class="year-filter">
        <select id="year-filter" aria-label="Filter by year">
          <option value="">All years</option>
          {allYears.map((year) => (
            <option value={year}>{year}</option>
          ))}
        </select>
      </div>
    </div>

    <p id="no-results" class="no-results" style="display: none;">No matching talks found.</p>

    <div class="archive-list" id="talks-timeline">
      {years.map((year) => (
        <YearGroup year={year} count={talksByYear[year].length} unit="talk">
          {talksByYear[year].map((talk) => (
            <TalkCard
              talk={talk}
              searchText={[
                talk.title,
                talk.description,
                talk.event,
                talk.org,
                talk.venue,
                talk.type,
                ...talk.tags,
              ].join(' ').toLowerCase()}
            />
          ))}
        </YearGroup>
      ))}
    </div>

    <section class="cta-section">
      <div class="cta-inner">
        <span class="section-register">Speaking &amp; Workshops</span>
        <h2>Teaching from direct systems practice</h2>
        <p>Workshops and masterclasses are a rigorous way to test engineering ideas in the open. For speaking engagements or private technical workshops, start with the curriculum question.</p>
        <div class="cta-actions">
          <a href="/contact" class="ie-action primary">Inquire about speaking <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const searchInput = document.getElementById('talk-search');
  const yearSelect = document.getElementById('year-filter');
  const talks = document.querySelectorAll('.talk-card');
  const yearGroups = document.querySelectorAll('.year-group');
  const noResults = document.getElementById('no-results');

  function filterTalks() {
    const query = (searchInput as HTMLInputElement)?.value.toLowerCase().trim() || '';
    const selectedYear = (yearSelect as HTMLSelectElement)?.value || '';
    let visibleCount = 0;

    talks.forEach((talk) => {
      const text = (talk as HTMLElement).dataset.search || '';
      const year = (talk as HTMLElement).dataset.year || '';
      const matchesQuery = !query || text.includes(query);
      const matchesYear = !selectedYear || year === selectedYear;
      const match = matchesQuery && matchesYear;
      (talk as HTMLElement).style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });

    yearGroups.forEach((group) => {
      const visibleTalks = group.querySelectorAll('.talk-card');
      let hasVisible = false;
      visibleTalks.forEach((t) => {
        if ((t as HTMLElement).style.display !== 'none') hasVisible = true;
      });
      (group as HTMLElement).style.display = hasVisible ? '' : 'none';
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  searchInput?.addEventListener('input', filterTalks);
  yearSelect?.addEventListener('change', filterTalks);
</script>

<style>
  .talks-page {
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }

  .filters {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    flex-wrap: wrap;
  }

  .filters .search-wrap {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 240px;
    max-width: 420px;
  }

  .search-icon {
    position: absolute;
    left: 0.9rem;
    color: var(--ie-muted);
    pointer-events: none;
  }

  .filters .search-wrap input {
    width: 100%;
    padding: 0.55rem 1rem 0.55rem 2.5rem;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-pill, 999px);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--ie-ink);
    transition: border-color 120ms ease;
  }

  .filters .search-wrap input:focus {
    outline: none;
    border-color: var(--ie-blue);
  }

  .year-filter select {
    padding: 0.55rem 1.25rem;
    font-size: 0.85rem;
    font-family: var(--font-mono);
    color: var(--ie-ink);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-pill, 999px);
    outline: none;
    cursor: pointer;
    transition: border-color 120ms ease;
  }

  .year-filter select:focus {
    border-color: var(--ie-blue);
  }

  .no-results {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ie-muted);
    padding: 2rem 0;
  }

  .section-register {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--ie-blue);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .cta-section {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .cta-inner {
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 8px);
    background: var(--ie-surface);
  }

  .cta-inner h2 {
    margin: 0 0 0.5rem;
    color: var(--ie-ink);
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.6vw, 1.95rem);
    font-weight: 500;
  }

  .cta-inner p {
    margin: 0 0 1.5rem;
    max-width: 620px;
    color: var(--ie-ink-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .ie-action {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.55rem 1rem;
    border-radius: var(--radius, 6px);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 120ms ease, background-color 120ms ease, color 120ms ease;
  }

  .ie-action.primary {
    border: 1px solid var(--ie-ink);
    background: var(--ie-ink);
    color: var(--ie-canvas);
  }

  .ie-action.primary:hover {
    border-color: var(--ie-blue);
    background: var(--ie-blue);
    color: #fff;
  }

  @media (max-width: 768px) {
    .filters {
      flex-direction: column;
      align-items: stretch;
    }
    .filters .search-wrap {
      max-width: none;
    }
  }
</style>
