---
import VisualAttribution from './VisualAttribution.astro';

interface Props {
  id?: string;
  class?: string;
}

const {
  id = 'semiconductor-traceability-graph',
  class: className = '',
} = Astro.props;
---

<figure id={id} class:list={['semiconductor-traceability-figure', className]}>
  <svg
    class="semiconductor-traceability-graph desktop-graph"
    viewBox="0 0 980 700"
    role="img"
    aria-labelledby={`${id}-title ${id}-description`}
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id={`${id}-title`}>Semiconductor Traceability Graph (Explanatory Model)</title>
    <desc id={`${id}-description`}>
      Explanatory model: Four separated process stages show a semiconductor dependency chain, PFAS evidence review,
      cost-of-quality consequences, and routing between general, distilled, and human review. Specific entity identifiers
      and relations illustrate the architectural pattern.
    </desc>

    <defs>
      <marker id={`${id}-arrow-blue`} viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M1.5 1.5 6.5 4 1.5 6.5" fill="none" stroke="var(--ie-blue)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
      <marker id={`${id}-arrow-green`} viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M1.5 1.5 6.5 4 1.5 6.5" fill="none" stroke="var(--ie-verified)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
      <marker id={`${id}-arrow-rust`} viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M1.5 1.5 6.5 4 1.5 6.5" fill="none" stroke="var(--ie-rust)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
    </defs>

    <g class="graph-layer graph-layer-1">
      <text x="24" y="28" class="stage-title">
        <tspan class="stage-index">01</tspan><tspan dx="12">Dependency structure</tspan>
      </text>

      <g transform="translate(24 54)">
        <rect width="170" height="64" rx="8" class="node-surface" />
        <text x="16" y="28" class="node-title">Supplier S-14</text>
        <text x="16" y="48" class="node-note">site · qualification</text>
      </g>
      <g transform="translate(264 54)">
        <rect width="170" height="64" rx="8" class="node-surface" />
        <text x="16" y="28" class="node-title">Material lot C17</text>
        <text x="16" y="48" class="node-note">compound · batch</text>
      </g>
      <g transform="translate(504 54)">
        <rect width="170" height="64" rx="8" class="node-primary" />
        <text x="16" y="28" class="node-title">Part P-4821</text>
        <text x="16" y="48" class="node-note">controlled component</text>
      </g>
      <g transform="translate(744 54)">
        <rect width="212" height="64" rx="8" class="node-surface" />
        <text x="16" y="28" class="node-title">Controller assembly</text>
        <text x="16" y="48" class="node-note">line · product family</text>
      </g>

      <path d="M194 86H258" class="edge-blue" marker-end={`url(#${id}-arrow-blue)`} />
      <path d="M434 86H498" class="edge-blue" marker-end={`url(#${id}-arrow-blue)`} />
      <path d="M674 86H738" class="edge-blue" marker-end={`url(#${id}-arrow-blue)`} />
      <text x="226" y="75" text-anchor="middle" class="edge-label">supplies</text>
      <text x="466" y="75" text-anchor="middle" class="edge-label">used in</text>
      <text x="706" y="75" text-anchor="middle" class="edge-label">feeds</text>
    </g>

    <g class="graph-layer graph-layer-2">
      <text x="24" y="178" class="stage-title">
        <tspan class="stage-index">02</tspan><tspan dx="12">PFAS evidence</tspan>
      </text>

      <g transform="translate(24 204)">
        <rect width="170" height="64" rx="8" class="node-surface" />
        <text x="16" y="28" class="node-title">Part + material</text>
        <text x="16" y="48" class="node-note">identity · supplier · lot</text>
      </g>
      <g transform="translate(264 204)">
        <rect width="170" height="64" rx="8" class="node-surface" />
        <text x="16" y="28" class="node-title">Supplier evidence</text>
        <text x="16" y="48" class="node-note">declaration · revision</text>
      </g>
      <g transform="translate(504 204)">
        <rect width="170" height="64" rx="8" class="node-surface" />
        <text x="16" y="28" class="node-title">PFAS assessment</text>
        <text x="16" y="48" class="node-note">substance · threshold</text>
      </g>
      <g transform="translate(744 204)">
        <rect width="212" height="64" rx="8" class="node-verified" />
        <text x="16" y="28" class="node-title">Evidence register</text>
        <text x="16" y="48" class="node-note">claim · source · confidence</text>
      </g>

      <path d="M194 236H258" class="edge-green" marker-end={`url(#${id}-arrow-green)`} />
      <path d="M434 236H498" class="edge-green" marker-end={`url(#${id}-arrow-green)`} />
      <path d="M674 236H738" class="edge-green" marker-end={`url(#${id}-arrow-green)`} />
      <text x="226" y="225" text-anchor="middle" class="edge-label">scope</text>
      <text x="466" y="225" text-anchor="middle" class="edge-label">screen</text>
      <text x="706" y="225" text-anchor="middle" class="edge-label">record</text>
    </g>

    <g class="graph-layer graph-layer-3">
      <text x="24" y="328" class="stage-title">
        <tspan class="stage-index">03</tspan><tspan dx="12">Cost of quality</tspan>
      </text>

      <g transform="translate(24 354)">
        <rect width="170" height="64" rx="8" class="node-constraint" />
        <text x="16" y="28" class="node-title constraint-text">Evidence gap</text>
        <text x="16" y="48" class="node-note">unresolved relationship</text>
      </g>
      <g transform="translate(264 354)">
        <rect width="170" height="64" rx="8" class="node-surface" />
        <text x="16" y="28" class="node-title">Quality event</text>
        <text x="16" y="48" class="node-note">hold · retest · rework</text>
      </g>
      <g transform="translate(504 354)">
        <rect width="170" height="64" rx="8" class="node-surface" />
        <text x="16" y="28" class="node-title">Cost attribution</text>
        <text x="16" y="48" class="node-note">appraisal · failure · delay</text>
      </g>
      <g transform="translate(744 354)">
        <rect width="212" height="64" rx="8" class="node-surface" />
        <text x="16" y="28" class="node-title">Disposition</text>
        <text x="16" y="48" class="node-note">release · contain · replace</text>
      </g>

      <path d="M194 386H258" class="edge-rust" marker-end={`url(#${id}-arrow-rust)`} />
      <path d="M434 386H498" class="edge-blue" marker-end={`url(#${id}-arrow-blue)`} />
      <path d="M674 386H738" class="edge-blue" marker-end={`url(#${id}-arrow-blue)`} />
      <text x="226" y="375" text-anchor="middle" class="edge-label">triggers</text>
      <text x="466" y="375" text-anchor="middle" class="edge-label">attributes</text>
      <text x="706" y="375" text-anchor="middle" class="edge-label">informs</text>
    </g>

    <g class="graph-layer graph-layer-4">
      <text x="24" y="478" class="stage-title">
        <tspan class="stage-index">04</tspan><tspan dx="12">Specialized review</tspan>
      </text>

      <g transform="translate(24 554)">
        <rect width="170" height="64" rx="8" class="node-surface" />
        <text x="16" y="28" class="node-title">Review request</text>
        <text x="16" y="48" class="node-note">part + evidence</text>
      </g>

      <path d="M194 586H224V546H258" class="edge-blue" marker-end={`url(#${id}-arrow-blue)`} />
      <path d="M224 586V626H258" class="edge-green" marker-end={`url(#${id}-arrow-green)`} />
      <circle cx="224" cy="586" r="3" class="junction-blue" />
      <text x="240" y="534" text-anchor="middle" class="edge-label">novel</text>
      <text x="241" y="646" text-anchor="middle" class="edge-label">bounded</text>

      <g transform="translate(264 514)">
        <rect width="170" height="64" rx="8" class="node-primary" />
        <text x="16" y="28" class="node-title">General agent</text>
        <text x="16" y="48" class="node-note">broad search</text>
      </g>
      <g transform="translate(264 594)">
        <rect width="170" height="64" rx="8" class="node-specialized" />
        <text x="16" y="28" class="node-title">Distilled reviewer</text>
        <text x="16" y="48" class="node-note">bounded · repeatable</text>
      </g>

      <g transform="translate(504 554)">
        <rect width="170" height="64" rx="8" class="node-verified" />
        <text x="16" y="28" class="node-title">Graph-grounded check</text>
        <text x="16" y="48" class="node-note">relations + evidence</text>
      </g>

      <path d="M434 546H466V586H498" class="edge-blue" marker-end={`url(#${id}-arrow-blue)`} />
      <path d="M434 626H466V586H498" class="edge-green" marker-end={`url(#${id}-arrow-green)`} />
      <circle cx="466" cy="586" r="3" class="junction-green" />
      <text x="466" y="534" text-anchor="middle" class="edge-label">reason</text>
      <text x="466" y="646" text-anchor="middle" class="edge-label">repeat</text>

      <g transform="translate(744 514)">
        <rect width="212" height="64" rx="8" class="node-surface" />
        <text x="16" y="28" class="node-title">Verified route</text>
        <text x="16" y="48" class="node-note">decision + trace</text>
      </g>
      <g transform="translate(744 594)">
        <rect width="212" height="64" rx="8" class="node-surface" />
        <text x="16" y="28" class="node-title">Human review</text>
        <text x="16" y="48" class="node-note">novel or uncertain</text>
      </g>

      <path d="M674 586H706V546H738" class="edge-green" marker-end={`url(#${id}-arrow-green)`} />
      <path d="M674 586H706V626H738" class="edge-rust edge-dashed" marker-end={`url(#${id}-arrow-rust)`} />
      <circle cx="706" cy="586" r="3" class="junction-green" />
      <text x="706" y="534" text-anchor="middle" class="edge-label">pass</text>
      <text x="706" y="646" text-anchor="middle" class="edge-label">escalate</text>
    </g>
  </svg>

  <!-- Mobile Focused Stage View: 100% responsive, zero horizontal overflow -->
  <div class="mobile-stage-view" aria-label="Focused stage view of semiconductor traceability graph">
    <!-- Stage 01 Mobile Card -->
    <div class="mobile-stage-card mobile-stage-1">
      <div class="mobile-stage-header">
        <span class="mobile-stage-num">01</span>
        <span class="mobile-stage-name">Dependency structure</span>
      </div>
      <svg class="mobile-stage-svg" viewBox="0 0 340 148" fill="none" xmlns="http://www.w3.org/2000/svg" role="img">
        <defs>
          <marker id={`${id}-m1-arr-blue`} viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M1.5 1.5 6.5 4 1.5 6.5" fill="none" stroke="var(--ie-blue)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
