---
/**
 * KVEvolutionArchitecture.astro
 * HTML/CSS-native architectural comparison of MHA vs MQA vs GQA KV Cache Heads.
 */
import Exhibit from '../../editorial/Exhibit.astro';

interface Props {
  caption?: string;
  exhibit?: string;
  title?: string;
}

const {
  caption = 'Multi-Head Attention (MHA) pairs each Query head with its own KV head. Multi-Query Attention (MQA) shares 1 KV head across all Query heads (up to 8× memory reduction, with potential quality trade-offs). Grouped-Query Attention (GQA) groups Query heads into clusters, striking a clean balance between memory bandwidth and capacity.',
  exhibit = '02',
  title = 'The Evolution of KV-Cache Head Architectures: MHA vs MQA vs GQA',
} = Astro.props;
---

<Exhibit exhibit={exhibit} title={title} badge="TENSOR GEOMETRY" caption={caption} wide>
  <div class="head-root">
    <div class="head-grid">
      <!-- MHA -->
      <div class="head-card">
        <div class="head-card-top">
          <span class="head-tag">MHA (MULTI-HEAD)</span>
          <h4 class="head-title">1:1 Ratio</h4>
          <span class="head-meta">8 Query Heads &bull; 8 KV Heads</span>
        </div>

        <div class="tensor-diagram">
          <div class="q-group">
            <span class="t-lbl">Query:</span>
            <div class="q-boxes">
              <span class="t-box q-box">Q₁</span>
              <span class="t-box q-box">Q₂</span>
              <span class="t-box q-box">Q₃</span>
              <span class="t-box q-box">Q₄</span>
            </div>
          </div>
          <div class="map-arrows">&darr;&darr;&darr;&darr; (1:1 Independent)</div>
          <div class="kv-group">
            <span class="t-lbl">KV Heads:</span>
            <div class="kv-boxes">
              <span class="t-box kv-box">KV₁</span>
              <span class="t-box kv-box">KV₂</span>
              <span class="t-box kv-box">KV₃</span>
              <span class="t-box kv-box">KV₄</span>
            </div>
          </div>
        </div>

        <div class="head-footer">
          <span class="footer-cost">Baseline Cache: 100% (1.31 GB / seq)</span>
          <span class="footer-note">Heavy memory bandwidth during decode</span>
        </div>
      </div>

      <!-- MQA -->
      <div class="head-card">
        <div class="head-card-top">
          <span class="head-tag tag-warn">MQA (MULTI-QUERY)</span>
          <h4 class="head-title">8:1 Extreme Sharing</h4>
          <span class="head-meta">8 Query Heads &bull; 1 Shared KV Head</span>
        </div>

        <div class="tensor-diagram">
          <div class="q-group">
            <span class="t-lbl">Query:</span>
            <div class="q-boxes">
              <span class="t-box q-box">Q₁</span>
              <span class="t-box q-box">Q₂</span>
              <span class="t-box q-box">Q₃</span>
              <span class="t-box q-box">Q₄</span>
            </div>
          </div>
          <div class="map-arrows">&searrow;&swarrow; (Shared Broadcast)</div>
          <div class="kv-group">
            <span class="t-lbl">KV Heads:</span>
            <div class="kv-boxes">
              <span class="t-box kv-box-shared">Single Shared KV Head</span>
            </div>
          </div>
        </div>

        <div class="head-footer">
          <span class="footer-cost">Max Savings: 12.5% (8× reduction)</span>
          <span class="footer-note">May suffer representational capacity loss</span>
        </div>
      </div>

      <!-- GQA -->
      <div class="head-card card-gqa">
        <div class="head-card-top">
          <span class="head-tag tag-signal">GQA (GROUPED-QUERY)</span>
          <h4 class="head-title">4:1 Grouped Balance</h4>
          <span class="head-meta">8 Query Heads &bull; 2 KV Heads (Llama-3 Standard)</span>
        </div>

        <div class="tensor-diagram">
          <div class="q-group">
            <span class="t-lbl">Query Groups:</span>
            <div class="q-boxes">
              <span class="t-box q-box">[Q₁, Q₂]</span>
              <span class="t-box q-box">[Q₃, Q₄]</span>
            </div>
          </div>
          <div class="map-arrows">&darr; &darr; (Grouped Projections)</div>
          <div class="kv-group">
            <span class="t-lbl">KV Heads:</span>
            <div class="kv-boxes">
              <span class="t-box kv-box-gqa">Group 1 KV</span>
              <span class="t-box kv-box-gqa">Group 2 KV</span>
            </div>
          </div>
        </div>

        <div class="head-footer">
          <span class="footer-cost footer-signal">Optimal: 25% (4× reduction)</span>
          <span class="footer-note">Full model expressivity with 4× throughput</span>
        </div>
      </div>
    </div>

    <!-- NOTICE LEADER -->
    <div class="head-notice">
      <span class="notice-arrow">&larr;</span>
      <span>Notice how Grouped-Query Attention (GQA) strikes the golden mean: 4× reduction in memory bandwidth bottlenecks while preserving full expressive capacity.</span>
    </div>
  </div>
</Exhibit>

<style>
  .head-root {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--surface-card);
    border-radius: var(--radius-card);
  }

  .head-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
  }

  .head-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--bg);
    border: 1px solid var(--border-default);
    border-radius: 8px;
  }

  .card-gqa {
    background: color-mix(in srgb, var(--accent) 5%, var(--bg));
    border-color: var(--accent);
  }

  .head-card-top {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .head-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .tag-warn { color: var(--text-muted); }
  .tag-signal { color: var(--accent); }

  .head-title {
    margin: 0;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text);
  }

  .head-meta {
    font-size: 11px;
    color: var(--text-muted);
  }

  .tensor-diagram {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-3);
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 6px;
  }

  .t-lbl {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 600;
    color: var(--text-muted);
  }

  .q-boxes, .kv-boxes {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    margin-top: 2px;
  }

  .t-box {
    padding: 3px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
  }

  .q-box {
    background: color-mix(in srgb, var(--text) 6%, transparent);
    border: 1px solid var(--border-default);
    color: var(--text);
  }

  .kv-box {
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
  }

  .kv-box-shared {
    flex: 1;
    text-align: center;
    background: color-mix(in srgb, var(--signal-warm, #FFAFCC) 20%, transparent);
    border: 1px solid var(--accent);
    color: var(--text);
  }

  .kv-box-gqa {
    flex: 1;
    text-align: center;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    border: 1px solid var(--accent);
    color: var(--accent);
  }

  .map-arrows {
    font-family: var(--font-mono);
    font-size: 9.5px;
    text-align: center;
    color: var(--text-muted);
    padding: 2px 0;
  }

  .head-footer {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: var(--space-2);
    border-top: 1px dashed var(--border-default);
    margin-top: auto;
  }

  .footer-cost {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    color: var(--text);
  }

  .footer-signal {
    color: var(--accent);
  }

  .footer-note {
    font-size: 10.5px;
    color: var(--text-muted);
  }

  .head-notice {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-muted);
    padding-top: var(--space-2);
    border-top: 1px dashed var(--border-default);
  }

  .notice-arrow {
    font-weight: 700;
    color: var(--accent);
  }
</style>
