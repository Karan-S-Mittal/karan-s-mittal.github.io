---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/content/PageHeader.astro';
import YearGroup from '@components/content/YearGroup.astro';
import BlogPostCard from '@components/content/BlogPostCard.astro';
import { externalWriting } from '@data/publications';

const allPosts = await getCollection('blog');
const isDev = import.meta.env.DEV;
const posts = allPosts
  .filter((post) => isDev || !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const postsByYear = posts.reduce<Record<string, typeof posts>>((acc, post) => {
  const year = post.data.pubDate.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<Layout title="Writing and systems notes | Karan Mittal" description="Evidence-backed essays on version control, AI systems, distributed infrastructure, and performance engineering.">
  <main class="container writing-page">
    <PageHeader
      label="Writing"
      title="Writing and systems notes."
      description="Evidence-backed explanations of version control, AI systems, distributed infrastructure, and performance engineering."
    />

    <section class="external-writing" aria-labelledby="external-writing-title">
      <div class="external-writing-head">
        <span>Published elsewhere</span>
        <h2 id="external-writing-title">Writing for engineering audiences.</h2>
      </div>
      {externalWriting.map((article) => (
        <a class="external-writing-row" href={article.href} target="_blank" rel="noopener">
          <div class="external-meta">
            <span>{article.publication}</span>
            <time datetime={article.pubDate}>{new Date(article.pubDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}</time>
          </div>
          <div>
            <h3>{article.title}</h3>
            <p>{article.description}</p>
          </div>
          <span class="external-action">Read at {article.publication} ↗</span>
        </a>
      ))}
    </section>

    <div class="archive-list" id="writing-timeline">
      {years.length > 0 ? (
        years.map((year) => (
          <YearGroup year={year} count={postsByYear[year].length}>
            {postsByYear[year].map((post) => (
              <BlogPostCard
                post={post}
              />
            ))}
          </YearGroup>
        ))
      ) : (
        <div class="empty-blog-state">
          <p>No essays published yet. Starting afresh.</p>
          <p class="empty-subtext">Add new posts in <code>src/content/blog/</code> using <code>npm run new</code>.</p>
        </div>
      )}
    </div>
  </main>
</Layout>

<style>
  .writing-page {
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }

  .external-writing {
    margin-bottom: clamp(3rem, 7vw, 5rem);
    border-top: 1px solid var(--ie-rule-strong);
  }

  .external-writing-head {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--ie-rule);
  }

  .external-writing-head > span {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--ie-blue);
    font-family: var(--font-sans);
    font-size: var(--ie-type-label);
    font-weight: 600;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .external-meta {
    display: grid;
    gap: 0.25rem;
    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label);
    line-height: 1.5;
  }

  .external-action {
    min-height: 44px;
    align-content: center;
    color: var(--ie-blue);
    font-family: var(--font-sans);
    font-size: var(--ie-type-ui);
    font-weight: 600;
    white-space: nowrap;
    transition: color 160ms ease;
  }

  .external-writing-head h2 {
    margin: 0;
    color: var(--ie-ink);
    font-family: var(--font-display);
    font-size: var(--ie-type-h2);
  }

  .external-writing-row {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: start;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--ie-rule);
    color: inherit;
    text-decoration: none;
  }

  .external-meta {
    display: grid;
    gap: 0.2rem;
  }

  .external-writing-row h3 {
    margin: 0 0 0.4rem;
    color: var(--ie-ink);
    font-family: var(--font-display);
    font-size: var(--ie-type-h3);
    line-height: 1.3;
  }

  .external-writing-row p {
    max-width: 65ch;
    margin: 0;
    color: var(--ie-ink-secondary);
    font-family: var(--font-sans);
    font-size: var(--ie-type-small);
    line-height: 1.6;
  }

  .external-action {
    min-height: 44px;
    align-content: center;
    color: var(--ie-blue);
    white-space: nowrap;
  }

  .external-writing-row:hover h3 { color: var(--ie-blue); }

  @media (max-width: 720px) {
    .external-writing-row {
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }

    .external-meta {
      grid-template-columns: auto 1fr;
      gap: 0.75rem;
    }

    .external-action { min-height: 0; }
  }

  .empty-blog-state {
    padding: 3rem 0;
    color: var(--ie-muted);
    font-family: var(--font-sans);
    font-size: var(--ie-type-body);
  }
  .empty-subtext {
    margin-top: 0.5rem;
    font-size: var(--ie-type-ui);
    color: var(--ie-ink-secondary);
  }
  .empty-subtext code {
    font-family: var(--font-mono);
    padding: 0.1rem 0.35rem;
    background: var(--ie-surface-raised);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-sm);
  }
</style>
