---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';
import VisualMicroSchematic from '@components/visuals/VisualMicroSchematic.astro';
import HeroWorkflowGraph from '@components/visuals/HeroWorkflowGraph.astro';
import '@styles/practice.css';

const publishedPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPosts = [...publishedPosts.filter(p => p.data.featured), ...publishedPosts.filter(p => !p.data.featured)].slice(0, 3);
const formatDate = (date: Date | string) => new Date(date).toLocaleDateString('en-GB', {day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC'});

const featuredBlueprints: Array<{
  slug: string;
  title: string;
  desc: string;
  badge: string;
  archetype: 'hierarchy' | 'comparison';
}> = [
  {
    slug: 'platform-stack',
    title: 'Developer Platform Stack',
    desc: 'The four-tier architecture spanning POSIX Git Merkle DAGs, auth gateways, CI runners, and ephemeral cloud workspaces.',
    badge: 'SYSTEM ARCHITECTURE',
    archetype: 'hierarchy',
  },
  {
    slug: 'code-review-topologies',
    title: 'Three Code Review Topologies',
    desc: 'Comparative breakdown of code review: GitHub Branch PRs vs. Gerrit Stacked Changes vs. Linux Kernel Patch series.',
    badge: 'REVIEW PROTOCOL',
    archetype: 'comparison',
  },
];
---

<Layout title={SITE.title} description={SITE.description}>
  <main class="practice-page">
    <!-- Centered Hero -->
    <section class="hero hero-centric" aria-labelledby="home-title">
      <div class="hero-content">
        <span class="register">Karan Mittal &bull; Systems Engineering &amp; MLOps</span>
        <h1 id="home-title">Solve the real problem.<br />Build a system that lasts.</h1>
        <p class="lead">
          I help engineering teams turn unpredictable LLM prototypes into reliable, cost-efficient production systems—through state-graph workflows, smart model routing, and automated evaluation.
        </p>
        <div class="actions">
          <a class="action" href="/contact">Discuss your system →</a>
          <a class="action secondary" href="/publications#blueprints">Explore architecture blueprints →</a>
        </div>
      </div>
      <HeroWorkflowGraph />
    </section>

    <!-- 3 Core Pillars: Ruled Editorial Ledger -->
    <section class="pillar-ledger-section" aria-label="Core focus areas">
      <div class="pillar-ledger">
        <article class="ledger-row">
          <div class="ledger-meta">
            <span class="ledger-index">[01]</span>
            <span class="ledger-tag">STATE GRAPHS</span>
          </div>
          <div class="ledger-content">
            <h3>Get models to follow instructions.</h3>
            <p>Replace fragile single-prompt chains with structured state graphs, tool sandboxes, and schema validation. Ensure agents reliably complete multi-step tasks without getting stuck in infinite loops.</p>
          </div>
          <div class="ledger-badge-wrap">
            <span class="ledger-badge">100% Deterministic flow</span>
          </div>
        </article>

        <article class="ledger-row">
          <div class="ledger-meta">
            <span class="ledger-index">[02]</span>
            <span class="ledger-tag">TOKEN EFFICIENCY</span>
          </div>
          <div class="ledger-content">
            <h3>Stop overpaying for tokens.</h3>
            <p>Architect tiered model routing, semantic caching, and prompt compaction. Run 90% of routine traffic on fast, inexpensive models to cut monthly API spend by up to 70%.</p>
          </div>
          <div class="ledger-badge-wrap">
            <span class="ledger-badge">~70% API spend cut</span>
          </div>
        </article>

        <article class="ledger-row">
          <div class="ledger-meta">
            <span class="ledger-index">[03]</span>
            <span class="ledger-tag">EVAL HARNESS</span>
          </div>
          <div class="ledger-content">
            <h3>Ship model updates safely.</h3>
            <p>Build automated regression test suites and policy gates into CI/CD. Test prompt adjustments and new model releases against benchmark datasets before they touch customers.</p>
          </div>
          <div class="ledger-badge-wrap">
            <span class="ledger-badge">Automated CI/CD gates</span>
          </div>
        </article>
      </div>
    </section>

    <!-- Section 01: Featured Architecture Blueprints -->
    <section class="section" aria-labelledby="blueprints-heading">
      <div class="section-head">
        <div>
          <span class="register">01 / Verified blueprints</span>
          <h2 id="blueprints-heading">Architectures you can inspect.</h2>
        </div>
        <a href="/publications#blueprints">Explore blueprint library →</a>
      </div>
      <div class="featured-blueprints-grid">
        {featuredBlueprints.map(bp => (
          <a href={`/visuals/${bp.slug}/`} class="blueprint-showcase-card">
            <VisualMicroSchematic slug={bp.slug} archetype={bp.archetype} />
            <div class="blueprint-card-info">
              <span class="register">{bp.badge}</span>
              <h3>{bp.title}</h3>
              <p>{bp.desc}</p>
              <span class="blueprint-card-cta">Inspect blueprint &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Section 02: Selected Publications -->
    <section class="section" aria-labelledby="publications-heading">
      <div class="section-head">
        <div>
          <span class="register">02 / Selected publications</span>
          <h2 id="publications-heading">Deep dives &amp; systems architecture.</h2>
        </div>
        <a href="/publications">All publications →</a>
      </div>
      {featuredPosts.length > 0 ? (
        featuredPosts.map(post => (
          <a class="note-row" href={`/blog/${post.id}/`}>
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
          </a>
        ))
      ) : (
        <p class="empty-state">Starting afresh with new systems essays. Check back soon.</p>
      )}
    </section>

    <!-- Centered Closing -->
    <section class="closing centered-closing" aria-labelledby="closing-heading">
      <span class="register">03 / Start a conversation</span>
      <h2 id="closing-heading">Have an AI system that needs to work better?</h2>
      <p class="lead">Whether you are struggling with agent reliability, runaway API bills, or scaling your evaluation pipeline, let’s talk through the engineering.</p>
      <div class="actions">
        <a href="/contact" class="action">Tell me what needs to work better →</a>
        <a href="/work" class="action secondary">Explore advisory &amp; build options →</a>
      </div>
    </section>
  </main>
</Layout>
