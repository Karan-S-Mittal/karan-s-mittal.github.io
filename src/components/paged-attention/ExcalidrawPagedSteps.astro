---
/**
 * ExcalidrawPagedSteps.astro
 * Progressive, step-by-step interactive visualizer for PagedAttention.
 * Allows reader to build up the mental model iteratively:
 * Step 1 (Virtual Blocks) -> Step 2 (Block Table) -> Step 3 (Scattered HBM) -> Step 4 (SRAM Gather)
 */
import ExcalidrawContainer from './ExcalidrawContainer.astro';

interface Props {
  caption?: string;
  exhibit?: string;
  title?: string;
}

const { caption = "Figure 4: The Progressive Mechanics of PagedAttention — Click the steps below to trace how virtual tokens map to scattered physical GPU memory.", exhibit, title } = Astro.props;
---

<ExcalidrawContainer caption={caption} exhibit={exhibit} title={title} badge="Step-by-Step Architecture">
  <!-- Interactive Step Switcher -->
  <div class="ex-steps-nav" role="tablist" aria-label="PagedAttention Stages">
    <button class="ex-step-tab active" data-target="all" role="tab" aria-selected="true">
      Full Flow
    </button>
    <button class="ex-step-tab" data-target="s1" role="tab" aria-selected="false">
      1. Virtual Blocks
    </button>
    <button class="ex-step-tab" data-target="s2" role="tab" aria-selected="false">
      2. Block Table
    </button>
    <button class="ex-step-tab" data-target="s3" role="tab" aria-selected="false">
      3. GPU Memory Pool
    </button>
    <button class="ex-step-tab" data-target="s4" role="tab" aria-selected="false">
      4. In-Kernel Gather
    </button>
  </div>

  <div class="ex-step-explainer" id="ex-step-desc">
    <strong>Complete Architecture:</strong> Virtual tokens sliced into logical blocks, translated via Block Table to scattered HBM frames, gathered in GPU SRAM.
  </div>

  <!-- SVG Diagram Canvas -->
  <svg id="ex-paged-steps-svg" class="ex-svg-canvas" viewBox="0 0 740 370" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <!-- Custom Excalidraw Arrow Markers -->
      <marker id="ex-arrow-s1" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 1 2 L 8 5 L 1 8 z" fill="var(--ex-blue-stroke)" />
      </marker>
      <marker id="ex-arrow-s2" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 1 2 L 8 5 L 1 8 z" fill="var(--ex-indigo-stroke)" />
      </marker>
      <marker id="ex-arrow-s3" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 1 2 L 8 5 L 1 8 z" fill="var(--ex-green-stroke)" />
      </marker>
      <marker id="ex-arrow-s4" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 1 2 L 8 5 L 1 8 z" fill="var(--ex-purple-stroke)" />
      </marker>
    </defs>

    <!-- ==================================================== -->
    <!-- STAGE 1: LOGICAL VIRTUAL BLOCKS -->
    <!-- ==================================================== -->
    <g id="step-group-s1" class="step-group">
      <!-- Section Label -->
      <text x="16" y="24" font-family="var(--font-sans)" font-size="13" font-weight="700" fill="var(--ex-blue-text)">
        1. Virtual Blocks (Logical)
      </text>

      <!-- Logical Block 0 (Blue) -->
      <g transform="translate(16, 40)">
        <rect x="0" y="0" width="145" height="135" rx="8" fill="var(--ex-card-bg)" stroke="var(--ex-blue-stroke)" stroke-width="1.5" />
        <rect x="6" y="6" width="133" height="24" rx="4" fill="var(--ex-blue-bg)" />
        <text x="72" y="22" text-anchor="middle" font-family="var(--font-mono)" font-size="11.5" font-weight="700" fill="var(--ex-blue-text)">
          Logical Block #0
        </text>

        <!-- Tokens -->
        <g transform="translate(10, 38)">
          <rect x="0" y="0" width="125" height="20" rx="3" fill="var(--ex-blue-bg)" />
          <text x="8" y="14" font-family="var(--font-mono)" font-size="10.5" fill="var(--ex-blue-text)">t₀: "The"</text>
          
          <rect x="0" y="24" width="125" height="20" rx="3" fill="var(--ex-blue-bg)" />
          <text x="8" y="38" font-family="var(--font-mono)" font-size="10.5" fill="var(--ex-blue-text)">t₁: "quick"</text>

          <rect x="0" y="48" width="125" height="20" rx="3" fill="var(--ex-blue-bg)" />
          <text x="8" y="62" font-family="var(--font-mono)" font-size="10.5" fill="var(--ex-blue-text)">t₂: "brown"</text>

          <rect x="0" y="72" width="125" height="20" rx="3" fill="var(--ex-blue-bg)" />
          <text x="8" y="86" font-family="var(--font-mono)" font-size="10.5" fill="var(--ex-blue-text)">t₃: "fox"</text>
        </g>
      </g>

      <!-- Logical Block 1 (Indigo) -->
      <g transform="translate(16, 195)">
        <rect x="0" y="0" width="145" height="135" rx="8" fill="var(--ex-card-bg)" stroke="var(--ex-indigo-stroke)" stroke-width="1.5" />
        <rect x="6" y="6" width="133" height="24" rx="4" fill="var(--ex-indigo-bg)" />
        <text x="72" y="22" text-anchor="middle" font-family="var(--font-mono)" font-size="11.5" font-weight="700" fill="var(--ex-indigo-text)">
          Logical Block #1
        </text>

        <!-- Tokens -->
        <g transform="translate(10, 38)">
          <rect x="0" y="0" width="125" height="20" rx="3" fill="var(--ex-indigo-bg)" />
          <text x="8" y="14" font-family="var(--font-mono)" font-size="10.5" fill="var(--ex-indigo-text)">t₄: "jumps"</text>
          
          <rect x="0" y="24" width="125" height="20" rx="3" fill="var(--ex-indigo-bg)" />
          <text x="8" y="38" font-family="var(--font-mono)" font-size="10.5" fill="var(--ex-indigo-text)">t₅: "over"</text>

          <rect x="0" y="48" width="125" height="20" rx="3" fill="var(--ex-indigo-bg)" />
          <text x="8" y="62" font-family="var(--font-mono)" font-size="10.5" fill="var(--ex-indigo-text)">t₆: "lazy"</text>

          <rect x="0" y="72" width="125" height="20" rx="3" fill="none" stroke="var(--ex-border)" stroke-dasharray="2 2" />
          <text x="8" y="86" font-family="var(--font-mono)" font-size="10.5" fill="var(--ex-text-muted)">t₇: [pending]</text>
        </g>
      </g>
    </g>

    <!-- Connector S1 -> S2 -->
    <path id="conn-s1-s2-a" d="M 161 107 L 205 107" stroke="var(--ex-blue-stroke)" stroke-width="1.5" marker-end="url(#ex-arrow-s1)" />
    <path id="conn-s1-s2-b" d="M 161 262 L 205 262" stroke="var(--ex-indigo-stroke)" stroke-width="1.5" marker-end="url(#ex-arrow-s2)" />

    <!-- ==================================================== -->
    <!-- STAGE 2: THE BLOCK TABLE (PAGE TABLE) -->
    <!-- ==================================================== -->
    <g id="step-group-s2" class="step-group">
      <text x="215" y="24" font-family="var(--font-sans)" font-size="13" font-weight="700" fill="var(--ex-amber-text)">
        2. Block Table (MMU)
      </text>

      <g transform="translate(215, 40)">
        <rect x="0" y="0" width="150" height="290" rx="8" fill="var(--ex-card-bg)" stroke="var(--ex-amber-stroke)" stroke-width="1.5" />
        <rect x="6" y="6" width="138" height="24" rx="4" fill="var(--ex-amber-bg)" />
