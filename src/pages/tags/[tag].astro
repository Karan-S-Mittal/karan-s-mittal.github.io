---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const isDev = import.meta.env.DEV;
  const posts = allPosts.filter((post) => isDev || !post.data.draft);

  const tagMap = new Map<string, typeof posts>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const key = tag.toLowerCase();
      if (!tagMap.has(key)) tagMap.set(key, []);
      tagMap.get(key)!.push(post);
    }
  }

  return Array.from(tagMap.entries()).map(([tag, tagPosts]) => ({
    params: { tag: tag.replace(/\s+/g, '-') },
    props: { tag, posts: tagPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()) },
  }));
}

const { tag, posts } = Astro.props;
---

<Layout title={`${tag} | Tags | Karan Mittal`}>
  <main class="container">
    <PageHeader
      label="Tag"
      title={tag}
      description={`All posts tagged with "${tag}".`}
      count={posts.length}
      countLabel="posts"
    />

    <div class="posts-list">
      {posts.map((post) => (
        <BlogPostCard post={post} />
      ))}
    </div>

    <p class="back-link">
      <a href="/tags">← All tags</a>
    </p>
  </main>
</Layout>

<style>
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .back-link {
    margin-top: var(--space-6);
  }
  .back-link a {
    font-size: var(--text-sm);
    font-weight: 600;
  }
</style>
