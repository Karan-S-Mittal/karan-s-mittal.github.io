---
/**
 * SwissTableArchitecture.astro
 * HTML/CSS-native Hash Map microarchitecture diagram comparing legacy buckets with Go 1.24 SwissTable SIMD groups.
 */
import Exhibit from '../../editorial/Exhibit.astro';

interface Props {
  caption?: string;
  exhibit?: string;
  title?: string;
}

const {
  caption = 'Go 1.24 replaces linked bucket overflow chains with 16-byte metadata control groups. A single 128-bit SIMD instruction matches 7-bit hash tags across 16 slots simultaneously in 1 CPU cycle, achieving 30%–50% faster map lookups.',
  exhibit = '05',
  title = 'Go 1.24 SwissTable SIMD Metadata Vector Probing',
} = Astro.props;
---

<Exhibit exhibit={exhibit} title={title} badge="HASH MAP MICROARCHITECTURE" caption={caption} wide>
  <div class="swiss-root">
    <!-- SECTION 1: LEGACY GO MAP -->
    <div class="swiss-section">
      <div class="section-header">
        <span class="section-tag tag-warn">LEGACY GO MAP / 8-ENTRY BUCKETS + OVERFLOW CHAIN</span>
        <span class="section-sub">Scalar top-hash iteration; pointer chasing across scattered heap overflow buckets on hash collisions.</span>
      </div>

      <div class="legacy-map-row">
        <div class="bucket-card">
          <div class="bucket-head">
            <span class="b-badge">PRIMARY BUCKET</span>
            <span class="b-sub">8 Entries</span>
          </div>
          <div class="b-slots">[k₀, v₀] [k₁, v₁] [k₂, v₂] ... [k₇, v₇]</div>
        </div>

        <div class="overflow-arrow">
          <span class="overflow-tag">OVERFLOW PTR</span>
          <span class="arrow-char">&rarr;</span>
        </div>

        <div class="bucket-card card-overflow">
          <div class="bucket-head">
            <span class="b-badge badge-warn">OVERFLOW BUCKET</span>
            <span class="b-sub">Heap Allocated &bull; Cache Miss Penalty</span>
          </div>
          <div class="b-slots">[k₈, v₈] [k₉, v₉] [k₁₀, v₁₀] ... [k₁₅, v₁₅]</div>
        </div>
      </div>
    </div>

    <div class="section-divider"></div>

    <!-- SECTION 2: GO 1.24 SWISSTABLE -->
    <div class="swiss-section">
      <div class="section-header">
        <span class="section-tag tag-signal">GO 1.24 SWISSTABLE / 16-BYTE METADATA VECTOR + SIMD PROBE</span>
        <span class="section-sub">16-slot control bytes loaded into 128-bit SIMD register; matches hash top 7-bits in 1 CPU instruction.</span>
      </div>

      <div class="swiss-grid">
        <!-- Control Group -->
        <div class="control-group-card">
          <div class="cg-head">
            <div>
              <h4 class="cg-title">16-Byte Control Group</h4>
              <span class="cg-sub">H1 = Group Index &bull; H2 = 7-bit Signature Tag</span>
            </div>
            <span class="cg-simd-badge">128-bit SIMD Compare</span>
          </div>

          <div class="ctrl-bytes-grid">
            <div class="byte-cell cell-match">7F</div>
            <div class="byte-cell cell-match">3A</div>
            <div class="byte-cell cell-match">8C</div>
            <div class="byte-cell cell-match">12</div>
            <div class="byte-cell cell-empty">FF</div>
            <div class="byte-cell cell-empty">FF</div>
            <div class="byte-cell cell-empty">...</div>
            <div class="byte-cell cell-empty">FF</div>
          </div>

          <span class="cg-footer">Instruction: SIMD compare matches all 16 slots in 1 CPU cycle</span>
        </div>

        <div class="probe-arrow">&rarr;</div>

        <!-- Packed Slot Array -->
        <div class="packed-slot-card">
          <div class="ps-head">
            <h4 class="ps-title">Packed Slot Array</h4>
            <span class="ps-sub">Flat contiguous array (Zero overflow pointers)</span>
          </div>

          <div class="slot-match-box">
            <span class="sm-label">Direct Offset Access:</span>
            <code class="sm-code">&amp;slots[match_index]</code>
          </div>

          <span class="ps-footer">High cache locality &bull; 30%–50% faster map lookups</span>
        </div>
      </div>
    </div>

    <!-- NOTICE LEADER -->
    <div class="swiss-notice">
      <span class="notice-arrow">&larr;</span>
      <span>Notice how SwissTable eliminates pointer-chasing overflow buckets, testing 16 hash tags simultaneously via vector registers.</span>
    </div>
  </div>
</Exhibit>

<style>
  .swiss-root {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--surface-card);
    border-radius: var(--radius-card);
  }

  .swiss-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .section-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .tag-warn {
    color: var(--text-muted);
  }

  .tag-signal {
    color: var(--accent);
  }

  .section-sub {
    font-size: 12px;
    line-height: 1.45;
    color: var(--text-muted);
  }

  /* LEGACY MAP ROW */
  .legacy-map-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .bucket-card {
    flex: 1;
    min-width: 200px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-3) var(--space-4);
    background: var(--bg);
    border: 1px solid var(--border-default);
    border-radius: 8px;
  }

  .card-overflow {
    border-style: dashed;
  }

  .bucket-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .b-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--text);
  }

  .badge-warn {
    color: var(--text-muted);
  }

  .b-sub {
    font-size: 10.5px;
    color: var(--text-muted);
  }

  .b-slots {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 6px 8px;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 4px;
    color: var(--text);
  }

  .overflow-arrow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .overflow-tag {
    font-family: var(--font-mono);
    font-size: 8.5px;
    font-weight: 700;
    color: var(--text-muted);
  }

  .arrow-char {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-muted);
  }

  .section-divider {
    height: 1px;
    background: var(--border-default);
  }

  /* SWISS GRID */
  .swiss-grid {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .control-group-card {
    flex: 1.4;
    min-width: 260px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: color-mix(in srgb, var(--accent) 5%, var(--bg));
    border: 1px solid var(--accent);
    border-radius: 8px;
  }

  .cg-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
  }

  .cg-title {
    margin: 0 0 2px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text);
  }

  .cg-sub {
    font-size: 11px;
    color: var(--text-muted);
  }

  .cg-simd-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
    background: var(--surface-card);
    border: 1px solid var(--accent);
    border-radius: 4px;
    color: var(--accent);
  }

  .ctrl-bytes-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 4px;
    margin: 4px 0;
  }

  .byte-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 28px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
  }

  .cell-match {
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    border: 1px solid var(--accent);
    color: var(--accent);
  }

  .cell-empty {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    color: var(--text-muted);
  }

  .cg-footer {
    font-size: 10.5px;
    color: var(--text-muted);
  }

  .probe-arrow {
    font-size: 16px;
    font-weight: 700;
    color: var(--accent);
  }

  .packed-slot-card {
    flex: 1;
    min-width: 200px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--bg);
    border: 1px solid var(--border-default);
    border-radius: 8px;
  }

  .ps-head {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ps-title {
    margin: 0;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text);
  }

  .ps-sub {
    font-size: 11px;
    color: var(--text-muted);
  }

  .slot-match-box {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 8px;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 6px;
  }

  .sm-label {
    font-size: 10.5px;
    color: var(--text-muted);
  }

  .sm-code {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 700;
    color: var(--accent);
  }

  .ps-footer {
    font-size: 10.5px;
    color: var(--text-muted);
  }

  /* NOTICE */
  .swiss-notice {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-muted);
    padding-top: var(--space-2);
    border-top: 1px dashed var(--border-default);
  }

  .notice-arrow {
    font-weight: 700;
    color: var(--accent);
  }
</style>
