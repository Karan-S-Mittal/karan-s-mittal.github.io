---
/**
 * SparsitySplitArchitecture.astro
 * Sparsity-Aware Dual-Direction Split Scanning Architecture.
 * Soft Architecture 720px publication-grade SVG.
 */
import Exhibit from '../../editorial/Exhibit.astro';

interface Props {
  exhibit?: string;
  title?: string;
  badge?: string;
  caption?: string;
}

const {
  exhibit = '03',
  title = 'Sparsity-Aware Dual-Direction Split Finding',
  badge = 'MEMORY & TIME EFFICIENCY',
  caption = 'XGBoost only iterates over non-missing entries I_k. It tests placing all missing values into the right child (Scan 1), then tests placing all missing values into the left child (Scan 2), capturing maximum gain with zero dense iteration overhead.',
} = Astro.props;
---

<Exhibit exhibit={exhibit} title={title} badge={badge} caption={caption} wide>
  <div class="sparsity-diagram-wrap">
    <svg class="sparsity-svg" viewBox="0 0 720 290" role="img" aria-label="Sparsity-aware dual direction split finding">
      <defs>
        <marker id="sparse-arrow" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
          <path d="M 0 0 L 8 3 L 0 6 Z" fill="var(--ie-blue)" />
        </marker>
        <marker id="sparse-arrow-rose" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
          <path d="M 0 0 L 8 3 L 0 6 Z" fill="var(--ie-rust)" />
        </marker>
      </defs>

      <!-- Non-missing Sorted Feature Stream -->
      <g transform="translate(20, 20)">
        <rect x="0" y="0" width="680" height="75" rx="6" fill="var(--ie-surface)" stroke="var(--ie-rule)" stroke-width="1.5" />
        <text x="16" y="24" class="hdr-title">Sorted Non-Missing Feature Stream (Iₖ)</text>
        <text x="664" y="24" text-anchor="end" class="hdr-meta">Linear scan: O(|Iₖ|)</text>

        <g transform="translate(16, 36)">
          <rect x="0" y="0" width="85" height="26" rx="3" fill="var(--ie-blue-soft)" stroke="var(--ie-blue)" stroke-width="1" />
          <text x="42" y="17" text-anchor="middle" class="entry-txt">x=0.1 (g₁,h₁)</text>

          <rect x="95" y="0" width="85" height="26" rx="3" fill="var(--ie-blue-soft)" stroke="var(--ie-blue)" stroke-width="1" />
          <text x="137" y="17" text-anchor="middle" class="entry-txt">x=0.3 (g₂,h₂)</text>

          <rect x="190" y="0" width="85" height="26" rx="3" fill="var(--ie-blue-soft)" stroke="var(--ie-blue)" stroke-width="1" />
          <text x="232" y="17" text-anchor="middle" class="entry-txt">x=0.7 (g₃,h₃)</text>

          <rect x="285" y="0" width="85" height="26" rx="3" fill="var(--ie-blue-soft)" stroke="var(--ie-blue)" stroke-width="1" />
          <text x="327" y="17" text-anchor="middle" class="entry-txt">x=1.2 (g₄,h₄)</text>

          <!-- Missing Instances Box -->
          <rect x="420" y="0" width="228" height="26" rx="3" fill="var(--ie-rust-soft)" stroke="var(--ie-rust)" stroke-width="1" stroke-dasharray="3 2" />
          <text x="534" y="17" text-anchor="middle" class="missing-txt">Missing Values (I missing: G miss, H miss)</text>
        </g>
      </g>

      <!-- DUAL DIRECTION SCANNING PLANES -->
      <g transform="translate(20, 115)">
        <!-- Pass 1: Missing Assigned to Right -->
        <g transform="translate(0, 0)">
          <rect x="0" y="0" width="330" height="150" rx="6" fill="var(--ie-surface)" stroke="var(--ie-rule)" stroke-width="1.5" />
          <text x="14" y="24" class="pass-title" font-weight="700">Pass 1: Missing &rarr; Right Child</text>

          <path d="M 14 60 L 260 60" stroke="var(--ie-blue)" stroke-width="2" marker-end="url(#sparse-arrow)" />
          <text x="140" y="52" text-anchor="middle" class="scan-dir">Accumulate Gʟ, Hʟ left-to-right &rarr;</text>

          <rect x="14" y="76" width="145" height="54" rx="3" fill="var(--ie-blue-soft)" stroke="var(--ie-rule)" />
          <text x="86" y="96" text-anchor="middle" class="box-head">Left: Iʟ (Known &le; s)</text>
          <text x="86" y="114" text-anchor="middle" class="box-stat">Gʟ, Hʟ</text>

          <rect x="170" y="76" width="145" height="54" rx="3" fill="var(--ie-rust-soft)" stroke="var(--ie-rust)" stroke-width="1" stroke-dasharray="2 2" />
          <text x="242" y="96" text-anchor="middle" class="box-head">Right: Iʀ + Missing</text>
          <text x="242" y="114" text-anchor="middle" class="box-stat-miss">G − Gʟ, H − Hʟ</text>
        </g>

        <!-- Pass 2: Missing Assigned to Left -->
        <g transform="translate(350, 0)">
          <rect x="0" y="0" width="330" height="150" rx="6" fill="var(--ie-surface)" stroke="var(--ie-rule)" stroke-width="1.5" />
          <text x="14" y="24" class="pass-title" font-weight="700">Pass 2: Missing &rarr; Left Child</text>

          <path d="M 260 60 L 14 60" stroke="var(--ie-rust)" stroke-width="2" marker-end="url(#sparse-arrow-rose)" />
          <text x="140" y="52" text-anchor="middle" class="scan-dir">Accumulate Gʀ, Hʀ right-to-left &larr;</text>

          <rect x="14" y="76" width="145" height="54" rx="3" fill="var(--ie-rust-soft)" stroke="var(--ie-rust)" stroke-width="1" stroke-dasharray="2 2" />
          <text x="86" y="96" text-anchor="middle" class="box-head">Left: Iʟ + Missing</text>
          <text x="86" y="114" text-anchor="middle" class="box-stat-miss">G − Gʀ, H − Hʀ</text>

          <rect x="170" y="76" width="145" height="54" rx="3" fill="var(--ie-blue-soft)" stroke="var(--ie-rule)" />
          <text x="242" y="96" text-anchor="middle" class="box-head">Right: Iʀ (Known &gt; s)</text>
          <text x="242" y="114" text-anchor="middle" class="box-stat">Gʀ, Hʀ</text>
        </g>
      </g>
    </svg>
  </div>
</Exhibit>

<style>
  .sparsity-diagram-wrap {
    width: 100%;
    background: var(--ie-surface);
    border-radius: var(--radius-card, 10px);
    overflow: hidden;
  }

  .sparsity-svg {
    width: 100%;
    height: auto;
    display: block;
    user-select: none;
  }

  .hdr-title {
    font-family: var(--font-sans, sans-serif);
    font-size: 12.5px;
    font-weight: 700;
    fill: var(--ie-ink);
  }

  .hdr-meta {
    font-family: var(--font-mono, monospace);
    font-size: 10.5px;
    fill: var(--ie-blue);
  }

  .entry-txt {
    font-family: var(--font-mono, monospace);
    font-size: 9.5px;
    font-weight: 600;
    fill: var(--ie-blue);
  }

  .missing-txt {
    font-family: var(--font-mono, monospace);
    font-size: 9.5px;
    font-weight: 600;
    fill: var(--ie-rust);
  }

  .pass-title {
    font-family: var(--font-sans, sans-serif);
    font-size: 12px;
    fill: var(--ie-ink);
  }

  .scan-dir {
    font-family: var(--font-mono, monospace);
    font-size: 9px;
    fill: var(--ie-muted);
  }

  .box-head {
    font-family: var(--font-mono, monospace);
    font-size: 9.5px;
    font-weight: 700;
    fill: var(--ie-ink);
  }

  .box-stat {
    font-family: var(--font-mono, monospace);
    font-size: 10px;
    fill: var(--ie-blue);
    font-weight: 600;
  }

  .box-stat-miss {
    font-family: var(--font-mono, monospace);
    font-size: 10px;
    fill: var(--ie-rust);
    font-weight: 600;
  }
</style>
