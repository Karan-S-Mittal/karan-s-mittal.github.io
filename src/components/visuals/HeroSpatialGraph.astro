---
/**
 * HeroSpatialGraph.astro
 *
 * A serene, graceful 3D isometric coordinate manifold.
 * Mappings across systems engineering dimensions:
 * - X-Axis: Latency Envelope (\tau)
 * - Y-Axis: Memory Horizon (M)
 * - Z-Axis: Autonomous State Span (\Omega)
 *
 * Designed with Naval-grade spatial simplicity:
 * - Vast negative space, delicate coordinate drop lines, floating junction pins.
 * - Pure vector SVG, zero external 3D engine overhead.
 * - 100% semantic tokens, zero raw hex colors.
 */

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['hero-spatial-container', className]} aria-hidden="true">
  <svg
    class="spatial-svg"
    viewBox="0 0 460 340"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Subtle Spatial Grid Pattern for Base Plane -->
      <pattern id="spatial-dot-grid" width="14" height="14" patternUnits="userSpaceOnUse">
        <circle cx="2" cy="2" r="0.75" fill="var(--ie-rule-strong)" opacity="0.6" />
      </pattern>

      <!-- Soft gradient for manifold depth plane -->
      <linearGradient id="plane-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="var(--ie-blue-soft)" stop-opacity="0.25" />
        <stop offset="100%" stop-color="var(--ie-surface)" stop-opacity="0.05" />
      </linearGradient>

      <!-- Subtle gradient for autonomous state ribbon -->
      <linearGradient id="ribbon-grad" x1="0%" y1="100%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="var(--ie-blue)" stop-opacity="0.1" />
        <stop offset="50%" stop-color="var(--ie-blue)" stop-opacity="0.3" />
        <stop offset="100%" stop-color="var(--ie-blue)" stop-opacity="0.6" />
      </linearGradient>
    </defs>

    <!-- Base Isometric Projection Grid (Ground Plane at Z = 0) -->
    <g class="isometric-base-plane" opacity="0.85">
      <!-- Ground plane polygon -->
      <polygon
        points="230,285 390,195 230,105 70,195"
        fill="url(#plane-grad)"
        stroke="var(--ie-rule)"
        stroke-width="1"
      />

      <!-- Ground plane internal coordinate lines -->
      <line x1="110" y1="172" x2="270" y2="82" stroke="var(--ie-rule)" stroke-width="0.75" stroke-dasharray="2 3" />
      <line x1="150" y1="150" x2="310" y2="60" stroke="var(--ie-rule)" stroke-width="0.75" stroke-dasharray="2 3" />
      <line x1="190" y1="128" x2="350" y2="38" stroke="var(--ie-rule)" stroke-width="0.75" stroke-dasharray="2 3" />

      <line x1="150" y1="240" x2="310" y2="150" stroke="var(--ie-rule)" stroke-width="0.75" stroke-dasharray="2 3" />
      <line x1="190" y1="262" x2="350" y2="172" stroke="var(--ie-rule)" stroke-width="0.75" stroke-dasharray="2 3" />

      <!-- Isometric Axis Rays -->
      <!-- Origin O at (230, 195) on the floor -->
      <!-- X-Axis: Latency \tau (Right-down +30 deg) -->
      <line x1="230" y1="195" x2="385" y2="282" stroke="var(--ie-ink-secondary)" stroke-width="1.2" />
      <circle cx="385" cy="282" r="2.5" fill="var(--ie-ink-secondary)" />
      <text x="395" y="292" class="axis-label" text-anchor="start">&tau; Latency Envelope</text>

      <!-- Y-Axis: Memory Horizon M (Left-down +150 deg) -->
      <line x1="230" y1="195" x2="75" y2="282" stroke="var(--ie-ink-secondary)" stroke-width="1.2" />
      <circle cx="75" cy="282" r="2.5" fill="var(--ie-ink-secondary)" />
      <text x="65" y="292" class="axis-label" text-anchor="end">M Memory Horizon</text>

      <!-- Z-Axis: Autonomous State Span \Omega (Vertical Up -90 deg) -->
      <line x1="230" y1="195" x2="230" y2="32" stroke="var(--ie-blue)" stroke-width="1.4" />
      <circle cx="230" cy="32" r="3" fill="var(--ie-blue)" />
      <text x="230" y="22" class="axis-label blue" text-anchor="middle">&Omega; Autonomous State Span</text>
    </g>

    <!-- Floating 3D Manifold Surface / Vector Contours -->
    <g class="manifold-geometry">
      <!-- 3D Ribbon / Flow Plane -->
      <path
        d="M 115,225 C 160,190 195,140 230,105 C 265,70 310,95 345,135 L 345,175 C 310,135 265,110 230,145 C 195,180 160,230 115,265 Z"
        fill="url(#ribbon-grad)"
        stroke="var(--ie-blue)"
        stroke-width="1"
        stroke-dasharray="4 2"
        opacity="0.8"
      />

      <!-- Primary Upper Trajectory Curve -->
      <path
        d="M 115,225 C 160,185 195,130 230,95 C 265,60 305,85 345,125"
        fill="none"
        stroke="var(--ie-blue)"
        stroke-width="1.75"
      />

      <!-- Secondary Lower Equilibrium Curve -->
      <path
        d="M 135,245 C 175,215 205,175 230,150 C 255,125 295,145 325,180"
        fill="none"
        stroke="var(--ie-blue)"
        stroke-width="1.2"
        stroke-dasharray="3 3"
        opacity="0.7"
      />
    </g>

    <!-- Vertical Drop Lines (Spatial Coordinate Grounding) -->
    <!-- Node Alpha Drop: PagedAttention Frame Pool -->
    <line x1="145" y1="205" x2="145" y2="245" stroke="var(--ie-rule-strong)" stroke-width="1" stroke-dasharray="2 2" />
    <circle cx="145" cy="245" r="2" fill="var(--ie-rule-strong)" />

    <!-- Node Beta Drop: Deterministic Retrieval Plane -->
    <line x1="230" y1="95" x2="230" y2="195" stroke="var(--ie-blue)" stroke-width="1" stroke-dasharray="2 3" opacity="0.7" />
    <circle cx="230" cy="195" r="2.5" fill="var(--ie-blue)" />

    <!-- Node Gamma Drop: Agent Execution Gate -->
    <line x1="335" y1="135" x2="335" y2="225" stroke="var(--ie-rust)" stroke-width="1" stroke-dasharray="2 2" opacity="0.8" />
    <circle cx="335" cy="225" r="2" fill="var(--ie-rust)" />

    <!-- Spatial Manifold Pin Nodes -->
    <!-- 1. Node Alpha: Memory Frame Stride -->
    <g class="spatial-node node-alpha" transform="translate(145, 205)">
      <circle cx="0" cy="0" r="10" fill="var(--ie-blue-soft)" opacity="0.4" />
      <circle cx="0" cy="0" r="4" fill="var(--ie-surface)" stroke="var(--ie-blue)" stroke-width="1.5" />
      <circle cx="0" cy="0" r="1.5" fill="var(--ie-blue)" />
      <!-- Label -->
      <g transform="translate(-10, -14)">
        <rect x="-85" y="-12" width="90" height="20" rx="3" fill="var(--ie-surface)" stroke="var(--ie-rule)" stroke-width="0.8" />
        <text x="-40" y="2" class="node-tag" text-anchor="middle">Paged VRAM Stride</text>
      </g>
    </g>

    <!-- 2. Node Beta: Deterministic Replay Apex -->
    <g class="spatial-node node-beta" transform="translate(230, 95)">
      <circle cx="0" cy="0" r="12" fill="var(--ie-blue-soft)" opacity="0.5" />
      <circle cx="0" cy="0" r="4.5" fill="var(--ie-surface)" stroke="var(--ie-verified)" stroke-width="1.8" />
      <circle cx="0" cy="0" r="1.8" fill="var(--ie-verified)" />
      <!-- Label -->
      <g transform="translate(0, -18)">
        <rect x="-60" y="-12" width="120" height="20" rx="3" fill="var(--ie-surface)" stroke="var(--ie-rule)" stroke-width="0.8" />
        <text x="0" y="2" class="node-tag verified" text-anchor="middle">Deterministic Replay Apex</text>
      </g>
    </g>

    <!-- 3. Node Gamma: Autonomous Execution Gate (Rust Constraint) -->
    <g class="spatial-node node-gamma" transform="translate(335, 135)">
      <circle cx="0" cy="0" r="10" fill="var(--ie-rust-soft, var(--ie-surface-raised))" opacity="0.5" />
      <circle cx="0" cy="0" r="4" fill="var(--ie-surface)" stroke="var(--ie-rust)" stroke-width="1.5" />
      <circle cx="0" cy="0" r="1.5" fill="var(--ie-rust)" />
      <!-- Label -->
      <g transform="translate(10, -14)">
        <rect x="-5" y="-12" width="92" height="20" rx="3" fill="var(--ie-surface)" stroke="var(--ie-rule)" stroke-width="0.8" />
        <text x="41" y="2" class="node-tag rust" text-anchor="middle">Permission Gate &bull; Human</text>
      </g>
    </g>

    <!-- Subtle Technical Drawing Crosshair Markers -->
    <path d="M 12 18 L 12 12 L 18 12" stroke="var(--ie-muted)" stroke-width="0.8" opacity="0.4" />
    <path d="M 448 18 L 448 12 L 442 12" stroke="var(--ie-muted)" stroke-width="0.8" opacity="0.4" />
    <path d="M 12 322 L 12 328 L 18 328" stroke="var(--ie-muted)" stroke-width="0.8" opacity="0.4" />
    <path d="M 448 322 L 448 328 L 442 328" stroke="var(--ie-muted)" stroke-width="0.8" opacity="0.4" />

    <!-- Discreet Technical Stamp in Bottom Right -->
    <g transform="translate(325, 314)">
      <text x="0" y="8" class="stamp-text">ISOMETRIC TOPOLOGY &bull; 1:1</text>
    </g>
  </svg>
</div>

<style>
  .hero-spatial-container {
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    user-select: none;
  }

  .spatial-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
    filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.03));
  }

  /* Typography within the Spatial SVG */
  .axis-label {
    font-family: var(--font-mono);
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    fill: var(--ie-muted);
  }

  .axis-label.blue {
    fill: var(--ie-blue);
  }

  .node-tag {
    font-family: var(--font-mono);
    font-size: 7.5px;
    font-weight: 500;
    letter-spacing: 0.03em;
    fill: var(--ie-ink);
  }

  .node-tag.verified {
    fill: var(--ie-verified);
    font-weight: 600;
  }

  .node-tag.rust {
    fill: var(--ie-rust);
    font-weight: 600;
  }

  .stamp-text {
    font-family: var(--font-mono);
    font-size: 6.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    fill: var(--ie-muted);
    opacity: 0.7;
  }

  /* Subtle floating animation on the spatial nodes */
  @media (prefers-reduced-motion: no-preference) {
    .node-alpha {
      animation: floatA 6s ease-in-out infinite alternate;
    }
    .node-beta {
      animation: floatB 7s ease-in-out infinite alternate;
    }
    .node-gamma {
      animation: floatC 8s ease-in-out infinite alternate;
    }
  }

  @keyframes floatA {
    from { transform: translate(145px, 205px); }
    to { transform: translate(145px, 201px); }
  }

  @keyframes floatB {
    from { transform: translate(230px, 95px); }
    to { transform: translate(230px, 91px); }
  }

  @keyframes floatC {
    from { transform: translate(335px, 135px); }
    to { transform: translate(335px, 139px); }
  }
</style>
