---
import ExcalidrawContainer from './ExcalidrawContainer.astro';

interface Props {
  caption?: string;
  exhibit?: string;
  title?: string;
}

const { caption, exhibit, title } = Astro.props;
---

<ExcalidrawContainer caption={caption} exhibit={exhibit} title={title} badge="COMPUTE MODEL">
  <svg class="ex-svg-canvas sys-diagram" viewBox="0 0 720 350" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Comparison between naive recomputation and KV-cached decoding at step 3.">
    <defs>
      <marker id="naive-arr-1" markerWidth="7" markerHeight="6" refX="6" refY="3" orient="auto"><polygon points="0 0, 7 3, 0 6" fill="var(--text)" /></marker>
      <marker id="naive-arr-blue-1" markerWidth="7" markerHeight="6" refX="6" refY="3" orient="auto"><polygon points="0 0, 7 3, 0 6" fill="var(--accent)" /></marker>
      <pattern id="waste-hatch-v3" width="6" height="6" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--muted)" stroke-opacity="0.35" stroke-width="1.5" />
      </pattern>
    </defs>

    <!-- SECTION 1: NAIVE PATH -->
    <g transform="translate(20, 16)">
      <text x="0" y="12" class="label-signal" dominant-baseline="central">PATH A / NAIVE DECODING (NO CACHE)</text>
      <text x="0" y="28" class="body-muted" dominant-baseline="central">Recomputes projections for all past tokens on every forward step (O(N²) cumulative work).</text>

      <g transform="translate(0, 44)">
        <!-- Token 0: The -->
        <rect x="0" y="0" width="64" height="48" rx="6" class="node-muted" />
        <rect x="0" y="0" width="64" height="48" rx="6" fill="url(#waste-hatch-v3)" />
        <text x="32" y="18" class="body" text-anchor="middle" font-weight="600" dominant-baseline="central">"The"</text>
        <text x="32" y="34" class="label" text-anchor="middle" font-size="9" dominant-baseline="central">RE-PROJ</text>

        <!-- Token 1: quick -->
        <rect x="74" y="0" width="64" height="48" rx="6" class="node-muted" />
        <rect x="74" y="0" width="64" height="48" rx="6" fill="url(#waste-hatch-v3)" />
        <text x="106" y="18" class="body" text-anchor="middle" font-weight="600" dominant-baseline="central">"quick"</text>
        <text x="106" y="34" class="label" text-anchor="middle" font-size="9" dominant-baseline="central">RE-PROJ</text>

        <!-- Token 2: brown -->
        <rect x="148" y="0" width="64" height="48" rx="6" class="node" />
        <text x="180" y="18" class="body" text-anchor="middle" font-weight="600" dominant-baseline="central">"brown"</text>
        <text x="180" y="34" class="label-signal" text-anchor="middle" font-size="9" dominant-baseline="central">ACTIVE</text>

        <!-- Flow Arrow -->
        <path d="M 218 24 H 262" class="flow" marker-end="url(#naive-arr-1)" />

        <!-- Transformer Block -->
        <rect x="270" y="0" width="220" height="48" rx="6" class="node" />
        <text x="380" y="18" class="title" text-anchor="middle" font-size="14" dominant-baseline="central">Transformer Layers</text>
        <text x="380" y="34" class="label" text-anchor="middle" font-size="9.5" dominant-baseline="central">3 FULL FORWARD PROJECTIONS</text>

        <!-- Flow Arrow -->
        <path d="M 496 24 H 540" class="flow" marker-end="url(#naive-arr-1)" />

        <!-- Output Token -->
        <rect x="548" y="0" width="132" height="48" rx="6" class="node-muted" />
        <text x="614" y="18" class="body" text-anchor="middle" font-weight="600" dominant-baseline="central">"fox"</text>
        <text x="614" y="34" class="label" text-anchor="middle" font-size="9.5" dominant-baseline="central">STEP 3 OUTPUT</text>
      </g>
    </g>

    <!-- DIVIDER -->
    <line x1="20" y1="164" x2="700" y2="164" class="rule" />

    <!-- SECTION 2: KV-CACHED PATH -->
    <g transform="translate(20, 180)">
      <text x="0" y="12" class="label-signal" dominant-baseline="central">PATH B / KV-CACHED DECODING</text>
      <text x="0" y="28" class="body-muted" dominant-baseline="central">Past Key/Value states remain static in GPU VRAM; projects only the single active token.</text>

      <g transform="translate(0, 44)">
        <!-- Stored KV Cache Bank -->
        <rect x="0" y="0" width="212" height="66" rx="6" class="node-muted" />
        <text x="12" y="16" class="label-signal" font-size="9.5" dominant-baseline="central">GPU VRAM KV CACHE</text>
        <rect x="12" y="26" width="88" height="28" rx="4" class="node" />
        <text x="56" y="40" class="label" text-anchor="middle" font-size="9.5" dominant-baseline="central">K₀, V₀ ("The")</text>
        <rect x="108" y="26" width="92" height="28" rx="4" class="node" />
        <text x="154" y="40" class="label" text-anchor="middle" font-size="9.5" dominant-baseline="central">K₁, V₁ ("quick")</text>

        <!-- Read Flow into Self Attention -->
        <path d="M 212 38 C 240 38, 250 32, 270 32" class="flow-dashed" marker-end="url(#naive-arr-1)" />

        <!-- New Token -->
        <rect x="0" y="78" width="104" height="34" rx="6" class="node-signal" />
        <text x="52" y="90" class="body" text-anchor="middle" font-weight="600" dominant-baseline="central">"brown"</text>
        <text x="52" y="103" class="label-signal" text-anchor="middle" font-size="8.5" dominant-baseline="central">ACTIVE (t₂)</text>

        <!-- Arrow to Proj -->
        <path d="M 108 95 H 138" class="flow-signal" marker-end="url(#naive-arr-blue-1)" />

        <!-- 1 Token Project -->
        <rect x="144" y="78" width="68" height="34" rx="6" class="node-signal" />
        <text x="178" y="90" class="label-signal" text-anchor="middle" font-size="9" dominant-baseline="central">PROJ</text>
        <text x="178" y="103" class="label-signal" text-anchor="middle" font-size="8" dominant-baseline="central">Q₂, K₂, V₂</text>

        <!-- Arrow to Attention -->
        <path d="M 212 95 C 240 95, 250 56, 270 56" class="flow-signal" marker-end="url(#naive-arr-blue-1)" />

        <!-- Self Attention Engine -->
        <rect x="270" y="10" width="220" height="92" rx="6" class="node-signal" />
        <text x="380" y="30" class="title" text-anchor="middle" font-size="14" dominant-baseline="central">Self-Attention</text>
        <text x="380" y="48" class="label-signal" text-anchor="middle" font-size="9.5" dominant-baseline="central">Q₂ ATTENDS TO [K₀, K₁, K₂]</text>
        <text x="380" y="64" class="body-muted" text-anchor="middle" font-size="11" dominant-baseline="central">Mixes contextual values [V₀, V₁, V₂]</text>
        <rect x="286" y="76" width="188" height="16" rx="3" class="node" />
        <text x="380" y="84" class="label-signal" text-anchor="middle" font-size="8.5" dominant-baseline="central">1 PROJECTION + O(N) READ</text>

        <!-- Connector to Output -->
        <path d="M 496 56 H 540" class="flow-signal" marker-end="url(#naive-arr-blue-1)" />

        <!-- Output Token -->
        <rect x="548" y="32" width="132" height="48" rx="6" class="node-signal" />
        <text x="614" y="50" class="body" text-anchor="middle" font-weight="600" dominant-baseline="central">"fox"</text>
        <text x="614" y="66" class="label-signal" text-anchor="middle" font-size="9.5" dominant-baseline="central">STEP 3 OUTPUT</text>
      </g>
    </g>
  </svg>
</ExcalidrawContainer>



