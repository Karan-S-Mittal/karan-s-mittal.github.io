---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/content/PageHeader.astro';
import VisualBlueprintCard from '@components/visuals/VisualBlueprintCard.astro';

interface VisualItem {
  id: string;
  title: string;
  desc: string;
  category: string;
  archetype?: 'loop' | 'pipeline' | 'memory' | 'tree' | 'hierarchy' | 'comparison';
  href: string;
}

// Auto-discover all visual pages in this directory
const rawPages = import.meta.glob<string>('./*.astro', { query: '?raw', import: 'default', eager: true });

// Curated metadata and archetype mapping for established visuals
const curatedMeta: Record<string, { title?: string; desc?: string; category?: string; archetype?: 'loop' | 'pipeline' | 'memory' | 'tree' | 'hierarchy' | 'comparison' }> = {
  'claude-code-loop': {
    title: 'Claude Code Local Agent Loop',
    desc: 'Interactive CLI orchestrator, context state compaction, ReAct execution cycle, and native primitives.',
    category: 'EXECUTION LOOP',
    archetype: 'loop',
  },
  'claude-code-harness': {
    title: 'Claude Code Harness Architecture',
    desc: 'Local execution harness lifecycle: CLI prompt dispatch, model reasoning, PreToolUse permission evaluation, and closed-loop compaction.',
    category: 'HARNESS PIPELINE',
    archetype: 'pipeline',
  },
  'codex-cloud-sandbox-loop': {
    title: 'OpenAI Codex Cloud Sandbox Loop',
    desc: 'Autonomous cloud daemon lifecycle: task dispatch, ephemeral VM provisioning, mutation engine, and self-correcting PR packaging.',
    category: 'CLOUD DAEMON',
    archetype: 'loop',
  },
  'codex-vs-claude-code': {
    title: 'Claude Code vs. OpenAI Codex Hero Visual',
    desc: 'Publication hero graphic and runtime architecture comparison between Anthropic Claude Code and OpenAI Codex.',
    category: 'RUNTIME COMPARISON',
    archetype: 'comparison',
  },
  'coding-agent': {
    title: 'Autonomous Coding Agent Cognitive Architecture',
    desc: 'Hierarchical flow from cognitive model orchestrator through context discovery, ReAct loops, and MCP dispatch into sandboxes.',
    category: 'COGNITIVE ARCHITECTURE',
    archetype: 'hierarchy',
  },
  'coding-timeline': {
    title: 'Agentic Coding Evolution: Claude Code vs. OpenAI Codex',
    desc: 'Comparative timeline tracking 16 major releases from terminal research previews to dynamic multi-agent orchestration.',
    category: 'COMPARATIVE TIMELINE',
    archetype: 'comparison',
  },
  'agent-context': {
    title: 'Coding Agent Topology: CLI to Multi-Agent Swarm',
    desc: 'Coding agents progressing from a local terminal to repository context, cloud environments, and coordinated agents.',
    category: 'CONTEXT PERIMETER',
    archetype: 'hierarchy',
  },
  'agent-progression': {
    title: 'Coding Agent Context Horizons & State Span',
    desc: 'Context perimeter expansion from ~8KB shell buffers to ~100MB AST graphs, cloud containers, and distributed swarm buses.',
    category: 'HORIZON EXPANSION',
    archetype: 'tree',
  },
  'paged-attention': {
    title: 'PagedAttention KV Cache Page Translation',
    desc: 'Physical page frame allocations and logical block tables modeling non-contiguous KV cache pooling to eliminate memory fragmentation.',
    category: 'MEMORY ARCHITECTURE',
    archetype: 'memory',
  },
  'deterministic-rag': {
    title: '3-Plane Deterministic RAG Replay Architecture',
    desc: 'Three execution planes compiling immutable corpus artifacts, deterministic hybrid retrieval, and auditable evidence bundles.',
    category: 'REPLAY ARCHITECTURE',
    archetype: 'hierarchy',
  },
  'coding-evolution': {
    title: 'Agent Coding Evolution Tree',
    desc: 'Evolution tree tracking the architectural branching of coding assistants from token completions to autonomous swarms.',
    category: 'EVOLUTION TREE',
    archetype: 'tree',
  },
};

const preferredOrder = [
  'claude-code-loop',
  'claude-code-harness',
  'codex-cloud-sandbox-loop',
  'codex-vs-claude-code',
  'coding-agent',
  'coding-timeline',
  'agent-context',
  'agent-progression',
  'deterministic-rag',
  'paged-attention',
  'coding-evolution',
];

const visuals: VisualItem[] = Object.entries(rawPages)
  .filter(([path]) => !path.endsWith('index.astro'))
  .map(([path, rawContent]) => {
    const slug = path.replace(/^\.\//, '').replace(/\.astro$/, '');
    const curated = curatedMeta[slug] || {};

    const titleMatch = rawContent.match(/const\s+title\s*=\s*['"`]([^'"`]+)['"`]/);
    const descMatch = rawContent.match(/const\s+(?:caption|description)\s*=\s*['"`]([^'"`]+)['"`]/);

    const title = curated.title || (titleMatch ? titleMatch[1] : slug.replace(/-/g, ' '));
    const desc = curated.desc || (descMatch ? descMatch[1] : '');
    const category = curated.category || 'SYSTEMS ARCHITECTURE';
    const archetype = curated.archetype || 'pipeline';

    return {
      id: slug,
      title,
      desc,
      category,
      archetype,
      href: `/visuals/${slug}/`,
    };
  })
  .sort((a, b) => {
    const idxA = preferredOrder.indexOf(a.id);
    const idxB = preferredOrder.indexOf(b.id);
    if (idxA !== -1 && idxB !== -1) return idxA - idxB;
    if (idxA !== -1) return -1;
    if (idxB !== -1) return 1;
    return a.title.localeCompare(b.title);
  });
---

<Layout
  title="Visuals & Systems Blueprints | Karan Mittal"
  description="A catalog of systems architecture diagrams, comparative chronologies, and memory models. Inspect and download each visual as an image."
>
  <main class="visuals-page">
    <div class="container page-shell">
      <PageHeader
        label="Visual Library"
        title="Visuals & Systems Blueprints."
        description="A collection of systems architecture diagrams, comparative chronologies, and memory models. Every visual can be inspected in full and exported as a 3× high-resolution PNG."
        count={visuals.length}
        countLabel="systems visuals"
      />

      <div class="search-bar-wrap">
        <input
          type="search"
          id="visual-search"
          placeholder="Filter visuals by keyword, topic, or technology..."
          aria-label="Filter visuals"
        />
      </div>

      <div class="visuals-grid" id="visuals-grid">
        {visuals.map((v, i) => (
          <VisualBlueprintCard
            slug={v.id}
            index={i + 1}
            title={v.title}
            desc={v.desc}
            category={v.category}
            href={v.href}
            archetype={v.archetype}
          />
        ))}
      </div>

      <p id="no-results" class="no-results" style="display: none;">
        No visuals match your filter.
      </p>
    </div>
  </main>
</Layout>

<script>
  const searchInput = document.getElementById('visual-search') as HTMLInputElement | null;
  const cards = document.querySelectorAll<HTMLElement>('.visual-card');
  const noResults = document.getElementById('no-results');

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      const query = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      cards.forEach((card) => {
        const text = card.dataset.search || '';
        const match = query === '' || text.includes(query);
        card.style.display = match ? 'flex' : 'none';
        if (match) visibleCount++;
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    });
  }
</script>

<style>
  .visuals-page {
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }

  .page-shell {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 var(--space-5, 1.5rem);
  }

  .search-bar-wrap {
    margin: 1.5rem 0 2rem;
  }

  .search-bar-wrap input {
    width: 100%;
    padding: 0.75rem 1rem;
    font-family: var(--font-diagram);
    font-size: var(--ie-type-ui);
    color: var(--ie-ink);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius);
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.15s ease;
  }

  .search-bar-wrap input:focus {
    border-color: var(--ie-blue);
  }

  /* Responsive Visual Blueprint Grid */
  .visuals-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .no-results {
    padding: 3rem 0;
    text-align: center;
    color: var(--ie-muted);
    font-family: var(--font-diagram);
    font-size: var(--ie-type-body);
  }

  @media (max-width: 640px) {
    .visuals-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
