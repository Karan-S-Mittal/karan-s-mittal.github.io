---
type PanelState = 'signal' | 'verified' | 'constraint' | 'failure' | 'model' | 'neutral';
type HeadingLevel = 'h2' | 'h3' | 'h4';

interface Props {
  as?: 'article' | 'section' | 'div';
  id?: string;
  title: string;
  index?: string;
  label?: string;
  state?: PanelState;
  heading?: HeadingLevel;
  spacious?: boolean;
}

const {
  as: element = 'article',
  id,
  title,
  index,
  label,
  state = 'signal',
  heading = 'h3',
  spacious = false,
} = Astro.props;

const Element = element;
const Heading = heading;
const hasIcon = await Astro.slots.has('icon');
const hasActions = await Astro.slots.has('actions');
const hasFooter = await Astro.slots.has('footer');
---

<Element id={id} class:list={['studio-panel', `state-${state}`, { spacious }]}>
  <header class="studio-panel-header">
    <div class="studio-panel-identity">
      {index && <span class="studio-panel-index">{index}</span>}
      {hasIcon && <span class="studio-panel-icon"><slot name="icon" /></span>}
      <div class="studio-panel-heading">
        {label && <p>{label}</p>}
        <Heading>{title}</Heading>
      </div>
    </div>
    {hasActions && <div class="studio-panel-actions"><slot name="actions" /></div>}
  </header>

  <div class="studio-panel-body">
    <slot />
  </div>

  {hasFooter && <footer class="studio-panel-footer"><slot name="footer" /></footer>}
</Element>

<style>
  .studio-panel {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    border-radius: var(--panel-radius);
    box-shadow: var(--panel-shadow);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .studio-panel:hover {
    border-color: var(--panel-border-strong);
  }

  .studio-panel::before {
    content: '';
    position: absolute;
    z-index: 2;
    top: calc(var(--panel-header-height) / 2 - 3px);
    left: 0.85rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--panel-border-strong);
  }

  /* State lights — Soft Architecture grammar: blue = structure/validated,
     pink = constraint/failure/attention, lavender = secondary/inferred */
  .state-signal::before { background: var(--interactive-primary); }
  .state-verified::before { background: var(--ie-blue); }
  .state-constraint::before { background: var(--signal-warm); }
  .state-failure::before { background: var(--signal-warm); }
  .state-model::before { background: var(--diagram-node-primary); }

  .studio-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--panel-header-height);
    gap: var(--space-3);
    padding: 0.6rem var(--space-4) 0.6rem 1.8rem;
    background: var(--panel-header-bg);
    border-bottom: 1px solid var(--panel-border);
  }

  .studio-panel-identity {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: var(--space-2);
  }

  .studio-panel-index {
    flex: 0 0 auto;
    color: var(--muted);
    font: 600 var(--ie-type-micro)/1 var(--font-mono);
    letter-spacing: 0.04em;
  }

  .studio-panel-icon {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    color: var(--muted);
  }

  .studio-panel-heading {
    min-width: 0;
  }

  .studio-panel-heading p {
    margin: 0 0 0.1rem;
    color: var(--muted);
    font: 500 var(--ie-type-micro)/1.2 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .studio-panel-heading :global(h2),
  .studio-panel-heading :global(h3),
  .studio-panel-heading :global(h4) {
    margin: 0;
    overflow: hidden;
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--ie-type-ui);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.3;
    text-overflow: ellipsis;
  }

  /* Portfolio panels use the same surface grammar, but their titles are
     editorial content rather than compact instrument labels. */
  .spacious .studio-panel-header {
    min-height: auto;
    align-items: flex-start;
    padding-block: var(--space-4);
  }

  .spacious .studio-panel-heading :global(h2) {
    overflow: visible;
    font-family: var(--font-display);
    font-size: var(--ie-type-h3);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
    text-overflow: clip;
  }

  .studio-panel-actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--space-2);
    color: var(--muted);
    font: 500 var(--ie-type-micro)/1 var(--font-mono);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .studio-panel-body {
    min-width: 0;
    padding: var(--space-4);
  }

  .spacious .studio-panel-body {
    padding: var(--space-5);
  }

  .studio-panel-footer {
    padding: 0.65rem var(--space-4);
    background: var(--panel-property-bg);
    border-top: 1px solid var(--panel-border);
  }
</style>
