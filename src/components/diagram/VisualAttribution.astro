---
/** Shared wordmark kept inside diagram captures and blog embeds. */
interface Props {
  author?: string;
  class?: string;
}
const { author = 'karansmittal', class: className = '' } = Astro.props;
---

<span class:list={['visual-attribution-box', className]} aria-label={`Visual by ${author}`}>
  {author}
</span>

<style>
  .visual-attribution-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.6rem;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card);
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--ie-ink);
    white-space: nowrap;
  }
</style>
