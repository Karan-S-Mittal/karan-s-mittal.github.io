---
/**
 * LinearTransform2D.astro
 * 3Blue1Brown-inspired 2D Matrix Linear Transformation & Grid Warping Visualizer.
 * Built on BaseCanvasElement with smooth continuous interpolation and determinant area shading.
 */
import Exhibit from '../../editorial/Exhibit.astro';

interface Props {
  caption?: string;
  exhibit?: string;
  title?: string;
}

const {
  caption = '2D linear transformation visualizer demonstrating how matrix multiplication T(v) = Av bends the coordinate grid, scales area by the determinant det(A), and maps basis vectors î (blue) and ĵ (coral).',
  exhibit = '02',
  title = '2D Linear Transformation & Coordinate Grid Warping Engine',
} = Astro.props;
---

<Exhibit exhibit={exhibit} title={title} badge="2D LINEAR ALGEBRA ENGINE" caption={caption} wide>
  <linear-transform-2d class="lt2d-root">
    <!-- Canvas Surface -->
    <div class="canvas-wrap">
      <canvas class="lt2d-canvas"></canvas>
    </div>

    <!-- 3B1B Matrix Control Deck -->
    <div class="lt2d-deck">
      <div class="deck-main">
        <!-- Matrix Inputs -->
        <div class="matrix-box">
          <span class="m-bracket left">[</span>
          <div class="m-grid">
            <input type="number" class="m-cell" id="m-a" value="1" step="0.1" />
            <input type="number" class="m-cell" id="m-b" value="1" step="0.1" />
            <input type="number" class="m-cell" id="m-c" value="0" step="0.1" />
            <input type="number" class="m-cell" id="m-d" value="1" step="0.1" />
          </div>
          <span class="m-bracket right">]</span>
        </div>

        <!-- Matrix Presets -->
        <div class="preset-group">
          <span class="ctrl-label">PRESETS:</span>
          <div class="preset-pills">
            <button type="button" class="preset-btn active" data-m="1,1,0,1">Shear</button>
            <button type="button" class="preset-btn" data-m="0,-1,1,0">Rotate 90&deg;</button>
            <button type="button" class="preset-btn" data-m="1.5,0,0,0.5">Squeeze</button>
            <button type="button" class="preset-btn" data-m="1,0,0,-1">Reflect</button>
            <button type="button" class="preset-btn" data-m="1,1,1,1">Singular (det=0)</button>
            <button type="button" class="preset-btn" data-m="1,0,0,1">Reset (I)</button>
          </div>
        </div>
      </div>

      <!-- Live Determinant & Step Slider -->
      <div class="deck-footer">
        <div class="det-display">
          <span class="ctrl-label">DETERMINANT:</span>
          <code class="det-val">det(A) = 1.00</code>
        </div>

        <div class="interp-slider-group">
          <span class="ctrl-label">TRANSFORM PROGRESS:</span>
          <input type="range" class="t-slider" min="0" max="1" step="0.005" value="1" />
          <span class="t-val">t = 1.00</span>
        </div>
      </div>
    </div>
  </linear-transform-2d>
</Exhibit>

<style>
  .lt2d-root {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--surface-card);
    border-radius: var(--radius-card);
    overflow: hidden;
    position: relative;
  }

  .canvas-wrap {
    width: 100%;
    height: 400px;
    position: relative;
  }

  .lt2d-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .lt2d-deck {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: color-mix(in srgb, var(--surface-card) 85%, var(--bg));
    border-top: 1px solid var(--border-default);
  }

  .deck-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .matrix-box {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
  }

  .m-bracket {
    font-size: 28px;
    font-weight: 300;
    color: var(--text-muted);
  }

  .m-grid {
    display: grid;
    grid-template-columns: repeat(2, 44px);
    gap: 4px;
  }

  .m-cell {
    width: 44px;
    height: 28px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    background: var(--surface);
    border: 1px solid var(--border-default);
    border-radius: 4px;
    color: var(--text);
  }

  .m-cell:focus {
    outline: none;
    border-color: var(--accent);
  }

  .preset-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ctrl-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .preset-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .preset-btn {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
    background: var(--surface);
    border: 1px solid var(--border-default);
    border-radius: 4px;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .preset-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .preset-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #ffffff;
  }

  .deck-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
    border-top: 1px dashed var(--border-default);
  }

  .det-display {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .det-val {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--accent);
  }

  .interp-slider-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 220px;
    max-width: 380px;
  }

  .t-slider {
    flex: 1;
    accent-color: var(--accent);
    cursor: pointer;
  }

  .t-val {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--accent);
    min-width: 50px;
    text-align: right;
  }
</style>

<script>
  import { BaseCanvasElement } from '../../visual-engine/core/BaseCanvasElement';
  import { easeInOutCubic, lerp } from '../../visual-engine/math/interpolations';
  import type { ThemeColors } from '../../visual-engine/core/ThemeBridge';

  class LinearTransform2DElement extends BaseCanvasElement {
    // Current matrix [a, b; c, d]
    private targetMatrix: [number, number, number, number] = [1, 1, 0, 1]; // [a, b, c, d]
    private currentMatrix: [number, number, number, number] = [1, 0, 0, 1];
    private transformProgress: number = 1.0;

    private cellA!: HTMLInputElement;
    private cellB!: HTMLInputElement;
    private cellC!: HTMLInputElement;
    private cellD!: HTMLInputElement;
    private detVal!: HTMLElement;
    private tSlider!: HTMLInputElement;
    private tVal!: HTMLElement;

    protected initScene(): void {
      this.cellA = this.querySelector('#m-a') as HTMLInputElement;
      this.cellB = this.querySelector('#m-b') as HTMLInputElement;
      this.cellC = this.querySelector('#m-c') as HTMLInputElement;
      this.cellD = this.querySelector('#m-d') as HTMLInputElement;
      this.detVal = this.querySelector('.det-val') as HTMLElement;
      this.tSlider = this.querySelector('.t-slider') as HTMLInputElement;
      this.tVal = this.querySelector('.t-val') as HTMLElement;

      this.initControls();
      this.updateDeterminant();
    }

    private initControls(): void {
      // 1. Preset buttons
      const presetBtns = this.querySelectorAll('.preset-btn');
      presetBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          presetBtns.forEach((b) => b.classList.remove('active'));
          const target = e.currentTarget as HTMLElement;
          target.classList.add('active');

          const raw = target.dataset.m;
          if (raw) {
            const parts = raw.split(',').map(Number);
            this.targetMatrix = [parts[0], parts[1], parts[2], parts[3]];
            this.cellA.value = String(parts[0]);
            this.cellB.value = String(parts[1]);
            this.cellC.value = String(parts[2]);
            this.cellD.value = String(parts[3]);
            this.updateDeterminant();
            this.animateTransform();
          }
        });
      });

      // 2. Manual Matrix Inputs
      [this.cellA, this.cellB, this.cellC, this.cellD].forEach((cell) => {
        cell?.addEventListener('input', () => {
          this.targetMatrix = [
            parseFloat(this.cellA.value) || 0,
            parseFloat(this.cellB.value) || 0,
            parseFloat(this.cellC.value) || 0,
            parseFloat(this.cellD.value) || 0,
          ];
          this.updateDeterminant();
          this.renderFrame(performance.now());
        });
      });

      // 3. Progress Slider
      this.tSlider?.addEventListener('input', (e) => {
        this.transformProgress = parseFloat((e.target as HTMLInputElement).value);
        if (this.tVal) this.tVal.textContent = `t = ${this.transformProgress.toFixed(2)}`;
        this.renderFrame(performance.now());
      });
    }

    private updateDeterminant(): void {
      const [a, b, c, d] = this.targetMatrix;
      const det = a * d - b * c;
      if (this.detVal) {
        this.detVal.textContent = `det(A) = ${det.toFixed(2)}`;
        this.detVal.style.color = Math.abs(det) < 0.001 ? 'var(--pink-400)' : 'var(--accent)';
      }
    }

    private animateTransform(): void {
      let start: number | null = null;
      const duration = 650; // ms

      const step = (now: number) => {
        if (!start) start = now;
        const elapsed = now - start;
        const rawProgress = Math.min(elapsed / duration, 1.0);
        this.transformProgress = easeInOutCubic(rawProgress);

        if (this.tSlider) this.tSlider.value = String(this.transformProgress);
        if (this.tVal) this.tVal.textContent = `t = ${this.transformProgress.toFixed(2)}`;

        this.renderFrame(now);

        if (rawProgress < 1.0) {
          requestAnimationFrame(step);
        }
      };

      requestAnimationFrame(step);
    }

    protected render(time: number): void {
      const ctx = this.ctx;
      const w = this.width;
      const h = this.height;
      const cx = w / 2;
      const cy = h / 2;
      const unit = Math.min(w, h) / 9; // Grid step size

      ctx.clearRect(0, 0, w, h);

      // Interpolate matrix from Identity I = [1,0,0,1] to target Matrix
      const t = this.transformProgress;
      const a = lerp(1, this.targetMatrix[0], t);
      const b = lerp(0, this.targetMatrix[1], t);
      const c = lerp(0, this.targetMatrix[2], t);
      const d = lerp(1, this.targetMatrix[3], t);

      // Helper: Transform point (x, y)
      const tx = (x: number, y: number): [number, number] => {
        const nx = a * x + b * y;
        const ny = c * x + d * y;
        return [cx + nx * unit, cy - ny * unit];
      };

      // 1. Draw Transformed Determinant Area Parallelogram (î x ĵ)
      const p0 = tx(0, 0);
      const pI = tx(1, 0);
      const pCorner = tx(1, 1);
      const pJ = tx(0, 1);

      ctx.beginPath();
      ctx.moveTo(p0[0], p0[1]);
      ctx.lineTo(pI[0], pI[1]);
      ctx.lineTo(pCorner[0], pCorner[1]);
      ctx.lineTo(pJ[0], pJ[1]);
      ctx.closePath();
      ctx.fillStyle = this.themeColors.isDark
        ? 'rgba(38, 118, 170, 0.25)'
        : 'rgba(38, 118, 170, 0.15)';
      ctx.fill();

      // 2. Draw Transformed Grid Lines
      const gridRange = 6;
      ctx.lineWidth = 1;
      ctx.strokeStyle = this.themeColors.isDark
        ? 'rgba(226, 232, 240, 0.12)'
        : 'rgba(26, 26, 46, 0.08)';

      for (let i = -gridRange; i <= gridRange; i++) {
        // Vertical grid lines (constant x)
        const vStart = tx(i, -gridRange);
        const vEnd = tx(i, gridRange);
        ctx.beginPath();
        ctx.moveTo(vStart[0], vStart[1]);
        ctx.lineTo(vEnd[0], vEnd[1]);
        ctx.stroke();

        // Horizontal grid lines (constant y)
        const hStart = tx(-gridRange, i);
        const hEnd = tx(gridRange, i);
        ctx.beginPath();
        ctx.moveTo(hStart[0], hStart[1]);
        ctx.lineTo(hEnd[0], hEnd[1]);
        ctx.stroke();
      }

      // 3. Draw Transformed Axes
      ctx.lineWidth = 1.8;
      ctx.strokeStyle = this.themeColors.isDark
        ? 'rgba(226, 232, 240, 0.35)'
        : 'rgba(26, 26, 46, 0.25)';

      const xAxisStart = tx(-gridRange, 0);
      const xAxisEnd = tx(gridRange, 0);
      ctx.beginPath();
      ctx.moveTo(xAxisStart[0], xAxisStart[1]);
      ctx.lineTo(xAxisEnd[0], xAxisEnd[1]);
      ctx.stroke();

      const yAxisStart = tx(0, -gridRange);
      const yAxisEnd = tx(0, gridRange);
      ctx.beginPath();
      ctx.moveTo(yAxisStart[0], yAxisStart[1]);
      ctx.lineTo(yAxisEnd[0], yAxisEnd[1]);
      ctx.stroke();

      // 4. Draw Basis Vector î (Anchor Blue #2676AA)
      this.drawVector(ctx, p0, pI, this.themeColors.accent, 'î');

      // 5. Draw Basis Vector ĵ (Signal Warm Coral #FFAFCC)
      this.drawVector(ctx, p0, pJ, this.themeColors.signalWarm, 'ĵ');

      // 6. Draw Origin Dot
      ctx.beginPath();
      ctx.arc(p0[0], p0[1], 4, 0, Math.PI * 2);
      ctx.fillStyle = this.themeColors.text;
      ctx.fill();
    }

    private drawVector(
      ctx: CanvasRenderingContext2D,
      from: [number, number],
      to: [number, number],
      color: string,
      label: string
    ): void {
      const headlen = 10;
      const dx = to[0] - from[0];
      const dy = to[1] - from[1];
      const angle = Math.atan2(dy, dx);

      // Line
      ctx.beginPath();
      ctx.moveTo(from[0], from[1]);
      ctx.lineTo(to[0], to[1]);
      ctx.strokeStyle = color;
      ctx.lineWidth = 2.8;
      ctx.lineCap = 'round';
      ctx.stroke();

      // Arrow Head
      ctx.beginPath();
      ctx.moveTo(to[0], to[1]);
      ctx.lineTo(
        to[0] - headlen * Math.cos(angle - Math.PI / 6),
        to[1] - headlen * Math.sin(angle - Math.PI / 6)
      );
      ctx.lineTo(
        to[0] - headlen * Math.cos(angle + Math.PI / 6),
        to[1] - headlen * Math.sin(angle + Math.PI / 6)
      );
      ctx.closePath();
      ctx.fillStyle = color;
      ctx.fill();

      // Vector Label
      ctx.font = '700 13px "JetBrains Mono", monospace';
      ctx.fillStyle = color;
      ctx.fillText(label, to[0] + 8 * Math.cos(angle), to[1] + 8 * Math.sin(angle));
    }

    protected onResize(): void {}
    protected onThemeChange(): void {}
  }

  if (!customElements.get('linear-transform-2d')) {
    customElements.define('linear-transform-2d', LinearTransform2DElement);
  }
</script>
