---
/**
 * DarkPlane.astro — spec §8.4 / §21
 * Darkness is semantic: conclusion, decision, final CTA.
 * Ink surface + soft radial blue glow. White heading, soft blue description,
 * blue primary action. Never a pink primary CTA here.
 */
interface Props {
  id?: string;
}

const { id } = Astro.props;
---

<section class="dark-plane" id={id}>
  <div class="dark-plane-inner">
    <slot />
  </div>
</section>

<style>
  .dark-plane {
    background:
      radial-gradient(
        circle at 80% 20%,
        rgba(0, 113, 227, 0.22),
        transparent 45%
      ),
      #121215;
    color: #f5f5f7;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-card);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.2);
    overflow: hidden;
  }

  .dark-plane-inner {
    max-width: var(--width-content);
    margin: 0 auto;
    padding: var(--space-8) var(--space-7);
  }

  .dark-plane :global(h1),
  .dark-plane :global(h2),
  .dark-plane :global(h3) {
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .dark-plane :global(p) {
    color: #a1a1a6;
    line-height: 1.65;
  }

  .dark-plane :global(a) {
    color: #2997ff;
  }

  @media (max-width: 640px) {
    .dark-plane-inner {
      padding: var(--space-7) var(--space-5);
    }
  }
</style>
