---
import { formatDate } from '@utils/date';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import TableOfContents from '@components/layout/TableOfContents.astro';
import RelatedPosts from '@components/content/RelatedPosts.astro';
import PostCTA from '@components/content/PostCTA.astro';
import { getReadingTime } from '@utils/readingTime';
import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.filter((post) => import.meta.env.DEV || !post.data.draft).map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;
const post = Astro.props;
const { Content, headings } = await render(post);

const tocHeadings = headings
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({ ...h, text: h.text.replace(/\s*#\s*$/, '') }));
const showToc = tocHeadings.length > 2;

const readingTime = getReadingTime(post.body || '');

const formattedDate = formatDate(post.data.pubDate);
---

<Layout
  title={`${post.data.title} | Karan Mittal`}
  description={post.data.description}
  type="article"
  pubDate={post.data.pubDate}
  canonical={post.data.firstPublished?.url}
  image={
    post.data.image
      ? new URL(post.data.image, Astro.site).toString()
      : undefined
  }
  imageWidth={post.data.image ? 1200 : undefined}
  imageHeight={post.data.image ? 630 : undefined}
>
  <main class="container post-layout instrumented-essay">
    <article class="post-content">
      <header class="post-header">
        <div class="post-header-copy">
          <div class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
            <span aria-hidden="true" class="meta-sep">·</span>
            <span>{readingTime} min read</span>
            {post.data.updatedDate && (
              <>
                <span class="updated">
                  <span aria-hidden="true" class="meta-sep">·</span> Updated <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time>
                </span>
              </>
            )}
            {post.data.firstPublished && (
              <>
                <span>
                  <span aria-hidden="true" class="meta-sep">·</span> First published on{' '}
                  <a href={post.data.firstPublished.url} target="_blank" rel="noopener">
                    {post.data.firstPublished.site}
                  </a>
                </span>
              </>
            )}
          </div>

          {post.data.titleHtml ? (
            <h1 set:html={post.data.titleHtml} />
          ) : (
            <h1>{post.data.title}</h1>
          )}

          {post.data.description && <p class="post-standfirst">{post.data.description}</p>}

          {post.data.tags.length > 0 && (
            <p class="post-tags">{post.data.tags.join(' · ')}</p>
          )}
        </div>

        {post.data.image && (
          <figure class="post-hero-figure">
            <a
              class="post-hero-media"
              href={post.data.image}
              target="_blank"
              rel="noopener"
              aria-label={`Open full-size figure: ${post.data.heroCaption || post.data.title}`}
            >
              <img
                src={post.data.image}
                alt={post.data.heroCaption || post.data.title}
                width="1920"
                height="1072"
                class="post-hero-img"
                loading="eager"
                decoding="async"
              />
            </a>
            {post.data.heroCaption && (
              <figcaption class="post-hero-caption">{post.data.heroCaption}</figcaption>
            )}
          </figure>
        )}
      </header>

      {showToc && (
        <details class="post-mobile-toc">
          <summary>
            <span>Contents</span>
            <span class="post-mobile-toc-count">{tocHeadings.length} sections</span>
          </summary>
          <div class="post-mobile-toc-panel">
            <TableOfContents headings={tocHeadings} idPrefix="mobile-toc" />
          </div>
        </details>
      )}

      <Content />

      <RelatedPosts post={post} />
      <PostCTA />

      <footer class="post-footer">
        <a class="more-link" href="/publications/">All writing and talks</a>
      </footer>
    </article>

    {showToc && (
      <aside class="post-sidebar">
        <TableOfContents headings={tocHeadings} idPrefix="desktop-toc" />
      </aside>
    )}
  </main>
</Layout>

<style>
  /* Essay page. Same edge, gaps and type steps as every other page; the
     contents column sits beside the prose on wide screens. */
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 232px;
    gap: 2.5rem;
    align-items: start;
  }
  .post-content {
    min-width: 0;
  }
  .post-sidebar {
    position: sticky;
    top: var(--gap-group);
    align-self: start;
  }
  .post-mobile-toc {
    display: none;
  }

  .post-header {
    max-width: 1040px;
    margin-bottom: var(--gap-block);
  }

  .post-header-copy {
    max-width: 760px;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin-bottom: var(--gap-related);
    color: var(--ie-muted);
    font-size: var(--ie-type-small);
  }
  .post-meta time {
    font-family: var(--font-mono);
    font-size: var(--ie-type-caption);
  }
  .meta-sep {
    color: var(--ie-rule-strong);
  }

  .post-header h1 {
    max-width: 28ch;
    margin: 0;
    font-size: var(--ie-type-h1);
    line-height: 1.15;
  }

  .post-standfirst {
    max-width: 52ch;
    margin: var(--gap-related) 0 0;
    color: var(--ie-muted);
    font-size: var(--ie-type-body);
  }

  .post-tags {
    margin: var(--gap-related) 0 0;
    color: var(--ie-muted);
    font-size: var(--ie-type-small);
  }

  /* Framed like the About portrait: a hairline holds the edge when the
     image is as light as the page. */
  .post-hero-figure {
    max-width: 1040px;
    margin: var(--gap-block) 0 0;
  }
  .post-hero-media {
    display: block;
    overflow-x: auto;
    border-radius: 18px;
    corner-shape: squircle;
    outline: 1px solid var(--ie-rule-strong);
    outline-offset: -1px;
  }
  .post-hero-img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 440px;
    object-fit: cover;
  }
  .post-hero-caption {
    margin-top: 0.75rem;
    color: var(--ie-muted);
    font-size: var(--ie-type-caption);
  }

  .post-footer {
    margin-top: var(--gap-group);
  }

  @media (max-width: 1100px) {
    .post-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .post-sidebar {
      display: none;
    }
    .post-mobile-toc {
      display: block;
      max-width: 700px;
      margin: 0 0 var(--gap-block);
      border-block: 1px solid var(--ie-rule);
    }
    .post-mobile-toc summary {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.75rem 0;
      color: var(--ie-ink);
      font-size: var(--ie-type-small);
      font-weight: 600;
      cursor: pointer;
      list-style: none;
    }
    .post-mobile-toc summary::-webkit-details-marker { display: none; }
    .post-mobile-toc summary::after {
      content: '+';
      color: var(--ie-blue);
      font-size: var(--ie-type-base);
    }
    .post-mobile-toc[open] summary::after { content: '\2212'; }
    .post-mobile-toc-count {
      margin-left: auto;
      color: var(--ie-muted);
      font-weight: 400;
    }
    .post-mobile-toc-panel {
      padding-bottom: 0.75rem;
    }
    .post-mobile-toc-panel :global(.toc-root) {
      max-height: min(60vh, 30rem);
    }
  }

  @media (max-width: 640px) {
    /* Wide figures keep their size and scroll inside their frame. */
    .post-hero-img {
      width: 720px;
      min-width: 720px;
      max-width: none;
      max-height: none;
    }
  }
</style>

<style is:global>
  /* Prose rules target markdown-rendered content within the instrumented essay. */
  .instrumented-essay .post-content > :is(p, ul, ol, blockquote, pre, h2, h3, h4, hr, table, .katex-display) {
    max-width: 700px;
  }

  .instrumented-essay .post-content > figure {
    width: 100%;
    max-width: 1040px;
  }

  .instrumented-essay .post-content > p,
  .instrumented-essay .post-content > :is(ul, ol) li {
    color: var(--ie-ink-secondary);
    font-family: var(--font-sans);
    font-size: var(--ie-type-body);
    line-height: 1.78;
  }

  .instrumented-essay .post-content > :is(ul, ol) {
    padding-left: 1.5rem;
    margin: 1.25rem 0;
  }

  .instrumented-essay .post-content > :is(ul, ol) li {
    margin-bottom: 0.45rem;
  }

  /* Space alone marks a new section; the header scrolls away, so anchor
     targets only need a small offset. */
  .instrumented-essay .post-content > h2 {
    margin-top: var(--gap-block);
    scroll-margin-top: var(--gap-group);
    color: var(--ie-ink);
    font-family: var(--font-display);
    font-size: var(--ie-type-h2);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .instrumented-essay .post-content > h3 {
    margin-top: var(--gap-group);
    scroll-margin-top: var(--gap-group);
    color: var(--ie-ink);
    font-family: var(--font-display);
    font-size: var(--ie-type-h3);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .instrumented-essay .post-content > h4 {
    margin: 2rem 0 0.65rem;
    scroll-margin-top: var(--gap-group);
    font-family: var(--font-display);
    font-size: var(--ie-type-base);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--ie-ink);
  }

  .instrumented-essay .post-content code {
    font-family: var(--font-mono);
  }

  .instrumented-essay .post-content > blockquote {
    margin-block: 2.5rem;
    padding: 0.2rem 0 0.2rem 1.25rem;
    border-left: 2px solid var(--ie-rule-strong);
    background: transparent;
    color: var(--ie-ink-secondary);
  }

  .instrumented-essay .post-content > blockquote p {
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-body);
    line-height: 1.68;
  }

  .instrumented-essay .post-content .katex-mathml,
  .instrumented-essay .post-content .katex-mathml math {
    inline-size: 1px !important;
    max-inline-size: 1px !important;
    overflow: hidden !important;
  }
  .instrumented-essay .post-content p > .katex:only-child {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }
  .instrumented-essay .post-content .katex-display {
    margin: 2rem 0;
    overflow-x: auto;
    color: var(--ie-ink);
  }
  .instrumented-essay .post-content .katex-display > .katex {
    min-width: max-content;
    font-size: 1.1em;
  }

  /* Tables: Inter for text, mono for code only. */
  .instrumented-essay .post-content table {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    table-layout: auto;
    border-top: 1px solid var(--ie-rule-strong);
    border-bottom: 1px solid var(--ie-rule-strong);
    font-family: var(--font-sans);
    font-size: var(--ie-type-small);
    line-height: 1.5;
  }

  .instrumented-essay .post-content th,
  .instrumented-essay .post-content td {
    padding: 0.75rem 0.85rem;
    border-width: 0 0 1px;
    border-style: solid;
    border-color: var(--ie-rule);
    text-align: left;
    vertical-align: top;
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .instrumented-essay .post-content th {
    background: transparent;
    color: var(--ie-ink);
    font-weight: 600;
  }

  .instrumented-essay .post-content td {
    color: var(--ie-ink-secondary);
  }

  .instrumented-essay .post-content table code {
    font-family: var(--font-mono);
    white-space: nowrap;
    overflow-wrap: normal;
  }


  @media (max-width: 640px) {
    .instrumented-essay .post-content .katex-display {
      font-size: 0.88rem;
    }
    .instrumented-essay .post-content .katex-display > .katex {
      min-width: 0;
      font-size: 0.95em;
      white-space: normal;
    }
    .instrumented-essay .post-content p > .katex:only-child {
      font-size: 0.94em;
    }
    .instrumented-essay .post-content table {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .instrumented-essay .post-content th,
    .instrumented-essay .post-content td {
      min-width: 10rem;
      padding: 0.65rem 0.75rem;
    }
    .instrumented-essay .post-content > figure {
      min-width: 0;
      max-width: 100%;
    }
  }
</style>
