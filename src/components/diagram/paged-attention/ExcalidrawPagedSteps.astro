---
import InteractiveWalkthrough from '../InteractiveWalkthrough.astro';

interface Props {
  caption?: string;
  exhibit?: string;
  title?: string;
}

const { caption, exhibit, title } = Astro.props;

const stages = [
  {
    id: 's1',
    index: '01',
    name: 'Logical blocks',
    desc: '<strong>01 / Logical blocks.</strong> The sequence is sliced into fixed-size blocks. Nothing is reserved for distant future tokens.',
    targetGroup: 'step-group-s1',
  },
  {
    id: 's2',
    index: '02',
    name: 'Block table',
    desc: '<strong>02 / Block table.</strong> A small table maps each logical block to its physical frame with an O(1) lookup.',
    targetGroup: 'step-group-s2',
  },
  {
    id: 's3',
    index: '03',
    name: 'Physical frames',
    desc: '<strong>03 / Physical frames.</strong> Frames come from any free block in the GPU pool, avoiding request-sized contiguous extents.',
    targetGroup: 'step-group-s3',
  },
  {
    id: 's4',
    index: '04',
    name: 'Kernel gather',
    desc: '<strong>04 / Kernel gather.</strong> The attention kernel follows the table’s pointers and reads the scattered KV blocks without a separate materialization copy.',
    targetGroup: 'step-group-s4',
  },
];
---

<InteractiveWalkthrough
  exhibit={exhibit}
  title={title}
  badge="PAGEDATTENTION MODEL"
  caption={caption}
  allStageName="Full model"
  allStageDesc="<strong>Complete model.</strong> Logical blocks are mapped to any available physical frame; the kernel follows that map directly during attention."
  stages={stages}
  wide={true}
>
  <div class="ex-canvas-frame">
    <svg id="ex-paged-steps-svg" class="ex-svg-canvas sys-diagram" viewBox="0 0 800 300" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="A four stage PagedAttention model showing logical token blocks, a block table, scattered physical frames, and an in-kernel gather.">
      <defs>
        <marker id="paged-arrow" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto"><polygon points="0 0, 10 4, 0 8" fill="var(--ex-text-main)" /></marker>
        <marker id="paged-arrow-signal" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto"><polygon points="0 0, 10 4, 0 8" fill="var(--ex-text-main)" /></marker>
      </defs>

      <g id="step-group-s1" data-step-group="step-group-s1" class="step-group">
        <text x="32" y="32" class="label-signal">01 / LOGICAL</text>
        <rect x="32" y="56" width="144" height="160" rx="4" class="node" />
        <text x="48" y="84" class="title">Token stream</text>
        <rect x="48" y="104" width="112" height="32" rx="4" class="node-muted" /><text x="64" y="125" class="label">BLOCK 00</text>
        <rect x="48" y="144" width="112" height="32" rx="4" class="node-muted" /><text x="64" y="165" class="label">BLOCK 01</text>
        <rect x="48" y="184" width="112" height="16" rx="4" fill="var(--ex-gray-bg)" /><text x="104" y="196" class="label" text-anchor="middle">…</text>
      </g>

      <path id="conn-s1-s2" data-step-connector="conn-s1-s2" d="M 176 136 H 240" class="flow-signal" marker-end="url(#paged-arrow-signal)" />

      <g id="step-group-s2" data-step-group="step-group-s2" class="step-group">
        <text x="240" y="32" class="label-signal">02 / TABLE</text>
        <rect x="240" y="56" width="152" height="160" rx="4" class="node-signal" />
        <text x="256" y="84" class="title">Translation</text>
        <text x="256" y="116" class="label">00  →  FRAME 12</text>
        <line x1="256" y1="128" x2="376" y2="128" class="rule" />
        <text x="256" y="156" class="label">01  →  FRAME 04</text>
        <line x1="256" y1="168" x2="376" y2="168" class="rule" />
        <text x="256" y="196" class="label">…</text>
      </g>

      <path id="conn-s2-s3" data-step-connector="conn-s2-s3" d="M 392 136 H 456" class="flow-signal" marker-end="url(#paged-arrow-signal)" />

      <g id="step-group-s3" data-step-group="step-group-s3" class="step-group">
        <text x="456" y="32" class="label-signal">03 / POOL</text>
        <rect x="456" y="56" width="152" height="160" rx="4" class="node" />
        <text x="472" y="84" class="title">Frame pool</text>
        <rect x="472" y="104" width="120" height="24" rx="4" class="node-signal" /><text x="488" y="121" class="label-signal">FRAME 12</text>
        <rect x="472" y="136" width="120" height="24" rx="4" class="node-muted" /><text x="488" y="153" class="label">FREE</text>
        <rect x="472" y="168" width="120" height="24" rx="4" class="node-signal" /><text x="488" y="185" class="label-signal">FRAME 04</text>
      </g>

      <path id="conn-s3-s4" data-step-connector="conn-s3-s4" d="M 608 136 H 672" class="flow-signal" marker-end="url(#paged-arrow-signal)" />

      <g id="step-group-s4" data-step-group="step-group-s4" class="step-group">
        <text x="672" y="32" class="label-signal">04 / KERNEL</text>
        <rect x="672" y="56" width="96" height="160" rx="4" class="node" />
        <text x="688" y="84" class="title">Gather</text>
        <text x="688" y="116" class="label">FOLLOW</text>
        <text x="688" y="136" class="label">POINTERS</text>
        <line x1="688" y1="152" x2="752" y2="152" class="rule" />
        <text x="688" y="180" class="label-signal">KV LOAD</text>
        <text x="688" y="200" class="label">ATTEND</text>
      </g>

      <text x="32" y="264" class="body-muted">Only the block table must be contiguous. KV frames can live anywhere in the pool.</text>
    </svg>
    <p class="ex-canvas-hint">On small screens, the figure scales to the reading column.</p>
  </div>
</InteractiveWalkthrough>
