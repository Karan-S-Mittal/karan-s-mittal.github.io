---
/**
 * TintedPlane.astro — spec §24 (Surfaces) / §3.1 surface.blue & canvas.blue
 * A soft blue-gradient plane for editorial statements: meta label, large ink
 * heading, secondary body — with an optional faint node-and-line motif.
 * The motif is semantic restraint, not decoration: sparse, connected, ambient.
 */
interface Props {
  id?: string;
  label?: string;
  motif?: boolean;
}

const { id, label, motif = true } = Astro.props;
---

<section class="tinted-plane" id={id}>
  {motif && (
    <svg class="tp-motif" viewBox="0 0 620 300" aria-hidden="true">
      <circle cx="70" cy="40" r="6" />
      <circle cx="300" cy="110" r="7" />
      <circle cx="180" cy="220" r="6" />
      <circle cx="470" cy="60" r="7" />
      <circle cx="560" cy="200" r="6" />
      <circle cx="400" cy="250" r="5" />
      <line x1="76" y1="44" x2="292" y2="106" class="tp-dashed" />
      <line x1="296" y1="118" x2="188" y2="212" class="tp-solid" />
      <line x1="308" y1="106" x2="462" y2="64" class="tp-solid" />
      <line x1="474" y1="68" x2="556" y2="192" class="tp-solid" />
      <line x1="554" y1="204" x2="406" y2="246" class="tp-dashed" />
      <line x1="186" y1="216" x2="394" y2="248" class="tp-dashed" />
    </svg>
  )}
  <div class="tp-inner">
    {label && <p class="tp-label">{label}</p>}
    <div class="tp-body">
      <slot />
    </div>
  </div>
</section>

<style>
  .tinted-plane {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    background:
      linear-gradient(
        135deg,
        var(--ie-blue-soft) 0%,
        color-mix(in srgb, var(--ie-blue-soft) 40%, var(--ie-surface-raised)) 55%,
        var(--ie-surface-raised) 100%
      );
    border: 1px solid color-mix(in srgb, var(--ie-blue) 55%, var(--ie-rule-strong));
  }

  .tp-motif {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.35;
    pointer-events: none;
  }

  .tp-motif circle {
    fill: var(--ie-blue);
  }

  .tp-motif .tp-solid {
    stroke: var(--ie-blue);
    stroke-width: 1.5;
  }

  .tp-motif .tp-dashed {
    stroke: var(--ie-blue);
    stroke-width: 1.5;
    stroke-dasharray: 4 6;
  }

  .tp-inner {
    position: relative;
    max-width: 56ch;
    padding: var(--space-8) var(--space-8);
  }

  .tp-label {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--ie-type-ui);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--interactive-primary);
  }

  .tp-body :global(h1),
  .tp-body :global(h2),
  .tp-body :global(h3) {
    color: var(--text);
    margin-bottom: var(--space-4);
  }

  .tp-body :global(p) {
    color: var(--text-secondary);
    margin-bottom: var(--space-3);
  }

  .tp-body :global(*:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .tp-inner {
      padding: var(--space-6) var(--space-5);
    }

    .tp-motif {
      opacity: 0.22;
    }
  }
</style>
