---
import Layout from '@layouts/Layout.astro';
import Button from '@components/editorial/Button.astro';
import { getCollection } from 'astro:content';
import { SITE, SOCIALS } from '../config';

const publishedPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPosts = publishedPosts.slice(0, 3);
const totalNotes = publishedPosts.length;

function formatDate(date: Date | string) {
  const value = typeof date === 'string' ? new Date(date) : date;
  return value.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
}

const linkedinSocial = SOCIALS.find((s) => s.name === 'LinkedIn')?.url || 'https://www.linkedin.com/in/karansmittal/';
const githubSocial = SOCIALS.find((s) => s.name === 'GitHub')?.url || 'https://github.com/karan-s-mittal';
---

<Layout
  title={`${SITE.title} | Deterministic AI Systems Architect`}
  description="Karan Mittal is an AI Systems Architect and co-founder of Dextar, specializing in deterministic RAG, low-level inference optimization, and dependable AI systems."
>
  <main class="home-shell">
    <!-- SIGNATURE HERO -->
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-content">
        <span class="hero-kicker">AI Systems Architect &middot; Co-Founder, Dextar</span>
        <h1 id="home-title" class="hero-title">
          I turn ambiguous AI problems into deterministic systems.
        </h1>
        <p class="hero-lead">
          I work with engineering teams turning uncertain AI prototypes into dependable production systems with clear boundaries, inspectable evidence, and explicit constraints. My focus centers on deterministic knowledge retrieval, inference memory optimization, and microarchitectural performance.
        </p>

        <div class="hero-actions">
          <Button href="/contact">Start a conversation &rarr;</Button>
          <Button href="/blog" variant="secondary">Read field notes &rarr;</Button>
          <Button href="/work" variant="secondary">Selected work &nearr;</Button>
        </div>
      </div>

      <div class="hero-aside">
        <div class="hero-portrait-frame">
          <img
            src="/profile-400.jpg"
            alt="Karan Mittal speaking at a technical event"
            class="hero-portrait"
            width="240"
            height="270"
            loading="eager"
          />
        </div>
        <div class="principle-note">
          <span class="note-label">Systems Principle</span>
          <p>&ldquo;The difficult part of an engineering problem is rarely the tool. It is designing a system people can rely on.&rdquo;</p>
        </div>
      </div>
    </section>

    <!-- 3-COLUMN SIGNAL STRIP -->
    <section class="signal-strip" aria-label="Key signals and focus areas">
      <div class="signal-col">
        <span class="signal-num">01</span>
        <div class="signal-body">
          <strong>Central India Ecosystem</strong>
          <p>Organizing workshops &amp; mentoring engineers at MLIndore, CodeVipassana, and GDG Cloud.</p>
        </div>
      </div>
      <div class="signal-col">
        <span class="signal-num">02</span>
        <div class="signal-body">
          <strong>Dextar Systems</strong>
          <p>Architecting deterministic knowledge layers and production GraphRAG for enterprise scale.</p>
        </div>
      </div>
      <div class="signal-col">
        <span class="signal-num">03</span>
        <div class="signal-body">
          <strong>Inference &amp; Advisory</strong>
          <p>Optimizing KV-cache layout, CUDA execution paths, and production reliability boundaries.</p>
        </div>
      </div>
    </section>

    <!-- 01 / WRITING-FIRST SECTION -->
    <section class="home-section" aria-labelledby="writing-heading">
      <div class="section-head">
        <div>
          <span class="section-register">01 / Field Notes</span>
          <h2 id="writing-heading">Selected Technical Writing</h2>
        </div>
        <a href="/blog" class="all-link">All notes ({totalNotes}) &rarr;</a>
      </div>

      <div class="notes-list">
        {featuredPosts.map((post) => (
          <a href={`/blog/${post.id}/`} class="note-row">
            <time datetime={post.data.pubDate.toISOString()} class="note-date">
              {formatDate(post.data.pubDate)}
            </time>
            <div class="note-main">
              <h3 class="note-title">{post.data.title}</h3>
              <p class="note-desc">{post.data.description}</p>
            </div>
            <span class="note-arrow" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>

      <div class="section-foot">
        <a href="/blog" class="ie-action secondary">Explore all {totalNotes} field notes &rarr;</a>
      </div>
    </section>

    <!-- 02 / ADVISORY & CONSULTATION -->
    <section class="home-section consultation-section" aria-labelledby="consult-heading">
      <div class="consultation-box">
        <span class="section-register">02 / Advisory</span>
        <h2 id="consult-heading">Bring the difficult system question</h2>
        <p class="consultation-desc">
          Available for technical advisory, deep-dive architecture reviews, and resolving prototype-to-production bottlenecks across deterministic retrieval and low-level inference.
        </p>

        <div class="hero-actions">
          <Button href="/contact">Start consultation inquiry &rarr;</Button>
          <Button href={`mailto:${SITE.email}?subject=Systems%20Architecture%20Inquiry`} variant="secondary">Email</Button>
          <Button href={linkedinSocial} target="_blank" rel="noopener" variant="secondary">LinkedIn &nearr;</Button>
          <Button href={githubSocial} target="_blank" rel="noopener" variant="secondary">GitHub &nearr;</Button>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .home-shell {
    max-width: 960px;
    margin-inline: auto;
    padding: clamp(2.5rem, 5vw, 4.5rem) var(--space-5, 1.5rem);
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6vw, 5rem);
  }

  /* SIGNATURE HERO */
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
  }

  .hero-kicker {
    display: inline-block;
    color: var(--ie-blue);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .hero-title {
    margin: 0 0 1.25rem;
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--ie-ink);
  }

  .hero-lead {
    margin: 0 0 2rem;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-body);
    line-height: 1.68;
    max-width: 620px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  /* HERO ASIDE WITH SIGNATURE PRINCIPLE NOTE */
  .hero-aside {
    position: relative;
    padding-bottom: 2rem;
  }

  .hero-portrait-frame {
    width: 240px;
    height: 270px;
    border-radius: var(--radius-card, 8px);
    overflow: hidden;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
  }

  .hero-portrait {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .principle-note {
    position: relative;
    width: 108%;
    margin-top: -1.75rem;
    margin-left: -1rem;
    padding: 0.85rem 1rem;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 8px);
    box-shadow: 4px 4px 0 var(--ie-blue-soft);
    transition: transform 150ms ease, box-shadow 150ms ease;
  }

  .principle-note:hover {
    transform: translateY(-2px);
    box-shadow: 5px 5px 0 var(--ie-blue-soft);
  }

  .principle-note p {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 0.8125rem;
    line-height: 1.45;
    font-style: italic;
    color: var(--ie-ink);
  }

  .note-label {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--ie-blue);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* 3-COLUMN SIGNAL STRIP */
  .signal-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--ie-rule);
    border-bottom: 1px solid var(--ie-rule);
    padding: 1.5rem 0;
    gap: 1.5rem;
  }

  .signal-col {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .signal-col + .signal-col {
    border-left: 1px solid var(--ie-rule);
    padding-left: 1.5rem;
  }

  .signal-num {
    color: var(--ie-blue);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .signal-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .signal-body strong {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ie-ink);
  }

  .signal-body p {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--ie-ink-secondary);
    line-height: 1.45;
  }

  /* SECTIONS */
  .home-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--ie-rule);
  }

  .section-register {
    display: inline-block;
    margin-bottom: 0.35rem;
    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-head h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.8vw, 2.1rem);
    font-weight: 600;
    color: var(--ie-ink);
    line-height: 1.2;
  }

  .all-link {
    color: var(--ie-blue);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: color 120ms ease;
  }

  .all-link:hover {
    color: var(--ie-ink);
    text-decoration: underline;
  }

  /* NOTES LIST */
  .notes-list {
    display: flex;
    flex-direction: column;
  }

  .note-row {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: baseline;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--ie-rule);
    text-decoration: none;
    color: inherit;
    transition: background-color 120ms ease;
  }

  .note-row:hover .note-title {
    color: var(--ie-blue);
  }

  .note-row:hover .note-arrow {
    transform: translateX(4px);
    color: var(--ie-blue);
  }

  .note-date {
    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .note-main {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .note-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ie-ink);
    transition: color 120ms ease;
  }

  .note-desc {
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-small);
    line-height: 1.55;
    max-width: 680px;
  }

  .note-arrow {
    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: 1.1rem;
    transition: transform 120ms ease, color 120ms ease;
  }

  .section-foot {
    margin-top: 0.5rem;
  }

  /* CONSULTATION */
  .consultation-section {
    border-top: 2px solid var(--ie-rust);
    padding-top: 2rem;
  }

  .consultation-box {
    max-width: 680px;
  }

  .consultation-box h2 {
    margin: 0.25rem 0 0.75rem;
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.8vw, 2.1rem);
    font-weight: 600;
    color: var(--ie-ink);
  }

  .consultation-desc {
    margin: 0 0 1.75rem;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-body);
    line-height: 1.65;
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .home-hero {
      grid-template-columns: 1fr;
    }

    .hero-aside {
      order: -1;
      display: grid;
      grid-template-columns: 140px 1fr;
      gap: 1.25rem;
      align-items: center;
      max-width: 480px;
      padding-bottom: 0;
    }

    .hero-portrait-frame {
      width: 140px;
      height: 160px;
    }

    .principle-note {
      width: 100%;
      margin: 0;
    }

    .signal-strip {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .signal-col + .signal-col {
      border-left: 0;
      border-top: 1px solid var(--ie-rule);
      padding-left: 0;
      padding-top: 1rem;
    }

    .note-row {
      grid-template-columns: 1fr auto;
      gap: 0.5rem 1rem;
    }

    .note-date {
      grid-column: 1 / -1;
    }
  }
</style>
