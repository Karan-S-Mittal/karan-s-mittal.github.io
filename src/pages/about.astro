---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/portfolio/PageHeader.astro';
import Icon from '../components/chrome/Icon.astro';
import communitiesData from '../data/communities.json';

const { communities } = communitiesData;
---

<Layout title="About | Karan Mittal">
  <main class="container about-page">
    <PageHeader
      label="About"
      title="Karan Mittal"
      description="AI systems architect, founder, and community builder working on dependable knowledge and inference systems."
    />

    <div class="about-intro">
      <div class="about-portrait-frame">
        <img class="about-portrait" src="/profile-400.jpg" alt="Karan Mittal speaking at a technical event" width="400" height="400" />
      </div>
      <div class="about-lead">
        <blockquote class="hero-quote">
          “The difficult part of an engineering problem is rarely the tool. It is designing a system people can rely on.”
        </blockquote>

        <p class="bio">
          I am an AI Systems Architect and co-founder of <a href="https://dextar.co" target="_blank" rel="noopener">Dextar</a>. I work with teams
          turning uncertain data and AI work into systems with clear boundaries, inspectable evidence, explicit
          constraints, and a path to production. My experience spans life sciences, semiconductor supply chains,
          and finance; my current focus includes deterministic knowledge systems, AI reliability, and microarchitectural performance engineering.
        </p>

        <nav class="local-nav" aria-label="Section shortcuts">
          <a href="/now" class="pill-shortcut"><span>Now</span> <span class="arrow" aria-hidden="true">→</span></a>
          <a href="#capabilities" class="pill-shortcut"><span>Practice</span> <span class="arrow" aria-hidden="true">↓</span></a>
          <a href="#community" class="pill-shortcut"><span>Community</span> <span class="arrow" aria-hidden="true">↓</span></a>
          <a href="/contact" class="pill-shortcut accent"><span>Project brief</span> <span class="arrow" aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </div>

    <section id="capabilities" class="about-section">
      <div class="section-head">
        <span class="section-register">01 / Practice</span>
        <h2>Engineering practice</h2>
      </div>
      <div class="capabilities-grid">
        <div class="capability-card">
          <span class="cap-num">01</span>
          <h3>AI Architecture &amp; RAG</h3>
          <p>Deterministic knowledge systems, retrieval contracts, graph-aware discovery, and LLM orchestration.</p>
        </div>
        <div class="capability-card">
          <span class="cap-num">02</span>
          <h3>Performance &amp; Inference</h3>
          <p>KV-cache layout optimization, CUDA kernels, memory fragmentation bounds, and low-latency delivery.</p>
        </div>
        <div class="capability-card">
          <span class="cap-num">03</span>
          <h3>Infrastructure &amp; MLOps</h3>
          <p>Production evaluation harnesses, distributed data pipelines, Kubernetes, and operational guardrails.</p>
        </div>
        <div class="capability-card">
          <span class="cap-num">04</span>
          <h3>Technical Strategy</h3>
          <p>Architecture review, engineering team mentoring, stakeholder alignment, and durable technical handover.</p>
        </div>
      </div>
    </section>

    <section id="community" class="about-section">
      <div class="section-head">
        <span class="section-register">02 / Ecosystem</span>
        <h2>Community &amp; Mentorship</h2>
        <p class="section-desc">Organising, mentoring, and teaching across technical communities in Central India.</p>
      </div>
      <div class="community-list">
        {communities.map((c) => (
          <div class="community-row">
            <img src={c.logo} alt={c.name} class="community-logo" loading="lazy" decoding="async" />
            <div class="community-info">
              <p class="community-name">{c.name}</p>
              <p class="community-desc">{c.description}</p>
            </div>
            {c.links && c.links.length > 0 && (
              <div class="community-links">
                {c.links.map((link: { label: string; url: string }) => (
                  <a href={link.url} target="_blank" rel="noopener" class="comm-btn">
                    <span>{link.label}</span>
                    <Icon name="arrow-up-right" size={12} />
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="cta-section">
      <div class="cta-inner">
        <span class="section-register">03 / Consultation</span>
        <h2>Bring the difficult system question</h2>
        <p>Available for consulting engagements involving complex data architectures, AI reliability, GPU performance optimization, or technical strategy.</p>
        <div class="cta-actions">
          <a href="/contact" class="ie-cta primary">Start a project brief <span aria-hidden="true">→</span></a>
          <a href="https://www.linkedin.com/in/karansmittal/" target="_blank" rel="noopener" class="ie-cta secondary">Connect on LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .about-page {
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }

  .about-intro {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--ie-rule);
  }

  .about-portrait-frame {
    width: 200px;
    height: 240px;
    border-radius: var(--radius-card, 8px);
    overflow: hidden;
    background: var(--ie-surface-raised);
    border: 1px solid var(--ie-rule);
  }

  .about-portrait {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(100%) contrast(1.05);
    transition: filter 200ms ease;
  }

  .about-portrait-frame:hover .about-portrait {
    filter: grayscale(20%) contrast(1.02);
  }

  .about-lead {
    display: flex;
    flex-direction: column;
  }

  .hero-quote {
    margin: 0 0 1.25rem;
    padding: 0;
    border: none;
    background: none;
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.3vw, 1.7rem);
    font-weight: 500;
    font-style: italic;
    color: var(--ie-ink);
    line-height: 1.4;
    letter-spacing: -0.015em;
  }

  .bio {
    margin: 0 0 1.5rem;
    color: var(--ie-ink-secondary);
    font-size: 1.05rem;
    line-height: 1.68;
    max-width: 680px;
  }

  .bio a {
    color: var(--ie-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .local-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .pill-shortcut {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-pill, 999px);
    background: var(--ie-surface);
    color: var(--ie-ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 120ms ease, background-color 120ms ease, color 120ms ease;
  }

  .pill-shortcut:hover {
    border-color: var(--ie-blue);
    background: var(--ie-blue-soft);
    color: var(--ie-blue);
  }

  .pill-shortcut.accent {
    border-color: var(--ie-blue);
    background: var(--ie-blue-soft);
    color: var(--ie-blue);
    font-weight: 600;
  }

  .pill-shortcut.accent:hover {
    background: var(--ie-blue);
    color: #fff;
  }

  .about-section {
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  .section-head {
    margin-bottom: 1.5rem;
  }

  .section-register {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--ie-blue);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .section-head h2 {
    margin: 0;
    color: var(--ie-ink);
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.8vw, 2.1rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .section-desc {
    margin: 0.4rem 0 0;
    color: var(--ie-muted);
    font-size: 0.95rem;
  }

  .capabilities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .capability-card {
    padding: 1.3rem 1.4rem;
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 8px);
    background: var(--ie-surface);
    transition: border-color 140ms ease;
  }

  .capability-card:hover {
    border-color: var(--ie-rule-strong);
  }

  .cap-num {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--ie-blue);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .capability-card h3 {
    margin: 0 0 0.5rem;
    color: var(--ie-ink);
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .capability-card p {
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .community-list {
    display: grid;
    gap: 1rem;
  }

  .community-row {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 8px);
    background: var(--ie-surface);
  }

  .community-logo {
    display: block;
    width: 2.75rem;
    height: 2.75rem;
    object-fit: contain;
    border-radius: var(--radius, 6px);
  }

  .community-name {
    margin: 0 0 0.25rem;
    color: var(--ie-ink);
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .community-desc {
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .community-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .comm-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-pill, 999px);
    background: var(--ie-surface-raised);
    color: var(--ie-ink);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-decoration: none;
    transition: border-color 120ms ease, background-color 120ms ease, color 120ms ease;
  }

  .comm-btn:hover {
    border-color: var(--ie-blue);
    background: var(--ie-blue-soft);
    color: var(--ie-blue);
  }

  .cta-section {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .cta-inner {
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 8px);
    background: var(--ie-surface);
  }

  .cta-inner h2 {
    margin: 0 0 0.75rem;
    color: var(--ie-ink);
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.8vw, 2.1rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .cta-inner p {
    margin: 0 0 1.5rem;
    max-width: 620px;
    color: var(--ie-ink-secondary);
    font-size: 1rem;
    line-height: 1.6;
  }

  .cta-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .ie-cta {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.55rem 1rem;
    border-radius: var(--radius, 6px);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 120ms ease, background-color 120ms ease, color 120ms ease;
  }

  .ie-cta.primary {
    border: 1px solid var(--ie-ink);
    background: var(--ie-ink);
    color: var(--ie-canvas);
  }

  .ie-cta.primary:hover {
    border-color: var(--ie-blue);
    background: var(--ie-blue);
    color: #fff;
  }

  .ie-cta.secondary {
    border: 1px solid var(--ie-rule);
    background: var(--ie-surface-raised);
    color: var(--ie-ink);
  }

  .ie-cta.secondary:hover {
    border-color: var(--ie-blue);
    color: var(--ie-blue);
  }

  @media (max-width: 768px) {
    .about-intro {
      grid-template-columns: 1fr;
    }
    .about-portrait-frame {
      width: 140px;
      height: 160px;
    }
    .community-row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .community-logo {
      display: none;
    }
    .community-links {
      justify-content: flex-start;
    }
  }
</style>
