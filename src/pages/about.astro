---
import Layout from '@layouts/Layout.astro';
import communitiesData from '@data/communities.json';
import CommunityIcon from '@components/content/CommunityIcon.astro';
import { SOCIALS } from '../config';
import '@styles/practice.css';

const linkedin = SOCIALS.find((social) => social.label === 'LinkedIn')!;

---

<Layout
  title="About | Karan Mittal"
  description="Karan Mittal is a data visualisation expert, co-founder and CTO of Dextar, and a community organiser in Indore. He has built data apps in Plotly Dash since 2019."
>
  <main class="practice-page about-page">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="about-hero-copy">
        <h1 id="about-title">About me</h1>
        <p class="lead">
          I’m a data visualisation expert and the co-founder and CTO of{' '}
          <a href="https://dextar.co" target="_blank" rel="noopener">Dextar</a>. I’ve built
          dashboards, search engines and NLP systems for teams in semiconductor manufacturing,
          life sciences and finance.
        </p>
      </div>

      <figure class="about-portrait">
        <div class="portrait-frame">
          <img
            src="/portrait.jpg"
            srcset="/portrait-320.jpg 320w, /portrait.jpg 480w"
            sizes="(max-width: 760px) 320px, 400px"
            alt="Karan Mittal speaking at a technical event"
            width="480"
            height="600"
          />
        </div>
      </figure>
    </section>

    <section class="section about-history" aria-labelledby="history-title">
      <h2 id="history-title">How I got here</h2>
      <div class="history-narrative">
        <p>
          I started in 2019 at TorqueVision Labs, building a risk-monitoring app in Plotly Dash
          while the framework was new. In 2021 I joined Plotly as a software engineer and worked on
          dash-DAQ, dash-VTK and the enterprise products. At UsefulBI I built oncology analytics
          for life-sciences teams and shipped apps on Dash Enterprise. At Lam Research I built
          process-monitoring analytics for semiconductor manufacturing. In 2025 I co-founded
          Dextar, where I’m CTO.
        </p>
      </div>
    </section>

    <!-- Section 02: Community & Teaching (Dense Single-Line Ledger) -->
    <section class="section community-section" id="community" aria-labelledby="community-title">
      <div class="section-head">
        <div>
          <h2 id="community-title">Community and teaching</h2>
        </div>
        <div class="community-head-actions">
          <a class="more-link" href="/publications/#talks">Talks and workshops</a>
          <a class="more-link" href={linkedin.href} target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
      <p class="community-lead">
        I organise and speak in technical communities in Indore, and I’ve delivered more than 70
        sessions and workshops.
      </p>

      <div class="community-ledger">
        {communitiesData.communities.map((community) => (
          <article class="community-ledger-row">
            <CommunityIcon id={community.id} />
            <div class="community-main">
              <h3>{community.name}</h3>
              <p>{community.description}</p>
            </div>
            <div class="community-links">
              {community.links.map((link) => (
                <a href={link.url} target="_blank" rel="noopener" class="community-link">
                  <span>{link.label}</span>
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Section 03: Closing CTA -->
    <section class="section closing" aria-labelledby="about-closing-title">
      <h2 id="about-closing-title">Work together</h2>
      <p class="lead">
        If your team has data that people can’t read yet, tell me what it is and who needs to see
        it. I build the dashboard, chart or graph view, and hand it over.
      </p>
      <div class="actions">
        <a href="/contact/" class="button">Discuss your project</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* ================================================================
     1. Hero: Asymmetric Wider Portrait Split
     ================================================================ */
  .about-hero {
    display: grid;
    min-height: auto;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 400px);
    align-items: center;
    gap: clamp(3rem, 7vw, 6rem);
    padding-top: var(--page-top);
  }

  .about-hero-copy .lead {
    max-width: 60ch;
    margin-bottom: 0;
  }

  .about-portrait {
    width: 100%;
    margin: 0;
  }

  .portrait-frame {
    border-radius: 18px;
    corner-shape: squircle;
    overflow: hidden;
    outline: 1px solid var(--ie-rule-strong);
    outline-offset: -1px;
  }

  .portrait-frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.02);
  }

  .history-narrative {
    max-width: 72ch;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: var(--gap-group);
  }

  .history-narrative p {
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-base);
    line-height: 1.6;
  }

  /* ================================================================
     3. Community: Dense Single-Line Ledger
     ================================================================ */
  .community-head-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .community-section .section-head {
    margin-bottom: var(--gap-related);
  }

  .community-lead {
    max-width: 72ch;
    margin-bottom: var(--gap-group);
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-base);
    line-height: 1.6;
  }

  .community-ledger {
    border-top: 1px solid var(--ie-rule);
  }

  .community-ledger-row {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: center;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--ie-rule);
    transition: background-color 140ms ease;
  }

  .community-main h3 {
    margin: 0 0 0.25rem;
    font-size: var(--ie-type-base);
    color: var(--ie-ink);
  }

  .community-main p {
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-small);
    line-height: 1.55;
    max-width: 68ch;
  }

  .community-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
  }

  .community-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-sans);
    font-size: var(--ie-type-small);
    color: var(--ie-blue);
    text-decoration: none;
  }

  .community-link::after {
    content: '\2197';
    font-size: 0.85em;
  }

  .community-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  /* Responsive Adjustments */
  @media (max-width: 760px) {
    .about-hero {
      grid-template-columns: 1fr;
      gap: var(--gap-group);
    }

    .about-portrait {
      max-width: 320px;
    }

    .community-ledger-row {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 0.35rem 1rem;
      align-items: start;
    }

    .community-links {
      grid-column: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .community-ledger-row {
      transition: none;
    }
  }
</style>
