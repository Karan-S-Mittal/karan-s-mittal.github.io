---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/portfolio/PageHeader.astro';
import YearGroup from '../../components/portfolio/YearGroup.astro';
import BlogPostCard from '../../components/portfolio/BlogPostCard.astro';

const allPosts = await getCollection('blog');
const isDev = import.meta.env.DEV;
const posts = allPosts
  .filter((post) => isDev || !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const postsByYear = posts.reduce<Record<string, typeof posts>>((acc, post) => {
  const year = post.data.pubDate.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<Layout title="Essays | Karan Mittal">
  <main class="container">
    <PageHeader label="§03 Blog" title="Writing & Systems Notes." description="First-principles explanations of retrieval, inference, algorithms, and the decisions beneath dependable software." />

    <div class="blog-toolbar">
      <div class="search-wrap blog-search">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="blog-search"
          placeholder="Search essays..."
          aria-label="Search essays"
          autocomplete="off"
        />
      </div>

      <div class="blog-quick-links">
        <a href="/studio/visuals" class="quick-link-pill pill-accent">
          <span class="pill-dot"></span>
          <span>Visuals Lab</span>
          <span class="pill-arrow">&rarr;</span>
        </a>
        <a href="/tags" class="quick-link-pill">
          <span>Topics</span>
        </a>
      </div>
    </div>

    <p id="no-results" class="no-results" style="display: none;">No posts found.</p>

    <div class="archive-list" id="blog-timeline">
      {years.map((year) => (
        <YearGroup year={year} count={postsByYear[year].length}>
          {postsByYear[year].map((post) => (
            <BlogPostCard
              post={post}
              searchText={[
                post.data.title,
                post.data.description,
                ...post.data.tags,
              ].join(' ').toLowerCase()}
            />
          ))}
        </YearGroup>
      ))}
    </div>
  </main>
</Layout>

<script>
  const searchInput = document.getElementById('blog-search');
  const posts = document.querySelectorAll('.post-card');
  const yearGroups = document.querySelectorAll('.year-group');
  const noResults = document.getElementById('no-results');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
      let visibleCount = 0;

      posts.forEach((post) => {
        const text = (post as HTMLElement).dataset.search || '';
        const match = !query || text.includes(query);
        (post as HTMLElement).style.display = match ? '' : 'none';
        if (match) visibleCount++;
      });

      yearGroups.forEach((group) => {
        const visiblePosts = group.querySelectorAll('.post-card');
        let hasVisible = false;
        visiblePosts.forEach((p) => {
          if ((p as HTMLElement).style.display !== 'none') hasVisible = true;
        });
        (group as HTMLElement).style.display = hasVisible ? '' : 'none';
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    });
  }
</script>

<style>
  main.container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 var(--space-5) var(--space-9);
  }

  .blog-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
    flex-wrap: wrap;
  }

  .blog-search {
    flex: 1;
    max-width: 360px;
    margin-bottom: 0;
  }

  .blog-quick-links {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .quick-link-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.45rem 0.85rem;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all var(--transition-fast);
    box-shadow: var(--shadow-sm);
  }

  .quick-link-pill:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }

  .pill-accent {
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    color: var(--accent);
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .pill-arrow {
    font-size: 11px;
    transition: transform var(--transition-fast);
  }

  .quick-link-pill:hover .pill-arrow {
    transform: translateX(2px);
  }

  .search-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-icon {
    position: absolute;
    left: 0.85rem;
    color: var(--muted);
    pointer-events: none;
  }
  .search-wrap input {
    width: 100%;
    padding: 0.6rem 1rem 0.6rem 2.5rem;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--text);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .search-wrap input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.15);
  }

  .no-results {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
    padding: var(--space-6) 0;
  }

  @media (max-width: 768px) {
    main.container {
      padding: 0 var(--space-4) var(--space-8);
    }
  }
</style>
