---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/content/PageHeader.astro';
import { SITE } from '../config';

const tallyEmbedUrl = 'https://tally.so/embed/jar8jY?alignLeft=1&hideTitle=1&dynamicHeight=1';
---

<Layout
  title="Start a Conversation | Karan Mittal"
  description="Start a consulting, collaboration, or technical conversation with Karan Mittal."
>
  <main class="container contact-page">
    <PageHeader
      label="Contact"
      title="What needs to work better?"
      description="Tell me about the problem, who it affects, and what a useful outcome would look like. A few sentences are enough to start."
    />

    <div class="contact-actions">
      <a class="email-action" href={`mailto:${SITE.email}?subject=Systems%20Engineering%20Inquiry`}>Email me →</a>
      <a href="#tally-container">Use the contact form ↓</a>
    </div>

    <div class="contact-layout">
      <aside class="contact-aside" aria-label="Consulting guidance">
        <div class="aside-brief-card">
          <div class="brief-section">
            <p class="aside-label">A useful first note</p>
            <p>Describe what is happening, its impact on the team or organisation, and any timing or constraints that matter. You do not need a finished brief or a chosen technology.</p>
          </div>

          <div class="brief-section">
            <p class="aside-label">Engagement scope</p>
            <ul class="aside-list">
              <li><span>→</span> System reviews and problem diagnosis</li>
              <li><span>→</span> Design, implementation, and handover</li>
              <li><span>→</span> Technical advisory, speaking, and workshops</li>
            </ul>
          </div>

          <div class="brief-section">
            <p class="aside-label">What happens next</p>
            <p>I review messages personally. Response timing depends on current commitments, so include any real deadline. If there is a fit, we’ll clarify scope, useful outcomes, and next steps before agreeing on an engagement.</p>
            <a class="engagement-link" href="/work#engagements">Explore ways to work together →</a>
          </div>

          <div class="brief-section quiet-route">
            <p class="aside-label">Email or connect directly</p>
            <div class="route-links">
              <a href="https://www.linkedin.com/in/karansmittal/" target="_blank" rel="noopener" class="route-link">
                <span>Connect on LinkedIn</span>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
              <a href={`mailto:${SITE.email}?subject=Systems%20Engineering%20Inquiry`} class="route-link">
                <span>{SITE.email}</span>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>
      </aside>

      <section class="form-panel" aria-label="Engineering conversation form">
        <div class="form-panel-head">
          <div class="form-badge-row">
            <span class="pill-badge">Start a conversation</span>
          </div>
          <p>Use the form below or send an email. A high-level description is enough for the first conversation. The embedded form is provided by Tally under its <a href="https://tally.so/help/privacy-policy" target="_blank" rel="noopener">privacy notice</a>; do not include credentials, private keys, or regulated personal data.</p>
        </div>

        <div class="iframe-container" id="tally-container">
          <div class="form-skeleton" id="form-skeleton" role="status" aria-live="polite">
            <div class="skeleton-header">
              <span class="skeleton-pill"></span>
              <span class="skeleton-status">Loading contact form…</span>
            </div>
            <div class="skeleton-line full"></div>
            <div class="skeleton-line half"></div>
            <div class="skeleton-box"></div>
            <div class="skeleton-button"></div>
          </div>
          <iframe
            id="tally-iframe"
            data-tally-src={tallyEmbedUrl}
            loading="lazy"
            width="100%"
            height="320"
            frameborder="0"
            marginheight="0"
            marginwidth="0"
            title="Start an engineering conversation with Karan Mittal"
          ></iframe>
          <p id="form-error" class="form-error" role="alert" hidden>
            The intake form could not be loaded. <a href="https://tally.so/r/jar8jY" target="_blank" rel="noopener">Open it directly on Tally</a> or <a href={`mailto:${SITE.email}?subject=Systems%20Engineering%20Inquiry`}>send the project brief by email</a>.
          </p>
          <noscript>
            <p class="form-fallback">
              This form needs JavaScript to load. <a href={`mailto:${SITE.email}?subject=Systems%20Engineering%20Inquiry`}>Send the project brief by email instead</a>.
            </p>
          </noscript>
        </div>
      </section>
    </div>

    <script is:inline>
      var documentRef = document;
      var frame = documentRef.getElementById('tally-iframe');
      var skeleton = documentRef.getElementById('form-skeleton');
      var formError = documentRef.getElementById('form-error');
      var tallyScript = 'https://tally.so/widgets/embed.js';
      var completed = false;
      var markLoaded = function () {
        if (!frame || !frame.getAttribute('src') || frame.getAttribute('src') === 'about:blank') return;
        completed = true;
        skeleton && skeleton.classList.add('loaded');
      };
      var showFallback = function () {
        if (completed) return;
        skeleton && skeleton.classList.add('loaded');
        formError && formError.removeAttribute('hidden');
      };
      frame && frame.addEventListener('load', markLoaded);
      frame && frame.addEventListener('error', showFallback);
      var loadTallyEmbeds = function () {
        if (typeof Tally !== 'undefined') {
          Tally.loadEmbeds();
          return;
        }
        documentRef.querySelectorAll('iframe[data-tally-src]:not([src])').forEach(function (iframe) {
          iframe.src = iframe.dataset.tallySrc;
        });
      };

      window.setTimeout(showFallback, 12000);

      if (typeof Tally !== 'undefined') {
        loadTallyEmbeds();
      } else if (documentRef.querySelector('script[src="' + tallyScript + '"]') === null) {
        var script = documentRef.createElement('script');
        script.src = tallyScript;
        script.onload = loadTallyEmbeds;
        script.onerror = function () { loadTallyEmbeds(); window.setTimeout(showFallback, 3000); };
        documentRef.body.appendChild(script);
      }
    </script>
  </main>
</Layout>

<style>
  .contact-page {
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }

  .contact-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .email-action {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.65rem 1.15rem;
    border: 1px solid var(--ie-ink);
    background: var(--ie-ink);
    color: var(--ie-canvas);
    border-radius: var(--radius, 4px);
    font-family: var(--font-sans);
    font-size: var(--ie-type-ui);
    font-weight: 500;
    text-decoration: none;
    transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease;
  }
  .email-action:hover {
    border-color: var(--ie-blue);
    background: var(--ie-blue);
    color: var(--ie-surface);
  }
  #tally-container { scroll-margin-top: 5rem; }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .contact-aside {
    display: block;
  }

  .aside-brief-card {
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 8px);
    background: var(--ie-surface);
    overflow: hidden;
  }

  .brief-section {
    padding: 1.25rem 1.4rem;
    border-bottom: 1px solid var(--ie-rule);
  }

  .brief-section:last-child {
    border-bottom: 0;
  }

  .engagement-link {
    display: inline-block;
    margin-top: 0.8rem;
    font-family: var(--font-sans);
    font-size: var(--ie-type-ui);
    font-weight: 500;
  }

  .aside-label {
    margin: 0 0 0.65rem;
    color: var(--ie-blue);
    font-family: var(--font-sans);
    font-size: var(--ie-type-label);
    font-weight: 600;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .brief-section p:not(.aside-label) {
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-ui);
    line-height: 1.6;
  }

  .aside-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .aside-list li {
    display: flex;
    gap: 0.5rem;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-ui);
    line-height: 1.5;
  }

  .aside-list li span {
    color: var(--ie-blue);
    font-weight: 600;
  }

  .route-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .route-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    min-height: 44px;
    overflow-wrap: anywhere;
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius, 6px);
    background: var(--ie-surface-raised);
    color: var(--ie-ink);
    font-family: var(--font-sans);
    font-size: var(--ie-type-ui);
    text-decoration: none;
    transition: border-color 120ms ease, color 120ms ease, background-color 120ms ease;
  }

  .route-link:hover {
    border-color: var(--ie-blue);
    background: var(--ie-blue-soft);
    color: var(--ie-blue);
  }

  .route-link .arrow {
    color: var(--ie-muted);
  }

  .form-panel {
    min-height: 540px;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 8px);
    background: var(--ie-surface);
  }

  .form-panel-head {
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--ie-rule);
  }

  .form-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .pill-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill, 999px);
    background: var(--ie-blue-soft);
    color: var(--ie-blue);
    font-family: var(--font-sans);
    font-size: var(--ie-type-micro);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .security-note {
    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
  }

  .form-panel-head p {
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-ui);
    line-height: 1.55;
  }

  .iframe-container {
    background: var(--ie-embed-surface);
    border-radius: var(--radius, 6px);
    position: relative;
    width: 100%;
    min-height: 380px;
  }

  .form-skeleton {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius, 6px);
    transition: opacity 280ms ease, visibility 280ms ease;
  }

  .form-skeleton.loaded {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .skeleton-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .skeleton-pill {
    width: 60px;
    height: 18px;
    border-radius: var(--radius-pill, 999px);
    background: var(--ie-blue-soft);
    animation: shimmer 1.8s infinite ease-in-out;
  }

  .skeleton-status {
    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    letter-spacing: 0.06em;
  }

  .skeleton-line {
    height: 12px;
    border-radius: 4px;
    background: var(--ie-surface-raised);
    border: 1px solid var(--ie-rule);
    animation: shimmer 1.8s infinite ease-in-out;
  }

  .skeleton-line.full { width: 100%; }
  .skeleton-line.half { width: 60%; }

  .skeleton-box {
    height: 120px;
    border-radius: var(--radius, 6px);
    background: var(--ie-surface-raised);
    border: 1px solid var(--ie-rule);
    margin-top: 0.5rem;
    animation: shimmer 1.8s infinite ease-in-out;
  }

  .skeleton-button {
    width: 130px;
    height: 36px;
    border-radius: var(--radius, 6px);
    background: var(--ie-surface-raised);
    border: 1px solid var(--ie-rule);
    animation: shimmer 1.8s infinite ease-in-out;
  }

  @keyframes shimmer {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }

  .iframe-container iframe {
    background: var(--ie-embed-surface);
    color-scheme: light;
    display: block;
    width: 100%;
    border: 0;
    border-radius: var(--radius, 6px);
  }

  .form-error,
  .form-fallback {
    margin: 1rem 0 0;
    padding: 0.8rem 1rem;
    border-left: 2px solid var(--ie-rust);
    background: var(--ie-rust-soft);
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-ui);
    line-height: 1.5;
  }

  .form-error a,
  .form-fallback a {
    color: var(--ie-blue);
    font-weight: 600;
  }

  @media (max-width: 840px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
