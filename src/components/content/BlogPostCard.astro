---
/**
 * One essay row, in the same shape as the rows on /publications/: date and
 * reading time first, then the title (the link), then the description.
 */
import type { CollectionEntry } from 'astro:content';
import AccentTitle from './AccentTitle.astro';
import { formatDate } from '@utils/date';
import { getReadingTime } from '../../utils/readingTime';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const readingTime = getReadingTime(post.body);
---

<li class="post-card">
  <p class="post-meta">
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    <span aria-hidden="true" class="meta-sep">·</span>
    <span>{readingTime} min read</span>
  </p>
  <h3 class="post-title">
    <a href={`/writing/${post.id}/`}><AccentTitle title={post.data.title} /></a>
  </h3>
  <p class="post-description">{post.data.description}</p>
</li>

<style>
  .post-card {
    margin: 0;
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--ie-rule);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin: 0 0 0.5rem;
    color: var(--ie-muted);
    font-size: var(--ie-type-small);
  }

  .post-meta time {
    font-family: var(--font-mono);
    font-size: var(--ie-type-caption);
  }

  .meta-sep {
    color: var(--ie-rule-strong);
  }

  .post-title {
    max-width: 40ch;
    margin: 0 0 0.5rem;
    font-size: var(--ie-type-h3);
    line-height: 1.28;
    letter-spacing: -0.015em;
  }

  .post-title a {
    color: var(--ie-ink);
  }

  .post-title a:hover {
    color: var(--ie-blue);
  }

  .post-description {
    max-width: 68ch;
    margin: 0;
    color: var(--ie-ink-secondary);
  }
</style>
