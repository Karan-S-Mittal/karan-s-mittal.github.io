---
/**
 * CiechanowskiGPUMemoryCanvas.astro
 * Branch Education-grade 3D WebGL Silicon DRAM & PagedAttention Interactive Engine.
 * Built on Three.js with metallic PBR materials (copper sheen, polysilicon gates, translucent capacitor trenches,
 * 3D glowing electron particle physics, and smooth 3D camera zoom orbits).
 */
---

<section class="branch-3d-scrolly-section" data-branch-3d aria-labelledby="gpu-canvas-title">
  <!-- Section Header -->
  <div class="canvas-header-shell">
    <div class="canvas-kicker">
      <span class="live-dot"></span>
      <span>01 / Flagship 3D Hardware Instrument &middot; Silicon Microarchitecture to KV Cache</span>
    </div>
    <h2 id="gpu-canvas-title">How RAM &amp; GPU Memory Work: The 3D Silicon Machine</h2>
    <p class="canvas-lead-text">
      Explore the multi-scale physics of memory in full 3D: rotate and inspect a microscopic 1T1C transistor and capacitor with metallic copper sheen and glowing electron particles, pull back to the 8&times;8 silicon crossbar die, and zoom out to the GPU memory wall.
    </p>
  </div>

  <!-- Multi-Scale 3D Camera Zoom Selector -->
  <div class="scale-selector-bar" role="tablist" aria-label="3D Silicon Zoom Scale">
    <button type="button" role="tab" class="scale-tab active" data-scale="0" aria-selected="true">
      <span class="scale-badge">SCALE 01 / 3D MICROSCOPIC</span>
      <strong>3D 1T1C Silicon Cell</strong>
      <small>Copper Bitline &middot; MOSFET Gate &middot; Glowing Capacitor Trench</small>
    </button>
    <button type="button" role="tab" class="scale-tab" data-scale="1" aria-selected="false">
      <span class="scale-badge">SCALE 02 / 3D SILICON DIE</span>
      <strong>8&times;8 Crossbar Array</strong>
      <small>64 Pillar Capacitors &middot; Wordline Decoders &middot; Sense Amps</small>
    </button>
    <button type="button" role="tab" class="scale-tab" data-scale="2" aria-selected="false">
      <span class="scale-badge">SCALE 03 / SYSTEM ARCHITECTURE</span>
      <strong>GPU VRAM &amp; PagedAttention</strong>
      <small>HBM3 DRAM Bank &middot; Virtual Paging &middot; Zero Fragmentation</small>
    </button>
  </div>

  <!-- 3D Stage & Narrative Grid -->
  <div class="scrolly-stage-grid">
    <!-- STICKY 3D WEBGL VIEWPORT -->
    <div class="sticky-3d-container">
      <div class="webgl-frame" data-webgl-frame>
        <!-- Top HUD Bar -->
        <div class="canvas-hud-bar">
          <div class="hud-left">
            <span class="hud-chip" data-hud-chip>3D SILICON: 1T1C CELL (14nm FINFET &amp; DEEP TRENCH)</span>
            <span class="hud-freq">CLOCK: 1980 MHz</span>
          </div>
          <div class="hud-right">
            <span class="hud-mode" data-hud-mode>GATE: NMOS CONDUCTING (1.2V)</span>
            <span class="hud-phase" data-hud-electrons>3D ELECTRONS: 42 e⁻ ACTIVE</span>
          </div>
        </div>

        <!-- Three.js WebGL Mount Container -->
        <div class="three-mount-area" data-three-mount>
          <div class="orbit-hint-overlay">
            <span>&olarr; Drag in 3D to rotate perspective &middot; Scroll to zoom scale</span>
          </div>
        </div>

        <!-- Contextual Direct Controls Plane -->
        <div class="canvas-controls-bar">
          <!-- Scale 1: 1T1C Physics Controls -->
          <div class="control-view-panel" data-ctrl-scale="0">
            <div class="btn-group">
              <button type="button" class="sim-btn primary" data-act-write1>
                ⚡ Write '1' (Charge 3D Trench)
              </button>
              <button type="button" class="sim-btn secondary" data-act-write0>
                ⚡ Write '0' (Discharge)
              </button>
              <button type="button" class="sim-btn secondary" data-act-read>
                🔍 Read &amp; Sense
              </button>
              <button type="button" class="sim-btn tertiary" data-act-leak>
                ⏳ Leak Electrons
              </button>
            </div>
            <div class="slider-group">
              <label for="gate-v-slider">Wordline Gate Voltage (V<sub>WL</sub>): <strong data-v-val>1.2V</strong></label>
              <input
                id="gate-v-slider"
                type="range"
                min="0"
                max="1.2"
                step="0.05"
                value="1.2"
                class="voltage-slider"
                data-gate-slider
              />
            </div>
          </div>

          <!-- Scale 2: Crossbar Array Controls -->
          <div class="control-view-panel hidden" data-ctrl-scale="1">
            <div class="btn-group">
              <button type="button" class="sim-btn primary" data-act-strobe>
                ⚡ Strobe Wordline Row
              </button>
              <button type="button" class="sim-btn secondary" data-act-next-addr>
                Next Wordline Rail (+0x08)
              </button>
            </div>
            <div class="hud-meta-badge">
              <span>ACTIVE 3D RAIL: <strong data-matrix-addr>WORDLINE #3 (ADDR 0x18)</strong></span>
            </div>
          </div>

          <!-- Scale 3: PagedAttention Controls -->
          <div class="control-view-panel hidden" data-ctrl-scale="2">
            <div class="btn-group">
              <button type="button" class="sim-btn primary" data-act-toggle-paged>
                ⇄ Toggle: PagedAttention vs Naive
              </button>
              <button type="button" class="sim-btn secondary" data-act-step-tokens>
                + Step Token Batch (+16 Tokens)
              </button>
            </div>
            <div class="hud-meta-badge">
              <span>ALLOCATION: <strong data-paged-mode-text>PagedAttention (Virtual Paging)</strong></span>
            </div>
          </div>
        </div>
      </div>
      <p class="canvas-caption-note">
        <em>Branch Education Standard:</em> Rendered in real-time WebGL with metallic PBR shaders (copper sheen, polysilicon gates, translucent dielectric capacitor cylinders, and simulated glowing electron particles).
      </p>
    </div>

    <!-- NARRATIVE CHAPTERS -->
    <div class="scrolly-narrative-track">
      <!-- CHAPTER 1 -->
      <article class="narrative-chapter active" data-chapter="0">
        <div class="chapter-register">
          <span class="chapter-num">01.01</span>
          <span class="chapter-label">3D MICROSCOPIC SILICON</span>
        </div>
        <h3>The 1T1C Memory Cell: 1 Transistor, 1 Capacitor</h3>
        <p>
          At the silicon scale, every bit of dynamic RAM consists of a single <strong>NMOS access transistor</strong> and a <strong>vertical deep trench capacitor</strong>:
        </p>
        <ol class="chapter-list">
          <li><strong>The Metallic Copper Bitline (Left)</strong>: Carries data into and out of the cell.</li>
          <li><strong>The Polysilicon Wordline Gate (Top)</strong>: Applying 1.2V creates an electric field that turns ON the conductive channel underneath the gate oxide.</li>
          <li><strong>The Deep Trench Capacitor (Right)</strong>: A 3D cylindrical container etched into silicon that holds a tiny packet of glowing electrons. Charge = 1; discharged = 0.</li>
        </ol>
        <p class="chapter-instruction">&darr; Scroll to pull back the 3D camera into the 8&times;8 Crossbar Array...</p>
      </article>

      <!-- CHAPTER 2 -->
      <article class="narrative-chapter" data-chapter="1">
        <div class="chapter-register alert">
          <span class="chapter-num">01.02</span>
          <span class="chapter-label">3D SILICON CROSSBAR DIE</span>
        </div>
        <h3>The 64-Pillar Crossbar Array</h3>
        <p>
          Individual 1T1C cells are arranged in a 2D matrix of horizontal <strong>Wordlines</strong> (Rows) and vertical <strong>Bitlines</strong> (Columns).
        </p>
        <p>
          When an address is decoded:
        </p>
        <ul class="chapter-list">
          <li>The <strong>Row Decoder</strong> energizes a single horizontal copper Wordline rail across the die.</li>
          <li>All 8 transistor gates on that row turn ON in parallel.</li>
          <li>The 8 cylindrical capacitors dump their electron charge onto the vertical Bitlines, latched by the Sense Amplifiers at the bottom edge.</li>
        </ul>
        <p class="chapter-instruction">&darr; Scroll to zoom to the GPU Memory Wall &amp; PagedAttention...</p>
      </article>

      <!-- CHAPTER 3 -->
      <article class="narrative-chapter" data-chapter="2">
        <div class="chapter-register solution">
          <span class="chapter-num">01.03</span>
          <span class="chapter-label">GPU MEMORY &amp; KV CACHE</span>
        </div>
        <h3>The Memory Wall: Contiguous vs. PagedAttention</h3>
        <p>
          In GPU LLM serving, millions of DRAM cells form <strong>16-token page frames</strong> that store the Key-Value (KV) cache.
        </p>
        <p>
          <strong>Naive Contiguous Allocation</strong> pre-reserves fixed blocks for the maximum context window (e.g. 128 tokens), leaving up to <strong>78% of VRAM wasted as idle internal fragmentation</strong> and triggering premature Out-of-Memory faults.
        </p>
        <p>
          <strong>PagedAttention</strong> adapts OS virtual memory paging, dynamically assigning non-contiguous 16-token physical frames on demand via a Virtual Block Table—slashing waste to <strong>&lt; 4%</strong> and unlocking <strong>3.8&times; serving throughput</strong>.
        </p>
      </article>
    </div>
  </div>
</section>

<script>
  import * as THREE from 'three';

  function initBranch3D() {
    document.querySelectorAll<HTMLElement>('[data-branch-3d]').forEach((root) => {
      const mount = root.querySelector<HTMLElement>('[data-three-mount]');
      if (!mount) return;

      const scaleTabs = root.querySelectorAll<HTMLButtonElement>('.scale-tab');
      const chapters = root.querySelectorAll<HTMLElement>('.narrative-chapter');
      const hudChip = root.querySelector<HTMLElement>('[data-hud-chip]');
      const hudMode = root.querySelector<HTMLElement>('[data-hud-mode]');
      const hudElectrons = root.querySelector<HTMLElement>('[data-hud-electrons]');
      const ctrlPanels = root.querySelectorAll<HTMLElement>('[data-ctrl-scale]');

      // Buttons
      const btnWrite1 = root.querySelector<HTMLButtonElement>('[data-act-write1]');
      const btnWrite0 = root.querySelector<HTMLButtonElement>('[data-act-write0]');
      const btnRead = root.querySelector<HTMLButtonElement>('[data-act-read]');
      const btnLeak = root.querySelector<HTMLButtonElement>('[data-act-leak]');
      const gateSlider = root.querySelector<HTMLInputElement>('[data-gate-slider]');
      const vValText = root.querySelector<HTMLElement>('[data-v-val]');

      const btnStrobe = root.querySelector<HTMLButtonElement>('[data-act-strobe]');
      const btnNextAddr = root.querySelector<HTMLButtonElement>('[data-act-next-addr]');
      const matrixAddrText = root.querySelector<HTMLElement>('[data-matrix-addr]');

      const btnTogglePaged = root.querySelector<HTMLButtonElement>('[data-act-toggle-paged]');
      const btnStepTokens = root.querySelector<HTMLButtonElement>('[data-act-step-tokens]');
      const pagedModeText = root.querySelector<HTMLElement>('[data-paged-mode-text]');

      // 3D Scene Setup
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(45, mount.clientWidth / mount.clientHeight, 0.1, 1000);
      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'high-performance' });
      renderer.setSize(mount.clientWidth, mount.clientHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.1;
      mount.appendChild(renderer.domElement);

      // Lighting with Metallic PBR Highlights
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
      scene.add(ambientLight);

      const dirLight = new THREE.DirectionalLight(0xffffff, 2.4);
      dirLight.position.set(20, 35, 25);
      scene.add(dirLight);

      const fillLight = new THREE.DirectionalLight(0x8daaff, 1.2);
      fillLight.position.set(-20, -10, -15);
      scene.add(fillLight);

      // Glowing Point Light inside the Capacitor Trench
      const capPointLight = new THREE.PointLight(0x38bdf8, 4.5, 30);
      capPointLight.position.set(4.5, 2.5, 0);
      scene.add(capPointLight);

      const gatePointLight = new THREE.PointLight(0x2857d9, 2.5, 20);
      gatePointLight.position.set(-1.25, 3.0, 0);
      scene.add(gatePointLight);

      // Materials (Metallic PBR & Sheen)
      const copperMat = new THREE.MeshStandardMaterial({
        color: 0xb87333,
        metalness: 0.96,
        roughness: 0.14,
      });

      const goldMat = new THREE.MeshStandardMaterial({
        color: 0xf59e0b,
        metalness: 0.98,
        roughness: 0.12,
      });

      const gateMat = new THREE.MeshStandardMaterial({
        color: 0x2857d9,
        metalness: 0.88,
        roughness: 0.18,
        emissive: 0x1d4ed8,
        emissiveIntensity: 0.45,
      });

      const siliconMat = new THREE.MeshStandardMaterial({
        color: 0x0f172a,
        metalness: 0.65,
        roughness: 0.35,
      });

      const dopedSiliconMat = new THREE.MeshStandardMaterial({
        color: 0x334155,
        metalness: 0.8,
        roughness: 0.2,
      });

      const glassCapMat = new THREE.MeshPhysicalMaterial({
        color: 0xa5f3fc,
        transparent: true,
        opacity: 0.55,
        roughness: 0.08,
        metalness: 0.15,
        transmission: 0.75,
        ior: 1.5,
      });

      const electronMat = new THREE.MeshStandardMaterial({
        color: 0x38bdf8,
        emissive: 0x0284c7,
        emissiveIntensity: 2.2,
        roughness: 0.1,
      });

      // Helper to generate crisp 3D Canvas Text Sprites
      function createTextSprite(text: string, bgColor = 'rgba(23, 26, 31, 0.85)', textColor = '#38bdf8') {
        const sprCanvas = document.createElement('canvas');
        sprCanvas.width = 512;
        sprCanvas.height = 128;
        const sprCtx = sprCanvas.getContext('2d')!;

        sprCtx.fillStyle = bgColor;
        sprCtx.roundRect(10, 10, 492, 108, 16);
        sprCtx.fill();
        sprCtx.strokeStyle = textColor;
        sprCtx.lineWidth = 4;
        sprCtx.stroke();

        sprCtx.font = '700 28px IBM Plex Mono, monospace';
        sprCtx.fillStyle = '#FFFFFF';
        sprCtx.textAlign = 'center';
        sprCtx.textBaseline = 'middle';
        sprCtx.fillText(text, 256, 64);

        const tex = new THREE.CanvasTexture(sprCanvas);
        tex.minFilter = THREE.LinearFilter;
        const sprMat = new THREE.SpriteMaterial({ map: tex, transparent: true });
        const sprite = new THREE.Sprite(sprMat);
        sprite.scale.set(4.5, 1.15, 1);
        return sprite;
      }

      // ----------------------------------------------------
      // BUILD 3D SCALE 1: MICROSCOPIC 1T1C CELL
      // ----------------------------------------------------
      const group1T1C = new THREE.Group();
      scene.add(group1T1C);

      // 1. Silicon Substrate Block
      const subGeom = new THREE.BoxGeometry(16, 2.5, 8);
      const subMesh = new THREE.Mesh(subGeom, siliconMat);
      subMesh.position.set(0, -1.25, 0);
      group1T1C.add(subMesh);

      // 2. N+ Doped Source (Left)
      const sourceGeom = new THREE.BoxGeometry(3, 1.5, 5);
      const sourceMesh = new THREE.Mesh(sourceGeom, dopedSiliconMat);
      sourceMesh.position.set(-4, 0.75, 0);
      group1T1C.add(sourceMesh);

      // 3. N+ Doped Drain (Right)
      const drainGeom = new THREE.BoxGeometry(3, 1.5, 5);
      const drainMesh = new THREE.Mesh(drainGeom, dopedSiliconMat);
      drainMesh.position.set(1.5, 0.75, 0);
      group1T1C.add(drainMesh);

      // 4. Inversion Channel (Active Cyan Conduction Layer)
      const chanGeom = new THREE.BoxGeometry(3, 0.35, 4.5);
      const chanMat = new THREE.MeshStandardMaterial({
        color: 0x38bdf8,
        emissive: 0x0284c7,
        emissiveIntensity: 1.2,
        transparent: true,
        opacity: 0.9,
      });
      const chanMesh = new THREE.Mesh(chanGeom, chanMat);
      chanMesh.position.set(-1.25, 0.18, 0);
      group1T1C.add(chanMesh);

      // 5. Polysilicon Wordline Gate & Gold Pad
      const gateGeom = new THREE.BoxGeometry(3.2, 1.8, 5.5);
      const gateMesh = new THREE.Mesh(gateGeom, gateMat);
      gateMesh.position.set(-1.25, 2.2, 0);
      group1T1C.add(gateMesh);

      const gateGoldPad = new THREE.Mesh(new THREE.BoxGeometry(2.4, 0.3, 4.5), goldMat);
      gateGoldPad.position.set(-1.25, 3.15, 0);
      group1T1C.add(gateGoldPad);

      // 6. Vertical Metallic Copper Bitline Rail (Left)
      const bitlineGeom = new THREE.BoxGeometry(1.2, 10, 1.2);
      const bitlineMesh = new THREE.Mesh(bitlineGeom, copperMat);
      bitlineMesh.position.set(-5.5, 4.0, 0);
      group1T1C.add(bitlineMesh);

      // Copper Interconnect Bridge to Source
      const bridgeGeom = new THREE.BoxGeometry(2.0, 0.6, 1.2);
      const bridgeMesh = new THREE.Mesh(bridgeGeom, copperMat);
      bridgeMesh.position.set(-4.5, 1.5, 0);
      group1T1C.add(bridgeMesh);

      // 7. 3D Deep Trench Capacitor (Translucent Cylinder on Right)
      const capOuterGeom = new THREE.CylinderGeometry(1.8, 1.8, 7.5, 32, 1, true);
      const capOuterMesh = new THREE.Mesh(capOuterGeom, glassCapMat);
      capOuterMesh.position.set(4.5, 2.75, 0);
      group1T1C.add(capOuterMesh);

      // Metallic Copper Rim at Top of Trench
      const capRimGeom = new THREE.TorusGeometry(1.8, 0.15, 16, 32);
      const capRimMesh = new THREE.Mesh(capRimGeom, copperMat);
      capRimMesh.rotation.x = Math.PI / 2;
      capRimMesh.position.set(4.5, 6.5, 0);
      group1T1C.add(capRimMesh);

      const capInnerGeom = new THREE.CylinderGeometry(1.4, 1.4, 6.8, 32);
      const capInnerMat = new THREE.MeshStandardMaterial({
        color: 0x0284c7,
        emissive: 0x0369a1,
        emissiveIntensity: 0.6,
        transparent: true,
        opacity: 0.45,
      });
      const capInnerMesh = new THREE.Mesh(capInnerGeom, capInnerMat);
      capInnerMesh.position.set(4.5, 2.75, 0);
      group1T1C.add(capInnerMesh);

      // Conductor trace from N+ Drain to Capacitor
      const drainCapBridge = new THREE.Mesh(new THREE.BoxGeometry(2.0, 0.6, 1.2), copperMat);
      drainCapBridge.position.set(3.0, 1.5, 0);
      group1T1C.add(drainCapBridge);

      // 8. 3D Sprites Labels in World Space
      const sprBitline = createTextSprite('BITLINE (COPPER)', 'rgba(15, 23, 42, 0.9)', '#f97316');
      sprBitline.position.set(-5.5, 9.8, 0);
      group1T1C.add(sprBitline);

      const sprGate = createTextSprite('WORDLINE GATE (1.2V)', 'rgba(15, 23, 42, 0.9)', '#38bdf8');
      sprGate.position.set(-1.25, 4.2, 0);
      group1T1C.add(sprGate);

      const sprCap = createTextSprite('DEEP TRENCH CAPACITOR', 'rgba(15, 23, 42, 0.9)', '#38bdf8');
      sprCap.position.set(4.5, 7.5, 0);
      group1T1C.add(sprCap);

      // 9. Kinetic 3D Electron Spheres
      const electronSpheres: { mesh: THREE.Mesh; vx: number; vy: number; vz: number }[] = [];
      const sphereGeom = new THREE.SphereGeometry(0.18, 16, 16);

      for (let i = 0; i < 42; i++) {
        const mesh = new THREE.Mesh(sphereGeom, electronMat);
        mesh.position.set(
          4.5 + (Math.random() * 2.0 - 1.0),
          1.0 + Math.random() * 4.5,
          (Math.random() * 2.0 - 1.0)
        );
        group1T1C.add(mesh);
        electronSpheres.push({
          mesh,
          vx: (Math.random() - 0.5) * 0.05,
          vy: (Math.random() - 0.5) * 0.05,
          vz: (Math.random() - 0.5) * 0.05,
        });
      }

      // ----------------------------------------------------
      // BUILD 3D SCALE 2: 8×8 CROSSBAR MATRIX DIE
      // ----------------------------------------------------
      const groupMatrix = new THREE.Group();
      groupMatrix.position.set(0, 0, 0);
      scene.add(groupMatrix);

      // 64 Pillar Capacitors and 8 Wordline Copper Rails
      const matrixCapacitors: THREE.Mesh[] = [];
      const matrixWordlines: THREE.Mesh[] = [];

      const gridSpacing = 2.2;
      const startX = -((7 * gridSpacing) / 2);
      const startZ = -((7 * gridSpacing) / 2);

      // Silicon Die Base Plate
      const dieBaseGeom = new THREE.BoxGeometry(22, 1.5, 22);
      const dieBaseMesh = new THREE.Mesh(dieBaseGeom, siliconMat);
      dieBaseMesh.position.set(0, -0.75, 0);
      groupMatrix.add(dieBaseMesh);

      // 8 Horizontal Wordline Metallic Rails
      for (let r = 0; r < 8; r++) {
        const wlGeom = new THREE.BoxGeometry(20, 0.4, 0.6);
        const wlMesh = new THREE.Mesh(wlGeom, r === 3 ? gateMat : copperMat);
        wlMesh.position.set(0, 1.8, startZ + r * gridSpacing);
        groupMatrix.add(wlMesh);
        matrixWordlines.push(wlMesh);
      }

      // 8 Vertical Bitline Metallic Rails (Underneath)
      for (let c = 0; c < 8; c++) {
        const blGeom = new THREE.BoxGeometry(0.6, 0.4, 20);
        const blMesh = new THREE.Mesh(blGeom, copperMat);
        blMesh.position.set(startX + c * gridSpacing, 0.6, 0);
        groupMatrix.add(blMesh);
      }

      // 64 Deep Trench Pillars
      const pillarGeom = new THREE.CylinderGeometry(0.45, 0.45, 3.2, 16);
      for (let r = 0; r < 8; r++) {
        for (let c = 0; c < 8; c++) {
          const isRow3 = r === 3;
          const pMat = new THREE.MeshStandardMaterial({
            color: isRow3 ? 0x38bdf8 : 0x0284c7,
            emissive: isRow3 ? 0x0284c7 : 0x000000,
            emissiveIntensity: isRow3 ? 0.8 : 0,
            metalness: 0.8,
            roughness: 0.2,
          });
          const pillar = new THREE.Mesh(pillarGeom, pMat);
          pillar.position.set(startX + c * gridSpacing, 1.6, startZ + r * gridSpacing);
          groupMatrix.add(pillar);
          matrixCapacitors.push(pillar);
        }
      }

      // ----------------------------------------------------
      // BUILD 3D SCALE 3: GPU HBM3 STACKED DRAM PACKAGE
      // ----------------------------------------------------
      const groupScale3 = new THREE.Group();
      scene.add(groupScale3);

      // 1. Silicon Interposer Substrate
      const interposerGeom = new THREE.BoxGeometry(26, 1.2, 26);
      const interposerMesh = new THREE.Mesh(interposerGeom, siliconMat);
      interposerMesh.position.set(0, -2.0, 0);
      groupScale3.add(interposerMesh);

      // 2. 4 Stacked 3D DRAM Dies with Metallic Gold TSVs
      const dramDieMeshes: THREE.Mesh[] = [];
      for (let d = 0; d < 4; d++) {
        const dieGeom = new THREE.BoxGeometry(22, 0.7, 22);
        const dieMat = new THREE.MeshStandardMaterial({
          color: d === 3 ? 0x1e293b : 0x0f172a,
          metalness: 0.85,
          roughness: 0.22,
        });
        const dieMesh = new THREE.Mesh(dieGeom, dieMat);
        dieMesh.position.set(0, -1.0 + d * 1.4, 0);
        groupScale3.add(dieMesh);
        dramDieMeshes.push(dieMesh);

        // Gold TSV Microbumps between stacked dies
        if (d < 3) {
          for (let bx = -8; bx <= 8; bx += 8) {
            for (let bz = -8; bz <= 8; bz += 8) {
              const tsv = new THREE.Mesh(new THREE.CylinderGeometry(0.35, 0.35, 0.7, 12), goldMat);
              tsv.position.set(bx, -0.3 + d * 1.4, bz);
              groupScale3.add(tsv);
            }
          }
        }
      }

      // 3. 64 3D Memory Page Frames on Top Die
      const scale3Tiles: THREE.Mesh[] = [];
      const tileSpacing = 2.4;
      const tStartX = -((7 * tileSpacing) / 2);
      const tStartZ = -((7 * tileSpacing) / 2);

      for (let r = 0; r < 8; r++) {
        for (let c = 0; c < 8; c++) {
          const idx = r * 8 + c;
          const tGeom = new THREE.BoxGeometry(2.0, 0.2, 2.0);
          const tMat = new THREE.MeshStandardMaterial({
            color: 0x334155,
            metalness: 0.8,
            roughness: 0.2,
          });
          const tile = new THREE.Mesh(tGeom, tMat);
          tile.position.set(tStartX + c * tileSpacing, 3.6, tStartZ + r * tileSpacing);
          groupScale3.add(tile);
          scale3Tiles.push(tile);
        }
      }

      // 4. 3D Sprites for Scale 3
      const sprHbm = createTextSprite('GPU HBM3 STACKED VRAM (819 GB/s)', 'rgba(15, 23, 42, 0.9)', '#38bdf8');
      sprHbm.position.set(0, 7.5, 0);
      groupScale3.add(sprHbm);

      function updateScale3Colors() {
        scale3Tiles.forEach((tile, idx) => {
          const mat = tile.material as THREE.MeshStandardMaterial;
          if (isPagedMode) {
            // PagedAttention: dynamic packed virtual allocation
            const pagedMap: { [key: number]: number } = {
              4: 0x2857d9, 19: 0x2857d9, 33: 0x2857d9, 52: 0x2857d9,
              2: 0x0d9488, 45: 0x0d9488, 11: 0x0d9488,
              12: 0x6366f1, 28: 0x6366f1,
              58: 0x9333ea, 23: 0x9333ea,
            };
            if (pagedMap[idx]) {
              mat.color.setHex(pagedMap[idx]);
              mat.emissive.setHex(pagedMap[idx]);
              mat.emissiveIntensity = 0.6;
            } else {
              mat.color.setHex(0x334155);
              mat.emissive.setHex(0x000000);
              mat.emissiveIntensity = 0;
            }
          } else {
            // Naive Contiguous: 78% internal fragmentation waste in red
            if (idx < 8) {
              const isUsed = idx < 3;
              mat.color.setHex(isUsed ? 0x2857d9 : 0xa63d17);
              mat.emissive.setHex(isUsed ? 0x2857d9 : 0xa63d17);
              mat.emissiveIntensity = isUsed ? 0.6 : 0.3;
            } else if (idx < 16) {
              const isUsed = idx < 10;
              mat.color.setHex(isUsed ? 0x0d9488 : 0xa63d17);
              mat.emissive.setHex(isUsed ? 0x0d9488 : 0xa63d17);
              mat.emissiveIntensity = isUsed ? 0.6 : 0.3;
            } else if (idx < 24) {
              const isUsed = idx < 17;
              mat.color.setHex(isUsed ? 0x6366f1 : 0xa63d17);
              mat.emissive.setHex(isUsed ? 0x6366f1 : 0xa63d17);
              mat.emissiveIntensity = isUsed ? 0.6 : 0.3;
            } else {
              mat.color.setHex(0x334155);
              mat.emissive.setHex(0x000000);
              mat.emissiveIntensity = 0;
            }
          }
        });
      }
      updateScale3Colors();

      // ----------------------------------------------------
      // SCALE CAMERA & ANIMATION STATE
      // ----------------------------------------------------
      let targetScale = 0;
      let currentScale = 0;

      // Camera Target Positions per scale
      const cameraPositions = [
        new THREE.Vector3(0, 3.5, 14), // Scale 1: 1T1C Close-up
        new THREE.Vector3(0, 22, 26),  // Scale 2: 8x8 Matrix Isometric
        new THREE.Vector3(0, 26, 34),  // Scale 3: Macro GPU VRAM Bank
      ];
      const cameraLookAts = [
        new THREE.Vector3(0, 2, 0),
        new THREE.Vector3(0, 0, 0),
        new THREE.Vector3(0, 0, 0),
      ];

      camera.position.copy(cameraPositions[0]);
      camera.lookAt(cameraLookAts[0]);

      // State
      let gateVoltage = 1.2;
      let isPagedMode = true;
      let selectedRow = 3;

      // Orbit Drag Controls
      let isDragging = false;
      let prevMousePos = { x: 0, y: 0 };
      let orbitOffset = { theta: 0, phi: 0 };

      mount.addEventListener('mousedown', (e) => {
        isDragging = true;
        prevMousePos = { x: e.clientX, y: e.clientY };
      });

      window.addEventListener('mouseup', () => (isDragging = false));

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const deltaX = e.clientX - prevMousePos.x;
        const deltaY = e.clientY - prevMousePos.y;
        prevMousePos = { x: e.clientX, y: e.clientY };

        orbitOffset.theta -= deltaX * 0.006;
        orbitOffset.phi = Math.max(-0.5, Math.min(0.8, orbitOffset.phi + deltaY * 0.006));
      });

      // Scale Switcher Function
      function setScale(scaleIdx: number) {
        targetScale = scaleIdx;

        scaleTabs.forEach((tab, idx) => {
          const isActive = idx === scaleIdx;
          tab.classList.toggle('active', isActive);
          tab.setAttribute('aria-selected', String(isActive));
        });

        ctrlPanels.forEach((p) => {
          const s = parseInt(p.dataset.ctrlScale || '0', 10);
          p.classList.toggle('hidden', s !== scaleIdx);
        });

        if (hudChip) {
          if (scaleIdx === 0) hudChip.textContent = '3D SILICON: 1T1C CELL (14nm FINFET & DEEP TRENCH)';
          else if (scaleIdx === 1) hudChip.textContent = '3D SILICON: 8×8 CROSSBAR MATRIX DIE (64 BITS)';
          else hudChip.textContent = '3D SYSTEM: GPU HBM3 MEMORY & PAGEDATTENTION';
        }
      }

      scaleTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const s = parseInt(tab.dataset.scale || '0', 10);
          setScale(s);
        });
      });

      // Button Handlers
      if (btnWrite1) {
        btnWrite1.addEventListener('click', () => {
          gateVoltage = 1.2;
          if (gateSlider) gateSlider.value = '1.2';
          if (vValText) vValText.textContent = '1.2V';
          capPointLight.intensity = 4.0;
          chanMesh.visible = true;
        });
      }

      if (btnWrite0) {
        btnWrite0.addEventListener('click', () => {
          gateVoltage = 1.2;
          if (gateSlider) gateSlider.value = '1.2';
          if (vValText) vValText.textContent = '1.2V';
          capPointLight.intensity = 0.2;
          chanMesh.visible = true;
        });
      }

      if (btnRead) {
        btnRead.addEventListener('click', () => {
          gateVoltage = 1.2;
          capPointLight.intensity = 5.0;
          setTimeout(() => (capPointLight.intensity = 4.0), 600);
        });
      }

      if (btnLeak) {
        btnLeak.addEventListener('click', () => {
          gateVoltage = 0.0;
          if (gateSlider) gateSlider.value = '0.0';
          if (vValText) vValText.textContent = '0.0V';
          capPointLight.intensity = Math.max(0.2, capPointLight.intensity - 1.2);
          chanMesh.visible = false;
        });
      }

      if (gateSlider) {
        gateSlider.addEventListener('input', (e) => {
          gateVoltage = parseFloat((e.target as HTMLInputElement).value);
          if (vValText) vValText.textContent = `${gateVoltage.toFixed(2)}V`;
          chanMesh.visible = gateVoltage > 0.4;
          gateMesh.position.y = 2.2 - (1.2 - gateVoltage) * 0.3;
        });
      }

      if (btnStrobe) {
        btnStrobe.addEventListener('click', () => {
          selectedRow = (selectedRow + 1) % 8;
          if (matrixAddrText) matrixAddrText.textContent = `WORDLINE #${selectedRow} (ADDR 0x${(selectedRow * 8).toString(16).padStart(2, '0').toUpperCase()})`;
          matrixWordlines.forEach((wl, idx) => {
            (wl.material as THREE.MeshStandardMaterial).color.setHex(idx === selectedRow ? 0x2857d9 : 0xb87333);
          });
        });
      }

      if (btnNextAddr) {
        btnNextAddr.addEventListener('click', () => {
          selectedRow = (selectedRow + 1) % 8;
          if (matrixAddrText) matrixAddrText.textContent = `WORDLINE #${selectedRow} (ADDR 0x${(selectedRow * 8).toString(16).padStart(2, '0').toUpperCase()})`;
          matrixWordlines.forEach((wl, idx) => {
            (wl.material as THREE.MeshStandardMaterial).color.setHex(idx === selectedRow ? 0x2857d9 : 0xb87333);
          });
        });
      }

      if (btnTogglePaged) {
        btnTogglePaged.addEventListener('click', () => {
          isPagedMode = !isPagedMode;
          if (pagedModeText) {
            pagedModeText.textContent = isPagedMode ? 'PagedAttention (Virtual Paging)' : 'Naive Contiguous Pre-Reservation';
            pagedModeText.style.color = isPagedMode ? 'var(--ie-blue)' : 'var(--ie-rust)';
          }
          updateScale3Colors();
        });
      }

      // Scroll Observer
      function onScroll() {
        const sectionRect = root.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        const totalDist = sectionRect.height - windowHeight;
        if (totalDist <= 0) return;

        const currentScroll = -sectionRect.top;
        const progress = Math.max(0, Math.min(1, currentScroll / totalDist));

        if (progress < 0.33) {
          if (targetScale !== 0) setScale(0);
        } else if (progress < 0.66) {
          if (targetScale !== 1) setScale(1);
        } else {
          if (targetScale !== 2) setScale(2);
        }

        chapters.forEach((ch, idx) => {
          const chRect = ch.getBoundingClientRect();
          const isCurrent = chRect.top <= windowHeight * 0.5 && chRect.bottom >= windowHeight * 0.2;
          ch.classList.toggle('active', isCurrent);
        });
      }

      window.addEventListener('scroll', onScroll, { passive: true });

      // Resize Handler
      window.addEventListener('resize', () => {
        camera.aspect = mount.clientWidth / mount.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(mount.clientWidth, mount.clientHeight);
      });

      // 60 FPS Render Loop
      function animate() {
        requestAnimationFrame(animate);

        // Interpolate camera zoom transition
        currentScale += (targetScale - currentScale) * 0.08;
        const basePos = cameraPositions[Math.min(2, Math.floor(currentScale))];
        const nextPos = cameraPositions[Math.min(2, Math.ceil(currentScale))];
        const t = currentScale % 1;

        const targetX = THREE.MathUtils.lerp(basePos.x, nextPos.x, t);
        const targetY = THREE.MathUtils.lerp(basePos.y, nextPos.y, t);
        const targetZ = THREE.MathUtils.lerp(basePos.z, nextPos.z, t);

        // Apply Orbit Rotation
        const radius = Math.sqrt(targetX * targetX + targetY * targetY + targetZ * targetZ);
        camera.position.x = radius * Math.sin(orbitOffset.theta) * Math.cos(orbitOffset.phi);
        camera.position.y = targetY + radius * Math.sin(orbitOffset.phi);
        camera.position.z = radius * Math.cos(orbitOffset.theta) * Math.cos(orbitOffset.phi);
        camera.lookAt(0, 1.5, 0);

        // Transition Group Visibilities across scales
        group1T1C.visible = currentScale < 0.8;
        groupMatrix.visible = currentScale >= 0.5 && currentScale < 1.6;
        groupScale3.visible = currentScale >= 1.4;

        if (group1T1C.visible) {
          // Animate 3D Electrons
          electronSpheres.forEach((e) => {
            e.mesh.position.x += e.vx;
            e.mesh.position.y += e.vy;
            e.mesh.position.z += e.vz;

            // Bounce within 3D capacitor cylinder
            if (e.mesh.position.x < 3.5 || e.mesh.position.x > 5.5) e.vx *= -1;
            if (e.mesh.position.y < 0.2 || e.mesh.position.y > 5.8) e.vy *= -1;
            if (e.mesh.position.z < -1.0 || e.mesh.position.z > 1.0) e.vz *= -1;
          });
        }

        if (groupMatrix.visible) {
          // Slow subtle rotation for 3D matrix die
          groupMatrix.rotation.y += 0.003;
        }

        if (groupScale3.visible) {
          // Slow subtle rotation for 3D GPU stack
          groupScale3.rotation.y += 0.003;
        }

        renderer.render(scene, camera);
      }

      animate();
    });
  }

  initBranch3D();
  document.addEventListener('astro:page-load', initBranch3D);
</script>

