---
import Layout from '../layouts/Layout.astro';
import NeuralNet3D from '../components/visuals/neural-net/NeuralNet3D.astro';
import CiechanowskiGPUMemoryCanvas from '../components/home/CiechanowskiGPUMemoryCanvas.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';

const publishedPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const pagedPost = publishedPosts.find((post) => post.id === 'paged-attention-kv-cache') || publishedPosts[0];
const recentNotes = publishedPosts.filter((post) => post.id !== pagedPost?.id).slice(0, 3);

function formatDate(date: Date | string) {
  const value = typeof date === 'string' ? new Date(date) : date;
  return value.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
}
---

<Layout
  title={`${SITE.title} | Explanatory Systems Studio`}
  description="Karan Mittal builds inspectable AI, data, and performance systems—and publishes the mechanisms, constraints, and evidence behind them."
  variant="instrumented"
>
  <main class="ie-home">
    <!-- HERO SECTION: 3Blue1Brown/Linear Precision Manifold + Statement + Identity -->
    <section class="ie-hero" aria-labelledby="home-title">
      <div class="ie-shell hero-grid">
        <div class="hero-copy">
          <p class="ie-register"><span>Studio 01</span> Engineer-scientist · Systems practice</p>
          <h1 id="home-title">I make complex systems inspectable.</h1>
          <p class="hero-lead">
            I design AI, data, and performance systems whose behaviour can be traced from input to decision—then publish the mechanisms, constraints, and evidence that make them dependable.
          </p>
          <div class="hero-actions">
            <a class="ie-action primary" href="#memory-simulator">Inspect hardware machine <span aria-hidden="true">&darr;</span></a>
            <a class="ie-action secondary" href="/work">Review selected work <span aria-hidden="true">&nearr;</span></a>
          </div>

          <!-- Integrated Identity & Location Card -->
          <div class="hero-identity-card">
            <img
              src="/profile-400.jpg"
              alt="Karan Mittal speaking on deterministic AI systems"
              class="identity-avatar"
              width="52"
              height="52"
              loading="eager"
            />
            <div class="identity-info">
              <div class="identity-status">
                <span class="live-dot"></span>
                <strong>Indore &middot; Global Advisory</strong>
              </div>
              <p class="identity-principle">&ldquo;Reliability is designed into the system&mdash;never added as an afterthought.&rdquo;</p>
            </div>
          </div>
        </div>

        <!-- 3Blue1Brown / Linear 3D Neural Flow Engine -->
        <div class="hero-canvas-frame">
          <NeuralNet3D
            exhibit="00"
            title="3D Deep Neural Architecture & Signal Propagation Engine"
            badge="Hero Precision Instrument"
            caption="Interactive 3Blue1Brown-grade tensor manifold. Rotate in 3D orbit: inspect weight matrices and real-time activation pulse propagation across layers."
          />
        </div>
      </div>

      <div class="ie-shell hero-proof" aria-label="Published studio evidence">
        <a href="/blog" class="proof-pill-link"><strong>{String(publishedPosts.length).padStart(2, '0')}</strong> published field notes &nearr;</a>
        <a href="/work" class="proof-pill-link"><strong>03</strong> systems practice areas &nearr;</a>
        <a href="/studio/visuals" class="proof-pill-link"><strong>01</strong> interactive visual laboratory &nearr;</a>
      </div>
    </section>

    <!-- SECTION 01: SCROLL-DRIVEN CIECHANOWSKI GPU MEMORY & PAGED ATTENTION CANVAS -->
    <section class="ie-section flagship-section" id="memory-simulator" aria-labelledby="gpu-canvas-title">
      <div class="ie-shell">
        <CiechanowskiGPUMemoryCanvas />
      </div>
    </section>

    <!-- SECTION 02: FIELD NOTES (TECHNICAL ESSAYS & DEEP DIVES) -->
    <section class="ie-section notes-section" aria-labelledby="notes-title">
      <div class="ie-shell">
        <div class="section-heading split">
          <div>
            <p class="ie-register"><span>02 / Field notes</span> Published mechanisms</p>
            <h2 id="notes-title">Ideas become useful when they can be challenged.</h2>
          </div>
          <a class="section-link" href="/blog">All field notes ({publishedPosts.length}) <span aria-hidden="true">&nearr;</span></a>
        </div>

        <div class="notes-layout">
          {pagedPost && (
            <article class="featured-note">
              <a href={`/blog/${pagedPost.id}/`} class="featured-note-visual" aria-label={`Read ${pagedPost.data.title}`}>
                <img src={pagedPost.data.image} alt="" loading="lazy" decoding="async" />
                <span class="visual-label">Featured deep dive / GPU memory</span>
              </a>
              <div class="featured-note-copy">
                <p class="note-meta"><time datetime={pagedPost.data.pubDate.toISOString()}>{formatDate(pagedPost.data.pubDate)}</time> &middot; LLM inference</p>
                <h3><a href={`/blog/${pagedPost.id}/`}>{pagedPost.data.title}</a></h3>
                <p>{pagedPost.data.description}</p>
                <a class="text-link" href={`/blog/${pagedPost.id}/`}>Trace the mechanism <span aria-hidden="true">&rarr;</span></a>
              </div>
            </article>
          )}

          <div class="notes-ledger" aria-label="Recent field notes">
            <div class="ledger-head"><span>Recent technical notes</span><code>{String(recentNotes.length).padStart(2, '0')} entries</code></div>
            {recentNotes.map((post, index) => (
              <a href={`/blog/${post.id}/`} class="ledger-row">
                <span class="ledger-index">{String(index + 1).padStart(2, '0')}</span>
                <span class="ledger-copy">
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  <strong>{post.data.title}</strong>
                  <small>{post.data.tags.slice(0, 2).join(' &middot; ')}</small>
                </span>
                <span class="ledger-arrow" aria-hidden="true">&nearr;</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 03: DECISION & CONSULTATION INTAKE -->
    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <div class="ie-shell contact-grid">
        <div>
          <p class="ie-register"><span>03 / Decision</span> Work together</p>
          <h2 id="contact-title">Have a system that needs to be understood before it can be trusted?</h2>
        </div>
        <div class="contact-copy">
          <p>Bring the architecture, workload, or unresolved constraint. Submit a short project brief through our intake form or reach out directly.</p>
          <div class="hero-actions">
            <a class="ie-action primary" href="/contact">Open project brief &amp; consultation <span aria-hidden="true">&rarr;</span></a>
            <a class="ie-action secondary" href={`mailto:${SITE.email}?subject=Systems%20Engineering%20Inquiry`}>Send direct email</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .ie-home { overflow: clip; }
  .ie-shell { width: min(100% - 3rem, 1280px); margin-inline: auto; }
  .ie-register { margin: 0 0 1rem; color: var(--ie-muted); font-family: var(--font-mono); font-size: 0.67rem; font-weight: 500; letter-spacing: 0.075em; text-transform: uppercase; }
  .ie-register span { margin-right: 0.6rem; color: var(--ie-blue); font-weight: 600; }
  .ie-hero { border-bottom: 1px solid var(--ie-rule); }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(340px, 0.85fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    min-height: min(720px, calc(100vh - 64px));
    padding-block: clamp(4.5rem, 10vh, 8rem) clamp(3.5rem, 8vh, 6rem);
  }

  .hero-copy { max-width: 720px; }
  .hero-copy h1 { max-width: 13ch; margin: 0 0 1.5rem; color: var(--ie-ink); font-size: clamp(3.35rem, 7.2vw, 6.5rem); font-weight: 500; line-height: 0.98; text-wrap: balance; }
  .hero-lead { max-width: 680px; margin: 0; color: var(--ie-ink-secondary); font-size: clamp(1.12rem, 1.7vw, 1.38rem); line-height: 1.58; }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .ie-action {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.68rem 1.15rem;
    border: 1px solid var(--ie-ink);
    border-radius: var(--radius, 6px);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: all 120ms ease;
  }
  .ie-action.primary { background: var(--ie-ink); color: var(--ie-canvas); }
  .ie-action.primary:hover { border-color: var(--ie-blue); background: var(--ie-blue); color: #fff; }
  .ie-action.secondary { background: transparent; color: var(--ie-ink); }
  .ie-action.secondary:hover { border-color: var(--ie-blue); color: var(--ie-blue); }

  /* Hero Identity Card */
  .hero-identity-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1.15rem;
    margin-top: 2.25rem;
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 8px);
    background: var(--ie-surface);
    max-width: 540px;
  }

  .identity-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    border: 1.5px solid var(--ie-rule-strong);
    filter: grayscale(100%);
    transition: filter 250ms ease;
    flex-shrink: 0;
  }

  .hero-identity-card:hover .identity-avatar {
    filter: grayscale(0%);
  }

  .identity-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .identity-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ie-ink);
  }

  .live-dot { width: 6px; height: 6px; border-radius: 50%; background: #34d399; box-shadow: 0 0 0 2px rgba(52, 211, 153, 0.3); }

  .identity-principle {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 0.86rem;
    font-style: italic;
    color: var(--ie-ink-secondary);
    line-height: 1.4;
  }

  .hero-canvas-frame {
    width: 100%;
    max-width: 540px;
    justify-self: end;
  }

  /* Hero Proof Strip */
  .hero-proof { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--ie-rule); }
  .proof-pill-link { display: block; padding: 1rem 1.25rem; border-right: 1px solid var(--ie-rule); color: var(--ie-muted); font-family: var(--font-mono); font-size: 0.68rem; text-align: center; text-decoration: none; transition: background-color 120ms ease, color 120ms ease; }
  .proof-pill-link:last-child { border-right: 0; }
  .proof-pill-link:hover { background: var(--ie-surface-raised); color: var(--ie-blue); }
  .proof-pill-link strong { margin-right: 0.3rem; color: var(--ie-blue); font-size: 0.95rem; font-weight: 600; }

  /* Section Layouts */
  .ie-section { padding-block: clamp(4.5rem, 9vw, 8rem); border-bottom: 1px solid var(--ie-rule); }
  .flagship-section { background: var(--ie-surface-raised); }
  .section-heading { margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .section-heading.split { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.8fr); gap: clamp(2rem, 8vw, 7rem); align-items: end; }
  .section-heading h2, .contact-grid h2 { max-width: 18ch; margin: 0; color: var(--ie-ink); font-family: var(--font-serif); font-size: clamp(2.3rem, 4.4vw, 3.8rem); font-weight: 500; line-height: 1.05; text-wrap: balance; }
  .section-heading > p, .contact-copy > p { max-width: 48ch; margin: 0; color: var(--ie-ink-secondary); font-size: 1rem; line-height: 1.6; }
  .section-link { display: inline-flex; align-items: center; gap: 0.35rem; justify-self: start; color: var(--ie-blue); font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; text-decoration: none; }
  .section-link:hover { text-decoration: underline; }

  /* Notes Layout */
  .notes-layout { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.95fr); gap: clamp(2.5rem, 6vw, 5rem); align-items: start; }
  .featured-note { display: flex; flex-direction: column; gap: 1.25rem; }
  .featured-note-visual { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; border: 1px solid var(--ie-rule); border-radius: var(--radius-card, 8px); background: var(--ie-surface); }
  .featured-note-visual img { width: 100%; height: 100%; object-fit: cover; transition: transform 300ms ease; }
  .featured-note:hover .featured-note-visual img { transform: scale(1.02); }
  .visual-label { position: absolute; top: 12px; left: 12px; padding: 0.3rem 0.6rem; border-radius: var(--radius-pill, 999px); background: rgba(23, 26, 31, 0.85); backdrop-filter: blur(6px); border: 1px solid rgba(255, 255, 255, 0.2); color: #fff; font-family: var(--font-mono); font-size: 0.65rem; }
  .featured-note-copy { display: flex; flex-direction: column; gap: 0.5rem; }
  .note-meta { margin: 0; color: var(--ie-muted); font-family: var(--font-mono); font-size: 0.68rem; text-transform: uppercase; }
  .featured-note-copy h3 { margin: 0; font-family: var(--font-serif); font-size: clamp(1.4rem, 2.2vw, 1.9rem); font-weight: 600; line-height: 1.2; }
  .featured-note-copy h3 a { color: var(--ie-ink); text-decoration: none; transition: color 120ms ease; }
  .featured-note-copy h3 a:hover { color: var(--ie-blue); }
  .featured-note-copy p { margin: 0; color: var(--ie-ink-secondary); font-size: 0.94rem; line-height: 1.58; }
  .text-link { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.5rem; color: var(--ie-blue); font-family: var(--font-mono); font-size: 0.72rem; font-weight: 600; text-decoration: none; }
  .text-link:hover { text-decoration: underline; }

  /* Notes Ledger */
  .notes-ledger { border-top: 2px solid var(--ie-ink); }
  .ledger-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.75rem 0; border-bottom: 1px solid var(--ie-rule); color: var(--ie-muted); font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .ledger-row { display: grid; grid-template-columns: 2rem minmax(0, 1fr) auto; gap: 0.75rem; align-items: start; padding: 1.15rem 0; border-bottom: 1px solid var(--ie-rule); color: var(--ie-ink); text-decoration: none; transition: background-color 100ms ease; }
  .ledger-index, .ledger-arrow { color: var(--ie-blue); font-family: var(--font-mono); font-size: 0.68rem; font-weight: 600; }
  .ledger-copy { display: flex; flex-direction: column; gap: 0.3rem; }
  .ledger-copy time { color: var(--ie-muted); font-family: var(--font-mono); font-size: 0.65rem; }
  .ledger-copy strong { font-family: var(--font-sans); font-size: 0.95rem; font-weight: 600; line-height: 1.35; color: var(--ie-ink); transition: color 120ms ease; }
  .ledger-copy small { color: var(--ie-muted); font-family: var(--font-mono); font-size: 0.68rem; }
  .ledger-row:hover .ledger-copy strong { color: var(--ie-blue); }

  /* Contact Section */
  .contact-section { padding-block: clamp(4.5rem, 9vw, 8rem); border-bottom: 1px solid var(--ie-rule); background: var(--ie-surface); }
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr); gap: clamp(3rem, 9vw, 8rem); padding-top: 1.5rem; border-top: 2px solid var(--ie-rust); }

  @media (max-width: 980px) {
    .hero-grid, .section-heading.split, .notes-layout, .contact-grid { grid-template-columns: 1fr; }
    .hero-grid { min-height: auto; align-items: start; }
    .hero-canvas-frame { max-width: 100%; justify-self: start; }
    .section-heading h2, .contact-grid h2 { max-width: 20ch; }
  }

  @media (max-width: 680px) {
    .ie-shell { width: min(100% - 2rem, 1280px); }
    .hero-grid { gap: 2.5rem; padding-block: 3.5rem; }
    .hero-copy h1 { font-size: clamp(3rem, 16vw, 4.6rem); }
    .hero-proof { grid-template-columns: 1fr; }
    .proof-pill-link { border-right: 0; border-bottom: 1px solid var(--ie-rule); text-align: left; }
    .proof-pill-link:last-child { border-bottom: 0; }
    .ie-section, .contact-section { padding-block: 3.5rem; }
    .section-heading h2, .contact-grid h2 { font-size: clamp(2.2rem, 12vw, 3.4rem); }
  }
</style>
