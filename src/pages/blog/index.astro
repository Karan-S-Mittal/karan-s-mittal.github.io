---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Layout title="Writing | Karan Mittal">
  <main style="max-width: 720px; margin: 0 auto; padding: 3rem 1.5rem;">
    <nav style="margin-bottom: 2rem; font-size: 0.9rem; color: var(--muted);">
      <a href="/">Karan Mittal</a>
      <span style="margin: 0 0.5rem;">/</span>
      <span style="font-weight: 600; color: var(--accent);">Writing</span>
    </nav>

    <h1 style="margin-bottom: 2rem;">Technical Writing</h1>

    <ul style="list-style: none; padding: 0;">
      {posts.map(post => (
        <li style="margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 1.5rem;">
          <a href={`/blog/${post.slug}/`} style="font-size: 1.15rem; font-weight: 600;">
            {post.data.title}
          </a>
          <p style="margin: 0.35rem 0 0; color: var(--muted); font-size: 0.95rem;">
            {post.data.description}
          </p>
          <p style="margin: 0.5rem 0 0; font-size: 0.8rem; color: var(--muted);">
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </p>
        </li>
      ))}
    </ul>
  </main>
</Layout>
