          <!-- Gather Operator -->
          <text x="52" y="68" text-anchor="middle" font-family="var(--font-mono)" font-size="13" font-weight="700" fill="var(--ex-text-muted)">▼ GATHER ▼</text>

          <!-- Gathered K, V blocks -->
          <rect x="0" y="86" width="104" height="60" rx="4" fill="var(--ex-card-bg)" stroke="var(--ex-green-stroke)" stroke-width="1" stroke-dasharray="2 2" />
          <text x="52" y="104" text-anchor="middle" font-family="var(--font-sans)" font-size="10" font-weight="700" fill="var(--ex-green-text)">Direct Stream</text>
          <text x="52" y="120" text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--ex-blue-text)">• K,V from #12</text>
          <text x="52" y="136" text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--ex-indigo-text)">• K,V from #04</text>

          <!-- Fused Attention compute -->
          <rect x="0" y="160" width="104" height="65" rx="4" fill="var(--ex-purple-bg)" stroke="var(--ex-purple-stroke)" stroke-width="1.5" />
