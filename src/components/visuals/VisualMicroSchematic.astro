---
/**
 * VisualMicroSchematic.astro
 *
 * Theme-aware live vector micro-schematic for architectural visuals.
 * Renders the structural topology of each system with 100% semantic tokens.
 * Zero raw hex colors. 100% vector SVG.
 */

interface Props {
  slug?: string;
  archetype?: 'loop' | 'pipeline' | 'memory' | 'tree' | 'hierarchy' | 'comparison';
  class?: string;
}

const { slug = '', archetype, class: className = '' } = Astro.props;

// Determine which schematic to render: by slug first, then fallback to archetype
const mode = slug || archetype || 'pipeline';
---

<div class:list={['micro-schematic-wrap', className]} aria-hidden="true">
  <svg class="micro-schematic-svg" viewBox="0 0 320 180" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <!-- Blueprint Grid Pattern -->
      <pattern id={`bp-grid-${slug || 'default'}`} width="16" height="16" patternUnits="userSpaceOnUse">
        <path d="M 16 0 L 0 0 0 16" fill="none" stroke="var(--ie-rule)" stroke-width="0.5" stroke-opacity="0.6" />
        <circle cx="16" cy="16" r="0.75" fill="var(--ie-rule-strong)" />
      </pattern>

      <!-- Blueprint Arrowhead (Active Blue) -->
      <marker id={`arr-blue-${slug || 'default'}`} viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="5" markerHeight="5" orient="auto">
        <path d="M 1.5 1.5 L 6.5 4 L 1.5 6.5" fill="none" stroke="var(--ie-blue)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </marker>

      <!-- Blueprint Arrowhead (Rust Constraint) -->
      <marker id={`arr-rust-${slug || 'default'}`} viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="5" markerHeight="5" orient="auto">
        <path d="M 1.5 1.5 L 6.5 4 L 1.5 6.5" fill="none" stroke="var(--ie-rust)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </marker>

      <!-- Blueprint Arrowhead (Verified Green) -->
      <marker id={`arr-verified-${slug || 'default'}`} viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="5" markerHeight="5" orient="auto">
        <path d="M 1.5 1.5 L 6.5 4 L 1.5 6.5" fill="none" stroke="var(--ie-verified)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
    </defs>

    <!-- Background Blueprint Grid -->
    <rect width="320" height="180" fill="var(--ie-surface-raised)" />
    <rect width="320" height="180" fill={`url(#bp-grid-${slug || 'default'})`} />

    <!-- Corner Blueprint Registration Crosshairs -->
    <path d="M 8 14 L 8 8 L 14 8" stroke="var(--ie-muted)" stroke-width="1" fill="none" opacity="0.5" />
    <path d="M 312 14 L 312 8 L 306 8" stroke="var(--ie-muted)" stroke-width="1" fill="none" opacity="0.5" />
    <path d="M 8 166 L 8 172 L 14 172" stroke="var(--ie-muted)" stroke-width="1" fill="none" opacity="0.5" />
    <path d="M 312 166 L 312 172 L 306 172" stroke="var(--ie-muted)" stroke-width="1" fill="none" opacity="0.5" />

    {/* 1. CLAUDE CODE LOCAL LOOP / LOOP ARCHETYPE */}
    {(mode === 'claude-code-loop' || mode === 'loop') && (
      <g class="schematic-group">
        <!-- Racetrack Main Loop -->
        <rect x="24" y="32" width="76" height="42" rx="4" fill="var(--ie-surface)" stroke="var(--ie-rule-strong)" stroke-width="1.5" />
        <text x="62" y="52" class="node-title" text-anchor="middle">Shell / CLI</text>
        <text x="62" y="64" class="node-sub" text-anchor="middle">stdin/stdout</text>

        <line x1="100" y1="53" x2="128" y2="53" stroke="var(--ie-blue)" stroke-width="1.5" marker-end={`url(#arr-blue-${slug || 'default'})`} />

        <rect x="130" y="32" width="76" height="42" rx="4" fill="var(--ie-surface)" stroke="var(--ie-blue)" stroke-width="1.5" />
        <text x="168" y="52" class="node-title" text-anchor="middle">Agent Loop</text>
        <text x="168" y="64" class="node-sub" text-anchor="middle">ReAct Cycle</text>

        <line x1="206" y1="53" x2="234" y2="53" stroke="var(--ie-blue)" stroke-width="1.5" marker-end={`url(#arr-blue-${slug || 'default'})`} />

        <!-- Constraint Gate (Rust) -->
        <rect x="236" y="32" width="60" height="42" rx="4" fill="var(--ie-surface)" stroke="var(--ie-rust)" stroke-width="1.5" />
        <text x="266" y="52" class="node-title rust" text-anchor="middle">Gate</text>
        <text x="266" y="64" class="node-sub rust" text-anchor="middle">Approval</text>

        <!-- Downward Substrate Bus -->
        <path d="M 168 74 L 168 96" stroke="var(--ie-blue)" stroke-width="1.5" />
        <circle cx="168" cy="96" r="2.5" fill="var(--ie-blue)" />
        <path d="M 62 96 L 266 96" stroke="var(--ie-blue)" stroke-width="1.5" />

        <!-- Substrate Drops -->
        <path d="M 62 96 L 62 114" stroke="var(--ie-blue)" stroke-width="1.5" marker-end={`url(#arr-blue-${slug || 'default'})`} />
        <path d="M 168 96 L 168 114" stroke="var(--ie-blue)" stroke-width="1.5" marker-end={`url(#arr-blue-${slug || 'default'})`} />
        <path d="M 266 96 L 266 114" stroke="var(--ie-blue)" stroke-width="1.5" marker-end={`url(#arr-blue-${slug || 'default'})`} />

        <!-- 3 Substrates -->
        <rect x="30" y="116" width="64" height="34" rx="3" fill="var(--ie-surface)" stroke="var(--ie-rule)" stroke-width="1.2" />
        <text x="62" y="132" class="node-mono" text-anchor="middle">Native Tools</text>
        <text x="62" y="142" class="node-sub" text-anchor="middle">ripgrep / edit</text>

        <rect x="136" y="116" width="64" height="34" rx="3" fill="var(--ie-surface)" stroke="var(--ie-rule)" stroke-width="1.2" />
        <text x="168" y="132" class="node-mono" text-anchor="middle">MCP Protocol</text>
        <text x="168" y="142" class="node-sub" text-anchor="middle">JSON-RPC</text>

        <rect x="234" y="116" width="64" height="34" rx="3" fill="var(--ie-surface)" stroke="var(--ie-rule)" stroke-width="1.2" />
        <text x="266" y="132" class="node-mono" text-anchor="middle">Subagents</text>
        <text x="266" y="142" class="node-sub" text-anchor="middle">Fork / Worktree</text>
      </g>
    )}

    {/* 2. PAGED ATTENTION / MEMORY ARCHETYPE */}
    {(mode === 'paged-attention' || mode === 'memory') && (
      <g class="schematic-group">
        <!-- Left: Virtual Contiguous Token Blocks -->
        <text x="24" y="36" class="section-label">VIRTUAL BLOCKS</text>
        <rect x="24" y="44" width="70" height="30" rx="3" fill="var(--ie-surface)" stroke="var(--ie-blue)" stroke-width="1.2" />
        <text x="59" y="60" class="node-mono" text-anchor="middle">Block 0</text>
        <text x="59" y="69" class="node-sub" text-anchor="middle">tokens [0..3]</text>

        <rect x="24" y="80" width="70" height="30" rx="3" fill="var(--ie-surface)" stroke="var(--ie-blue)" stroke-width="1.2" />
        <text x="59" y="96" class="node-mono" text-anchor="middle">Block 1</text>
        <text x="59" y="105" class="node-sub" text-anchor="middle">tokens [4..7]</text>

        <!-- Middle: Page Translation Table -->
        <text x="120" y="36" class="section-label">BLOCK TABLE</text>
        <rect x="114" y="44" width="80" height="66" rx="4" fill="var(--ie-surface)" stroke="var(--ie-rule-strong)" stroke-width="1.2" />
        <text x="154" y="64" class="node-mono" text-anchor="middle">Blk 0 &rarr; F12</text>
        <line x1="120" y1="76" x2="188" y2="76" stroke="var(--ie-rule)" stroke-width="1" />
        <text x="154" y="96" class="node-mono" text-anchor="middle">Blk 1 &rarr; F07</text>

        <!-- Connectors Virtual -> Table -->
        <path d="M 94 59 L 112 59" stroke="var(--ie-blue)" stroke-width="1.2" marker-end={`url(#arr-blue-${slug || 'default'})`} />
        <path d="M 94 95 L 112 95" stroke="var(--ie-blue)" stroke-width="1.2" marker-end={`url(#arr-blue-${slug || 'default'})`} />

        <!-- Right: Non-Contiguous Physical GPU Frames Grid -->
        <text x="220" y="36" class="section-label">PHYSICAL VRAM</text>
        <g transform="translate(216, 44)">
          <!-- Frame 00 (free) -->
          <rect x="0" y="0" width="38" height="24" rx="2" fill="var(--ie-mem-free)" stroke="var(--ie-rule)" stroke-width="1" />
          <text x="19" y="16" class="node-sub" text-anchor="middle">F00</text>

          <!-- Frame 07 (Allocated Block 1) -->
          <rect x="42" y="0" width="46" height="24" rx="2" fill="var(--ie-mem-allocated)" stroke="var(--ie-blue)" stroke-width="1.5" />
          <text x="65" y="14" class="node-mono blue" text-anchor="middle">F07</text>
          <text x="65" y="21" class="node-micro" text-anchor="middle">Blk 1</text>

          <!-- Frame 08 (Other Req / Cached) -->
          <rect x="0" y="28" width="38" height="24" rx="2" fill="var(--ie-mem-cached)" stroke="var(--ie-rule)" stroke-width="1" />
          <text x="19" y="44" class="node-sub" text-anchor="middle">F08 (Req2)</text>

          <!-- Frame 12 (Allocated Block 0) -->
          <rect x="42" y="28" width="46" height="24" rx="2" fill="var(--ie-mem-allocated)" stroke="var(--ie-blue)" stroke-width="1.5" />
          <text x="65" y="42" class="node-mono blue" text-anchor="middle">F12</text>
          <text x="65" y="49" class="node-micro" text-anchor="middle">Blk 0</text>

          <!-- Frame 13 (Free) -->
          <rect x="0" y="56" width="38" height="24" rx="2" fill="var(--ie-mem-free)" stroke="var(--ie-rule)" stroke-width="1" />
          <text x="19" y="72" class="node-sub" text-anchor="middle">F13</text>

          <!-- Frame 14 (Free) -->
          <rect x="42" y="56" width="46" height="24" rx="2" fill="var(--ie-mem-free)" stroke="var(--ie-rule)" stroke-width="1" />
          <text x="65" y="72" class="node-sub" text-anchor="middle">F14</text>
        </g>

        <!-- Dynamic Page Translation Lines -->
        <path d="M 194 62 C 206 62 206 86 256 86" fill="none" stroke="var(--ie-blue)" stroke-width="1.5" marker-end={`url(#arr-blue-${slug || 'default'})`} />
        <path d="M 194 95 C 206 95 206 56 256 56" fill="none" stroke="var(--ie-blue)" stroke-width="1.5" marker-end={`url(#arr-blue-${slug || 'default'})`} />

        <!-- Bottom Takeaway Leader -->
        <text x="160" y="160" class="leader-callout" text-anchor="middle">&larr; zero contiguous GPU copy: non-contiguous scatter-gather</text>
      </g>
    )}

    {/* 3. DETERMINISTIC RAG ARCHITECTURE */}
    {mode === 'deterministic-rag' && (
      <g class="schematic-group">
        <!-- 3 Horizontal Planes Stacked -->
        <!-- Plane 1: Immutable Corpus Plane -->
        <rect x="24" y="28" width="272" height="34" rx="4" fill="var(--ie-surface)" stroke="var(--ie-rule-strong)" stroke-width="1.2" />
        <text x="36" y="44" class="plane-title">PLANE 01 &bull; IMMUTABLE CORPUS</text>
        <text x="36" y="54" class="node-sub">Content Addressable Hash &bull; Normalized AST Chunking</text>

        <!-- Plane 2: Deterministic Retrieval Plane -->
        <rect x="24" y="72" width="272" height="34" rx="4" fill="var(--ie-surface)" stroke="var(--ie-blue)" stroke-width="1.5" />
        <text x="36" y="88" class="plane-title blue">PLANE 02 &bull; HYBRID RETRIEVAL</text>
        <text x="36" y="98" class="node-sub">BM25 Sparse &bull; Dense Bi-Encoder &bull; Reciprocal Rank Fusion</text>

        <!-- Plane 3: Verifiable Trace Plane -->
        <rect x="24" y="116" width="272" height="34" rx="4" fill="var(--ie-surface)" stroke="var(--ie-verified)" stroke-width="1.5" />
        <text x="36" y="132" class="plane-title green">PLANE 03 &bull; REPLAY TRACE</text>
        <text x="36" y="142" class="node-sub">Deterministic Seed &bull; Merkle Audit Bundle &bull; Exact Replay</text>

        <!-- Downward Connectors -->
        <path d="M 160 62 L 160 70" stroke="var(--ie-blue)" stroke-width="1.5" marker-end={`url(#arr-blue-${slug || 'default'})`} />
        <path d="M 160 106 L 160 114" stroke="var(--ie-verified)" stroke-width="1.5" marker-end={`url(#arr-verified-${slug || 'default'})`} />

        <circle cx="280" cy="45" r="4" fill="var(--ie-rule-strong)" />
        <circle cx="280" cy="89" r="4" fill="var(--ie-blue)" />
        <circle cx="280" cy="133" r="4" fill="var(--ie-verified)" />
      </g>
    )}

    {/* 4. CLAUDE CODE HARNESS */}
    {mode === 'claude-code-harness' && (
      <g class="schematic-group">
        <!-- 4-Stage Horizontal Harness Pipeline -->
        <rect x="18" y="46" width="62" height="46" rx="4" fill="var(--ie-surface)" stroke="var(--ie-rule-strong)" stroke-width="1.2" />
        <text x="49" y="66" class="node-title" text-anchor="middle">Prompt</text>
        <text x="49" y="78" class="node-sub" text-anchor="middle">CLI Stream</text>

        <line x1="80" y1="69" x2="96" y2="69" stroke="var(--ie-blue)" stroke-width="1.5" marker-end={`url(#arr-blue-${slug || 'default'})`} />

        <rect x="98" y="46" width="64" height="46" rx="4" fill="var(--ie-surface)" stroke="var(--ie-blue)" stroke-width="1.5" />
        <text x="130" y="66" class="node-title" text-anchor="middle">Harness</text>
        <text x="130" y="78" class="node-sub" text-anchor="middle">Claude 3.7</text>

        <line x1="162" y1="69" x2="178" y2="69" stroke="var(--ie-rust)" stroke-width="1.5" marker-end={`url(#arr-rust-${slug || 'default'})`} />

        <rect x="180" y="46" width="60" height="46" rx="4" fill="var(--ie-surface)" stroke="var(--ie-rust)" stroke-width="1.5" />
        <text x="210" y="66" class="node-title rust" text-anchor="middle">PreTool</text>
        <text x="210" y="78" class="node-sub rust" text-anchor="middle">Policy Gate</text>

        <line x1="240" y1="69" x2="254" y2="69" stroke="var(--ie-blue)" stroke-width="1.5" marker-end={`url(#arr-blue-${slug || 'default'})`} />

        <rect x="256" y="46" width="50" height="46" rx="4" fill="var(--ie-surface)" stroke="var(--ie-rule-strong)" stroke-width="1.2" />
        <text x="281" y="66" class="node-title" text-anchor="middle">Runner</text>
        <text x="281" y="78" class="node-sub" text-anchor="middle">Tools</text>

        <!-- Feedback Context Compaction Loop -->
        <path d="M 281 92 L 281 124 L 130 124 L 130 94" fill="none" stroke="var(--ie-blue)" stroke-width="1.2" stroke-dasharray="3 3" marker-end={`url(#arr-blue-${slug || 'default'})`} />
        <text x="205" y="136" class="leader-callout" text-anchor="middle">&larr; closed-loop context compaction</text>
      </g>
    )}

    {/* 5. CODEX CLOUD SANDBOX LOOP */}
    {mode === 'codex-cloud-sandbox-loop' && (
      <g class="schematic-group">
        <!-- Circular / Racetrack Cloud Sandbox Loop -->
        <rect x="24" y="42" width="70" height="40" rx="4" fill="var(--ie-surface)" stroke="var(--ie-rule-strong)" stroke-width="1.2" />
        <text x="59" y="60" class="node-title" text-anchor="middle">Task Spec</text>
        <text x="59" y="72" class="node-sub" text-anchor="middle">Cloud Dispatch</text>

        <line x1="94" y1="62" x2="114" y2="62" stroke="var(--ie-blue)" stroke-width="1.5" marker-end={`url(#arr-blue-${slug || 'default'})`} />

        <rect x="116" y="42" width="88" height="40" rx="4" fill="var(--ie-surface)" stroke="var(--ie-blue)" stroke-width="1.5" />
        <text x="160" y="60" class="node-title" text-anchor="middle">Ephemeral VM</text>
        <text x="160" y="72" class="node-sub" text-anchor="middle">Isolated Container</text>

        <line x1="204" y1="62" x2="224" y2="62" stroke="var(--ie-blue)" stroke-width="1.5" marker-end={`url(#arr-blue-${slug || 'default'})`} />

        <rect x="226" y="42" width="70" height="40" rx="4" fill="var(--ie-surface)" stroke="var(--ie-rule-strong)" stroke-width="1.2" />
        <text x="261" y="60" class="node-title" text-anchor="middle">Mutator</text>
        <text x="261" y="72" class="node-sub" text-anchor="middle">Patch Synthesizer</text>

        <!-- Lower Feedback Loop: Self-Correction via Tests -->
        <path d="M 261 82 L 261 122 L 160 122" fill="none" stroke="var(--ie-rust)" stroke-width="1.5" marker-end={`url(#arr-rust-${slug || 'default'})`} />
        <rect x="116" y="104" width="88" height="36" rx="4" fill="var(--ie-surface)" stroke="var(--ie-verified)" stroke-width="1.5" />
        <text x="160" y="120" class="node-title green" text-anchor="middle">Test Gate</text>
        <text x="160" y="130" class="node-sub" text-anchor="middle">Exit 0 &rarr; Auto PR</text>
      </g>
    )}

    {/* 6. CODEX VS CLAUDE CODE HERO */}
    {mode === 'codex-vs-claude-code' && (
      <g class="schematic-group">
        <!-- Dual Track Comparative Lanes -->
        <text x="24" y="32" class="section-label">ANTHROPIC CLAUDE CODE</text>
        <rect x="24" y="38" width="272" height="42" rx="4" fill="var(--ie-surface)" stroke="var(--ie-blue)" stroke-width="1.2" />
        <text x="36" y="56" class="node-title blue">Local Interactive REPL</text>
        <text x="36" y="68" class="node-sub">Terminal Shell &bull; Local Substrate &bull; Human Permission Gate</text>
        <rect x="236" y="46" width="50" height="26" rx="3" fill="var(--ie-surface)" stroke="var(--ie-rust)" stroke-width="1" />
        <text x="261" y="62" class="node-micro rust" text-anchor="middle">HUMAN GATE</text>

        <line x1="24" y1="92" x2="296" y2="92" stroke="var(--ie-rule)" stroke-width="1" stroke-dasharray="4 4" />

        <text x="24" y="112" class="section-label">OPENAI CODEX CLOUD</text>
        <rect x="24" y="118" width="272" height="42" rx="4" fill="var(--ie-surface)" stroke="var(--ie-rule-strong)" stroke-width="1.2" />
        <text x="36" y="136" class="node-title">Cloud Autonomous Daemon</text>
        <text x="36" y="148" class="node-sub">Headless VM &bull; Container Isolation &bull; Self-Correcting PR</text>
        <rect x="236" y="126" width="50" height="26" rx="3" fill="var(--ie-surface)" stroke="var(--ie-verified)" stroke-width="1" />
        <text x="261" y="142" class="node-micro green" text-anchor="middle">AUTO PR</text>
      </g>
    )}

    {/* 7. CODING AGENT ARCHITECTURE */}
    {mode === 'coding-agent' && (
      <g class="schematic-group">
        <!-- 3-Tier Cognitive Hierarchy -->
        <!-- Tier 1: Planner / Orchestrator -->
        <rect x="80" y="24" width="160" height="32" rx="4" fill="var(--ie-surface)" stroke="var(--ie-blue)" stroke-width="1.5" />
        <text x="160" y="42" class="node-title" text-anchor="middle">Cognitive Orchestrator</text>
        <text x="160" y="50" class="node-sub" text-anchor="middle">LLM Reasoning &bull; Task Decomposition</text>

        <path d="M 160 56 L 160 70" stroke="var(--ie-blue)" stroke-width="1.5" marker-end={`url(#arr-blue-${slug || 'default'})`} />

        <!-- Tier 2: State & Tool Router -->
        <rect x="50" y="72" width="220" height="32" rx="4" fill="var(--ie-surface)" stroke="var(--ie-rule-strong)" stroke-width="1.2" />
        <text x="160" y="88" class="node-title" text-anchor="middle">Context Map &amp; Router</text>
        <text x="160" y="96" class="node-sub" text-anchor="middle">AST Graph &bull; Tool Dispatch &bull; Memory</text>

        <!-- Downward Fork into 3 Substrates -->
        <path d="M 160 104 L 160 118" stroke="var(--ie-blue)" stroke-width="1.5" />
        <circle cx="160" cy="118" r="2.5" fill="var(--ie-blue)" />
        <path d="M 66 118 L 254 118" stroke="var(--ie-blue)" stroke-width="1.5" />
        <path d="M 66 118 L 66 130" stroke="var(--ie-blue)" stroke-width="1.5" marker-end={`url(#arr-blue-${slug || 'default'})`} />
        <path d="M 160 118 L 160 130" stroke="var(--ie-blue)" stroke-width="1.5" marker-end={`url(#arr-blue-${slug || 'default'})`} />
        <path d="M 254 118 L 254 130" stroke="var(--ie-blue)" stroke-width="1.5" marker-end={`url(#arr-blue-${slug || 'default'})`} />

        <!-- Substrates -->
        <rect x="30" y="132" width="72" height="30" rx="3" fill="var(--ie-surface)" stroke="var(--ie-rule)" stroke-width="1.2" />
        <text x="66" y="148" class="node-mono" text-anchor="middle">File System</text>
        <text x="66" y="156" class="node-micro" text-anchor="middle">Edit / Grep</text>

        <rect x="124" y="132" width="72" height="30" rx="3" fill="var(--ie-surface)" stroke="var(--ie-rule)" stroke-width="1.2" />
        <text x="160" y="148" class="node-mono" text-anchor="middle">Terminal / VM</text>
        <text x="160" y="156" class="node-micro" text-anchor="middle">Bash Exec</text>

        <rect x="218" y="132" width="72" height="30" rx="3" fill="var(--ie-surface)" stroke="var(--ie-rule)" stroke-width="1.2" />
        <text x="254" y="148" class="node-mono" text-anchor="middle">MCP Servers</text>
        <text x="254" y="156" class="node-micro" text-anchor="middle">Remote Ext</text>
      </g>
    )}

    {/* 8. CODING TIMELINE COMPARISON */}
    {mode === 'coding-timeline' && (
      <g class="schematic-group">
        <!-- Dual Timeline Rails -->
        <line x1="40" y1="60" x2="280" y2="60" stroke="var(--ie-rule-strong)" stroke-width="2" />
        <line x1="40" y1="120" x2="280" y2="120" stroke="var(--ie-blue)" stroke-width="2" />

        <text x="40" y="44" class="node-mono">Codex Track (OpenAI)</text>
        <text x="40" y="104" class="node-mono blue">Claude Track (Anthropic)</text>

        <!-- Milestones Codex -->
        <circle cx="60" cy="60" r="4" fill="var(--ie-surface)" stroke="var(--ie-ink)" stroke-width="1.5" />
        <text x="60" y="74" class="node-micro" text-anchor="middle">2021</text>

        <circle cx="130" cy="60" r="4" fill="var(--ie-surface)" stroke="var(--ie-ink)" stroke-width="1.5" />
        <text x="130" y="74" class="node-micro" text-anchor="middle">2023</text>

        <circle cx="210" cy="60" r="4" fill="var(--ie-surface)" stroke="var(--ie-ink)" stroke-width="1.5" />
        <text x="210" y="74" class="node-micro" text-anchor="middle">2024</text>

        <circle cx="260" cy="60" r="5" fill="var(--ie-ink)" />
        <text x="260" y="74" class="node-micro" text-anchor="middle">2025</text>

        <!-- Milestones Claude -->
