---
/**
 * HeroWorkflowGraph.astro
 *
 * Authentic Directed State-Graph for Karan Mittal's Engineering Studio:
 * - Real nodes, branching edges, circular junction pins, and feedback cycles.
 * - Stage 01: Cognitive Intent & Cost Router (SLM fast path vs Frontier reasoning).
 * - Stage 02: Agent State Machine Runtime with Sandboxed Tool Harness and Schema Invariants.
 * - Stage 03: Closed-Loop Self-Correction Feedback Edge (Validation failure retry).
 * - Stage 04: CI/CD Regression & Eval Policy Gate -> Deterministic Verified Delivery.
 * - 100% semantic tokens (var(--ie-*)), zero raw hex colors, dual-theme compliant.
 */

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<figure class:list={['hero-workflow-figure', className]}>
  <svg
    class="workflow-svg"
    viewBox="0 0 880 480"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-label="Agent Workflows and State Graphs Architecture"
  >
    <defs>
      <!-- Blueprint Arrowhead (Active Blue) -->
      <marker id="wf-arr-blue" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M 2 2 L 8 5 L 2 8" fill="none" stroke="var(--ie-blue)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </marker>

      <!-- Blueprint Arrowhead (Verified Green) -->
      <marker id="wf-arr-green" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M 2 2 L 8 5 L 2 8" fill="none" stroke="var(--ie-verified)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </marker>

      <!-- Blueprint Arrowhead (Constraint / Retry Rust) -->
      <marker id="wf-arr-rust" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M 2 2 L 8 5 L 2 8" fill="none" stroke="var(--ie-rust)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </marker>

      <!-- Subtle Dot Matrix Pattern for Technical Blueprint Background -->
      <pattern id="wf-grid-dots" width="24" height="24" patternUnits="userSpaceOnUse">
        <circle cx="2" cy="2" r="0.8" fill="var(--ie-rule-strong)" opacity="0.45" />
      </pattern>
    </defs>

    <!-- Background Blueprint Canvas with CAD Registration Crosshairs -->
    <rect x="0" y="0" width="880" height="480" rx="10" fill="var(--ie-surface)" stroke="var(--ie-rule)" stroke-width="1" />
    <rect x="0" y="0" width="880" height="480" rx="10" fill="url(#wf-grid-dots)" />

    <!-- Corner CAD Crosshairs (+) -->
    <path d="M 12 20 L 28 20 M 20 12 L 20 28" stroke="var(--ie-muted)" stroke-width="1" opacity="0.5" />
    <path d="M 852 20 L 868 20 M 860 12 L 860 28" stroke="var(--ie-muted)" stroke-width="1" opacity="0.5" />
    <path d="M 12 460 L 28 460 M 20 452 L 20 468" stroke="var(--ie-muted)" stroke-width="1" opacity="0.5" />
    <path d="M 852 460 L 868 460 M 860 452 L 860 468" stroke="var(--ie-muted)" stroke-width="1" opacity="0.5" />

    <!-- Technical Header Telemetry Bar -->
    <g class="wf-telemetry-header">
      <text x="36" y="28" class="wf-mono-tag">STATE GRAPH ENGINE // SPEC: DAG-01</text>
      <text x="844" y="28" text-anchor="end" class="wf-mono-tag">DETERMINISTIC LATENCY // 0-RTT</text>
      <line x1="20" y1="38" x2="860" y2="38" stroke="var(--ie-rule)" stroke-width="1" />
    </g>

    <!-- ============================================================
         NODE 01: USER INTENT / OBJECTIVE ENTRY
         ============================================================ -->
    <g class="wf-node entry-node" transform="translate(320, 52)">
      <rect x="0" y="0" width="240" height="34" rx="17" fill="var(--ie-surface-raised)" stroke="var(--ie-rule-strong)" stroke-width="1.2" />
      <circle cx="16" cy="17" r="4" fill="var(--ie-blue)" />
      <text x="30" y="21" class="wf-node-entry-text">INPUT: USER INTENT &amp; CONTEXT</text>
    </g>

    <!-- Edge: Entry Node -> Cognitive Router -->
    <line x1="440" y1="86" x2="440" y2="108" stroke="var(--ie-blue)" stroke-width="1.6" marker-end="url(#wf-arr-blue)" />

    <!-- ============================================================
         NODE 02: COGNITIVE INTENT ROUTER
         ============================================================ -->
    <g class="wf-node router-node" transform="translate(290, 110)">
      <rect x="0" y="0" width="300" height="48" rx="6" fill="var(--ie-surface)" stroke="var(--ie-blue)" stroke-width="1.5" />
      <rect x="0" y="0" width="300" height="18" rx="6" fill="var(--ie-blue-soft)" opacity="0.4" />
      <text x="12" y="13" class="wf-stage-heading">01 // COGNITIVE ROUTER &amp; TIERED GATE</text>
      <text x="12" y="34" class="wf-node-title">Semantic Classifier &amp; Token Budget Evaluator</text>
    </g>

    <!-- Terminal Pins on Router Node -->
    <circle cx="360" cy="158" r="3.5" fill="var(--ie-blue)" />
    <circle cx="520" cy="158" r="3.5" fill="var(--ie-blue)" />

    <!-- Branching Edges from Router: Left (SLM) & Right (Frontier) -->
    <!-- Edge Left to Fast SLM -->
    <path d="M 360 158 L 360 178 L 220 178 L 220 196" stroke="var(--ie-blue)" stroke-width="1.6" fill="none" marker-end="url(#wf-arr-blue)" />
    <!-- Edge Right to Frontier Reasoning -->
    <path d="M 520 158 L 520 178 L 660 178 L 660 196" stroke="var(--ie-blue)" stroke-width="1.6" fill="none" marker-end="url(#wf-arr-blue)" />

    <!-- Edge Condition Pills -->
    <g transform="translate(240, 170)">
      <rect x="0" y="-9" width="104" height="18" rx="4" fill="var(--ie-surface)" stroke="var(--ie-rule-strong)" stroke-width="1" />
      <text x="6" y="4" class="wf-condition-text">tokens &lt; 4k (90%)</text>
    </g>
    <g transform="translate(545, 170)">
      <rect x="0" y="-9" width="102" height="18" rx="4" fill="var(--ie-surface)" stroke="var(--ie-rule-strong)" stroke-width="1" />
      <text x="6" y="4" class="wf-condition-text">complex synthesis</text>
    </g>

    <!-- ============================================================
         TIER 02: PARALLEL EXECUTION PATHS (SLM vs FRONTIER)
         ============================================================ -->
    <!-- Node: Fast SLM Path (Left) -->
    <g class="wf-node model-node slm" transform="translate(100, 198)">
      <rect x="0" y="0" width="240" height="52" rx="6" fill="var(--ie-surface-raised)" stroke="var(--ie-rule-strong)" stroke-width="1.2" />
      <text x="12" y="21" class="wf-node-title">Fast Specialized Model (SLM)</text>
      <text x="12" y="38" class="wf-node-desc">90% routine calls &bull; &darr; 70% API spend</text>
      <rect x="186" y="8" width="46" height="16" rx="3" fill="var(--ie-verified-soft)" stroke="var(--ie-verified)" stroke-width="0.8" />
      <text x="190" y="19" class="wf-pill-badge green">FAST</text>
    </g>

    <!-- Node: Frontier Reasoning (Right) -->
    <g class="wf-node model-node frontier" transform="translate(540, 198)">
      <rect x="0" y="0" width="240" height="52" rx="6" fill="var(--ie-surface-raised)" stroke="var(--ie-rule-strong)" stroke-width="1.2" />
      <text x="12" y="21" class="wf-node-title">Frontier Reasoning Core</text>
      <text x="12" y="38" class="wf-node-desc">Deep synthesis, edge cases &amp; planning</text>
      <rect x="180" y="8" width="52" height="16" rx="3" fill="var(--ie-blue-soft)" stroke="var(--ie-blue)" stroke-width="0.8" />
      <text x="184" y="19" class="wf-pill-badge blue">DEEP</text>
    </g>

    <!-- Terminal Pins on Models -->
    <circle cx="220" cy="250" r="3.5" fill="var(--ie-blue)" />
    <circle cx="660" cy="250" r="3.5" fill="var(--ie-blue)" />

    <!-- Converging Edges into State Machine Core -->
    <path d="M 220 250 L 220 274 L 380 274 L 380 286" stroke="var(--ie-blue)" stroke-width="1.6" fill="none" marker-end="url(#wf-arr-blue)" />
    <path d="M 660 250 L 660 274 L 500 274 L 500 286" stroke="var(--ie-blue)" stroke-width="1.6" fill="none" marker-end="url(#wf-arr-blue)" />

    <!-- ============================================================
         NODE 03: AGENT STATE MACHINE ENGINE (CENTRAL RUNTIME)
         ============================================================ -->
    <g class="wf-node state-machine-node" transform="translate(260, 288)">
      <rect x="0" y="0" width="360" height="54" rx="6" fill="var(--ie-surface)" stroke="var(--ie-blue)" stroke-width="1.8" />
      <rect x="0" y="0" width="360" height="18" rx="6" fill="var(--ie-blue-soft)" opacity="0.4" />
      <text x="14" y="13" class="wf-stage-heading">02 // AGENT STATE GRAPH RUNTIME</text>
      <text x="14" y="34" class="wf-node-title">Typed Step Machine &amp; Checkpoint Store</text>
      <text x="14" y="47" class="wf-node-desc">Explicit graph transitions &bull; zero infinite loops</text>

      <!-- Feedback Recovery Entry Port Pin (Right side of State Machine) -->
      <circle cx="360" cy="27" r="4.5" fill="var(--ie-rust)" />
    </g>

    <!-- Dual Bus from State Machine to Sub-Executors -->
    <path d="M 330 342 L 330 362 L 230 362 L 230 374" stroke="var(--ie-blue)" stroke-width="1.6" fill="none" marker-end="url(#wf-arr-blue)" />
    <path d="M 550 342 L 550 362 L 650 362 L 650 374" stroke="var(--ie-blue)" stroke-width="1.6" fill="none" marker-end="url(#wf-arr-blue)" />

    <!-- Sub-Executor Node A: Sandboxed Tool Harness -->
    <g class="wf-node tool-node" transform="translate(100, 376)">
      <rect x="0" y="0" width="260" height="42" rx="5" fill="var(--ie-surface-raised)" stroke="var(--ie-rule-strong)" stroke-width="1.2" />
      <text x="12" y="18" class="wf-node-sub-heading">TOOL HARNESS SANDBOX</text>
      <text x="12" y="32" class="wf-node-sub-body">Bash &bull; SQL &bull; AST Parser &bull; Git DAG</text>
    </g>

    <!-- Sub-Executor Node B: Schema & Policy Gate -->
    <g class="wf-node guard-node" transform="translate(520, 376)">
      <rect x="0" y="0" width="260" height="42" rx="5" fill="var(--ie-surface-raised)" stroke="var(--ie-rule-strong)" stroke-width="1.2" />
      <text x="12" y="18" class="wf-node-sub-heading">INVARIANT &amp; POLICY GATE</text>
      <text x="12" y="32" class="wf-node-sub-body">Typed schema validation &bull; policy checks</text>
    </g>

    <!-- Convergence from Tools & Policy to Decision / Gate -->
    <path d="M 230 418 L 230 436 L 400 436" stroke="var(--ie-blue)" stroke-width="1.6" fill="none" />
    <path d="M 650 418 L 650 436 L 480 436" stroke="var(--ie-blue)" stroke-width="1.6" fill="none" />
    <circle cx="440" cy="436" r="4.5" fill="var(--ie-blue)" />

    <!-- ============================================================
         CLOSED-LOOP RECOVERY / FEEDBACK LOOP EDGE (THE PROOF)
         ============================================================ -->
    <!-- Feedback Edge: From Validation Failure back to State Machine -->
    <path
      d="M 650 436 L 800 436 L 800 315 L 624 315"
      stroke="var(--ie-rust)"
      stroke-width="1.8"
      stroke-dasharray="4 3"
      fill="none"
      stroke-linejoin="round"
      stroke-linecap="round"
      marker-end="url(#wf-arr-rust)"
    />

    <!-- Feedback Condition Pill (Masks underlying path cleanly) -->
    <g transform="translate(720, 360)">
      <rect x="0" y="-17" width="156" height="34" rx="4" fill="var(--ie-surface)" stroke="var(--ie-rust)" stroke-width="1.2" />
      <text x="10" y="-3" class="wf-feedback-text">RETRY: FIX &amp; REPLAY</text>
      <text x="10" y="10" class="wf-feedback-sub">Closed-loop recovery (k&le;3)</text>
    </g>

    <!-- ============================================================
         NODE 04: DETERMINISTIC DELIVERY / EVAL VERIFICATION
         ============================================================ -->
    <!-- Edge: Success down to Terminal Node -->
    <line x1="440" y1="436" x2="440" y2="452" stroke="var(--ie-verified)" stroke-width="2" marker-end="url(#wf-arr-green)" />

    <g class="wf-node output-node" transform="translate(250, 454)">
      <rect x="0" y="0" width="380" height="20" rx="4" fill="var(--ie-verified-soft)" stroke="var(--ie-verified)" stroke-width="1.2" />
      <circle cx="12" cy="10" r="3.5" fill="var(--ie-verified)" />
      <text x="24" y="14" class="wf-output-text">DETERMINISTIC VERIFIED PRODUCTION OUTPUT &bull; ZERO DRIFT</text>
    </g>
  </svg>

  <figcaption class="hero-workflow-caption">
    <strong>Deterministic Architecture:</strong> Cognitive routing slashes API spend by 70%, typed state machines eliminate infinite loops through closed-loop retry edges, and schema guardrails guarantee safe production delivery.
  </figcaption>
</figure>

<style>
  .hero-workflow-figure {
    width: 100%;
    max-width: 920px;
    margin: 2.5rem auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    user-select: none;
    padding: 0;
  }

  .workflow-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .hero-workflow-caption {
    font-family: var(--font-diagram);
    font-size: var(--ie-type-ui);
    color: var(--ie-ink-secondary);
    text-align: center;
    margin-top: 1.25rem;
    line-height: 1.55;
    max-width: 760px;
  }

  .hero-workflow-caption strong {
    color: var(--ie-ink);
    font-weight: 600;
  }

  /* Typography within SVG */
  .wf-mono-tag {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 600;
    fill: var(--ie-muted);
    letter-spacing: 0.06em;
  }

  .wf-node-entry-text {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    fill: var(--ie-ink);
    letter-spacing: 0.04em;
  }

  .wf-stage-heading {
    font-family: var(--font-display);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    fill: var(--ie-blue);
  }

  .wf-node-title {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: -0.01em;
    fill: var(--ie-ink);
  }

  .wf-node-desc {
    font-family: var(--font-sans);
    font-size: 10.5px;
    fill: var(--ie-ink-secondary);
  }

  .wf-condition-text {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 600;
    fill: var(--ie-ink);
    letter-spacing: 0.02em;
  }

  .wf-pill-badge {
    font-family: var(--font-mono);
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .wf-pill-badge.green {
    fill: var(--ie-verified);
  }

  .wf-pill-badge.blue {
    fill: var(--ie-blue);
  }

  .wf-node-sub-heading {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    fill: var(--ie-muted);
    letter-spacing: 0.06em;
  }

  .wf-node-sub-body {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    fill: var(--ie-ink);
  }

  .wf-feedback-text {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    fill: var(--ie-rust);
  }

  .wf-feedback-sub {
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 500;
    fill: var(--ie-ink-secondary);
  }

  .wf-output-text {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    fill: var(--ie-verified);
  }
</style>
