---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import YearGroup from '../../components/YearGroup.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';

const allPosts = await getCollection('blog');
const isDev = import.meta.env.DEV;
const posts = allPosts
  .filter((post) => isDev || !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const postsByYear = posts.reduce<Record<string, typeof posts>>((acc, post) => {
  const year = post.data.pubDate.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<Layout title="Writing | Karan Mittal">
  <main class="container">
    <PageHeader
      label="Writing"
      title="Technical Essays"
      description="Long-form writing on deterministic AI, GraphRAG architecture, high-performance systems, and lessons from production MLOps."
      count={posts.length}
      countLabel="essays"
    />

    <div class="timeline">
      {years.map((year) => (
        <YearGroup year={year} count={postsByYear[year].length}>
          {postsByYear[year].map((post) => (
            <BlogPostCard post={post} />
          ))}
        </YearGroup>
      ))}
    </div>
  </main>
</Layout>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
</style>
