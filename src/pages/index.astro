---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';
import { practiceAreas } from '@data/practice';
import { externalWriting } from '@data/publications';
import talksData from '@data/talks.json';
import communitiesData from '@data/communities.json';
import EvidenceTrail from '@components/diagram/home/EvidenceTrail.astro';
import PracticeGlyph from '@components/diagram/home/PracticeGlyph.astro';
import '@styles/practice.css';

const publishedPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestLocalPost = publishedPosts[0];
const externalArticle = externalWriting[0];
const recentTalks = [...talksData.talks]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, latestLocalPost ? 1 : 2);

// Most visible community first.
const communityOrder = ['gdg-cloud-indore', 'mlindore', 'codevipassana'];
const communities = [...communitiesData.communities].sort(
  (a, b) => communityOrder.indexOf(a.id) - communityOrder.indexOf(b.id)
);

const monthYear = (value: Date) =>
  value.toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Layout title={SITE.title} description={SITE.description}>
  <main class="practice-page home-page">
    <section class="band home-hero" aria-labelledby="hero-heading">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1 id="hero-heading">Karan Mittal</h1>
          <p class="hero-role">
            <span>Independent engineer · Co-founder of Dextar</span>
            <span>Organiser, GDG Cloud Indore and ML Indore</span>
          </p>
          <p class="lead">
            I build knowledge graphs and LLM evaluations for teams whose answers have to hold up.
            At <a href="https://dextar.co" target="_blank" rel="noopener">Dextar</a> that means
            tracing material lots and supplier claims through semiconductor supply chains, so every
            answer points back to the record behind it.
          </p>
          <div class="actions">
            <a class="button" href="/contact/">Discuss your problem</a>
            <a class="more-link" href="/publications/">Writing and talks</a>
          </div>
        </div>

        <figure class="hero-portrait">
          <img
            src="/profile.jpg"
            srcset="/profile-400.jpg 400w, /profile.jpg 800w"
            sizes="(max-width: 720px) 200px, 380px"
            alt="Karan Mittal speaking on stage at a Google Developer Groups DevFest"
            width="800"
            height="800"
            fetchpriority="high"
          />
        </figure>
      </div>
    </section>

    <section class="band band--tint" aria-labelledby="recent-heading">
      <div class="wrap rail">
        <h2 id="recent-heading" class="rail-title">Recent work</h2>

        <div class="recent-body">
          <ul class="community-list" aria-label="Communities">
            {communities.map((community) => (
              <li>
                <a class="community" href={community.links[0].url} target="_blank" rel="noopener">
                  <img src={community.icon} alt="" width="44" height="44" loading="lazy" />
                  <span class="community-text">
                    <span class="community-name">{community.name}</span>
                    <span class="community-role">{community.role}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>

          <ul class="proof-list">
            {latestLocalPost && (
              <li class="proof-item">
                <p class="proof-meta">
                  <span>Essay</span>
                  <time datetime={latestLocalPost.data.pubDate.toISOString()}>
                    {monthYear(latestLocalPost.data.pubDate)}
                  </time>
                </p>
                <h3 class="proof-title">
                  <a href={`/writing/${latestLocalPost.id}/`}>{latestLocalPost.data.title}</a>
                </h3>
                <p class="proof-desc">{latestLocalPost.data.description}</p>
              </li>
            )}

            {externalArticle && (
              <li class="proof-item">
                <p class="proof-meta">
                  <span>Published at {externalArticle.publication}</span>
                  <time datetime={externalArticle.pubDate}>
                    {monthYear(new Date(externalArticle.pubDate))}
                  </time>
                </p>
                <h3 class="proof-title">
                  <a href={externalArticle.href} target="_blank" rel="noopener">
                    {externalArticle.title}<span class="proof-mark" aria-hidden="true">&nbsp;&nearr;</span>
                  </a>
                </h3>
                <p class="proof-desc">{externalArticle.description}</p>
              </li>
            )}

            {recentTalks.map((talk) => (
              <li class="proof-item">
                <p class="proof-meta">
                  <span>{talk.type === 'workshop' ? 'Workshop' : 'Talk'} at {talk.event} · {talk.org}</span>
                  <time datetime={talk.date}>{monthYear(new Date(talk.date))}</time>
                </p>
                <h3 class="proof-title">
                  {talk.links[0]
                    ? <a href={talk.links[0].url} target="_blank" rel="noopener">{talk.title}<span class="proof-mark" aria-hidden="true">&nbsp;&nearr;</span></a>
                    : talk.title}
                </h3>
                <p class="proof-desc">{talk.description}</p>
              </li>
            ))}
          </ul>

          <div class="actions">
            <a class="more-link" href="/publications/">All writing and talks</a>
          </div>
        </div>
      </div>
    </section>

    <section id="practice" class="band" aria-labelledby="practice-heading">
      <div class="wrap">
        <div class="rail">
          <h2 id="practice-heading" class="rail-title">What I fix</h2>
          <p class="lead">
            I design graph-grounded knowledge systems and the evaluations that prove them, so every
            answer traces back to evidence and failures surface before users see them.
          </p>
        </div>

        <figure class="fix-figure">
          <EvidenceTrail />
          <figcaption class="dg-caption">
            Illustrative. The answer carries the path that produced it, so anyone can check it.
          </figcaption>
        </figure>

        <ol class="practice-list">
          {practiceAreas.map((area) => (
            <li class="practice-item" id={area.id}>
              <div class="practice-body">
                <h3 class="practice-problem">{area.problem}</h3>
                <p class="practice-intervention">{area.intervention}</p>
              </div>
              <div class="practice-figure">
                <PracticeGlyph kind={area.diagram} />
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="band band--tint" aria-labelledby="closing-heading">
      <div class="wrap">
        <h2 id="closing-heading">What needs to work better?</h2>
        <p class="lead">
          Describe the system, who relies on it, and what a trustworthy answer would look like.
          A few sentences are enough to start.
        </p>
        <div class="actions">
          <a href="/contact/" class="more-link">Start a conversation</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* ---- Hero: who, on the page edge; the portrait beside it ----------- */

  .home-hero {
    padding-top: var(--page-top);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 380px);
    align-items: center;
    gap: var(--gap-group) clamp(2rem, 6vw, 6rem);
  }

  .home-hero h1 {
    margin-bottom: var(--gap-related);
    font-size: var(--ie-type-display);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .hero-role {
    max-width: 52ch;
    margin-bottom: var(--gap-related);
    color: var(--ie-ink);
    font-size: var(--ie-type-body);
    font-weight: 600;
    line-height: 1.4;
  }

  .hero-role span {
    display: block;
  }

  .home-hero .lead {
    max-width: 58ch;
  }

  .hero-portrait {
    margin: 0;
  }

  .hero-portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    border-radius: 18px;
    corner-shape: squircle;
    object-fit: cover;
    object-position: 46% 30%;
  }

  /* Phones: a small portrait above the name, so the first screen shows
     the person and the message together. */
  @media (max-width: 720px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-portrait {
      order: -1;
      width: 200px;
    }
  }

  /* ---- Rail sections ------------------------------------------------ */

  .rail-title {
    margin: 0;
  }

  .rail .lead {
    max-width: 58ch;
  }

  /* ---- Recent work -------------------------------------------------- */

  .community-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--gap-related) 2rem;
    margin: 0 0 var(--gap-group);
    padding: 0;
    list-style: none;
  }

  .community-list li {
    margin: 0;
  }

  .community {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-height: 44px;
    color: var(--ie-ink);
  }

  /* The hairline keeps a dark logo visible on the dark band. */
  .community img {
    flex-shrink: 0;
    border-radius: 10px;
    corner-shape: squircle;
    outline: 1px solid var(--ie-rule-strong);
    outline-offset: -1px;
  }

  .community-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .community-name {
    font-weight: 600;
  }

  .community:hover .community-name {
    color: var(--ie-blue);
  }

  .community-role {
    color: var(--ie-muted);
    font-size: var(--ie-type-small);
  }

  .proof-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ie-rule-strong);
    list-style: none;
  }

  .proof-item {
    margin: 0;
    padding-block: clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid var(--ie-rule-strong);
  }

  .proof-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-bottom: 0.5rem;
    color: var(--ie-muted);
    font-size: var(--ie-type-small);
  }

  .proof-meta span {
    font-weight: 600;
  }

  .proof-title {
    max-width: 44ch;
    margin-bottom: 0.55rem;
    font-size: var(--ie-type-h3);
    line-height: 1.22;
    letter-spacing: -0.02em;
  }

  .proof-title a {
    color: var(--ie-ink);
  }

  .proof-title a:hover {
    color: var(--ie-blue);
  }

  .proof-mark {
    margin-left: 0.3em;
    color: var(--ie-muted);
    font-size: 0.8em;
  }

  .proof-desc {
    max-width: 68ch;
    margin: 0;
    color: var(--ie-ink-secondary);
  }

  /* ---- What I fix: the figure runs the full page width -------------- */

  .fix-figure {
    margin: var(--gap-block) 0;
  }

  .practice-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ie-rule);
    list-style: none;
  }

  .practice-item {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    align-items: center;
    gap: 1.25rem clamp(2rem, 5vw, 4rem);
    padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
    border-bottom: 1px solid var(--ie-rule);
  }

  @media (max-width: 760px) {
    .practice-item {
      grid-template-columns: 1fr;
    }

    .practice-figure {
      max-width: 320px;
    }
  }

  .practice-problem {
    margin-bottom: 0.65rem;
    font-size: var(--ie-type-h3);
    line-height: 1.24;
    letter-spacing: -0.02em;
  }

  .practice-intervention {
    max-width: 68ch;
    margin: 0;
    color: var(--ie-ink-secondary);
  }
</style>
