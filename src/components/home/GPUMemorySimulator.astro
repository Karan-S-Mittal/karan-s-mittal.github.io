---
/**
 * GPUMemorySimulator.astro
 * A Bartosz Ciechanowski-grade interactive hardware & kernel simulator.
 * Readers interactively generate LLM sequence tokens and compare Naive Contiguous VRAM allocation
 * against PagedAttention virtual block tables in real-time.
 */
---

<section class="gpu-sim-instrument" data-gpu-sim aria-labelledby="gpu-sim-title">
  <div class="sim-header">
    <div>
      <p class="sim-kicker">Interactive Hardware Instrument · LLM Memory Wall</p>
      <h3 id="gpu-sim-title">GPU VRAM &amp; PagedAttention Memory Simulator</h3>
    </div>
    <p class="sim-lead">
      LLM inference is bound by memory bandwidth and VRAM fragmentation. Drag tokens or add requests to compare pre-reserved contiguous memory against on-demand virtual page table indexing.
    </p>
  </div>

  <!-- Mode Switcher -->
  <div class="sim-mode-bar" role="tablist" aria-label="Allocation Strategy">
    <button type="button" role="tab" data-sim-mode="paged" class="active" aria-selected="true">
      <span class="mode-tag">RECOMMENDED · vLLM</span>
      <strong>PagedAttention (Virtual Paging)</strong>
      <small>Non-contiguous physical frames · &lt; 4% waste</small>
    </button>
    <button type="button" role="tab" data-sim-mode="naive" aria-selected="false">
      <span class="mode-tag">TRADITIONAL · NAIVE</span>
      <strong>Contiguous Pre-Reservation</strong>
      <small>Pre-allocated max sequence blocks · 60–80% waste</small>
    </button>
  </div>

  <!-- Interactive Controls Plane -->
  <div class="sim-controls-panel">
    <div class="control-group">
      <button type="button" class="sim-btn primary" data-btn-step>
        <span class="btn-icon">&blacktriangleright;</span> Generate Next Token Batch (+16 Tokens)
      </button>
      <button type="button" class="sim-btn secondary" data-btn-add>
        + Spawn New Request
      </button>
      <button type="button" class="sim-btn tertiary" data-btn-reset>
        ↺ Reset VRAM
      </button>
    </div>
    <div class="sim-speed-badge">
      <span class="live-pulse"></span>
      <span class="speed-text" data-sim-status>HARDWARE STATUS: ONLINE (H100 SXM5 80GB VRAM)</span>
    </div>
  </div>

  <!-- Main Hardware Visual Stage -->
  <div class="sim-stage-grid">
    <!-- Left: Virtual Request Queue & Block Table -->
    <div class="sim-pane queue-pane">
      <div class="pane-header">
        <span class="pane-title">LOGICAL REQUEST QUEUE</span>
        <code class="pane-badge" data-queue-count>3 ACTIVE STREAMS</code>
      </div>

      <div class="request-list" data-request-list>
        <!-- Dynamic Request Rows rendered via JS -->
      </div>

      <!-- Virtual to Physical Block Table (Visible in Paged Mode) -->
      <div class="block-table-section" data-block-table-wrap>
        <div class="table-header">
          <span>VIRTUAL BLOCK POINTER TABLE</span>
          <small>vLLM Logical &rarr; Physical Page Index</small>
        </div>
        <div class="table-entries" data-table-entries>
          <!-- Dynamic pointers -->
        </div>
      </div>
    </div>

    <!-- Right: Physical GPU VRAM Memory Matrix (64 Physical Frames: 8x8 Grid) -->
    <div class="sim-pane vram-pane">
      <div class="pane-header">
        <span class="pane-title">PHYSICAL GPU MEMORY MATRIX (64 &times; 16-TOKEN FRAMES)</span>
        <code class="pane-badge" data-vram-addr>ADDR: 0x0000 &rarr; 0x03FF</code>
      </div>

      <div class="vram-matrix" data-vram-grid>
        <!-- 64 Physical Frame Tiles rendered via JS -->
      </div>

      <!-- Legend -->
      <div class="vram-legend">
        <div class="legend-item"><span class="legend-swatch client-0"></span><span>Seq 0 (Req A)</span></div>
        <div class="legend-item"><span class="legend-swatch client-1"></span><span>Seq 1 (Req B)</span></div>
        <div class="legend-item"><span class="legend-swatch client-2"></span><span>Seq 2 (Req C)</span></div>
        <div class="legend-item"><span class="legend-swatch client-3"></span><span>Seq 3 (Req D)</span></div>
        <div class="legend-item"><span class="legend-swatch waste"></span><span class="waste-text">Fragmented Waste</span></div>
        <div class="legend-item"><span class="legend-swatch empty"></span><span>Free VRAM</span></div>
      </div>
    </div>
  </div>

  <!-- Real-Time Hardware Telemetry HUD -->
  <div class="sim-telemetry-grid">
    <div class="telemetry-card">
      <span class="telemetry-label">PHYSICAL VRAM USAGE</span>
      <strong class="telemetry-value" data-stat-vram>24 / 64 Frames</strong>
      <div class="progress-bar"><div class="progress-fill" data-bar-vram style="width: 37.5%"></div></div>
    </div>
    <div class="telemetry-card" data-waste-card>
      <span class="telemetry-label">INTERNAL FRAGMENTATION WASTE</span>
      <strong class="telemetry-value" data-stat-waste>3.1%</strong>
      <div class="progress-bar"><div class="progress-fill rust" data-bar-waste style="width: 3.1%"></div></div>
    </div>
    <div class="telemetry-card">
      <span class="telemetry-label">SERVING CONCURRENCY</span>
      <strong class="telemetry-value" data-stat-throughput>3.4&times; Baseline</strong>
      <span class="telemetry-note" data-stat-note>Zero contiguous reservation lock</span>
    </div>
  </div>

  <!-- Mechanistic Insight Register -->
  <div class="sim-insight-box">
    <span class="insight-tag">MECHANISTIC PROOF</span>
    <p data-sim-insight>
      <strong>PagedAttention</strong> allocates non-contiguous 16-token physical pages on demand as tokens generate. It treats GPU memory like OS virtual memory paging, eliminating internal fragmentation and enabling 3&ndash;4&times; larger batch sizes without GPU Out-of-Memory faults.
    </p>
  </div>
</section>

<script>
  interface ClientRequest {
    id: number;
    name: string;
    tokens: number;
    maxTokens: number;
    colorClass: string;
    physicalPages: number[];
  }

  function initGPUSimulator() {
    document.querySelectorAll<HTMLElement>('[data-gpu-sim]').forEach((root) => {
      let mode: 'paged' | 'naive' = 'paged';
      const TOTAL_FRAMES = 64; // 8x8 grid
      const TOKENS_PER_FRAME = 16;
      const MAX_REQ_TOKENS = 128; // 8 frames max per sequence
      const COLORS = ['client-0', 'client-1', 'client-2', 'client-3'];

      let requests: ClientRequest[] = [
        { id: 0, name: 'Req A (Query)', tokens: 48, maxTokens: 128, colorClass: 'client-0', physicalPages: [] },
        { id: 1, name: 'Req B (Code Gen)', tokens: 32, maxTokens: 128, colorClass: 'client-1', physicalPages: [] },
        { id: 2, name: 'Req C (Summary)', tokens: 16, maxTokens: 128, colorClass: 'client-2', physicalPages: [] },
      ];

      const modeTabs = root.querySelectorAll<HTMLButtonElement>('[data-sim-mode]');
      const btnStep = root.querySelector<HTMLButtonElement>('[data-btn-step]');
      const btnAdd = root.querySelector<HTMLButtonElement>('[data-btn-add]');
      const btnReset = root.querySelector<HTMLButtonElement>('[data-btn-reset]');
      const requestListEl = root.querySelector<HTMLElement>('[data-request-list]');
      const blockTableWrap = root.querySelector<HTMLElement>('[data-block-table-wrap]');
      const tableEntriesEl = root.querySelector<HTMLElement>('[data-table-entries]');
      const vramGridEl = root.querySelector<HTMLElement>('[data-vram-grid]');
      const queueCountEl = root.querySelector<HTMLElement>('[data-queue-count]');
      const statVram = root.querySelector<HTMLElement>('[data-stat-vram]');
      const barVram = root.querySelector<HTMLElement>('[data-bar-vram]');
      const statWaste = root.querySelector<HTMLElement>('[data-stat-waste]');
      const barWaste = root.querySelector<HTMLElement>('[data-bar-waste]');
      const statThroughput = root.querySelector<HTMLElement>('[data-stat-throughput]');
      const statNote = root.querySelector<HTMLElement>('[data-stat-note]');
      const statusText = root.querySelector<HTMLElement>('[data-sim-status]');
      const insightText = root.querySelector<HTMLElement>('[data-sim-insight]');
      const wasteCard = root.querySelector<HTMLElement>('[data-waste-card]');

      function reallocate() {
        // Clear allocations
        requests.forEach((r) => (r.physicalPages = []));
        const frameMap = new Array<string | null>(TOTAL_FRAMES).fill(null);

        if (mode === 'naive') {
          // Naive mode: Each request pre-allocates contiguous maxTokens (8 frames each)
          let currentFrame = 0;
          let oomOccurred = false;

          requests.forEach((req) => {
            const neededFrames = Math.ceil(req.maxTokens / TOKENS_PER_FRAME); // 8 frames
            if (currentFrame + neededFrames <= TOTAL_FRAMES) {
              const activeFrames = Math.ceil(req.tokens / TOKENS_PER_FRAME);
              for (let i = 0; i < neededFrames; i++) {
                const fIdx = currentFrame + i;
                req.physicalPages.push(fIdx);
                // Mark active vs wasted
                frameMap[fIdx] = i < activeFrames ? req.colorClass : 'waste';
              }
              currentFrame += neededFrames;
            } else {
              oomOccurred = true;
            }
          });

          render(frameMap, oomOccurred);
        } else {
          // Paged mode: On-demand allocation in scattered physical frames (realistic hash distribution)
          const freeFrames: number[] = [];
          for (let i = 0; i < TOTAL_FRAMES; i++) freeFrames.push(i);

          // Deterministic shuffle for scattered realistic allocation
          const scatteredOrder = [
            4, 19, 33, 2, 45, 12, 58, 23, 7, 39, 50, 15, 61, 28, 8, 42,
            1, 18, 32, 55, 11, 27, 49, 3, 20, 36, 62, 14, 30, 46, 5, 22,
            0, 16, 31, 54, 10, 26, 48, 63, 13, 29, 44, 6, 21, 37, 59, 17,
            34, 51, 9, 25, 41, 57, 24, 40, 56, 35, 52, 47, 60, 38, 53, 43
          ];

          let scatterIdx = 0;
          let oomOccurred = false;

          requests.forEach((req) => {
            const neededFrames = Math.ceil(req.tokens / TOKENS_PER_FRAME);
            for (let i = 0; i < neededFrames; i++) {
              if (scatterIdx < scatteredOrder.length) {
                const fIdx = scatteredOrder[scatterIdx++];
                req.physicalPages.push(fIdx);
                frameMap[fIdx] = req.colorClass;
              } else {
                oomOccurred = true;
              }
            }
          });

          render(frameMap, oomOccurred);
        }
      }

      function render(frameMap: (string | null)[], oom: boolean) {
        // 1. Render Requests List
        if (requestListEl) {
          requestListEl.innerHTML = requests
            .map((r) => {
              const activePages = Math.ceil(r.tokens / TOKENS_PER_FRAME);
              const maxPages = Math.ceil(r.maxTokens / TOKENS_PER_FRAME);
              return `
              <div class="request-item">
                <div class="req-header">
                  <span class="req-badge ${r.colorClass}">${r.name}</span>
                  <span class="req-tokens">${r.tokens} / ${r.maxTokens} Tokens (${activePages} Pages)</span>
                </div>
                <div class="req-token-track">
                  <div class="req-token-fill ${r.colorClass}" style="width: ${(r.tokens / r.maxTokens) * 100}%"></div>
                </div>
              </div>
            `;
            })
            .join('');
        }

        if (queueCountEl) {
          queueCountEl.textContent = `${requests.length} ACTIVE STREAMS`;
        }

        // 2. Render Virtual Block Table (Paged Mode)
        if (blockTableWrap) {
          blockTableWrap.style.display = mode === 'paged' ? 'block' : 'none';
        }
        if (tableEntriesEl && mode === 'paged') {
          tableEntriesEl.innerHTML = requests
            .map((r) =>
              r.physicalPages
                .map(
                  (pIdx, vIdx) => `
                <div class="table-row">
                  <span class="row-seq ${r.colorClass}">${r.name.slice(0, 5)}:V${vIdx}</span>
                  <span class="row-arrow">&rarr;</span>
                  <span class="row-frame">Frame 0x${pIdx.toString(16).padStart(2, '0').toUpperCase()}</span>
                </div>
              `
                )
                .join('')
            )
            .join('');
        }

        // 3. Render Physical 64-Frame Matrix (8x8)
        if (vramGridEl) {
          vramGridEl.innerHTML = frameMap
            .map((state, idx) => {
              const hex = '0x' + idx.toString(16).padStart(2, '0').toUpperCase();
              let cls = 'vram-tile';
              if (state) cls += ` ${state}`;
              return `<div class="${cls}" title="Physical Frame ${hex}"><span class="tile-addr">${hex}</span></div>`;
            })
            .join('');
        }

        // 4. Calculate Telemetry
        let totalActiveTokens = requests.reduce((acc, r) => acc + r.tokens, 0);
        let actualFramesUsed = requests.reduce((acc, r) => acc + Math.ceil(r.tokens / TOKENS_PER_FRAME), 0);
        let reservedFrames = mode === 'naive' ? requests.length * 8 : actualFramesUsed;

        if (statVram && barVram) {
          const pct = Math.min(100, Math.round((reservedFrames / TOTAL_FRAMES) * 100));
          statVram.textContent = `${reservedFrames} / ${TOTAL_FRAMES} Frames (${pct}%)`;
          barVram.style.width = `${pct}%`;
        }

        if (statWaste && barWaste && wasteCard) {
          let wastePct = 0;
          if (mode === 'naive') {
            const wastedFrames = reservedFrames - actualFramesUsed;
            wastePct = reservedFrames > 0 ? Math.round((wastedFrames / reservedFrames) * 100) : 0;
            statWaste.textContent = `${wastePct}% (${reservedFrames - actualFramesUsed} Wasted Frames)`;
            statWaste.style.color = 'var(--ie-rust)';
            barWaste.style.width = `${wastePct}%`;
            wasteCard.classList.add('waste-highlight');
          } else {
            // Paged mode internal fragmentation on last page only
            const lastPageWastedTokens = requests.reduce((acc, r) => {
              const rem = r.tokens % TOKENS_PER_FRAME;
              return acc + (rem === 0 ? 0 : TOKENS_PER_FRAME - rem);
            }, 0);
            wastePct = totalActiveTokens > 0 ? Math.round((lastPageWastedTokens / (actualFramesUsed * TOKENS_PER_FRAME)) * 100) : 0;
            statWaste.textContent = `${wastePct}% (< 4% boundary)`;
            statWaste.style.color = 'var(--ie-ink)';
            barWaste.style.width = `${Math.max(4, wastePct)}%`;
            wasteCard.classList.remove('waste-highlight');
          }
        }

        if (statThroughput && statNote) {
          if (mode === 'paged') {
            statThroughput.textContent = '3.8× Concurrency';
            statNote.textContent = 'Near-zero memory fragmentation';
          } else {
            statThroughput.textContent = '1.0× Baseline';
            statNote.textContent = 'Pre-reserved contiguous blocks';
          }
        }

        if (statusText) {
          if (oom) {
            statusText.textContent = 'HARDWARE ALERT: GPU OUT OF MEMORY (OOM) ABORT!';
            statusText.style.color = 'var(--ie-rust)';
          } else {
            statusText.textContent = `HARDWARE STATUS: ONLINE (${mode.toUpperCase()} MODE ACTIVE)`;
            statusText.style.color = 'var(--ie-ink)';
          }
        }

        if (insightText) {
          if (mode === 'naive') {
            insightText.innerHTML = `
              <strong>Naive Contiguous Allocation:</strong> Every request pre-allocates memory for its maximum potential sequence length (128 tokens = 8 physical frames). Over <strong>70% of reserved VRAM sits completely idle</strong>, triggering premature GPU Out-of-Memory faults while hardware capacity is still largely empty.
            `;
          } else {
            insightText.innerHTML = `
              <strong>PagedAttention Virtual Table:</strong> Physical GPU frames are allocated dynamically in 16-token page chunks only when generated. Physical memory is non-contiguous, exactly like OS virtual memory paging. <strong>Waste drops to &lt; 4%</strong>, enabling 3&ndash;4&times; higher multi-tenant serving throughput.
            `;
          }
        }
      }

      // Step Sequence: Generate tokens across requests
      if (btnStep) {
        btnStep.addEventListener('click', () => {
          requests.forEach((r) => {
            if (r.tokens < r.maxTokens) {
              r.tokens = Math.min(r.maxTokens, r.tokens + 16);
            }
          });
          reallocate();
        });
      }

      // Add New Client Request
      if (btnAdd) {
        btnAdd.addEventListener('click', () => {
          if (requests.length >= 4) {
            alert('Max 4 concurrent requests in simulation preview.');
            return;
          }
          const nextId = requests.length;
          const labels = ['Req A', 'Req B', 'Req C', 'Req D'];
          requests.push({
            id: nextId,
            name: `${labels[nextId]} (Interactive)`,
            tokens: 16,
            maxTokens: 128,
            colorClass: COLORS[nextId % COLORS.length],
            physicalPages: [],
          });
          reallocate();
        });
      }

      // Reset VRAM
      if (btnReset) {
        btnReset.addEventListener('click', () => {
          requests = [
            { id: 0, name: 'Req A (Query)', tokens: 48, maxTokens: 128, colorClass: 'client-0', physicalPages: [] },
            { id: 1, name: 'Req B (Code Gen)', tokens: 32, maxTokens: 128, colorClass: 'client-1', physicalPages: [] },
            { id: 2, name: 'Req C (Summary)', tokens: 16, maxTokens: 128, colorClass: 'client-2', physicalPages: [] },
          ];
          reallocate();
        });
      }

      // Mode Switcher
      modeTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const targetMode = tab.dataset.simMode as 'paged' | 'naive';
          if (targetMode === mode) return;
          mode = targetMode;

          modeTabs.forEach((t) => {
            const isActive = t === tab;
            t.classList.toggle('active', isActive);
            t.setAttribute('aria-selected', String(isActive));
          });

          reallocate();
        });
      });

      // Initial execution
      reallocate();
    });
  }

  initGPUSimulator();
  document.addEventListener('astro:page-load', initGPUSimulator);
</script>

<style>
  .gpu-sim-instrument {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin-top: 1rem;
  }

  .sim-header {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: end;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--ie-rule);
  }

  .sim-kicker {
    margin: 0 0 0.5rem;
    color: var(--ie-blue);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .sim-header h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    font-weight: 500;
    line-height: 1.15;
    color: var(--ie-ink);
  }

  .sim-lead {
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: 0.96rem;
    line-height: 1.6;
  }

  /* Mode Bar */
  .sim-mode-bar {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--ie-rule-strong);
    background: var(--ie-surface);
  }

  .sim-mode-bar button {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    padding: 1.25rem 1.5rem;
    border: 0;
    border-right: 1px solid var(--ie-rule);
    background: transparent;
    text-align: left;
    cursor: pointer;
    transition: background-color 120ms ease;
  }

  .sim-mode-bar button:last-child {
    border-right: none;
  }

  .mode-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ie-muted);
  }

  .sim-mode-bar strong {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ie-ink);
  }

  .sim-mode-bar small {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ie-muted);
  }

  .sim-mode-bar button.active {
    background: var(--ie-blue-soft);
    box-shadow: inset 0 -3px 0 var(--ie-blue);
  }

  .sim-mode-bar button.active .mode-tag,
  .sim-mode-bar button.active strong {
    color: var(--ie-blue);
  }

  /* Controls Panel */
  .sim-controls-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--ie-surface-raised);
    border-bottom: 1px solid var(--ie-rule);
    flex-wrap: wrap;
  }

  .control-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .sim-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--ie-ink);
    border-radius: var(--radius, 6px);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 120ms ease;
  }

  .sim-btn.primary {
    background: var(--ie-ink);
    color: var(--ie-canvas);
  }

  .sim-btn.primary:hover {
    border-color: var(--ie-blue);
    background: var(--ie-blue);
    color: #fff;
  }

  .sim-btn.secondary {
    background: var(--ie-surface);
    color: var(--ie-ink);
  }

  .sim-btn.secondary:hover {
    border-color: var(--ie-blue);
    color: var(--ie-blue);
  }

  .sim-btn.tertiary {
    border-color: var(--ie-rule);
    background: transparent;
    color: var(--ie-muted);
  }

  .sim-btn.tertiary:hover {
    border-color: var(--ie-rust);
    color: var(--ie-rust);
  }

  .sim-speed-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .live-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ie-blue);
    box-shadow: 0 0 0 3px rgba(40, 87, 217, 0.2);
  }

  .speed-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--ie-ink);
  }

  /* Stage Grid */
  .sim-stage-grid {
    display: grid;
    grid-template-columns: minmax(320px, 0.95fr) minmax(420px, 1.05fr);
    border: 1px solid var(--ie-rule);
    border-top: none;
    background: var(--ie-surface);
  }

  .sim-pane {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .queue-pane {
    border-right: 1px solid var(--ie-rule);
  }

  .pane-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--ie-rule);
  }

  .pane-title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ie-muted);
  }

  .pane-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--ie-blue);
    font-weight: 600;
  }

  /* Request Rows */
  .request-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .request-item {
    padding: 0.75rem;
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius, 6px);
    background: var(--ie-surface-raised);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .req-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .req-badge {
