---
import VisualPage from '@layouts/VisualPage.astro';
import SemiconductorTraceabilityGraph from '@components/diagram/SemiconductorTraceabilityGraph.astro';
import { getDiagramBySlug } from '@data/diagrams';

const diagram = getDiagramBySlug('semiconductor-traceability')!;
---

<VisualPage
  title={diagram.title}
  description={diagram.description}
  explanation={diagram.explanation}
  targetId={diagram.targetId}
  filename={diagram.filename}
  category={diagram.category}
  drawingNo={diagram.canonicalId}
>
  <div class="diagram-scroll">
    <SemiconductorTraceabilityGraph id="semiconductor-traceability-download" />
  </div>
</VisualPage>

<style>
  .diagram-scroll { width: 100%; }

  @media (max-width: 680px) {
    .diagram-scroll {
      width: 760px;
      max-width: none;
    }
  }
</style>
