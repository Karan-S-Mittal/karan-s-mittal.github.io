</ExcalidrawContainer>

<script>
  function initPagedStepsInteractive() {
    const tabs = document.querySelectorAll('.ex-step-tab');
    const desc = document.getElementById('ex-step-desc');
    const groups = {
      s1: document.getElementById('step-group-s1'),
      s2: document.getElementById('step-group-s2'),
      s3: document.getElementById('step-group-s3'),
      s4: document.getElementById('step-group-s4'),
    };
    const connectors = [
      document.getElementById('conn-s1-s2-a'),
      document.getElementById('conn-s1-s2-b'),
      document.getElementById('conn-s2-s3-a'),
      document.getElementById('conn-s2-s3-b'),
      document.getElementById('conn-s3-s4-a'),
      document.getElementById('conn-s3-s4-b'),
    ];

    const descriptions: Record<string, string> = {
      all: '<strong>Complete Architecture:</strong> Virtual tokens sliced into logical blocks, translated via Block Table to scattered HBM frames, gathered in GPU SRAM.',
      s1: '<strong>Step 1 (Virtual Blocks):</strong> Continuous tokens are partitioned into fixed-size logical blocks (e.g. 4 tokens). No future memory is pre-allocated.',
      s2: '<strong>Step 2 (Block Table):</strong> Like an OS page table, the Block Table maintains virtual-to-physical pointer translations in constant O(1) time.',
      s3: '<strong>Step 3 (Scattered HBM):</strong> Physical frames are allocated on demand across GPU memory. Non-contiguous storage eliminates external fragmentation (0% waste).',
      s4: '<strong>Step 4 (In-Kernel Gather):</strong> CUDA/Triton kernels stream non-contiguous KV vectors straight into on-chip SRAM during GEMM without tensor copying.',
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target') || 'all';

        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        if (desc && descriptions[target]) {
          desc.innerHTML = descriptions[target];
        }

        // Highlight/dim corresponding svg groups
        Object.entries(groups).forEach(([key, el]) => {
          if (!el) return;
          if (target === 'all' || target === key) {
            el.style.opacity = '1';
            el.style.filter = 'none';
          } else {
            el.style.opacity = '0.18';
            el.style.filter = 'grayscale(0.8)';
          }
        });

        connectors.forEach((conn) => {
          if (!conn) return;
          conn.style.opacity = target === 'all' ? '1' : '0.2';
        });
      });
    });
  }

  // Initialize on load and on astro page transitions
  initPagedStepsInteractive();
  document.addEventListener('astro:page-load', initPagedStepsInteractive);
</script>

<style>
  .ex-steps-nav {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 0.85rem;
    justify-content: center;
  }

  .ex-step-tab {
    background: var(--ex-card-bg);
    color: var(--ex-text-muted);
    border: 1px solid var(--ex-border);
    border-radius: 6px;
    padding: 0.35rem 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .ex-step-tab:hover {
    color: var(--ex-text-main);
    border-color: var(--ex-blue-stroke);
  }

  .ex-step-tab.active {
    background: var(--ex-blue-bg);
    color: var(--ex-blue-text);
    border-color: var(--ex-blue-stroke);
  }

  .ex-step-explainer {
    background: var(--ex-gray-bg);
    border: 1px solid var(--ex-border);
    border-radius: 6px;
    padding: 0.6rem 0.85rem;
    font-size: 0.86rem;
    color: var(--ex-text-main);
    line-height: 1.45;
    margin-bottom: 1rem;
    min-height: 2.8rem;
    display: flex;
    align-items: center;
  }

  .step-group {
    transition: opacity 0.25s ease, filter 0.25s ease;
  }
</style>
