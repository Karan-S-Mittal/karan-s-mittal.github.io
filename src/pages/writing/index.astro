---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/content/PageHeader.astro';
import YearGroup from '@components/content/YearGroup.astro';
import { externalWriting } from '@data/publications';

const allPosts = await getCollection('blog');
const isDev = import.meta.env.DEV;

interface UnifiedWritingItem {
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  href: string;
  source: string;
  external: boolean;
  tags: string[];
}

const localPosts: UnifiedWritingItem[] = allPosts
  .filter((post) => isDev || !post.data.draft)
  .map((post) => ({
    id: post.id,
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    href: `/writing/${post.id}/`,
    source: 'ON-SITE ESSAY',
    external: false,
    tags: post.data.tags || [],
  }));

const extEntries: UnifiedWritingItem[] = externalWriting.map((item) => ({
  id: item.href,
  title: item.title,
  description: item.description,
  pubDate: new Date(item.pubDate),
  href: item.href,
  source: `PUBLISHED AT ${item.publication.toUpperCase()}`,
  external: true,
  tags: ['Coding Agents', 'Harness Architecture', 'Evaluation'],
}));

const allWriting = [...localPosts, ...extEntries].sort(
  (a, b) => b.pubDate.valueOf() - a.pubDate.valueOf()
);

const writingByYear = allWriting.reduce<Record<string, UnifiedWritingItem[]>>((acc, item) => {
  const year = item.pubDate.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(item);
  return acc;
}, {});

const years = Object.keys(writingByYear).sort((a, b) => Number(b) - Number(a));
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<Layout
  title="Writing and systems notes | Karan Mittal"
  description="Evidence-backed essays and technical publications on version control, AI systems, distributed infrastructure, and performance engineering."
>
  <main class="container writing-page">
    <PageHeader
      label="Writing"
      title="Writing and systems notes."
      description="Evidence-backed explanations of version control, AI systems, distributed infrastructure, and performance engineering."
      count={allWriting.length}
      countLabel="published essays & articles"
    />

    <div class="archive-list" id="writing-timeline">
      {years.length > 0 ? (
        years.map((year) => (
          <YearGroup year={year} count={writingByYear[year].length} unit="article">
            <div class="writing-items-stream">
              {writingByYear[year].map((item) => (
                <article class="writing-stream-card">
                  <div class="writing-card-header">
                    <span class="source-tag">{item.source}</span>
                    <span class="meta-sep" aria-hidden="true">&bull;</span>
                    <time datetime={item.pubDate.toISOString()}>{formatDate(item.pubDate)}</time>
                  </div>
                  <h3 class="writing-card-title">
                    <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined}>
                      <span>{item.title}</span>
                      {item.external && <span class="ext-icon" aria-hidden="true">↗</span>}
                    </a>
                  </h3>
                  <p class="writing-card-desc">{item.description}</p>
                  {item.tags.length > 0 && (
                    <div class="writing-tags">
                      {item.tags.map((tag) => (
                        <span class="tag-pill">{tag}</span>
                      ))}
                    </div>
                  )}
                </article>
              ))}
            </div>
          </YearGroup>
        ))
      ) : (
        <div class="empty-blog-state">
          <p>No essays published yet. Starting afresh.</p>
        </div>
      )}
    </div>
  </main>
</Layout>

<style>
  .writing-page {
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }

  .writing-items-stream {
    display: flex;
    flex-direction: column;
  }

  .writing-stream-card {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--ie-rule);
  }

  .writing-stream-card:last-child {
    border-bottom: none;
  }

  .writing-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
  }

  .source-tag {
    font-weight: 700;
    color: var(--ie-blue);
    letter-spacing: 0.04em;
  }

  .meta-sep {
    color: var(--ie-rule-strong);
  }

  .writing-card-header time {
    color: var(--ie-muted);
  }

  .writing-card-title {
    margin: 0 0 0.55rem;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .writing-card-title a {
    color: var(--ie-ink);
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    transition: color 140ms ease;
  }

  .writing-card-title a:hover {
    color: var(--ie-blue);
  }

  .ext-icon {
    font-size: 0.9em;
    color: var(--ie-muted);
  }

  .writing-card-desc {
    max-width: 68ch;
    margin: 0 0 0.85rem;
    color: var(--ie-ink-secondary);
    font-family: var(--font-sans);
    font-size: var(--ie-type-body);
    line-height: 1.62;
  }

  .writing-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-pill {
    padding: 0.15rem 0.5rem;
    background: var(--ie-surface-raised);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-sm, 4px);
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    color: var(--ie-muted);
    letter-spacing: 0.02em;
  }

  .empty-blog-state {
    padding: 3rem 0;
    color: var(--ie-muted);
    font-family: var(--font-sans);
    font-size: var(--ie-type-body);
  }
</style>
