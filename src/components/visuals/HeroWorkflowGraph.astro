---
/**
 * HeroWorkflowGraph.astro
 *
 * Clean, unboxed systems architecture workflow:
 * - 01 / Intelligent Cost & Model Router (Saves money, cuts API bills)
 * - 02 / Agent State-Graph Engine (Gets models to obey, structured execution)
 * - 03 / CI/CD Eval & Safety Gate (MLOps, regression testing, safe deployment)
 *
 * Design updates:
 * - High-contrast, prominent connector pill badges with 10.5px bold font.
 * - Precision stealth blueprint arrowheads (8x8 viewBox, stroke-width 1.5).
 * - Calibrated stage columns and zero text overflow.
 * - Standard semantic <figcaption> centered below the artwork.
 * - 100% semantic tokens (var(--ie-*)), zero raw hex colors.
 */

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<figure class:list={['hero-workflow-figure', className]}>
  <svg
    class="workflow-svg"
    viewBox="0 0 820 306"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <defs>
      <!-- Precision Blueprint Arrowhead (Active Blue) -->
      <marker id="wf-arr-blue" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M 1.5 1.5 L 6.5 4 L 1.5 6.5" fill="none" stroke="var(--ie-blue)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </marker>

      <!-- Precision Blueprint Arrowhead (Verified Green) -->
      <marker id="wf-arr-green" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M 1.5 1.5 L 6.5 4 L 1.5 6.5" fill="none" stroke="var(--ie-verified)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
    </defs>

    <!-- ============================================================
         STAGE 01: MODEL & COST ROUTER (Saves Money)
         ============================================================ -->
    <g class="wf-stage stage-1">
      <!-- Main Stage Container -->
      <rect x="10" y="16" width="240" height="216" rx="6" fill="var(--ie-surface)" stroke="var(--ie-blue)" stroke-width="1.5" />

      <!-- Stage Header Bar -->
      <path d="M 10 22 A 6 6 0 0 1 16 16 L 244 16 A 6 6 0 0 1 250 22 L 250 48 L 10 48 Z" fill="var(--ie-blue-soft)" opacity="0.4" />
      <text x="22" y="37" class="wf-stage-heading">01 / MODEL &amp; COST ROUTER</text>

      <!-- Sub-Card A: Fast / Cheap Model -->
      <g transform="translate(22, 58)">
        <rect x="0" y="0" width="216" height="44" rx="4" fill="var(--ie-surface-raised)" stroke="var(--ie-rule)" stroke-width="1" />
        <text x="12" y="19" class="wf-sub-title">Fast Language Model (SLM)</text>
        <text x="12" y="33" class="wf-sub-desc">90% routine tasks &bull; 10x cheaper</text>
      </g>

      <!-- Sub-Card B: Heavy Reasoning Model -->
      <g transform="translate(22, 110)">
        <rect x="0" y="0" width="216" height="44" rx="4" fill="var(--ie-surface-raised)" stroke="var(--ie-rule)" stroke-width="1" />
        <text x="12" y="19" class="wf-sub-title">Frontier Reasoning Model</text>
        <text x="12" y="33" class="wf-sub-desc">Deep synthesis &amp; edge cases</text>
      </g>

      <!-- Sub-Card C: Savings Outcome Badge -->
      <g transform="translate(22, 162)">
        <rect x="0" y="0" width="216" height="44" rx="4" fill="var(--ie-verified-soft)" stroke="var(--ie-verified)" stroke-width="1.2" />
        <text x="12" y="19" class="wf-metric-pill green">&darr; 70% LOWER API BILLS</text>
        <text x="12" y="33" class="wf-sub-desc">Semantic caching &amp; compaction</text>
      </g>
    </g>

    <!-- Connector: Stage 1 to Stage 2 -->
    <line x1="250" y1="124" x2="286" y2="124" stroke="var(--ie-blue)" stroke-width="1.6" marker-end="url(#wf-arr-blue)" />
    <g transform="translate(270, 96)">
      <rect x="-24" y="-10" width="48" height="20" rx="4" fill="var(--ie-surface)" stroke="var(--ie-rule-strong)" stroke-width="1" />
      <text x="0" y="4" class="wf-connector-pill" text-anchor="middle">ROUTE</text>
    </g>

    <!-- ============================================================
         STAGE 02: AGENT STATE GRAPH (Gets Models to Obey)
         ============================================================ -->
    <g class="wf-stage stage-2">
      <!-- Main Stage Container -->
      <rect x="290" y="16" width="240" height="216" rx="6" fill="var(--ie-surface)" stroke="var(--ie-blue)" stroke-width="1.5" />

      <!-- Stage Header Bar -->
      <path d="M 290 22 A 6 6 0 0 1 296 16 L 524 16 A 6 6 0 0 1 530 22 L 530 48 L 290 48 Z" fill="var(--ie-blue-soft)" opacity="0.4" />
      <text x="302" y="37" class="wf-stage-heading">02 / AGENT STATE GRAPH</text>

      <!-- Sub-Card A: Structured Execution Plan -->
      <g transform="translate(302, 58)">
        <rect x="0" y="0" width="216" height="44" rx="4" fill="var(--ie-surface-raised)" stroke="var(--ie-rule)" stroke-width="1" />
        <text x="12" y="19" class="wf-sub-title">Structured Schema Plan</text>
        <text x="12" y="33" class="wf-sub-desc">Typed state &amp; validated steps</text>
      </g>

      <!-- Sub-Card B: Tool Execution Sandbox -->
      <g transform="translate(302, 110)">
        <rect x="0" y="0" width="216" height="44" rx="4" fill="var(--ie-surface-raised)" stroke="var(--ie-rule)" stroke-width="1" />
        <text x="12" y="19" class="wf-sub-title">Sandboxed Tool Harness</text>
        <text x="12" y="33" class="wf-sub-desc">Policy gates for SQL, bash &amp; APIs</text>
      </g>

      <!-- Sub-Card C: Reliability Badge -->
      <g transform="translate(302, 162)">
        <rect x="0" y="0" width="216" height="44" rx="4" fill="var(--ie-surface-raised)" stroke="var(--ie-rule-strong)" stroke-width="1.2" />
        <text x="12" y="19" class="wf-metric-pill blue">CLOSED-LOOP RECOVERY</text>
        <text x="12" y="33" class="wf-sub-desc">Zero runaway infinite loops</text>
      </g>
    </g>

    <!-- Connector: Stage 2 to Stage 3 -->
    <line x1="530" y1="124" x2="566" y2="124" stroke="var(--ie-blue)" stroke-width="1.6" marker-end="url(#wf-arr-blue)" />
    <g transform="translate(550, 96)">
      <rect x="-28" y="-10" width="56" height="20" rx="4" fill="var(--ie-surface)" stroke="var(--ie-rule-strong)" stroke-width="1" />
      <text x="0" y="4" class="wf-connector-pill" text-anchor="middle">EXECUTE</text>
    </g>

    <!-- ============================================================
         STAGE 03: MLOPS EVAL HARNESS (Safe Production DevOps)
         ============================================================ -->
    <g class="wf-stage stage-3">
      <!-- Main Stage Container -->
      <rect x="570" y="16" width="240" height="216" rx="6" fill="var(--ie-surface)" stroke="var(--ie-verified)" stroke-width="1.5" />

      <!-- Stage Header Bar -->
      <path d="M 570 22 A 6 6 0 0 1 576 16 L 804 16 A 6 6 0 0 1 810 22 L 810 48 L 570 48 Z" fill="var(--ie-verified-soft)" opacity="0.45" />
      <text x="582" y="37" class="wf-stage-heading green">03 / MLOPS EVAL HARNESS</text>

      <!-- Sub-Card A: Continuous Regression Evals -->
      <g transform="translate(582, 58)">
        <rect x="0" y="0" width="216" height="44" rx="4" fill="var(--ie-surface-raised)" stroke="var(--ie-rule)" stroke-width="1" />
        <text x="12" y="19" class="wf-sub-title">Continuous Regression Evals</text>
        <text x="12" y="33" class="wf-sub-desc">Gold-set benchmarks in CI/CD</text>
      </g>

      <!-- Sub-Card B: Live Telemetry -->
      <g transform="translate(582, 110)">
        <rect x="0" y="0" width="216" height="44" rx="4" fill="var(--ie-surface-raised)" stroke="var(--ie-rule)" stroke-width="1" />
        <text x="12" y="19" class="wf-sub-title">Production Telemetry</text>
        <text x="12" y="33" class="wf-sub-desc">Drift &amp; hallucination detectors</text>
      </g>

      <!-- Sub-Card C: Safe Gate Badge -->
      <g transform="translate(582, 162)">
        <rect x="0" y="0" width="216" height="44" rx="4" fill="var(--ie-verified-soft)" stroke="var(--ie-verified)" stroke-width="1.2" />
        <text x="12" y="19" class="wf-metric-pill green">&check; SAFE PRODUCTION GATE</text>
        <text x="12" y="33" class="wf-sub-desc">Ship updates with zero outages</text>
      </g>
    </g>

    <!-- Connector: Stage 3 to Production Delivery -->
    <path d="M 690 232 L 690 252 L 410 252 L 410 263" stroke="var(--ie-verified)" stroke-width="1.6" fill="none" marker-end="url(#wf-arr-green)" />
    <circle cx="690" cy="252" r="2.5" fill="var(--ie-verified)" />
    <g transform="translate(550, 252)">
      <rect x="-28" y="-10" width="56" height="20" rx="4" fill="var(--ie-surface)" stroke="var(--ie-rule-strong)" stroke-width="1" />
      <text x="0" y="4" class="wf-connector-pill green" text-anchor="middle">VERIFIED</text>
    </g>

    <!-- Bottom Destination: Deterministic Production Output -->
    <g transform="translate(230, 265)">
      <rect x="0" y="0" width="360" height="32" rx="6" fill="var(--ie-surface)" stroke="var(--ie-verified)" stroke-width="1.5" />
      <circle cx="18" cy="16" r="4" fill="var(--ie-verified)" />
      <text x="32" y="20" class="wf-destination-title">RELIABLE PRODUCTION DELIVERY &bull; CONTROLLED SPEND</text>
    </g>
  </svg>

  <figcaption class="hero-workflow-caption">
    <strong>Architecture:</strong> Smart model routing cuts API bills by up to 70%, state graphs prevent infinite loops, and CI/CD evals test changes before production.
  </figcaption>
</figure>

<style>
  .hero-workflow-figure {
    width: 100%;
    max-width: 860px;
    margin: 2.5rem auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    user-select: none;
    padding: 0;
  }

  .workflow-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .hero-workflow-caption {
    font-family: var(--font-diagram);
    font-size: var(--ie-type-ui);
    color: var(--ie-ink-secondary);
    text-align: center;
    margin-top: 1.25rem;
    line-height: 1.55;
    max-width: 680px;
  }

  .hero-workflow-caption strong {
    color: var(--ie-ink);
    font-weight: 600;
  }

  /* Typography within SVG */
  .wf-stage-heading {
    font-family: var(--font-display);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    fill: var(--ie-blue);
  }

  .wf-stage-heading.green {
    fill: var(--ie-verified);
  }

  .wf-sub-title {
    font-family: var(--font-display);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    fill: var(--ie-ink);
  }

  .wf-sub-desc {
    font-family: var(--font-diagram);
    font-size: 10px;
    fill: var(--ie-ink-secondary);
  }

  .wf-metric-pill {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .wf-metric-pill.green {
    fill: var(--ie-verified);
  }

  .wf-metric-pill.blue {
    fill: var(--ie-blue);
  }

  .wf-connector-pill {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;
    fill: var(--ie-ink);
  }

  .wf-connector-pill.green {
    fill: var(--ie-verified);
  }

  .wf-destination-title {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    fill: var(--ie-verified);
  }
</style>
