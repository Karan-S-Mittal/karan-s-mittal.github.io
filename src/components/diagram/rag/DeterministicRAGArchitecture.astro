---
/**
 * DeterministicRAGArchitecture.astro
 * HTML/CSS-native 3-plane systems architecture diagram for Deterministic RAG & Replay Contracts.
 */
import Exhibit from '../../editorial/Exhibit.astro';

interface Props {
  caption?: string;
  exhibit?: string;
  title?: string;
}

const {
  caption = 'An auditable RAG system compiles an immutable replay contract across three execution planes: (1) versioned corpus and index artifacts, (2) deterministic hybrid retrieval with strict tie-breaking rules, and (3) an immutable evidence bundle trace with regression diffing.',
  exhibit = '01',
  title = 'The 3-Plane Deterministic RAG Replay Architecture',
} = Astro.props;
---

<Exhibit exhibit={exhibit} title={title} badge="RETRIEVAL ARCHITECTURE" caption={caption} wide>
  <div class="rag-root">
    <!-- PLANE 1: IMMUTABLE ARTIFACT LAYER -->
    <div class="rag-plane plane-artifacts">
      <div class="rplane-header">
        <span class="rplane-tag">01 / IMMUTABLE ARTIFACT REGISTRY</span>
        <span class="rplane-desc">Versioned, cryptographically hashed inputs required before query execution</span>
      </div>

      <div class="rag-cards-grid cols-3">
        <div class="rcard">
          <span class="rcard-tag">CORPUS SNAPSHOT</span>
          <h4 class="rcard-title">sha256:7f3a9e...</h4>
          <p class="rcard-desc">Pinned document collection with frozen chunk boundaries.</p>
        </div>

        <div class="rcard">
          <span class="rcard-tag">EMBEDDING ARTIFACT</span>
          <h4 class="rcard-title">Model Checkpoint v2</h4>
          <p class="rcard-desc">Deterministic tokenizer, pooling logic, and L2 normalization.</p>
        </div>

        <div class="rcard">
          <span class="rcard-tag">INDEX BUILD ID</span>
          <h4 class="rcard-title">HNSW M=32, ef=128</h4>
          <p class="rcard-desc">Frozen proximity graph index with fixed search hyperparameters.</p>
        </div>
      </div>
    </div>

    <!-- CONNECTOR 1 -->
    <div class="rag-connector">
      <span class="rconn-line"></span>
      <span class="rconn-pill">QUERY DISPATCH (Q_HASH) &rarr; DETERMINISTIC EXECUTION</span>
      <span class="rconn-line"></span>
    </div>

    <!-- PLANE 2: DETERMINISTIC HYBRID RETRIEVAL -->
    <div class="rag-plane plane-retrieval">
      <div class="rplane-header">
        <div class="rplane-title-group">
          <span class="rplane-tag tag-signal">02 / DETERMINISTIC HYBRID RETRIEVAL PLANE</span>
          <span class="rplane-desc">Vector Recall &bull; Graph Relational Traversal &bull; Deterministic Ranking</span>
        </div>
        <span class="tiebreak-pill">Tie-Break: Score DESC &rarr; DocID ASC</span>
      </div>

      <div class="rag-cards-grid cols-2">
        <div class="rcard rcard-active">
          <div class="rcard-top">
            <span class="rcard-badge">PATH A / VECTOR RECALL</span>
            <span class="rcard-status">k = 20 Candidates</span>
          </div>
          <h4 class="rcard-title">HNSW Graph Traversal</h4>
          <p class="rcard-desc">Approximate nearest-neighbor candidate selection with fixed seed &amp; ef_search.</p>
        </div>

        <div class="rcard rcard-active">
          <div class="rcard-top">
            <span class="rcard-badge">PATH B / GRAPHRAG RELATIONAL</span>
            <span class="rcard-status">Hierarchical Clusters</span>
          </div>
          <h4 class="rcard-title">Entity &amp; Community Traversal</h4>
          <p class="rcard-desc">Multi-hop relational expansion linking entities to verified source passages.</p>
        </div>
      </div>
    </div>

    <!-- CONNECTOR 2 -->
    <div class="rag-connector">
      <span class="rconn-line"></span>
      <span class="rconn-pill">CANDIDATE RANKING &rarr; AUDITABLE TRACE EMISSION</span>
      <span class="rconn-line"></span>
    </div>

    <!-- PLANE 3: AUDITABLE REPLAY RECORD -->
    <div class="rag-plane plane-trace">
      <div class="rplane-header">
        <span class="rplane-tag">03 / AUDITABLE REPLAY RECORD &amp; TRACE</span>
        <span class="rplane-desc">Immutable evidence bundle emitted for regression testing and CI verification</span>
      </div>

      <div class="trace-box">
        <div class="trace-item">
          <span class="t-key">Query Hash:</span>
          <span class="t-val">0x8f2d...</span>
        </div>
        <div class="trace-item">
          <span class="t-key">Context Bundle:</span>
          <span class="t-val">[Doc #104 (Score: 0.94), Doc #088 (Score: 0.91), Doc #312 (Score: 0.89)]</span>
        </div>
        <div class="trace-item">
          <span class="t-key">CI Delta Test:</span>
          <span class="t-val val-pass">&check; Zero Context Drift Against Baseline</span>
        </div>
      </div>
    </div>

    <!-- NOTICE LEADER -->
    <div class="rag-notice">
      <span class="notice-arrow">&larr;</span>
      <span>Notice how versioning the index artifact and enforcing a deterministic tie-breaking policy turns probabilistic retrieval into an auditable evidence contract.</span>
    </div>
  </div>
</Exhibit>

<style>
  .rag-root {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--surface-card);
    border-radius: var(--radius-card);
  }

  .rag-plane {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: calc(var(--radius-card) - 4px);
    border: 1px solid var(--border-default);
  }

  .plane-artifacts {
    background: color-mix(in srgb, var(--text) 3%, var(--bg));
  }

  .plane-retrieval {
    background: color-mix(in srgb, var(--accent) 5%, var(--bg));
    border-color: color-mix(in srgb, var(--accent) 25%, var(--border-default));
  }

  .plane-trace {
    background: var(--bg);
  }

  .rplane-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .rplane-title-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .rplane-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .tag-signal { color: var(--accent); }

  .rplane-desc {
    font-size: 12px;
    color: var(--text-muted);
  }

  .tiebreak-pill {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    padding: 3px 8px;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 4px;
    color: var(--accent);
  }

  .rag-cards-grid {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 600px) {
    .rag-cards-grid.cols-3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .rag-cards-grid.cols-2 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .rcard {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-3) var(--space-4);
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 8px;
  }

  .rcard-active {
    border-color: color-mix(in srgb, var(--accent) 30%, var(--border-default));
  }

  .rcard-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .rcard-tag, .rcard-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .rcard-badge { color: var(--accent); }

  .rcard-status {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    padding: 2px 6px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border-radius: 4px;
    color: var(--accent);
  }

  .rcard-title {
    margin: 2px 0 0;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text);
  }

  .rcard-desc {
    margin: 0;
    font-size: 11.5px;
    line-height: 1.45;
    color: var(--text-muted);
  }

  /* CONNECTORS */
  .rag-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: 2px 0;
  }

  .rconn-line {
    flex: 1;
    height: 1px;
    background: var(--border-default);
  }

  .rconn-pill {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 3px 10px;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 12px;
    color: var(--accent);
  }

  /* TRACE BOX */
  .trace-box {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-3) var(--space-4);
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .trace-item {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .t-key {
    font-weight: 700;
    color: var(--text-muted);
  }

  .t-val {
    color: var(--text);
  }

  .val-pass {
    color: var(--accent);
    font-weight: 700;
  }

  .rag-notice {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-muted);
    padding-top: var(--space-2);
    border-top: 1px dashed var(--border-default);
  }

  .notice-arrow {
    font-weight: 700;
    color: var(--accent);
  }
</style>
