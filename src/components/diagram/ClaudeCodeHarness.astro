---
/**
 * ClaudeCodeHarness.astro
 * Minimalist architecture diagram of the Claude Code local harness execution loop.
 *
 * Core subsystems:
 * 1. User Terminal (CLI) - Entry point for prompts and SIGINT interrupts
 * 2. Claude Code Harness perimeter:
 *    - Model Engine (Claude 3.7 Sonnet / CoT reasoning)
 *    - Permission Pipeline (PreToolUse security gate: Deny > Ask)
 *    - Tool Runner (Host execution: read, edit, grep, bash)
 *    - Context Compaction (5-layer buffer trimming & ephemeral subagents)
 *
 * Visual principles:
 * - 100% token compliant (zero raw hex).
 * - Ultra-minimal text: high-signal tokens, zero prose paragraphs.
 * - Icons prominently sized (18-20px) relative to compact labels.
 * - Longer blueprint connectors (var(--ie-blue)) with generous drops.
 * - Single constraint node in rust (var(--ie-rust)) for Permission Pipeline.
 * - Standard <VisualAttribution /> box in the bottom right corner.
 */
import {
  Terminal,
  Cpu,
  ShieldAlert,
  Wrench,
  Layers,
  RefreshCw,
  Search,
  SquarePen,
  FileCode,
  CornerDownRight,
  CornerLeftUp,
} from '@lucide/astro';
import BrandIcon from './icons/BrandIcon.astro';
import VisualAttribution from './VisualAttribution.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['claude-harness-root', className]}>
  <div class="claude-harness-canvas diagram-canvas" id="claude-code-harness">
    <!-- ================= 1. USER TERMINAL (CLI) ================= -->
    <div class="terminal-node">
      <div class="node-head">
        <div class="node-icon">
          <Terminal size={18} stroke-width={1.5} />
        </div>
        <div class="node-titles">
          <h3 class="node-name">User Terminal (CLI)</h3>
          <span class="node-sub">Interactive Developer Shell</span>
        </div>
        <span class="node-badge">STDIN / STDOUT</span>
      </div>

      <div class="token-row">
        <span class="token-chip"><code>prompt</code> user intent</span>
        <span class="token-sep">·</span>
        <span class="token-chip"><code>SIGINT</code> interrupt</span>
        <span class="token-sep">·</span>
        <span class="token-chip"><code>escape</code> abort</span>
      </div>
    </div>

    <!-- Long Connector: Terminal -> Harness -->
    <div class="long-bridge" aria-hidden="true">
      <div class="stem-wire stem-top"></div>
      <span class="bridge-pill">Prompt · Interrupt Stream</span>
      <div class="stem-wire stem-bottom">
        <svg class="arrow-svg" viewBox="0 0 10 14">
          <path d="M1,3 L5,11 L9,3" fill="none" stroke="var(--ie-blue)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
    </div>

    <!-- ================= 2. CLAUDE CODE HARNESS ================= -->
    <div class="harness-perimeter">
      <!-- Harness Perimeter Header -->
      <div class="harness-head">
        <div class="brand-group">
          <div class="brand-icon-box">
            <BrandIcon name="claude" size={18} />
          </div>
          <div class="harness-titles">
            <h3 class="harness-name">Claude Code Harness</h3>
            <span class="harness-sub">Local Execution Runtime Perimeter</span>
          </div>
        </div>
        <span class="harness-badge">LOCAL HARNESS</span>
      </div>

      <!-- Core 4-Subsystem Topology Matrix -->
      <div class="subsystems-matrix">
        <!-- TOP ROW: Model Engine (Left) & Permission Pipeline (Right) -->
        <div class="matrix-row">
          <!-- 1. Model Engine -->
          <div class="subsystem-card card-model">
            <div class="card-head">
              <div class="sub-icon icon-claude">
                <Cpu size={18} stroke-width={1.5} />
              </div>
              <div class="sub-titles">
                <h4 class="sub-name">Model Engine</h4>
                <span class="sub-role">Claude 3.7 Sonnet</span>
              </div>
            </div>
            <div class="chips-list">
              <div class="chip-item">
                <span class="bullet-dot"></span>
                <span><code>reasoning</code> Adaptive CoT</span>
              </div>
              <div class="chip-item">
                <span class="bullet-dot"></span>
                <span><code>tool-call</code> Invocation request</span>
              </div>
            </div>
          </div>

          <!-- Long Horizontal Bridge: PreToolUse -->
          <div class="long-horiz-bridge" aria-hidden="true">
            <span class="bridge-tag">PreToolUse</span>
            <svg class="horiz-wire-svg" viewBox="0 0 74 14">
              <line x1="2" y1="7" x2="64" y2="7" stroke="var(--ie-blue)" stroke-width="1.4" />
              <path d="M59,3 L65,7 L59,11" fill="none" stroke="var(--ie-blue)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>

          <!-- 2. Permission Pipeline -->
          <div class="subsystem-card card-permission">
            <div class="card-head">
              <div class="sub-icon icon-rust">
                <ShieldAlert size={18} stroke-width={1.5} />
              </div>
              <div class="sub-titles">
                <h4 class="sub-name">Permission Pipeline</h4>
                <span class="sub-role role-rust">Security Filter</span>
              </div>
              <span class="tag-rust">APPROVAL</span>
            </div>
            <div class="chips-list">
              <div class="chip-item">
                <span class="bullet-dot dot-rust"></span>
                <span><code>policy</code> Deny &gt; Ask</span>
              </div>
              <div class="chip-item">
                <span class="bullet-dot dot-rust"></span>
                <span><code>sandbox</code> Shell gate</span>
              </div>
            </div>
          </div>
        </div>

        <!-- VERTICAL INTER-TIER CONNECTORS (Elongated arrows) -->
        <div class="matrix-transit-row" aria-hidden="true">
          <!-- Left Column: Closed-loop Bidirectional Channel -->
          <div class="transit-col-left">
            <div class="dual-channel">
              <div class="channel-wire wire-return">
                <svg class="transit-vert-svg" viewBox="0 0 10 40">
                  <line x1="5" y1="36" x2="5" y2="8" stroke="var(--ie-blue)" stroke-width="1.4" />
                  <path d="M1,12 L5,4 L9,12" fill="none" stroke="var(--ie-blue)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="transit-pill pill-return">Context Feed</span>
              </div>
              <div class="channel-wire wire-down">
                <span class="transit-pill pill-post">PostToolUse</span>
                <svg class="transit-vert-svg" viewBox="0 0 10 40">
                  <line x1="5" y1="4" x2="5" y2="32" stroke="var(--ie-blue)" stroke-width="1.4" />
                  <path d="M1,28 L5,36 L9,28" fill="none" stroke="var(--ie-blue)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
            </div>
          </div>

          <!-- Center Blank Spacer -->
          <div class="transit-spacer"></div>

          <!-- Right Column: Approved Tool Execution Drop -->
          <div class="transit-col-right">
            <div class="single-channel">
              <div class="transit-stem stem-right-top"></div>
              <span class="transit-pill pill-approved">Approved</span>
              <div class="transit-stem stem-right-bottom">
                <svg class="transit-vert-svg" viewBox="0 0 10 24">
                  <line x1="5" y1="2" x2="5" y2="16" stroke="var(--ie-blue)" stroke-width="1.4" />
                  <path d="M1,12 L5,20 L9,12" fill="none" stroke="var(--ie-blue)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
            </div>
          </div>
        </div>

        <!-- BOTTOM ROW: Context Compaction (Left) & Tool Runner (Right) -->
        <div class="matrix-row">
          <!-- 4. Context Compaction -->
          <div class="subsystem-card card-compaction">
            <div class="card-head">
              <div class="sub-icon">
                <Layers size={18} stroke-width={1.5} />
              </div>
              <div class="sub-titles">
                <h4 class="sub-name">Context Compaction</h4>
                <span class="sub-role">State Management</span>
              </div>
            </div>
            <div class="chips-list">
              <div class="chip-item">
                <span class="bullet-dot"></span>
                <span><code>5-layer</code> Buffer trim</span>
              </div>
              <div class="chip-item">
                <span class="bullet-dot"></span>
                <span><code>subagent</code> Ephemeral fork</span>
              </div>
            </div>
          </div>

          <!-- Long Horizontal Bridge: Outputs Return -->
          <div class="long-horiz-bridge" aria-hidden="true">
            <svg class="horiz-wire-svg" viewBox="0 0 74 14">
              <line x1="72" y1="7" x2="10" y2="7" stroke="var(--ie-blue)" stroke-width="1.4" />
              <path d="M15,3 L9,7 L15,11" fill="none" stroke="var(--ie-blue)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="bridge-tag">Tool Outputs</span>
          </div>

          <!-- 3. Tool Runner -->
          <div class="subsystem-card card-tools">
            <div class="card-head">
              <div class="sub-icon">
                <Wrench size={18} stroke-width={1.5} />
              </div>
              <div class="sub-titles">
                <h4 class="sub-name">Tool Runner</h4>
                <span class="sub-role">Host Substrate</span>
              </div>
            </div>
            <div class="chips-list">
              <div class="chip-item">
                <span class="bullet-dot"></span>
                <span><code>Read / Edit</code> Exact lines</span>
              </div>
              <div class="chip-item">
                <span class="bullet-dot"></span>
                <span><code>Grep / Bash</code> Sandboxed CLI</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Attributed Signature Box in Artwork Corner -->
    <div class="corner-attribution">
      <VisualAttribution author="karansmittal" />
    </div>
  </div>
</div>

<style>
  .claude-harness-root {
    width: 100%;
    margin: 0 auto;
    font-family: var(--font-diagram);
    color: var(--ie-ink);
  }

  .claude-harness-canvas {
    position: relative;
    width: 100%;
    background-color: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card);
    padding: clamp(1.25rem, 3.5vw, 2.25rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
  }

  /* ================= 1. USER TERMINAL NODE ================= */
  .terminal-node {
    width: 100%;
    max-width: 680px;
    background: var(--ie-canvas);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card);
    padding: 0.85rem 1.15rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .node-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .node-icon {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ie-blue);
    flex-shrink: 0;
  }

  .node-titles {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .node-name {
    font-size: var(--ie-type-ui);
    font-weight: 600;
    margin: 0;
    line-height: 1.25;
    color: var(--ie-ink);
  }

  .node-sub {
    font-size: var(--ie-type-micro);
    color: var(--ie-muted);
    line-height: 1.2;
  }

  .node-badge {
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    font-weight: 500;
    color: var(--ie-muted);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    padding: 0.12rem 0.45rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    letter-spacing: 0.03em;
  }

  .token-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--ie-type-label);
    color: var(--ie-ink-secondary);
    padding-top: 0.35rem;
    border-top: 1px dashed var(--ie-rule);
    flex-wrap: wrap;
  }

  .token-chip {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    white-space: nowrap;
  }

  .token-sep {
    color: var(--ie-rule-strong);
  }

  code {
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    padding: 0.05rem 0.32rem;
    border-radius: 4px;
    color: var(--ie-ink);
    white-space: nowrap;
  }

  /* ================= LONG BLUEPRINT BRIDGES ================= */
  .long-bridge {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 680px;
    margin: 0.35rem 0;
  }

  .stem-wire {
    width: 1.5px;
    background: var(--ie-blue);
  }

  .stem-top {
    height: 14px;
  }

  .stem-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 16px;
  }

  .arrow-svg {
    width: 10px;
    height: 14px;
    display: block;
  }

  .bridge-pill {
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    font-weight: 600;
    color: var(--ie-ink);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule-strong);
    padding: 0.18rem 0.75rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
  }

  /* ================= 2. CLAUDE CODE HARNESS ================= */
  .harness-perimeter {
    width: 100%;
    max-width: 680px;
    background: var(--ie-canvas);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card);
    padding: 1.25rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .harness-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--ie-rule);
  }

  .brand-group {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand-icon-box {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-sm);
    background: var(--ie-surface);
    border: 1px solid var(--brand-anthropic-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-anthropic);
    flex-shrink: 0;
  }

  .harness-titles {
    display: flex;
    flex-direction: column;
  }

  .harness-name {
    margin: 0;
    font-size: var(--ie-type-ui);
    font-weight: 600;
    color: var(--ie-ink);
    line-height: 1.25;
  }

  .harness-sub {
    font-size: var(--ie-type-micro);
    color: var(--ie-muted);
    line-height: 1.2;
  }

  .harness-badge {
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    color: var(--brand-anthropic-ink);
    background: var(--brand-anthropic-soft);
    border: 1px solid var(--brand-anthropic-border);
    padding: 0.12rem 0.5rem;
    border-radius: var(--radius-pill);
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  /* ================= SUBSYSTEMS MATRIX ================= */
  .subsystems-matrix {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .matrix-row {
    display: grid;
    grid-template-columns: 1fr 88px 1fr;
    align-items: center;
  }

  .subsystem-card {
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: 6px;
    padding: 0.85rem 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    box-sizing: border-box;
  }

  .card-permission {
    border-color: var(--ie-rule-strong);
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .sub-icon {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-sm);
    background: var(--ie-canvas);
    border: 1px solid var(--ie-rule);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ie-ink-secondary);
    flex-shrink: 0;
  }

  .sub-icon.icon-claude {
    color: var(--brand-anthropic);
  }

  .sub-icon.icon-rust {
    color: var(--ie-rust);
    border-color: var(--ie-rust);
    background: var(--ie-rust-soft);
  }

  .sub-titles {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .sub-name {
    margin: 0;
    font-size: var(--ie-type-label);
    font-weight: 600;
    color: var(--ie-ink);
    line-height: 1.25;
    white-space: nowrap;
  }

  .sub-role {
    font-size: var(--ie-type-micro);
    color: var(--ie-muted);
    line-height: 1.2;
    white-space: nowrap;
  }

  .role-rust {
    color: var(--ie-rust);
  }

  .tag-rust {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 600;
    color: var(--ie-rust);
    background: var(--ie-canvas);
    border: 1px solid var(--ie-rust);
    padding: 0.08rem 0.35rem;
    border-radius: 3px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .chips-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .chip-item {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: var(--ie-type-label);
    color: var(--ie-ink-secondary);
    line-height: 1.3;
    white-space: nowrap;
  }

  .bullet-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--ie-muted);
    flex-shrink: 0;
    margin-top: 0.4rem;
  }

  .dot-rust {
    background: var(--ie-rust);
  }

  /* Horizontal bridges */
  .long-horiz-bridge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    width: 88px;
  }

  .bridge-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--ie-ink);
    white-space: nowrap;
  }

  .horiz-wire-svg {
    width: 74px;
    height: 14px;
    display: block;
  }

  /* Vertical inter-tier transit (Elongated arrows) */
  .matrix-transit-row {
    display: grid;
    grid-template-columns: 1fr 88px 1fr;
    height: 60px;
    align-items: center;
  }

  .transit-col-left {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  .dual-channel {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .channel-wire {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
  }

  .transit-vert-svg {
    width: 10px;
    height: 38px;
    display: block;
  }

  .transit-col-right {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  .single-channel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .transit-stem {
    width: 1.5px;
    background: var(--ie-blue);
  }

  .stem-right-top {
    height: 8px;
  }

  .stem-right-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .transit-pill {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    color: var(--ie-muted);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    padding: 0.08rem 0.45rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    line-height: 1.2;
  }

  .pill-return {
    color: var(--ie-blue);
  }

  .pill-post {
    color: var(--ie-muted);
  }

  .pill-approved {
    color: var(--ie-verified);
  }

  /* ================= CORNER ATTRIBUTION ================= */
  .corner-attribution {
    width: 100%;
    max-width: 680px;
    display: flex;
    justify-content: flex-end;
    margin-top: 1rem;
  }

  /* ================= RESPONSIVE ================= */
  @media (max-width: 640px) {
    .matrix-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .long-horiz-bridge,
    .matrix-transit-row {
      display: none;
    }

    .token-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }
  }
</style>
