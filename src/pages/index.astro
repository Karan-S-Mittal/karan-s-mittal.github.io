---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';
import { practiceAreas } from '@data/practice';
import { externalWriting } from '@data/publications';
import talksData from '@data/talks.json';
import EvidenceTrail from '@components/diagram/home/EvidenceTrail.astro';
import PracticeGlyph from '@components/diagram/home/PracticeGlyph.astro';
import '@styles/practice.css';

const publishedPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestLocalPost = publishedPosts[0];
const externalArticle = externalWriting[0];
const latestTalk = [...talksData.talks].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
)[0];

const monthYear = (value: Date) =>
  value.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
---

<Layout title={SITE.title} description={SITE.description}>
  <main class="practice-page home-page">
    <header class="home-hero" aria-labelledby="hero-heading">
      <h1 id="hero-heading">Knowledge systems that show their work.</h1>
      <figure class="hero-figure">
        <EvidenceTrail />
        <figcaption class="dg-caption">
          Illustrative. The answer carries the path that produced it, so anyone can check it.
        </figcaption>
      </figure>
      <p class="lead">
        I design graph-grounded knowledge systems and the evaluations that prove them, so
        every answer traces back to evidence and failures surface before users see them.
      </p>
      <div class="hero-actions">
        <a class="button" href="/contact/">Discuss your problem</a>
        <a class="more-link" href="#practice">What I fix</a>
      </div>
    </header>

    <section id="practice" class="section" aria-labelledby="practice-heading">
      <div class="section-header">
        <span class="register">What I fix</span>
        <h2 id="practice-heading">Where knowledge systems lose the thread.</h2>
      </div>

      <ol class="practice-list">
        {practiceAreas.map((area) => (
          <li class="practice-item" id={area.id}>
            <div class="practice-body">
              <h3 class="practice-problem">{area.problem}</h3>
              <p class="practice-intervention">{area.intervention}</p>
            </div>
            <div class="practice-figure">
              <PracticeGlyph kind={area.diagram} />
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="proof" class="section" aria-labelledby="proof-heading">
      <div class="section-header">
        <span class="register">Publications</span>
        <h2 id="proof-heading">Recent writing and talks.</h2>
      </div>

      <ul class="proof-list">
        {externalArticle && (
          <li class="proof-item">
            <p class="proof-meta">
              <span>Published at {externalArticle.publication}</span>
              <time datetime={externalArticle.pubDate}>
                {monthYear(new Date(externalArticle.pubDate))}
              </time>
            </p>
            <h3 class="proof-title">
              <a href={externalArticle.href} target="_blank" rel="noopener">
                {externalArticle.title}<span class="proof-mark" aria-hidden="true">&nbsp;&nearr;</span>
              </a>
            </h3>
            <p class="proof-desc">{externalArticle.description}</p>
          </li>
        )}

        {latestTalk && (
          <li class="proof-item">
            <p class="proof-meta">
              <span>{latestTalk.type === 'workshop' ? 'Workshop' : 'Talk'} · {latestTalk.org}</span>
              <time datetime={latestTalk.date}>{monthYear(new Date(latestTalk.date))}</time>
            </p>
            <h3 class="proof-title">
              {latestTalk.links[0]
                ? <a href={latestTalk.links[0].url} target="_blank" rel="noopener">{latestTalk.title}<span class="proof-mark" aria-hidden="true">&nbsp;&nearr;</span></a>
                : latestTalk.title}
            </h3>
            <p class="proof-desc">{latestTalk.description}</p>
          </li>
        )}
        {latestLocalPost && (
          <li class="proof-item">
            <p class="proof-meta">
              <span>On-site essay</span>
              <time datetime={latestLocalPost.data.pubDate.toISOString()}>
                {monthYear(latestLocalPost.data.pubDate)}
              </time>
            </p>
            <h3 class="proof-title">
              <a href={`/writing/${latestLocalPost.id}/`}>{latestLocalPost.data.title}</a>
            </h3>
            <p class="proof-desc">{latestLocalPost.data.description}</p>
          </li>
        )}
      </ul>

      <div class="proof-actions">
        <a class="more-link" href="/publications/">All publications</a>
      </div>
    </section>

    <section class="section closing" aria-labelledby="closing-heading">
      <div class="closing-copy">
        <span class="register">Start a conversation</span>
        <h2 id="closing-heading">What needs to work better?</h2>
        <p class="lead">
          Describe the system, who relies on it, and what a trustworthy answer would look like.
          A few sentences are enough to start.
        </p>
        <div class="actions">
          <a href="/contact/" class="more-link">Start a conversation</a>
          <a href="/about/" class="more-link">About me</a>
        </div>
      </div>
      <figure class="closing-portrait">
        <img
          src="/profile-400.jpg"
          srcset="/profile-400.jpg 400w, /profile.jpg 800w"
          sizes="(max-width: 720px) 60vw, 300px"
          alt="Karan Mittal leading a technical workshop"
          width="400"
          height="400"
          loading="lazy"
        />
      </figure>
    </section>
  </main>
</Layout>

<style>
  /* ---- Hero -------------------------------------------------------- */

  .home-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: clamp(5rem, 11vw, 9rem) 0;
    text-align: center;
  }

  .home-hero h1 {
    max-width: 18ch;
    margin-bottom: 1.25rem;
    font-size: var(--ie-type-display);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .home-hero .lead {
    max-width: 52ch;
    margin-bottom: 0;
    color: var(--ie-muted);
    font-size: var(--ie-type-body);
    line-height: 1.45;
  }

  /* Wider than the text column, like a product image under hero copy. The
     hero is a centred flex column, so the overflow spreads evenly. */
  .hero-figure {
    width: min(1100px, calc(100vw - 3rem));
    max-width: none;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 clamp(2.5rem, 5vw, 3.5rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.75rem;
    margin-top: 2.25rem;
  }

  /* ---- Shared section header --------------------------------------- */

  .section-header {
    max-width: 720px;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .closing .lead,
  .section-header .lead {
    max-width: 62ch;
  }

  /* ---- Closing: invitation beside a portrait ------------------------ */

  .closing {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(200px, 300px);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .practice-page .closing > * {
    max-width: none;
  }

  .closing-portrait {
    margin: 0;
  }

  .closing-portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    border-radius: 18px;
    corner-shape: squircle;
    object-fit: cover;
    object-position: 64% 28%;
  }

  @media (max-width: 720px) {
    .closing {
      grid-template-columns: 1fr;
    }

    .closing-portrait {
      max-width: 240px;
    }
  }

  /* ---- What I fix -------------------------------------------------- */

  .practice-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ie-rule);
    list-style: none;
  }

  .practice-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    align-items: center;
    gap: 1.25rem clamp(2rem, 5vw, 4rem);
    padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
    border-bottom: 1px solid var(--ie-rule);
  }

  @media (max-width: 760px) {
    .practice-item {
      grid-template-columns: 1fr;
    }

    .practice-figure {
      max-width: 320px;
    }
  }

  .practice-problem {
    margin-bottom: 0.65rem;
    font-size: var(--ie-type-h3);
    line-height: 1.24;
    letter-spacing: -0.02em;
  }

  .practice-intervention {
    max-width: 68ch;
    margin: 0;
    color: var(--ie-ink-secondary);
  }

  /* ---- Direct proof ------------------------------------------------ */

  .proof-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ie-rule);
    list-style: none;
  }

  .proof-item {
    padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
    border-bottom: 1px solid var(--ie-rule);
  }

  .proof-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 0.5rem;
    color: var(--ie-muted);
    font-size: var(--ie-type-small);
  }

  .proof-meta span {
    font-weight: 600;
  }

  .proof-title {
    max-width: 40ch;
    margin-bottom: 0.55rem;
    font-size: var(--ie-type-h3);
    line-height: 1.22;
    letter-spacing: -0.02em;
  }

  .proof-title a {
    color: var(--ie-ink);
    text-decoration: none;
  }

  .proof-title a:hover {
    color: var(--ie-blue);
  }

  .proof-mark {
    margin-left: 0.3em;
    color: var(--ie-muted);
    font-size: 0.8em;
  }

  .proof-desc {
    max-width: 68ch;
    margin: 0;
    color: var(--ie-ink-secondary);
  }

  .proof-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2rem;
    margin-top: 1.25rem;
  }
</style>
