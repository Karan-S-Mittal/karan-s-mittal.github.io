        </g>
        <path d="M152 108 H180" class="edge-blue" marker-end={`url(#${id}-m1-arr-blue)`} />
        <text x="166" y="100" text-anchor="middle" class="edge-label">feeds</text>
        <g transform="translate(188 84)">
          <rect width="144" height="48" rx="6" class="node-surface" />
          <text x="12" y="22" class="node-title">Controller assembly</text>
          <text x="12" y="38" class="node-note">line · product family</text>
        </g>
      </svg>
    </div>

    <!-- Stage 02 Mobile Card -->
    <div class="mobile-stage-card mobile-stage-2">
      <div class="mobile-stage-header">
        <span class="mobile-stage-num">02</span>
        <span class="mobile-stage-name">PFAS evidence</span>
      </div>
      <svg class="mobile-stage-svg" viewBox="0 0 340 148" fill="none" xmlns="http://www.w3.org/2000/svg" role="img">
        <defs>
          <marker id={`${id}-m2-arr-green`} viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M1.5 1.5 6.5 4 1.5 6.5" fill="none" stroke="var(--ie-verified)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </marker>
        </defs>
        <g transform="translate(8 12)">
          <rect width="144" height="48" rx="6" class="node-surface" />
          <text x="12" y="22" class="node-title">Part + material</text>
          <text x="12" y="38" class="node-note">identity · supplier · lot</text>
        </g>
        <path d="M152 36 H180" class="edge-green" marker-end={`url(#${id}-m2-arr-green)`} />
        <text x="166" y="28" text-anchor="middle" class="edge-label">scope</text>
        <g transform="translate(188 12)">
          <rect width="144" height="48" rx="6" class="node-surface" />
          <text x="12" y="22" class="node-title">Supplier evidence</text>
          <text x="12" y="38" class="node-note">declaration · revision</text>
        </g>
        <path d="M260 60 V74 H80 V84" class="edge-green" marker-end={`url(#${id}-m2-arr-green)`} />
        <text x="170" y="71" text-anchor="middle" class="edge-label">screen</text>
        <g transform="translate(8 84)">
          <rect width="144" height="48" rx="6" class="node-surface" />
          <text x="12" y="22" class="node-title">PFAS assessment</text>
          <text x="12" y="38" class="node-note">substance · threshold</text>
        </g>
        <path d="M152 108 H180" class="edge-green" marker-end={`url(#${id}-m2-arr-green)`} />
        <text x="166" y="100" text-anchor="middle" class="edge-label">record</text>
        <g transform="translate(188 84)">
          <rect width="144" height="48" rx="6" class="node-verified" />
          <text x="12" y="22" class="node-title">Evidence register</text>
          <text x="12" y="38" class="node-note">claim · confidence</text>
        </g>
      </svg>
    </div>

    <!-- Stage 03 Mobile Card -->
    <div class="mobile-stage-card mobile-stage-3">
      <div class="mobile-stage-header">
        <span class="mobile-stage-num">03</span>
        <span class="mobile-stage-name">Cost of quality</span>
