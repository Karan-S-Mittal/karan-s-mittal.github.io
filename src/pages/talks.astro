---
import Layout from '../layouts/Layout.astro';
import talksData from '../data/talks.json';

const { talks } = talksData;

// Sort chronologically: newest first
const sortedTalks = [...talks].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const hasAnyLinks = sortedTalks.some(t => t.links && t.links.length > 0);

const formatDate = (iso: string) => {
  const d = new Date(iso + 'T00:00:00');
  return d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
};
---

<Layout title="Talks | Karan Mittal">
  <main class="container">
    <p class="label">Talks &amp; Workshops</p>
    <h1 style="margin-bottom: 1rem;">Speaking</h1>
    <p style="color: var(--muted); margin-bottom: 3rem; max-width: 600px;">
      I speak at conferences, meetups, and workshops on AI architecture, GraphRAG, deterministic systems, and MLOps.
      If you would like me to speak at your event,
      <a href="mailto:karanshyammittal@gmail.com">get in touch</a>.
    </p>

    <div class="timeline">
      {sortedTalks.map((talk) => (
        <div class="timeline-item">
          <p style="font-size: 0.8rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.5rem;">
            {formatDate(talk.date)}
          </p>
          <h3 style="margin: 0 0 0.5rem; font-size: 1.15rem;">
            {talk.title}
          </h3>
          <p style="color: var(--muted); margin-bottom: 0.75rem;">
            {talk.description}
          </p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            {talk.tags.map((tag: string) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
          {talk.links && talk.links.length > 0 && (
            <p style="margin-top: 0.75rem; margin-bottom: 0;">
              {talk.links.map((link: { label: string; url: string }) => (
                <a href={link.url} target="_blank" rel="noopener">{link.label} &rarr;</a>
              ))}
            </p>
          )}
        </div>
      ))}
    </div>

    <section style="margin-top: 4rem; padding: 2rem; border: 1px solid var(--border); border-radius: var(--radius); text-align: center;">
      <h2 style="margin-top: 0; font-size: 1.2rem;">Invite Me to Speak</h2>
      <p style="color: var(--muted); margin-bottom: 1.5rem;">
        I am open to speaking at conferences, meetups, and workshops on AI architecture, GraphRAG, MLOps, and building production-scale systems.
      </p>
      <a href="mailto:karanshyammittal@gmail.com" class="btn btn-primary">Request a Talk</a>
    </section>
  </main>
</Layout>

<style>
  .tag {
    padding: 0.35rem 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
  }
</style>
