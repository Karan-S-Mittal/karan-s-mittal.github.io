---
/**
 * DarkPlane.astro — spec §8.4 / §21
 * Darkness is semantic: conclusion, decision, final CTA.
 * Ink surface + soft radial blue glow. White heading, soft blue description,
 * blue primary action. Never a pink primary CTA here.
 */
interface Props {
  id?: string;
}

const { id } = Astro.props;
---

<section class="dark-plane" id={id}>
  <div class="dark-plane-inner">
    <slot />
  </div>
</section>

<style>
  .dark-plane {
    background:
      radial-gradient(
        circle at 85% 15%,
        rgba(162, 210, 255, 0.15),
        transparent 34%
      ),
      var(--ink-900);
    color: var(--neutral-000);
    border-radius: var(--radius-card);
  }

  .dark-plane-inner {
    max-width: var(--width-content);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6);
  }

  .dark-plane :global(h1),
  .dark-plane :global(h2),
  .dark-plane :global(h3) {
    color: var(--neutral-000);
  }

  .dark-plane :global(p) {
    color: rgba(162, 210, 255, 0.85);
  }

  .dark-plane :global(a) {
    color: var(--blue-300);
  }

  @media (max-width: 640px) {
    .dark-plane-inner {
      padding: var(--space-7) var(--space-5);
    }
  }
</style>
