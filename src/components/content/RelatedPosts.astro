---
/**
 * RelatedPosts.astro
 * Surfaces 2-3 other posts at the end of an essay so a reader who finishes
 * has a path deeper into the site.
 *
 * Ranking: most shared tags first (compared via normalizeTag, since tags in
 * this repo have inconsistent casing/formatting), tie-broken by recency.
 * Because the sort key is (sharedTagCount desc, pubDate desc), posts that
 * share nothing with the current one naturally fall back to "most recent
 * first" without any special-casing. Always excludes the current post and
 * any draft: true post.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { normalizeTag } from '@utils/tags.js';
import BlogPostCard from './BlogPostCard.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  limit?: number;
}

const { post, limit = 3 } = Astro.props;

const currentTags = new Set(post.data.tags.map(normalizeTag));

const candidates = await getCollection(
  'blog',
  ({ id, data }) => id !== post.id && !data.draft
);

const related = candidates
  .map((candidate) => {
    const candidateTags = candidate.data.tags.map(normalizeTag);
    const sharedTagCount = candidateTags.filter((tag) => currentTags.has(tag)).length;
    return { candidate, sharedTagCount };
  })
  .sort((a, b) => {
    if (b.sharedTagCount !== a.sharedTagCount) return b.sharedTagCount - a.sharedTagCount;
    return b.candidate.data.pubDate.valueOf() - a.candidate.data.pubDate.valueOf();
  })
  .slice(0, limit)
  .map((entry) => entry.candidate);
---

{
  related.length > 0 && (
    <section class="related-posts" aria-labelledby="related-posts-heading">
      <h2 id="related-posts-heading">More writing</h2>
      <ul class="related-posts-list">
        {related.map((relatedPost) => (
          <BlogPostCard post={relatedPost} />
        ))}
      </ul>
    </section>
  )
}

<style>
  .related-posts {
    max-width: 700px;
    margin-top: var(--gap-section);
  }

  .related-posts h2 {
    margin: 0 0 var(--gap-group);
    font-size: var(--ie-type-h3);
  }

  .related-posts-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ie-rule);
    list-style: none;
  }
</style>
