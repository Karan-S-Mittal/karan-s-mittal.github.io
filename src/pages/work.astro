---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/content/PageHeader.astro';
import WorkCard from '@components/content/WorkCard.astro';
import workData from '@data/work.json';

const { work } = workData;
---

<Layout
  title="Selected Work | Karan Mittal"
  description="How Karan Mittal approaches deterministic engineering for complex data and AI systems."
>
  <main class="container work-page">
    <PageHeader
      label="Practice"
      title="From uncertain AI prototypes to systems a team can operate."
      description="Three recurring classes of engagement, documented as mechanistic system lenses. Client and proprietary implementation details remain confidential."
    />

    <div class="principle-banner">
      <span class="principle-icon" aria-hidden="true">↳</span>
      <p>Reliability is not a feature added at the end. It is a set of explicit choices about evidence, constraints, failure modes, and operational ownership.</p>
    </div>

    <div class="work-list">
      {work.map((item, index) => <WorkCard item={item} index={String(index + 1).padStart(2, '0')} detailed />)}
    </div>

    <section class="case-study-row">
      <div class="case-study-copy">
        <span class="section-register">Case Study</span>
        <h2>A public example: building on a written systems contract.</h2>
        <p>The same reasoning spine &mdash; ambiguity, constraint, mechanism, evidence, decision &mdash; applied to an implementation whose claims can be checked directly in the open-source repository.</p>
      </div>
      <a href="/case-studies/soft-architecture/" class="ie-action secondary">
        <span>Read case study</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </section>

    <section class="engagement-section">
      <div class="engagement-copy">
        <span class="section-register">02 / Consultation</span>
        <h2>Bring the difficult system question.</h2>
        <p>Available for consulting engagements navigating knowledge systems, AI reliability, GPU memory layout bottlenecks, and the transition from prototype to production.</p>
      </div>
      <div class="engagement-actions">
        <a href="/contact" class="ie-action primary">Open project brief <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .work-page {
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }

  .principle-banner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    max-width: 780px;
    margin: clamp(1rem, 2vw, 1.5rem) 0 clamp(2rem, 4vw, 3rem);
    padding: 1.1rem 1.4rem;
    border-left: 3px solid var(--ie-blue);
    border-top: 1px solid var(--ie-rule);
    border-right: 1px solid var(--ie-rule);
    border-bottom: 1px solid var(--ie-rule);
    background: var(--ie-surface);
    border-radius: 0 var(--radius-card, 8px) var(--radius-card, 8px) 0;
  }

  .principle-icon {
    color: var(--ie-blue);
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .principle-banner p {
    margin: 0;
    color: var(--ie-ink);
    font-size: 0.95rem;
    line-height: 1.6;
    font-style: italic;
  }

  .work-list {
    display: grid;
    gap: 1.75rem;
  }

  .work-list :global(.studio-panel) {
    scroll-margin-top: 5rem;
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 8px);
    background: var(--ie-surface);
  }

  .section-register {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--ie-blue);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .case-study-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 8px);
  }

  .case-study-copy h2 {
    margin: 0 0 0.5rem;
    color: var(--ie-ink);
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.2vw, 1.6rem);
    font-weight: 500;
  }

  .case-study-copy p {
    max-width: 580px;
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .engagement-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 1.75rem;
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 8px);
    background: var(--ie-surface);
  }

  .engagement-copy h2 {
    margin: 0 0 0.5rem;
    color: var(--ie-ink);
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.6vw, 1.95rem);
    font-weight: 500;
  }

  .engagement-copy p {
    max-width: 580px;
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .ie-action {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    border-radius: var(--radius, 6px);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 120ms ease, background-color 120ms ease, color 120ms ease;
  }

  .ie-action.primary {
    border: 1px solid var(--ie-ink);
    background: var(--ie-ink);
    color: var(--ie-canvas);
  }

  .ie-action.primary:hover {
    border-color: var(--ie-blue);
    background: var(--ie-blue);
    color: #fff;
  }

  .ie-action.secondary {
    border: 1px solid var(--ie-rule);
    background: var(--ie-surface-raised);
    color: var(--ie-ink);
  }

  .ie-action.secondary:hover {
    border-color: var(--ie-blue);
    color: var(--ie-blue);
  }

  @media (max-width: 768px) {
    .case-study-row,
    .engagement-section {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
  }
</style>
