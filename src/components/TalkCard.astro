---
import type { Talk } from '../types/talks';
import { formatTalkDate } from '../utils/date';

interface Props {
  talk: Talk;
}

const { talk } = Astro.props;
const formattedDate = formatTalkDate(talk.date);

const typeLabel: Record<Talk['type'], string> = {
  talk: 'Session',
  workshop: 'Workshop',
  panel: 'Panel',
  keynote: 'Keynote',
};
---

<article class="talk-card">
  <div class="talk-meta">
    <span class="talk-type" data-type={talk.type}>{typeLabel[talk.type]}</span>
    <time datetime={talk.date}>{formattedDate}</time>
  </div>

  <h3 class="talk-title">{talk.title}</h3>
  <p class="talk-description">{talk.description}</p>

  <div class="talk-footnote">
    <span>{talk.event}</span>
    <span class="sep">·</span>
    <span>{talk.org}</span>
    {talk.venue && (
      <>
        <span class="sep">·</span>
        <span>{talk.venue}</span>
      </>
    )}
  </div>

  {talk.tags.length > 0 && (
    <div class="talk-tags">
      {talk.tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}

  {talk.links.length > 0 && (
    <div class="talk-links">
      {talk.links.map((link) => (
        <a href={link.url} target="_blank" rel="noopener noreferrer" class="talk-link">
          {link.label}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7"/>
            <path d="M7 7h10v10"/>
          </svg>
        </a>
      ))}
    </div>
  )}
</article>

<style>
  .talk-card {
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
  }

  .talk-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .talk-type {
    display: inline-block;
    padding: 0.12rem var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: var(--radius-pill);
    background: var(--text);
    color: var(--bg);
  }
  .talk-type[data-type="workshop"] {
    background: var(--accent);
    color: #fff;
  }
  .talk-type[data-type="panel"] {
    background: #8b5cf6;
    color: #fff;
  }
  .talk-type[data-type="keynote"] {
    background: #ef4444;
    color: #fff;
  }

  time {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--muted);
  }

  .talk-title {
    margin: 0 0 var(--space-1);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
  }

  .talk-description {
    margin: 0 0 var(--space-3);
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .talk-footnote {
    font-size: var(--text-xs);
    color: var(--muted);
    margin-bottom: var(--space-3);
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
    align-items: center;
  }
  .talk-footnote .sep {
    color: var(--border);
  }

  .talk-tags {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }

  .talk-links {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .talk-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .talk-link:hover {
    color: var(--text);
    text-decoration: none;
  }
  .talk-link svg {
    flex-shrink: 0;
    opacity: 0.5;
  }

  @media (max-width: 640px) {
    .talk-card {
      padding: var(--space-4);
    }
  }
</style>
