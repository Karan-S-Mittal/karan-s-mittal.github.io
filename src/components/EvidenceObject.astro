---
/**
 * EvidenceObject.astro — spec §13
 * Compact proof fragment connecting constraint → decision → result.
 * Not a generic metric card: the reasoning chain is the content.
 *
 * Two canonical shapes:
 *  - Metric:  metric / method / outcome
 *  - Chain:   slot body with custom steps (e.g. "119 endpoints ↓ one contract ↓ consistent surface")
 */
interface Props {
  index?: string;
  label: string;
  metric?: string;
  method?: string;
  outcome?: string;
}

const { index, label, metric, method, outcome } = Astro.props;
---

<figure class="evidence-object">
  <figcaption class="eo-head">
    {index && <span class="eo-index">{index} /</span>}
    <span class="eo-label">{label}</span>
  </figcaption>

  {metric && <p class="eo-metric">{metric}</p>}

  {method && (
    <>
      <span class="eo-rule" aria-hidden="true"></span>
      <p class="eo-method">{method}</p>
    </>
  )}

  {outcome && (
    <>
      <p class="eo-outcome">
        <span class="eo-arrow" aria-hidden="true">&darr;</span>
        {outcome}
      </p>
    </>
  )}

  <div class="eo-body">
    <slot />
  </div>
</figure>

<style>
  .evidence-object {
    margin: var(--space-6) 0;
    padding: var(--space-5);
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .eo-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .eo-index {
    color: var(--interactive-primary);
  }

  .eo-label {
    color: var(--text-secondary);
  }

  /* Evidence Metric — spec §4.2: 36–64px, compact and assertive */
  .eo-metric {
    margin: 0;
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--text);
  }

  .eo-rule {
    display: block;
    width: 4.5rem;
    height: 1px;
    margin: var(--space-3) 0;
    background: var(--border-muted);
  }

  .eo-method {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .eo-outcome {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    font-weight: 500;
    color: var(--interactive-primary);
  }

  .eo-arrow {
    color: var(--signal-secondary);
  }

  .eo-body {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .eo-body > :global(*:first-child) {
    margin-top: 0;
  }

  .eo-body > :global(*:last-child) {
    margin-bottom: 0;
  }
</style>
