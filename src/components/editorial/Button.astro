---
/**
 * Button.astro — spec §8.3 / §25
 * Primary: blue surface, white text, 8px radius, subtle 1px lift on hover.
 * Secondary: transparent, hairline border, ink text, blue hover.
 * No scale, no bounce, no glow. Full state contract incl. focus-visible + reduced-motion (global kill-switch).
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
}

const { href, variant = 'primary', type = 'button', disabled = false } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn', `btn-${variant}`, { 'btn-disabled': disabled }]}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  aria-disabled={disabled ? 'true' : undefined}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    gap: var(--space-2);
    padding: 0.55rem 1.4rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .btn:focus-visible {
    outline: 2px solid var(--interactive-focus);
    outline-offset: 3px;
  }

  /* Primary — Apple Dodger Blue */
  .btn-primary {
    background: var(--accent);
    color: #ffffff;
    font-weight: 600;
    box-shadow: 0 1px 3px rgba(0, 113, 227, 0.24);
  }

  @media (hover: hover) {
    .btn-primary:hover:not(.btn-disabled) {
      background: var(--accent-hover);
      color: #ffffff;
      text-decoration: none;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(0, 113, 227, 0.32);
    }

    .btn-secondary:hover:not(.btn-disabled) {
      background: rgba(0, 0, 0, 0.04);
      color: var(--text);
      border-color: rgba(0, 0, 0, 0.2);
      text-decoration: none;
      transform: translateY(-1px);
    }
  }

  .btn-primary:active:not(.btn-disabled) {
    transform: translateY(0);
    box-shadow: none;
  }

  /* Secondary — Apple neutral frosted / hairline border */
  .btn-secondary {
    background: var(--bg-elevated);
    color: var(--text);
    border-color: rgba(0, 0, 0, 0.12);
    box-shadow: var(--shadow-sm);
  }

  .btn-secondary:active:not(.btn-disabled) {
    transform: translateY(0);
    background: var(--neutral-100);
  }

  .btn-disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
</style>
