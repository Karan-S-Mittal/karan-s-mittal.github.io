---
import { SOCIALS, SITE } from '../../config';

const socials = SOCIALS;
---

<footer>
  <div class="footer-inner">
    <!-- Top Multi-Column Navigation Directory -->
    <div class="footer-directory">
      <!-- Column 1: Systems Engineering -->
      <div class="footer-col">
        <h3 class="col-title">Systems Engineering</h3>
        <ul class="col-links">
          <li><a href="/work">Selected Work</a></li>
          <li><a href="/blog">Deep Dives &amp; Essays</a></li>
          <li><a href="/talks">Talks &amp; Lectures</a></li>
          <li><a href="/tags">Topics &amp; Tags Index</a></li>
        </ul>
      </div>

      <!-- Column 2: Explanatory Systems Studio -->
      <div class="footer-col">
        <h3 class="col-title">Explanatory Studio</h3>
        <ul class="col-links">
          <li><a href="/studio/visuals" class="highlight-link"><span class="link-dot"></span>Interactive Visuals Lab</a></li>
          <li><a href="/studio">Studio Overview</a></li>
          <li><a href="/studio/components">Component Gallery</a></li>
          <li><a href="/case-studies/soft-architecture">Soft Architecture Spec</a></li>
        </ul>
      </div>

      <!-- Column 3: About & Meta -->
      <div class="footer-col">
        <h3 class="col-title">About &amp; Updates</h3>
        <ul class="col-links">
          <li><a href="/about">About Karan</a></li>
          <li><a href="/now">Now (Current Focus)</a></li>
          <li><a href="/about#community">Community &amp; Mentorship</a></li>
          <li><a href="/rss.xml">RSS Atom Feed</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar: Copyright & Socials -->
    <div class="footer-bottom-bar">
      <div class="footer-brand-info">
        <p class="copyright">&copy; {new Date().getFullYear()} {SITE.name}</p>
        <span class="brand-subtext">Deterministic Systems &middot; Explanatory Engineering</span>
      </div>

      <div class="footer-socials">
        {socials.map(s => (
          <a
            href={s.href}
            target={s.href.startsWith('http') ? '_blank' : undefined}
            rel={s.href.startsWith('http') ? 'noopener' : undefined}
            aria-label={s.label}
            title={s.label}
            class="social-btn"
          >
            {s.icon === 'github' && (
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
            )}
            {s.icon === 'linkedin' && (
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            )}
            {s.icon === 'x' && (
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            )}
            {s.icon === 'email' && (
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: var(--space-9);
    background: var(--surface-card);
  }

  .footer-inner {
    max-width: var(--page-max-width, 1040px);
    margin: 0 auto;
    padding: var(--space-7) var(--space-5) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Multi-Column Directory */
  .footer-directory {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-6);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-6);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .col-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0;
  }

  .col-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .col-links li {
    margin: 0;
  }

  .col-links a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted, #68768b);
    text-decoration: none;
    transition: all var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .col-links a:hover {
    color: var(--accent);
    transform: translateX(2px);
  }

  .highlight-link {
    color: var(--accent) !important;
    font-weight: 600;
  }

  .link-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Bottom Bar */
  .footer-bottom-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-brand-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .copyright {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    margin: 0;
  }

  .brand-subtext {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--muted);
    opacity: 0.8;
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    color: var(--muted);
    border: 1px solid var(--border);
    background: var(--surface);
    transition: all var(--transition-fast);
  }

  .social-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-1px);
  }
</style>
