---
/**
 * CodeReviewTopologies.astro
 * Comparative architectural breakdown of three code review paradigms:
 * 1. Branch-Based PR / MR (GitHub / GitLab)
 * 2. Stacked Changes / Change-Id (Gerrit / Critique / Sapling)
 * 3. Patch Series via Email (Linux Kernel / SourceHut)
 *
 * 100% token compliant with Soft Architecture grammar.
 */
import VisualAttribution from '../VisualAttribution.astro';

interface Props {
  id?: string;
}

const { id = 'code-review-topologies' } = Astro.props;
---

<div class="review-topologies-root" id={id}>
  <div class="topologies-grid">
    <!-- Paradigm 1: Branch PR / MR -->
    <div class="topology-card card-branch">
      <div class="card-header">
        <span class="badge-tag">BRANCH-CENTRIC</span>
        <h4 class="card-title">Pull / Merge Request</h4>
        <span class="platform-meta">GitHub · GitLab · Bitbucket</span>
      </div>

      <div class="topology-diagram">
        <svg viewBox="0 0 240 130" class="topo-svg" aria-label="Branch PR topology">
          <!-- Main branch line -->
          <line x1="20" y1="95" x2="220" y2="95" stroke="var(--ie-ink)" stroke-width="2" />
          <circle cx="35" cy="95" r="4" fill="var(--ie-ink)" />
          <text x="35" y="115" font-family="var(--font-mono)" font-size="9" fill="var(--ie-muted)" text-anchor="middle">v1.0</text>
          
          <circle cx="205" cy="95" r="5" fill="var(--ie-verified)" />
          <text x="205" y="115" font-family="var(--font-mono)" font-size="9" fill="var(--ie-ink)" font-weight="600" text-anchor="middle">merge</text>

          <!-- Branch fork -->
          <path d="M 35 95 C 60 95, 60 35, 85 35" fill="none" stroke="var(--ie-blue)" stroke-width="1.5" stroke-dasharray="3 3" />
          <line x1="85" y1="35" x2="165" y2="35" stroke="var(--ie-blue)" stroke-width="2" />
          
          <!-- WIP Commits -->
          <circle cx="95" cy="35" r="3.5" fill="var(--ie-blue)" />
          <circle cx="125" cy="35" r="3.5" fill="var(--ie-blue)" />
          <circle cx="155" cy="35" r="3.5" fill="var(--ie-blue)" />
          <text x="125" y="22" font-family="var(--font-mono)" font-size="8.5" fill="var(--ie-blue)" text-anchor="middle">feat: 3 commits</text>

          <!-- Branch join -->
          <path d="M 165 35 C 185 35, 185 95, 205 95" fill="none" stroke="var(--ie-verified)" stroke-width="1.5" />

          <!-- Diff Bracket -->
          <rect x="75" y="48" width="100" height="24" rx="4" fill="var(--ie-surface-raised)" stroke="var(--ie-rule)" stroke-width="1" />
          <text x="125" y="64" font-family="var(--font-mono)" font-size="8.5" fill="var(--ie-rust)" text-anchor="middle">1 Cumulative Diff</text>
        </svg>
      </div>

      <div class="metrics-list">
        <div class="metric-row">
          <span class="metric-label">Review Unit</span>
          <span class="metric-val">All commits aggregated</span>
        </div>
        <div class="metric-row">
          <span class="metric-label">Revision Identity</span>
          <span class="metric-val">Branch tip update</span>
        </div>
        <div class="metric-row">
          <span class="metric-label">State Tracking</span>
          <span class="metric-val">Branch pair + PR record</span>
        </div>
        <div class="metric-row">
          <span class="metric-label">Accepted History</span>
          <span class="metric-val">Merge, squash, or rebase</span>
        </div>
      </div>
    </div>

    <!-- Paradigm 2: Stacked Changes -->
    <div class="topology-card card-stacked">
      <div class="card-header">
        <span class="badge-tag">COMMIT-CENTRIC</span>
        <h4 class="card-title">Stacked Diffs</h4>
        <span class="platform-meta">Gerrit · Critique · Sapling</span>
      </div>

      <div class="topology-diagram">
        <svg viewBox="0 0 240 130" class="topo-svg" aria-label="Stacked Changes topology">
          <!-- Stack line -->
          <line x1="30" y1="65" x2="210" y2="65" stroke="var(--ie-ink)" stroke-width="1.5" />
          
          <!-- Node 1 -->
          <g transform="translate(45, 35)">
            <rect x="-20" y="0" width="40" height="60" rx="4" fill="var(--ie-surface-raised)" stroke="var(--ie-verified)" stroke-width="1.5" />
            <text x="0" y="24" font-family="var(--font-mono)" font-size="8.5" fill="var(--ie-ink)" font-weight="600" text-anchor="middle">C1</text>
            <text x="0" y="42" font-family="var(--font-mono)" font-size="7" fill="var(--ie-verified)" text-anchor="middle">✓ +2</text>
          </g>

          <!-- Node 2 -->
          <g transform="translate(115, 35)">
            <rect x="-20" y="0" width="40" height="60" rx="4" fill="var(--ie-surface-raised)" stroke="var(--ie-blue)" stroke-width="1.5" />
            <text x="0" y="24" font-family="var(--font-mono)" font-size="8.5" fill="var(--ie-ink)" font-weight="600" text-anchor="middle">C2</text>
            <text x="0" y="42" font-family="var(--font-mono)" font-size="7" fill="var(--ie-blue)" text-anchor="middle">Review</text>
          </g>

          <!-- Node 3 -->
          <g transform="translate(185, 35)">
            <rect x="-20" y="0" width="40" height="60" rx="4" fill="var(--ie-surface-raised)" stroke="var(--ie-rule-strong)" stroke-width="1" />
            <text x="0" y="24" font-family="var(--font-mono)" font-size="8.5" fill="var(--ie-muted)" font-weight="600" text-anchor="middle">C3</text>
            <text x="0" y="42" font-family="var(--font-mono)" font-size="7" fill="var(--ie-muted)" text-anchor="middle">Draft</text>
          </g>

          <text x="120" y="118" font-family="var(--font-mono)" font-size="8" fill="var(--ie-muted)" text-anchor="middle">Change-Id links successive patch sets</text>
        </svg>
      </div>

      <div class="metrics-list">
        <div class="metric-row">
          <span class="metric-label">Review Unit</span>
          <span class="metric-val">One change across patch sets</span>
        </div>
        <div class="metric-row">
          <span class="metric-label">Revision Identity</span>
          <span class="metric-val">Change-Id trailer</span>
        </div>
        <div class="metric-row">
          <span class="metric-label">State Tracking</span>
          <span class="metric-val">Patch set series</span>
        </div>
        <div class="metric-row">
          <span class="metric-label">Accepted History</span>
          <span class="metric-val">Linear validated commits</span>
        </div>
      </div>
    </div>

    <!-- Paradigm 3: Patch-over-Email -->
    <div class="topology-card card-email">
      <div class="card-header">
        <span class="badge-tag">PROTOCOL-CENTRIC</span>
        <h4 class="card-title">Patch Series via Email</h4>
        <span class="platform-meta">Linux Kernel · Git · SourceHut</span>
      </div>

      <div class="topology-diagram">
        <svg viewBox="0 0 240 130" class="topo-svg" aria-label="Patch over email topology">
          <!-- Mailing list thread representation -->
          <rect x="25" y="20" width="190" height="26" rx="3" fill="var(--ie-surface-raised)" stroke="var(--ie-rule)" />
          <text x="35" y="36" font-family="var(--font-mono)" font-size="8" fill="var(--ie-ink)">[PATCH 0/2] Cover Letter</text>

          <rect x="40" y="52" width="175" height="24" rx="3" fill="var(--ie-surface-raised)" stroke="var(--ie-blue)" stroke-width="1.2" />
          <text x="50" y="67" font-family="var(--font-mono)" font-size="8" fill="var(--ie-blue)">[PATCH 1/2] core: refactor</text>

          <rect x="40" y="82" width="175" height="24" rx="3" fill="var(--ie-surface-raised)" stroke="var(--ie-rule)" />
          <text x="50" y="97" font-family="var(--font-mono)" font-size="8" fill="var(--ie-ink-secondary)">[PATCH 2/2] doc: update</text>

          <text x="120" y="122" font-family="var(--font-mono)" font-size="8" fill="var(--ie-verified)" text-anchor="middle">Maintainer may apply an mbox</text>
        </svg>
      </div>

      <div class="metrics-list">
        <div class="metric-row">
          <span class="metric-label">Review Unit</span>
          <span class="metric-val">Patch or patch series</span>
        </div>
        <div class="metric-row">
          <span class="metric-label">Revision Identity</span>
          <span class="metric-val">Message-ID threading</span>
        </div>
        <div class="metric-row">
          <span class="metric-label">State Tracking</span>
          <span class="metric-val">In-Reply-To thread</span>
        </div>
        <div class="metric-row">
          <span class="metric-label">Accepted History</span>
          <span class="metric-val">Applied mbox series</span>
        </div>
      </div>
    </div>
  </div>

  <div class="diagram-footer">
    <span class="footer-note">Architectural comparison of code review encapsulation primitives and history maintenance.</span>
    <VisualAttribution />
  </div>
</div>

<style>
  .review-topologies-root {
    width: 100%;
    padding: 1.5rem;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 8px);
    font-family: var(--font-sans);
  }

  .topologies-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .topology-card {
    display: flex;
    flex-direction: column;
    padding: 1.1rem;
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-sm, 6px);
    background: var(--ie-surface-raised);
  }

  .card-branch {
    border-top: 3px solid var(--ie-rust);
  }

  .card-stacked {
    border-top: 3px solid var(--ie-blue);
  }

  .card-email {
    border-top: 3px solid var(--ie-verified);
  }

  .card-header {
    margin-bottom: 0.75rem;
  }

  .badge-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ie-muted);
    margin-bottom: 0.35rem;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--ie-type-ui);
    font-weight: 600;
    color: var(--ie-ink);
    margin: 0 0 0.25rem 0;
    line-height: 1.25;
  }

  .platform-meta {
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    color: var(--ie-ink-secondary);
  }

  .topology-diagram {
    margin: 0.75rem 0;
    padding: 0.5rem;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-sm, 4px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .topo-svg {
    width: 100%;
    height: auto;
    max-height: 130px;
    display: block;
  }

  .metrics-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--ie-rule);
  }

  .metric-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--ie-type-micro);
  }

  .metric-label {
    color: var(--ie-muted);
    font-family: var(--font-mono);
  }

  .metric-val {
    color: var(--ie-ink);
    font-family: var(--font-mono);
    font-weight: 500;
    text-align: right;
  }

  .metric-val.warn {
    color: var(--ie-rust);
  }

  .metric-val.good {
    color: var(--ie-verified);
  }

  .diagram-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--ie-rule);
  }

  .footer-note {
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    color: var(--ie-muted);
  }

  @media (max-width: 860px) {
    .topologies-grid {
      grid-template-columns: 1fr;
    }
    .diagram-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
