---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE, SOCIALS } from '../config';

const publishedPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPosts = publishedPosts.slice(0, 5);

function formatDate(date: Date | string) {
  const value = typeof date === 'string' ? new Date(date) : date;
  return value.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
}

const linkedinSocial = SOCIALS.find((s) => s.name === 'LinkedIn')?.url || 'https://www.linkedin.com/in/karansmittal/';
const githubSocial = SOCIALS.find((s) => s.name === 'GitHub')?.url || 'https://github.com/karan-s-mittal';
---

<Layout
  title={`${SITE.title} | AI Systems Architect & Advisor`}
  description="Karan Mittal is an AI Systems Architect and co-founder of Dextar, specializing in deterministic RAG, low-level inference optimization, and production-grade AI systems."
>
  <main class="home-shell">
    <!-- HERO -->
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-header">
        <div class="hero-avatar-frame">
          <img
            src="/profile-400.jpg"
            alt="Karan Mittal"
            class="hero-portrait"
            width="88"
            height="88"
            loading="eager"
          />
        </div>
        <div class="hero-header-text">
          <p class="hero-role">AI Systems Architect &middot; Co-Founder, Dextar</p>
          <h1 id="home-title">Karan Mittal</h1>
        </div>
      </div>

      <p class="hero-lead">
        I design deterministic knowledge systems, optimize low-level LLM inference memory, and build inspectable AI architectures that engineering teams can operate with confidence in high-stakes domains.
      </p>

      <div class="hero-actions">
        <a class="ie-action primary" href="/blog">Read field notes &rarr;</a>
        <a class="ie-action secondary" href="/work">Selected work &nearr;</a>
        <a class="ie-action secondary" href="/contact">Get in touch &rarr;</a>
      </div>
    </section>

    <!-- SELECTED FIELD NOTES -->
    <section class="notes-section" aria-labelledby="notes-title">
      <div class="section-head">
        <div>
          <span class="section-register">01 / Writing</span>
          <h2 id="notes-title">Selected Field Notes</h2>
        </div>
        <a class="section-link" href="/blog">All notes ({publishedPosts.length}) <span aria-hidden="true">&nearr;</span></a>
      </div>

      <div class="notes-list" role="feed" aria-label="Selected field notes">
        {featuredPosts.map((post) => (
          <article class="note-row">
            <div class="note-meta">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              {post.data.tags && post.data.tags.length > 0 && (
                <span class="note-tag">{post.data.tags[0]}</span>
              )}
            </div>
            <div class="note-body">
              <h3>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h3>
              <p>{post.data.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ADVISORY & FOCUS -->
    <section class="advisory-section" aria-labelledby="advisory-title">
      <div class="advisory-frame">
        <div class="section-head">
          <div>
            <span class="section-register">02 / Advisory</span>
            <h2 id="advisory-title">Technical Advisory &amp; Architecture</h2>
          </div>
        </div>

        <p class="advisory-bio">
          Available for technical advisory, deep-dive architecture reviews, and resolving prototype-to-production bottlenecks across deterministic retrieval contracts, GPU memory layout, and evaluation harnesses.
        </p>

        <div class="hero-actions">
          <a class="ie-action primary" href="/contact">Start consultation inquiry &rarr;</a>
          <a class="ie-action secondary" href={`mailto:${SITE.email}?subject=Systems%20Architecture%20Inquiry`}>Email</a>
          <a class="ie-action secondary" href={linkedinSocial} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">&nearr;</span></a>
          <a class="ie-action secondary" href={githubSocial} target="_blank" rel="noopener">GitHub <span aria-hidden="true">&nearr;</span></a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .home-shell {
    width: min(100% - 3rem, 860px);
    margin-inline: auto;
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  /* Shared Typography & Controls */
  .section-register {
    display: inline-block;
    margin-bottom: 0.5rem;
    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .section-head h2 {
    margin: 0;
    color: var(--ie-ink);
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 3.2vw, 2.25rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ie-blue);
    font-family: var(--font-mono);
    font-size: var(--ie-type-ui);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .section-link:hover {
    text-decoration: underline;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .ie-action {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.6rem 1.15rem;
    border: 1px solid var(--ie-ink);
    border-radius: var(--radius, 6px);
    font-family: var(--font-sans);
    font-size: var(--ie-type-ui);
    font-weight: 600;
    text-decoration: none;
    transition: all 120ms ease;
  }

  .ie-action.primary {
    background: var(--ie-ink);
    color: var(--ie-canvas);
  }

  .ie-action.primary:hover {
    border-color: var(--ie-blue);
    background: var(--ie-blue);
    color: #ffffff;
  }

  .ie-action.secondary {
    background: transparent;
    color: var(--ie-ink);
    border-color: var(--ie-rule-strong);
  }

  .ie-action.secondary:hover {
    border-color: var(--ie-blue);
    color: var(--ie-blue);
    background: var(--ie-surface);
  }

  /* HERO SECTION */
  .home-hero {
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--ie-rule);
  }

  .hero-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .hero-avatar-frame {
    flex-shrink: 0;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--ie-rule);
    background: var(--ie-surface);
  }

  .hero-portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .hero-role {
    margin: 0 0 0.4rem;
    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero-header-text h1 {
    margin: 0;
    color: var(--ie-ink);
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    font-weight: 500;
    line-height: 1.05;
  }

  .hero-lead {
    max-width: 66ch;
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-body);
    line-height: 1.68;
  }

  /* SELECTED NOTES */
  .notes-section {
    padding-block: clamp(3rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--ie-rule);
  }

  .notes-list {
    display: flex;
    flex-direction: column;
  }

  .note-row {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 1.75rem;
    align-items: baseline;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--ie-rule);
  }

  .note-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .note-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .note-meta time {
    color: var(--ie-muted);
    font-family: var(--font-mono);
    font-size: var(--ie-type-label);
  }

  .note-tag {
    display: inline-block;
    color: var(--ie-blue);
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .note-body h3 {
    margin: 0 0 0.45rem;
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.38;
  }

  .note-body h3 a {
    color: var(--ie-ink);
    text-decoration: none;
    transition: color 120ms ease;
  }

  .note-body h3 a:hover {
    color: var(--ie-blue);
  }

  .note-body p {
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-small);
    line-height: 1.6;
  }

  /* ADVISORY SECTION */
  .advisory-section {
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }

  .advisory-frame {
    border-top: 2px solid var(--ie-rust);
    padding-top: 2rem;
  }

  .advisory-bio {
    max-width: 66ch;
    margin: 0;
    color: var(--ie-ink-secondary);
    font-size: var(--ie-type-body);
    line-height: 1.68;
  }

  @media (max-width: 680px) {
    .home-shell {
      width: min(100% - 2rem, 860px);
      padding-block: 2.5rem;
    }

    .hero-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .section-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .note-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding-block: 1.25rem;
    }

    .note-meta {
      flex-direction: row;
      gap: 0.75rem;
      align-items: baseline;
    }
  }
</style>
