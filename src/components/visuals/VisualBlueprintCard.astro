---
/**
 * VisualBlueprintCard.astro
 *
 * Standard reusable blueprint card template for systems architecture diagrams.
 * Provides a consistent frame, category metadata, live vector micro-preview,
 * and high-resolution export indicator.
 *
 * Invariant: 100% token compliant, zero raw hex colors.
 */
import VisualMicroSchematic from './VisualMicroSchematic.astro';

interface Props {
  slug: string;
  index: number | string;
  title: string;
  desc: string;
  category?: string;
  href: string;
  archetype?: 'loop' | 'pipeline' | 'memory' | 'tree' | 'hierarchy' | 'comparison';
}

const {
  slug,
  index,
  title,
  desc,
  category = 'SYSTEMS TOPOLOGY',
  href,
  archetype,
} = Astro.props;

const formattedIndex = typeof index === 'number' ? `ARC-${String(index).padStart(2, '0')}` : index;
---

<article class="visual-card" data-search={`${title} ${desc} ${category}`.toLowerCase()}>
  <a href={href} class="card-link" aria-label={`Inspect ${title}`}>
    <!-- Micro-Blueprint Viewport -->
    <div class="card-viewport">
      <VisualMicroSchematic slug={slug} archetype={archetype} />
      <div class="viewport-hover-indicator" aria-hidden="true">
        <span class="indicator-chip">Inspect &rarr;</span>
      </div>
    </div>

    <!-- Metadata & Details -->
    <div class="card-body">
      <div class="card-meta">
        <span class="meta-id">{formattedIndex}</span>
        <span class="meta-sep" aria-hidden="true">&bull;</span>
        <span class="meta-category">{category}</span>
        <span class="meta-export">3&times; PNG</span>
      </div>

      <h3 class="card-title">{title}</h3>
      <p class="card-desc">{desc}</p>
    </div>
  </a>
</article>

<style>
  .visual-card {
    display: flex;
    flex-direction: column;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card, 6px);
    overflow: hidden;
    transition: border-color var(--transition-fast, 150ms ease), transform var(--transition-fast, 150ms ease), box-shadow var(--transition-fast, 150ms ease);
  }

  .visual-card:hover {
    border-color: var(--ie-blue);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px -4px var(--ie-blue-soft);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .card-viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .viewport-hover-indicator {
    position: absolute;
    inset: 0;
    background: rgba(38, 118, 170, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-fast, 150ms ease);
    pointer-events: none;
  }

  .visual-card:hover .viewport-hover-indicator {
    opacity: 1;
  }

  .indicator-chip {
    padding: 0.35rem 0.75rem;
    background: var(--ie-surface);
    border: 1px solid var(--ie-blue);
    border-radius: var(--radius-sm, 4px);
    font-family: var(--font-diagram);
    font-size: var(--ie-type-micro);
    font-weight: 600;
    color: var(--ie-blue);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .card-body {
    padding: 1rem 1.15rem 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.45rem;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    line-height: 1;
  }

  .meta-id {
    font-weight: 600;
    color: var(--ie-ink);
    letter-spacing: 0.04em;
  }

  .meta-sep {
    color: var(--ie-rule-strong);
  }

  .meta-category {
    font-weight: 500;
    color: var(--ie-blue);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .meta-export {
    margin-left: auto;
    font-size: 0.65rem;
    color: var(--ie-muted);
    padding: 0.15rem 0.35rem;
    border: 1px solid var(--ie-rule);
    border-radius: 3px;
    background: var(--ie-surface-raised);
    letter-spacing: 0.02em;
  }

  .card-title {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
    color: var(--ie-ink);
    transition: color var(--transition-fast, 150ms ease);
  }

  .visual-card:hover .card-title {
    color: var(--ie-blue);
  }

  .card-desc {
    margin: 0;
    font-family: var(--font-diagram);
    font-size: var(--ie-type-small, 0.875rem);
    color: var(--ie-ink-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
