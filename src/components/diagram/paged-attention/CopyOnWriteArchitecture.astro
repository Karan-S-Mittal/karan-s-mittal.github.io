---
import Exhibit from '../../editorial/Exhibit.astro';

interface Props { caption?: string; exhibit?: string; title?: string; }

const {
  caption = 'Two generated candidates initially reference the same physical prompt block. When their outputs diverge, each candidate allocates only a new private block; the unchanged prefix remains stored once.',
  exhibit = '05',
  title = 'What is shared and what is copied during copy-on-write',
} = Astro.props;
---

<Exhibit exhibit={exhibit} title={title} badge="PREFIX SHARING" caption={caption} wide>
  <div class="cow-path">
    <header class="cow-question">
      <span>Question</span>
      <strong>Two samples begin with the same prompt. Which tokens need two physical copies?</strong>
    </header>

    <div class="cow-flow">
      <section class="shared-prefix">
        <span class="step-label">01 · Before divergence</span>
        <h4>One physical prefix block</h4>
        <div class="frame shared-frame">
          <span>Frame 10 · ref_count = 2</span>
          <div><i>San</i><i>Francisco</i><i>is</i><i>a</i></div>
        </div>
        <p>Sample A and Sample B both point to this frame.</p>
      </section>

      <div class="branch" aria-hidden="true">
        <span>first different token</span>
        <i></i>
      </div>

      <section class="private-branches">
        <span class="step-label">02 · After divergence</span>
        <h4>Only new output blocks become private</h4>

        <article class="candidate">
          <div class="candidate-label"><strong>Sample A</strong><span>still references Frame 10</span></div>
          <div class="frame private-frame"><span>New Frame 14</span><div><i>historic</i><i>city</i></div></div>
        </article>

        <article class="candidate">
          <div class="candidate-label"><strong>Sample B</strong><span>still references Frame 10</span></div>
          <div class="frame private-frame"><span>New Frame 19</span><div><i>vibrant</i><i>hub</i></div></div>
        </article>
      </section>
    </div>

    <aside class="cow-takeaway">
      <span>What gets copied</span>
      <p><strong>Not the shared prompt.</strong> Copy-on-write allocates new physical storage only for the blocks that differ after the branch.</p>
    </aside>
  </div>
</Exhibit>

<style>
  .cow-path { width: 100%; }

  .cow-question,
  .cow-takeaway {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1rem 0;
    border-top: 2px solid var(--ie-ink, var(--text));
    border-bottom: 1px solid var(--ie-rule-strong, var(--border-default));
  }

  .cow-question > span,
  .cow-takeaway > span,
  .step-label {
    color: var(--ie-blue, var(--accent));
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .cow-question strong { color: var(--ie-ink, var(--text)); font-size: 1rem; font-weight: 550; }

  .cow-flow {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) 110px minmax(0, 1.2fr);
    align-items: stretch;
    padding: 1.5rem 0;
  }

  .shared-prefix,
  .private-branches {
    padding: 1.25rem;
    border: 1px solid var(--ie-rule-strong, var(--border-default));
    background: var(--ie-surface, var(--surface-card));
  }

  .shared-prefix h4,
  .private-branches h4 { margin: 0.55rem 0 1.25rem; color: var(--ie-ink, var(--text)); font-size: 1.15rem; }
  .shared-prefix > p { margin: 1rem 0 0; color: var(--ie-ink-secondary, var(--text-secondary)); font-size: 0.94rem; line-height: 1.5; }

  .frame { border: 1px solid var(--ie-blue, var(--accent)); }
  .frame > span { display: block; padding: 0.5rem 0.65rem; border-bottom: 1px solid var(--ie-blue, var(--accent)); background: var(--ie-blue-soft, var(--accent-subtle)); color: var(--ie-blue, var(--accent)); font-family: var(--font-mono); font-size: 0.78rem; }
  .frame > div { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0.75rem; }
  .frame i { padding: 0.35rem 0.5rem; border: 1px solid var(--ie-rule-strong, var(--border-default)); border-radius: 3px; color: var(--ie-ink, var(--text)); font-family: var(--font-mono); font-size: 0.82rem; font-style: normal; }

  .branch { position: relative; display: flex; align-items: center; justify-content: center; }
  .branch::before, .branch::after { content: ''; position: absolute; right: 0; left: 0; height: 1px; background: var(--ie-blue, var(--accent)); }
  .branch::before { top: 38%; transform: rotate(-13deg); transform-origin: left; }
  .branch::after { bottom: 38%; transform: rotate(13deg); transform-origin: left; }
  .branch i::before, .branch i::after { content: ''; position: absolute; right: 1px; width: 7px; height: 7px; border-top: 1px solid var(--ie-blue, var(--accent)); border-right: 1px solid var(--ie-blue, var(--accent)); transform: rotate(45deg); }
  .branch i::before { top: calc(38% - 4px); }
  .branch i::after { bottom: calc(38% - 4px); }
  .branch > span { position: relative; z-index: 1; padding: 0.3rem; background: var(--ie-surface-raised, var(--bg)); color: var(--ie-rust, var(--signal-warm)); font-family: var(--font-mono); font-size: 0.72rem; text-align: center; text-transform: uppercase; }

  .candidate { display: grid; grid-template-columns: minmax(8rem, 0.7fr) minmax(0, 1.3fr); gap: 1rem; align-items: center; padding: 0.85rem 0; border-top: 1px solid var(--ie-rule, var(--border-default)); }
  .candidate:first-of-type { border-top: 0; }
  .candidate-label { display: flex; flex-direction: column; }
  .candidate-label strong { color: var(--ie-ink, var(--text)); font-size: 0.95rem; }
  .candidate-label span { color: var(--ie-muted, var(--text-muted)); font-size: 0.82rem; line-height: 1.4; }
  .private-frame { border-color: var(--ie-rust, var(--signal-warm)); }
  .private-frame > span { border-color: var(--ie-rust, var(--signal-warm)); background: var(--ie-rust-soft, transparent); color: var(--ie-rust, var(--signal-warm)); }

  .cow-takeaway { border-top-width: 1px; }
  .cow-takeaway p { margin: 0; color: var(--ie-ink-secondary, var(--text-secondary)); font-size: 0.95rem; line-height: 1.55; }
  .cow-takeaway strong { color: var(--ie-ink, var(--text)); }

  @media (max-width: 760px) {
    .cow-question, .cow-takeaway { grid-template-columns: 1fr; gap: 0.4rem; }
    .cow-flow { grid-template-columns: 1fr; }
    .branch { min-height: 76px; }
    .branch::before, .branch::after { right: 50%; left: 50%; width: 1px; height: 100%; transform: none; }
    .branch::before { top: 0; }
    .branch::after { display: none; }
    .branch i::before, .branch i::after { display: none; }
    .candidate { grid-template-columns: 1fr; }
  }
</style>
