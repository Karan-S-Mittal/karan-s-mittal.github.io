---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';

const allPosts = await getCollection('blog');
const isDev = import.meta.env.DEV;
const posts = allPosts.filter((post) => isDev || !post.data.draft);

const tagCounts = posts.reduce<Record<string, number>>((acc, post) => {
  for (const tag of post.data.tags) {
    const key = tag.toLowerCase();
    acc[key] = (acc[key] || 0) + 1;
  }
  return acc;
}, {});

const tags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .map(([tag, count]) => ({ tag, count }));
---

<Layout title="Tags | Karan Mittal">
  <main class="container">
    <PageHeader
      label="Tags"
      title="All Topics"
      description="Browse essays by topic."
      count={tags.length}
      countLabel="topics"
    />

    <div class="tags-grid">
      {tags.map(({ tag, count }) => (
        <a href={`/tags/${tag.replace(/\s+/g, '-')}/`} class="tag-card">
          <span class="tag-name">{tag}</span>
          <span class="tag-count">{count} post{count === 1 ? '' : 's'}</span>
        </a>
      ))}
    </div>
  </main>
</Layout>

<style>
  .tags-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-4);
  }
  .tag-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
  }
  .tag-card:hover {
    text-decoration: none;
  }
  .tag-name {
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--text);
  }
  .tag-count {
    font-size: var(--text-xs);
    color: var(--muted);
    font-weight: 500;
  }
</style>
