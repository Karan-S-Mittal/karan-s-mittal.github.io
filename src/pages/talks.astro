---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import YearGroup from '../components/YearGroup.astro';
import TalkCard from '../components/TalkCard.astro';
import talksData from '../data/talks.json';
import type { Talk } from '../types/talks';

const talks: Talk[] = talksData.talks;

const sortedTalks = [...talks].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const talksByYear = sortedTalks.reduce<Record<string, Talk[]>>((acc, talk) => {
  if (!acc[talk.year]) acc[talk.year] = [];
  acc[talk.year].push(talk);
  return acc;
}, {});

const years = Object.keys(talksByYear).sort((a, b) => Number(b) - Number(a));
---

<Layout title="Talks | Karan Mittal">
  <main class="container">
    <PageHeader
      label="Talks & Workshops"
      title="Speaking"
      description="I speak at conferences, meetups, and workshops on AI architecture, GraphRAG, deterministic systems, and MLOps."
      count={sortedTalks.length}
      countLabel="events"
    />

    <div class="timeline">
      {years.map((year) => (
        <YearGroup year={year} count={talksByYear[year].length}>
          {talksByYear[year].map((talk) => (
            <TalkCard talk={talk} />
          ))}
        </YearGroup>
      ))}
    </div>

    <section class="cta-section">
      <h2>Invite Me to Speak</h2>
      <p>Open to speaking at conferences, meetups, and workshops on AI architecture, GraphRAG, MLOps, and building production-scale systems.</p>
      <a href="mailto:karanshyammittal@gmail.com" class="btn btn-primary">Request a Talk</a>
    </section>
  </main>
</Layout>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-bottom: 4rem;
  }

  .cta-section {
    padding: 2.5rem;
    border-radius: var(--radius);
    background: var(--bg-elevated);
    text-align: center;
  }
  .cta-section h2 {
    margin-top: 0;
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }
  .cta-section p {
    color: var(--muted);
    margin-bottom: 1.25rem;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
    font-size: 0.95rem;
  }

  @media (max-width: 640px) {
    .cta-section {
      padding: 1.5rem;
    }
  }
</style>
