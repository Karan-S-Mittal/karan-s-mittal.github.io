---
import type { Talk } from '../types/talks';
import { formatTalkDate } from '../utils/date';

interface Props {
  talk: Talk;
  searchText?: string;
}

const { talk, searchText } = Astro.props;
const formattedDate = formatTalkDate(talk.date);

const typeLabel: Record<Talk['type'], string> = {
  talk: 'Session',
  workshop: 'Workshop',
  panel: 'Panel',
  keynote: 'Keynote',
};
---

<article class="talk-card" data-search={searchText} data-year={talk.year} data-date={talk.date}>
  <div class="talk-meta">
    <time datetime={talk.date}>{formattedDate}</time>
    <span aria-hidden="true" class="meta-sep">·</span>
    <span class="talk-type" data-type={talk.type}>{typeLabel[talk.type]}</span>
  </div>

  <h3 class="talk-title">{talk.title}</h3>
  <p class="talk-description">{talk.description}</p>

  <div class="talk-footnote">
    <span>{talk.event}</span>
    <span class="sep">·</span>
    <span>{talk.org}</span>
    {talk.venue && (
      <>
        <span class="sep">·</span>
        <span>{talk.venue}</span>
      </>
    )}
  </div>

  {talk.links.length > 0 && (
    <div class="talk-links">
      {talk.links.map((link) => (
        <a href={link.url} target="_blank" rel="noopener noreferrer" class="talk-link">
          {link.label}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7"/>
            <path d="M7 7h10v10"/>
          </svg>
        </a>
      ))}
    </div>
  )}
</article>

<style>
  .talk-card {
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--border);
  }
  .talk-card:last-child {
    border-bottom: none;
  }

  .talk-meta {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .meta-sep {
    color: var(--border);
  }

  .talk-type {
    font-weight: 600;
    color: var(--accent);
  }
  .talk-type[data-type="workshop"] {
    color: #c97a1a;
  }
  .talk-type[data-type="panel"] {
    color: #8b5cf6;
  }
  .talk-type[data-type="keynote"] {
    color: #dc2626;
  }

  .talk-title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
  }

  .talk-description {
    margin: 0 0 var(--space-3);
    color: var(--muted);
    font-size: var(--text-base);
    line-height: 1.6;
  }

  .talk-footnote {
    font-size: var(--text-sm);
    color: var(--muted);
    margin-bottom: var(--space-3);
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
    align-items: center;
  }
  .talk-footnote .sep {
    color: var(--border);
  }

  .talk-links {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .talk-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .talk-link:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .talk-link svg {
    flex-shrink: 0;
    opacity: 0.5;
  }

  @media (max-width: 640px) {
    .talk-card {
      padding: var(--space-4) 0;
    }
    .talk-title {
      font-size: var(--text-base);
    }
  }
</style>
