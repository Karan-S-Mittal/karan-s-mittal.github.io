---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import WorkCard from '../components/WorkCard.astro';
import workData from '../data/work.json';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const featuredWork = workData.work.slice(0, 3);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<Layout
  title="Karan Mittal | Deterministic Engineering"
  description="Karan Mittal designs dependable data and AI systems for teams working with complexity."
>
  <main class="container">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="label"><span class="label-num">01</span>Independent consulting · Dextar co-founder</p>
        <h1 id="home-title">Engineering systems<br />you can rely on.</h1>
        <p class="hero-lead">
          I design deterministic data and AI systems for teams working with complexity—
          knowledge engines, production retrieval, and the infrastructure that makes ambitious work dependable.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="btn btn-primary">Discuss an engagement</a>
          <a href="/work" class="btn btn-secondary">See selected work</a>
        </div>
      </div>
      <aside class="hero-aside" aria-label="Karan's engineering principles">
        <img src="/profile-400.jpg" alt="Karan Mittal" width="400" height="400" />
        <div class="principle-note">
          <p class="note-label">Operating principle</p>
          <p>“Reliability is designed into the system—never added as an afterthought.”</p>
        </div>
      </aside>
    </section>

    <section class="signal-strip" aria-label="Focus areas">
      <p><span>01</span>Knowledge & retrieval systems</p>
      <p><span>02</span>Performance engineering</p>
      <p><span>03</span>Production data & AI delivery</p>
    </section>

    <section class="home-section" aria-labelledby="work-heading">
      <div class="section-heading">
        <div>
          <p class="label"><span class="label-num">02</span>Selected work</p>
          <h2 id="work-heading">The system is the product.</h2>
        </div>
        <p>Representative architecture challenges, described without exposing client detail.</p>
      </div>
      <div class="work-grid">
        {featuredWork.map((item) => <WorkCard item={item} />)}
      </div>
      <a href="/work" class="section-more">Explore the engineering lenses <span aria-hidden="true">→</span></a>
    </section>

    <section class="home-section ideas-section" aria-labelledby="ideas-heading">
      <div class="section-heading">
        <div>
          <p class="label"><span class="label-num">03</span>Field notes</p>
          <h2 id="ideas-heading">Ideas made inspectable.</h2>
        </div>
        <p>Writing about systems, retrieval, and the technical choices beneath dependable software.</p>
      </div>
      <div class="ideas-layout">
        <div class="writing-list">
          {posts.map(post => (
            <a href={`/blog/${post.id}/`} class="writing-row">
              <time class="writing-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              <span class="writing-body">
                <span class="writing-title">{post.data.title}</span>
                <span class="writing-desc">{post.data.description}</span>
              </span>
              <span class="row-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <a class="public-note" href="https://www.linkedin.com/in/karansmittal/" target="_blank" rel="noopener">
          <span class="public-note-kicker">Also writing in public</span>
          <strong>Selected notes and technical perspectives on LinkedIn.</strong>
          <span>Follow the working thread ↗</span>
        </a>
      </div>
      <a href="/blog" class="section-more">Browse all field notes <span aria-hidden="true">→</span></a>
    </section>

    <section class="home-section proof-section" aria-labelledby="proof-heading">
      <div class="section-heading">
        <div>
          <p class="label"><span class="label-num">04</span>Proof, in public</p>
          <h2 id="proof-heading">Teaching from the work.</h2>
        </div>
        <p>Technical communities are where ideas are tested, clarified, and shared.</p>
      </div>
      <div class="proof-grid">
        <a href="/talks" class="proof-card">
          <span class="proof-number">05</span>
          <span class="proof-label">Talks & workshops on record</span>
          <span class="proof-link">View speaking →</span>
        </a>
        <a href="/about#community" class="proof-card">
          <span class="proof-number">03</span>
          <span class="proof-label">Technical communities supported</span>
          <span class="proof-link">Explore community work →</span>
        </a>
        <a href="https://gdg.community.dev/gdg-cloud-indore/" class="proof-card proof-card-external" target="_blank" rel="noopener">
          <span class="proof-number">IN</span>
          <span class="proof-label">Building and learning in Central India</span>
          <span class="proof-link">See public events ↗</span>
        </a>
      </div>
    </section>

    <section class="contact-panel">
      <div>
        <p class="label">Work together</p>
        <h2>Have a system that needs to be right?</h2>
        <p>For consulting engagements involving AI reliability, knowledge systems, performance, or technical strategy.</p>
      </div>
      <div class="contact-actions">
        <a href="/contact" class="btn btn-primary">Start a conversation</a>
        <a href="https://www.linkedin.com/in/karansmittal/" class="text-link" target="_blank" rel="noopener">Connect on LinkedIn ↗</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: var(--space-8); align-items: center; padding: var(--space-8) 0 var(--space-7); }
  .hero h1 { margin-bottom: var(--space-4); font-size: clamp(2.75rem, 6vw, 4.5rem); }
  .hero-lead { max-width: 620px; margin-bottom: var(--space-5); font-size: var(--text-lg); line-height: 1.72; color: var(--text-secondary); }
  .hero-actions, .contact-actions { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
  .hero-aside { position: relative; }
  .hero-aside img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; border: 1px solid var(--border); border-radius: var(--radius-lg); filter: grayscale(100%); }
  .principle-note { position: relative; width: calc(100% + var(--space-6)); margin: calc(var(--space-5) * -1) 0 0 calc(var(--space-5) * -1); padding: var(--space-3) var(--space-4); border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); box-shadow: 6px 6px 0 var(--accent-subtle); }
  .principle-note p { margin: 0; font-family: var(--font-serif); font-size: var(--text-sm); line-height: 1.45; color: var(--text); }
  .principle-note .note-label { margin-bottom: var(--space-1); color: var(--accent); font-family: var(--font-mono); font-size: 0.65rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .signal-strip { display: grid; grid-template-columns: repeat(3, 1fr); margin-bottom: var(--space-8); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .signal-strip p { display: flex; align-items: center; gap: var(--space-2); margin: 0; padding: var(--space-3) var(--space-4); color: var(--muted); font-family: var(--font-mono); font-size: var(--text-xs); line-height: 1.4; }
  .signal-strip p + p { border-left: 1px solid var(--border); }
  .signal-strip span { color: var(--accent); }
  .home-section { padding: var(--space-7) 0; border-top: 1px solid var(--border); }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: var(--space-6); margin-bottom: var(--space-5); }
  .section-heading h2 { margin: 0; font-size: clamp(var(--text-2xl), 3vw, var(--text-3xl)); }
  .section-heading > p { max-width: 290px; margin: 0 0 var(--space-1); color: var(--muted); font-size: var(--text-sm); line-height: 1.6; }
  .work-grid, .proof-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); }
  .section-more { display: inline-flex; gap: var(--space-2); margin-top: var(--space-5); color: var(--accent); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.04em; text-decoration: none; }
  .section-more:hover { color: var(--text); text-decoration: none; }
  .ideas-layout { display: grid; grid-template-columns: minmax(0, 1fr) 210px; gap: var(--space-5); }
  .writing-list { display: flex; flex-direction: column; }
  .writing-row { display: grid; grid-template-columns: 5.6rem minmax(0, 1fr) auto; gap: var(--space-3); align-items: baseline; padding: var(--space-3) 0; border-bottom: 1px solid var(--border-subtle); color: inherit; text-decoration: none; }
  .writing-row:first-child { border-top: 1px solid var(--border-subtle); }
  .writing-row:hover { text-decoration: none; }
  .writing-row:hover .writing-title { color: var(--accent); }
  .writing-date { color: var(--muted); font-family: var(--font-mono); font-size: var(--text-xs); }
  .writing-body { display: grid; gap: var(--space-1); }
  .writing-title { color: var(--text); font-family: var(--font-serif); font-size: var(--text-lg); font-weight: 600; line-height: 1.3; transition: color var(--transition-fast); }
  .writing-desc { color: var(--muted); font-size: var(--text-sm); line-height: 1.5; }
  .row-arrow { color: var(--accent); }
  .public-note { display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-4); padding: var(--space-4); border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-elevated); color: var(--text); text-decoration: none; }
  .public-note:hover { border-color: var(--accent); color: var(--text); text-decoration: none; }
  .public-note-kicker, .public-note > span:last-child { color: var(--muted); font-family: var(--font-mono); font-size: var(--text-xs); }
  .public-note strong { font-family: var(--font-serif); font-weight: 600; line-height: 1.35; }
  .proof-card { display: flex; flex-direction: column; min-height: 170px; padding: var(--space-4); border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-elevated); color: inherit; text-decoration: none; }
  .proof-card:hover { border-color: var(--accent); color: inherit; text-decoration: none; }
  .proof-number { margin-bottom: auto; color: var(--accent); font-family: var(--font-serif); font-size: var(--text-3xl); font-weight: 600; line-height: 1; }
  .proof-label { max-width: 13rem; color: var(--text); font-family: var(--font-serif); font-size: var(--text-base); font-weight: 600; line-height: 1.25; }
  .proof-link { margin-top: var(--space-3); color: var(--muted); font-family: var(--font-mono); font-size: var(--text-xs); }
  .contact-panel { display: flex; justify-content: space-between; align-items: end; gap: var(--space-6); margin: var(--space-7) 0 0; padding: var(--space-7) var(--space-6); border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-elevated); }
  .contact-panel h2 { max-width: 520px; margin: 0 0 var(--space-2); font-size: clamp(var(--text-2xl), 3vw, var(--text-3xl)); }
  .contact-panel p:not(.label) { max-width: 560px; margin: 0; color: var(--muted); }
  .contact-actions { justify-content: flex-end; flex: 0 0 auto; }
  .text-link { color: var(--muted); font-family: var(--font-mono); font-size: var(--text-xs); text-decoration: none; }
  .text-link:hover { color: var(--text); }
  @media (max-width: 720px) {
    .hero { grid-template-columns: 1fr; gap: var(--space-6); }
    .hero-aside { display: grid; grid-template-columns: 120px 1fr; gap: var(--space-4); align-items: center; max-width: 470px; }
    .principle-note { width: auto; margin: 0; }
    .work-grid, .proof-grid { grid-template-columns: 1fr; }
    .section-heading, .contact-panel { align-items: flex-start; flex-direction: column; gap: var(--space-3); }
    .section-heading > p { max-width: 480px; }
    .ideas-layout { grid-template-columns: 1fr; }
    .public-note { min-height: 150px; }
    .proof-card { min-height: 145px; }
    .contact-actions { justify-content: flex-start; }
  }
  @media (max-width: 480px) {
    .hero { padding-top: var(--space-7); }
    .hero h1 { font-size: 2.55rem; }
    .signal-strip { grid-template-columns: 1fr; }
    .signal-strip p + p { border-left: 0; border-top: 1px solid var(--border); }
    .writing-row { grid-template-columns: 1fr auto; gap: var(--space-1) var(--space-3); }
    .writing-date { grid-column: 1 / -1; }
    .contact-panel { padding: var(--space-5); }
  }
</style>
