---
interface Props {
  label: string;
  title: string;
  description?: string;
  count?: number;
  countLabel?: string;
  headingLevel?: 'h1' | 'h2';
}

const { label, title, description, count, countLabel = 'on record', headingLevel = 'h1' } = Astro.props;
const Heading = headingLevel;
---

<header class="page-header">
  <p class="label-tag">{label}</p>
  <Heading>{title}</Heading>
  {description && (
    <p class="lead">
      {description}
      {count !== undefined && (
        <span class="count-badge">{count} {countLabel}</span>
      )}
    </p>
  )}
</header>

<style>
  .page-header {
    margin-bottom: var(--space-8);
    padding: var(--space-5) 0 0;
    border-top: 1px solid var(--ie-rule-strong, var(--border));
  }
  .label-tag {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--ie-type-label);
    font-weight: 600;
    letter-spacing: 0.055em;
    color: var(--ie-blue);
    text-transform: uppercase;
  }
  .page-header :is(h1, h2) {
    font-family: var(--font-display);
    max-width: 28ch;
    font-size: var(--ie-type-h1);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--ie-ink);
    margin-bottom: var(--space-4);
  }
  .lead {
    color: var(--ie-ink-secondary);
    max-width: 680px;
    margin: 0;
    line-height: 1.68;
    font-size: var(--ie-type-body);
  }
  .count-badge {
    display: inline-block;
    margin-left: var(--space-2);
    font-size: var(--ie-type-micro);
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--ie-blue);
    background: var(--ie-blue-soft);
    border: 1px solid var(--ie-rule);
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .page-header {
      margin-bottom: var(--space-6);
    }
    .lead {
      font-size: var(--ie-type-h4);
    }
  }
</style>
