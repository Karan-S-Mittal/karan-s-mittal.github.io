---
import VisualAttribution from '../VisualAttribution.astro';

interface Props { caption?: string; exhibit?: string; title?: string; }

const {
  caption = 'Logical token blocks remain contiguous in the request’s address space, while a block table maps them to any available physical frames. The attention kernel follows that table when reading K/V data.',
  exhibit = '04',
  title = 'How logical blocks reach non-contiguous GPU frames',
} = Astro.props;
---

<div class="paging-path" id="paged-attention-diagram">
  <header class="paging-header">
    <div class="header-badge">PAGE TRANSLATION</div>
    <h2 class="diagram-title">{title}</h2>
  </header>
    <header class="path-question">
      <span>Question</span>
      <strong>How can one logical sequence use physical frames 12 and 7 without first copying them together?</strong>
    </header>

    <div class="path-flow">
      <section class="path-step">
        <span class="step-label">01 · Logical blocks</span>
        <h4>Split tokens into fixed-size blocks</h4>
        <div class="logical-block"><b>Block 0</b><span>The · quick · brown · fox</span></div>
        <div class="logical-block active"><b>Block 1</b><span>jumps · over · lazy · <i>open slot</i></span></div>
      </section>

      <div class="path-arrow" aria-hidden="true"><span>index</span></div>

      <section class="path-step">
        <span class="step-label">02 · Block table</span>
        <h4>Translate logical IDs to frame IDs</h4>
        <div class="block-table">
          <p><span>Logical block 0</span><i>→</i><strong>Frame 12</strong></p>
          <p><span>Logical block 1</span><i>→</i><strong>Frame 07</strong></p>
        </div>
      </section>

      <div class="path-arrow" aria-hidden="true"><span>locate</span></div>

      <section class="path-step">
        <span class="step-label">03 · Physical VRAM</span>
        <h4>Use any available frames</h4>
        <div class="frame-pool">
          <p><strong>Frame 07</strong><span>Request 1 · Block 1</span></p>
          <p class="other"><strong>Frame 08</strong><span>Another request</span></p>
          <p><strong>Frame 12</strong><span>Request 1 · Block 0</span></p>
        </div>
      </section>

      <div class="path-arrow" aria-hidden="true"><span>read</span></div>

      <section class="path-step kernel-step">
        <span class="step-label">04 · Attention kernel</span>
        <h4>Follow the table while computing</h4>
        <div class="kernel-read">
          <code>block 0 → frame 12</code>
          <code>block 1 → frame 07</code>
        </div>
        <p class="step-note">No contiguous intermediate copy is required.</p>
      </section>
    </div>

    <aside class="path-takeaway">
      <span>What to notice</span>
      <p><strong>Logical order and physical location are separate.</strong> The block table preserves sequence order; the allocator is free to place each block wherever capacity exists.</p>
    </aside>

    <footer class="diagram-footer-bar">
      {caption && <p class="diagram-caption">{caption}</p>}
      <VisualAttribution author="karansmittal" />
    </footer>
  </div>

<style>
  .paging-path {
    width: 100%;
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    border-radius: var(--radius-card);
    padding: clamp(1.25rem, 3vw, 2rem);
    box-sizing: border-box;
    font-family: var(--font-diagram);
    color: var(--ie-ink);
  }

  .paging-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
  }

  .header-badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: var(--ie-type-micro);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--ie-blue);
    text-transform: uppercase;
  }

  .diagram-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--ie-type-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ie-ink);
  }

  .diagram-caption {
    margin: 0;
    font-size: var(--ie-type-micro);
    color: var(--ie-muted);
    line-height: 1.4;
    flex: 1;
    min-width: 240px;
  }

  .diagram-footer-bar {
    margin-top: 1.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--ie-rule);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .path-question,
  .path-takeaway {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1rem 0;
    border-top: 2px solid var(--ie-ink, var(--text));
    border-bottom: 1px solid var(--ie-rule-strong, var(--border-default));
  }

  .path-question > span,
  .path-takeaway > span,
  .step-label {
    color: var(--ie-blue, var(--accent));
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .path-question strong { color: var(--ie-ink, var(--text)); font-size: 1rem; font-weight: 550; }

  .path-flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 44px minmax(0, 1fr) 44px minmax(0, 1fr) 44px minmax(0, 1fr);
    padding: 1.5rem 0;
  }

  .path-step {
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--ie-rule-strong, var(--border-default));
    background: var(--ie-surface, var(--surface-card));
  }

  .path-step h4 { min-height: 48px; margin: 0.55rem 0 1rem; color: var(--ie-ink, var(--text)); font-family: var(--font-display); font-weight: 600; font-size: 1rem; line-height: 1.35; letter-spacing: -0.01em; }

  .logical-block { display: grid; grid-template-columns: 4.25rem minmax(0, 1fr); margin-bottom: 0.55rem; border: 1px solid var(--ie-rule, var(--border-default)); }
  .logical-block > * { display: flex; min-height: 42px; align-items: center; padding: 0.5rem 0.6rem; font-family: var(--font-mono); font-size: 0.78rem; line-height: 1.35; }
  .logical-block b { border-right: 1px solid var(--ie-rule, var(--border-default)); color: var(--ie-muted, var(--text-muted)); font-weight: 500; }
  .logical-block span { color: var(--ie-ink, var(--text)); }
  .logical-block i { color: var(--ie-muted, var(--text-muted)); font-style: normal; }
  .logical-block.active { border-left: 2px solid var(--ie-blue, var(--accent)); }

  .block-table p,
  .frame-pool p {
    display: grid;
    gap: 0.35rem;
    margin: 0 0 0.5rem;
    padding: 0.65rem;
    border: 1px solid var(--ie-rule, var(--border-default));
    font-size: 0.8rem;
  }

  .block-table p { grid-template-columns: 1fr auto 1fr; align-items: center; }
  .block-table i { color: var(--ie-blue, var(--accent)); font-style: normal; }
  .block-table strong { color: var(--ie-blue, var(--accent)); }

  .frame-pool p { border-color: var(--ie-blue, var(--accent)); background: var(--ie-blue-soft, var(--accent-subtle)); }
  .frame-pool p.other { border-color: var(--ie-rule, var(--border-default)); background: transparent; color: var(--ie-muted, var(--text-muted)); }
  .frame-pool span { color: var(--ie-muted, var(--text-muted)); }

  .kernel-read { display: grid; gap: 0.45rem; }
  .kernel-read code { padding: 0.65rem; border-left: 2px solid var(--ie-blue, var(--accent)); background: var(--ie-code); color: var(--ie-code-text); font-size: 0.76rem; }
  .step-note { margin: 1rem 0 0; color: var(--ie-ink-secondary, var(--text-secondary)); font-size: 0.86rem; line-height: 1.45; }

  .path-arrow { position: relative; display: flex; align-items: center; justify-content: center; }
  .path-arrow::before { content: ''; position: absolute; right: 0; left: 0; height: 1px; background: var(--ie-blue, var(--accent)); }
  .path-arrow::after { content: ''; position: absolute; right: 1px; width: 7px; height: 7px; border-top: 1px solid var(--ie-blue, var(--accent)); border-right: 1px solid var(--ie-blue, var(--accent)); transform: rotate(45deg); }
  .path-arrow span { position: relative; z-index: 1; padding: 0.25rem; background: var(--ie-surface-raised, var(--bg)); color: var(--ie-blue, var(--accent)); font-family: var(--font-mono); font-size: 0.68rem; text-transform: uppercase; }

  .path-takeaway { border-top-width: 1px; }
  .path-takeaway p { margin: 0; color: var(--ie-ink-secondary, var(--text-secondary)); font-size: 0.95rem; line-height: 1.55; }
  .path-takeaway strong { color: var(--ie-ink, var(--text)); }

  @media (max-width: 900px) {
    .path-question, .path-takeaway { grid-template-columns: 1fr; gap: 0.4rem; }
    .path-flow { grid-template-columns: 1fr; }
    .path-step h4 { min-height: 0; }
    .path-arrow { min-height: 48px; justify-content: flex-start; padding-left: 1rem; }
    .path-arrow::before { top: 0; bottom: 0; left: 1.25rem; width: 1px; height: auto; }
    .path-arrow::after { right: auto; bottom: 2px; left: calc(1.25rem - 3px); transform: rotate(135deg); }
    .path-arrow span { margin-left: 1rem; }
  }
</style>
