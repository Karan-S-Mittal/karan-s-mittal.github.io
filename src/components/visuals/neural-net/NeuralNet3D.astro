    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill, 999px);
    background: rgba(23, 26, 31, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-family: var(--font-mono);
