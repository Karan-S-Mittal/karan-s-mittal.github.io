---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/portfolio/PageHeader.astro';
import { normalizeTag, tagSlug } from '../../utils/tags.js';

const allPosts = await getCollection('blog');
const isDev = import.meta.env.DEV;
const posts = allPosts.filter((post) => isDev || !post.data.draft);

const tagCounts = posts.reduce<Record<string, number>>((acc, post) => {
  for (const tag of post.data.tags) {
    const key = normalizeTag(tag);
    acc[key] = (acc[key] || 0) + 1;
  }
  return acc;
}, {});

const tags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .map(([tag, count]) => ({ tag, count }));
---

<Layout title="Topics Index | Karan Mittal">
  <main class="container tags-page">
    <PageHeader
      label="Taxonomy"
      title="Topics & Systems Index."
      description="Taxonomy of technical essays, deep dives, benchmarks, and architecture breakdowns."
      count={tags.length}
      countLabel="topics"
    />

    <div class="tags-grid">
      {tags.map(({ tag, count }) => (
        <a href={`/tags/${tagSlug(tag)}/`} class="tag-card">
          <span class="tag-name">{tag}</span>
          <span class="tag-count">{count} {count === 1 ? 'essay' : 'essays'}</span>
        </a>
      ))}
    </div>
  </main>
</Layout>

<style>
  .tags-page {
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }

  .tags-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.85rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .tag-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-pill, 999px);
    background: var(--ie-surface);
    border: 1px solid var(--ie-rule);
    text-decoration: none;
    color: inherit;
    transition: border-color 120ms ease, background-color 120ms ease, color 120ms ease;
  }

  .tag-card:hover {
    border-color: var(--ie-blue);
    background: var(--ie-blue-soft);
    color: var(--ie-blue);
    text-decoration: none;
  }

  .tag-name {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.8rem;
    color: var(--ie-ink);
  }

  .tag-card:hover .tag-name {
    color: var(--ie-blue);
  }

  .tag-count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ie-muted);
    font-weight: 500;
  }
</style>
